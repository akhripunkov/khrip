// ============================================================================
// Атомы, литералы, поля, индексы, вызовы функций и методов, встраивание.
// ============================================================================

var inline_depth: int
var inline_stack: [int]
var inline_rets: [int]
// Открытый конец среза str: s[a..] передаёт его в __text_slice (TEXT_END в
// lib/text.kh).
const SLICE_END = 0x7FFFFFFFFFFFFFFF
// Позиция сразу за последним символьным литералом, который стал str: для
// подсказки «n == 'a'» к 'a' == n с int n (char_compare_hint).
var char_lit_end: int

fn parse_atom() -> int {
    let w = want
    want = ty_err
    let t = tok()
    let k = t.kind
    if k == T_INT {
        advance()
        if is_float_want(w) {
            emit_mov_imm(RAX, __int_to_f64_bits(t.val))
            return ty_float
        }
        let at = code_len
        emit_mov_imm(RAX, t.val)
        note_simple(OPK_IMM, t.val, at)
        int_lit_end = pos
        return ty_int
    }
    if k == T_FLOAT {
        advance()
        emit_mov_imm(RAX, t.val)
        return ty_float
    }
    if k == T_CHAR {
        advance()
        if char_is_int(w) {
            if is_float_want(w) {
                emit_mov_imm(RAX, __int_to_f64_bits(t.val))
                return ty_float
            }
            emit_mov_imm(RAX, t.val)
            return ty_int
        }
        emit_mov_imm(RAX, const_str(char_text(t.val)))
        char_lit_end = pos
        return ty_str
    }
    if k == T_STR {
        advance()
        emit_mov_imm(RAX, strlit(t.val))
        return ty_str
    }
    if k == T_TRUE || k == T_FALSE {
        advance()
        if k == T_TRUE {
            emit_mov_imm(RAX, 1)
        } else {
            emit_mov_imm(RAX, 0)
        }
        return ty_bool
    }
    if k == T_NONE {
        advance()
        emit_mov_imm(RAX, 0)
        if tkind(w) == K_OPT {
            return w
        }
        return ty_none
    }
    if k == '(' {
        advance()
        let saved = no_struct
        no_struct = false
        let r = parse_expr(w)
        no_struct = saved
        expect_tok(')')
        return r
    }
    if k == '[' {
        return parse_list_lit(w)
    }
    if k == '\{' {
        if brace_struct_ahead(w) {
            return parse_brace_struct(w)
        }
        return parse_map_lit(w)
    }
    if k == T_IDENT && tok().text == "tx" && kind_at(pos + 1) == '\{' {
        return parse_tx_value(w)
    }
    if k == T_IDENT {
        return parse_ident(w)
    }
    if k == T_CALL {
        return parse_call_expr()
    }
    if k == T_MATCH {
        return parse_match(true, w)
    }
    if k == T_IF {
        return parse_if_expr(w)
    }
    if k == T_SQL {
        return parse_sql(w)
    }
    var hint = ""
    if k == T_FN {
        hint = "lambdas are written x => expression and work in map, filter, find, any, all, count, sort_by; otherwise declare a named fn"
    }
    syntax_error(t, "expected a value, found " + tok_show(t), hint)
    if k != T_EOF && k != '}' && k != ')' {
        advance()
    }
    return ty_err
}

// Символьный литерал 'x' (T_CHAR, текущий токен — за ним) — код символа (int),
// если ждут int, int? или float или если за ним арифметика (- * / % & | ^ << >>:
// у str их нет, поэтому print('z' - 'a') — 25). Иначе — str из одного символа:
// c == 'a', s.split(','), print('A'), 'a' + 'b'.
fn char_is_int(w: int) -> bool {
    let t = ty_inner(w)
    if t == ty_int || t == ty_float {
        return true
    }
    let k = kind()
    return k == '-' || k == '*' || k == '/' || k == '%' || k == '&' || k == '|' || k == '^' || k == T_SHL || k == T_SHR
}

// Похожее имя для подсказки «может быть, вы имели в виду».
fn similar_name(name: str) -> str {
    var best = ""
    var best_d = 3
    var i = nlocals - 1
    while i >= local_floor {
        let d = edit_distance(name, locals[i].name)
        if d < best_d {
            best = locals[i].name
            best_d = d
        }
        i -= 1
    }
    for g in sym_map.keys {
        if !g.starts_with("__") {
            let d = edit_distance(name, g)
            if d < best_d {
                best = g
                best_d = d
            }
        }
    }
    return best
}

fn unknown_name_hint(name: str) -> str {
    if sql_quoted_param {
        // '{city}' в sql — параметр; литерал PostgreSQL пишется с \{
        return "in sql, \{" + name + "} is a value from Khrip; for the PostgreSQL literal '\{" + name + "}' write '\\\{" + name + "}'"
    }
    let h = name_hint(name)
    if h.byte_len() > 0 {
        return h
    }
    let s = similar_name(name)
    if s.byte_len() > 0 {
        return "did you mean '" + s + "'?"
    }
    return ""
}

fn parse_ident(w: int) -> int {
    let t = tok()
    advance()
    let name = t.text
    if kind() == '(' {
        return parse_call(t, w)
    }
    if name == "fetch" && kind() == T_IDENT && is_http_method(tok().text) && find_local(name) < 0 {
        if tx_depth > 0 {
            error_tok(t, "fetch inside tx runs again on every retry and holds a database connection", "call it before or after the tx block")
        }
        return parse_fetch(t)
    }
    if kind() == '\{' && !no_struct {
        let si = struct_find(name)
        if si >= 0 {
            return parse_struct_lit(si, t)
        }
    }
    let li = find_local(name)
    if li >= 0 {
        let at = code_len
        emit_load_local(li)
        if !is_narrowed(li) {
            note_simple(OPK_LOCAL, li, at)
            simple_mut = locals[li].mutable
        }
        let nk = kind()
        let keeps_opt = nk == T_QQ || ((nk == T_EQ || nk == T_NE) && kind_at(pos + 1) == T_NONE)
        if is_narrowed(li) && !keeps_opt {
            let inner = ty_inner(locals[li].ty)
            if !is_ref(inner) {
                emit_load(RAX, RAX, 0)
            }
            return inner
        }
        return locals[li].ty
    }
    let usi = struct_find(name)
    if usi >= 0 && structs[usi].sum >= 0 && structs[usi].fields.len() == 0 {
        // вариант без полей — готовое значение
        emit_mov_imm(RAX, unit_addr(usi))
        return ty_sum(structs[usi].sum)
    }
    let s = sym_find(name)
    if s >= 0 {
        let sk = sym_kind(s)
        if sk == SK_TABLE && kind() == '.' {
            return parse_table_method(t, sym_idx(s), w)
        }
        if sk == SK_CONN || sk == SK_TABLE {
            db_name_not_value(t, sk)
            return ty_err
        }
        if sk == SK_GLOBAL {
            let g = globals[sym_idx(s)]
            if global_in_store(g) {
                store_touch()
            }
            emit_load_abs(RAX, g.addr)
            return g.ty
        }
        if sk == SK_CONST {
            let c = consts[sym_idx(s)]
            let at = code_len
            emit_mov_imm(RAX, c.val)
            if c.ty == ty_int {
                note_simple(OPK_IMM, c.val, at)
            }
            return c.ty
        }
        if sk == SK_FN {
            error_tok(t, "'" + name + "' is a function; call it with " + name + "(...)", "")
            return ty_err
        }
        error_tok(t, "'" + name + "' is a type, not a value", "create a value with " + name + " \{ field: value }")
        return ty_err
    }
    error_tok(t, "unknown name '" + name + "'", unknown_name_hint(name))
    return ty_err
}

// ---- Литералы списков, словарей и структур ----

// Размер элемента списка в памяти: bool — байт, остальное — слово.
fn esize_of(et: int) -> int {
    if et == ty_bool {
        return 1
    }
    return 8
}

fn emit_list_new(et: int) {
    emit_mov_imm(RDI, 4)
    emit_mov_imm(RSI, esize_of(et))
    emit_call(rt_func("__list_new"))
}

// [a, b, ...]: список создаётся, когда известен тип элемента — из ожидаемого
// типа или по первому элементу.
fn parse_list_lit(want_ty: int) -> int {
    var w = want_ty
    if tkind(w) == K_OPT {
        w = ty_inner(w)
    }
    let at = tok()
    advance()
    let saved = no_struct
    no_struct = false
    var et = ty_err
    var known = false
    let want_known = tkind(w) == K_LIST
    if want_known {
        et = ty_elem(w)
        known = true
        emit_list_new(et)
        emit_push(RAX)
    }
    var first = true
    while kind() != ']' && kind() != T_EOF && !panic_mode {
        let vt = tok()
        if known {
            want = et
        } else {
            want = ty_err
        }
        let t = parse_coalesce()
        if !known {
            et = t
            known = true
            // первый элемент в стек, затем новый список
            emit_push(RAX)
            emit_list_new(et)
            emit_push(RAX)
            emit_load(RSI, RSP, 8)
            emit_mov_rr(RDI, RAX)
            emit_call(rt_func("__list_push"))
            // убрать первый элемент из-под списка
            emit_pop(RAX)
            emit_store(RSP, 0, RAX)
        } else {
            // [Circle { .. }, Rect { .. }] — список общего типа Shape
            if !want_known && t != et && !assignable(t, et) && variant_sum(t) >= 0 && variant_sum(t) == variant_sum(et) {
                et = variant_sum(t)
            }
            coerce(t, et, vt)
            emit_mov_rr(RSI, RAX)
            emit_load(RDI, RSP, 0)
            emit_call(rt_func("__list_push"))
        }
        first = false
        if kind() == ',' {
            advance()
        } else if kind() != ']' {
            syntax_error(tok(), "expected ',' or ']' in the list, found " + tok_show(tok()), "")
        }
    }
    expect_tok(']')
    no_struct = saved
    if !known {
        error_tok(at, "cannot infer the element type of []", "annotate the variable, e.g. var xs: [int] = []")
        emit_mov_imm(RAX, 0)
        return ty_err
    }
    emit_pop(RAX)
    return ty_list(et)
}

// ---- Литералы структур без имени типа (A2, A3) ----

// { в позиции значения (текущая лексема) — литерал структуры: за ней «...» или
// имя и «:», «,» или «}» (поле, сокращение поля). Ключ-строка — словарь, как
// раньше; пустые {} — структура, только если ждут структуру. Если ждут
// словарь — всегда словарь: var m: map[str, int] = \{k: 1} (ключ — переменная).
fn brace_struct_ahead(w: int) -> bool {
    let t = ty_inner(w)
    if tkind(t) == K_MAP {
        return false
    }
    if struct_lit_shape(pos) {
        return true
    }
    return kind_at(pos + 1) == '}' && tkind(t) == K_STRUCT
}

// Лексемы с { в позиции i выглядят как литерал структуры (без пустых {}).
fn struct_lit_shape(i: int) -> bool {
    let k1 = kind_at(i + 1)
    if k1 == T_ELLIPSIS {
        return true
    }
    if keyword_name(k1) {
        // { type: ... }: поле с именем-ключевым словом — ошибка с подсказкой
        // в разборе литерала, как у именованного типа
        return kind_at(i + 2) == ':'
    }
    if k1 != T_IDENT {
        return false
    }
    let k2 = kind_at(i + 2)
    if k2 == ':' || k2 == ',' || k2 == '}' {
        return true
    }
    // сокращение, а следующее поле — на новой строке: { a ⏎ b: 2 }
    return (k2 == T_IDENT || k2 == T_ELLIPSIS) && toks[i + 2].line > toks[i + 1].line
}

// Лексема-ключевое слово, которое пишут как имя поля (type, match, ...);
// true, false и none — значения.
fn keyword_name(k: int) -> bool {
    return k >= T_FN && k <= T_MATCH && k != T_TRUE && k != T_FALSE && k != T_NONE
}

// { в начале оператора или ветки match — блок; но «{ имя:», «{ имя,» и
// «{ ...» блоком быть не могут: это литерал структуры, которому нужны скобки
// или имя типа (E-A1).
fn brace_block_is_struct(i: int) -> bool {
    let k1 = kind_at(i + 1)
    if k1 == T_ELLIPSIS {
        return true
    }
    return (k1 == T_IDENT || keyword_name(k1)) && (kind_at(i + 2) == ':' || kind_at(i + 2) == ',')
}

// Ветка match: { имя } после => — тоже E-A1 (как блок это просто имя:
// пишется => имя).
fn arm_brace_is_struct(i: int) -> bool {
    return brace_block_is_struct(i) || (kind_at(i + 1) == T_IDENT && kind_at(i + 2) == '}')
}

// Как написать литерал с { в позиции i, чтобы он стал значением: (\{ a: ... }).
fn brace_paren_hint(i: int) -> str {
    if kind_at(i + 1) == T_IDENT && kind_at(i + 2) == '}' {
        return "(\{ " + toks[i + 1].text + " })"
    }
    if kind_at(i + 1) == T_IDENT {
        return "(\{ " + toks[i + 1].text + ": ... })"
    }
    return "(\{ ... })"
}

// Ошибка E-A1 и похожая в начале оператора: литерал на месте блока.
fn brace_block_error(i: int, arm: bool, w: int) {
    var named = "the type name before the brace"
    if tkind(ty_inner(w)) == K_STRUCT && !is_anon_ty(ty_inner(w)) {
        named = ty_name(ty_inner(w)) + " \{ ... }"
    }
    if arm && kind_at(i + 1) == T_IDENT && kind_at(i + 2) == '}' {
        let x = toks[i + 1].text
        error_tok(toks[i], "a struct literal as a match arm needs parentheses or its type: " + brace_paren_hint(i), "after => a brace starts a block; write => " + brace_paren_hint(i) + " for a struct, or => " + x + " for the value of " + x)
    } else if arm {
        error_tok(toks[i], "a struct literal as a match arm needs parentheses or its type: " + brace_paren_hint(i), "after => a brace starts a block; write => " + brace_paren_hint(i) + " or " + named)
    } else {
        error_tok(toks[i], "a struct literal at the start of a statement needs parentheses or its type: " + brace_paren_hint(i), "a brace at the start of a statement starts a block; write " + brace_paren_hint(i) + " or " + named)
    }
}

// Разбирается заголовок for ... in (для подсказки у литерала там).
var for_header: bool

// Литерал структуры без имени типа: { поле: значение, ...x, поле }. Тип — тот,
// что ждут (A2: let x: T, параметр, return, элемент списка, поле другого
// литерала, присваивание); если не ждут структуру — анонимный тип из полей (A3).
fn parse_brace_struct(w: int) -> int {
    let at = tok()
    if no_struct {
        // в условии, у match и в заголовке for { начинает блок
        var hint = "in a condition, a match value or a for loop, a brace starts the block"
        if for_header && kind_at(pos + 1) == T_IDENT && kind_at(pos + 2) == ':' {
            // for k in {x: 1}: обходят словарь, а не структуру
            let x = toks[pos + 1].text
            hint = "to loop over a map keyed by the value of " + x + " write \{(" + x + "): ...}, or \{\"" + x + "\": ...} for the key \"" + x + "\""
        }
        error_tok(at, "a struct literal here needs parentheses: " + brace_paren_hint(pos), hint)
    }
    let t = ty_inner(w)
    let open = pos
    var r = ty_err
    if tkind(t) == K_STRUCT {
        r = parse_struct_lit(types[t].a, at)
    } else if tkind(t) == K_SUM {
        let su = types[t].a
        error_tok(at, "a struct literal for " + ty_name(t) + " needs the name of its variant", "write it before the brace, e.g. " + structs[sums[su].variants[0]].name + " \{ ... }; variants: " + variant_names(su))
        parse_anon_lit(at)
    } else {
        r = parse_anon_lit(at)
    }
    if panic_mode && pos <= matching_close(open) {
        // синтаксическая ошибка внутри: дальше — за литералом, как после
        // целого значения (иначе его } приняли бы за конец блока, а следующий
        // оператор пропал бы при восстановлении)
        pos = matching_close(open)
        advance()
        panic_mode = false
        r = ty_err
    }
    return r
}

// { поле: значение, ... } без ожидаемого типа (A3): тип — анонимная структура
// из этих полей с типами их значений (anon_struct; раскладка — как у типа,
// записанного первым). Значения вычисляются по порядку записи и ждут в стеке,
// затем — структура. ...x добавляет поля структуры x, кроме заданных явно; поле
// из нескольких распаковок берётся из последней.
fn parse_anon_lit(at: Token) -> int {
    let open = pos
    let explicit = explicit_fields(open)
    advance()
    let saved = no_struct
    no_struct = false
    // по записи: имя поля ("" — распаковка) и тип значения; лексемы значений
    // поле: значение — [ivs, ive) (для проверки «это был бы словарь»)
    var inames: [str] = []
    var itys: [int] = []
    var ivs: [int] = []
    var ive: [int] = []
    var ntoks: [Token] = []
    var plain = true
    var bad = false
    while kind() != '}' && kind() != T_EOF && !panic_mode {
        if kind() == T_ELLIPSIS {
            plain = false
            let st = tok()
            advance()
            let src = parse_expr(ty_err)
            if tkind(src) != K_STRUCT {
                if src != ty_err {
                    var hint = ""
                    if tkind(src) == K_OPT && tkind(ty_inner(src)) == K_STRUCT {
                        hint = "the value may be none; unwrap it first"
                    }
                    error_tok(st, "... needs a value of a type with fields, found " + ty_name(src), hint)
                }
                bad = true
            }
            emit_push(RAX)
            inames.push("")
            itys.push(src)
            ivs.push(0)
            ive.push(0)
            ntoks.push(st)
        } else {
            let fname = expect_ident()
            if panic_mode {
                break
            }
            var t = ty_err
            var vs = pos
            if kind() == ':' {
                advance()
                vs = pos
                t = parse_expr(ty_err)
            } else if kind() == ',' || kind() == '}' || tok().line > fname.line {
                // сокращение: поле с тем же именем, что у переменной
                plain = false
                pos -= 1
                t = parse_ident(ty_err)
            } else {
                syntax_error(tok(), "expected ':' after field '" + fname.text + "', found " + tok_show(tok()), "\{ name: value } or \{ name } for a variable of that name")
                break
            }
            if t == ty_none {
                error_tok(fname, "cannot infer the type of field '" + fname.text + "' from none", "give the literal a type: let v: \{ " + fname.text + ": T? } = ..., or a named type")
                bad = true
            } else if t == ty_void || t == ty_never {
                error_tok(fname, "field '" + fname.text + "' gets no value", "")
                bad = true
            } else if t == ty_err {
                bad = true
            }
            if list_has(inames, fname.text) {
                error_tok(fname, "field '" + fname.text + "' is set twice", "remove one of them")
                bad = true
            }
            emit_push(RAX)
            inames.push(fname.text)
            itys.push(t)
            ivs.push(vs)
            ive.push(pos)
            ntoks.push(fname)
        }
        if kind() == ',' {
            advance()
        }
    }
    expect_tok('}')
    no_struct = saved
    let n = inames.len()
    if plain && !bad && !panic_mode && n > 0 && reads_as_var_map(inames, itys, ivs, ive) {
        // {k: v}, где k — переменная int или str: раньше это был словарь с
        // ключом — значением k; теперь структура с полем "k" — громко
        let k = inames[0]
        error_tok(ntoks[0], "ambiguous literal: '" + k + "' is a field name here and also a variable", "for the struct, give it a type (let r: \{ " + k + ": T } = ..., or Name \{ " + k + ": v }) or rename the variable; for a map write \{(" + k + "): v} (keyed by its value) or \{\"" + k + "\": v}")
    }
    // поля типа: имя, тип, откуда значение (запись и номер поля распаковки);
    // поле T? из нескольких распаковок: earlier_* — прежние, по порядку
    // (последняя, у которой оно не none, — как Product \{ ...old, ...patch })
    var names: [str] = []
    var tys: [int] = []
    var from_item: [int] = []
    var from_field: [int] = []
    var earlier_item: [[int]] = []
    var earlier_field: [[int]] = []
    var i = 0
    while i < n && !bad {
        if inames[i] == "" {
            let sf = structs[types[itys[i]].a].fields
            var m = 0
            while m < sf.len() {
                let f = sf[m]
                if !list_has(explicit, f.name) {
                    var j = 0
                    while j < names.len() && names[j] != f.name {
                        j += 1
                    }
                    if j == names.len() {
                        names.push(f.name)
                        tys.push(f.ty)
                        from_item.push(i)
                        from_field.push(m)
                        earlier_item.push([])
                        earlier_field.push([])
                    } else if tys[j] != f.ty {
                        error_tok(at, "field '" + f.name + "' comes from two ... values with different types: " + ty_name(tys[j]) + " and " + ty_name(f.ty), "set it explicitly: " + f.name + ": value")
                        bad = true
                    } else {
                        if tkind(f.ty) == K_OPT {
                            earlier_item[j].push(from_item[j])
                            earlier_field[j].push(from_field[j])
                        }
                        from_item[j] = i
                        from_field[j] = m
                    }
                }
                m += 1
            }
        } else {
            names.push(inames[i])
            tys.push(itys[i])
            from_item.push(i)
            from_field.push(-1)
            earlier_item.push([])
            earlier_field.push([])
        }
        i += 1
    }
    if !bad && !panic_mode && names.len() == 0 {
        error_tok(at, "this struct literal has no fields", "")
        bad = true
    }
    if bad || panic_mode {
        emit_alu_imm(0, RSP, n * 8)
        emit_mov_imm(RAX, 0)
        return ty_err
    }
    var defs: [int] = []
    for x in names {
        defs.push(-1)
    }
    let si = anon_struct(names, tys, defs, open)
    let fs = structs[si].fields
    let nf = fs.len()
    emit_mov_imm(RDI, nf * 8 + 8)
    emit_call(rt_func("__alloc"))
    var j = 0
    while j < nf {
        var w = 0
        while names[w] != fs[j].name {
            w += 1
        }
        if earlier_item[w].len() > 0 {
            // поле T? из нескольких распаковок: по порядку, каждая следующая —
            // только если не none
            var e = 0
            while e < earlier_item[w].len() {
                emit_load(RCX, RSP, (n - 1 - earlier_item[w][e]) * 8)
                emit_load(RCX, RCX, earlier_field[w][e] * 8)
                emit_rr(0x85, RCX, RCX)
                let skip = emit_jcc(CC_E)
                emit_store(RAX, j * 8, RCX)
                patch_here(skip)
                e += 1
            }
            emit_load(RCX, RSP, (n - 1 - from_item[w]) * 8)
            emit_load(RCX, RCX, from_field[w] * 8)
            emit_rr(0x85, RCX, RCX)
            let skip = emit_jcc(CC_E)
            emit_store(RAX, j * 8, RCX)
            patch_here(skip)
        } else {
            emit_load(RCX, RSP, (n - 1 - from_item[w]) * 8)
            if from_field[w] >= 0 {
                emit_load(RCX, RCX, from_field[w] * 8)
            }
            emit_store(RAX, j * 8, RCX)
        }
        j += 1
    }
    emit_alu_imm(0, RSP, n * 8)
    return ty_struct(si)
}

// Литерал A3 без распаковок и сокращений, который раньше был бы словарём с
// ключами — значениями переменных: каждое имя поля — локальная, параметр,
// глобальная, store или const типа int или str (у всех один тип), значения
// одного типа и ни одно значение не упоминает имя своего поля (ни как
// переменную, ни как поле: { q: q.trim() }, { id: order.id } — структуры).
fn reads_as_var_map(names: [str], tys: [int], vs: [int], ve: [int]) -> bool {
    var kt = -1
    var i = 0
    while i < names.len() {
        var t = -1
        let li = find_local(names[i])
        if li >= 0 {
            t = locals[li].ty
        } else {
            let s = sym_find(names[i])
            if s >= 0 && sym_kind(s) == SK_GLOBAL {
                t = globals[sym_idx(s)].ty
            } else if s >= 0 && sym_kind(s) == SK_CONST {
                t = consts[sym_idx(s)].ty
            }
        }
        if t != ty_int && t != ty_str {
            return false
        }
        if kt < 0 {
            kt = t
        } else if t != kt {
            return false
        }
        if tys[i] != tys[0] {
            return false
        }
        var j = vs[i]
        while j < ve[i] {
            if toks[j].kind == T_IDENT && toks[j].text == names[i] {
                return false
            }
            j += 1
        }
        i += 1
    }
    return true
}

// Подсказка для анонимной структуры там, где ждали словарь: {k: 1} с ключом
// без кавычек — структура.
fn anon_map_hint(t: int) -> str {
    if !is_anon_ty(t) {
        return ""
    }
    return "\{ name: value } is a struct; for a map, quote the keys (\{\"k\": 1}) or put a variable key in parentheses (\{(k): 1})"
}

fn parse_map_lit(want_ty: int) -> int {
    var w = want_ty
    if tkind(w) == K_OPT {
        w = ty_inner(w)
    }
    let at = tok()
    let k1 = kind_at(pos + 1)
    if k1 == T_LET || k1 == T_VAR || k1 == T_RETURN || k1 == T_FOR || k1 == T_WHILE {
        // x => \{ let ... }: в значении скобка — литерал, а не блок
        syntax_error(toks[pos + 1], "a brace in a value starts a map or struct literal, not a block", "a lambda body and an argument are one expression; move the statements into a function")
        pos = matching_close(pos)
        advance()
        return ty_err
    }
    advance()
    let saved = no_struct
    no_struct = false
    var kt = ty_err
    var vt = ty_err
    var known = false
    if tkind(w) == K_MAP {
        kt = types[w].a
        vt = types[w].b
        known = true
    }
    // ключ-строка определяется по ожидаемому типу или первому ключу ('a': — тоже str)
    let first_str = kind() == T_STR || (kind() == T_CHAR && kind_at(pos + 1) == ':')
    var is_str = first_str
    if known {
        is_str = kt == ty_str
    }
    let guess = known
    var flags = 0
    if known {
        flags = map_flags(kt, vt)
    } else if is_str {
        flags = 1
    }
    emit_mov_imm(RDI, flags)
    emit_call(rt_func("__map_new"))
    emit_push(RAX)
    while kind() != '}' && kind() != T_EOF && !panic_mode {
        let kt_tok = tok()
        if (kind() == T_IDENT || keyword_name(kind())) && kind_at(pos + 1) == ':' {
            // ключ — голое имя: без ожидаемого словаря тот же текст —
            // литерал структуры, поэтому ключ пишется явно
            error_tok(kt_tok, "a map key cannot be a bare name: '" + kt_tok.text + "'", "write \{\"" + kt_tok.text + "\": v} for the key \"" + kt_tok.text + "\", or \{(" + kt_tok.text + "): v} for a key from the variable " + kt_tok.text)
        }
        if known {
            want = kt
        } else {
            want = ty_err
        }
        let k1 = parse_coalesce()
        if !known {
            kt = k1
            if kt != ty_int && kt != ty_str {
                error_tok(kt_tok, "map keys must be int or str", "")
            }
        } else {
            coerce(k1, kt, kt_tok)
        }
        emit_push(RAX)
        expect_tok(':')
        let vtok = tok()
        if known {
            want = vt
        } else {
            want = ty_err
        }
        let v1 = parse_coalesce()
        if !known {
            vt = v1
            known = true
        } else {
            coerce(v1, vt, vtok)
        }
        if !guess && map_flags(kt, vt) != flags {
            // тип стал известен по первой записи: признаки пустого словаря
            // (значения bool — байтами, ключ-строка не литерал)
            emit_push(RAX)
            emit_load(RDI, RSP, 16)
            emit_mov_imm(RSI, map_flags(kt, vt))
            emit_call(rt_func("__map_retag"))
            emit_pop(RAX)
            flags = map_flags(kt, vt)
        }
        emit_mov_rr(RDX, RAX)
        emit_pop(RSI)
        emit_load(RDI, RSP, 0)
        emit_call(rt_func("__map_set"))
        if kind() == ',' {
            advance()
        }
    }
    expect_tok('}')
    no_struct = saved
    emit_pop(RAX)
    if !known {
        error_tok(at, "cannot infer the type of \{}", "annotate the variable, e.g. var m: map[str, int] = \{}")
        return ty_err
    }
    return ty_map(kt, vt)
}

// Имена, заданные в литерале явно (поле: значение или сокращение поле).
fn explicit_fields(open: int) -> [str] {
    var names: [str] = []
    let close = matching_close(open)
    var i = open + 1
    var depth = 0
    while i < close {
        let k = toks[i].kind
        if k == '(' || k == '[' || k == '\{' {
            depth += 1
        } else if k == ')' || k == ']' || k == '}' {
            depth -= 1
        } else if depth == 0 && k == T_IDENT {
            let prev = toks[i - 1].kind
            let next = toks[i + 1].kind
            if (prev == '\{' || prev == ',') && (next == ':' || next == ',' || next == '}') {
                names.push(toks[i].text)
            }
        }
        i += 1
    }
    return names
}

fn list_has(xs: [str], s: str) -> bool {
    for x in xs {
        if x == s {
            return true
        }
    }
    return false
}

// Имя { поле: значение, ...другое, поле }
fn parse_struct_lit(si: int, at: Token) -> int {
    let open = pos
    let fields = structs[si].fields
    let nf = fields.len()
    if nf == 0 && structs[si].sum >= 0 && kind_at(pos + 1) == '}' {
        advance()
        advance()
        emit_mov_imm(RAX, unit_addr(si))
        return ty_sum(structs[si].sum)
    }
    let explicit = explicit_fields(open)
    advance()
    let saved = no_struct
    no_struct = false
    var set: [bool] = []
    var i = 0
    while i < nf {
        set.push(false)
        i += 1
    }
    emit_mov_imm(RDI, nf * 8 + 8)
    emit_call(rt_func("__alloc"))
    if structs[si].sum >= 0 {
        // метка варианта перед полями
        emit_mov_imm(RCX, si)
        emit_store(RAX, 0, RCX)
        emit_alu_imm(0, RAX, 8)
    }
    emit_push(RAX)
    while kind() != '}' && kind() != T_EOF && !panic_mode {
        if kind() == T_ELLIPSIS {
            let st = tok()
            advance()
            let src = parse_expr(ty_err)
            if tkind(src) != K_STRUCT {
                if src != ty_err {
                    error_tok(st, "... needs a value of a type with fields, found " + ty_name(src), "")
                }
            } else {
                let sf = structs[types[src].a].fields
                // распаковка значения того же типа (...old) копирует поля как
                // есть; другого типа (заплатка, ...patch) — поле T? берётся,
                // только если оно не none, и в поле T, и в поле T?, как SET
                // \{patch} и to_bson: Product \{ ...old, ...patch } не стирает
                // то, чего клиент не прислал
                let same = types[src].a == si
                var j = 0
                while j < nf {
                    let f = fields[j]
                    if !list_has(explicit, f.name) {
                        var m = 0
                        while m < sf.len() {
                            let opt = tkind(sf[m].ty) == K_OPT && !same
                            if sf[m].name == f.name && !opt && assignable(sf[m].ty, f.ty) {
                                emit_load(RCX, RAX, m * 8)
                                emit_load(RDX, RSP, 0)
                                emit_store(RDX, j * 8, RCX)
                                set[j] = true
                            } else if sf[m].name == f.name && opt && (assignable(sf[m].ty, f.ty) || assignable(ty_inner(sf[m].ty), f.ty)) {
                                let into_opt = assignable(sf[m].ty, f.ty)
                                if !set[j] && fields[j].def >= 0 {
                                    // значения ещё нет: сначала значение по
                                    // умолчанию, его заменит присланное
                                    emit_push(RAX)
                                    let save = pos
                                    pos = fields[j].def
                                    let dt = tok()
                                    let t = parse_expr(fields[j].ty)
                                    coerce(t, fields[j].ty, dt)
                                    pos = save
                                    emit_load(RCX, RSP, 8)
                                    emit_store(RCX, j * 8, RAX)
                                    emit_pop(RAX)
                                    set[j] = true
                                } else if !set[j] && tkind(f.ty) == K_OPT {
                                    // поле T? без значения — none (память
                                    // литерала обнулена)
                                    set[j] = true
                                }
                                emit_load(RCX, RAX, m * 8)
                                emit_rr(0x85, RCX, RCX)
                                let skip = emit_jcc(CC_E)
                                if !into_opt && !is_ref(f.ty) {
                                    emit_load(RCX, RCX, 0)
                                }
                                emit_load(RDX, RSP, 0)
                                emit_store(RDX, j * 8, RCX)
                                patch_here(skip)
                            }
                            m += 1
                        }
                    }
                    j += 1
                }
            }
        } else {
            let fname = expect_ident()
            if panic_mode {
                break
            }
            let fi = field_find(si, fname.text)
            var ft = ty_err
            if fi < 0 {
                var hint = ""
                var best_d = 3
                for f in fields {
                    let d = edit_distance(fname.text, f.name)
                    if d < best_d {
                        best_d = d
                        hint = "did you mean '" + f.name + "'?"
                    }
                }
                if hint.byte_len() == 0 {
                    hint = "its fields: " + field_names(si)
                }
                error_tok(fname, type_label(si) + " has no field '" + fname.text + "'", hint)
            } else {
                ft = fields[fi].ty
            }
            if kind() == ':' {
                advance()
                let vt = tok()
                let t = parse_expr(ft)
                coerce(t, ft, vt)
            } else {
                // сокращение: поле с тем же именем, что у переменной
                pos -= 1
                let t = parse_ident(ft)
                coerce(t, ft, fname)
            }
            if fi >= 0 {
                if set[fi] && list_has(explicit, fname.text) {
                    let cnt = count_name(explicit, fname.text)
                    if cnt > 1 {
                        error_tok(fname, "field '" + fname.text + "' is set twice", "")
                    }
                }
                emit_load(RCX, RSP, 0)
                emit_store(RCX, fi * 8, RAX)
                set[fi] = true
            }
        }
        if kind() == ',' {
            advance()
        }
    }
    expect_tok('}')
    no_struct = saved
    var missing = ""
    var j = 0
    while j < nf {
        if !set[j] && !panic_mode && tkind(fields[j].ty) == K_OPT && fields[j].def < 0 {
            // необязательное поле без значения — none
            emit_load(RCX, RSP, 0)
            emit_mov_imm(RAX, 0)
            emit_store(RCX, j * 8, RAX)
        } else if !set[j] && !panic_mode {
            if fields[j].def >= 0 {
                // значение по умолчанию из объявления типа
                let save = pos
                pos = fields[j].def
                let dt = tok()
                let t = parse_expr(fields[j].ty)
                coerce(t, fields[j].ty, dt)
                pos = save
                emit_load(RCX, RSP, 0)
                emit_store(RCX, j * 8, RAX)
            } else {
                if missing.byte_len() > 0 {
                    missing += ", "
                }
                missing += fields[j].name + ": " + ty_name(fields[j].ty)
            }
        }
        j += 1
    }
    if missing.byte_len() > 0 {
        var hint = "set every field, or copy them with ...other"
        if at.kind == '\{' && kind_at(open + 1) == '}' {
            hint = "write them in the braces: \{ " + missing_first(fields, set) + ": ... }"
        }
        error_tok(at, "missing fields in " + structs[si].name + ": " + missing, hint)
    }
    emit_pop(RAX)
    return ty_struct(si)
}

// Поля структуры si через запятую: для подсказок.
fn field_names(si: int) -> str {
    var r = ""
    for f in structs[si].fields {
        if r.byte_len() > 0 {
            r += ", "
        }
        r += f.name
    }
    return r
}

// «type 'User'» или запись анонимного типа — в сообщениях о полях.
fn type_label(si: int) -> str {
    if is_anon(si) {
        return structs[si].name
    }
    return "type '" + structs[si].name + "'"
}

// Первое поле без значения и без значения по умолчанию.
fn missing_first(fields: [Field], set: [bool]) -> str {
    var j = 0
    while j < fields.len() {
        if !set[j] && fields[j].def < 0 && tkind(fields[j].ty) != K_OPT {
            return fields[j].name
        }
        j += 1
    }
    return "field"
}

fn count_name(xs: [str], s: str) -> int {
    var n = 0
    for x in xs {
        if x == s {
            n += 1
        }
    }
    return n
}

// ---- Постфиксные операции: поле, метод, индекс, срез ----

fn parse_postfix(t0: int, at: Token) -> int {
    var t = t0
    // корень цепочки — для проверки изменений внутри tx (tx_mutation)
    let saved_root = mut_root
    let saved_fresh = mut_fresh
    mut_root = at
    mut_fresh = at.kind != T_IDENT
    while true {
        let k = kind()
        if k == '.' {
            advance()
            let nt = expect_ident()
            if panic_mode {
                mut_root = saved_root
                mut_fresh = saved_fresh
                return ty_err
            }
            if kind() == '(' {
                t = parse_method(t, nt)
                // результат метода — новое значение (кроме sort/reverse: тот же список)
                if !rw_same_method(nt.text) {
                    mut_fresh = true
                }
            } else {
                t = field_load(t, nt)
            }
        } else if k == '[' {
            t = parse_index(t)
        } else if k == '?' && kind_at(pos + 1) == '.' {
            syntax_error(tok(), "Khrip has no ?. operator", "unwrap first: let v = x else \{ ... } or if let v = x \{ ... }")
            mut_root = saved_root
            mut_fresh = saved_fresh
            return ty_err
        } else {
            // цепочка кончилась: запомнить, откуда она (let a = b.items — псевдоним)
            last_chain_root = mut_root
            last_chain_fresh = mut_fresh
            last_chain_end = pos
            mut_root = saved_root
            mut_fresh = saved_fresh
            return t
        }
    }
    return t
}

// ---- Изменения внутри tx ----
// Блок tx может выполниться снова после конфликта: всё, что он меняет вне
// базы, изменилось бы дважды. Корень цепочки (xs в xs.a[i].push(v)) — внешняя
// локальная, store или глобальная → ошибка.
var mut_root: Token = Token { kind: 0, val: 0, text: "", line: 0, col: 0, file: 0 }
var mut_fresh: bool
var last_chain_root: Token = Token { kind: 0, val: 0, text: "", line: 0, col: 0, file: 0 }
var last_chain_fresh: bool
var last_chain_end: int
// внутри tx: локальные, которые ссылаются на значения снаружи (let a = b,
// for x in xs) — менять их так же нельзя
var tx_aliases: [str]

fn tx_alias_has(name: str) -> bool {
    var i = tx_aliases.len() - 1
    while i >= 0 {
        if tx_aliases[i] == name {
            return true
        }
        i -= 1
    }
    return false
}

// Имя — значение снаружи блока tx: внешняя локальная, псевдоним, store, глобальная.
fn tx_is_outer(name: str) -> bool {
    let li = find_local(name)
    if li >= 0 {
        return li < tx_local_base || tx_alias_has(name)
    }
    let s = sym_find(name)
    return s >= 0 && sym_kind(s) == SK_GLOBAL
}

// Выражение toks[from..pos] — путь к значению снаружи tx (b, b.items, users[k])
// без вызовов методов, которые дают новое значение.
fn tx_alias_source(from: int) -> bool {
    if tx_depth == 0 || last_chain_end != pos || last_chain_fresh || last_chain_root.kind != T_IDENT {
        return false
    }
    let r = toks[from]
    if r.line != last_chain_root.line || r.col != last_chain_root.col || r.file != last_chain_root.file {
        return false
    }
    return tx_is_outer(r.text)
}

// Аргументы вызова, открытого скобкой open: для каждого — корень пути (xs в
// xs, b.items, m[k]) или "".
fn call_arg_roots(open: int) -> [str] {
    var out: [str] = []
    let close = matching_close(open)
    var i = open + 1
    while i < close {
        var j = i
        var depth = 0
        while j < close && !(depth == 0 && kind_at(j) == ',') {
            let k = kind_at(j)
            if k == '(' || k == '[' || k == '\{' {
                depth += 1
            } else if k == ')' || k == ']' || k == '}' {
                depth -= 1
            }
            j += 1
        }
        var root = ""
        if kind_at(i) == T_IDENT {
            var q = i + 1
            var path = true
            while q < j && path {
                if kind_at(q) == '.' && kind_at(q + 1) == T_IDENT && kind_at(q + 2) != '(' {
                    q += 2
                } else if kind_at(q) == '[' {
                    q = matching_close(q) + 1
                } else {
                    path = false
                }
            }
            if path {
                root = toks[i].text
            }
        }
        out.push(root)
        i = j + 1
    }
    return out
}

// Вызов функции программы внутри tx: она меняет параметр, а ей передали значение снаружи.
fn tx_arg_check(t: Token, fi: int, shift: int) {
    // скобка вызова — текущая или только что пройденная
    var open = pos
    if kind() != '(' {
        open = pos - 1
    }
    if kind_at(open) != '(' {
        return
    }
    let pm = fn_param_mut(fi)
    let roots = call_arg_roots(open)
    for a in 0..roots.len() {
        let p = a + shift
        if p < pm.len() && pm[p] && roots[a].byte_len() > 0 && tx_is_outer(roots[a]) {
            error_tok(t, t.text + "() changes its argument " + roots[a] + ", which comes from outside tx, and the block may run again after a conflict", "pass a copy, or call it after the block")
        }
    }
}

fn tx_mutation(at: Token) {
    if tx_depth == 0 || mut_fresh || mut_root.kind != T_IDENT {
        return
    }
    let name = mut_root.text
    let li = find_local(name)
    if li >= 0 {
        tx_outer_check(mut_root, li)
        return
    }
    let s = sym_find(name)
    if s >= 0 && sym_kind(s) == SK_GLOBAL {
        if globals[sym_idx(s)].is_store {
            error_tok(at, "store " + name + " is not rolled back with the tx block, and the block may run again after a conflict", "change it after the block, from the block's result")
        } else {
            error_tok(at, "'" + name + "' is a global, and the tx block may run again after a conflict", "change it after the block, from the block's result")
        }
    }
}

fn mutating_method(name: str) -> bool {
    return rw_mutating(name) || name == "extend" || name == "set" || name == "delete"
}

fn field_load(t: int, nt: Token) -> int {
    if t == ty_err {
        return ty_err
    }
    if tkind(t) == K_OPT && tkind(ty_inner(t)) == K_STRUCT {
        error_tok(nt, "the value may be none; unwrap it before reading ." + nt.text, "if let v = x \{ v." + nt.text + " } or let v = x else \{ return ... }")
        return ty_err
    }
    if tkind(t) == K_SUM {
        let s = types[t].a
        error_tok(nt, sums[s].name + " can be any of " + variant_names(s) + "; use match to read fields", "match x \{ " + structs[sums[s].variants[0]].name + " v => v." + nt.text + " ... }")
        return ty_err
    }
    if tkind(t) != K_STRUCT {
        let bytes = tkind(t) == K_STR && system_code(nt)
        var hint = ""
        if tkind(t) == K_STR {
            hint = str_method_hint(nt.text, bytes)
        }
        if hint == "" {
            hint = method_hint(nt.text, bytes)
        }
        if nt.text == "len" {
            hint = "use .len()"
            if bytes {
                hint = "use .byte_len()"
            }
        }
        error_tok(nt, ty_name(t) + " has no field '" + nt.text + "'", hint)
        return ty_err
    }
    let si = types[t].a
    let fi = field_find(si, nt.text)
    if fi < 0 {
        var hint = ""
        var best_d = 3
        for f in structs[si].fields {
            let d = edit_distance(nt.text, f.name)
            if d < best_d {
                best_d = d
                hint = "did you mean '" + f.name + "'?"
            }
        }
        if hint.byte_len() == 0 {
            if func_find(nt.text) >= 0 {
                hint = "to call the function, write ." + nt.text + "()"
            } else {
                hint = "its fields: " + field_names(si)
            }
        }
        error_tok(nt, type_label(si) + " has no field '" + nt.text + "'", hint)
        return ty_err
    }
    emit_load(RAX, RAX, fi * 8)
    return structs[si].fields[fi].ty
}

fn parse_index(t: int) -> int {
    let at = tok()
    advance()
    let saved = no_struct
    no_struct = false
    let k = tkind(t)
    if k == K_MAP {
        emit_push(RAX)
        let kt = tok()
        let it = parse_expr(types[t].a)
        coerce(it, types[t].a, kt)
        expect_tok(']')
        no_struct = saved
        emit_mov_rr(RSI, RAX)
        emit_pop(RDI)
        let vt = types[t].b
        // T? already has its optional representation; ty_opt(T?) is T?.
        // Boxing again would return a pointer to the box instead of its value.
        if is_ref(vt) || tkind(vt) == K_OPT {
            emit_call(rt_func("__map_get_ref"))
        } else {
            emit_call(rt_func("__map_get_box"))
        }
        return ty_opt(vt)
    }
    if k == K_OPT {
        error_tok(at, "the value may be none; unwrap it before indexing", "let v = x else \{ return ... }")
    } else if k != K_LIST && k != K_STR && t != ty_err {
        error_tok(at, ty_name(t) + " cannot be indexed", anon_map_hint(t))
    }
    // срез: [a..b], [..b], [a..]
    if kind() == T_DOTDOT {
        advance()
        emit_push(RAX)
        emit_mov_imm(RAX, 0)
        return finish_slice(t, at, saved)
    }
    want = ty_int
    if peek_simple(1) && is_int_like(op_ty) && kind_at(pos + 1) == ']' {
        advance()
        load_operand(RCX)
    } else {
        emit_push(RAX)
        let it = parse_expr(ty_int)
        if it != ty_int && it != ty_err {
            error_tok(at, "index must be int, found " + ty_name(it), mismatch_hint(it, ty_int))
        }
        if kind() == T_DOTDOT {
            advance()
            return finish_slice(t, at, saved)
        }
        emit_mov_rr(RCX, RAX)
        emit_pop(RAX)
    }
    if k == K_STR {
        system_str_error(at, "str index s[i]", "s.byte(i)")
    }
    expect_tok(']')
    no_struct = saved
    if k == K_STR && !system_code(at) {
        // символ i — строка из одного символа; вне [0, len) — паника
        emit_mov_rr(RDI, RAX)
        emit_mov_rr(RSI, RCX)
        emit_call(rt_func("__text_at"))
        return ty_str
    }
    if k == K_STR {
        emit_byte_at(at)
        return ty_int
    }
    emit_bounds_check(at)
    emit_load(RAX, RAX, 0)
    if k == K_LIST && ty_elem(t) == ty_bool {
        emit_movzx_index()
        return ty_bool
    }
    // mov rax, [rax + rcx*8]
    emit8(0x48)
    emit8(0x8B)
    emit8(0x04)
    emit8(0xC8)
    if k == K_LIST {
        return ty_elem(t)
    }
    return ty_err
}

// Получатель в стеке, начало среза в rax; текущий токен — после «..».
// Срез str в коде программы — в символах (__text_slice), в системном — в байтах.
fn finish_slice(t: int, at: Token, saved: bool) -> int {
    let text = tkind(t) == K_STR && !system_code(at)
    if tkind(t) == K_STR {
        system_str_error(at, "str slice", "s.byte_slice(a, b)")
    }
    emit_push(RAX)
    if kind() == ']' && text {
        // до конца: длину в символах считать незачем
        emit_mov_imm(RAX, SLICE_END)
    } else if kind() == ']' {
        // до конца: длина получателя
        emit_load(RDX, RSP, 8)
        if tkind(t) == K_STR {
            emit_str_len(RAX, RDX)
        } else {
            emit_load(RAX, RDX, 8)
        }
    } else {
        let et = parse_expr(ty_int)
        if et != ty_int && et != ty_err {
            error_tok(at, "slice bounds must be int", "")
        }
    }
    expect_tok(']')
    no_struct = saved
    emit_mov_rr(RDX, RAX)
    emit_pop(RSI)
    emit_pop(RDI)
    if text {
        emit_call(rt_func("__text_slice"))
        return ty_str
    }
    if tkind(t) == K_STR {
        emit_call(rt_func("__str_slice"))
        return ty_str
    }
    emit_call(rt_func("__list_slice"))
    return t
}

// ---- Вызовы ----

// Аргументы вызовов, которые сейчас разбираются (defer у compile_args): по
// одной записи на аргумент, у вложенных вызовов — выше. arg_kind = -1 —
// значение в стеке, иначе это простое значение (OPK_IMM, OPK_LOCAL — число или
// неизменяемая локальная arg_val), и в стек оно не кладётся: его загрузят прямо
// в регистр аргумента (emit_call_args) или подставят параметром встроенного тела.
var arg_kind: [int]
var arg_val: [int]

// Значение аргумента в rax: в стек или (defer и оно простое) — запись без кода.
fn push_arg(defer: bool) {
    if defer && take_simple_if(simple_mut && rest_pure()) {
        arg_kind.push(op_kind)
        arg_val.push(op_val)
        return
    }
    emit_push(RAX)
    if defer {
        arg_kind.push(-1)
        arg_val.push(0)
    }
}

// Снять записи n последних аргументов → сколько из них лежит в стеке.
fn args_done(n: int) -> int {
    var pushed = 0
    var i = 0
    while i < n {
        if arg_kind.pop() < 0 {
            pushed += 1
        }
        arg_val.pop()
        i += 1
    }
    return pushed
}

// Аргументы по параметрам ps начиная с first; каждый кладётся в стек, а при
// defer простые значения — в записи arg_kind/arg_val (снять — args_done).
// → число аргументов.
fn compile_args(ps: [Param], first: int, tt: int, kt: int, vt: int, name: str, at: Token, defer: bool) -> int {
    let saved = no_struct
    no_struct = false
    var n = 0
    var i = first
    while kind() != ')' && kind() != T_EOF && !panic_mode {
        let a = tok()
        var pt = ty_err
        if i < ps.len() {
            pt = subst(ps[i].ty, tt, kt, vt)
        }
        let t = parse_expr(pt)
        if i < ps.len() {
            coerce(t, pt, a)
        }
        push_arg(defer)
        n += 1
        i += 1
        if kind() == ',' {
            advance()
        } else if kind() != ')' {
            syntax_error(tok(), "expected ',' or ')' in the call, found " + tok_show(tok()), "")
        }
    }
    // недостающие аргументы — значения по умолчанию (литералы из объявления)
    let given = i
    while kind() == ')' && i < ps.len() && ps[i].def >= 0 && !panic_mode {
        let back = pos
        pos = ps[i].def
        let pt = subst(ps[i].ty, tt, kt, vt)
        let t = parse_expr(pt)
        coerce(t, pt, toks[ps[i].def])
        pos = back
        push_arg(defer)
        n += 1
        i += 1
    }
    expect_tok(')')
    no_struct = saved
    if i != ps.len() && !panic_mode {
        var want_n = 0
        var sig = ""
        var j = first
        while j < ps.len() {
            if sig.byte_len() > 0 {
                sig += ", "
            }
            sig += ps[j].name + ": " + ty_name(ps[j].ty)
            if ps[j].def < 0 {
                want_n += 1
            }
            j += 1
        }
        let got = given - first
        var takes = want_n.to_str()
        if want_n != ps.len() - first {
            takes = want_n.to_str() + " to " + (ps.len() - first).to_str()
        }
        error_tok(at, "'" + name + "' takes " + takes + " argument(s), got " + got.to_str(), name + "(" + sig + ")")
    }
    return n
}

fn in_inline_stack(fi: int) -> bool {
    for x in inline_stack {
        if x == fi {
            return true
        }
    }
    return false
}

// Вызов функции fi, аргументы (n штук) в стеке; deferred — у них есть записи
// arg_kind/arg_val (compile_args с defer, не больше 6 аргументов), и простые
// значения в стек не клались.
fn emit_call_args(fi: int, n: int, deferred: bool) {
    if n == funcs[fi].params.len() && funcs[fi].inline_ok && inline_depth < 3 && fi != cur_fn && !in_inline_stack(fi) && nerrors == 0 {
        inline_call(fi, n, deferred)
    } else if deferred {
        // из стека — в обратном порядке, простые значения — прямо в регистры
        let base = arg_kind.len() - n
        var i = n - 1
        while i >= 0 {
            if arg_kind[base + i] < 0 {
                emit_pop(arg_reg(i))
            }
            i -= 1
        }
        i = 0
        while i < n {
            if arg_kind[base + i] >= 0 {
                op_kind = arg_kind[base + i]
                op_val = arg_val[base + i]
                load_operand(arg_reg(i))
            }
            i += 1
        }
        emit_call(fi)
    } else {
        emit_args_to_regs(n)
        emit_call(fi)
        emit_args_cleanup(n)
    }
    if deferred {
        args_done(n)
    }
}

// Встраивание: тело функции разбирается заново на месте вызова. Параметр,
// которому передали неизменяемую локальную (deferred), — она же (её регистр или
// ячейка): параметр тоже не меняется; число — в свою ячейку, без стека.
fn inline_call(fi: int, n: int, deferred: bool) {
    let f = funcs[fi]
    var slots: [int] = []
    var regs: [int] = []
    var base = 0
    if deferred {
        base = arg_kind.len() - n
    }
    var i = 0
    while i < n {
        var r = -1
        var off = 0
        if deferred && arg_kind[base + i] == OPK_LOCAL {
            let l = locals[arg_val[base + i]]
            r = l.reg
            off = l.off
        } else {
            off = new_slot()
        }
        regs.push(r)
        slots.push(off)
        i += 1
    }
    i = n - 1
    while i >= 0 {
        if !deferred || arg_kind[base + i] < 0 {
            emit_pop(RAX)
            // значение ещё в rax: чтение параметра сразу за записью не нужно
            stored_at = code_len
            emit_store(RBP, slots[i], RAX)
            stored_end = code_len
            stored_reg = -1
            stored_off = slots[i]
        }
        i -= 1
    }
    i = 0
    while i < n {
        if deferred && arg_kind[base + i] == OPK_IMM {
            emit_mov_imm(RAX, arg_val[base + i])
            emit_store(RBP, slots[i], RAX)
        }
        i += 1
    }
    let saved_pos = pos
    let saved_n = nlocals
    let saved_floor = local_floor
    let saved_ret = fn_ret_ty
    let saved_ns = no_struct
    let saved_want = want
    let saved_loop = loop_depth
    local_floor = nlocals
    i = 0
    while i < n {
        add_local(f.params[i].name, f.params[i].ty, false, regs[i], slots[i])
        i += 1
    }
    fn_ret_ty = f.ret
    no_struct = false
    loop_depth = 0
    inline_depth += 1
    quiet += 1
    inline_stack.push(fi)
    let base = inline_rets.len()
    pos = f.body
    parse_block()
    // return в самом конце тела — переход на следующую инструкцию
    if inline_rets.len() > base && inline_rets[inline_rets.len() - 1] == code_len - 4 && code_len - 5 >= barrier {
        inline_rets.pop()
        code_rollback(code_len - 5)
    }
    // метка конца — только если на неё есть переходы: иначе записи о последней
    // инструкции тела (простое значение, setcc) годятся и после встраивания
    if inline_rets.len() > base {
        let end = here()
        while inline_rets.len() > base {
            patch_rel(inline_rets.pop(), end)
        }
    }
    inline_stack.pop()
    quiet -= 1
    inline_depth -= 1
    pos = saved_pos
    locals_to(saved_n)
    local_floor = saved_floor
    fn_ret_ty = saved_ret
    no_struct = saved_ns
    want = saved_want
    loop_depth = saved_loop
}

// Значение int/bool/str в rax → str.
fn emit_to_str(t: int, at: Token) -> bool {
    if t == ty_str || t == ty_err {
        return true
    }
    emit_mov_rr(RDI, RAX)
    if t == ty_int {
        emit_call(rt_func("__int_to_str"))
        return true
    }
    if t == ty_bool {
        emit_call(rt_func("__bool_to_str"))
        return true
    }
    if t == ty_float {
        emit_call(rt_func("__float_to_str"))
        return true
    }
    var hint = "interpolate its fields, or write to_json(x)"
    if tkind(t) == K_OPT {
        hint = "it may be none: write x ?? \"default\" (\{x ?? 0} for a number), or unwrap it first with if let"
    } else if tkind(t) == K_LIST || tkind(t) == K_MAP {
        hint = "write to_json(x); a [str] joins with xs.join(\", \")"
    } else if tkind(t) == K_SUM {
        hint = "match on it, or write to_json(x)"
    }
    error_tok(at, "cannot turn " + ty_name(t) + " into text", hint)
    return false
}

fn builtin_args(n: int, at: Token, name: str) -> int {
    return builtin_args_d(n, at, name, false)
}

// Аргументы встроенной функции → регистры regs по порядку: из стека, а
// простые значения — прямо в регистр (как у вызова, push_arg).
fn builtin_regs(n: int, at: Token, name: str, regs: [int]) -> int {
    let got = builtin_args_d(n, at, name, true)
    let base = arg_kind.len() - got
    var i = got - 1
    while i >= 0 {
        if arg_kind[base + i] < 0 && i < regs.len() {
            emit_pop(regs[i])
        }
        i -= 1
    }
    i = 0
    while i < got {
        if arg_kind[base + i] >= 0 && i < regs.len() {
            op_kind = arg_kind[base + i]
            op_val = arg_val[base + i]
            load_operand(regs[i])
        }
        i += 1
    }
    args_done(got)
    return got
}

fn builtin_args_d(n: int, at: Token, name: str, defer: bool) -> int {
    let saved = no_struct
    no_struct = false
    var got = 0
    while kind() != ')' && kind() != T_EOF && !panic_mode {
        let a = tok()
        let t = parse_expr(ty_int)
        if t != ty_int && t != ty_err {
            error_tok(a, name + " takes int arguments, found " + ty_name(t), "")
        }
        push_arg(defer)
        got += 1
        if kind() == ',' {
            advance()
        } else if kind() != ')' {
            syntax_error(tok(), "expected ',' or ')' in the call", "")
        }
    }
    expect_tok(')')
    no_struct = saved
    if n >= 0 && got != n {
        error_tok(at, name + " takes " + n.to_str() + " argument(s), got " + got.to_str(), "")
    }
    return got
}

// Встроенные функции. → тип или -1, если это не встроенная.
// setjmp по буферу в rax: rip, rsp, rbp, rbx, r12–r15; повторный возврат — с 1.
fn emit_setjmp_rax() {
    emit8(0x48)
    emit8(0x8D)
    emit8(0x0D)
    let lea = emit_hole()
    emit_store(RAX, 0, RCX)
    emit_store(RAX, 8, RSP)
    emit_store(RAX, 16, RBP)
    emit_store(RAX, 24, RBX)
    emit_store(RAX, 32, R12)
    emit_store(RAX, 40, R13)
    emit_store(RAX, 48, R14)
    emit_store(RAX, 56, R15)
    emit8(0x31)
    emit8(0xC0)
    emit8(0xEB)
    emit8(0x05)
    patch_rel(lea, code_len)
    emit8(0xB8)
    emit32(1)
    barrier = code_len
}

// store8/store32/store64(адрес, значение). Адрес x + число — число смещением; если
// x — простое значение (неизменяемая локальная, число), стек не нужен: значение
// считается в rax, а адрес — регистр x или rcx.
fn parse_store(t: Token, name: str) -> int {
    advance()
    let saved = no_struct
    no_struct = false
    var got = 0
    var disp = 0
    var base = -1
    var deferred = false
    var lk = 0
    var lv = 0
    while kind() != ')' && kind() != T_EOF && !panic_mode {
        let a = tok()
        let ty = parse_expr(ty_int)
        if ty != ty_int && ty != ty_err {
            error_tok(a, name + " takes int arguments, found " + ty_name(ty), "")
        }
        got += 1
        if got == 1 {
            disp = take_addimm()
            deferred = take_simple_if(simple_mut && rest_pure())
            lk = op_kind
            lv = op_val
            if deferred && lk == OPK_LOCAL && locals[lv].reg >= 0 {
                base = locals[lv].reg
            }
            if !deferred {
                emit_push(RAX)
            }
        }
        if kind() == ',' {
            advance()
        } else if kind() != ')' {
            syntax_error(tok(), "expected ',' or ')' in the call", "")
        }
    }
    expect_tok(')')
    no_struct = saved
    if got != 2 {
        error_tok(t, name + " takes 2 argument(s), got " + got.to_str(), "")
        return ty_void
    }
    var src = RAX
    // значение — число: mov [адрес], число (без rax); локальная в регистре —
    // прямо из него
    var imm = false
    var iv = 0
    if simple_kind == OPK_IMM && (name == "store8" || fits_i32(simple_val)) {
        let k0 = op_kind
        let v0 = op_val
        if take_simple() {
            imm = true
            iv = op_val
        }
        op_kind = k0
        op_val = v0
    } else if simple_kind == OPK_LOCAL && name != "store8" && locals[simple_val].reg >= 0 {
        let k0 = op_kind
        let v0 = op_val
        if take_simple_if(true) {
            src = locals[op_val].reg
        }
        op_kind = k0
        op_val = v0
    }
    if base < 0 {
        if deferred {
            op_kind = lk
            op_val = lv
            load_operand(RCX)
        } else {
            emit_pop(RCX)
        }
        base = RCX
    }
    if imm {
        if name == "store8" {
            emit_mem_sized(0xC6, 0, base, disp, false)
            emit8(iv & 255)
        } else {
            emit_mem_sized(0xC7, 0, base, disp, name == "store64")
            emit32(iv & 0xFFFFFFFF)
        }
    } else if name == "store8" {
        emit_mem_sized(0x88, src, base, disp, false)
    } else if name == "store32" {
        emit_mem_sized(0x89, src, base, disp, false)
    } else {
        emit_mem_sized(0x89, src, base, disp, true)
    }
    return ty_void
}

fn parse_builtin(t: Token, w: int) -> int {
    let name = t.text
    if name == "load8" || name == "load32" || name == "load64" {
        advance()
        builtin_args(1, t, name)
        emit_pop(RAX)
        // адрес x + число: число — смещением; x — неизменяемая локальная в
        // регистре: прямо [регистр + смещение]
        let disp = take_addimm()
        let index = take_addreg()
        var base = take_regload()
        if base < 0 {
            base = RAX
        }
        if name == "load8" {
            emit_mem_index(0x0FB6, RAX, base, index, disp, false)
        } else if name == "load32" {
            // mov eax, [...] (старшие 32 бита — нули)
            emit_mem_index(0x8B, RAX, base, index, disp, false)
        } else {
            emit_mem_index(0x8B, RAX, base, index, disp, true)
        }
        return ty_int
    }
    if name == "store8" || name == "store32" || name == "store64" {
        return parse_store(t, name)
    }
    if name == "syscall" {
        advance()
        builtin_regs(-1, t, name, [RAX, RDI, RSI, RDX, R10, R8, R9])
        emit8(0x0F)
        emit8(0x05)
        return ty_int
    }
    if name == "__ctx" {
        advance()
        expect_tok(')')
        // mov rax, fs:[0]
        emit8(0x64)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x04)
        emit8(0x25)
        emit32(0)
        return ty_int
    }
    if name == "__cast" {
        advance()
        let t1 = parse_expr(ty_err)
        expect_tok(')')
        if w == ty_err {
            error_tok(t, "__cast needs a known target type", "")
            return ty_err
        }
        return w
    }
    if name == "__chdb_root" && files[t.file].is_lib {
        // корень мест ch, соединений и таблиц ClickHouse (src/coll.kh)
        advance()
        expect_tok(')')
        emit_mov_imm(RAX, ch_root())
        return ty_int
    }
    if name == "__db_root" && files[t.file].is_lib {
        // корень таблиц мест sql и миграций (src/sql.kh)
        advance()
        expect_tok(')')
        emit_mov_imm(RAX, sql_root())
        return ty_int
    }
    if name == "__gc_roots" && files[t.file].is_lib {
        // таблица корней store для сборщика (lib/gc.kh)
        advance()
        expect_tok(')')
        emit_mov_imm(RAX, gc_root_table())
        return ty_int
    }
    if name == "__data_end" && files[t.file].is_lib {
        // конец данных программы (lib/api.kh, __in_data): mov rax, imm64, а число
        // подставит resolve_fixups, когда данные больше не растут
        advance()
        expect_tok(')')
        emit8(0x48)
        emit8(0xB8)
        fixups.push(Fixup { at: code_len, func: FIX_DATA_END })
        emit64(0)
        return ty_int
    }
    if name == "__to_str" {
        advance()
        let a = tok()
        let t1 = parse_expr(ty_err)
        expect_tok(')')
        emit_to_str(t1, a)
        return ty_str
    }
    // встроенные функции драйвера — только когда он подключён: иначе это
    // своя функция программы с тем же именем
    if ((name == "to_bson" || name == "from_bson") && drv_bson) || ((name == "ch_encode" || name == "ch_decode") && drv_ch) {
        return parse_database_builtin(t, w)
    }
    if name == "to_json" {
        advance()
        let a = tok()
        let saved = no_struct
        no_struct = false
        let t1 = parse_expr(ty_err)
        no_struct = saved
        expect_tok(')')
        let d = type_desc(t1)
        if d == 0 {
            if t1 != ty_err {
                error_tok(a, "cannot turn " + ty_name(t1) + " into JSON", "")
            }
            return ty_str
        }
        emit_mov_rr(RDI, RAX)
        emit_mov_imm(RSI, d)
        emit_call(rt_func("__json_encode"))
        return ty_str
    }
    // __from_json_lenient — from_json для снимка KHRIP_DATA (только библиотека и
    // сгенерированный код): неправильный UTF-8 — U+FFFD, а не ошибка
    let lenient = name == "__from_json_lenient" && files[t.file].is_lib
    if name == "from_json" || lenient {
        advance()
        let a = tok()
        let t1 = parse_expr(ty_str)
        coerce(t1, ty_str, a)
        expect_tok(')')
        let inner = ty_inner(w)
        let d = type_desc(inner)
        if w == ty_err || d == 0 {
            error_tok(t, "from_json needs to know the result type", "let user: User? = from_json(text)")
            return ty_err
        }
        emit_mov_rr(RDI, RAX)
        emit_mov_imm(RSI, d)
        if lenient {
            emit_call(rt_func("__json_decode_lenient"))
        } else {
            emit_call(rt_func("__json_decode"))
        }
        return ty_opt(inner)
    }
    let lib_only = name == "__fsqrt" || name.starts_with("__simd_") || name == "__sha256_x64" || name == "__sha512_x64" || name == "__cpu_aes" || name == "__aes_ctr" || name == "__ghash" || name == "__chacha_block" || name == "__mp_add" || name == "__mp_sub" || name == "__mont_mul" || name == "__madd" || name == "__msub" || name == "__wmul" || name == "__cpu_avx2" || name == "__cpu_pdep" || name == "__cpu_sha" || name == "__spawn" || name == "__co_call" || name == "__file_name" || name == "__setjmp" || name == "__longjmp" || name == "__cas" || name == "__xchg" || name == "__xadd" || name == "__memcpy" || name == "__memset" || name == "__data_end" || name == "__data_hex" || name == "__gc_roots" || name == "__ctz" || name == "__clz" || name == "__sp" || name == "__cpu_pause" || name == "__noinline" || name == "__save_area" || name == "__str_ptrw" || name == "__str_lenw"
    if lib_only && !files[t.file].is_lib {
        return -1
    }
    if name == "__setjmp" {
        advance()
        builtin_args(1, t, name)
        emit_pop(RAX)
        emit_setjmp_rax()
        return ty_int
    }
    if name == "__longjmp" {
        advance()
        builtin_args(1, t, name)
        emit_pop(RAX)
        emit_load(RBX, RAX, 24)
        emit_load(R12, RAX, 32)
        emit_load(R13, RAX, 40)
        emit_load(R14, RAX, 48)
        emit_load(R15, RAX, 56)
        emit_load(RBP, RAX, 16)
        emit_load(RSP, RAX, 8)
        // jmp [rax]
        emit8(0xFF)
        emit8(0x20)
        return ty_void
    }
    if name == "__simd_find_byte" || name == "__simd_find_json" || name == "__simd_find_crlf2" {
        advance()
        if name == "__simd_find_byte" {
            builtin_regs(3, t, name, [RDI, RSI, RDX])
        } else {
            builtin_regs(2, t, name, [RDI, RSI])
        }
        if name == "__simd_find_byte" {
            emit_simd_find_byte()
        } else if name == "__simd_find_json" {
            emit_simd_find_json()
        } else {
            emit_simd_find_crlf2()
        }
        return ty_int
    }
    if name == "__simd_utf8_scan" || name == "__simd_utf8_skip" || name == "__simd_utf8_seek" || name == "__simd_find_json_hi" {
        advance()
        if name == "__simd_utf8_skip" || name == "__simd_utf8_seek" {
            builtin_regs(3, t, name, [RDI, RSI, RDX])
        } else {
            builtin_regs(2, t, name, [RDI, RSI])
        }
        if name == "__simd_utf8_scan" {
            emit_simd_utf8_scan()
        } else if name == "__simd_utf8_skip" {
            emit_simd_utf8_skip()
        } else if name == "__simd_utf8_seek" {
            emit_simd_utf8_seek()
        } else {
            emit_simd_find_json_hi()
        }
        return ty_int
    }
    if name == "__simd_case" {
        advance()
        builtin_regs(4, t, name, [RDI, RSI, RDX, RCX])
        emit_simd_case()
        return ty_int
    }
    if name == "__simd_pinscan" {
        // слова со значением в STORE (lib/gc.kh, записи сборщика)
        advance()
        builtin_regs(3, t, name, [RDI, RSI, RDX])
        emit_simd_pinscan()
        return ty_int
    }
    if name == "__data_hex" {
        // таблица из шестнадцатеричного литерала: байты кладутся в DATA при
        // компиляции, в программе — только адрес
        advance()
        let a = tok()
        var addr = -1
        if a.kind == T_STR {
            addr = data_hex_table(strlits[a.val])
            advance()
        } else {
            parse_expr(ty_err)
        }
        expect_tok(')')
        if addr < 0 {
            error_tok(a, "__data_hex takes a string literal of hex digit pairs", "__data_hex(\"0F C0 FF\")")
            addr = 0
        }
        emit_mov_imm(RAX, addr)
        return ty_int
    }
    if name == "__cpu_sha" {
        advance()
        expect_tok(')')
        emit_cpu_sha()
        return ty_bool
    }
    if name == "__simd_sha256" || name == "__sha256_x64" || name == "__sha512_x64" {
        advance()
        builtin_args(3, t, name)
        emit_pop(RDX)
        emit_pop(RSI)
        emit_pop(RDI)
        if name == "__simd_sha256" {
            emit_sha256_ni()
        } else if name == "__sha256_x64" {
            emit_sha256_x64()
        } else {
            emit_sha512_x64()
        }
        return ty_void
    }
    if name == "__cpu_aes" {
        advance()
        expect_tok(')')
        emit_cpu_aes()
        return ty_bool
    }
    if name == "__aes_ctr" {
        advance()
        builtin_args(6, t, name)
        emit_pop(R9)
        emit_pop(R8)
        emit_pop(RCX)
        emit_pop(RDX)
        emit_pop(RSI)
        emit_pop(RDI)
        emit_aes_ctr()
        return ty_void
    }
    if name == "__ghash" {
        advance()
        builtin_args(4, t, name)
        emit_pop(RCX)
        emit_pop(RDX)
        emit_pop(RSI)
        emit_pop(RDI)
        emit_ghash()
        return ty_void
    }
    if name == "__mp_add" || name == "__mp_sub" {
        advance()
        builtin_args(4, t, name)
        emit_pop(RCX)
        emit_pop(RDX)
        emit_pop(RSI)
        emit_pop(RDI)
        if name == "__mp_add" {
            emit_mp_addsub(0x13)
        } else {
            emit_mp_addsub(0x1B)
        }
        return ty_int
    }
    if name == "__mont_mul" {
        advance()
        builtin_args(6, t, name)
        emit_pop(R9)
        emit_pop(R8)
        emit_pop(RCX)
        emit_pop(RDX)
        emit_pop(RSI)
        emit_pop(RDI)
        emit_mont_mul()
        return ty_void
    }
    if name == "__madd" || name == "__msub" {
        advance()
        builtin_args(5, t, name)
        emit_pop(R8)
        emit_pop(RCX)
        emit_pop(RDX)
        emit_pop(RSI)
        emit_pop(RDI)
        emit_mod_addsub(name == "__madd")
        return ty_void
    }
    if name == "__wmul" {
        // произведение по модулю 2^64, без проверки переполнения
        advance()
        builtin_args(2, t, name)
        emit_pop(RCX)
        emit_pop(RAX)
        // imul rax, rcx
        emit_hex("48 0F AF C1")
        return ty_int
    }
    if name == "__chacha_block" {
        advance()
        builtin_args(2, t, name)
        emit_pop(RSI)
        emit_pop(RDI)
        emit_chacha_block()
        return ty_void
    }
    if name == "__cpu_avx2" {
        advance()
        expect_tok(')')
        emit_cpu_avx2()
        return ty_bool
    }
    if name == "__cpu_pdep" {
        advance()
        expect_tok(')')
        emit_cpu_pdep()
        return ty_bool
    }
    if name == "__spawn" {
        // __spawn(вершина стека, аргумент): новый поток (clone) выполняет
        // __thread_main(аргумент) и завершается
        advance()
        builtin_args(2, t, name)
        emit_pop(RSI)
        emit_pop(RDI)
        // mov [rdi-8], rsi; lea rsi, [rdi-16]
        emit8(0x48)
        emit8(0x89)
        emit8(0x77)
        emit8(0xF8)
        emit8(0x48)
        emit8(0x8D)
        emit8(0x77)
        emit8(0xF0)
        // CLONE_VM | FS | FILES | SIGHAND | THREAD | SYSVSEM
        emit_mov_imm(RDI, 0x50F00)
        emit_mov_imm(RDX, 0)
        emit_mov_imm(R10, 0)
        emit_mov_imm(R8, 0)
        emit_mov_imm(RAX, 56)
        emit8(0x0F)
        emit8(0x05)
        emit_test_rax()
        let parent = emit_jcc(CC_NE)
        // поток: аргумент на его стеке
        emit_load(RDI, RSP, 8)
        emit_mov_imm(RBP, 0)
        emit_call(rt_func("__thread_main"))
        emit_mov_imm(RDI, 0)
        emit_mov_imm(RAX, 60)
        emit8(0x0F)
        emit8(0x05)
        patch_here(parent)
        return ty_int
    }
    if name == "__co_call" {
        // __co_call(вершина стека, сопрограмма): перейти на стек запросов и
        // выполнить __co_main(сопрограмма); возврата нет (lib/http.kh)
        advance()
        builtin_args(2, t, name)
        emit_pop(RDI)
        emit_pop(RAX)
        // mov rsp, rax
        emit8(0x48)
        emit8(0x89)
        emit8(0xC4)
        emit_mov_imm(RBP, 0)
        emit_call(rt_func("__co_main"))
        emit8(0x0F)
        emit8(0x0B)
        barrier = code_len
        return ty_void
    }
    if name == "__fsqrt" {
        advance()
        let a = tok()
        let t1 = parse_expr(ty_float)
        coerce(t1, ty_float, a)
        expect_tok(')')
        // movq xmm0, rax; sqrtsd xmm0, xmm0; movq rax, xmm0
        emit_hex("66 48 0F 6E C0 F2 0F 51 C0 66 48 0F 7E C0")
        return ty_float
    }
    if name == "__file_name" {
        advance()
        builtin_args(1, t, name)
        emit_pop(RAX)
        // mov rax, [таблица + rax*8]
        emit8(0x48)
        emit8(0x8B)
        emit8(0x04)
        emit8(0xC5)
        emit32(file_table())
        return ty_str
    }
    if name == "__cas" {
        // lock cmpxchg [rdx], rcx; rax — ожидаемое значение
        advance()
        builtin_args(3, t, name)
        emit_pop(RCX)
        emit_pop(RAX)
        emit_pop(RDX)
        emit8(0xF0)
        emit8(0x48)
        emit8(0x0F)
        emit8(0xB1)
        emit8(0x0A)
        emit_setcc(CC_E)
        return ty_bool
    }
    if name == "__ctz" || name == "__clz" {
        // число нулевых битов справа (__ctz) или слева (__clz); у нуля — 64
        advance()
        builtin_args(1, t, name)
        emit_pop(RAX)
        if name == "__ctz" {
            // mov ecx, 64; bsf rax, rax; cmovz rax, rcx
            emit_hex("B9 40 00 00 00 48 0F BC C0 48 0F 44 C1")
        } else {
            // mov ecx, 127; bsr rax, rax; cmovz rax, rcx; xor rax, 63
            emit_hex("B9 7F 00 00 00 48 0F BD C0 48 0F 44 C1 48 83 F0 3F")
        }
        return ty_int
    }
    if name == "__str_ptrw" || name == "__str_lenw" {
        // адрес байтов и длина строки обоих видов без ветвления (lib/core.kh,
        // __str_ptr и __str_len; src/emit.kh)
        advance()
        builtin_args(1, t, name)
        emit_pop(RAX)
        if name == "__str_ptrw" {
            emit_str_ptr(RAX, RAX)
        } else {
            emit_mov_rr(RDX, RAX)
            emit_str_len(RAX, RDX)
        }
        return ty_int
    }
    if name == "__sp" {
        // указатель стека здесь: mov rax, rsp (вершина стека потока, lib/rt.kh)
        advance()
        expect_tok(')')
        emit_hex("48 89 E0")
        return ty_int
    }
    if name == "__save_area" {
        // байт места сохранения rbx, r12–r15 под rbp каждой функции
        // (SAVE_REGS, src/expr.kh): запись контекста копирует стек от rbp
        // минус оно (lib/gc.kh, __pin_publish)
        advance()
        expect_tok(')')
        emit_mov_imm(RAX, SAVE_REGS * 8)
        return ty_int
    }
    if name == "__cpu_pause" {
        // pause: подсказка процессору в цикле ожидания (lib/gc.kh)
        advance()
        expect_tok(')')
        emit_hex("F3 90")
        return ty_void
    }
    if name == "__noinline" {
        // метка: функцию с ней не встраивают (can_inline, src/decl.kh) — для
        // редких путей библиотеки, которые встроились бы во многие места;
        // кода нет
        advance()
        expect_tok(')')
        return ty_void
    }
    if name == "__xchg" || name == "__xadd" {
        advance()
        builtin_args(2, t, name)
        emit_pop(RAX)
        emit_pop(RDX)
        if name == "__xchg" {
            // xchg [rdx], rax
            emit8(0x48)
            emit8(0x87)
            emit8(0x02)
        } else {
            // lock xadd [rdx], rax
            emit8(0xF0)
            emit8(0x48)
            emit8(0x0F)
            emit8(0xC1)
            emit8(0x02)
        }
        return ty_int
    }
    if name == "__memset" {
        // rep stosb: rdi = куда, al = байт, rcx = сколько
        advance()
        builtin_regs(3, t, name, [RDI, RAX, RCX])
        emit8(0xF3)
        emit8(0xAA)
        return ty_void
    }
    if name == "__memcpy" {
        // rep movsb: rdi = куда, rsi = откуда, rcx = сколько
        advance()
        builtin_regs(3, t, name, [RDI, RSI, RCX])
        emit8(0xF3)
        emit8(0xA4)
        return ty_void
    }
    if name == "len" {
        advance()
        let a = tok()
        let ai = pos
        let t1 = parse_expr(ty_err)
        // аргумент из одного токена может быть литералом
        var lit = -1
        if pos == ai + 1 {
            lit = ai
        }
        expect_tok(')')
        let k = tkind(t1)
        if k == K_STR {
            system_str_error(t, "len(str)", "s.byte_len()")
        }
        if k == K_STR && !system_code(t) {
            emit_text_len(lit)
            return ty_int
        }
        if k == K_STR {
            emit_mov_rr(RDX, RAX)
            emit_str_len(RAX, RDX)
            return ty_int
        }
        if k == K_LIST || k == K_MAP {
            emit_load(RAX, RAX, 8)
            return ty_int
        }
        if t1 != ty_err {
            error_tok(a, ty_name(t1) + " has no length", "")
        }
        return ty_err
    }
    if name == "print" || name == "eprint" || name == "write" {
        advance()
        let a = tok()
        let saved = no_struct
        no_struct = false
        let t1 = parse_expr(ty_str)
        no_struct = saved
        if kind() == ',' {
            error_tok(tok(), name + " takes one value", "combine values with interpolation: " + name + "(\"\{a} \{b}\")")
            while kind() != ')' && kind() != T_EOF {
                advance()
            }
        }
        expect_tok(')')
        if emit_to_str(t1, a) {
            emit_mov_rr(RDI, RAX)
            emit_call(rt_func(name))
        }
        last_was_call = true
        return ty_void
    }
    return -1
}

// Имя встроенного метода какого-нибудь типа: sum(xs) пишут по привычке
// других языков, а это метод — xs.sum().
fn builtin_method_any(name: str) -> bool {
    if str_method_args(name) >= 0 || name == "trim" {
        return true
    }
    if name == "push" || name == "pop" || name == "last" || name == "insert" || name == "remove_at" || name == "truncate" || name == "copy" || name == "reverse" || name == "join" || name == "sum" {
        return true
    }
    if name == "abs" || name == "min" || name == "max" || name == "round" || name == "floor" || name == "ceil" || name == "round_to" || name == "sqrt" {
        return true
    }
    return name == "index_of" || name == "sort" || name == "sort_by" || name == "map" || name == "filter" || name == "any" || name == "all" || name == "count" || name == "has" || name == "keys" || name == "values"
}

// Подсказка «это метод»: аргументы — простые имена и литералы, тогда x.имя(y),
// иначе общий вид. ( за именем — на pos или перед ним (parse_call уже шагнул).
fn method_form_hint(name: str) -> str {
    var open = pos
    if kind_at(open) != '(' {
        open = pos - 1
    }
    if kind_at(open) != '(' {
        return ""
    }
    let close = matching_close(open)
    var args: [str] = []
    var i = open + 1
    var simple = close > open + 1
    while simple && i < close {
        let k = toks[i].kind
        if (k == T_IDENT || k == T_INT || k == T_FLOAT || k == T_STR) && (i + 1 == close || toks[i + 1].kind == ',') {
            args.push(toks[i].text)
            i += 2
        } else {
            simple = false
        }
    }
    if simple && args.len() > 0 {
        var rest = ""
        var j = 1
        while j < args.len() {
            if j > 1 {
                rest += ", "
            }
            rest += args[j]
            j += 1
        }
        return name + " is a method: write " + args[0] + "." + name + "(" + rest + ")"
    }
    return name + " is a method of its first argument: write x." + name + "(...)"
}

fn parse_call(t: Token, w: int) -> int {
    if tx_depth > 0 && (t.text == "fetch" || t.text == "sleep" || driver_io(t.text)) && !files[t.file].is_lib {
        error_tok(t, t.text + " inside tx runs again on every retry and holds a database connection", "call it before or after the tx block")
    }
    let bt = parse_builtin(t, w)
    if bt >= 0 {
        last_was_call = true
        return bt
    }
    let name = t.text
    let fi = func_find(name)
    advance()
    if fi < 0 {
        var hint = name_hint(name)
        if hint.byte_len() == 0 && builtin_method_any(name) {
            hint = method_form_hint(name)
        }
        if hint.byte_len() == 0 {
            let s = similar_name(name)
            if s.byte_len() > 0 {
                hint = "did you mean '" + s + "'?"
            }
        }
        if struct_find(name) >= 0 {
            hint = "create a value with " + name + " \{ field: value }"
        }
        error_tok(t, "unknown function '" + name + "'", hint)
        // разобрать аргументы, чтобы продолжить
        var ps: [Param] = []
        let n = compile_args(ps, 0, ty_err, ty_err, ty_err, name, t, false)
        emit_alu_imm(0, RSP, n * 8)
        return ty_err
    }
    let f = funcs[fi]
    if tx_depth > 0 && !f.is_lib {
        let why = fn_effect(fi)
        if why != "" {
            error_tok(t, name + "() " + why + ", and the tx block may run again after a conflict", "call it before or after the tx block")
        }
        tx_arg_check(t, fi, 0)
    }
    // текущая лексема — первый аргумент, перед ней — (
    if f.is_lib {
        driver_query_check(t, pos - 1, 1)
    }
    // не больше 6 аргументов — все в регистрах: простые значения — без стека
    let defer = f.params.len() <= 6
    let n = compile_args(f.params, 0, ty_err, ty_err, ty_err, name, t, defer)
    if n != f.params.len() {
        var pushed = n
        if defer {
            pushed = args_done(n)
        }
        emit_alu_imm(0, RSP, pushed * 8)
        return f.ret
    }
    sql_call_check(t, fi)
    emit_call_args(fi, n, defer)
    last_was_call = true
    if f.is_lib && (name == "fail" || name == "exit") {
        // не возвращаются: годятся для else { ... } и ветвей match
        return ty_never
    }
    return f.ret
}

// Методы встроенных типов → функции библиотеки __str_*, __list_*, __int_*, ...
fn method_prefix(k: int) -> str {
    if k == K_STR {
        return "__str_"
    }
    if k == K_LIST {
        return "__list_"
    }
    if k == K_INT {
        return "__int_"
    }
    if k == K_BOOL {
        return "__bool_"
    }
    if k == K_FLOAT {
        return "__float_"
    }
    if k == K_MAP {
        return "__map_"
    }
    return ""
}

// Функция метода str. В коде программы методы, которые считают символы, —
// функции lib/text.kh (__text_find, __text_lower, ...); остальные __text_* —
// не методы, их вызывает сам компилятор (s[i], срезы, for, сравнения). В
// системном коде find, lower, upper и trim — ошибки (system_str_method), и
// после ошибки — байтовые byte_find, ascii_lower, ascii_upper и ascii_trim.
fn str_method_fn(name: str, system: bool) -> str {
    if !system && (name == "find" || name == "find_from" || name == "lower" || name == "upper" || name == "trim" || name == "split" || name == "replace") {
        return "__text_" + name
    }
    if name == "find" || name == "find_from" {
        return "__str_byte_" + name
    }
    if name == "lower" || name == "upper" || name == "trim" {
        return "__str_ascii_" + name
    }
    return "__str_" + name
}

// Методы списков, int, float и bool в коде программы, которые вызывают
// функцию библиотеки по префиксу (__list_push, __int_abs, ...); len, to_int,
// to_float, contains, index_of, sort и лямбды разбираются отдельно.
fn builtin_method(k: int, name: str) -> bool {
    if k == K_LIST {
        return name == "push" || name == "pop" || name == "last" || name == "insert" || name == "remove_at" || name == "clear" || name == "truncate" || name == "copy" || name == "reverse" || name == "join" || name == "sum"
    }
    if k == K_INT {
        return name == "to_str" || name == "abs" || name == "min" || name == "max"
    }
    if k == K_FLOAT {
        return name == "to_str" || name == "round" || name == "floor" || name == "ceil" || name == "round_to" || name == "abs" || name == "sqrt" || name == "min" || name == "max"
    }
    if k == K_BOOL {
        return name == "to_str"
    }
    return true
}

// Встроенные методы str в коде программы → сколько у них аргументов после
// получателя: 0 или 1 (один и больше); -1 — не метод. s.имя(...) вызывает
// встроенный метод, даже если в программе есть fn имя(s: str, ...), поэтому
// такое объявление — ошибка (str_method_clash).
fn str_method_args(name: str) -> int {
    if name == "len" || name == "byte_len" || name == "trim" || name == "lower" || name == "upper" || name == "ascii_trim" || name == "ascii_lower" || name == "ascii_upper" || name == "to_int" || name == "to_float" || name == "to_str" {
        return 0
    }
    if name == "byte" || name == "byte_slice" || name == "byte_find" || name == "byte_find_from" || name == "contains" || name == "starts_with" || name == "ends_with" || name == "find" || name == "find_from" || name == "split" || name == "replace" || name == "repeat" || name == "matches" {
        return 1
    }
    return -1
}

// fn имя(s: str, ...) с именем встроенного метода str: функция программы — метод
// своего первого параметра, но s.имя(...) у str всегда вызывает встроенный
// метод. Раньше fn trim(s: str) молча проигрывала встроенному trim (а до
// байтового API s.byte_len() вызывал функцию программы) — теперь это ошибка в
// объявлении. Первый параметр str? — тоже: у str-получателя метод встроенный.
fn str_method_clash(name: Token, ps: [Param]) {
    let n = str_method_args(name.text)
    if n < 0 || ps.len() == 0 || ps[0].ty == ty_err || !assignable(ty_str, ps[0].ty) {
        return
    }
    var form = "s." + name.text + "()"
    if n > 0 {
        form = "s." + name.text + "(...)"
    }
    error_tok(name, "fn " + name.text + " clashes with the built-in str method " + name.text, "rename it: " + form + " calls the built-in, never a function that takes str first")
}

// Методы str, которые в системном коде запрещены: у них будет символьный смысл.
// Текущий токен — '('.
fn system_str_method(nt: Token) {
    let name = nt.text
    if name == "len" {
        system_str_error(nt, "str .len()", "s.byte_len()")
    } else if name == "find" || name == "find_from" {
        system_str_error(nt, "str ." + name + "()", "s.byte_" + name + "(...)")
    } else if name == "lower" || name == "upper" || name == "trim" {
        system_str_error(nt, "str ." + name + "()", "s.ascii_" + name + "()")
    } else if name == "matches" {
        system_str_error(nt, "regex .matches()", "a byte loop with s.byte(i)")
    } else if (name == "split" || name == "replace") && kind_at(pos + 1) == T_STR && strlits[toks[pos + 1].val] == "" && (kind_at(pos + 2) == ',' || kind_at(pos + 2) == ')') {
        if name == "split" {
            system_str_error(nt, "split(\"\")", "a byte loop with s.byte(i)")
        } else {
            system_str_error(nt, "replace(\"\", ...)", "a Buf filled byte by byte")
        }
    }
}

fn skip_call_args() {
    let close = matching_close(pos)
    pos = close
    advance()
}

// получатель.имя(аргументы); получатель в rax, текущий токен — '('.
fn parse_method(rt: int, nt: Token) -> int {
    let name = nt.text
    let k = tkind(rt)
    if tx_depth > 0 {
        if mutating_method(name) {
            tx_mutation(nt)
        }
        if (name == "sleep" || name == "fetch" || driver_io(name)) && !files[nt.file].is_lib {
            error_tok(nt, name + " inside tx: the block may run again after a conflict", "call it before or after the tx block")
        }
    }
    if rt == ty_err {
        skip_call_args()
        return ty_err
    }
    if k == K_OPT {
        error_tok(nt, "the value may be none; unwrap it before calling ." + name + "()", "if let v = x \{ v." + name + "() } or (x ?? default)." + name + "()")
        skip_call_args()
        return ty_err
    }
    if k == K_STR {
        // вынесен из лямбды (src/variant.kh, hoist_begin)
        let ht = hoisted_call()
        if ht >= 0 {
            return ht
        }
        if system_code(nt) {
            system_str_method(nt)
        }
        if name == "matches" {
            return parse_matches(nt)
        }
        if name == "lower" && !system_code(nt) && lower_contains_at(pos) {
            return parse_lower_contains()
        }
    }
    if k == K_FLOAT && name == "to_int" && kind_at(pos + 1) == ')' {
        advance()
        advance()
        emit_float_to_int(nt)
        last_was_call = false
        return ty_int
    }
    if k == K_INT && name == "to_float" && kind_at(pos + 1) == ')' {
        advance()
        advance()
        emit_int_to_float()
        last_was_call = false
        return ty_float
    }
    if name == "len" && k == K_STR && !system_code(nt) && kind_at(pos + 1) == ')' {
        // получатель — токен перед «.len»
        let lit = pos - 3
        advance()
        advance()
        emit_text_len(lit)
        return ty_int
    }
    if ((name == "len" && (k == K_STR || k == K_LIST || k == K_MAP)) || (name == "byte_len" && k == K_STR)) && kind_at(pos + 1) == ')' {
        advance()
        advance()
        if k == K_STR {
            emit_mov_rr(RDX, RAX)
            emit_str_len(RAX, RDX)
        } else {
            emit_load(RAX, RAX, 8)
        }
        last_was_call = false
        return ty_int
    }
    if k == K_STR && name == "byte" && kind_at(pos + 2) == ')' {
        // s.byte(i) с простым индексом: индекс сразу в rcx
        pos += 1
        want = ty_int
        if peek_simple(1) && is_int_like(op_ty) {
            load_operand(RCX)
            pos += 2
            emit_byte_at(nt)
            return ty_int
        }
        pos -= 1
    }
    if k == K_MAP {
        return parse_map_method(rt, nt)
    }
    var tt = ty_err
    if k == K_LIST {
        tt = ty_elem(rt)
        if is_lambda_method(name) {
            // два звена и больше без побочных действий — одним проходом
            let links = chain_links(pos - 2)
            if links.len() >= 2 && chain_pure(links) {
                return parse_fused(rt, false, links)
            }
            return parse_lambda_method(rt, nt)
        }
        if name == "sort" && kind() == '(' && kind_at(pos + 1) != ')' {
            // компаратор из других языков: сортируют по ключу
            error_tok(nt, ".sort() takes no comparator", "sort by a key: xs.sort_by(x => x.n); descending: xs.sort_by(x => -x.n); several keys: stable sort_by calls, last key first")
            skip_call_args()
            return ty_err
        }
        if name == "contains" || name == "sort" || name == "index_of" {
            return parse_list_typed_method(rt, nt)
        }
    }
    var fi = -1
    let prefix = method_prefix(k)
    if k == K_STR {
        // в коде программы — только встроенные методы; прочие __str_* —
        // внутренние функции библиотеки (s.slice — байтовый срез)
        if system_code(nt) || str_method_args(name) >= 0 {
            fi = func_find(str_method_fn(name, system_code(nt)))
        }
    } else if prefix.byte_len() > 0 && (system_code(nt) || builtin_method(k, name)) {
        // в коде программы — только описанные методы: прочие __list_*,
        // __int_*, ... — внутренние функции библиотеки (xs.vacate(i) обнулял
        // бы память списка store мимо блокировки)
        fi = func_find(prefix + name)
        if k == K_LIST && name == "sum" && tt == ty_float {
            fi = func_find("__list_sum_float")
        }
        if fi >= 0 && !system_code(nt) && funcs[fi].params.len() > 0 {
            // получатель — первый параметр: [1, 2].join(",") — не [str]
            let pt = subst(funcs[fi].params[0].ty, tt, ty_err, ty_err)
            if !assignable(rt, pt) {
                var hint = ""
                if name == "join" {
                    hint = "turn the items into text first: xs.map(x => x.to_str()).join(\", \")"
                }
                error_tok(nt, "." + name + "() works on " + ty_name(pt) + ", not " + ty_name(rt), hint)
                skip_call_args()
                return ty_err
            }
        }
    }
    if fi < 0 {
        let uf = func_find(name)
        if uf >= 0 && funcs[uf].params.len() > 0 && assignable(rt, funcs[uf].params[0].ty) {
            fi = uf
            if tx_depth > 0 && !funcs[uf].is_lib {
                let why = fn_effect(uf)
                if why != "" {
                    error_tok(nt, name + "() " + why + ", and the tx block may run again after a conflict", "call it before or after the tx block")
                }
                // x.f(...): x — первый параметр
                let pm = fn_param_mut(uf)
                if pm.len() > 0 && pm[0] {
                    tx_mutation(nt)
                }
                tx_arg_check(nt, uf, 1)
            }
        }
    }
    if fi < 0 {
        var hint = ""
        if k == K_STR {
            hint = str_method_hint(name, system_code(nt))
        }
        if hint == "" {
            hint = method_hint(name, k == K_STR && system_code(nt))
        }
        if hint.byte_len() == 0 {
            let uf = func_find(name)
            if uf >= 0 && funcs[uf].params.len() > 0 {
                hint = "'" + name + "' takes " + ty_name(funcs[uf].params[0].ty) + " as its first parameter"
            }
        }
        if hint.byte_len() == 0 && k == K_LIST {
            hint = "list methods: len push pop last insert remove_at clear truncate copy contains index_of sort reverse join sum, and map filter find any all count sort_by"
        }
        if hint.byte_len() == 0 && (name == "len" || name == "has" || name == "get" || name == "keys" || name == "values" || name == "remove") {
            hint = anon_map_hint(rt)
        }
        error_tok(nt, ty_name(rt) + " has no method '" + name + "'", hint)
        skip_call_args()
        return ty_err
    }
    let f = funcs[fi]
    if f.is_lib {
        driver_query_check(nt, pos, 0)
    }
    emit_push(RAX)
    advance()
    let n = compile_args(f.params, 1, tt, ty_err, ty_err, name, nt, false) + 1
    if n != f.params.len() {
        emit_alu_imm(0, RSP, n * 8)
        return subst(f.ret, tt, ty_err, ty_err)
    }
    if k == K_LIST && (name == "push" || name == "insert") && barrier_on(tt) {
        // элемент попадает внутрь списка
        emit_load(RSI, RSP, 0)
        emit_load(RDI, RSP, 8 * (n - 1))
        emit_mov_imm(RDX, type_desc(tt))
        emit_call(rt_func("__barrier"))
        emit_store(RSP, 0, RAX)
    }
    if k == K_STR && name == "byte" {
        emit_pop(RCX)
        emit_pop(RAX)
        emit_byte_at(nt)
        return ty_int
    }
    if k == K_STR && name == "byte_slice" {
        // как срез s[a..b]: прямой вызов, без встраивания
        emit_args_to_regs(n)
        emit_call(rt_func("__str_slice"))
        last_was_call = true
        return ty_str
    }
    emit_call_args(fi, n, false)
    last_was_call = true
    return subst(f.ret, tt, ty_err, ty_err)
}

// s.lower().contains(sub): с позиции i — «( ) . contains (» (i — '(' после
// lower).
fn lower_contains_at(i: int) -> bool {
    return kind_at(i) == '(' && kind_at(i + 1) == ')' && kind_at(i + 2) == '.' && kind_at(i + 3) == T_IDENT && toks[i + 3].text == "contains" && kind_at(i + 4) == '('
}

// s.lower().contains(sub) → __text_contains_lower(s, sub) (lib/text.kh): тот
// же ответ без копии s в нижнем регистре. Получатель в rax, текущий токен —
// '(' после lower.
fn parse_lower_contains() -> int {
    let ct = toks[pos + 3]
    pos += 4
    let fi = rt_func("__text_contains_lower")
    let f = funcs[fi]
    emit_push(RAX)
    advance()
    let n = compile_args(f.params, 1, ty_err, ty_err, ty_err, "contains", ct, false) + 1
    if n != f.params.len() {
        emit_alu_imm(0, RSP, n * 8)
        return ty_bool
    }
    emit_call_args(fi, n, false)
    last_was_call = true
    return ty_bool
}

// Длина str в rax в символах (lib/text.kh); если получатель — литерал (токен
// lit; -1 — не литерал), число известно при компиляции.
fn emit_text_len(lit: int) {
    last_was_call = false
    if lit >= 0 && toks[lit].kind == T_STR {
        emit_mov_imm(RAX, char_count(strlits[toks[lit].val]))
        return
    }
    if lit >= 0 && toks[lit].kind == T_CHAR {
        emit_mov_imm(RAX, 1)
        return
    }
    emit_mov_rr(RDI, RAX)
    emit_call(rt_func("__text_len"))
}

// s.byte(i): получатель в rax, индекс в rcx; байт с проверкой границ (длина и
// адрес байтов — по виду строки, lib/core.kh; rdx — длина).
fn emit_byte_at(at: Token) {
    emit_str_len(RDX, RAX)
    emit_rr(0x39, RDX, RCX)
    emit_panic_jump(CC_AE, PANIC_INDEX, at)
    emit_str_ptr(RAX, RAX)
    emit_movzx_index()
    last_was_call = false
}

// contains/sort/index_of для [int] и [str] — разные функции библиотеки.
fn parse_list_typed_method(rt: int, nt: Token) -> int {
    let et = ty_elem(rt)
    var suffix = ""
    if et == ty_int {
        suffix = "_int"
    } else if et == ty_bool && nt.text != "sort" {
        suffix = "_bool"
    } else if et == ty_str {
        suffix = "_str"
    } else {
        error_tok(nt, "." + nt.text + "() works on lists of int or str, not " + ty_name(rt), "")
        skip_call_args()
        return ty_err
    }
    let fi = rt_func("__list_" + nt.text + suffix)
    let f = funcs[fi]
    emit_push(RAX)
    advance()
    let n = compile_args(f.params, 1, et, ty_err, ty_err, nt.text, nt, false) + 1
    if n != f.params.len() {
        emit_alu_imm(0, RSP, n * 8)
        return f.ret
    }
    emit_call_args(fi, n, false)
    last_was_call = true
    return f.ret
}

// Методы словаря: has, get, remove, keys, values, clear.
fn parse_map_method(rt: int, nt: Token) -> int {
    let name = nt.text
    let kt = types[rt].a
    let vt = types[rt].b
    if name == "values" && kind_at(pos + 1) == ')' {
        // m.values().filter(...)... без побочных действий — проход прямо по
        // массивам словаря, без списка values() (src/variant.kh, parse_fused)
        let links = chain_links(pos + 2)
        if links.len() >= 1 && chain_pure(links) {
            advance()
            advance()
            return parse_fused(rt, true, links)
        }
    }
    emit_push(RAX)
    let open = pos
    advance()
    var argc = 0
    if name == "has" || name == "get" || name == "remove" || name == "contains" {
        argc = 1
    }
    var n = 0
    if argc == 1 {
        let a = tok()
        let t = parse_expr(kt)
        coerce(t, kt, a)
        emit_push(RAX)
        n = 1
    }
    if name == "get" && kind() == ',' {
        // dict.get(k, default) из Python
        // простые части (одна лексема) — в подсказку как есть
        var m = "m"
        if open >= 3 && toks[open - 2].kind == '.' && toks[open - 3].kind == T_IDENT && !(open >= 4 && (toks[open - 4].kind == '.' || toks[open - 4].kind == ')' || toks[open - 4].kind == ']')) {
            m = toks[open - 3].text
        }
        var k = "k"
        if pos == open + 2 {
            k = toks[open + 1].text
        }
        var d = "default"
        if kind_at(pos + 2) == ')' {
            d = toks[pos + 1].text
        }
        error_tok(tok(), ".get() takes only the key", "for a default write " + m + "[" + k + "] ?? " + d)
        skip_call_args_from_open()
        emit_alu_imm(0, RSP, (n + 1) * 8)
        return ty_err
    }
    if !expect_tok(')') {
        emit_alu_imm(0, RSP, (n + 1) * 8)
        return ty_err
    }
    last_was_call = true
    if argc == 1 {
        emit_pop(RSI)
    }
    emit_pop(RDI)
    if name == "has" || name == "contains" {
        emit_call(rt_func("__map_has"))
        return ty_bool
    }
    if name == "get" {
        if is_ref(vt) || tkind(vt) == K_OPT {
            emit_call(rt_func("__map_get_ref"))
        } else {
            emit_call(rt_func("__map_get_box"))
        }
        return ty_opt(vt)
    }
    if name == "remove" {
        if is_ref(vt) || tkind(vt) == K_OPT {
            emit_call(rt_func("__map_remove_ref"))
        } else {
            emit_call(rt_func("__map_remove_box"))
        }
        return ty_opt(vt)
    }
    if name == "keys" {
        emit_call(rt_func("__map_keys"))
        return ty_list(kt)
    }
    if name == "values" {
        emit_mov_imm(RSI, esize_of(vt))
        emit_call(rt_func("__map_values"))
        return ty_list(vt)
    }
    if name == "clear" {
        emit_call(rt_func("__map_clear"))
        return ty_void
    }
    var hint = method_hint(name, false)
    error_tok(nt, ty_name(rt) + " has no method '" + name + "'", hint)
    return ty_err
}
