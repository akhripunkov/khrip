// ============================================================================
// Какие маршруты только читают store. Их запросы берут разделяемую блокировку
// и идут параллельно; остальные — по одному (lib/rt.kh, __store_lock).
//
// Анализ по лексемам и консервативный: всё, в чём он не уверен, — запись.
// Запись — это:
//   - присваивание чему-то, кроме локальной переменной или свежей коллекции
//     (x.f = ..., store_name = ..., m[k] = ... для m из store);
//   - изменяющий метод (push, pop, insert, remove_at, clear, truncate, reverse,
//     sort, sort_by, remove) у значения, которое может быть из store. Свежие
//     значения — литералы, результаты values, keys, filter, map, copy, split,
//     срезы, a ?? b из свежих частей, элемент m[k] свежего локального словаря,
//     в который кладут только свежее (rw_fresh_elems), и локальные
//     переменные, которым присвоено только свежее;
//   - вызов функции программы, которая пишет, или функции библиотеки не из
//     списка безопасных;
//   - вызов функции драйвера, которая меняет свой первый аргумент
//     (построители BSON, mongo_next, mongo_close), если аргумент может быть
//     из store.
// Имена функций библиотеки сравниваются после разрешения: своя функция
// программы с тем же именем разбирается как функция программы.
// ============================================================================

// По функциям: 0 — только читает store, 1 — может писать.
var rw_writes: [int]
var rw_done: bool

fn rw_mutating(name: str) -> bool {
    return name == "push" || name == "pop" || name == "insert" || name == "remove_at" || name == "clear" || name == "truncate" || name == "reverse" || name == "sort" || name == "sort_by" || name == "remove"
}

// Методы, которые возвращают новую коллекцию. Своя функция программы с тем
// же именем (fn values(s: Shop) -> [Cat] { return s.cats }) может вернуть
// что угодно, и x.values() тогда вызывает её — тогда не свежее.
fn rw_fresh_method(name: str) -> bool {
    return (name == "values" || name == "keys" || name == "filter" || name == "map" || name == "copy" || name == "split") && !rw_user_fn(name)
}

// Методы, которые возвращают свой получатель (то же условие).
fn rw_same_method(name: str) -> bool {
    return (name == "sort_by" || name == "sort" || name == "reverse") && !rw_user_fn(name)
}

// Есть функция программы с таким именем.
fn rw_user_fn(name: str) -> bool {
    let f = func_find(name)
    return f >= 0 && !funcs[f].is_lib
}

// Функции библиотеки, которые не трогают store.
fn rw_safe_lib(name: str) -> bool {
    if name == "to_bson" || name == "from_bson" || name == "ch_encode" || name == "ch_decode" || name == "bson_error" || name == "ch_error" {
        return true
    }
    // строковые операции lib/text.kh пишут только в кэш строк арены запроса
    if name.starts_with("__text_") {
        return true
    }
    // состояние сборщика store (lib/gc.kh) — только чтение его счётчиков
    if name == "__gc_stats" || name == "__gc_handed_off" {
        return true
    }
    return name == "__to_str" || name == "print" || name == "eprint" || name == "write" || name == "args" || name == "env" || name == "read_file" || name == "write_file" || name == "exit" || name == "now" || name == "now_ms" || name == "sleep" || name == "time_iso" || name == "parse_time" || name == "parse_date" || name == "random_str" || name == "sha256" || name == "hash_password" || name == "check_password" || name == "url_encode" || name == "to_json" || name == "from_json" || name == "json_error" || name == "header" || name == "set_header" || name == "fail"
}

// Функции драйверов, которые не трогают store и не меняют аргументы: разбор и
// чтение BSON, ошибки, сетевые вызовы. Сетевые на время ожидания отпускают
// блокировку store (окна docs/design/v0.13-store-gc.md §6.5) и берут её снова
// в том же режиме, поэтому маршрут, который store только читает, остаётся
// read, как с fetch.
fn rw_driver_safe(name: str) -> bool {
    if name == "bson_valid" || name == "bson_parse" || name == "bson_new" || name == "bson_finish" || name == "bson_fields" || name == "bson_get" || name == "bson_has" || name == "bson_is_null" || name == "object_id" {
        return true
    }
    if name == "bson_get_int" || name == "bson_get_float" || name == "bson_get_str" || name == "bson_get_bool" || name == "bson_get_doc" || name == "bson_get_array" || name == "bson_get_binary" {
        return true
    }
    if name == "mongo_command" || name == "mongo_insert" || name == "mongo_update" || name == "mongo_delete" || name == "mongo_create_indexes" || name == "mongo_cursor" || name == "mongo_find" || name == "mongo_find_with" {
        return true
    }
    return name == "ch_query" || name == "ch_query_params" || name == "ch_insert" || name == "ch_cancel" || name == "ch_null"
}

// Функции драйверов, которые меняют свой первый аргумент: построители BSON —
// BsonBuilder, mongo_next и mongo_close — курсор. Как push: запись, если
// аргумент может быть из store (rw_arg_local).
fn rw_driver_mutator(name: str) -> bool {
    if name == "mongo_next" || name == "mongo_close" || name == "bson_int" || name == "bson_int32" || name == "bson_float" || name == "bson_str" || name == "bson_bool" || name == "bson_null" || name == "bson_doc" {
        return true
    }
    return name == "bson_array" || name == "bson_int_array" || name == "bson_binary" || name == "bson_object_id" || name == "bson_date" || name == "bson_decimal128" || name == "bson_timestamp"
}

// Функции драйверов, которые возвращают новый построитель или курсор.
fn rw_driver_fresh(name: str) -> bool {
    if !(name == "bson_new" || name == "mongo_find" || name == "mongo_find_with" || name == "mongo_cursor") {
        return false
    }
    let fi = func_find(name)
    return fi >= 0 && funcs[fi].is_lib
}

// Первый аргумент вызова функции в позиции i (получатель — для формы метода)
// не из store: свежее значение или параметр функции fi, тип которого в store
// не положить (BsonBuilder, MongoCursor и всё, что их содержит: проверка store
// в src/api.kh, store_raw_type).
fn rw_arg_local(fi: int, i: int, after_dot: bool, body: int, end: int) -> bool {
    var a = -1
    var last = -1
    if after_dot {
        last = i - 2
        a = rw_recv_start(last)
    } else {
        let open = i + 1
        let close = matching_close(open)
        var j = open + 1
        var depth = 0
        while j < close && !(depth == 0 && toks[j].kind == ',') {
            let k = toks[j].kind
            if k == '(' || k == '[' || k == '\{' {
                depth += 1
            } else if k == ')' || k == ']' || k == '}' {
                depth -= 1
            }
            j += 1
        }
        if j == open + 1 {
            return false
        }
        a = open + 1
        last = j - 1
    }
    if a >= 0 && a == last && toks[a].kind == T_IDENT {
        for p in funcs[fi].params {
            if p.name == toks[a].text {
                var seen: [int] = []
                return store_raw_type(p.ty, seen).byte_len() > 0
            }
        }
    }
    return rw_fresh_at(last, a, body, end, 0)
}

// Встроенные функции, которые пишут в память напрямую.
fn rw_raw_builtin(name: str) -> bool {
    return name == "store8" || name == "store32" || name == "store64" || name == "syscall" || name.starts_with("__")
}

fn rw_is_assign(k: int) -> bool {
    return k == '=' || k == T_PLUSEQ || k == T_MINUSEQ || k == T_STAREQ || k == T_SLASHEQ || k == T_PERCENTEQ
}

// Парная открывающая скобка для закрывающей в позиции j (или -1).
fn rw_open_of(j: int, from: int) -> int {
    var depth = 0
    var i = j
    while i >= from {
        let k = toks[i].kind
        if k == ')' || k == ']' || k == '}' {
            depth += 1
        } else if k == '(' || k == '[' || k == '\{' {
            depth -= 1
            if depth == 0 {
                return i
            }
        }
        i -= 1
    }
    return -1
}

// Конец выражения, которое начинается в a, так, как его читает парсер
// (src/expr.kh, src/atom.kh): операнды через ?? || && == != < <= > >= + - | ^
// * / % << >> & — и через перевод строки (парсер переводов строк внутри
// выражения не видит, а ; лексер отбрасывает); у операнда — префиксы - ! ~,
// атом (литерал, (...), [...], {...}, имя, имя(...), Структура {...}, if и
// match как значения) и постфиксы .имя, .имя(...), [...]. → индекс первой
// лексемы после выражения или -1, если вид незнаком (fetch, sql, call, tx...)
// или выражение не кончается до limit: тогда оно не свежее.
fn rw_expr_scan(a: int, limit: int) -> int {
    var i = a
    while true {
        while i < limit && (toks[i].kind == '-' || toks[i].kind == '!' || toks[i].kind == '~') {
            i += 1
        }
        if i >= limit {
            return -1
        }
        let k = toks[i].kind
        if k == T_INT || k == T_FLOAT || k == T_CHAR || k == T_STR || k == T_TRUE || k == T_FALSE || k == T_NONE {
            i += 1
        } else if k == '(' || k == '[' || k == '\{' {
            i = rw_close_in(i, limit)
        } else if k == T_IDENT {
            let name = toks[i].text
            if name == "fetch" || name == "tx" {
                return -1
            }
            i += 1
            if i < limit && toks[i].kind == '(' {
                i = rw_close_in(i, limit)
            } else if i < limit && toks[i].kind == '\{' && struct_find(name) >= 0 {
                i = rw_close_in(i, limit)
            }
        } else if k == T_IF {
            i = rw_if_scan(i, limit)
        } else if k == T_MATCH {
            let b = rw_brace_at(i + 1, limit)
            if b < 0 {
                return -1
            }
            i = rw_close_in(b, limit)
        } else {
            return -1
        }
        if i < 0 {
            return -1
        }
        // постфиксы
        while i < limit {
            if toks[i].kind == '.' && i + 1 < limit && toks[i + 1].kind == T_IDENT {
                i += 2
                if i < limit && toks[i].kind == '(' {
                    i = rw_close_in(i, limit)
                    if i < 0 {
                        return -1
                    }
                }
            } else if toks[i].kind == '[' {
                i = rw_close_in(i, limit)
                if i < 0 {
                    return -1
                }
            } else {
                break
            }
        }
        if i < limit && rw_binop(toks[i].kind) {
            i += 1
        } else {
            return i
        }
    }
    return -1
}

// Бинарный оператор выражения (все уровни parse_coalesce … parse_mul).
fn rw_binop(k: int) -> bool {
    return k == T_QQ || k == T_OROR || k == T_ANDAND || k == T_EQ || k == T_NE || k == '<' || k == T_LE || k == '>' || k == T_GE || k == '+' || k == '-' || k == '|' || k == '^' || k == '*' || k == '/' || k == '%' || k == T_SHL || k == T_SHR || k == '&'
}

// Лексема после скобки, парной к открывающей в i, или -1 (нет пары до limit).
fn rw_close_in(i: int, limit: int) -> int {
    let c = matching_close(i)
    if c < 0 || c >= limit {
        return -1
    }
    return c + 1
}

// Первая { на нулевой глубине скобок с позиции i (условие if, подлежащее
// match: там структуры без скобок не пишут) или -1.
fn rw_brace_at(i: int, limit: int) -> int {
    var depth = 0
    var j = i
    while j < limit {
        let k = toks[j].kind
        if k == '\{' && depth == 0 {
            return j
        }
        if k == '(' || k == '[' || k == '\{' {
            depth += 1
        } else if k == ')' || k == ']' || k == '}' {
            depth -= 1
            if depth < 0 {
                return -1
            }
        }
        j += 1
    }
    return -1
}

// if как значение с позиции i: if условие { ... } else if ... else { ... }
// → лексема после него или -1.
fn rw_if_scan(i: int, limit: int) -> int {
    let b = rw_brace_at(i + 1, limit)
    if b < 0 {
        return -1
    }
    let e = rw_close_in(b, limit)
    if e < 0 || e >= limit || toks[e].kind != T_ELSE {
        return e
    }
    if e + 1 < limit && toks[e + 1].kind == T_IF {
        return rw_if_scan(e + 1, limit)
    }
    if e + 1 < limit && toks[e + 1].kind == '\{' {
        return rw_close_in(e + 1, limit)
    }
    return -1
}

// Свежее ли выражение, которое начинается в a (до limit), целиком.
fn rw_fresh_expr(a: int, body: int, end: int, depth: int) -> bool {
    let e = rw_expr_scan(a, end)
    if e <= a {
        return false
    }
    return rw_fresh_at(e - 1, a, body, end, depth)
}

// Имя нельзя судить по объявлениям в теле: оно — параметр функции с телом
// body, глобальная или store (локальная с тем же именем в каком-то блоке не
// говорит ничего об упоминаниях вне него).
fn rw_name_unsafe(name: str, body: int) -> bool {
    let sym = sym_find(name)
    if sym >= 0 && sym_kind(sym) == SK_GLOBAL {
        return true
    }
    var f = 0
    while f < funcs.len() {
        if funcs[f].body == body {
            for p in funcs[f].params {
                if p.name == name {
                    return true
                }
            }
            return false
        }
        f += 1
    }
    return false
}

// Позиция = в объявлении let/var имя [: тип] = с именем в i, или -1 (нет
// значения: var x: [int]; y[k] = v — у x значения нет, а = — уже другого
// оператора).
fn rw_decl_eq(i: int, end: int) -> int {
    var j = i + 1
    if j < end && toks[j].kind == ':' {
        j = rw_type_end(j + 1, end)
        if j < 0 {
            return -1
        }
    }
    if j < end && toks[j].kind == '=' {
        return j
    }
    return -1
}

// Лексема после типа с позиции j, как его читает parse_type (src/decl.kh):
// имя, [тип] или map[тип, тип] и, может быть, ? → индекс или -1.
fn rw_type_end(j: int, end: int) -> int {
    if j >= end {
        return -1
    }
    var e = -1
    if toks[j].kind == '[' {
        let t = rw_type_end(j + 1, end)
        if t < 0 || t >= end || toks[t].kind != ']' {
            return -1
        }
        e = t + 1
    } else if toks[j].kind == T_IDENT {
        e = j + 1
        if toks[j].text == "map" {
            if e >= end || toks[e].kind != '[' {
                return -1
            }
            let k = rw_type_end(e + 1, end)
            if k < 0 || k >= end || toks[k].kind != ',' {
                return -1
            }
            let v = rw_type_end(k + 1, end)
            if v < 0 || v >= end || toks[v].kind != ']' {
                return -1
            }
            e = v + 1
        }
    } else {
        return -1
    }
    if e < end && toks[e].kind == '?' {
        e += 1
    }
    return e
}

// Цель присваивания, оператор которого в позиции i: -2 — объявление let/var;
// иначе позиция имени в начале цепочки имя(.поле | [индекс])* перед
// оператором или -1, если цель не такая. По лексемам назад, без оглядки на
// строки: let t = 1; c.name = v — цель c.name (; лексер отбрасывает).
fn rw_assign_root(i: int, body: int) -> int {
    if toks[i].kind == '=' {
        // let имя = / let имя: тип = — тип разобран так же, как parse_type
        var j = i - 1
        while j > body && (toks[j].kind == T_IDENT || toks[j].kind == '[' || toks[j].kind == ']' || toks[j].kind == ',' || toks[j].kind == '?' || toks[j].kind == ':') {
            if toks[j].kind == T_IDENT && (toks[j - 1].kind == T_LET || toks[j - 1].kind == T_VAR) {
                if rw_decl_eq(j, i + 1) == i {
                    return -2
                }
                break
            }
            j -= 1
        }
    }
    var r = i - 1
    while r >= body {
        let k = toks[r].kind
        if k == ']' {
            let o = rw_open_of(r, body)
            if o <= body {
                return -1
            }
            r = o - 1
        } else if k == T_IDENT {
            if toks[r - 1].kind == '.' {
                r -= 2
            } else {
                return r
            }
        } else {
            return -1
        }
    }
    return -1
}

// Свежее ли значение выражения, которое кончается лексемой last (начало — a
// или -1, если неизвестно).
fn rw_fresh_at(last: int, a: int, body: int, end: int, depth: int) -> bool {
    if depth > 8 || last < body {
        return false
    }
    // a ?? b — свежее, если свежи обе части: значение может быть любой из них
    // (по одной последней лексеме groups[k] ?? xs.copy() выглядело бы свежим,
    // хотя бывает списком store)
    if a >= 0 {
        let q = rw_top_qq(a, last)
        if q >= 0 {
            return rw_fresh_at(q - 1, a, body, end, depth + 1) && rw_fresh_at(last, q + 1, body, end, depth + 1)
        }
    }
    let k = toks[last].kind
    if k == ')' {
        let m = rw_open_of(last, body)
        // новый построитель BSON или курсор: bson_new(), mongo_find(...)
        if m >= body + 1 && toks[m - 1].kind == T_IDENT && rw_driver_fresh(toks[m - 1].text) {
            return true
        }
        if m < body + 2 || toks[m - 1].kind != T_IDENT || toks[m - 2].kind != '.' {
            return false
        }
        let name = toks[m - 1].text
        if rw_fresh_method(name) {
            return true
        }
        if rw_same_method(name) {
            return rw_fresh_at(m - 3, rw_recv_start(m - 3), body, end, depth + 1)
        }
        return false
    }
    if k == ']' {
        let m = rw_open_of(last, body)
        if m < 0 {
            return false
        }
        if m == a {
            return true
        }
        // элемент свежего локального словаря, в который кладут только свежее:
        // cats[k] у var cats: map[str, Category] = {}
        if a >= 0 && m == a + 1 && toks[a].kind == T_IDENT && toks[a - 1].kind != '.' && rw_fresh_elems(toks[a].text, body, end, depth + 1) {
            return true
        }
        // срез xs[a..b] — копия
        var i = m + 1
        var d = 0
        while i < last {
            let ki = toks[i].kind
            if ki == '(' || ki == '[' || ki == '\{' {
                d += 1
            } else if ki == ')' || ki == ']' || ki == '}' {
                d -= 1
            } else if d == 0 && (ki == T_DOTDOT || ki == T_DOTDOTEQ) {
                return true
            }
            i += 1
        }
        return false
    }
    if k == '}' {
        let m = rw_open_of(last, body)
        // литерал словаря {..} или структуры Name { .. }
        return m >= 0 && (m == a || (m == a + 1 && toks[a].kind == T_IDENT))
    }
    if k == T_IDENT && last == a {
        return rw_fresh_local(toks[last].text, last, body, end, depth + 1)
    }
    return false
}

// Первый ?? между a и last на нулевой глубине скобок или -1.
fn rw_top_qq(a: int, last: int) -> int {
    var depth = 0
    var i = a
    while i <= last {
        let k = toks[i].kind
        if k == '(' || k == '[' || k == '\{' {
            depth += 1
        } else if k == ')' || k == ']' || k == '}' {
            depth -= 1
        } else if k == T_QQ && depth == 0 {
            return i
        }
        i += 1
    }
    return -1
}

// Методы словаря, которые в него ничего не кладут и сам словарь не отдают.
fn rw_map_read_method(name: str) -> bool {
    return name == "len" || name == "has" || name == "get" || name == "remove" || name == "keys" || name == "values" || name == "clear" || name == "contains"
}

// Имена, для которых rw_fresh_elems сейчас проверяет, что в них кладут:
// внутри проверки их элементы считаются свежими (наименьшее «да»: в пустой
// словарь кладут только свежее или его же элементы — по индукции по
// вставкам все его элементы свежие).
var rw_elem_stack: [str]

// Локальный словарь name — свежий, и всё, что в него кладут, свежее: каждое
// объявление — var name[: тип] = {}, и каждое упоминание name в теле —
// name[k] (чтение), name[k] = v со свежим v (или += и т. п.: значения int и
// str), name.len/has/get/remove/keys/values/clear/contains(...) или
// for ... in name. Любое другое упоминание (name = ..., передать, вернуть,
// положить в литерал, let b = name) — и уже не понять, что в него кладут
// (через b), поэтому нет.
fn rw_fresh_elems(name: str, body: int, end: int, depth: int) -> bool {
    if depth > 8 {
        return false
    }
    for s in rw_elem_stack {
        if s == name {
            return true
        }
    }
    rw_elem_stack.push(name)
    let ok = rw_fresh_elems_scan(name, body, end, depth)
    rw_elem_stack.pop()
    return ok
}

fn rw_fresh_elems_scan(name: str, body: int, end: int, depth: int) -> bool {
    if rw_name_unsafe(name, body) {
        return false
    }
    var found = false
    var i = body
    while i < end {
        let t = toks[i]
        if t.kind == T_IDENT && t.text == name && toks[i - 1].kind != '.' {
            let pk = toks[i - 1].kind
            let nk = toks[i + 1].kind
            if pk == T_LET || pk == T_VAR {
                if toks[i - 2].kind == T_IF || toks[i - 2].kind == T_WHILE {
                    return false
                }
                // var name[: тип] = {} — и на этом выражение кончается; одно
                // объявление на всё тело
                let j = rw_decl_eq(i, end)
                if found || j < 0 || j + 2 >= end || toks[j + 1].kind != '\{' || toks[j + 2].kind != '}' || rw_expr_scan(j + 1, end) != j + 3 {
                    return false
                }
                found = true
            } else if nk == '[' {
                let close = matching_close(i + 1)
                if close < 0 {
                    return false
                }
                if toks[close + 1].kind == '=' {
                    // name[k] = v: v свежее (элементы name здесь — свежие)
                    if !rw_fresh_expr(close + 2, body, end, depth + 1) {
                        return false
                    }
                }
            } else if nk == '.' && kind_at(i + 2) == T_IDENT && kind_at(i + 3) == '(' && rw_map_read_method(toks[i + 2].text) {
            } else if pk == T_IN && nk == '\{' {
            } else {
                return false
            }
        }
        i += 1
    }
    return found
}

// Начало получателя, если он — просто имя (а не поле x.y): иначе -1.
fn rw_recv_start(last: int) -> int {
    if toks[last].kind == T_IDENT && toks[last - 1].kind != '.' {
        return last
    }
    return -1
}

// Локальная переменная name свежая: объявлена через let/var, и всё, что ей
// присваивается, — свежее. Параметры, переменные циклов и лямбд — не свежие.
// at — лексема, где имя упомянуто (или -1): параметр лямбды с тем же именем,
// в теле которой at нет (xs.map(c => ...) рядом с let c = ...), — другое имя.
fn rw_fresh_local(name: str, at: int, body: int, end: int, depth: int) -> bool {
    if depth > 8 || rw_name_unsafe(name, body) {
        return false
    }
    var decls = 0
    var i = body
    while i < end {
        let t = toks[i]
        if t.kind == T_IDENT && t.text == name && toks[i - 1].kind != '.' {
            let pk = toks[i - 1].kind
            let nk = toks[i + 1].kind
            if pk == T_LET || pk == T_VAR {
                if toks[i - 2].kind == T_IF || toks[i - 2].kind == T_WHILE {
                    return false
                }
                // let name[: тип] = выражение — одно объявление на всё тело
                // (имя в другом блоке — другая переменная, а по лексемам их
                // не различить)
                let j = rw_decl_eq(i, end)
                if j < 0 || !rw_fresh_expr(j + 1, body, end, depth + 1) {
                    return false
                }
                decls += 1
                if decls > 1 {
                    return false
                }
            } else if nk == T_FATARROW && pk == '(' && at >= 0 && (at < i || at > matching_close(i - 1)) {
                // параметр другой лямбды
            } else if pk == T_FOR || nk == T_FATARROW || (pk == ',' && toks[i - 2].kind == T_IDENT && toks[i - 3].kind == T_FOR) {
                return false
            } else if nk == '=' {
                // присваивание имени — где бы оно ни стояло в строке (; лексер
                // отбрасывает): и оно свежее
                if !rw_fresh_expr(i + 2, body, end, depth + 1) {
                    return false
                }
            }
        }
        i += 1
    }
    return decls == 1
}

// Присваивание с оператором в i (тело [body, end)) меняет что-то кроме
// локальных функции: цель — глобальная или store, поле или элемент не свежей
// локальной (на один уровень: xs[i] = ..., s.f = ...) или цель не узнана.
fn rw_assign_effect(i: int, body: int, end: int) -> bool {
    let root = rw_assign_root(i, body)
    if root == -2 {
        return false
    }
    if root < 0 {
        return true
    }
    let name = toks[root].text
    let sym = sym_find(name)
    if sym >= 0 && sym_kind(sym) == SK_GLOBAL {
        return true
    }
    if root == i - 1 {
        // своей локальной (параметры и переменные циклов неизменяемы)
        return false
    }
    if !rw_fresh_local(name, root, body, end, 0) {
        return true
    }
    return !((toks[root + 1].kind == '[' && matching_close(root + 1) == i - 1) || (toks[root + 1].kind == '.' && i == root + 3))
}

// Пишет ли функция fi сама (без учёта вызываемых); вызванные функции
// программы — в callees.
fn rw_scan(fi: int, callees: [int]) -> bool {
    let body = funcs[fi].body
    let end = funcs[fi].body_end
    var i = body
    while i < end {
        let t = toks[i]
        let k = t.kind
        if rw_is_assign(k) {
            if rw_assign_effect(i, body, end) {
                return true
            }
        } else if k == T_IDENT && toks[i + 1].kind == '(' {
            let name = t.text
            let after_dot = toks[i - 1].kind == '.'
            // t.insert(rows) таблицы ClickHouse store не трогает (§8.3); локальная
            // с тем же именем — обычное значение
            let ch_table = after_dot && ch_table_call_at(fi, i - 2)
            if ch_table {
            } else if after_dot && rw_mutating(name) {
                if !rw_fresh_at(i - 2, rw_recv_start(i - 2), body, end, 0) {
                    return true
                }
            } else {
                let sym = sym_find(name)
                if sym >= 0 && sym_kind(sym) == SK_FN {
                    let f = sym_idx(sym)
                    if funcs[f].is_lib {
                        if rw_driver_mutator(name) {
                            if !rw_arg_local(fi, i, after_dot, body, end) {
                                return true
                            }
                        } else if !rw_safe_lib(name) && !rw_driver_safe(name) {
                            return true
                        }
                    } else {
                        callees.push(f)
                    }
                } else if !after_dot && rw_raw_builtin(name) && name != "__to_str" {
                    return true
                }
            }
        }
        i += 1
    }
    return false
}

fn rw_analyze() {
    rw_done = true
    // вызовы функций программы: пары (кто, кого)
    var from: [int] = []
    var to: [int] = []
    var f = 0
    while f < funcs.len() {
        var w = 1
        if funcs[f].body >= 0 && !funcs[f].is_lib {
            var cs: [int] = []
            w = 0
            if rw_scan(f, cs) {
                w = 1
            }
            for c in cs {
                from.push(f)
                to.push(c)
            }
        }
        rw_writes.push(w)
        f += 1
    }
    // пишет и тот, кто вызывает пишущего
    var changed = true
    while changed {
        changed = false
        var e = 0
        while e < from.len() {
            if rw_writes[to[e]] == 1 && rw_writes[from[e]] == 0 {
                rw_writes[from[e]] = 1
                changed = true
            }
            e += 1
        }
    }
}

// Маршрут только читает store.
fn route_reads_only(r: Route) -> bool {
    if !rw_done {
        rw_analyze()
    }
    return r.fi < rw_writes.len() && rw_writes[r.fi] == 0
}

// ============================================================================
// Лямбды без побочных действий (слияние цепочек, src/variant.kh). Цепочку
// m.values().filter(f).map(g)... можно вычислять поэлементно одним проходом,
// только если ни одна её лямбда ничего не меняет и ни с чем не общается:
// тогда порядок вычисления лямбд не виден, кроме паники (её текст — у первого
// по порядку обхода элемента, на котором она случилась). Анализ по лексемам и
// консервативный: всё, в чём он не уверен, — побочное действие. В теле лямбды
// побочные действия:
//   - любое присваивание (бывает в блоке-значении if или match);
//   - изменяющий метод (push, sort_by, ...) у чего угодно;
//   - return, break, continue (выход из цикла посреди цепочки), sql и ch,
//     fetch, call, tx;
//   - вызов функции библиотеки не из списка чистых (print, now, random_str,
//     fail, sleep, драйверы...) или неизвестной функции;
//   - вызов функции программы, у которой они есть (ниже).
// Функция программы чиста, если в её теле нет этого же, но присваивать ей
// можно своим локальным, а менять свежие локальные коллекции (как в анализе
// чтения выше: литералы, filter, map, ...), и return у неё свой; и если все
// функции, которые она вызывает, чисты (неподвижная точка, рекурсия — чиста).
// ============================================================================

// По функциям программы: 0 — чистая, 1 — нет.
var fx_impure: [int]
var fx_done: bool

// Функции библиотеки без побочных действий: ответ зависит только от
// аргументов (и от окружения процесса — env); __to_str — подстановка в
// строку "{x}".
fn fx_pure_lib(name: str) -> bool {
    return name == "__to_str" || name == "time_iso" || name == "parse_time" || name == "parse_date" || name == "to_json" || name == "sha256" || name == "url_encode" || name == "env"
}

// Побочные действия в лексемах [a, b) тела: лямбды (in_fn = false) или
// функции fi (in_fn = true; body, end — её тело). Вызванные функции программы —
// в callees (их чистоту решает fx_analyze).
fn fx_scan(a: int, b: int, in_fn: bool, body: int, end: int, callees: [int]) -> bool {
    var i = a
    while i < b {
        let t = toks[i]
        let k = t.kind
        if k == T_SQL || k == T_CALL {
            return true
        }
        if !in_fn && (k == T_RETURN || k == T_BREAK || k == T_CONTINUE) {
            return true
        }
        if rw_is_assign(k) {
            if !in_fn || fx_assign_effect(i, body, end) {
                return true
            }
        } else if k == T_IDENT {
            if t.text == "fetch" || (t.text == "tx" && kind_at(i + 1) == '\{') {
                return true
            }
            let sym = sym_find(t.text)
            if sym >= 0 && (sym_kind(sym) == SK_TABLE || sym_kind(sym) == SK_CONN) && toks[i - 1].kind != '.' {
                // таблица или соединение базы (и локальная с тем же именем)
                return true
            }
            if kind_at(i + 1) == '(' {
                let after_dot = toks[i - 1].kind == '.'
                if after_dot && rw_mutating(t.text) {
                    if !in_fn || !rw_fresh_at(i - 2, rw_recv_start(i - 2), body, end, 0) {
                        return true
                    }
                }
                if sym >= 0 && sym_kind(sym) == SK_FN {
                    let f = sym_idx(sym)
                    if funcs[f].is_lib {
                        if !fx_pure_lib(t.text) {
                            return true
                        }
                    } else {
                        callees.push(f)
                    }
                } else if !after_dot && t.text != "__to_str" {
                    // встроенная функция компилятора или неизвестное имя
                    return true
                }
            }
        }
        i += 1
    }
    return false
}

// Присваивание в позиции i внутри тела функции [body, end) меняет что-то
// кроме её локальных: глобальную или store, поле или элемент не свежей
// локальной (как в rw_scan).
fn fx_assign_effect(i: int, body: int, end: int) -> bool {
    return rw_assign_effect(i, body, end)
}

fn fx_analyze() {
    fx_done = true
    var from: [int] = []
    var to: [int] = []
    var f = 0
    while f < funcs.len() {
        var w = 1
        if funcs[f].body >= 0 && !funcs[f].is_lib {
            var cs: [int] = []
            w = 0
            if fx_scan(funcs[f].body, funcs[f].body_end, true, funcs[f].body, funcs[f].body_end, cs) {
                w = 1
            }
            for c in cs {
                from.push(f)
                to.push(c)
            }
        }
        fx_impure.push(w)
        f += 1
    }
    var changed = true
    while changed {
        changed = false
        var e = 0
        while e < from.len() {
            if fx_impure[to[e]] == 1 && fx_impure[from[e]] == 0 {
                fx_impure[from[e]] = 1
                changed = true
            }
            e += 1
        }
    }
}

// Тело лямбды — лексемы [a, b) — без побочных действий.
fn lambda_pure(a: int, b: int) -> bool {
    if !fx_done {
        fx_analyze()
    }
    var cs: [int] = []
    if fx_scan(a, b, false, a, b, cs) {
        return false
    }
    for c in cs {
        if c >= fx_impure.len() || fx_impure[c] == 1 {
            return false
        }
    }
    return true
}
