// ============================================================================
// Машинный код x86-64: буфер, кодировщики инструкций, метки, вызовы, данные.
// ============================================================================

const RAX = 0
const RCX = 1
const RDX = 2
const RBX = 3
const RSP = 4
const RBP = 5
const RSI = 6
const RDI = 7
const R8 = 8
const R9 = 9
const R10 = 10
const R11 = 11
const R12 = 12
const R13 = 13
const R14 = 14
const R15 = 15

// Коды условий x86: инверсия условия — младший бит.
const CC_O = 0
const CC_NO = 1
const CC_B = 2
const CC_AE = 3
const CC_E = 4
const CC_NE = 5
const CC_BE = 6
const CC_A = 7
const CC_L = 12
const CC_GE = 13
const CC_LE = 14
const CC_G = 15

const CODE_BASE = 0x400000
const DATA_BASE = 0x20000000
const HDR_SIZE = 176
const CODE_MAX = 268435456
const DATA_MAX = 134217728

// Место в коде, которое дописывается в конце сборки: rel32 вызова функции func
// или (func == FIX_DATA_END) imm64 с концом данных программы.
type Fixup {
    at: int
    func: int
}

const FIX_DATA_END = -1

var code: int
var code_len: int
var data: int
var data_len: int
var fixups: [Fixup]
// Позиция последней метки: щелевая оптимизация не заглядывает за неё.
var barrier: int
// Позиция последнего push rax или -1.
var last_push: int
var strlit_addr: [int]
var const_strs: StrMap = smap_new()
// Таблицы __data_hex по тексту: одинаковый текст — одна таблица.
var data_hexes: StrMap = smap_new()

fn emit_init() {
    code = __mmap(CODE_MAX)
    data = __mmap(DATA_MAX)
    code_len = 0
    data_len = 0
    last_push = -1
    barrier = 0
    const_strs = smap_new()
    data_hexes = smap_new()
    utf8_tab = 0
    case_tab = 0
}

fn emit8(b: int) {
    store8(code + code_len, b)
    code_len += 1
}

fn emit32(v: int) {
    store8(code + code_len, v & 255)
    store8(code + code_len + 1, (v >> 8) & 255)
    store8(code + code_len + 2, (v >> 16) & 255)
    store8(code + code_len + 3, (v >> 24) & 255)
    code_len += 4
}

fn emit64(v: int) {
    emit32(v & 0xFFFFFFFF)
    emit32((v >> 32) & 0xFFFFFFFF)
}

fn put32_at(p: int, v: int) {
    store8(p, v & 255)
    store8(p + 1, (v >> 8) & 255)
    store8(p + 2, (v >> 16) & 255)
    store8(p + 3, (v >> 24) & 255)
}

// Выравнивание на 16 байт заполнителем, который никогда не исполняется
// (между функциями или сразу после безусловного перехода).
fn align16() {
    while (code_len & 15) != 0 {
        emit8(0xCC)
    }
}

// Текущая позиция как цель перехода.
fn here() -> int {
    barrier = code_len
    return code_len
}

fn patch_rel(at: int, target: int) {
    put32_at(code + at, target - at - 4)
}

fn patch_here(at: int) {
    patch_rel(at, here())
}

fn emit_hole() -> int {
    let at = code_len
    emit32(0)
    return at
}

fn emit_jmp() -> int {
    emit8(0xE9)
    return emit_hole()
}

fn emit_jmp_to(target: int) {
    emit8(0xE9)
    emit32(target - code_len - 4)
}

fn emit_jcc(cc: int) -> int {
    emit8(0x0F)
    emit8(0x80 + cc)
    return emit_hole()
}

fn emit_jcc_to(cc: int, target: int) {
    emit8(0x0F)
    emit8(0x80 + cc)
    emit32(target - code_len - 4)
}

// ---- Регистры ----

fn rex_w(reg: int, rm: int) -> int {
    return 0x48 | ((reg >> 3) << 2) | (rm >> 3)
}

// op r/m64, r64 с регистровыми операндами (rm — назначение).
fn emit_rr(op: int, reg: int, rm: int) {
    emit8(rex_w(reg, rm))
    emit8(op)
    emit8(0xC0 | ((reg & 7) << 3) | (rm & 7))
}

fn emit_mov_rr(dst: int, src: int) {
    if dst != src {
        emit_rr(0x89, src, dst)
    }
}

// op reg, [base + disp] или [base + disp], reg — по коду операции.
fn emit_mem(op: int, reg: int, base: int, disp: int) {
    emit8(rex_w(reg, base))
    emit8(op)
    emit_modrm_mem(reg, base, disp)
}

// ModRM (и SIB для rsp, r12) операнда [base + disp]: без смещения, со смещением
// в байт или в 4 байта — самое короткое (у rbp и r13 смещение есть всегда).
fn emit_modrm_mem(reg: int, base: int, disp: int) {
    let rb = ((reg & 7) << 3) | (base & 7)
    var md = 0x80
    if disp == 0 && (base & 7) != 5 {
        md = 0
    } else if disp >= -128 && disp <= 127 {
        md = 0x40
    }
    emit8(md | rb)
    if (base & 7) == 4 {
        emit8(0x24)
    }
    if md == 0x40 {
        emit8(disp & 255)
    } else if md == 0x80 {
        emit32(disp)
    }
}

fn emit_load(dst: int, base: int, disp: int) {
    emit_mem(0x8B, dst, base, disp)
}

fn emit_store(base: int, disp: int, src: int) {
    emit_mem(0x89, src, base, disp)
}

// movzx eax, byte [rax + rcx]: байт строки или bool списка по индексу.
fn emit_movzx_index() {
    emit8(0x0F)
    emit8(0xB6)
    emit8(0x04)
    emit8(0x08)
}

fn emit_mov_imm(dst: int, v: int) {
    if v >= 0 && v <= 0x7FFFFFFF {
        if dst >= 8 {
            emit8(0x41)
        }
        emit8(0xB8 + (dst & 7))
        emit32(v)
        return
    }
    if v < 0 && v >= -2147483648 {
        emit8(0x48 | (dst >> 3))
        emit8(0xC7)
        emit8(0xC0 | (dst & 7))
        emit32(v & 0xFFFFFFFF)
        return
    }
    emit8(0x48 | (dst >> 3))
    emit8(0xB8 + (dst & 7))
    emit64(v)
}

fn fits_i32(v: int) -> bool {
    return v >= -2147483648 && v <= 2147483647
}

// Последняя инструкция — add/sub rax, число (addimm_end = -1 — записи нет): её
// можно убрать и взять число смещением адреса (load64(x + 8) — mov rax, [rax + 8]).
var addimm_at: int
var addimm_end: int = -1
var addimm_val: int

// Арифметика с непосредственным операндом: ext — номер операции в группе 0x81.
fn emit_alu_imm(ext: int, dst: int, v: int) {
    if dst == RAX && (ext == 0 || ext == 5) {
        addimm_at = code_len
        addimm_val = v
        if ext == 5 {
            addimm_val = -v
        }
    }
    emit_alu_imm_raw(ext, dst, v)
    if dst == RAX && (ext == 0 || ext == 5) {
        addimm_end = code_len
    }
}

// Убрать add/sub rax, число, если оно — последняя инструкция и после него нет
// меток (метка ровно перед ним не мешает): → смещение или 0.
fn take_addimm() -> int {
    if addimm_end != code_len || addimm_at < barrier || !fits_i32(addimm_val) {
        return 0
    }
    code_len = addimm_at
    addimm_end = -1
    return addimm_val
}

// op reg, [base + disp] или [base + disp], reg: op — один байт или два
// (0x0FB6 — movzx); w — 64 бита (REX.W). Регистры байтов — только al и cl.
fn emit_mem_sized(op: int, reg: int, base: int, disp: int, w: bool) {
    var rex = 0x40 | ((reg >> 3) << 2) | (base >> 3)
    if w {
        rex = rex | 8
    }
    if rex != 0x40 {
        emit8(rex)
    }
    if op > 255 {
        emit8(op >> 8)
    }
    emit8(op & 255)
    emit_modrm_mem(reg, base, disp)
}

fn emit_alu_imm_raw(ext: int, dst: int, v: int) {
    emit8(0x48 | (dst >> 3))
    if v >= -128 && v <= 127 {
        emit8(0x83)
        emit8(0xC0 | (ext << 3) | (dst & 7))
        emit8(v & 255)
        return
    }
    emit8(0x81)
    emit8(0xC0 | (ext << 3) | (dst & 7))
    emit32(v & 0xFFFFFFFF)
}

fn emit_push(r: int) {
    if r >= 8 {
        emit8(0x41)
    }
    emit8(0x50 + (r & 7))
    if r == RAX {
        last_push = code_len - 1
    }
}

// pop сразу после push rax превращается в mov.
fn emit_pop(r: int) {
    if last_push >= 0 && last_push == code_len - 1 && last_push >= barrier {
        code_len -= 1
        last_push = -1
        emit_mov_rr(r, RAX)
        return
    }
    if r >= 8 {
        emit8(0x41)
    }
    emit8(0x58 + (r & 7))
}

fn emit_test_rax() {
    emit8(0x48)
    emit8(0x85)
    emit8(0xC0)
}

// rax = условие cc ? 1 : 0
fn emit_setcc(cc: int) {
    emit8(0x0F)
    emit8(0x90 + cc)
    emit8(0xC0)
    emit8(0x0F)
    emit8(0xB6)
    emit8(0xC0)
}

// ---- Вызовы ----

// Функции компилируются только если их вызывают: вызов ставит функцию в очередь.
var work: [int]

fn emit_call(fi: int) {
    emit8(0xE8)
    fixups.push(Fixup { at: code_len, func: fi })
    emit32(0)
    if !funcs[fi].used {
        funcs[fi].used = true
        work.push(fi)
    }
}

// Аргументы лежат в стеке (последний сверху); первые шесть уходят в регистры.
fn emit_args_to_regs(n: int) {
    if n <= 6 {
        var i = n - 1
        while i >= 0 {
            emit_pop(arg_reg(i))
            i -= 1
        }
        return
    }
    var i = 0
    while i < 6 {
        emit_load(arg_reg(i), RSP, (n - 1 - i) * 8)
        i += 1
    }
}

fn emit_args_cleanup(n: int) {
    if n > 6 {
        emit_alu_imm(0, RSP, n * 8)
    }
}

fn arg_reg(i: int) -> int {
    if i == 0 {
        return RDI
    }
    if i == 1 {
        return RSI
    }
    if i == 2 {
        return RDX
    }
    if i == 3 {
        return RCX
    }
    if i == 4 {
        return R8
    }
    return R9
}

// ---- Данные ----

fn data_byte(b: int) {
    store8(data + data_len, b)
    data_len += 1
}

fn data_align() {
    while (data_len & 7) != 0 {
        data_len += 1
    }
}

fn data_u64(v: int) {
    data_align()
    store64(data + data_len, v)
    data_len += 8
}

// Строка в сегменте данных: байты, ноль, заголовок {ptr, len} → адрес заголовка.
fn data_str(s: str) -> int {
    let off = data_len
    var i = 0
    let n = s.byte_len()
    while i < n {
        data_byte(s.byte(i))
        i += 1
    }
    data_byte(0)
    data_align()
    let h = data_len
    data_u64(DATA_BASE + off)
    data_u64(n)
    return DATA_BASE + h
}

fn strlit(i: int) -> int {
    while strlit_addr.len() <= i {
        strlit_addr.push(0)
    }
    if strlit_addr[i] == 0 {
        strlit_addr[i] = data_str(strlits[i])
    }
    return strlit_addr[i]
}

// Строка, которую создаёт сам компилятор (места паник и т. п.), без повторов.
fn const_str(s: str) -> int {
    let a = smap_get(const_strs, s)
    if a >= 0 {
        return a
    }
    let addr = data_str(s)
    smap_put(const_strs, s, addr)
    return addr
}

// Таблица __data_hex: байты из шестнадцатеричного текста («0F C0 …», пробелы
// между парами не в счёт) — в DATA с выравниванием на 8 → адрес или -1, если в
// тексте не пары шестнадцатеричных цифр (и если пробел разрывает пару: data_hex
// читает пару как две цифры подряд). Функцию с таблицей могут встроить много
// раз, а таблица остаётся одна.
fn data_hex_table(s: str) -> int {
    let a = smap_get(data_hexes, s)
    if a >= 0 {
        return a
    }
    var digits = 0
    for i in 0..s.byte_len() {
        let c = s.byte(i)
        if c == ' ' {
            if digits % 2 != 0 {
                return -1
            }
        } else {
            if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')) {
                return -1
            }
            digits += 1
        }
    }
    if digits % 2 != 0 {
        return -1
    }
    data_align()
    let addr = DATA_BASE + data_len
    data_hex(s)
    smap_put(data_hexes, s, addr)
    return addr
}
