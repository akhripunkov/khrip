// ============================================================================
// Объявления верхнего уровня и таблица имён. Предварительный проход собирает
// все типы, функции, глобальные переменные и константы до компиляции тел,
// поэтому порядок объявлений в программе не важен.
// ============================================================================

const SK_FN = 1
const SK_STRUCT = 2
const SK_GLOBAL = 3
const SK_CONST = 4
const SK_SUM = 5

const FK_USER = 0
const FK_ROUTE = 1
const FK_TEST = 2
const FK_GEN = 3
const FK_EVERY = 4

type Param {
    name: str
    ty: int
    // лексема значения по умолчанию (литерал) или -1
    def: int
}

type Func {
    name: str
    params: [Param]
    ret: int
    tok: int
    body: int
    body_end: int
    code: int
    kind: int
    inline_ok: bool
    is_lib: bool
    used: bool
    size: int
}

type Global {
    name: str
    ty: int
    addr: int
    init: int
    tok: int
    is_store: bool
}

type Const {
    name: str
    ty: int
    val: int
    // строка-литерал (номер в strlits) или -1
    lit: int
}

var funcs: [Func]
var globals: [Global]
var consts: [Const]
var sym_map: StrMap = smap_new()
var sym_kinds: [int]
var sym_idxs: [int]

var pos: int

fn tok() -> Token {
    return toks[pos]
}

fn kind() -> int {
    return toks[pos].kind
}

fn kind_at(i: int) -> int {
    if i >= toks.len() {
        return T_EOF
    }
    return toks[i].kind
}

fn advance() {
    if toks[pos].kind != T_EOF {
        pos += 1
    }
}

fn tok_desc(k: int) -> str {
    if k == T_EOF {
        return "end of file"
    }
    if k == T_IDENT {
        return "a name"
    }
    if k == T_INT {
        return "a number"
    }
    if k == T_CHAR {
        return "a character"
    }
    if k == T_STR {
        return "a string"
    }
    if k < 128 {
        return "'" + __str_from_byte(k) + "'"
    }
    if k == T_ARROW {
        return "'->'"
    }
    if k == T_IN {
        return "'in'"
    }
    return "a token"
}

fn tok_show(t: Token) -> str {
    if t.kind == T_EOF {
        return "end of file"
    }
    return "'" + t.text + "'"
}

fn expect_tok(k: int) -> bool {
    if kind() == k {
        advance()
        return true
    }
    var hint = ""
    let found = tok().text
    if k == '{' && kind() == ':' {
        hint = "Khrip blocks use braces, not a colon"
    } else if found == "and" || found == "or" || found == "not" {
        hint = "Khrip uses && || ! instead of and, or, not"
    } else if found == "then" || found == "do" {
        hint = "write the block in braces: if x \{ ... }"
    }
    syntax_error(tok(), "expected " + tok_desc(k) + ", found " + tok_show(tok()), hint)
    return false
}

fn expect_ident() -> Token {
    let t = tok()
    if t.kind == T_IDENT {
        advance()
        return t
    }
    var hint = ""
    if t.kind >= T_FN && t.kind <= T_MATCH {
        hint = "'" + t.text + "' is a keyword and cannot be used as a name"
    }
    syntax_error(t, "expected a name, found " + tok_show(t), hint)
    return t
}

// Индекс парной закрывающей скобки для открывающей в позиции i.
fn matching_close(i: int) -> int {
    var depth = 0
    var j = i
    while j < toks.len() {
        let k = toks[j].kind
        if k == '(' || k == '[' || k == '\{' {
            depth += 1
        } else if k == ')' || k == ']' || k == '}' {
            depth -= 1
            if depth == 0 {
                return j
            }
        } else if k == T_EOF {
            return j
        }
        j += 1
    }
    return toks.len() - 1
}

// ---- Таблица имён ----

fn sym_find(name: str) -> int {
    return smap_get(sym_map, name)
}

fn sym_add(name: str, kind: int, idx: int, t: Token) -> bool {
    if smap_get(sym_map, name) >= 0 {
        error_tok(t, "'" + name + "' is already defined", "")
        return false
    }
    sym_kinds.push(kind)
    sym_idxs.push(idx)
    smap_put(sym_map, name, sym_kinds.len() - 1)
    return true
}

fn sym_kind(s: int) -> int {
    return sym_kinds[s]
}

fn sym_idx(s: int) -> int {
    return sym_idxs[s]
}

fn func_find(name: str) -> int {
    let s = sym_find(name)
    if s < 0 || sym_kinds[s] != SK_FN {
        return -1
    }
    return sym_idxs[s]
}

// Внутренняя функция библиотеки, которую вызывает сгенерированный код.
fn rt_func(name: str) -> int {
    let f = func_find(name)
    if f < 0 {
        error_tok(tok(), "internal: missing runtime function " + name, "")
        return 0
    }
    return f
}

// ---- Типы в объявлениях ----

fn generic_ok() -> bool {
    return files[tok().file].is_lib
}

// int | bool | str | Имя | [T] | map[K, V] | T? | { поле: T, ... }
fn parse_type() -> int {
    var t = ty_err
    let start = tok()
    if kind() == '[' {
        advance()
        let e = parse_type()
        expect_tok(']')
        t = ty_list(e)
    } else if kind() == '\{' {
        t = parse_anon_type()
    } else if kind() == T_IDENT {
        let name = start.text
        advance()
        if name == "int" {
            t = ty_int
        } else if name == "bool" {
            t = ty_bool
        } else if name == "str" {
            t = ty_str
        } else if name == "float" {
            t = ty_float
        } else if name == "map" {
            if expect_tok('[') {
                let k = parse_type()
                expect_tok(',')
                let v = parse_type()
                expect_tok(']')
                if k != ty_int && k != ty_str && k != ty_err {
                    error_tok(start, "map keys must be int or str, not " + ty_name(k), "")
                }
                t = ty_map(k, v)
            }
        } else if (name == "T" || name == "K" || name == "V") && generic_ok() {
            t = ty_make(K_GEN, name.byte(0), 0)
        } else if name.starts_with("__anon") && files[start.file].is_lib {
            // анонимная структура в сгенерированном коде: __anon<номер> (ty_src)
            t = ty_struct(anon_index(name))
        } else {
            let s = struct_find(name)
            let u = sum_find(name)
            if s >= 0 {
                t = ty_struct(s)
            } else if u >= 0 {
                t = ty_sum(u)
            } else {
                error_tok(start, "unknown type '" + name + "'", type_hint(name))
            }
        }
    } else {
        syntax_error(start, "expected a type, found " + tok_show(start), "types are int, bool, str, [T], map[K, V], T?, \{ field: T } or a type name")
    }
    if kind() == '?' {
        advance()
        t = ty_opt(t)
    }
    return t
}

// ---- Анонимные структуры (A1) ----
// { поле: тип [= литерал], ... } пишется везде, где пишется тип. Тип
// структурный: те же имена полей с теми же типами и значениями по умолчанию в
// любом порядке — одна структура (anon_struct). Именованные типы остаются
// номинальными: значение анонимного типа становится именованным только
// литералом или распаковкой (User { ...x }).

fn parse_anon_type() -> int {
    let open = pos
    let at = tok()
    advance()
    var names: [str] = []
    var tys: [int] = []
    var defs: [int] = []
    var bad = false
    while kind() != '}' && kind() != T_EOF && !panic_mode {
        if kind() == T_ELLIPSIS {
            error_tok(tok(), "an anonymous type cannot copy fields with ...", "name the type: type Name \{ ...Other, field: T }")
            bad = true
            advance()
            if kind() == T_IDENT {
                advance()
            }
        } else {
            let fname = expect_ident()
            if panic_mode || !expect_tok(':') {
                break
            }
            let ft = parse_type()
            var def = -1
            if kind() == '=' {
                advance()
                let dt = tok()
                def = pos
                let lt = default_literal(ft)
                if lt < 0 {
                    error_tok(dt, "a field default must be a literal: a number, string, true, false, none, [], \{} or a variant without fields", "compute other values in the code that creates the value")
                    def = -1
                    bad = true
                    while kind() != ',' && kind() != '}' && kind() != T_EOF && tok().line == dt.line {
                        advance()
                    }
                } else if !default_fits(lt, ft) && ft != ty_err {
                    error_tok(dt, "the default does not fit field '" + fname.text + "' of type " + ty_name(ft), "")
                    bad = true
                }
            }
            if ft == ty_err {
                bad = true
            }
            if list_has(names, fname.text) {
                error_tok(fname, "field '" + fname.text + "' is declared twice in this type", "remove one of them")
                bad = true
            } else {
                names.push(fname.text)
                tys.push(ft)
                defs.push(def)
            }
        }
        if kind() == ',' {
            advance()
        }
    }
    if panic_mode {
        // восстановление: за парной скобкой
        pos = matching_close(open)
        advance()
        return ty_err
    }
    expect_tok('}')
    if bad {
        return ty_err
    }
    if names.len() == 0 {
        error_tok(at, "an anonymous struct type needs at least one field", "write its fields: \{ name: str }")
        return ty_err
    }
    let si = anon_struct(names, tys, defs, open)
    if !files[at.file].is_lib && quiet == 0 {
        anon_written(si, open)
    }
    return ty_struct(si)
}

var anon_structs: [int]

// Анонимная структура с полями names (типы tys, значения по умолчанию defs —
// лексемы литералов или -1): та, что уже есть с тем же набором полей, или
// новая с полями в этом порядке. Её имя — запись типа: { a: int, b: str }.
fn anon_struct(names: [str], tys: [int], defs: [int], open: int) -> int {
    let n = names.len()
    for si in anon_structs {
        let fs = structs[si].fields
        if fs.len() == n {
            var same = true
            var i = 0
            while i < n && same {
                let j = field_find(si, names[i])
                same = j >= 0 && fs[j].ty == tys[i] && default_key(fs[j].def, fs[j].ty) == default_key(defs[i], tys[i])
                i += 1
            }
            if same {
                return si
            }
        }
    }
    var fs: [Field] = []
    var text = "\{ "
    var i = 0
    while i < n {
        fs.push(Field { name: names[i], ty: tys[i], def: defs[i] })
        if i > 0 {
            text += ", "
        }
        text += names[i] + ": " + ty_name(tys[i])
        if defs[i] >= 0 {
            text += " = " + default_text(defs[i], tys[i])
        }
        i += 1
    }
    text += " }"
    structs.push(StructT { name: text, fields: fs, tok: open, sum: -1 })
    struct_state.push(2)
    struct_tok.push(open)
    anon_structs.push(structs.len() - 1)
    return structs.len() - 1
}

// Структура si — анонимная (её имя — запись типа).
fn is_anon(si: int) -> bool {
    return structs[si].name.byte(0) == '\{'
}

fn is_anon_ty(t: int) -> bool {
    return tkind(t) == K_STRUCT && is_anon(types[t].a)
}

// Номер структуры из имени __anon<номер> сгенерированного кода.
fn anon_index(name: str) -> int {
    var v = 0
    var i = 6
    while i < name.byte_len() {
        v = v * 10 + name.byte(i) - '0'
        i += 1
    }
    return v
}

// Значение по умолчанию поля типа ty (лексема def или -1) для сравнения типов:
// одно и то же значение, записанное одинаково, — один ключ.
fn default_key(def: int, ty: int) -> str {
    if def < 0 {
        return ""
    }
    let t = toks[def]
    if t.kind == '-' {
        return "-" + toks[def + 1].kind.to_str() + ":" + toks[def + 1].val.to_str()
    }
    if t.kind == T_STR {
        return "s:" + strlits[t.val]
    }
    if t.kind == T_CHAR {
        // 'x' у поля int или float — код символа, иначе строка из него
        if ty_inner(ty) == ty_int || ty_inner(ty) == ty_float {
            return T_INT.to_str() + ":" + t.val.to_str()
        }
        return "s:" + char_text(t.val)
    }
    if t.kind == T_IDENT {
        return "e:" + t.text
    }
    if t.kind == '[' {
        return "[]"
    }
    if t.kind == '\{' {
        return "\{}"
    }
    return t.kind.to_str() + ":" + t.val.to_str()
}

// Значение по умолчанию для имени типа: как в исходнике.
fn default_text(def: int, ty: int) -> str {
    let k = toks[def].kind
    if k == '[' {
        return "[]"
    }
    if k == '\{' {
        return "\{}"
    }
    return default_src(def, ty_inner(ty))
}

// W-A2: одна и та же анонимная структура, записанная как тип в трёх местах
// программы, — предупреждение «дайте ей имя» (anon_warnings, в конце сборки, —
// у третьего места по тексту). Места — по лексеме {: повторный разбор того же
// места (встраивание) не считается.
var anon_use_si: [int]
var anon_use_at: [int]

fn anon_written(si: int, open: int) {
    var i = 0
    while i < anon_use_si.len() {
        if anon_use_si[i] == si && anon_use_at[i] == open {
            return
        }
        i += 1
    }
    anon_use_si.push(si)
    anon_use_at.push(open)
}

fn anon_warnings() {
    for si in anon_structs {
        var at: [int] = []
        var i = 0
        while i < anon_use_si.len() {
            if anon_use_si[i] == si {
                at.push(anon_use_at[i])
            }
            i += 1
        }
        let n = at.len()
        if n >= 3 {
            // третье место по тексту: два раза убрать наименьшее
            var k = 0
            while k < 3 {
                var m = 0
                var j = 1
                while j < at.len() {
                    if at[j] < at[m] {
                        m = j
                    }
                    j += 1
                }
                if k < 2 {
                    at[m] = toks.len()
                } else {
                    at[0] = at[m]
                }
                k += 1
            }
            warn_tok(toks[at[0]], "the anonymous type " + structs[si].name + " is written " + n.to_str() + " times", "name it once: type Name " + structs[si].name + ", then write Name")
        }
    }
}

// ---- Предварительный проход ----

var struct_state: [int]
var struct_tok: [int]

// Структура с телом в позиции body (-1 — вариант без полей).
fn add_struct(name: Token, body: int, sum: int) -> int {
    var fs: [Field] = []
    structs.push(StructT { name: name.text, fields: fs, tok: body, sum: sum })
    var st = 0
    if body < 0 {
        st = 2
    }
    struct_state.push(st)
    struct_tok.push(body)
    sym_add(name.text, SK_STRUCT, structs.len() - 1, name)
    return structs.len() - 1
}

// type Имя { поля }  или  type Имя = Вариант { поля } | Вариант | ...
fn prescan_type_name() {
    advance()
    let name = expect_ident()
    if name.kind != T_IDENT {
        return
    }
    if kind() != '=' {
        add_struct(name, pos, -1)
        return
    }
    advance()
    let si = sums.len()
    var vs: [int] = []
    sums.push(SumT { name: name.text, variants: vs, tok: pos })
    sym_add(name.text, SK_SUM, si, name)
    if kind() == '|' {
        advance()
    }
    while true {
        let vn = expect_ident()
        if vn.kind != T_IDENT {
            return
        }
        var body = -1
        if kind() == '\{' {
            body = pos
            pos = matching_close(pos)
            advance()
        }
        sums[si].variants.push(add_struct(vn, body, si))
        if kind() != '|' {
            break
        }
        advance()
    }
}

// Индекс последнего токена объявления type, которое начинается в i.
fn type_decl_end(i: int) -> int {
    var j = i + 2
    if kind_at(j) == '\{' {
        return matching_close(j)
    }
    if kind_at(j) != '=' {
        return i + 1
    }
    j += 1
    if kind_at(j) == '|' {
        j += 1
    }
    while true {
        if kind_at(j) != T_IDENT {
            return j - 1
        }
        j += 1
        if kind_at(j) == '\{' {
            j = matching_close(j) + 1
        }
        if kind_at(j) != '|' {
            return j - 1
        }
        j += 1
    }
    return j
}

// Значение поля типа ft по умолчанию — литерал; токены литерала пропускаются.
// → тип литерала или -1, если это не литерал.
fn default_literal(ft: int) -> int {
    let k = kind()
    if k == '-' && kind_at(pos + 1) == T_INT {
        advance()
        advance()
        return ty_int
    }
    if k == '-' && kind_at(pos + 1) == T_FLOAT {
        advance()
        advance()
        return ty_float
    }
    if k == T_INT {
        advance()
        return ty_int
    }
    if k == T_FLOAT {
        advance()
        return ty_float
    }
    if k == T_STR {
        advance()
        return ty_str
    }
    if k == T_CHAR {
        // 'x': код символа у поля int, иначе str (как в parse_atom)
        advance()
        if ty_inner(ft) == ty_int || ty_inner(ft) == ty_float {
            return ty_int
        }
        return ty_str
    }
    if k == T_TRUE || k == T_FALSE {
        advance()
        return ty_bool
    }
    if k == T_NONE {
        advance()
        return ty_none
    }
    if k == T_IDENT {
        // вариант без полей: role: Role = Member
        let si = struct_find(tok().text)
        if si >= 0 && structs[si].sum >= 0 && struct_tok[si] < 0 {
            advance()
            return ty_sum(structs[si].sum)
        }
    }
    if k == '[' && kind_at(pos + 1) == ']' {
        advance()
        advance()
        return ty_list(ty_err)
    }
    if k == '\{' && kind_at(pos + 1) == '}' {
        advance()
        advance()
        return ty_map(ty_err, ty_err)
    }
    return -1
}

fn default_fits(lt: int, ft: int) -> bool {
    if lt == ty_none {
        return tkind(ft) == K_OPT
    }
    if lt == ty_int && ty_inner(ft) == ty_float {
        return true
    }
    if tkind(lt) == K_LIST || tkind(lt) == K_MAP {
        return tkind(ft) == tkind(lt)
    }
    return assignable(lt, ft)
}

// Поля структуры s; ...Другая подставляет поля другой структуры.
fn prescan_struct_fields(s: int) {
    if struct_state[s] == 2 {
        return
    }
    if struct_state[s] == 1 {
        error_tok(toks[struct_tok[s]], "type '" + structs[s].name + "' includes itself through ...", "")
        return
    }
    struct_state[s] = 1
    let saved = pos
    pos = struct_tok[s]
    if expect_tok('\{') {
        while kind() != '}' && kind() != T_EOF {
            panic_mode = false
            if kind() == T_ELLIPSIS {
                advance()
                let other = expect_ident()
                let o = struct_find(other.text)
                if o < 0 {
                    error_tok(other, "unknown type '" + other.text + "'", "")
                } else {
                    prescan_struct_fields(o)
                    for f in structs[o].fields {
                        add_field(s, f.name, f.ty, other, f.def)
                    }
                }
            } else {
                let fname = expect_ident()
                if !expect_tok(':') {
                    skip_line()
                    continue
                }
                let ft = parse_type()
                var def = -1
                if kind() == '=' {
                    advance()
                    let at = tok()
                    def = pos
                    let lt = default_literal(ft)
                    if lt < 0 {
                        error_tok(at, "a field default must be a literal: a number, string, true, false, none, [], \{} or a variant without fields", "compute other values in the code that creates the value")
                        def = -1
                        // до следующего поля: «,», «}» или конец строки
                        while kind() != ',' && kind() != '}' && kind() != T_EOF && tok().line == at.line {
                            advance()
                        }
                    } else if !default_fits(lt, ft) && ft != ty_err {
                        error_tok(at, "the default does not fit field '" + fname.text + "' of type " + ty_name(ft), "")
                    }
                }
                add_field(s, fname.text, ft, fname, def)
            }
            if kind() == ',' {
                advance()
            }
        }
    }
    struct_state[s] = 2
    pos = saved
}

fn add_field(s: int, name: str, t: int, at: Token, def: int) {
    if field_find(s, name) >= 0 {
        error_tok(at, "field '" + name + "' is declared twice in '" + structs[s].name + "'", "")
        return
    }
    structs[s].fields.push(Field { name: name, ty: t, def: def })
}

// Пропуск до начала следующей строки.
fn skip_line() {
    let line = tok().line
    while kind() != T_EOF && tok().line == line {
        advance()
    }
}

fn parse_params() -> [Param] {
    var ps: [Param] = []
    if !expect_tok('(') {
        return ps
    }
    while kind() != ')' && kind() != T_EOF {
        let pn = expect_ident()
        if panic_mode {
            break
        }
        var pt = ty_err
        if kind() == ':' {
            advance()
            pt = parse_type()
        } else {
            error_tok(pn, "parameter '" + pn.text + "' needs a type", "write " + pn.text + ": int (or another type)")
        }
        var def = -1
        if kind() == '=' {
            // значение по умолчанию: литерал
            advance()
            def = pos
            if kind() == '-' && (kind_at(pos + 1) == T_INT || kind_at(pos + 1) == T_FLOAT) {
                advance()
            }
            let dk = kind()
            if dk == T_INT || dk == T_FLOAT || dk == T_STR || dk == T_CHAR || dk == T_TRUE || dk == T_FALSE || dk == T_NONE || dk == T_IDENT {
                advance()
                if kind() != ',' && kind() != ')' {
                    error_tok(toks[def], "a default value must be a single literal: 10, \"text\", true, none or an enum value", "compute it inside the function")
                    while kind() != ',' && kind() != ')' && kind() != T_EOF {
                        advance()
                    }
                    def = -1
                }
            } else {
                error_tok(tok(), "a default value must be a literal, found " + tok_show(tok()), pn.text + ": int = 10")
                def = -1
            }
        }
        ps.push(Param { name: pn.text, ty: pt, def: def })
        if kind() == ',' {
            advance()
        } else if kind() != ')' {
            syntax_error(tok(), "expected ',' or ')' in the parameter list, found " + tok_show(tok()), "")
            break
        }
    }
    expect_tok(')')
    return ps
}

fn prescan_fn(kind_: int) {
    advance()
    let name = expect_ident()
    if name.kind != T_IDENT {
        return
    }
    let ps = parse_params()
    if !files[name.file].is_lib {
        str_method_clash(name, ps)
    }
    var ret = ty_void
    if kind() == T_ARROW {
        advance()
        ret = parse_type()
    } else if kind() == ':' {
        error_tok(tok(), "the result type is written after ->", "fn " + name.text + "(...) -> int \{ ... }")
        advance()
        parse_type()
    }
    let body = pos
    if kind() != '\{' {
        syntax_error(tok(), "expected '\{' to start the body of '" + name.text + "'", "")
        return
    }
    let end = matching_close(body)
    let fi = funcs.len()
    funcs.push(Func {
        name: name.text,
        params: ps,
        ret: ret,
        tok: pos - 1,
        body: body,
        body_end: end,
        code: -1,
        kind: kind_,
        inline_ok: false,
        is_lib: files[name.file].is_lib,
        used: false,
        size: end - body
    })
    sym_add(name.text, SK_FN, fi, name)
    funcs[fi].inline_ok = can_inline(fi)
}

// Маленькие нерекурсивные функции без циклов встраиваются в место вызова
// (кроме помеченных __noinline() в библиотеке).
fn can_inline(fi: int) -> bool {
    let f = funcs[fi]
    if f.body_end - f.body > 48 || f.params.len() > 6 || f.kind != FK_USER || f.name == "main" {
        return false
    }
    var i = f.body + 1
    while i < f.body_end {
        let k = toks[i].kind
        if k == T_WHILE || k == T_FOR {
            return false
        }
        if k == T_IDENT && (toks[i].text == f.name || toks[i].text.starts_with("__simd_") || toks[i].text == "tx" || toks[i].text == "__noinline") {
            return false
        }
        i += 1
    }
    return true
}

fn global_slot() -> int {
    data_align()
    let addr = DATA_BASE + data_len
    data_u64(0)
    return addr
}

// var имя: тип [= выражение] и store имя: тип [= выражение]
fn prescan_global(is_store: bool) {
    let kw = tok()
    advance()
    let name_at = pos
    let name = expect_ident()
    if name.kind != T_IDENT {
        return
    }
    var t = ty_err
    if kind() == ':' {
        advance()
        t = parse_type()
    } else {
        error_tok(name, "global '" + name.text + "' needs a type", "write " + kw.text + " " + name.text + ": int = 0")
    }
    var init = -1
    if kind() == '=' {
        advance()
        init = pos
    }
    globals.push(Global { name: name.text, ty: t, addr: global_slot(), init: init, tok: name_at, is_store: is_store })
    sym_add(name.text, SK_GLOBAL, globals.len() - 1, name)
}

// const ИМЯ = литерал
fn prescan_const() {
    advance()
    let name = expect_ident()
    if name.kind != T_IDENT || !expect_tok('=') {
        return
    }
    var neg = false
    if kind() == '-' {
        neg = true
        advance()
    }
    let v = tok()
    var t = ty_int
    var val = v.val
    var lit = -1
    if v.kind == T_INT {
        if neg {
            val = -val
        }
    } else if v.kind == T_STR && !neg {
        t = ty_str
        val = strlit(v.val)
        lit = v.val
    } else if v.kind == T_CHAR {
        // const SEP = ',' — str из одного символа; const NEG = -'a' — число
        if neg {
            val = -val
        } else {
            t = ty_str
            lit = add_strlit(char_text(v.val))
            val = strlit(lit)
        }
    } else if (v.kind == T_TRUE || v.kind == T_FALSE) && !neg {
        t = ty_bool
        val = 0
        if v.kind == T_TRUE {
            val = 1
        }
    } else {
        error_tok(v, "a constant must be a number, string or boolean literal", "use a global var for computed values")
        return
    }
    advance()
    consts.push(Const { name: name.text, ty: t, val: val, lit: lit })
    sym_add(name.text, SK_CONST, consts.len() - 1, name)
}

fn decl_hint(t: Token) -> str {
    if t.text == "func" || t.text == "def" || t.text == "function" || t.text == "fun" {
        return "declare functions with fn"
    }
    if t.text == "struct" || t.text == "class" || t.text == "interface" || t.text == "record" {
        return "declare types with type Name \{ field: type }"
    }
    if t.text == "import" || t.text == "package" || t.text == "use" || t.text == "include" {
        return "Khrip has no imports: the standard library and all project files are always available"
    }
    if t.kind == T_LET {
        return "use var name: type = value for globals"
    }
    return ""
}

// Проход по объявлениям верхнего уровня. pass 1 — имена типов, pass 2 — всё остальное.
fn prescan(pass: int) {
    prescan_from(pass, 0)
}

fn prescan_from(pass: int, from: int) {
    var i = from
    var depth = 0
    // незакрытая { объявления type доходит до конца файла: за ним — конец
    while i < toks.len() && toks[i].kind != T_EOF {
        let k = toks[i].kind
        if depth == 0 && k == T_TYPE {
            pos = i
            panic_mode = false
            if pass == 1 {
                prescan_type_name()
            }
            i = type_decl_end(i) + 1
            continue
        }
        if depth == 0 {
            pos = i
            panic_mode = false
            if pass == 2 {
                if k == T_FN {
                    prescan_fn(FK_USER)
                } else if k == T_VAR {
                    prescan_global(false)
                } else if k == T_STORE {
                    prescan_global(true)
                } else if k == T_CONST {
                    prescan_const()
                } else if k == T_ROUTE || k == T_TEST {
                    prescan_api(k)
                } else if k == T_IDENT && toks[i].text == "every" && kind_at(i + 1) == T_INT {
                    prescan_every()
                } else if k == T_IDENT && toks[i].text == "migration" && kind_at(i + 1) == T_INT {
                    prescan_migration()
                    i += 3
                    continue
                } else if k == T_IDENT && toks[i].text == "clickhouse" && kind_at(i + 1) == T_IDENT && kind_at(i + 2) == '=' {
                    i = prescan_ch_conn()
                    continue
                } else if k == T_IDENT && toks[i].text == "table" && kind_at(i + 1) == T_IDENT && kind_at(i + 2) == ':' && line_start_at(i) {
                    i = prescan_ch_table()
                    continue
                } else if k == T_IDENT && toks[i].text == "migration" && kind_at(i + 1) == T_IDENT && kind_at(i + 2) == T_INT {
                    i = prescan_ch_migration()
                    continue
                } else if k != T_TYPE && starts_decl_error(i) {
                    error_tok(toks[i], "expected a declaration (fn, type, var, const, store, route, every, test, migration, table or clickhouse), found " + tok_show(toks[i]), decl_hint(toks[i]))
                }
                if (k == T_FN || k == T_ROUTE || k == T_TEST) && pos > i && toks[pos].kind == '\{' {
                    // заголовок разобран, pos — на { тела: дальше — тело (тип
                    // результата { поле: T } перед ним — не начало объявления)
                    i = pos + 1
                    depth += 1
                    continue
                }
                if (k == T_VAR || k == T_STORE) && pos > i {
                    // имя и тип разобраны: дальше — начальное значение (= после
                    // типа { поле: T } — не начало объявления)
                    i = pos
                    continue
                }
            }
        }
        if k == '(' || k == '[' || k == '\{' {
            depth += 1
        } else if k == ')' || k == ']' || k == '}' {
            depth -= 1
            if depth < 0 {
                depth = 0
            }
        }
        i += 1
    }
    if pass == 2 {
        var s = 0
        while s < structs.len() {
            prescan_struct_fields(s)
            s += 1
        }
    }
    pos = 0
    panic_mode = false
}

// Сообщать об ошибке только в начале «мусорной» строки верхнего уровня.
fn starts_decl_error(i: int) -> bool {
    if i == 0 {
        return true
    }
    let p = toks[i - 1]
    return p.line != toks[i].line || p.kind == '}'
}
