// ============================================================================
// khc — компилятор Khrip-1, написанный на Khrip-1.
//
//   khc -o <выход> <файл.kh>...     собрать программу
//   khc run <файл.kh>...            собрать и сразу запустить
//   khc test <файл.kh>...           собрать и запустить блоки test
//   khc check <файл.kh>...          только проверить
//   ключи: --json (ошибки в JSON; столбец, как и в обычном выводе, — номер
//          символа в строке), --test (собрать запуск тестов в -o),
//          --system (программа — системный код: строки только через байтовый
//          API; так собираются исходники компилятора), --all-lib (проверить
//          все функции подключённой библиотеки, а не только вызванные)
//
// Стандартная библиотека (lib/*.kh) подключается сама: каталог lib ищется
// рядом с исполняемым файлом компилятора (../lib) или в $KHRIP_LIB.
// ============================================================================

fn version() -> str {
    return "0.12.0"
}

fn put16_at(p: int, v: int) {
    store8(p, v & 255)
    store8(p + 1, (v >> 8) & 255)
}

fn put64_at(p: int, v: int) {
    put32_at(p, v & 0xFFFFFFFF)
    put32_at(p + 4, (v >> 32) & 0xFFFFFFFF)
}

// Каталог, где лежит исполняемый файл компилятора.
fn exe_dir() -> str {
    let buf = __alloc(4096)
    let n = syscall(89, __cstr("/proc/self/exe"), buf, 4095)
    if n <= 0 {
        return "."
    }
    var i = n - 1
    while i > 0 && load8(buf + i) != '/' {
        i -= 1
    }
    return __str_new(buf, i)
}

fn find_lib() -> str {
    return env("KHRIP_LIB") ?? exe_dir() + "/../lib"
}

fn load_file(path: str, is_lib: bool) -> bool {
    let text = read_file(path)
    if text == none {
        eprint("khc: cannot read " + path)
        return false
    }
    files.push(SrcFile { path: path, text: text ?? "", is_lib: is_lib })
    return true
}

// Статический ELF: код с CODE_BASE (вместе с заголовками), данные с DATA_BASE.
fn elf_image() -> str {
    let code_end = HDR_SIZE + code_len
    let data_off = (code_end + 0xFFF) & ~0xFFF
    let total = data_off + data_len
    let img = __mmap(total + 16)
    store8(img, 0x7F)
    store8(img + 1, 'E')
    store8(img + 2, 'L')
    store8(img + 3, 'F')
    store8(img + 4, 2)
    store8(img + 5, 1)
    store8(img + 6, 1)
    put16_at(img + 16, 2)
    put16_at(img + 18, 0x3E)
    put32_at(img + 20, 1)
    put64_at(img + 24, CODE_BASE + HDR_SIZE)
    put64_at(img + 32, 64)
    put16_at(img + 52, 64)
    put16_at(img + 54, 56)
    put16_at(img + 56, 2)
    put16_at(img + 58, 64)
    put32_at(img + 64, 1)
    put32_at(img + 68, 5)
    put64_at(img + 72, 0)
    put64_at(img + 80, CODE_BASE)
    put64_at(img + 88, CODE_BASE)
    put64_at(img + 96, code_end)
    put64_at(img + 104, code_end)
    put64_at(img + 112, 0x1000)
    put32_at(img + 120, 1)
    put32_at(img + 124, 6)
    put64_at(img + 128, data_off)
    put64_at(img + 136, DATA_BASE)
    put64_at(img + 144, DATA_BASE)
    put64_at(img + 152, data_len)
    put64_at(img + 160, data_len)
    put64_at(img + 168, 0x1000)
    __memcpy(img + HDR_SIZE, code, code_len)
    __memcpy(img + data_off, data, data_len)
    return __str_new(img, total)
}

// Запуск собранной программы без файла на диске: memfd_create + execveat.
fn run_image(img: str, name: str) -> int {
    let fd = syscall(319, __cstr(name), 0)
    if fd < 0 {
        eprint("khc: memfd_create failed")
        return 1
    }
    var off = 0
    while off < img.byte_len() {
        let w = syscall(1, fd, __str_ptr(img) + off, img.byte_len() - off)
        if w <= 0 {
            eprint("khc: cannot write the program image")
            return 1
        }
        off += w
    }
    let argv = __alloc(16)
    store64(argv, __cstr(name))
    let envp = __argv + (__argc + 1) * 8
    // execveat(fd, "", argv, envp, AT_EMPTY_PATH)
    syscall(322, fd, __cstr(""), argv, envp, 0x1000)
    eprint("khc: cannot run the program")
    return 1
}

// Сгенерированный исходный текст дописывается к программе.
fn add_generated(text: str) {
    files.push(SrcFile { path: "<generated>", text: text, is_lib: true })
    toks.pop()
    let start = toks.len()
    lex_file(files.len() - 1)
    add_tok_text(T_EOF, 0, "", lx_p)
    prescan_from(1, start)
    prescan_from(2, start)
}

// Размер кода каждой скомпилированной функции (ключ --sizes).
fn print_sizes() {
    var starts: [int] = []
    for f in funcs {
        if f.code >= 0 {
            starts.push(f.code)
        }
    }
    var total = 0
    for f in funcs {
        if f.code >= 0 {
            var end = code_len
            for x in starts {
                if x > f.code && x < end {
                    end = x
                }
            }
            // размер, имя и адрес (для профилировщика: valgrind, perf)
            print((end - f.code).to_str() + " " + f.name + " @" + (CODE_BASE + HDR_SIZE + f.code).to_str())
            total += end - f.code
        }
    }
    print(total.to_str() + " code total, " + data_len.to_str() + " data")
}

// После sql_finish: данные программы больше не растут.
fn resolve_fixups() {
    for fx in fixups {
        if fx.func == FIX_DATA_END {
            put64_at(code + fx.at, DATA_BASE + data_len)
            continue
        }
        let target = funcs[fx.func].code
        if target < 0 {
            report_at(0, 1, 1, "internal: function '" + funcs[fx.func].name + "' was not compiled", "")
        } else {
            patch_rel(fx.at, target)
        }
    }
}

fn usage() -> int {
    eprint("usage: khc -o <output> <file.kh>...")
    eprint("       khc run <file.kh>...     build and run")
    eprint("       khc test <file.kh>...    build and run the test blocks")
    eprint("       khc check <file.kh>...   only check")
    eprint("options: --json     report errors as JSON")
    eprint("         --test     build a runner for test blocks")
    eprint("         --system   system code: str only through the byte API")
    eprint("         --all-lib  check every library function, not only the called ones")
    return 2
}

fn main() -> int {
    let argv = args()
    var out = ""
    var inputs: [str] = []
    var test_mode = false
    var check_only = false
    var run = false
    var sizes = false
    var locks = false
    var all_lib = false
    var i = 1
    while i < argv.len() {
        let a = argv[i]
        if a == "-o" && i + 1 < argv.len() {
            out = argv[i + 1]
            i += 2
            continue
        }
        if a == "--json" {
            json_errors = true
        } else if a == "--test" {
            test_mode = true
        } else if a == "check" {
            check_only = true
        } else if a == "run" && inputs.len() == 0 {
            run = true
        } else if a == "test" && inputs.len() == 0 {
            run = true
            test_mode = true
        } else if a == "--sizes" {
            sizes = true
        } else if a == "--locks" {
            locks = true
        } else if a == "--system" {
            system_mode = true
        } else if a == "--all-lib" {
            all_lib = true
        } else if a == "--version" {
            print("khc " + version())
            return 0
        } else {
            inputs.push(a)
        }
        i += 1
    }
    if inputs.len() == 0 || (out.byte_len() == 0 && !check_only && !run) {
        return usage()
    }
    types_init()
    emit_init()
    sym_map = smap_new()
    let lib = find_lib()
    for name in lib_files() {
        if !load_file(lib + "/" + name, true) {
            eprint("khc: the standard library was not found; set KHRIP_LIB to the lib directory")
            return 2
        }
    }
    for path in inputs {
        if !load_file(path, false) {
            return 2
        }
    }
    var fi = 0
    while fi < files.len() {
        lex_file(fi)
        fi += 1
    }
    uses_db = scan_uses_db()
    load_migration_files(inputs[0])
    // библиотека API — только программам с route, test, store, JSON или базой;
    // библиотеки драйверов — только тем, кто пользуется их именами
    let base_api = test_mode || uses_api() || uses_db
    let drivers = driver_libs(lib, base_api, all_lib)
    if drv_clash.keys.len() > 0 {
        // библиотека драйвера разбиралась бы с чужими типами: только эти ошибки
        print_diags()
        return 1
    }
    if base_api || drivers.len() > 0 {
        api_libs = true
        var names = api_lib_files()
        for d in drivers {
            names.push(d)
        }
        for name in names {
            if !load_file(lib + "/" + name, true) {
                return 2
            }
            lex_file(files.len() - 1)
        }
    }
    // куча store (lib/gc.kh) — только программам со store и тестам; остальным —
    // её заглушки (lib/nostore.kh): ядро ссылается на кучу, но без store в неё
    // не попадает
    var heap_lib = "nostore.kh"
    if test_mode || uses_store() {
        heap_lib = "gc.kh"
    }
    if !load_file(lib + "/" + heap_lib, true) {
        return 2
    }
    lex_file(files.len() - 1)
    lx_file = files.len() - 1
    add_tok_text(T_EOF, 0, "", lx_p)
    let init_fn = gen_func("__init_globals", ty_void)
    let main_fn = gen_func("__main", ty_int)
    let stores_fn = gen_func("__init_stores", ty_void)
    prescan(1)
    prescan(2)
    sort_migrations()
    api_mode = routes.len() > 0 || tests.len() > 0 || everies.len() > 0 || test_mode
    check_api()
    if locks {
        // как маршруты берут блокировку store: read — параллельно с другими
        for r in routes {
            var mode = "write"
            if route_reads_only(r) {
                mode = "read"
            }
            print(r.method + " " + r.path + ": " + mode)
        }
    }
    if api_libs {
        add_generated(gen_api_source())
    }
    // точка входа: mov rdi, rsp; call __entry; ud2
    emit8(0x48)
    emit8(0x89)
    emit8(0xE7)
    emit_call(rt_func("__entry"))
    emit8(0x0F)
    emit8(0x0B)
    // Функции программы компилируются все (ради ошибок), функции библиотеки —
    // только вызванные: очередь work пополняет emit_call. С --all-lib — все.
    var f = 0
    while f < funcs.len() {
        if funcs[f].body >= 0 && (!funcs[f].is_lib || all_lib) && !funcs[f].used {
            funcs[f].used = true
            compile_fn(f)
        }
        f += 1
    }
    if api_libs {
        compile_init_globals(init_fn, stores_fn)
    } else {
        compile_init_globals(init_fn, -1)
    }
    compile_main_wrapper(main_fn, test_mode)
    var w = 0
    while w < work.len() {
        let fi = work[w]
        if funcs[fi].body >= 0 && funcs[fi].code < 0 {
            compile_fn(fi)
        }
        w += 1
    }
    sql_finish()
    resolve_fixups()
    if diags.len() > 0 {
        print_diags()
        return 1
    }
    if check_only {
        return 0
    }
    if sizes {
        print_sizes()
    }
    if run {
        return run_image(elf_image(), inputs[0])
    }
    if !write_file(out, elf_image(), true) {
        eprint("khc: cannot write " + out)
        return 1
    }
    return 0
}
