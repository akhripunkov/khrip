// ============================================================================
// SIMD-примитивы рантайма: поиск байта, конца заголовков HTTP («\r\n\r\n»)
// и символов, которые нужно экранировать в JSON. Каждый примитив — три пути:
// AVX2 (32 байта за шаг), SSE2 (16 байт, есть на любом x86-64) и побайтный;
// путь выбирается по __simd_level (2, 1, 0), который рантайм выставляет
// при старте по cpuid (lib/rt.kh, __simd_init).
// Аргументы: rdi — адрес, rsi — длина, rdx — байт; результат в rax — индекс
// первого совпадения или длина, если совпадений нет.
// ============================================================================

fn hex_val(c: int) -> int {
    if c >= '0' && c <= '9' {
        return c - '0'
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10
    }
    return c - 'a' + 10
}

// Байты машинного кода из строки «C5 FD 74 C1».
fn emit_hex(s: str) {
    var i = 0
    while i + 1 < s.len() {
        if s[i] == ' ' {
            i += 1
            continue
        }
        emit8(hex_val(s[i]) * 16 + hex_val(s[i + 1]))
        i += 2
    }
}

fn simd_level_addr() -> int {
    let s = sym_find("__simd_level")
    if s < 0 || sym_kind(s) != SK_GLOBAL {
        error_tok(tok(), "internal: missing __simd_level", "")
        return 0
    }
    return globals[sym_idx(s)].addr
}

// cmp byte [__simd_level], v
fn emit_level_cmp(v: int) {
    emit_hex("80 3C 25")
    emit32(simd_level_addr())
    emit8(v)
}

// Общая часть: выбор пути. → [переход на SSE2, переход на побайтный путь].
fn simd_dispatch() -> [int] {
    var holes: [int] = []
    // xor eax, eax
    emit_hex("31 C0")
    emit_level_cmp(1)
    let to_scalar = emit_jcc(CC_B)
    emit_level_cmp(2)
    let to_sse = emit_jcc(CC_B)
    holes.push(to_sse)
    holes.push(to_scalar)
    return holes
}

// Цикл по блокам: «lea rcx, [rax + need]; cmp rcx, rsi; ja выход».
fn simd_block_check(need: int) -> int {
    emit_hex("48 8D 48")
    emit8(need)
    emit_hex("48 39 F1")
    return emit_jcc(CC_A)
}

// Найден блок с маской в ecx: rax += bsf(ecx).
fn simd_found() -> int {
    // bsf ecx, ecx; add rax, rcx
    emit_hex("0F BC C9 48 01 C8")
    return emit_jmp()
}

// Байт рядом в xmmN для SSE2: mov ecx, b; movd; punpcklbw; punpcklwd; pshufd.
fn sse_broadcast(reg: int, b: int) {
    emit8(0xB9)
    emit32(b)
    let r = reg & 7
    emit_hex("66 0F 6E")
    emit8(0xC1 | (r << 3))
    emit_hex("66 0F 60")
    emit8(0xC0 | (r << 3) | r)
    emit_hex("66 0F 61")
    emit8(0xC0 | (r << 3) | r)
    emit_hex("66 0F 70")
    emit8(0xC0 | (r << 3) | r)
    emit8(0)
}

// То же для AVX2: mov ecx, b; vmovd xmmN, ecx; vpbroadcastb ymmN, xmmN.
fn avx_broadcast(reg: int, b: int) {
    emit8(0xB9)
    emit32(b)
    let r = reg & 7
    emit_hex("C5 F9 6E")
    emit8(0xC1 | (r << 3))
    emit_hex("C4 E2 7D 78")
    emit8(0xC0 | (r << 3) | r)
}

// __simd_find_byte(адрес, длина, байт)
fn emit_simd_find_byte() {
    let d = simd_dispatch()
    var found: [int] = []
    var done: [int] = []
    // AVX2: байт из edx: vmovd xmm1, edx; vpbroadcastb ymm1, xmm1
    emit_hex("C5 F9 6E CA C4 E2 7D 78 C9")
    let avx_top = here()
    let avx_end = simd_block_check(32)
    // vmovdqu ymm0, [rdi+rax]; vpcmpeqb ymm0, ymm0, ymm1; vpmovmskb ecx, ymm0
    emit_hex("C5 FE 6F 04 07 C5 FD 74 C1 C5 FD D7 C8")
    emit_hex("85 C9")
    let avx_hit = emit_jcc(CC_NE)
    emit_hex("48 83 C0 20")
    emit_jmp_to(avx_top)
    patch_here(avx_hit)
    emit_hex("C5 F8 77")
    found.push(emit_jmp())
    patch_here(avx_end)
    emit_hex("C5 F8 77")
    // SSE2
    patch_here(d[0])
    emit_hex("66 0F 6E CA 66 0F 60 C9 66 0F 61 C9 66 0F 70 C9 00")
    let sse_top = here()
    let sse_end = simd_block_check(16)
    // movdqu xmm0, [rdi+rax]; pcmpeqb xmm0, xmm1; pmovmskb ecx, xmm0
    emit_hex("F3 0F 6F 04 07 66 0F 74 C1 66 0F D7 C8")
    emit_hex("85 C9")
    found.push(emit_jcc(CC_NE))
    emit_hex("48 83 C0 10")
    emit_jmp_to(sse_top)
    let found_at = here()
    for h in found {
        patch_rel(h, found_at)
    }
    done.push(simd_found())
    // побайтно
    patch_here(sse_end)
    patch_here(d[1])
    let sc_top = here()
    emit_hex("48 39 F0")
    done.push(emit_jcc(CC_AE))
    // cmp byte [rdi+rax], dl
    emit_hex("38 14 07")
    done.push(emit_jcc(CC_E))
    emit_hex("48 FF C0")
    emit_jmp_to(sc_top)
    let end = here()
    for h in done {
        patch_rel(h, end)
    }
}

// __simd_find_json(адрес, длина): первый '"', '\\' или байт < 0x20.
fn emit_simd_find_json() {
    let d = simd_dispatch()
    var found: [int] = []
    var done: [int] = []
    // AVX2: ymm1 = '"', ymm2 = '\\', ymm3 = 0x1F
    avx_broadcast(1, 0x22)
    avx_broadcast(2, 0x5C)
    avx_broadcast(3, 0x1F)
    let avx_top = here()
    let avx_end = simd_block_check(32)
    // ymm0 = блок; ymm6 = (min(v, 0x1F) == v); ymm5 = (v == '"') | ymm6 | (v == '\\')
    emit_hex("C5 FE 6F 04 07")
    emit_hex("C5 FD DA F3 C5 CD 74 F0")
    emit_hex("C5 FD 74 E9 C5 D5 EB EE")
    emit_hex("C5 FD 74 F2 C5 D5 EB EE")
    emit_hex("C5 FD D7 CD 85 C9")
    let avx_hit = emit_jcc(CC_NE)
    emit_hex("48 83 C0 20")
    emit_jmp_to(avx_top)
    patch_here(avx_hit)
    emit_hex("C5 F8 77")
    found.push(emit_jmp())
    patch_here(avx_end)
    emit_hex("C5 F8 77")
    // SSE2
    patch_here(d[0])
    sse_broadcast(1, 0x22)
    sse_broadcast(2, 0x5C)
    sse_broadcast(3, 0x1F)
    let sse_top = here()
    let sse_end = simd_block_check(16)
    emit_hex("F3 0F 6F 04 07")
    emit_hex("66 0F 6F F0 66 0F DA F3 66 0F 74 F0")
    emit_hex("66 0F 6F E8 66 0F 74 E9 66 0F EB EE")
    emit_hex("66 0F 6F F0 66 0F 74 F2 66 0F EB EE")
    emit_hex("66 0F D7 CD 85 C9")
    found.push(emit_jcc(CC_NE))
    emit_hex("48 83 C0 10")
    emit_jmp_to(sse_top)
    let found_at = here()
    for h in found {
        patch_rel(h, found_at)
    }
    done.push(simd_found())
    // побайтно
    patch_here(sse_end)
    patch_here(d[1])
    let sc_top = here()
    emit_hex("48 39 F0")
    done.push(emit_jcc(CC_AE))
    // movzx ecx, byte [rdi+rax]
    emit_hex("0F B6 0C 07")
    emit_hex("83 F9 22")
    done.push(emit_jcc(CC_E))
    emit_hex("83 F9 5C")
    done.push(emit_jcc(CC_E))
    emit_hex("83 F9 20")
    done.push(emit_jcc(CC_B))
    emit_hex("48 FF C0")
    emit_jmp_to(sc_top)
    let end = here()
    for h in done {
        patch_rel(h, end)
    }
}

// __simd_find_crlf2(адрес, длина): начало «\r\n\r\n» или длина.
fn emit_simd_find_crlf2() {
    let d = simd_dispatch()
    var found: [int] = []
    var done: [int] = []
    // AVX2: ymm1 = '\r', ymm2 = '\n'; совпадение в i — '\r' в i, '\n' в i+1, ...
    avx_broadcast(1, 13)
    avx_broadcast(2, 10)
    let avx_top = here()
    let avx_end = simd_block_check(35)
    emit_hex("C5 F5 74 04 07")
    emit_hex("C5 ED 74 6C 07 01 C5 FD DB C5")
    emit_hex("C5 F5 74 6C 07 02 C5 FD DB C5")
    emit_hex("C5 ED 74 6C 07 03 C5 FD DB C5")
    emit_hex("C5 FD D7 C8 85 C9")
    let avx_hit = emit_jcc(CC_NE)
    emit_hex("48 83 C0 20")
    emit_jmp_to(avx_top)
    patch_here(avx_hit)
    emit_hex("C5 F8 77")
    found.push(emit_jmp())
    patch_here(avx_end)
    emit_hex("C5 F8 77")
    // SSE2
    patch_here(d[0])
    sse_broadcast(1, 13)
    sse_broadcast(2, 10)
    let sse_top = here()
    let sse_end = simd_block_check(19)
    emit_hex("F3 0F 6F 04 07 66 0F 74 C1")
    emit_hex("F3 0F 6F 6C 07 01 66 0F 74 EA 66 0F DB C5")
    emit_hex("F3 0F 6F 6C 07 02 66 0F 74 E9 66 0F DB C5")
    emit_hex("F3 0F 6F 6C 07 03 66 0F 74 EA 66 0F DB C5")
    emit_hex("66 0F D7 C8 85 C9")
    found.push(emit_jcc(CC_NE))
    emit_hex("48 83 C0 10")
    emit_jmp_to(sse_top)
    let found_at = here()
    for h in found {
        patch_rel(h, found_at)
    }
    done.push(simd_found())
    // побайтно: cmp dword [rdi+rax], 0x0A0D0A0D
    patch_here(sse_end)
    patch_here(d[1])
    let sc_top = here()
    emit_hex("48 8D 48 04 48 39 F1")
    let miss = emit_jcc(CC_A)
    emit_hex("81 3C 07 0D 0A 0D 0A")
    done.push(emit_jcc(CC_E))
    emit_hex("48 FF C0")
    emit_jmp_to(sc_top)
    patch_here(miss)
    // mov rax, rsi
    emit_hex("48 89 F0")
    let end = here()
    for h in done {
        patch_rel(h, end)
    }
}

// __cpu_avx2(): есть ли AVX2 и включено ли сохранение ymm операционной системой.
fn emit_cpu_avx2() {
    var no: [int] = []
    // push rbx; mov eax, 1; xor ecx, ecx; cpuid
    emit_hex("53 B8 01 00 00 00 31 C9 0F A2")
    // OSXSAVE и AVX: ecx биты 27, 28
    emit_hex("81 E1 00 00 00 18 81 F9 00 00 00 18")
    no.push(emit_jcc(CC_NE))
    // xgetbv: XMM и YMM сохраняются
    emit_hex("31 C9 0F 01 D0 83 E0 06 83 F8 06")
    no.push(emit_jcc(CC_NE))
    // mov eax, 7; xor ecx, ecx; cpuid; test ebx, 1 << 5
    emit_hex("B8 07 00 00 00 31 C9 0F A2 F7 C3 20 00 00 00")
    emit_setcc(CC_NE)
    let done = emit_jmp()
    let no_at = here()
    for h in no {
        patch_rel(h, no_at)
    }
    emit_hex("31 C0")
    patch_here(done)
    // pop rbx
    emit8(0x5B)
}

// ---- SHA-256 на инструкциях SHA-NI ----

// __cpu_sha(): есть ли SHA-NI (cpuid 7: ebx бит 29) и SSSE3 + SSE4.1 (cpuid 1:
// ecx биты 9 и 19), нужные для перестановок состояния.
fn emit_cpu_sha() {
    // push rbx; mov eax, 1; xor ecx, ecx; cpuid
    emit_hex("53 B8 01 00 00 00 31 C9 0F A2")
    // and ecx, (1 << 19) | (1 << 9); cmp ecx, то же
    emit_hex("81 E1 00 02 08 00 81 F9 00 02 08 00")
    let no = emit_jcc(CC_NE)
    // mov eax, 7; xor ecx, ecx; cpuid; test ebx, 1 << 29
    emit_hex("B8 07 00 00 00 31 C9 0F A2 F7 C3 00 00 00 20")
    emit_setcc(CC_NE)
    let done = emit_jmp()
    patch_here(no)
    emit_hex("31 C0")
    patch_here(done)
    emit8(0x5B)
}

// Инструкция над xmm-регистрами 0–7: префикс и код, затем ModRM «регистр-регистр».
fn sse_rr(op: str, dst: int, src: int) {
    emit_hex(op)
    emit8(0xC0 + dst * 8 + src)
}

// То же с непосредственным байтом.
fn sse_rri(op: str, dst: int, src: int, imm: int) {
    sse_rr(op, dst, src)
    emit8(imm)
}

// movdqu xmm, [base + disp] — base: 2 (rdx), 6 (rsi), 7 (rdi).
fn sse_load(dst: int, base: int, disp: int) {
    emit_hex("F3 0F 6F")
    emit8(0x80 + dst * 8 + base)
    emit32(disp)
}

fn sse_store(base: int, disp: int, src: int) {
    emit_hex("F3 0F 7F")
    emit8(0x80 + src * 8 + base)
    emit32(disp)
}

// __simd_sha256(state, block, k): один 64-байтовый блок. rdi — состояние (8 слов
// по 32 бита, a — первым), rsi — блок, rdx — 64 константы K по 32 бита и за ними
// маска pshufb для перестановки байтов слова. Схема — как у Intel и в ядре Linux
// (arch/x86/crypto/sha256_ni_asm.S): xmm1 = ABEF, xmm2 = CDGH, xmm0 — слова
// сообщения плюс K, xmm3–xmm6 — расписание сообщения, xmm7 — маска, потом
// временный. Исходное состояние на время раундов — в стеке.
fn emit_sha256_ni() {
    let movdqa = "66 0F 6F"
    let pshufd = "66 0F 70"
    let palignr = "66 0F 3A 0F"
    let pblendw = "66 0F 3A 0E"
    let pshufb = "66 0F 38 00"
    let paddd = "66 0F FE"
    let punpckhqdq = "66 0F 6D"
    let rnds2 = "0F 38 CB"
    let msg1 = "0F 38 CC"
    let msg2 = "0F 38 CD"
    // состояние: DCBA, HGFE → ABEF, CDGH
    sse_load(1, 7, 0)
    sse_load(2, 7, 16)
    sse_rri(pshufd, 1, 1, 0xB1)
    sse_rri(pshufd, 2, 2, 0x1B)
    sse_rr(movdqa, 7, 1)
    sse_rri(palignr, 1, 2, 8)
    sse_rri(pblendw, 2, 7, 0xF0)
    // sub rsp, 32; movdqu [rsp], xmm1; movdqu [rsp + 16], xmm2
    emit_hex("48 83 EC 20 F3 0F 7F 0C 24 F3 0F 7F 54 24 10")
    sse_load(7, 2, 256)
    var i = 0
    while i < 64 {
        // m0..m3 — xmm3..xmm6 по кругу
        let m0 = 3 + (i / 4) % 4
        let m1 = 3 + (i / 4 + 1) % 4
        let m3 = 3 + (i / 4 + 3) % 4
        if i < 16 {
            sse_load(m0, 6, i * 4)
            sse_rr(pshufb, m0, 7)
        }
        sse_load(0, 2, i * 4)
        sse_rr(paddd, 0, m0)
        sse_rr(rnds2, 2, 1)
        if i >= 12 && i < 60 {
            sse_rr(movdqa, 7, m0)
            sse_rri(palignr, 7, m3, 4)
            sse_rr(paddd, m1, 7)
            sse_rr(msg2, m1, m0)
        }
        sse_rr(punpckhqdq, 0, 0)
        sse_rr(rnds2, 1, 2)
        if i >= 4 && i < 52 {
            sse_rr(msg1, m3, m0)
        }
        i += 4
    }
    // прибавить исходное состояние: movdqu xmm0, [rsp]; movdqu xmm7, [rsp + 16]
    emit_hex("F3 0F 6F 04 24 F3 0F 6F 7C 24 10 48 83 C4 20")
    sse_rr(paddd, 1, 0)
    sse_rr(paddd, 2, 7)
    // ABEF, CDGH → DCBA, HGFE
    sse_rri(pshufd, 1, 1, 0x1B)
    sse_rri(pshufd, 2, 2, 0xB1)
    sse_rr(movdqa, 7, 1)
    sse_rri(pblendw, 1, 2, 0xF0)
    sse_rri(palignr, 2, 7, 8)
    sse_store(7, 0, 1)
    sse_store(7, 16, 2)
}

// ---- SHA-256 без SHA-NI: свой машинный код ----
// 32-битные операции «r/m, r»: 0x89 mov, 0x01 add, 0x31 xor, 0x21 and, 0x09 or.

fn x_rr(op: int, dst: int, src: int) {
    let rex = ((src >> 3) << 2) | (dst >> 3)
    if rex != 0 {
        emit8(0x40 | rex)
    }
    emit8(op)
    emit8(0xC0 | ((src & 7) << 3) | (dst & 7))
}

// ror/shr r32, n (ext: 1 — ror, 5 — shr)
fn x_shift(ext: int, reg: int, n: int) {
    if reg >= 8 {
        emit8(0x41)
    }
    emit8(0xC1)
    emit8(0xC0 | (ext << 3) | (reg & 7))
    emit8(n)
}

// op reg, [rsp + disp] (op: 0x8B mov в регистр, 0x03 add) или 0x89 — в память.
fn x_rsp(op: int, reg: int, disp: int) {
    if reg >= 8 {
        emit8(0x44)
    }
    emit8(op)
    if disp < 128 {
        emit8(0x44 | ((reg & 7) << 3))
        emit8(0x24)
        emit8(disp)
    } else {
        emit8(0x84 | ((reg & 7) << 3))
        emit8(0x24)
        emit32(disp)
    }
}

// add reg, [base + rsi + disp8] (sib: 0x34 — rsp, 0x32 — rdx)
fn x_add_idx(reg: int, sib: int, disp: int) {
    if reg >= 8 {
        emit8(0x44)
    }
    emit8(0x03)
    emit8(0x44 | ((reg & 7) << 3))
    emit8(sib)
    emit8(disp)
}

// Один 64-байтовый блок: rdi — состояние (8 слов по 32 бита), rsi — блок,
// rdx — константы K. Состояние a..h — в r8d..r15d, расписание W[64] — на стеке;
// раунды развёрнуты по 8: роли регистров сдвигаются, а не переписываются.
fn emit_sha256_x64() {
    let eax = 0
    let ecx = 1
    let ebx = 3
    let ebp = 5
    // push rbx, rbp, r12–r15, rdi; sub rsp, 256
    emit_hex("53 55 41 54 41 55 41 56 41 57 57 48 81 EC 00 01 00 00")
    for i in 0..16 {
        // mov eax, [rsi + 4i]; bswap eax; mov [rsp + 4i], eax
        emit8(0x8B)
        emit8(0x46)
        emit8(i * 4)
        emit_hex("0F C8")
        x_rsp(0x89, eax, i * 4)
    }
    for i in 16..64 {
        // s0 = ror(x, 7) ^ ror(x, 18) ^ (x >> 3), x = W[i - 15]
        x_rsp(0x8B, eax, (i - 15) * 4)
        x_rr(0x89, ecx, eax)
        x_rr(0x89, ebx, eax)
        x_shift(1, eax, 7)
        x_shift(1, ecx, 18)
        x_rr(0x31, eax, ecx)
        x_shift(5, ebx, 3)
        x_rr(0x31, eax, ebx)
        // s1 = ror(y, 17) ^ ror(y, 19) ^ (y >> 10), y = W[i - 2]
        x_rsp(0x8B, ecx, (i - 2) * 4)
        x_rr(0x89, ebx, ecx)
        x_rr(0x89, ebp, ecx)
        x_shift(1, ecx, 17)
        x_shift(1, ebx, 19)
        x_rr(0x31, ecx, ebx)
        x_shift(5, ebp, 10)
        x_rr(0x31, ecx, ebp)
        x_rr(0x01, eax, ecx)
        x_rsp(0x03, eax, (i - 16) * 4)
        x_rsp(0x03, eax, (i - 7) * 4)
        x_rsp(0x89, eax, i * 4)
    }
    // mov r8d..r15d, [rdi + 4r]
    for r in 0..8 {
        emit8(0x44)
        emit8(0x8B)
        emit8(0x47 | (r << 3))
        emit8(r * 4)
    }
    // xor esi, esi: смещение раунда в W и K
    emit_hex("31 F6")
    let top = code_len
    for j in 0..8 {
        let a = 8 + (8 - j) % 8
        let b = 8 + (9 - j) % 8
        let c = 8 + (10 - j) % 8
        let d = 8 + (11 - j) % 8
        let e = 8 + (12 - j) % 8
        let f = 8 + (13 - j) % 8
        let g = 8 + (14 - j) % 8
        let h = 8 + (15 - j) % 8
        // h += S1(e) + ch(e, f, g) + K[i] + W[i]
        x_rr(0x89, eax, e)
        x_rr(0x89, ecx, e)
        x_shift(1, eax, 6)
        x_shift(1, ecx, 11)
        x_rr(0x31, eax, ecx)
        x_shift(1, ecx, 14)
        x_rr(0x31, eax, ecx)
        x_rr(0x89, ecx, f)
        x_rr(0x31, ecx, g)
        x_rr(0x21, ecx, e)
        x_rr(0x31, ecx, g)
        x_rr(0x01, h, eax)
        x_rr(0x01, h, ecx)
        x_add_idx(h, 0x32, j * 4)
        x_add_idx(h, 0x34, j * 4)
        x_rr(0x01, d, h)
        // h += S0(a) + maj(a, b, c)
        x_rr(0x89, eax, a)
        x_rr(0x89, ecx, a)
        x_shift(1, eax, 2)
        x_shift(1, ecx, 13)
        x_rr(0x31, eax, ecx)
        x_shift(1, ecx, 9)
        x_rr(0x31, eax, ecx)
        x_rr(0x89, ecx, a)
        x_rr(0x09, ecx, b)
        x_rr(0x21, ecx, c)
        x_rr(0x89, ebx, a)
        x_rr(0x21, ebx, b)
        x_rr(0x09, ecx, ebx)
        x_rr(0x01, h, eax)
        x_rr(0x01, h, ecx)
    }
    // add rsi, 32; cmp rsi, 256; jne top
    emit_hex("48 83 C6 20 48 81 FE 00 01 00 00")
    emit_jcc_to(CC_NE, top)
    // mov rdi, [rsp + 256]; add [rdi + 4r], r8d..r15d
    emit_hex("48 8B BC 24 00 01 00 00")
    for r in 0..8 {
        emit8(0x44)
        emit8(0x01)
        emit8(0x47 | (r << 3))
        emit8(r * 4)
    }
    // add rsp, 264; pop r15–r12, rbp, rbx
    emit_hex("48 81 C4 08 01 00 00 41 5F 41 5E 41 5D 41 5C 5D 5B")
}

// ---- SHA-512 (и SHA-384): тот же приём на 64-битных регистрах ----

// 64-битная операция «r/m, r» (0x89 mov, 0x01 add, 0x31 xor, 0x21 and, 0x09 or).
fn q_rr(op: int, dst: int, src: int) {
    emit8(0x48 | ((src >> 3) << 2) | (dst >> 3))
    emit8(op)
    emit8(0xC0 | ((src & 7) << 3) | (dst & 7))
}

// ror/shr r64, n (ext: 1 — ror, 5 — shr)
fn q_shift(ext: int, reg: int, n: int) {
    emit8(0x48 | (reg >> 3))
    emit8(0xC1)
    emit8(0xC0 | (ext << 3) | (reg & 7))
    emit8(n)
}

// op reg, [rsp + disp] (0x8B — в регистр, 0x03 — add) или 0x89 — в память.
fn q_rsp(op: int, reg: int, disp: int) {
    emit8(0x48 | ((reg >> 3) << 2))
    emit8(op)
    if disp < 128 {
        emit8(0x44 | ((reg & 7) << 3))
        emit8(0x24)
        emit8(disp)
    } else {
        emit8(0x84 | ((reg & 7) << 3))
        emit8(0x24)
        emit32(disp)
    }
}

// add reg, [base + rsi + disp8] (sib: 0x34 — rsp, 0x32 — rdx)
fn q_add_idx(reg: int, sib: int, disp: int) {
    emit8(0x48 | ((reg >> 3) << 2))
    emit8(0x03)
    emit8(0x44 | ((reg & 7) << 3))
    emit8(sib)
    emit8(disp)
}

// Один 128-байтовый блок: rdi — состояние (8 слов по 64 бита), rsi — блок,
// rdx — константы K (80 слов). a..h — в r8..r15, W[80] — на стеке.
fn emit_sha512_x64() {
    let rax = 0
    let rcx = 1
    let rbx = 3
    let rbp = 5
    // push rbx, rbp, r12–r15, rdi; sub rsp, 640
    emit_hex("53 55 41 54 41 55 41 56 41 57 57 48 81 EC 80 02 00 00")
    for i in 0..16 {
        // mov rax, [rsi + 8i]; bswap rax; mov [rsp + 8i], rax
        emit_hex("48 8B 46")
        emit8(i * 8)
        emit_hex("48 0F C8")
        q_rsp(0x89, rax, i * 8)
    }
    for i in 16..80 {
        // s0 = ror(x, 1) ^ ror(x, 8) ^ (x >> 7), x = W[i - 15]
        q_rsp(0x8B, rax, (i - 15) * 8)
        q_rr(0x89, rcx, rax)
        q_rr(0x89, rbx, rax)
        q_shift(1, rax, 1)
        q_shift(1, rcx, 8)
        q_rr(0x31, rax, rcx)
        q_shift(5, rbx, 7)
        q_rr(0x31, rax, rbx)
        // s1 = ror(y, 19) ^ ror(y, 61) ^ (y >> 6), y = W[i - 2]
        q_rsp(0x8B, rcx, (i - 2) * 8)
        q_rr(0x89, rbx, rcx)
        q_rr(0x89, rbp, rcx)
        q_shift(1, rcx, 19)
        q_shift(1, rbx, 61)
        q_rr(0x31, rcx, rbx)
        q_shift(5, rbp, 6)
        q_rr(0x31, rcx, rbp)
        q_rr(0x01, rax, rcx)
        q_rsp(0x03, rax, (i - 16) * 8)
        q_rsp(0x03, rax, (i - 7) * 8)
        q_rsp(0x89, rax, i * 8)
    }
    // mov r8..r15, [rdi + 8r]
    for r in 0..8 {
        emit8(0x4C)
        emit8(0x8B)
        emit8(0x47 | (r << 3))
        emit8(r * 8)
    }
    // xor esi, esi: смещение раунда в W и K
    emit_hex("31 F6")
    let top = code_len
    for j in 0..8 {
        let a = 8 + (8 - j) % 8
        let b = 8 + (9 - j) % 8
        let c = 8 + (10 - j) % 8
        let d = 8 + (11 - j) % 8
        let e = 8 + (12 - j) % 8
        let f = 8 + (13 - j) % 8
        let g = 8 + (14 - j) % 8
        let h = 8 + (15 - j) % 8
        // h += S1(e) + ch(e, f, g) + K[i] + W[i]
        q_rr(0x89, rax, e)
        q_rr(0x89, rcx, e)
        q_shift(1, rax, 14)
        q_shift(1, rcx, 18)
        q_rr(0x31, rax, rcx)
        q_shift(1, rcx, 23)
        q_rr(0x31, rax, rcx)
        q_rr(0x89, rcx, f)
        q_rr(0x31, rcx, g)
        q_rr(0x21, rcx, e)
        q_rr(0x31, rcx, g)
        q_rr(0x01, h, rax)
        q_rr(0x01, h, rcx)
        q_add_idx(h, 0x32, j * 8)
        q_add_idx(h, 0x34, j * 8)
        q_rr(0x01, d, h)
        // h += S0(a) + maj(a, b, c)
        q_rr(0x89, rax, a)
        q_rr(0x89, rcx, a)
        q_shift(1, rax, 28)
        q_shift(1, rcx, 34)
        q_rr(0x31, rax, rcx)
        q_shift(1, rcx, 5)
        q_rr(0x31, rax, rcx)
        q_rr(0x89, rcx, a)
        q_rr(0x09, rcx, b)
        q_rr(0x21, rcx, c)
        q_rr(0x89, rbx, a)
        q_rr(0x21, rbx, b)
        q_rr(0x09, rcx, rbx)
        q_rr(0x01, h, rax)
        q_rr(0x01, h, rcx)
    }
    // add rsi, 64; cmp rsi, 640; jne top
    emit_hex("48 83 C6 40 48 81 FE 80 02 00 00")
    emit_jcc_to(CC_NE, top)
    // mov rdi, [rsp + 640]; add [rdi + 8r], r8..r15
    emit_hex("48 8B BC 24 80 02 00 00")
    for r in 0..8 {
        emit8(0x4C)
        emit8(0x01)
        emit8(0x47 | (r << 3))
        emit8(r * 8)
    }
    // add rsp, 648; pop r15–r12, rbp, rbx
    emit_hex("48 81 C4 88 02 00 00 41 5F 41 5E 41 5D 41 5C 5D 5B")
}

// ---- AES-NI, PCLMULQDQ и ChaCha20 для TLS ----

// __cpu_aes(): есть ли AES-NI, PCLMULQDQ и SSSE3 (cpuid 1: ecx биты 25, 1, 9).
fn emit_cpu_aes() {
    // push rbx; mov eax, 1; xor ecx, ecx; cpuid
    emit_hex("53 B8 01 00 00 00 31 C9 0F A2")
    // and ecx, маска; cmp ecx, маска; sete al; movzx eax, al; pop rbx
    emit_hex("81 E1 02 02 00 02 81 F9 02 02 00 02")
    emit_setcc(CC_E)
    emit8(0x5B)
}

// __aes_ctr(ключи, 16 × раундов, счётчик, откуда, куда, блоков): AES в режиме
// счётчика. rdi — ключи раундов подряд, rsi — смещение последнего, rdx —
// 16 байт счётчика (последние 4 — номер блока старшими байтами вперёд; растёт
// на месте), rcx — открытый текст, r8 — результат, r9 — число блоков.
fn emit_aes_ctr() {
    // test r9, r9; jz конец
    emit_hex("4D 85 C9")
    let skip = emit_jcc(CC_E)
    let top = code_len
    // movdqu xmm0, [rdx]; movdqu xmm1, [rdi]; pxor xmm0, xmm1; mov eax, 16
    emit_hex("F3 0F 6F 02 F3 0F 6F 0F 66 0F EF C1 B8 10 00 00 00")
    let inner = code_len
    // movdqu xmm1, [rdi + rax]; aesenc xmm0, xmm1; add eax, 16; cmp rax, rsi; jb inner
    emit_hex("F3 0F 6F 0C 07 66 0F 38 DC C1 83 C0 10 48 39 F0 72")
    emit8((inner - (code_len + 1)) & 255)
    // movdqu xmm1, [rdi + rsi]; aesenclast xmm0, xmm1
    emit_hex("F3 0F 6F 0C 37 66 0F 38 DD C1")
    // movdqu xmm1, [rcx]; pxor xmm0, xmm1; movdqu [r8], xmm0
    emit_hex("F3 0F 6F 09 66 0F EF C1 F3 41 0F 7F 00")
    // счётчик + 1: mov eax, [rdx + 12]; bswap eax; inc eax; bswap eax; mov [rdx + 12], eax
    emit_hex("8B 42 0C 0F C8 FF C0 0F C8 89 42 0C")
    // add rcx, 16; add r8, 16; dec r9; jnz top
    emit_hex("48 83 C1 10 49 83 C0 10 49 FF C9")
    emit_jcc_to(CC_NE, top)
    patch_here(skip)
}

// xmm0 = xmm0 · xmm5 в GF(2^128) для GHASH. Оба значения — с переставленными
// байтами (pshufb); схема — из статьи Intel «Carry-Less Multiplication
// Instruction and its Usage for Computing the GCM Mode» (функция gfmul).
// Временные: xmm1–xmm4, xmm7.
fn emit_gfmul() {
    let movdqa = "66 0F 6F"
    let pclmul = "66 0F 3A 44"
    let pxor = "66 0F EF"
    let por = "66 0F EB"
    let dq = "66 0F 73"
    let d = "66 0F 72"
    sse_rr(movdqa, 1, 0)
    sse_rri(pclmul, 1, 5, 0x00)
    sse_rr(movdqa, 2, 0)
    sse_rri(pclmul, 2, 5, 0x10)
    sse_rr(movdqa, 3, 0)
    sse_rri(pclmul, 3, 5, 0x01)
    sse_rr(movdqa, 4, 0)
    sse_rri(pclmul, 4, 5, 0x11)
    sse_rr(pxor, 2, 3)
    sse_rr(movdqa, 3, 2)
    sse_rri(dq, 7, 3, 8)
    sse_rri(dq, 3, 2, 8)
    sse_rr(pxor, 1, 3)
    sse_rr(pxor, 4, 2)
    // произведение [xmm4:xmm1] сдвинуть на бит влево
    sse_rr(movdqa, 7, 1)
    sse_rri(d, 2, 7, 31)
    sse_rr(movdqa, 2, 4)
    sse_rri(d, 2, 2, 31)
    sse_rri(d, 6, 1, 1)
    sse_rri(d, 6, 4, 1)
    sse_rr(movdqa, 3, 7)
    sse_rri(dq, 3, 3, 12)
    sse_rri(dq, 7, 2, 4)
    sse_rri(dq, 7, 7, 4)
    sse_rr(por, 1, 7)
    sse_rr(por, 4, 2)
    sse_rr(por, 4, 3)
    // приведение по модулю x^128 + x^7 + x^2 + x + 1
    sse_rr(movdqa, 7, 1)
    sse_rri(d, 6, 7, 31)
    sse_rr(movdqa, 2, 1)
    sse_rri(d, 6, 2, 30)
    sse_rr(movdqa, 3, 1)
    sse_rri(d, 6, 3, 25)
    sse_rr(pxor, 7, 2)
    sse_rr(pxor, 7, 3)
    sse_rr(movdqa, 2, 7)
    sse_rri(dq, 3, 2, 4)
    sse_rri(dq, 7, 7, 12)
    sse_rr(pxor, 1, 7)
    sse_rr(movdqa, 3, 1)
    sse_rri(d, 2, 3, 1)
    sse_rr(movdqa, 7, 1)
    sse_rri(d, 2, 7, 2)
    sse_rr(movdqa, 0, 1)
    sse_rri(d, 2, 0, 7)
    sse_rr(pxor, 3, 7)
    sse_rr(pxor, 3, 0)
    sse_rr(pxor, 3, 2)
    sse_rr(pxor, 1, 3)
    sse_rr(pxor, 4, 1)
    sse_rr(movdqa, 0, 4)
}

// __ghash(ключ, x, данные, блоков): x = (x ^ блок) · H по всем блокам. rdi —
// H с переставленными байтами и за ним маска pshufb, rsi — 16 байт x (на месте),
// rdx — данные, rcx — число блоков.
fn emit_ghash() {
    // test rcx, rcx; jz конец
    emit_hex("48 85 C9")
    let skip = emit_jcc(CC_E)
    // movdqu xmm6, [rdi + 16]; movdqu xmm5, [rdi]; movdqu xmm0, [rsi]; pshufb xmm0, xmm6
    emit_hex("F3 0F 6F 77 10 F3 0F 6F 2F F3 0F 6F 06 66 0F 38 00 C6")
    let top = code_len
    // movdqu xmm1, [rdx]; pshufb xmm1, xmm6; pxor xmm0, xmm1
    emit_hex("F3 0F 6F 0A 66 0F 38 00 CE 66 0F EF C1")
    emit_gfmul()
    // add rdx, 16; dec rcx; jnz top
    emit_hex("48 83 C2 10 48 FF C9")
    emit_jcc_to(CC_NE, top)
    // pshufb xmm0, xmm6; movdqu [rsi], xmm0
    emit_hex("66 0F 38 00 C6 F3 0F 7F 06")
    patch_here(skip)
}

// Поворот 32-битных слов xmm-регистра reg влево на n (xmm4 — временный).
fn sse_rotl(reg: int, n: int) {
    sse_rr("66 0F 6F", 4, reg)
    sse_rri("66 0F 72", 6, reg, n)
    sse_rri("66 0F 72", 2, 4, 32 - n)
    sse_rr("66 0F EB", reg, 4)
}

// Четверть раунда ChaCha20 сразу для четырёх столбцов (строки — xmm0–xmm3).
fn chacha_quarter() {
    let paddd = "66 0F FE"
    let pxor = "66 0F EF"
    sse_rr(paddd, 0, 1)
    sse_rr(pxor, 3, 0)
    sse_rotl(3, 16)
    sse_rr(paddd, 2, 3)
    sse_rr(pxor, 1, 2)
    sse_rotl(1, 12)
    sse_rr(paddd, 0, 1)
    sse_rr(pxor, 3, 0)
    sse_rotl(3, 8)
    sse_rr(paddd, 2, 3)
    sse_rr(pxor, 1, 2)
    sse_rotl(1, 7)
}

// __chacha_block(состояние, куда): 64 байта ключевого потока ChaCha20 по
// состоянию из 16 слов (rdi), в rsi. Строки состояния — в xmm0–xmm3; диагонали
// получаются сдвигом строк (pshufd), как в известных реализациях на SSE2.
fn emit_chacha_block() {
    let pshufd = "66 0F 70"
    emit_hex("F3 0F 6F 07 F3 0F 6F 4F 10 F3 0F 6F 57 20 F3 0F 6F 5F 30")
    // mov eax, 10
    emit_hex("B8 0A 00 00 00")
    let top = code_len
    chacha_quarter()
    sse_rri(pshufd, 1, 1, 0x39)
    sse_rri(pshufd, 2, 2, 0x4E)
    sse_rri(pshufd, 3, 3, 0x93)
    chacha_quarter()
    sse_rri(pshufd, 1, 1, 0x93)
    sse_rri(pshufd, 2, 2, 0x4E)
    sse_rri(pshufd, 3, 3, 0x39)
    // dec eax; jnz top
    emit_hex("FF C8")
    emit_jcc_to(CC_NE, top)
    // прибавить исходное состояние и записать: movdqu xmm4, [rdi + 16i]; paddd; movdqu [rsi + 16i]
    for i in 0..4 {
        emit_hex("F3 0F 6F 67")
        emit8(i * 16)
        sse_rr("66 0F FE", i, 4)
        emit_hex("F3 0F 7F")
        emit8(0x46 + i * 8)
        emit8(i * 16)
    }
}

// ---- Длинная арифметика: части по 64 бита, младшие первыми ----

// Короткий переход назад (jcc rel8) на метку target.
fn emit_jcc8_back(cc: int, target: int) {
    emit8(0x70 + cc)
    emit8((target - (code_len + 1)) & 255)
}

// __mp_add(r, a, b, n) / __mp_sub: r = a ± b по n частям, → перенос (заём).
// rdi — r, rsi — a, rdx — b, rcx — n (больше 0). op: 0x13 adc, 0x1B sbb.
fn emit_mp_addsub(op: int) {
    // xor r8d, r8d (заодно CF = 0)
    emit_hex("45 31 C0")
    let top = code_len
    // mov rax, [rsi + r8*8]; adc/sbb rax, [rdx + r8*8]; mov [rdi + r8*8], rax
    emit_hex("4A 8B 04 C6 4A")
    emit8(op)
    emit_hex("04 C2 4A 89 04 C7")
    // inc r8; dec rcx; jnz top (inc и dec не трогают CF)
    emit_hex("49 FF C0 48 FF C9")
    emit_jcc8_back(CC_NE, top)
    emit_setcc(CC_B)
}

// __mont_mul(r, a, b, m, n, minv): r = a · b · 2^(-64n) mod m с точностью до
// одного вычитания m (r — n + 1 частей, верхняя 0 или 1; дальше — в lib/pk.kh).
// Схема CIOS (Koç, Acar, Kaliski, 1996); minv = -m^(-1) mod 2^64. rdi — r,
// rsi — a, rdx — b (уходит в r10), rcx — m, r8 — n (не меньше 2), r9 — minv.
// Промежуточное t (n + 2 частей) — на стеке, r15 — его адрес.
fn emit_mont_mul() {
    // push rbx, rbp, r12–r15; mov r10, rdx
    emit_hex("53 55 41 54 41 55 41 56 41 57 49 89 D2")
    // rax = (8n + 31) & -16; sub rsp, rax; mov rbp, rax
    emit_hex("4A 8D 04 C5 1F 00 00 00 48 83 E0 F0 48 29 C4 48 89 C5")
    // t = 0: xor eax, eax; xor r11d, r11d; lea rbx, [r8 + 2]
    emit_hex("31 C0 45 31 DB 49 8D 58 02")
    let zero = code_len
    // mov [rsp + r11*8], rax; inc r11; cmp r11, rbx; jb zero
    emit_hex("4A 89 04 DC 49 FF C3 49 39 DB")
    emit_jcc8_back(CC_B, zero)
    // mov r15, rsp; xor r11d, r11d
    emit_hex("49 89 E7 45 31 DB")
    let outer = code_len
    // r13 = a[i]; r14 = 0 (перенос); r12 = 0 (j)
    emit_hex("4E 8B 2C DE 45 31 F6 45 31 E4")
    let inner1 = code_len
    // t[j] += b[j] · a[i] + перенос
    // mov rax, [r10 + r12*8]; mul r13; add rax, r14; adc rdx, 0
    emit_hex("4B 8B 04 E2 49 F7 E5 4C 01 F0 48 83 D2 00")
    // add rax, [r15 + r12*8]; adc rdx, 0; mov [r15 + r12*8], rax; mov r14, rdx
    emit_hex("4B 03 04 E7 48 83 D2 00 4B 89 04 E7 49 89 D6")
    // inc r12; cmp r12, r8; jb inner1
    emit_hex("49 FF C4 4D 39 C4")
    emit_jcc8_back(CC_B, inner1)
    // t[n] += перенос; t[n + 1] += CF
    emit_hex("4F 01 34 C7 4B 83 54 C7 08 00")
    // r13 = t[0] · minv (младшие 64 бита)
    emit_hex("4D 8B 2F 4D 0F AF E9")
    // t[0] + m[0] · r13: младшая часть обнуляется, остаётся перенос
    // mov rax, [rcx]; mul r13; add rax, [r15]; adc rdx, 0; mov r14, rdx; mov r12d, 1
    emit_hex("48 8B 01 49 F7 E5 49 03 07 48 83 D2 00 49 89 D6 41 BC 01 00 00 00")
    let inner2 = code_len
    // t[j - 1] = t[j] + m[j] · r13 + перенос
    // mov rax, [rcx + r12*8]; mul r13; add rax, r14; adc rdx, 0
    emit_hex("4A 8B 04 E1 49 F7 E5 4C 01 F0 48 83 D2 00")
    // add rax, [r15 + r12*8]; adc rdx, 0; mov [r15 + r12*8 - 8], rax; mov r14, rdx
    emit_hex("4B 03 04 E7 48 83 D2 00 4B 89 44 E7 F8 49 89 D6")
    // inc r12; cmp r12, r8; jb inner2
    emit_hex("49 FF C4 4D 39 C4")
    emit_jcc8_back(CC_B, inner2)
    // t[n - 1] = t[n] + перенос; t[n] = t[n + 1] + CF; t[n + 1] = 0
    emit_hex("4B 8B 04 C7 4C 01 F0 4B 89 44 C7 F8 4B 8B 44 C7 08 48 83 D0 00 4B 89 04 C7")
    emit_hex("4B C7 44 C7 08 00 00 00 00")
    // inc r11; cmp r11, r8; jb outer
    emit_hex("49 FF C3 4D 39 C3")
    emit_jcc_to(CC_B, outer)
    // r = t - m (по n частям): xor r11d, r11d; mov rbx, r8 (счётчик, dec не трогает CF)
    emit_hex("45 31 DB 4C 89 C3")
    let sub = code_len
    // mov rax, [r15 + r11*8]; sbb rax, [rcx + r11*8]; mov [rdi + r11*8], rax; inc r11; dec rbx; jnz sub
    emit_hex("4B 8B 04 DF 4A 1B 04 D9 4A 89 04 DF 49 FF C3 48 FF CB")
    emit_jcc8_back(CC_NE, sub)
    // оставить t, если был заём и t[n] = 0: маска rax = -(заём) & -(t[n] ^ 1)
    // sbb rax, rax; mov rdx, [r15 + r8*8]; xor rdx, 1; neg rdx; and rax, rdx
    emit_hex("48 19 C0 4B 8B 14 C7 48 83 F2 01 48 F7 DA 48 21 D0")
    // r[i] ^= (r[i] ^ t[i]) & маска: xor r11d, r11d
    emit_hex("45 31 DB")
    let sel = code_len
    // mov rdx, [rdi + r11*8]; mov rbx, [r15 + r11*8]; xor rbx, rdx; and rbx, rax; xor rdx, rbx; mov [rdi + r11*8], rdx
    emit_hex("4A 8B 14 DF 4B 8B 1C DF 48 31 D3 48 21 C3 48 31 DA 4A 89 14 DF")
    // inc r11; cmp r11, r8; jb sel
    emit_hex("49 FF C3 4D 39 C3")
    emit_jcc8_back(CC_B, sel)
    // add rsp, rbp; pop r15–r12, rbp, rbx
    emit_hex("48 01 EC 41 5F 41 5E 41 5D 41 5C 5D 5B")
}

// __mod_add(r, a, b, m, n): r = a + b mod m; __mod_sub: r = a - b mod m
// (a, b < m). rdi — r, rsi — a, rdx — b, rcx — m, r8 — n. Без временной памяти:
// сложение, вычитание m и обратное прибавление m под маской.
fn emit_mod_addsub(add: bool) {
    // xor r9d, r9d; mov r10, r8
    emit_hex("45 31 C9 4D 89 C2")
    let l1 = code_len
    // mov rax, [rsi + r9*8]; adc/sbb rax, [rdx + r9*8]; mov [rdi + r9*8], rax; inc r9; dec r10; jnz l1
    emit_hex("4A 8B 04 CE 4A")
    if add {
        emit8(0x13)
    } else {
        emit8(0x1B)
    }
    emit_hex("04 CA 4A 89 04 CF 49 FF C1 49 FF CA")
    emit_jcc8_back(CC_NE, l1)
    // r11 = -(перенос или заём)
    emit_hex("4D 19 DB")
    if add {
        // r -= m; маска = -(заём) & ~(-перенос): вернуть m, если вычитать было не нужно
        emit_hex("45 31 C9 4D 89 C2")
        let l2 = code_len
        // mov rax, [rdi + r9*8]; sbb rax, [rcx + r9*8]; mov [rdi + r9*8], rax; inc r9; dec r10; jnz l2
        emit_hex("4A 8B 04 CF 4A 1B 04 C9 4A 89 04 CF 49 FF C1 49 FF CA")
        emit_jcc8_back(CC_NE, l2)
        // sbb rax, rax; not r11; and r11, rax
        emit_hex("48 19 C0 49 F7 D3 49 21 C3")
    }
    // r += m & r11; перенос — в rdx: and сбрасывает CF, поэтому adc по цепочке нельзя.
    // xor edx, edx; xor r9d, r9d; mov r10, r8
    emit_hex("31 D2 45 31 C9 4D 89 C2")
    let l3 = code_len
    // mov rax, [rcx + r9*8]; and rax, r11; add rax, rdx; setc dl; movzx edx, dl
    emit_hex("4A 8B 04 C9 4C 21 D8 48 01 D0 0F 92 C2 0F B6 D2")
    // add [rdi + r9*8], rax; adc rdx, 0; inc r9; dec r10; jnz l3
    emit_hex("4A 01 04 CF 48 83 D2 00 49 FF C1 49 FF CA")
    emit_jcc8_back(CC_NE, l3)
}

