// ============================================================================
// SIMD-примитивы рантайма: поиск байта, конца заголовков HTTP («\r\n\r\n»)
// и символов, которые нужно экранировать в JSON. Каждый примитив — три пути:
// AVX2 (32 байта за шаг), SSE2 (16 байт, есть на любом x86-64) и побайтный;
// путь выбирается по __simd_level (2, 1, 0), который рантайм выставляет
// при старте по cpuid (lib/rt.kh, __simd_init).
// Аргументы: rdi — адрес, rsi — длина, rdx — байт; результат в rax — индекс
// первого совпадения или длина, если совпадений нет. Примитивы UTF-8 (ниже) —
// со своими результатами и двумя путями.
// ============================================================================

fn hex_val(c: int) -> int {
    if c >= '0' && c <= '9' {
        return c - '0'
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10
    }
    return c - 'a' + 10
}

// Байты машинного кода из строки «C5 FD 74 C1».
fn emit_hex(s: str) {
    var i = 0
    while i + 1 < s.byte_len() {
        if s.byte(i) == ' ' {
            i += 1
            continue
        }
        emit8(hex_val(s.byte(i)) * 16 + hex_val(s.byte(i + 1)))
        i += 2
    }
}

// То же — байты в сегмент данных.
fn data_hex(s: str) {
    var i = 0
    while i + 1 < s.byte_len() {
        if s.byte(i) == ' ' {
            i += 1
            continue
        }
        data_byte(hex_val(s.byte(i)) * 16 + hex_val(s.byte(i + 1)))
        i += 2
    }
}

fn simd_level_addr() -> int {
    let s = sym_find("__simd_level")
    if s < 0 || sym_kind(s) != SK_GLOBAL {
        error_tok(tok(), "internal: missing __simd_level", "")
        return 0
    }
    return globals[sym_idx(s)].addr
}

// cmp byte [__simd_level], v
fn emit_level_cmp(v: int) {
    emit_hex("80 3C 25")
    emit32(simd_level_addr())
    emit8(v)
}

// Общая часть: выбор пути. → [переход на SSE2, переход на побайтный путь].
fn simd_dispatch() -> [int] {
    var holes: [int] = []
    // xor eax, eax
    emit_hex("31 C0")
    emit_level_cmp(1)
    let to_scalar = emit_jcc(CC_B)
    emit_level_cmp(2)
    let to_sse = emit_jcc(CC_B)
    holes.push(to_sse)
    holes.push(to_scalar)
    return holes
}

// Цикл по блокам: «lea rcx, [rax + need]; cmp rcx, rsi; ja выход».
fn simd_block_check(need: int) -> int {
    emit_hex("48 8D 48")
    emit8(need)
    emit_hex("48 39 F1")
    return emit_jcc(CC_A)
}

// Найден блок с маской в ecx: rax += bsf(ecx).
fn simd_found() -> int {
    // bsf ecx, ecx; add rax, rcx
    emit_hex("0F BC C9 48 01 C8")
    return emit_jmp()
}

// Байт рядом в xmmN для SSE2: mov ecx, b; movd; punpcklbw; punpcklwd; pshufd.
fn sse_broadcast(reg: int, b: int) {
    emit8(0xB9)
    emit32(b)
    let r = reg & 7
    emit_hex("66 0F 6E")
    emit8(0xC1 | (r << 3))
    emit_hex("66 0F 60")
    emit8(0xC0 | (r << 3) | r)
    emit_hex("66 0F 61")
    emit8(0xC0 | (r << 3) | r)
    emit_hex("66 0F 70")
    emit8(0xC0 | (r << 3) | r)
    emit8(0)
}

// То же для AVX2: mov ecx, b; vmovd xmmN, ecx; vpbroadcastb ymmN, xmmN.
fn avx_broadcast(reg: int, b: int) {
    emit8(0xB9)
    emit32(b)
    let r = reg & 7
    emit_hex("C5 F9 6E")
    emit8(0xC1 | (r << 3))
    emit_hex("C4 E2 7D 78")
    emit8(0xC0 | (r << 3) | r)
}

// __simd_find_byte(адрес, длина, байт)
fn emit_simd_find_byte() {
    let d = simd_dispatch()
    var found: [int] = []
    var done: [int] = []
    // AVX2: байт из edx: vmovd xmm1, edx; vpbroadcastb ymm1, xmm1
    emit_hex("C5 F9 6E CA C4 E2 7D 78 C9")
    let avx_top = here()
    let avx_end = simd_block_check(32)
    // vmovdqu ymm0, [rdi+rax]; vpcmpeqb ymm0, ymm0, ymm1; vpmovmskb ecx, ymm0
    emit_hex("C5 FE 6F 04 07 C5 FD 74 C1 C5 FD D7 C8")
    emit_hex("85 C9")
    let avx_hit = emit_jcc(CC_NE)
    emit_hex("48 83 C0 20")
    emit_jmp_to(avx_top)
    patch_here(avx_hit)
    emit_hex("C5 F8 77")
    found.push(emit_jmp())
    patch_here(avx_end)
    emit_hex("C5 F8 77")
    // SSE2
    patch_here(d[0])
    emit_hex("66 0F 6E CA 66 0F 60 C9 66 0F 61 C9 66 0F 70 C9 00")
    let sse_top = here()
    let sse_end = simd_block_check(16)
    // movdqu xmm0, [rdi+rax]; pcmpeqb xmm0, xmm1; pmovmskb ecx, xmm0
    emit_hex("F3 0F 6F 04 07 66 0F 74 C1 66 0F D7 C8")
    emit_hex("85 C9")
    found.push(emit_jcc(CC_NE))
    emit_hex("48 83 C0 10")
    emit_jmp_to(sse_top)
    let found_at = here()
    for h in found {
        patch_rel(h, found_at)
    }
    done.push(simd_found())
    // побайтно
    patch_here(sse_end)
    patch_here(d[1])
    let sc_top = here()
    emit_hex("48 39 F0")
    done.push(emit_jcc(CC_AE))
    // cmp byte [rdi+rax], dl
    emit_hex("38 14 07")
    done.push(emit_jcc(CC_E))
    emit_hex("48 FF C0")
    emit_jmp_to(sc_top)
    let end = here()
    for h in done {
        patch_rel(h, end)
    }
}

// __simd_find_json(адрес, длина): первый '"', '\\' или байт < 0x20.
fn emit_simd_find_json() {
    let d = simd_dispatch()
    var found: [int] = []
    var done: [int] = []
    // AVX2: ymm1 = '"', ymm2 = '\\', ymm3 = 0x1F
    avx_broadcast(1, 0x22)
    avx_broadcast(2, 0x5C)
    avx_broadcast(3, 0x1F)
    let avx_top = here()
    let avx_end = simd_block_check(32)
    // ymm0 = блок; ymm6 = (min(v, 0x1F) == v); ymm5 = (v == '"') | ymm6 | (v == '\\')
    emit_hex("C5 FE 6F 04 07")
    emit_hex("C5 FD DA F3 C5 CD 74 F0")
    emit_hex("C5 FD 74 E9 C5 D5 EB EE")
    emit_hex("C5 FD 74 F2 C5 D5 EB EE")
    emit_hex("C5 FD D7 CD 85 C9")
    let avx_hit = emit_jcc(CC_NE)
    emit_hex("48 83 C0 20")
    emit_jmp_to(avx_top)
    patch_here(avx_hit)
    emit_hex("C5 F8 77")
    found.push(emit_jmp())
    patch_here(avx_end)
    emit_hex("C5 F8 77")
    // SSE2
    patch_here(d[0])
    sse_broadcast(1, 0x22)
    sse_broadcast(2, 0x5C)
    sse_broadcast(3, 0x1F)
    let sse_top = here()
    let sse_end = simd_block_check(16)
    emit_hex("F3 0F 6F 04 07")
    emit_hex("66 0F 6F F0 66 0F DA F3 66 0F 74 F0")
    emit_hex("66 0F 6F E8 66 0F 74 E9 66 0F EB EE")
    emit_hex("66 0F 6F F0 66 0F 74 F2 66 0F EB EE")
    emit_hex("66 0F D7 CD 85 C9")
    found.push(emit_jcc(CC_NE))
    emit_hex("48 83 C0 10")
    emit_jmp_to(sse_top)
    let found_at = here()
    for h in found {
        patch_rel(h, found_at)
    }
    done.push(simd_found())
    // побайтно
    patch_here(sse_end)
    patch_here(d[1])
    let sc_top = here()
    emit_hex("48 39 F0")
    done.push(emit_jcc(CC_AE))
    // movzx ecx, byte [rdi+rax]
    emit_hex("0F B6 0C 07")
    emit_hex("83 F9 22")
    done.push(emit_jcc(CC_E))
    emit_hex("83 F9 5C")
    done.push(emit_jcc(CC_E))
    emit_hex("83 F9 20")
    done.push(emit_jcc(CC_B))
    emit_hex("48 FF C0")
    emit_jmp_to(sc_top)
    let end = here()
    for h in done {
        patch_rel(h, end)
    }
}

// __simd_find_crlf2(адрес, длина): начало «\r\n\r\n» или длина.
fn emit_simd_find_crlf2() {
    let d = simd_dispatch()
    var found: [int] = []
    var done: [int] = []
    // AVX2: ymm1 = '\r', ymm2 = '\n'; совпадение в i — '\r' в i, '\n' в i+1, ...
    avx_broadcast(1, 13)
    avx_broadcast(2, 10)
    let avx_top = here()
    let avx_end = simd_block_check(35)
    emit_hex("C5 F5 74 04 07")
    emit_hex("C5 ED 74 6C 07 01 C5 FD DB C5")
    emit_hex("C5 F5 74 6C 07 02 C5 FD DB C5")
    emit_hex("C5 ED 74 6C 07 03 C5 FD DB C5")
    emit_hex("C5 FD D7 C8 85 C9")
    let avx_hit = emit_jcc(CC_NE)
    emit_hex("48 83 C0 20")
    emit_jmp_to(avx_top)
    patch_here(avx_hit)
    emit_hex("C5 F8 77")
    found.push(emit_jmp())
    patch_here(avx_end)
    emit_hex("C5 F8 77")
    // SSE2
    patch_here(d[0])
    sse_broadcast(1, 13)
    sse_broadcast(2, 10)
    let sse_top = here()
    let sse_end = simd_block_check(19)
    emit_hex("F3 0F 6F 04 07 66 0F 74 C1")
    emit_hex("F3 0F 6F 6C 07 01 66 0F 74 EA 66 0F DB C5")
    emit_hex("F3 0F 6F 6C 07 02 66 0F 74 E9 66 0F DB C5")
    emit_hex("F3 0F 6F 6C 07 03 66 0F 74 EA 66 0F DB C5")
    emit_hex("66 0F D7 C8 85 C9")
    found.push(emit_jcc(CC_NE))
    emit_hex("48 83 C0 10")
    emit_jmp_to(sse_top)
    let found_at = here()
    for h in found {
        patch_rel(h, found_at)
    }
    done.push(simd_found())
    // побайтно: cmp dword [rdi+rax], 0x0A0D0A0D
    patch_here(sse_end)
    patch_here(d[1])
    let sc_top = here()
    emit_hex("48 8D 48 04 48 39 F1")
    let miss = emit_jcc(CC_A)
    emit_hex("81 3C 07 0D 0A 0D 0A")
    done.push(emit_jcc(CC_E))
    emit_hex("48 FF C0")
    emit_jmp_to(sc_top)
    patch_here(miss)
    // mov rax, rsi
    emit_hex("48 89 F0")
    let end = here()
    for h in done {
        patch_rel(h, end)
    }
}

// ---- UTF-8: проверка со счётом символов, пропуск символов, JSON со старшими байтами ----
// Здесь два пути: AVX2 (__simd_level 2) и скалярный, в котором ASCII идёт по 8
// байт (SWAR); отдельного SSE2 нет (docs/design/v0.13-utf8.md, §4.1), кроме
// __simd_find_json_hi: это копия __simd_find_json со всеми тремя путями.
// Байты — objdump -d от docs/design/v0.13-utf8.asm, вместе с переходами внутри
// примитива (метки — в комментариях); адреса в DATA вписываются при выдаче. Код
// проверен на C (272 млн случаев) и tests/run/utf8_simd.kh; чтобы его изменить,
// правьте .asm, собирайте nasm и переносите байты заново. Кроме аргументов
// затираются только rax rcx rdx r8–r11 и ymm0–ymm15 (rbp сохраняется); вызовов нет.

// Константы __simd_utf8_scan в DATA (352 байта, выровнены на 32), одни на программу:
// [0] 0x0F, [32] 0xC0, [64] [96] [128] таблицы T1 T2 T3 алгоритма Keiser–Lemire
// «lookup», [160] 0x60, [192] 0x70, [224] 0x80, [256] маска хвоста (32 × FF и
// 32 × 00), [320] MAXV — порог «блок кончается внутри символа».
var utf8_tab: int

fn data_fill(b: int, n: int) {
    for i in 0..n {
        data_byte(b)
    }
}

fn utf8_consts() -> int {
    if utf8_tab == 0 {
        while (data_len & 31) != 0 {
            data_byte(0)
        }
        utf8_tab = DATA_BASE + data_len
        data_fill(0x0F, 32)
        data_fill(0xC0, 32)
        data_hex("02 02 02 02 02 02 02 02 80 80 80 80 21 01 15 49")
        data_hex("02 02 02 02 02 02 02 02 80 80 80 80 21 01 15 49")
        data_hex("E7 A3 83 83 8B CB CB CB CB CB CB CB CB DB CB CB")
        data_hex("E7 A3 83 83 8B CB CB CB CB CB CB CB CB DB CB CB")
        data_hex("01 01 01 01 01 01 01 01 E6 AE BA BA 01 01 01 01")
        data_hex("01 01 01 01 01 01 01 01 E6 AE BA BA 01 01 01 01")
        data_fill(0x60, 32)
        data_fill(0x70, 32)
        data_fill(0x80, 32)
        data_fill(0xFF, 32)
        data_fill(0, 32)
        data_fill(0xFF, 29)
        data_hex("EF DF BF")
    }
    return utf8_tab
}

// Инструкция с операндом [disp32] в DATA: байты до смещения, затем адрес.
fn emit_abs(op: str, addr: int) {
    emit_hex(op)
    emit32(addr)
}

// Блок ymm0 проверки UTF-8 (148 байт): ymm6 — предыдущий блок, ymm7 копит ошибки,
// ymm8 — «предыдущий блок кончился внутри символа», r8 += число байтов 10xxxxxx.
// Константы — в ymm4, ymm5, ymm10–ymm15 (emit_simd_utf8_scan), t — их адрес.
fn utf8_block(t: int) {
    // vpmovmskb ecx, ymm0; test ecx, ecx; jnz .full
    emit_hex("C5 FD D7 C8 85 C9 75 10")
    // блок ASCII сразу после незаконченного символа — ошибка:
    // vpor ymm7, ymm7, ymm8; vpxor xmm8, xmm8, xmm8; vmovdqa ymm6, ymm0; jmp .done
    emit_hex("C4 C1 45 EB F8 C4 41 39 EF C0 C5 FD 6F F0 EB 7C")
    // .full: байты 0x80..0xBF (-64 > b со знаком): vpcmpgtb ymm9, ymm10, ymm0;
    // vpmovmskb ecx, ymm9; popcnt ecx, ecx; add r8, rcx
    emit_hex("C5 2D 64 C8 C4 C1 7D D7 C9 F3 0F B8 C9 49 01 C8")
    // ymm1 — конец прошлого блока и начало этого, ymm2 = prev1:
    // vperm2i128 ymm1, ymm6, ymm0, 0x21; vpalignr ymm2, ymm0, ymm1, 15
    emit_hex("C4 E3 4D 46 C8 21 C4 E3 7D 0F D1 0F")
    // ymm3 = T1[prev1 >> 4] & T2[prev1 & 15] & T3[b >> 4] (vpsrlw, vpand, vpshufb)
    emit_hex("C5 E5 71 D2 04 C5 E5 DB DD C4 E2 25 00 DB")
    emit_hex("C5 ED DB D5 C4 E2 1D 00 D2 C5 E5 DB DA")
    emit_hex("C5 ED 71 D0 04 C5 ED DB D5 C4 E2 15 00 D2 C5 E5 DB DA")
    // после prev2 >= 0xE0 и prev3 >= 0xF0 нужен байт продолжения (бит 7):
    // vpalignr ymm2, ymm0, ymm1, 14; vpalignr ymm1, ymm0, ymm1, 13;
    // vpsubusb ymm2, ymm2, ymm14; vpsubusb ymm1, ymm1, ymm15
    emit_hex("C4 E3 7D 0F D1 0E C4 E3 7D 0F C9 0D C4 C1 6D D8 D6 C4 C1 75 D8 CF")
    // vpor ymm2, ymm2, ymm1; vpand ymm2, ymm2, ymm4; vpxor ymm2, ymm2, ymm3; vpor ymm7, ymm7, ymm2
    emit_hex("C5 ED EB D1 C5 ED DB D4 C5 ED EF D3 C5 C5 EB FA")
    // блок кончается внутри символа: vpsubusb ymm8, ymm0, [MAXV]; vmovdqa ymm6, ymm0
    emit_abs("C5 7D D8 04 25", t + 320)
    emit_hex("C5 FD 6F F0")
    // .done
}

// __simd_utf8_scan(адрес, длина): число символов, если [p, p + n) — правильный
// UTF-8 (таблица 3-7 Unicode: без лишне длинных форм, суррогатов и значений больше
// U+10FFFF), иначе -1. AVX2 — проверка «lookup» по 32 байта, а число символов —
// n минус число байтов 10xxxxxx. Последние 0–31 байт — ещё один блок: одно чтение
// 32 байт с маской, если оно не выходит за страницу, иначе копия в обнулённый блок
// на стеке; пустой хвост не читается вовсе (блок нулей). Нули дополнения делают
// «символ не закончен в конце» обычной ошибкой «нет байта продолжения».
fn emit_simd_utf8_scan() {
    let t = utf8_consts()
    // cmp byte [__simd_level], 2; jb .swar
    emit_level_cmp(2)
    emit_hex("0F 82 81 02 00 00")
    // push rbp; mov rbp, rsp; sub rsp, 64; and rsp, -32 — блок для хвоста;
    // xor eax, eax — смещение блока; xor r8d, r8d — байты продолжения
    emit_hex("55 48 89 E5 48 83 EC 40 48 83 E4 E0 31 C0 45 31 C0")
    // vpxor xmm7, xmm7, xmm7; vpxor xmm6, xmm6, xmm6; vpxor xmm8, xmm8, xmm8
    emit_hex("C5 C1 EF FF C5 C9 EF F6 C4 41 39 EF C0")
    // vmovdqu: ymm5 = 0x0F, ymm10 = 0xC0, ymm11–ymm13 = T1–T3, ymm14 = 0x60,
    // ymm15 = 0x70, ymm4 = 0x80
    emit_abs("C5 FE 6F 2C 25", t)
    emit_abs("C5 7E 6F 14 25", t + 32)
    emit_abs("C5 7E 6F 1C 25", t + 64)
    emit_abs("C5 7E 6F 24 25", t + 96)
    emit_abs("C5 7E 6F 2C 25", t + 128)
    emit_abs("C5 7E 6F 34 25", t + 160)
    emit_abs("C5 7E 6F 3C 25", t + 192)
    emit_abs("C5 FE 6F 24 25", t + 224)
    // .blk: lea rcx, [rax + 32]; cmp rcx, rsi; ja .tail; vmovdqu ymm0, [rdi + rax]
    emit_hex("48 8D 48 20 48 39 F1 0F 87 A2 00 00 00 C5 FE 6F 04 07")
    utf8_block(t)
    // add rax, 32; jmp .blk
    emit_hex("48 83 C0 20 E9 51 FF FF FF")
    // .tail: rdx = n - rax; r9 = rdi + rax; vpxor xmm0, xmm0, xmm0; test rdx, rdx; jz .tblk
    emit_hex("48 89 F2 48 29 C2 4C 8D 0C 07 C5 F9 EF C0 48 85 D2 0F 84 A4 00 00 00")
    // чтение 32 байт не выходит за страницу, если (r9 & 4095) <= 4064, иначе ja .slowtail
    emit_hex("44 89 C9 81 E1 FF 0F 00 00 81 F9 E0 0F 00 00 77 16")
    // lea rcx, [маска + 32]; sub rcx, rdx; vmovdqu ymm0, [r9]; vpand ymm0, ymm0, [rcx]; jmp .tblk
    emit_abs("48 8D 0C 25", t + 288)
    emit_hex("48 29 D1 C4 C1 7E 6F 01 C5 FD DB 01 EB 7D")
    // .slowtail: vmovdqa [rsp], ymm0 и копия хвоста двумя перекрывающимися
    // кусками по 16, 8, 4 или 2 байта (.t8, .t4, .t2) или один байт (.t1), затем jmp .tdo
    emit_hex("C5 FD 7F 04 24 48 83 FA 10 72 19")
    emit_hex("C4 C1 7A 6F 09 C4 C1 7A 6F 54 11 F0 C5 FA 7F 0C 24 C5 FA 7F 54 14 F0 EB 54")
    emit_hex("48 83 FA 08 72 13 49 8B 09 4D 8B 54 11 F8 48 89 0C 24 4C 89 54 14 F8 EB 3B")
    emit_hex("48 83 FA 04 72 12 41 8B 09 45 8B 54 11 FC 89 0C 24 44 89 54 14 FC EB 23")
    emit_hex("48 83 FA 02 72 16 41 0F B7 09 45 0F B7 54 11 FE 66 89 0C 24 66 44 89 54 14 FE EB 07")
    emit_hex("41 0F B6 09 88 0C 24")
    // .tdo: vmovdqa ymm0, [rsp]
    emit_hex("C5 FD 6F 04 24")
    // .tblk
    utf8_block(t)
    // vptest ymm7, ymm7; vzeroupper; mov rsp, rbp; pop rbp; jnz .bad;
    // rax = n - r8; jmp .done
    emit_hex("C4 E2 7D 17 FF C5 F8 77 48 89 EC 5D 0F 85 A5 01 00 00")
    emit_hex("48 89 F0 4C 29 C0 E9 A1 01 00 00")
    // .swar: строгая проверка по символу со счётом в rax, rcx — смещение:
    // xor ecx, ecx; xor eax, eax
    emit_hex("31 C9 31 C0")
    // .s: cmp rcx, rsi; jae .good; 8 байт ASCII за шаг: lea r8, [rcx + 8]; cmp r8, rsi;
    // ja .one; mov r8, [rdi + rcx]; mov r9, 0x8080808080808080; test r8, r9; jnz .one;
    // add rcx, 8; add rax, 8; jmp .s
    emit_hex("48 39 F1 0F 83 8B 01 00 00 4C 8D 41 08 49 39 F0 77 1D")
    emit_hex("4C 8B 04 0F 49 B9 80 80 80 80 80 80 80 80 4D 85 C8 75 0A")
    emit_hex("48 83 C1 08 48 83 C0 08 EB D1")
    // .one: inc rax; edx = байт; < 0x80 — .a1, < 0xC2 — .bad, < 0xE0 — .c2,
    // < 0xF0 — .c3, > 0xF4 — .bad
    emit_hex("48 FF C0 0F B6 14 0F 81 FA 80 00 00 00 0F 82 4A 01 00 00")
    emit_hex("81 FA C2 00 00 00 0F 82 48 01 00 00 81 FA E0 00 00 00 0F 82 0A 01 00 00")
    emit_hex("81 FA F0 00 00 00 0F 82 9A 00 00 00 81 FA F4 00 00 00 0F 87 24 01 00 00")
    // 4 байта: rcx + 3 < n; r9d = второй байт: после F0 — не меньше 0x90 (.f1),
    // после F4 — не больше 0x8F (.f2); все три — 10xxxxxx; add rcx, 4; jmp .s
    emit_hex("4C 8D 41 03 49 39 F0 0F 83 17 01 00 00 44 0F B6 4C 0F 01")
    emit_hex("81 FA F0 00 00 00 75 0D 41 81 F9 90 00 00 00 0F 82 FC 00 00 00")
    emit_hex("81 FA F4 00 00 00 75 0D 41 81 F9 8F 00 00 00 0F 87 E7 00 00 00")
    emit_hex("41 81 E1 C0 00 00 00 41 81 F9 80 00 00 00 0F 85 D3 00 00 00")
    emit_hex("44 0F B6 4C 0F 02 41 81 E1 C0 00 00 00 41 81 F9 80 00 00 00 0F 85 B9 00 00 00")
    emit_hex("44 0F B6 4C 0F 03 41 81 E1 C0 00 00 00 41 81 F9 80 00 00 00 0F 85 9F 00 00 00")
    emit_hex("48 83 C1 04 E9 00 FF FF FF")
    // .c3: 3 байта: rcx + 2 < n; после E0 — не меньше 0xA0 (.e1), после ED — не
    // больше 0x9F (.e2, не суррогат); оба — 10xxxxxx; add rcx, 3; jmp .s
    emit_hex("4C 8D 41 02 49 39 F0 0F 83 89 00 00 00 44 0F B6 4C 0F 01")
    emit_hex("81 FA E0 00 00 00 75 09 41 81 F9 A0 00 00 00 72 72")
    emit_hex("81 FA ED 00 00 00 75 09 41 81 F9 9F 00 00 00 77 61")
    emit_hex("41 81 E1 C0 00 00 00 41 81 F9 80 00 00 00 75 51")
    emit_hex("44 0F B6 4C 0F 02 41 81 E1 C0 00 00 00 41 81 F9 80 00 00 00 75 3B")
    emit_hex("48 83 C1 03 E9 9C FE FF FF")
    // .c2: 2 байта: rcx + 1 < n; второй — 10xxxxxx; add rcx, 2; jmp .s
    emit_hex("4C 8D 41 01 49 39 F0 73 29 44 0F B6 4C 0F 01")
    emit_hex("41 81 E1 C0 00 00 00 41 81 F9 80 00 00 00 75 13 48 83 C1 02 E9 74 FE FF FF")
    // .a1: inc rcx; jmp .s; .good: jmp .done; .bad: mov rax, -1; .done
    emit_hex("48 FF C1 E9 6C FE FF FF EB 07 48 C7 C0 FF FF FF FF")
}

// __simd_utf8_skip(адрес, длина, k): смещение начала символа k (k >= 0) по
// правилу ведущих байтов — символ начинается в байте 0 и в каждом байте, кроме
// 10xxxxxx, — или n, если символов не больше k. На правильном UTF-8 — точное.
fn emit_simd_utf8_skip() {
    // xor eax, eax; test rdx, rdx; jz .r; mov eax, 1 — символ 0 начинается в
    // байте 0, ведущие байты ищутся в [1, n)
    emit_hex("31 C0 48 85 D2 0F 84 A5 00 00 00 B8 01 00 00 00")
    // cmp byte [__simd_level], 2; jb .s
    emit_level_cmp(2)
    emit_hex("72 72")
    // ymm1 = -65: b > -65 со знаком — b не 10xxxxxx
    emit_hex("B9 BF BF BF BF C5 F9 6E C9 C4 E2 7D 58 C9")
    // .blk: lea rcx, [rax + 32]; cmp rcx, rsi; ja .t; vmovdqu ymm0, [rdi + rax];
    // vpcmpgtb ymm0, ymm0, ymm1; vpmovmskb ecx, ymm0; popcnt r9d, ecx; cmp r9, rdx; jae .in;
    // sub rdx, r9; add rax, 32; jmp .blk
    emit_hex("48 8D 48 20 48 39 F1 77 58 C5 FE 6F 04 07")
    emit_hex("C5 FD 64 C1 C5 FD D7 C8 F3 44 0F B8 C9 49 39 D1 73 09")
    emit_hex("4C 29 CA 48 83 C0 20 EB D7")
    // .in: нужный ведущий байт в этом блоке. На уровне 3 (быстрый PDEP) бит k - 1,
    // разложенный по маске, ложится ровно на него: cmp byte [__simd_level], 3;
    // jb .clr0; lea r8, [rdx - 1]; xor r9d, r9d; bts r9, r8; pdep rcx, r9, rcx; jmp .bit
    emit_level_cmp(3)
    emit_hex("72 12 4C 8D 42 FF 45 31 C9 4D 0F AB C1 C4 E2 B3 F5 C9 EB 11")
    // .clr0: иначе сбросить k - 1 младших битов маски по одному: dec rdx; jz .bit;
    // .clr: lea r8d, [rcx - 1]; and ecx, r8d; dec rdx; jnz .clr
    emit_hex("48 FF CA 74 0C 44 8D 41 FF 44 21 C1 48 FF CA 75 F4")
    // .bit: bsf ecx, ecx; add rax, rcx; vzeroupper; jmp .r; .t: vzeroupper
    emit_hex("0F BC C9 48 01 C8 C5 F8 77 EB 27 C5 F8 77")
    // .s: по байту: cmp rax, rsi; jae .end; movzx ecx, byte [rdi + rax];
    // and ecx, 0xC0; cmp ecx, 0x80; je .n; dec rdx; jz .r; .n: inc rax; jmp .s
    emit_hex("48 39 F0 73 1C 0F B6 0C 07 81 E1 C0 00 00 00 81 F9 80 00 00 00 74 05")
    emit_hex("48 FF CA 74 08 48 FF C0 EB DF")
    // .end: mov rax, rsi; .r
    emit_hex("48 89 F0")
}

// __simd_utf8_seek(адрес, длина, k): смещение начала символа k (k >= 0) по
// правилу ведущих байтов (n, если символов не больше k), если [p, p + смещение) —
// правильный UTF-8 (при смещении n — вся строка), иначе -1 - смещение. Один
// проход вместо __simd_utf8_scan и __simd_utf8_skip: блоки по 32 байта
// проверяются (как в __simd_utf8_scan, без счёта) только до блока с символом k,
// а в нём ошибки таблиц берутся лишь до байта смещения включительно — ошибка в
// этом байте значит, что символ перед ним не закончен. Только AVX2: при
// __simd_level < 2 обёртка (lib/text.kh, __utf8_seek) берёт пропуск и проверку.
// Хвост — как у __simd_utf8_scan, а ведущие байты в нём — только среди r
// настоящих; если символа k нет, проверяется и первый нуль за ними.
fn emit_simd_utf8_seek() {
    let t = utf8_consts()
    // xor eax, eax; test rdx, rdx; jz .done (k = 0: смещение 0, проверять нечего);
    // push rbp; mov rbp, rsp; sub rsp, 64; and rsp, -32 — блок для хвоста
    emit_hex("31 C0 48 85 D2 0F 84 DD 02 00 00 55 48 89 E5 48 83 EC 40 48 83 E4 E0")
    // vpxor xmm7, xmm7, xmm7; vpxor xmm6, xmm6, xmm6; vpxor xmm8, xmm8, xmm8
    emit_hex("C5 C1 EF FF C5 C9 EF F6 C4 41 39 EF C0")
    // константы — как в __simd_utf8_scan
    emit_abs("C5 FE 6F 2C 25", t)
    emit_abs("C5 7E 6F 14 25", t + 32)
    emit_abs("C5 7E 6F 1C 25", t + 64)
    emit_abs("C5 7E 6F 24 25", t + 96)
    emit_abs("C5 7E 6F 2C 25", t + 128)
    emit_abs("C5 7E 6F 34 25", t + 160)
    emit_abs("C5 7E 6F 3C 25", t + 192)
    emit_abs("C5 FE 6F 24 25", t + 224)
    // mov r10d, 1 — байт 0 начинает символ 0, даже если он 10xxxxxx
    emit_hex("41 BA 01 00 00 00")
    // .blk: lea rcx, [rax + 32]; cmp rcx, rsi; ja .tail; vmovdqu ymm0, [rdi + rax];
    // ведущие байты блока: vpcmpgtb ymm9, ymm10, ymm0; vpmovmskb ecx, ymm9; not ecx;
    // or ecx, r10d; xor r10d, r10d; popcnt r9d, ecx; cmp r9, rdx; ja .found
    // (символ k — в этом блоке); sub rdx, r9
    emit_hex("48 8D 48 20 48 39 F1 0F 87 B4 00 00 00 C5 FE 6F 04 07 C5 2D 64 C8")
    emit_hex("C4 C1 7D D7 C9 F7 D1 44 09 D1 45 31 D2 F3 44 0F B8 C9 49 39 D1")
    emit_hex("0F 87 7F 01 00 00 4C 29 CA")
    // проверка блока без счёта: ASCII — vpmovmskb ecx, ymm0; test ecx, ecx; jnz .full;
    // vpor ymm7, ymm7, ymm8; vpxor xmm8, xmm8, xmm8; vmovdqa ymm6, ymm0; jmp .next
    emit_hex("C5 FD D7 C8 85 C9 75 10 C4 C1 45 EB F8 C4 41 39 EF C0 C5 FD 6F F0 EB 6C")
    // .full: таблицы Keiser–Lemire, как в utf8_block; vpor ymm7, ymm7, ymm2
    emit_hex("C4 E3 4D 46 C8 21 C4 E3 7D 0F D1 0F C5 E5 71 D2 04 C5 E5 DB DD C4 E2 25 00 DB")
    emit_hex("C5 ED DB D5 C4 E2 1D 00 D2 C5 E5 DB DA C5 ED 71 D0 04 C5 ED DB D5")
    emit_hex("C4 E2 15 00 D2 C5 E5 DB DA C4 E3 7D 0F D1 0E C4 E3 7D 0F C9 0D C4 C1 6D D8 D6")
    emit_hex("C4 C1 75 D8 CF C5 ED EB D1 C5 ED DB D4 C5 ED EF D3 C5 C5 EB FA")
    // vpsubusb ymm8, ymm0, [MAXV]; vmovdqa ymm6, ymm0
    emit_abs("C5 7D D8 04 25", t + 320)
    emit_hex("C5 FD 6F F0")
    // .next: add rax, 32; jmp .blk
    emit_hex("48 83 C0 20 E9 3F FF FF FF")
    // .tail: r11 = n - rax (rdx занят k); r9 = rdi + rax; vpxor xmm0, xmm0, xmm0;
    // test r11, r11; jz .tblk; чтение 32 байт не выходит за страницу, если
    // (r9 & 4095) <= 4064, иначе ja .slowtail
    emit_hex("49 89 F3 49 29 C3 4C 8D 0C 07 C5 F9 EF C0 4D 85 DB 0F 84 A5 00 00 00 44 89 C9")
    emit_hex("81 E1 FF 0F 00 00 81 F9 E0 0F 00 00 77 16")
    // lea rcx, [маска + 32]; sub rcx, r11; vmovdqu ymm0, [r9]; vpand ymm0, ymm0, [rcx]; jmp .tblk
    emit_abs("48 8D 0C 25", t + 288)
    emit_hex("4C 29 D9 C4 C1 7E 6F 01 C5 FD DB 01 EB 7E")
    // .slowtail: копия хвоста в обнулённый блок на стеке, как в __simd_utf8_scan
    // (длина — в r11, второй кусок — через r8)
    emit_hex("C5 FD 7F 04 24 49 83 FB 10 72 1A C4 C1 7A 6F 09 C4 81 7A 6F 54 19 F0")
    emit_hex("C5 FA 7F 0C 24 C4 A1 7A 7F 54 1C F0 EB 54")
    emit_hex("49 83 FB 08 72 13 49 8B 09 4F 8B 44 19 F8 48 89 0C 24 4E 89 44 1C F8 EB 3B")
    emit_hex("49 83 FB 04 72 12 41 8B 09 47 8B 44 19 FC 89 0C 24 46 89 44 1C FC EB 23")
    emit_hex("49 83 FB 02 72 16 41 0F B7 09 47 0F B7 44 19 FE 66 89 0C 24 66 46 89 44 1C FE EB 07")
    emit_hex("41 0F B6 09 88 0C 24")
    // .tdo: vmovdqa ymm0, [rsp]
    emit_hex("C5 FD 6F 04 24")
    // .tblk: ведущие байты среди r11 настоящих: mov ecx, r11d; mov r8d, 1; shl r8d, cl;
    // dec r8d; vpcmpgtb ymm9, ymm10, ymm0; vpmovmskb ecx, ymm9; not ecx; or ecx, r10d;
    // and ecx, r8d; popcnt r9d, ecx; cmp r9, rdx; ja .found
    emit_hex("44 89 D9 41 B8 01 00 00 00 41 D3 E0 41 FF C8 C5 2D 64 C8 C4 C1 7D D7 C9 F7 D1")
    emit_hex("44 09 D1 44 21 C1 F3 44 0F B8 C9 49 39 D1 77 09")
    // символа k нет: mov rax, rsi; lea r8d, [r11 + 1] — проверить и нуль за хвостом; jmp .last
    emit_hex("48 89 F0 45 8D 43 01 EB 33")
    // .found: символ k начинается со следующего ведущего за rdx младшими. На
    // уровне 3 — PDEP, как в __simd_utf8_skip: cmp byte [__simd_level], 3; jb .clr0;
    // xor r8d, r8d; bts r8, rdx; pdep rcx, r8, rcx; jmp .bit
    emit_level_cmp(3)
    emit_hex("72 0E 45 31 C0 49 0F AB D0 C4 E2 BB F5 C9 EB 11")
    // .clr0: иначе сбросить их по одному: test rdx, rdx; jz .bit;
    // .clr: lea r8d, [rcx - 1]; and ecx, r8d; dec rdx; jnz .clr;
    // .bit: bsf ecx, ecx; add rax, rcx; lea r8d, [rcx + 1]
    emit_hex("48 85 D2 74 0C 44 8D 41 FF 44 21 C1 48 FF CA 75 F4 0F BC C9 48 01 C8 44 8D 41 01")
    // .last: ymm9 — маска первых r8 байтов (1–32): lea rcx, [маска + 32]; sub rcx, r8;
    // vmovdqu ymm9, [rcx]
    emit_abs("48 8D 0C 25", t + 288)
    emit_hex("4C 29 C1 C5 7E 6F 09")
    // проверка последнего блока: ASCII — vpor ymm7, ymm7, ymm8 (символ перед блоком
    // не закончен); иначе таблицы, а их ошибки — vpand ymm2, ymm2, ymm9
    emit_hex("C5 FD D7 C8 85 C9 75 07 C4 C1 45 EB F8 EB 64")
    emit_hex("C4 E3 4D 46 C8 21 C4 E3 7D 0F D1 0F C5 E5 71 D2 04 C5 E5 DB DD C4 E2 25 00 DB")
    emit_hex("C5 ED DB D5 C4 E2 1D 00 D2 C5 E5 DB DA C5 ED 71 D0 04 C5 ED DB D5")
    emit_hex("C4 E2 15 00 D2 C5 E5 DB DA C4 E3 7D 0F D1 0E C4 E3 7D 0F C9 0D C4 C1 6D D8 D6")
    emit_hex("C4 C1 75 D8 CF C5 ED EB D1 C5 ED DB D4 C5 ED EF D3 C4 C1 6D DB D1 C5 C5 EB FA")
    // vptest ymm7, ymm7; vzeroupper; mov rsp, rbp; pop rbp; jz .done; not rax (-1 - смещение); .done
    emit_hex("C4 E2 7D 17 FF C5 F8 77 48 89 EC 5D 74 03 48 F7 D0")
}

// Константы __simd_case в DATA (480 байт, выровнены на 32), одни на программу:
// по 128 байт на регистр (нижний, верхний): [0] первая буква, которую надо
// менять, [32] TD — разности байтов продолжения (индекс 8–B после D0, 0–3 после
// D1, по старшей тетраде байта), [64] TL — разности первых байтов (8–B для D0,
// 0–3 для D1, по старшей тетраде следующего байта); затем [256] 25, [288] 0x0F,
// [320] 0xC0, [352] 0xA0, [384] 0xD0, [416] 0xD1, [448] 0x20.
var case_tab: int

fn case_consts() -> int {
    if case_tab == 0 {
        while (data_len & 31) != 0 {
            data_byte(0)
        }
        case_tab = DATA_BASE + data_len
        // нижний: Ѐ–Џ (D0 80–8F) → D1 90–9F, А–П (D0 90–9F) → D0 B0–BF,
        // Р–Я (D0 A0–AF) → D1 80–8F
        data_fill(0x41, 32)
        data_hex("00 00 00 00 00 00 00 00 10 20 E0 00 00 00 00 00")
        data_hex("00 00 00 00 00 00 00 00 10 20 E0 00 00 00 00 00")
        data_hex("00 00 00 00 00 00 00 00 01 00 01 00 00 00 00 00")
        data_hex("00 00 00 00 00 00 00 00 01 00 01 00 00 00 00 00")
        data_fill(0, 32)
        // верхний: а–п (D0 B0–BF) → D0 90–9F, р–я (D1 80–8F) → D0 A0–AF,
        // ѐ–џ (D1 90–9F) → D0 80–8F
        data_fill(0x61, 32)
        data_hex("20 F0 00 00 00 00 00 00 00 00 00 E0 00 00 00 00")
        data_hex("20 F0 00 00 00 00 00 00 00 00 00 E0 00 00 00 00")
        data_hex("FF FF 00 00 00 00 00 00 00 00 00 00 00 00 00 00")
        data_hex("FF FF 00 00 00 00 00 00 00 00 00 00 00 00 00 00")
        data_fill(0, 32)
        data_fill(25, 32)
        data_fill(0x0F, 32)
        data_fill(0xC0, 32)
        data_fill(0xA0, 32)
        data_fill(0xD0, 32)
        data_fill(0xD1, 32)
        data_fill(0x20, 32)
    }
    return case_tab
}

// __simd_case(куда, откуда, n, up): регистр (up = 1 — верхний) ASCII и
// кириллицы U+0400–045F блоками по 32 байта → сколько байтов с начала
// обработано. Длина символов не меняется, поэтому блок отображается на месте:
// каждый байт — по себе и соседям (предыдущий — для байта продолжения,
// следующий — для первого байта пары). Блок, в котором есть что-то ещё (другие
// первые байты, D1 A0–BF, одинокие байты продолжения, пара без второго байта),
// не принимается, и ответ — его начало, а если на границе стоит первый байт пары
// — он (этот байт уже записан, посимвольный проход перепишет его). Куда = 0 —
// только проверка: не принимается и блок, где что-то меняется. Последний блок —
// внахлёст до n, следующий байт за концом — нуль. n < 32 — 0. Только AVX2;
// байты — objdump -d от kh_case из docs/design/v0.13-utf8.asm, проверено на C
// (39 млн случаев) и tests/run/case.kh.
fn emit_simd_case() {
    let t = case_consts()
    // xor eax, eax; cmp rdx, 32; jb .ret (n < 32 — 0); shl ecx, 7;
    // lea r8, [rcx + таблица] — 128 байт регистра
    emit_hex("31 C0 48 83 FA 20 0F 82 33 03 00 00 C1 E1 07")
    emit_abs("4C 8D 81", t)
    // ymm8 = 0x20, ymm11 = 0xD1, ymm12 = 0xD0, ymm13 = 0xA0, ymm14 = 0xC0, ymm15 = 0x0F
    emit_abs("C5 7E 6F 04 25", t + 448)
    emit_abs("C5 7E 6F 1C 25", t + 416)
    emit_abs("C5 7E 6F 24 25", t + 384)
    emit_abs("C5 7E 6F 2C 25", t + 352)
    emit_abs("C5 7E 6F 34 25", t + 320)
    emit_abs("C5 7E 6F 3C 25", t + 288)
    // .blk: mov r11, rax (ответ, если блок не примут); lea rcx, [rax + 33];
    // cmp rcx, rdx; ja .last (нужен и байт за блоком); ymm0 = c — блок
    emit_hex("49 89 C3 48 8D 48 21 48 39 D1 0F 87 5C 01 00 00 C5 FE 6F 04 06 C5 FD D7 C8")
    case_block(t, "0F 85 93 02 00 00 E9 1F 01 00 00", "E9 0C 01 00 00", false, "0F 85 D7 01 00 00", "0F 85 76 01 00 00 EB 05")
    // .next: add rax, 32; jmp .blk
    emit_hex("48 83 C0 20 E9 94 FE FF FF")
    // .last: cmp rax, rdx; je .end; последний блок — внахлёст: rax = n - 32
    emit_hex("48 39 D0 0F 84 7B 01 00 00 48 89 D0 48 83 E8 20 C5 FE 6F 04 06 C5 FD D7 C8")
    case_block(t, "0F 85 27 01 00 00 E9 1D 01 00 00", "E9 0A 01 00 00", true, "75 69", "75 0C EB 05")
    // принят: mov rax, rdx; jmp .end
    emit_hex("48 89 D0 EB 1E")
    // .out: mov rax, r11; перед ним первый байт пары (D0, D1) — ответ на байт
    // раньше: test rax, rax; jz .end; movzx ecx, byte [rsi + rax - 1];
    // and ecx, 0xFE; cmp ecx, 0xD0; jne .end; dec rax
    emit_hex("4C 89 D8 48 85 C0 74 16 0F B6 4C 06 FF 81 E1 FE 00 00 00 81 F9 D0 00 00 00")
    emit_hex("75 03 48 FF C8")
    // .end: vzeroupper; .ret
    emit_hex("C5 F8 77")
}

// Блок ymm0 = c с позиции rax для emit_simd_case; хвосты переходов (.out, .done)
// у двух копий разные: out_a — из ASCII-проверки, done_a — после записи ASCII,
// out_bad — блок с другими байтами, tail — конец проверки «ничего не меняется».
// last — последний блок: z — сдвиг c с нулём в конце, а не чтение за блоком.
fn case_block(t: int, out_a: str, done_a: str, last: bool, out_bad: str, tail: str) {
    // vpmovmskb ecx, ymm0 (байты >= 0x80); test ecx, ecx; jnz .full
    // ASCII: буквы — (c - первая) <= 25: vpsubb ymm1, ymm0, [r8];
    // vpminub ymm3, ymm1, [25]; vpcmpeqb ymm3, ymm3, ymm1
    emit_hex("85 C9 75 3A C4 C1 7D F8 08")
    emit_abs("C5 F5 DA 1C 25", t + 256)
    // test rdi, rdi; jnz .aw; vptest ymm3, ymm3; jnz .out; jmp .done
    emit_hex("C5 E5 74 D9 48 85 FF 75 10 C4 E2 7D 17 DB " + out_a)
    // .aw: vpand ymm3, ymm3, ymm8; vpxor ymm2, ymm0, ymm3; vmovdqu [rdi + rax], ymm2; jmp .done
    emit_hex("C4 C1 65 DB D8 C5 FD EF D3 C5 FE 7F 14 07 " + done_a)
    // .full: a — байты перед c: в начале — сдвиг c с нулём (vperm2i128 ymm1, ymm0,
    // ymm0, 8; vpalignr ymm2, ymm0, ymm1, 15), иначе vmovdqu ymm2, [rsi + rax - 1]
    emit_hex("48 85 C0 75 0E C4 E3 7D 46 C8 08 C4 E3 7D 0F D1 0F EB 06")
    emit_hex("C5 FE 6F 54 06 FF")
    // ymm3 = (a = D1), ymm4 = (a = D0); индекс TD — старшая тетрада c, после D1
    // ^ 8 (vpand ymm2, ymm3, ymm8; vpsrlw ymm2, ymm2, 2); vpshufb из [r8 + 32];
    // разности — только после D0 и D1; ymm2 = c + разности
    emit_hex("C4 C1 6D 74 DB C4 C1 6D 74 E4 C5 F5 71 D0 04 C4 C1 75 DB CF C4 C1 65 DB D0")
    emit_hex("C5 ED 71 D2 02 C5 F5 EF CA C4 C1 7E 6F 50 20 C4 E2 6D 00 D1 C5 E5 EB CC")
    emit_hex("C5 ED DB D1 C5 ED FC D0")
    // годные байты продолжения: 80–BF после D0, 80–9F после D1 → r9d
    // (vpcmpgtb с 0xA0 — 80–9F, с 0xC0 — 80–BF)
    emit_hex("C5 95 64 C8 C5 E5 DB D9 C5 E5 EB DC C5 8D 64 C8 C5 E5 DB D9 C5 7D D7 CB")
    if last {
        // z — c, сдвинутый на байт, с нулём в конце: vperm2i128 ymm1, ymm0, ymm0, 0x81;
        // vpalignr ymm1, ymm1, ymm0, 1
        emit_hex("C4 E3 7D 46 C8 81 C4 E3 75 0F C8 01")
    } else {
        // z — байты за c: vmovdqu ymm1, [rsi + rax + 1]
        emit_hex("C5 FE 6F 4C 06 01")
    }
    // годные первые байты: D0 перед 80–BF, D1 перед 80–9F → r9d; другие байты
    // >= 0x80 (ecx & ~r9d) — jnz .out
    emit_hex("C4 C1 7D 74 E4 C5 8D 64 D9 C5 E5 DB DC C5 7D D7 D3 45 09 D1")
    emit_hex("C4 C1 7D 74 DB C5 95 64 F1 C5 CD DB F3 C5 7D D7 D6 45 09 D1 41 F7 D1 44 21 C9 " + out_bad)
    // разности первых байтов: индекс TL — старшая тетрада z, для D1 ^ 8;
    // vpshufb из [r8 + 64], только у D0 и D1; ymm2 += они
    emit_hex("C5 DD EB E3 C4 C1 65 DB D8 C5 E5 71 D3 02 C5 F5 71 D1 04 C4 C1 75 DB CF C5 F5 EF CB")
    emit_hex("C4 C1 7E 6F 58 40 C4 E2 65 00 D9 C5 E5 DB DC C5 ED FC D3")
    // буквы ASCII, как выше: ymm2 ^= 0x20 у них
    emit_hex("C4 C1 7D F8 08")
    emit_abs("C5 F5 DA 1C 25", t + 256)
    emit_hex("C5 E5 74 D9 C4 C1 65 DB D8 C5 ED EF D3")
    // test rdi, rdi; jnz .fw; только проверка: vpcmpeqb ymm1, ymm2, ymm0;
    // vpmovmskb ecx, ymm1; not ecx; test ecx, ecx; jnz .out; jmp .done
    if last {
        emit_hex("48 85 FF 75 10 C5 ED 74 C8 C5 FD D7 C9 F7 D1 85 C9 " + tail)
    } else {
        emit_hex("48 85 FF 75 14 C5 ED 74 C8 C5 FD D7 C9 F7 D1 85 C9 " + tail)
    }
    // .fw: vmovdqu [rdi + rax], ymm2; .done
    emit_hex("C5 FE 7F 14 07")
}

// __simd_find_json_hi(адрес, длина): то же, что __simd_find_json, и ещё бит 62
// результата — был ли до найденного места байт >= 0x80 (тогда строку JSON нужно
// проверить на UTF-8). Маска старших битов копится в r9d; в блоке с находкой —
// только до неё: lea r10, [rcx - 1]; xor r10, rcx — биты до младшей единицы
// маски находок включительно.
fn emit_simd_find_json_hi() {
    // xor r9d, r9d; xor eax, eax; cmp byte [__simd_level], 1; jb .sc;
    // cmp byte [__simd_level], 2; jb .sse
    emit_hex("45 31 C9 31 C0")
    emit_level_cmp(1)
    emit_hex("0F 82 26 01 00 00")
    emit_level_cmp(2)
    emit_hex("72 7D")
    // AVX2: ymm1 = '"', ymm2 = '\\', ymm3 = 0x1F
    emit_hex("B9 22 00 00 00 C5 F9 6E C9 C4 E2 7D 78 C9")
    emit_hex("B9 5C 00 00 00 C5 F9 6E D1 C4 E2 7D 78 D2")
    emit_hex("B9 1F 00 00 00 C5 F9 6E D9 C4 E2 7D 78 DB")
    // .atop: lea rcx, [rax + 32]; cmp rcx, rsi; ja .aend; ymm0 = блок;
    // ymm5 = (min(v, 0x1F) == v) | (v == '"') | (v == '\\')
    emit_hex("48 8D 48 20 48 39 F1 77 47 C5 FE 6F 04 07")
    emit_hex("C5 FD DA F3 C5 CD 74 F0")
    emit_hex("C5 FD 74 E9 C5 D5 EB EE")
    emit_hex("C5 FD 74 F2 C5 D5 EB EE")
    // vpmovmskb ecx, ymm5; vpmovmskb r8d, ymm0; test ecx, ecx; jnz .ahit;
    // or r9d, r8d; add rax, 32; jmp .atop
    emit_hex("C5 FD D7 CD C5 7D D7 C0 85 C9 75 09 45 09 C1 48 83 C0 20 EB C5")
    // .ahit: lea r10, [rcx - 1]; xor r10, rcx; and r8d, r10d; or r9d, r8d;
    // vzeroupper; jmp .found; .aend: vzeroupper
    emit_hex("4C 8D 51 FF 49 31 CA 45 21 D0 45 09 C1 C5 F8 77 E9 9A 00 00 00 C5 F8 77")
    // .sse: SSE2, те же байты в xmm1–xmm3 (movd, punpcklbw, punpcklwd, pshufd)
    emit_hex("B9 22 00 00 00 66 0F 6E C9 66 0F 60 C9 66 0F 61 C9 66 0F 70 C9 00")
    emit_hex("B9 5C 00 00 00 66 0F 6E D1 66 0F 60 D2 66 0F 61 D2 66 0F 70 D2 00")
    emit_hex("B9 1F 00 00 00 66 0F 6E D9 66 0F 60 DB 66 0F 61 DB 66 0F 70 DB 00")
    // .stop: lea rcx, [rax + 16]; cmp rcx, rsi; ja .sc; movdqu xmm0, [rdi + rax]
    emit_hex("48 8D 48 10 48 39 F1 77 54 F3 0F 6F 04 07")
    emit_hex("66 0F 6F F0 66 0F DA F3 66 0F 74 F0")
    emit_hex("66 0F 6F E8 66 0F 74 E9 66 0F EB EE")
    emit_hex("66 0F 6F F0 66 0F 74 F2 66 0F EB EE")
    // pmovmskb ecx, xmm5; pmovmskb r8d, xmm0; test ecx, ecx; jnz .shit;
    // or r9d, r8d; add rax, 16; jmp .stop
    emit_hex("66 0F D7 CD 66 44 0F D7 C0 85 C9 75 09 45 09 C1 48 83 C0 10 EB B8")
    // .shit: то же, что .ahit; .found: bsf ecx, ecx; add rax, rcx; jmp .done
    emit_hex("4C 8D 51 FF 49 31 CA 45 21 D0 45 09 C1 0F BC C9 48 01 C8 EB 27")
    // .sc: побайтно: cmp rax, rsi; jae .done; movzx ecx, byte [rdi + rax];
    // '"', '\\' или < 0x20 — .done
    emit_hex("48 39 F0 73 22 0F B6 0C 07 83 F9 22 74 19 83 F9 5C 74 14 83 F9 20 72 0F")
    // r9d |= c >> 7: mov r10d, ecx; shr r10d, 7; or r9d, r10d; inc rax; jmp .sc
    emit_hex("41 89 CA 41 C1 EA 07 45 09 D1 48 FF C0 EB D9")
    // .done: test r9d, r9d; jz .ret; bts rax, 62; .ret
    emit_hex("45 85 C9 74 05 48 0F BA E8 3E")
}

// ---- Сборщик store: слова со значением в STORE ----

// __simd_pinscan(адрес, n, out): слова [p, p + 8n) со значением в области STORE
// ((w >> 38) == 0x40) — подряд в out; → их число. В out — место на n слов:
// найденный блок пишет все свои слова и сдвигает конец только на совпавшие
// (без переходов по каждому слову), поэтому лишнее слово может лечь за концом,
// но не дальше n. Запись сборщика копирует так регистры, стек и контекст
// (lib/gc.kh, __pin_take); совпадений обычно нет, и блок без них — несколько
// инструкций. AVX2 — 4 слова за шаг (vpsrlq 38, vpcmpeqq, vmovmskpd), SSE2 — 2
// (pcmpeqq в SSE2 нет: после сдвига на 38 старшая половина слова — нуль, и
// сравниваются половины, pcmpeqd; совпадение — младшие, биты 0 и 2
// movmskps), остаток и уровень 0 — по слову. Байты — nasm от текста в
// комментариях; кроме аргументов затираются rax rcx r8–r11 и ymm0–ymm2.
fn emit_simd_pinscan() {
    // xor eax, eax (найдено); xor r8d, r8d (номер слова)
    emit_hex("31 C0 45 31 C0")
    // cmp byte [__simd_level], 1; jb .scalar; cmp byte [__simd_level], 2; jb .sse
    emit_level_cmp(1)
    emit_hex("0F 82 F8 00 00 00")
    emit_level_cmp(2)
    emit_hex("0F 82 8C 00 00 00")
    // AVX2: ymm2 = 0x40 в каждом слове: mov r9d, 0x40; vmovq xmm2, r9; vpbroadcastq ymm2, xmm2
    emit_hex("41 B9 40 00 00 00 C4 C1 F9 6E D1 C4 E2 7D 59 D2")
    // .avx: lea r9, [r8 + 4]; cmp r9, rsi; ja .avx_end; vmovdqu ymm0, [rdi + r8*8];
    // vpsrlq ymm1, ymm0, 38; vpcmpeqq ymm1, ymm1, ymm2; vmovmskpd ecx, ymm1;
    // test ecx, ecx; jnz .avx_hit; .avx_next: add r8, 4; jmp .avx
    emit_hex("4D 8D 48 04 49 39 F1 77 6E C4 A1 7E 6F 04 C7 C5 F5 73 D0 26")
    emit_hex("C4 E2 75 29 CA C5 FD 50 C9 85 C9 75 06 49 83 C0 04 EB D9")
    // .avx_hit: слово k блока: mov r10, [rdi + r8*8 + 8k]; mov [rdx + rax*8], r10;
    // rax += бит k маски (mov r11d, ecx; shr r11d, k; and r11d, 1; add rax, r11);
    // после слова 3 — shr ecx, 3; add rax, rcx; jmp .avx_next
    emit_hex("4E 8B 14 C7 4C 89 14 C2 41 89 CB 41 83 E3 01 4C 01 D8")
    emit_hex("4E 8B 54 C7 08 4C 89 14 C2 41 89 CB 41 D1 EB 41 83 E3 01 4C 01 D8")
    emit_hex("4E 8B 54 C7 10 4C 89 14 C2 41 89 CB 41 C1 EB 02 41 83 E3 01 4C 01 D8")
    emit_hex("4E 8B 54 C7 18 4C 89 14 C2 C1 E9 03 48 01 C8 EB AA")
    // .avx_end: vzeroupper; jmp .scalar (остаток)
    emit_hex("C5 F8 77 EB 5E")
    // .sse: xmm2 = [0x40, 0, 0x40, 0] (по 32 бита): mov r9d, 0x40; movq xmm2, r9;
    // punpcklqdq xmm2, xmm2
    emit_hex("41 B9 40 00 00 00 66 49 0F 6E D1 66 0F 6C D2")
    // .sse_loop: lea r9, [r8 + 2]; cmp r9, rsi; ja .scalar; movdqu xmm1, [rdi + r8*8];
    // psrlq xmm1, 38; pcmpeqd xmm1, xmm2; movmskps ecx, xmm1; test ecx, 5;
    // jnz .sse_hit; .sse_next: add r8, 2; jmp .sse_loop
    emit_hex("4D 8D 48 02 49 39 F1 77 46 F3 42 0F 6F 0C C7 66 0F 73 D1 26")
    emit_hex("66 0F 76 CA 0F 50 C9 F7 C1 05 00 00 00 75 06 49 83 C0 02 EB D7")
    // .sse_hit: слово 0 и rax += бит 0; слово 1 и rax += бит 2; jmp .sse_next
    emit_hex("4E 8B 14 C7 4C 89 14 C2 41 89 CB 41 83 E3 01 4C 01 D8")
    emit_hex("4E 8B 54 C7 08 4C 89 14 C2 C1 E9 02 83 E1 01 48 01 C8 EB D4")
    // .scalar: cmp r8, rsi; jae .done; mov r10, [rdi + r8*8]; mov r11, r10;
    // shr r11, 38; cmp r11, 0x40; jne .s_next; mov [rdx + rax*8], r10; inc rax;
    // .s_next: inc r8; jmp .scalar; .done
    emit_hex("49 39 F0 73 1D 4E 8B 14 C7 4D 89 D3 49 C1 EB 26 49 83 FB 40 75 07")
    emit_hex("4C 89 14 C2 48 FF C0 49 FF C0 EB DE")
}

// __cpu_avx2(): есть ли AVX2 и включено ли сохранение ymm операционной системой.
fn emit_cpu_avx2() {
    var no: [int] = []
    // push rbx; mov eax, 1; xor ecx, ecx; cpuid
    emit_hex("53 B8 01 00 00 00 31 C9 0F A2")
    // OSXSAVE и AVX: ecx биты 27, 28
    emit_hex("81 E1 00 00 00 18 81 F9 00 00 00 18")
    no.push(emit_jcc(CC_NE))
    // xgetbv: XMM и YMM сохраняются
    emit_hex("31 C9 0F 01 D0 83 E0 06 83 F8 06")
    no.push(emit_jcc(CC_NE))
    // mov eax, 7; xor ecx, ecx; cpuid; test ebx, 1 << 5
    emit_hex("B8 07 00 00 00 31 C9 0F A2 F7 C3 20 00 00 00")
    emit_setcc(CC_NE)
    let done = emit_jmp()
    let no_at = here()
    for h in no {
        patch_rel(h, no_at)
    }
    emit_hex("31 C0")
    patch_here(done)
    // pop rbx
    emit8(0x5B)
}

// __cpu_pdep(): есть ли BMI2 с быстрым PDEP — у Intel всегда (3 такта с
// Haswell), у AMD — с Zen 3 (семейство 19h): до него PDEP микрокодом и медленнее
// побитового цикла. → уровень SIMD 3 (lib/rt.kh).
fn emit_cpu_pdep() {
    // push rbx; xor eax, eax; cpuid; cmp eax, 7; jb .no; mov r8d, ebx (производитель);
    // mov eax, 1; cpuid; mov r9d, eax (семейство); mov eax, 7; xor ecx, ecx; cpuid;
    // test ebx, 1 << 8 (BMI2); jz .no
    emit_hex("53 31 C0 0F A2 83 F8 07 72 48 41 89 D8 B8 01 00 00 00 0F A2 41 89 C1")
    emit_hex("B8 07 00 00 00 31 C9 0F A2 F7 C3 00 01 00 00 74 2A")
    // cmp r8d, "Genu"; je .yes; cmp r8d, "Auth"; jne .no; расширенное семейство:
    // shr r9d, 20; and r9d, 0xFF; cmp r9d, 0Ah; jb .no
    emit_hex("41 81 F8 47 65 6E 75 74 1A 41 81 F8 41 75 74 68 75 18")
    emit_hex("41 C1 E9 14 41 81 E1 FF 00 00 00 41 83 F9 0A 72 07")
    // .yes: mov eax, 1; jmp .done; .no: xor eax, eax; .done: pop rbx
    emit_hex("B8 01 00 00 00 EB 02 31 C0 5B")
}

// ---- SHA-256 на инструкциях SHA-NI ----

// __cpu_sha(): есть ли SHA-NI (cpuid 7: ebx бит 29) и SSSE3 + SSE4.1 (cpuid 1:
// ecx биты 9 и 19), нужные для перестановок состояния.
fn emit_cpu_sha() {
    // push rbx; mov eax, 1; xor ecx, ecx; cpuid
    emit_hex("53 B8 01 00 00 00 31 C9 0F A2")
    // and ecx, (1 << 19) | (1 << 9); cmp ecx, то же
    emit_hex("81 E1 00 02 08 00 81 F9 00 02 08 00")
    let no = emit_jcc(CC_NE)
    // mov eax, 7; xor ecx, ecx; cpuid; test ebx, 1 << 29
    emit_hex("B8 07 00 00 00 31 C9 0F A2 F7 C3 00 00 00 20")
    emit_setcc(CC_NE)
    let done = emit_jmp()
    patch_here(no)
    emit_hex("31 C0")
    patch_here(done)
    emit8(0x5B)
}

// Инструкция над xmm-регистрами 0–7: префикс и код, затем ModRM «регистр-регистр».
fn sse_rr(op: str, dst: int, src: int) {
    emit_hex(op)
    emit8(0xC0 + dst * 8 + src)
}

// То же с непосредственным байтом.
fn sse_rri(op: str, dst: int, src: int, imm: int) {
    sse_rr(op, dst, src)
    emit8(imm)
}

// movdqu xmm, [base + disp] — base: 2 (rdx), 6 (rsi), 7 (rdi).
fn sse_load(dst: int, base: int, disp: int) {
    emit_hex("F3 0F 6F")
    emit8(0x80 + dst * 8 + base)
    emit32(disp)
}

fn sse_store(base: int, disp: int, src: int) {
    emit_hex("F3 0F 7F")
    emit8(0x80 + src * 8 + base)
    emit32(disp)
}

// __simd_sha256(state, block, k): один 64-байтовый блок. rdi — состояние (8 слов
// по 32 бита, a — первым), rsi — блок, rdx — 64 константы K по 32 бита и за ними
// маска pshufb для перестановки байтов слова. Схема — как у Intel и в ядре Linux
// (arch/x86/crypto/sha256_ni_asm.S): xmm1 = ABEF, xmm2 = CDGH, xmm0 — слова
// сообщения плюс K, xmm3–xmm6 — расписание сообщения, xmm7 — маска, потом
// временный. Исходное состояние на время раундов — в стеке.
fn emit_sha256_ni() {
    let movdqa = "66 0F 6F"
    let pshufd = "66 0F 70"
    let palignr = "66 0F 3A 0F"
    let pblendw = "66 0F 3A 0E"
    let pshufb = "66 0F 38 00"
    let paddd = "66 0F FE"
    let punpckhqdq = "66 0F 6D"
    let rnds2 = "0F 38 CB"
    let msg1 = "0F 38 CC"
    let msg2 = "0F 38 CD"
    // состояние: DCBA, HGFE → ABEF, CDGH
    sse_load(1, 7, 0)
    sse_load(2, 7, 16)
    sse_rri(pshufd, 1, 1, 0xB1)
    sse_rri(pshufd, 2, 2, 0x1B)
    sse_rr(movdqa, 7, 1)
    sse_rri(palignr, 1, 2, 8)
    sse_rri(pblendw, 2, 7, 0xF0)
    // sub rsp, 32; movdqu [rsp], xmm1; movdqu [rsp + 16], xmm2
    emit_hex("48 83 EC 20 F3 0F 7F 0C 24 F3 0F 7F 54 24 10")
    sse_load(7, 2, 256)
    var i = 0
    while i < 64 {
        // m0..m3 — xmm3..xmm6 по кругу
        let m0 = 3 + (i / 4) % 4
        let m1 = 3 + (i / 4 + 1) % 4
        let m3 = 3 + (i / 4 + 3) % 4
        if i < 16 {
            sse_load(m0, 6, i * 4)
            sse_rr(pshufb, m0, 7)
        }
        sse_load(0, 2, i * 4)
        sse_rr(paddd, 0, m0)
        sse_rr(rnds2, 2, 1)
        if i >= 12 && i < 60 {
            sse_rr(movdqa, 7, m0)
            sse_rri(palignr, 7, m3, 4)
            sse_rr(paddd, m1, 7)
            sse_rr(msg2, m1, m0)
        }
        sse_rr(punpckhqdq, 0, 0)
        sse_rr(rnds2, 1, 2)
        if i >= 4 && i < 52 {
            sse_rr(msg1, m3, m0)
        }
        i += 4
    }
    // прибавить исходное состояние: movdqu xmm0, [rsp]; movdqu xmm7, [rsp + 16]
    emit_hex("F3 0F 6F 04 24 F3 0F 6F 7C 24 10 48 83 C4 20")
    sse_rr(paddd, 1, 0)
    sse_rr(paddd, 2, 7)
    // ABEF, CDGH → DCBA, HGFE
    sse_rri(pshufd, 1, 1, 0x1B)
    sse_rri(pshufd, 2, 2, 0xB1)
    sse_rr(movdqa, 7, 1)
    sse_rri(pblendw, 1, 2, 0xF0)
    sse_rri(palignr, 2, 7, 8)
    sse_store(7, 0, 1)
    sse_store(7, 16, 2)
}

// ---- SHA-256 без SHA-NI: свой машинный код ----
// 32-битные операции «r/m, r»: 0x89 mov, 0x01 add, 0x31 xor, 0x21 and, 0x09 or.

fn x_rr(op: int, dst: int, src: int) {
    let rex = ((src >> 3) << 2) | (dst >> 3)
    if rex != 0 {
        emit8(0x40 | rex)
    }
    emit8(op)
    emit8(0xC0 | ((src & 7) << 3) | (dst & 7))
}

// ror/shr r32, n (ext: 1 — ror, 5 — shr)
fn x_shift(ext: int, reg: int, n: int) {
    if reg >= 8 {
        emit8(0x41)
    }
    emit8(0xC1)
    emit8(0xC0 | (ext << 3) | (reg & 7))
    emit8(n)
}

// op reg, [rsp + disp] (op: 0x8B mov в регистр, 0x03 add) или 0x89 — в память.
fn x_rsp(op: int, reg: int, disp: int) {
    if reg >= 8 {
        emit8(0x44)
    }
    emit8(op)
    if disp < 128 {
        emit8(0x44 | ((reg & 7) << 3))
        emit8(0x24)
        emit8(disp)
    } else {
        emit8(0x84 | ((reg & 7) << 3))
        emit8(0x24)
        emit32(disp)
    }
}

// add reg, [base + rsi + disp8] (sib: 0x34 — rsp, 0x32 — rdx)
fn x_add_idx(reg: int, sib: int, disp: int) {
    if reg >= 8 {
        emit8(0x44)
    }
    emit8(0x03)
    emit8(0x44 | ((reg & 7) << 3))
    emit8(sib)
    emit8(disp)
}

// Один 64-байтовый блок: rdi — состояние (8 слов по 32 бита), rsi — блок,
// rdx — константы K. Состояние a..h — в r8d..r15d, расписание W[64] — на стеке;
// раунды развёрнуты по 8: роли регистров сдвигаются, а не переписываются.
fn emit_sha256_x64() {
    let eax = 0
    let ecx = 1
    let ebx = 3
    let ebp = 5
    // push rbx, rbp, r12–r15, rdi; sub rsp, 256
    emit_hex("53 55 41 54 41 55 41 56 41 57 57 48 81 EC 00 01 00 00")
    for i in 0..16 {
        // mov eax, [rsi + 4i]; bswap eax; mov [rsp + 4i], eax
        emit8(0x8B)
        emit8(0x46)
        emit8(i * 4)
        emit_hex("0F C8")
        x_rsp(0x89, eax, i * 4)
    }
    for i in 16..64 {
        // s0 = ror(x, 7) ^ ror(x, 18) ^ (x >> 3), x = W[i - 15]
        x_rsp(0x8B, eax, (i - 15) * 4)
        x_rr(0x89, ecx, eax)
        x_rr(0x89, ebx, eax)
        x_shift(1, eax, 7)
        x_shift(1, ecx, 18)
        x_rr(0x31, eax, ecx)
        x_shift(5, ebx, 3)
        x_rr(0x31, eax, ebx)
        // s1 = ror(y, 17) ^ ror(y, 19) ^ (y >> 10), y = W[i - 2]
        x_rsp(0x8B, ecx, (i - 2) * 4)
        x_rr(0x89, ebx, ecx)
        x_rr(0x89, ebp, ecx)
        x_shift(1, ecx, 17)
        x_shift(1, ebx, 19)
        x_rr(0x31, ecx, ebx)
        x_shift(5, ebp, 10)
        x_rr(0x31, ecx, ebp)
        x_rr(0x01, eax, ecx)
        x_rsp(0x03, eax, (i - 16) * 4)
        x_rsp(0x03, eax, (i - 7) * 4)
        x_rsp(0x89, eax, i * 4)
    }
    // mov r8d..r15d, [rdi + 4r]
    for r in 0..8 {
        emit8(0x44)
        emit8(0x8B)
        emit8(0x47 | (r << 3))
        emit8(r * 4)
    }
    // xor esi, esi: смещение раунда в W и K
    emit_hex("31 F6")
    let top = code_len
    for j in 0..8 {
        let a = 8 + (8 - j) % 8
        let b = 8 + (9 - j) % 8
        let c = 8 + (10 - j) % 8
        let d = 8 + (11 - j) % 8
        let e = 8 + (12 - j) % 8
        let f = 8 + (13 - j) % 8
        let g = 8 + (14 - j) % 8
        let h = 8 + (15 - j) % 8
        // h += S1(e) + ch(e, f, g) + K[i] + W[i]
        x_rr(0x89, eax, e)
        x_rr(0x89, ecx, e)
        x_shift(1, eax, 6)
        x_shift(1, ecx, 11)
        x_rr(0x31, eax, ecx)
        x_shift(1, ecx, 14)
        x_rr(0x31, eax, ecx)
        x_rr(0x89, ecx, f)
        x_rr(0x31, ecx, g)
        x_rr(0x21, ecx, e)
        x_rr(0x31, ecx, g)
        x_rr(0x01, h, eax)
        x_rr(0x01, h, ecx)
        x_add_idx(h, 0x32, j * 4)
        x_add_idx(h, 0x34, j * 4)
        x_rr(0x01, d, h)
        // h += S0(a) + maj(a, b, c)
        x_rr(0x89, eax, a)
        x_rr(0x89, ecx, a)
        x_shift(1, eax, 2)
        x_shift(1, ecx, 13)
        x_rr(0x31, eax, ecx)
        x_shift(1, ecx, 9)
        x_rr(0x31, eax, ecx)
        x_rr(0x89, ecx, a)
        x_rr(0x09, ecx, b)
        x_rr(0x21, ecx, c)
        x_rr(0x89, ebx, a)
        x_rr(0x21, ebx, b)
        x_rr(0x09, ecx, ebx)
        x_rr(0x01, h, eax)
        x_rr(0x01, h, ecx)
    }
    // add rsi, 32; cmp rsi, 256; jne top
    emit_hex("48 83 C6 20 48 81 FE 00 01 00 00")
    emit_jcc_to(CC_NE, top)
    // mov rdi, [rsp + 256]; add [rdi + 4r], r8d..r15d
    emit_hex("48 8B BC 24 00 01 00 00")
    for r in 0..8 {
        emit8(0x44)
        emit8(0x01)
        emit8(0x47 | (r << 3))
        emit8(r * 4)
    }
    // add rsp, 264; pop r15–r12, rbp, rbx
    emit_hex("48 81 C4 08 01 00 00 41 5F 41 5E 41 5D 41 5C 5D 5B")
}

// ---- SHA-512 (и SHA-384): тот же приём на 64-битных регистрах ----

// 64-битная операция «r/m, r» (0x89 mov, 0x01 add, 0x31 xor, 0x21 and, 0x09 or).
fn q_rr(op: int, dst: int, src: int) {
    emit8(0x48 | ((src >> 3) << 2) | (dst >> 3))
    emit8(op)
    emit8(0xC0 | ((src & 7) << 3) | (dst & 7))
}

// ror/shr r64, n (ext: 1 — ror, 5 — shr)
fn q_shift(ext: int, reg: int, n: int) {
    emit8(0x48 | (reg >> 3))
    emit8(0xC1)
    emit8(0xC0 | (ext << 3) | (reg & 7))
    emit8(n)
}

// op reg, [rsp + disp] (0x8B — в регистр, 0x03 — add) или 0x89 — в память.
fn q_rsp(op: int, reg: int, disp: int) {
    emit8(0x48 | ((reg >> 3) << 2))
    emit8(op)
    if disp < 128 {
        emit8(0x44 | ((reg & 7) << 3))
        emit8(0x24)
        emit8(disp)
    } else {
        emit8(0x84 | ((reg & 7) << 3))
        emit8(0x24)
        emit32(disp)
    }
}

// add reg, [base + rsi + disp8] (sib: 0x34 — rsp, 0x32 — rdx)
fn q_add_idx(reg: int, sib: int, disp: int) {
    emit8(0x48 | ((reg >> 3) << 2))
    emit8(0x03)
    emit8(0x44 | ((reg & 7) << 3))
    emit8(sib)
    emit8(disp)
}

// Один 128-байтовый блок: rdi — состояние (8 слов по 64 бита), rsi — блок,
// rdx — константы K (80 слов). a..h — в r8..r15, W[80] — на стеке.
fn emit_sha512_x64() {
    let rax = 0
    let rcx = 1
    let rbx = 3
    let rbp = 5
    // push rbx, rbp, r12–r15, rdi; sub rsp, 640
    emit_hex("53 55 41 54 41 55 41 56 41 57 57 48 81 EC 80 02 00 00")
    for i in 0..16 {
        // mov rax, [rsi + 8i]; bswap rax; mov [rsp + 8i], rax
        emit_hex("48 8B 46")
        emit8(i * 8)
        emit_hex("48 0F C8")
        q_rsp(0x89, rax, i * 8)
    }
    for i in 16..80 {
        // s0 = ror(x, 1) ^ ror(x, 8) ^ (x >> 7), x = W[i - 15]
        q_rsp(0x8B, rax, (i - 15) * 8)
        q_rr(0x89, rcx, rax)
        q_rr(0x89, rbx, rax)
        q_shift(1, rax, 1)
        q_shift(1, rcx, 8)
        q_rr(0x31, rax, rcx)
        q_shift(5, rbx, 7)
        q_rr(0x31, rax, rbx)
        // s1 = ror(y, 19) ^ ror(y, 61) ^ (y >> 6), y = W[i - 2]
        q_rsp(0x8B, rcx, (i - 2) * 8)
        q_rr(0x89, rbx, rcx)
        q_rr(0x89, rbp, rcx)
        q_shift(1, rcx, 19)
        q_shift(1, rbx, 61)
        q_rr(0x31, rcx, rbx)
        q_shift(5, rbp, 6)
        q_rr(0x31, rcx, rbp)
        q_rr(0x01, rax, rcx)
        q_rsp(0x03, rax, (i - 16) * 8)
        q_rsp(0x03, rax, (i - 7) * 8)
        q_rsp(0x89, rax, i * 8)
    }
    // mov r8..r15, [rdi + 8r]
    for r in 0..8 {
        emit8(0x4C)
        emit8(0x8B)
        emit8(0x47 | (r << 3))
        emit8(r * 8)
    }
    // xor esi, esi: смещение раунда в W и K
    emit_hex("31 F6")
    let top = code_len
    for j in 0..8 {
        let a = 8 + (8 - j) % 8
        let b = 8 + (9 - j) % 8
        let c = 8 + (10 - j) % 8
        let d = 8 + (11 - j) % 8
        let e = 8 + (12 - j) % 8
        let f = 8 + (13 - j) % 8
        let g = 8 + (14 - j) % 8
        let h = 8 + (15 - j) % 8
        // h += S1(e) + ch(e, f, g) + K[i] + W[i]
        q_rr(0x89, rax, e)
        q_rr(0x89, rcx, e)
        q_shift(1, rax, 14)
        q_shift(1, rcx, 18)
        q_rr(0x31, rax, rcx)
        q_shift(1, rcx, 23)
        q_rr(0x31, rax, rcx)
        q_rr(0x89, rcx, f)
        q_rr(0x31, rcx, g)
        q_rr(0x21, rcx, e)
        q_rr(0x31, rcx, g)
        q_rr(0x01, h, rax)
        q_rr(0x01, h, rcx)
        q_add_idx(h, 0x32, j * 8)
        q_add_idx(h, 0x34, j * 8)
        q_rr(0x01, d, h)
        // h += S0(a) + maj(a, b, c)
        q_rr(0x89, rax, a)
        q_rr(0x89, rcx, a)
        q_shift(1, rax, 28)
        q_shift(1, rcx, 34)
        q_rr(0x31, rax, rcx)
        q_shift(1, rcx, 5)
        q_rr(0x31, rax, rcx)
        q_rr(0x89, rcx, a)
        q_rr(0x09, rcx, b)
        q_rr(0x21, rcx, c)
        q_rr(0x89, rbx, a)
        q_rr(0x21, rbx, b)
        q_rr(0x09, rcx, rbx)
        q_rr(0x01, h, rax)
        q_rr(0x01, h, rcx)
    }
    // add rsi, 64; cmp rsi, 640; jne top
    emit_hex("48 83 C6 40 48 81 FE 80 02 00 00")
    emit_jcc_to(CC_NE, top)
    // mov rdi, [rsp + 640]; add [rdi + 8r], r8..r15
    emit_hex("48 8B BC 24 80 02 00 00")
    for r in 0..8 {
        emit8(0x4C)
        emit8(0x01)
        emit8(0x47 | (r << 3))
        emit8(r * 8)
    }
    // add rsp, 648; pop r15–r12, rbp, rbx
    emit_hex("48 81 C4 88 02 00 00 41 5F 41 5E 41 5D 41 5C 5D 5B")
}

// ---- AES-NI, PCLMULQDQ и ChaCha20 для TLS ----

// __cpu_aes(): есть ли AES-NI, PCLMULQDQ и SSSE3 (cpuid 1: ecx биты 25, 1, 9).
fn emit_cpu_aes() {
    // push rbx; mov eax, 1; xor ecx, ecx; cpuid
    emit_hex("53 B8 01 00 00 00 31 C9 0F A2")
    // and ecx, маска; cmp ecx, маска; sete al; movzx eax, al; pop rbx
    emit_hex("81 E1 02 02 00 02 81 F9 02 02 00 02")
    emit_setcc(CC_E)
    emit8(0x5B)
}

// __aes_ctr(ключи, 16 × раундов, счётчик, откуда, куда, блоков): AES в режиме
// счётчика. rdi — ключи раундов подряд, rsi — смещение последнего, rdx —
// 16 байт счётчика (последние 4 — номер блока старшими байтами вперёд; растёт
// на месте), rcx — открытый текст, r8 — результат, r9 — число блоков.
fn emit_aes_ctr() {
    // test r9, r9; jz конец
    emit_hex("4D 85 C9")
    let skip = emit_jcc(CC_E)
    let top = code_len
    // movdqu xmm0, [rdx]; movdqu xmm1, [rdi]; pxor xmm0, xmm1; mov eax, 16
    emit_hex("F3 0F 6F 02 F3 0F 6F 0F 66 0F EF C1 B8 10 00 00 00")
    let inner = code_len
    // movdqu xmm1, [rdi + rax]; aesenc xmm0, xmm1; add eax, 16; cmp rax, rsi; jb inner
    emit_hex("F3 0F 6F 0C 07 66 0F 38 DC C1 83 C0 10 48 39 F0 72")
    emit8((inner - (code_len + 1)) & 255)
    // movdqu xmm1, [rdi + rsi]; aesenclast xmm0, xmm1
    emit_hex("F3 0F 6F 0C 37 66 0F 38 DD C1")
    // movdqu xmm1, [rcx]; pxor xmm0, xmm1; movdqu [r8], xmm0
    emit_hex("F3 0F 6F 09 66 0F EF C1 F3 41 0F 7F 00")
    // счётчик + 1: mov eax, [rdx + 12]; bswap eax; inc eax; bswap eax; mov [rdx + 12], eax
    emit_hex("8B 42 0C 0F C8 FF C0 0F C8 89 42 0C")
    // add rcx, 16; add r8, 16; dec r9; jnz top
    emit_hex("48 83 C1 10 49 83 C0 10 49 FF C9")
    emit_jcc_to(CC_NE, top)
    patch_here(skip)
}

// xmm0 = xmm0 · xmm5 в GF(2^128) для GHASH. Оба значения — с переставленными
// байтами (pshufb); схема — из статьи Intel «Carry-Less Multiplication
// Instruction and its Usage for Computing the GCM Mode» (функция gfmul).
// Временные: xmm1–xmm4, xmm7.
fn emit_gfmul() {
    let movdqa = "66 0F 6F"
    let pclmul = "66 0F 3A 44"
    let pxor = "66 0F EF"
    let por = "66 0F EB"
    let dq = "66 0F 73"
    let d = "66 0F 72"
    sse_rr(movdqa, 1, 0)
    sse_rri(pclmul, 1, 5, 0x00)
    sse_rr(movdqa, 2, 0)
    sse_rri(pclmul, 2, 5, 0x10)
    sse_rr(movdqa, 3, 0)
    sse_rri(pclmul, 3, 5, 0x01)
    sse_rr(movdqa, 4, 0)
    sse_rri(pclmul, 4, 5, 0x11)
    sse_rr(pxor, 2, 3)
    sse_rr(movdqa, 3, 2)
    sse_rri(dq, 7, 3, 8)
    sse_rri(dq, 3, 2, 8)
    sse_rr(pxor, 1, 3)
    sse_rr(pxor, 4, 2)
    // произведение [xmm4:xmm1] сдвинуть на бит влево
    sse_rr(movdqa, 7, 1)
    sse_rri(d, 2, 7, 31)
    sse_rr(movdqa, 2, 4)
    sse_rri(d, 2, 2, 31)
    sse_rri(d, 6, 1, 1)
    sse_rri(d, 6, 4, 1)
    sse_rr(movdqa, 3, 7)
    sse_rri(dq, 3, 3, 12)
    sse_rri(dq, 7, 2, 4)
    sse_rri(dq, 7, 7, 4)
    sse_rr(por, 1, 7)
    sse_rr(por, 4, 2)
    sse_rr(por, 4, 3)
    // приведение по модулю x^128 + x^7 + x^2 + x + 1
    sse_rr(movdqa, 7, 1)
    sse_rri(d, 6, 7, 31)
    sse_rr(movdqa, 2, 1)
    sse_rri(d, 6, 2, 30)
    sse_rr(movdqa, 3, 1)
    sse_rri(d, 6, 3, 25)
    sse_rr(pxor, 7, 2)
    sse_rr(pxor, 7, 3)
    sse_rr(movdqa, 2, 7)
    sse_rri(dq, 3, 2, 4)
    sse_rri(dq, 7, 7, 12)
    sse_rr(pxor, 1, 7)
    sse_rr(movdqa, 3, 1)
    sse_rri(d, 2, 3, 1)
    sse_rr(movdqa, 7, 1)
    sse_rri(d, 2, 7, 2)
    sse_rr(movdqa, 0, 1)
    sse_rri(d, 2, 0, 7)
    sse_rr(pxor, 3, 7)
    sse_rr(pxor, 3, 0)
    sse_rr(pxor, 3, 2)
    sse_rr(pxor, 1, 3)
    sse_rr(pxor, 4, 1)
    sse_rr(movdqa, 0, 4)
}

// __ghash(ключ, x, данные, блоков): x = (x ^ блок) · H по всем блокам. rdi —
// H с переставленными байтами и за ним маска pshufb, rsi — 16 байт x (на месте),
// rdx — данные, rcx — число блоков.
fn emit_ghash() {
    // test rcx, rcx; jz конец
    emit_hex("48 85 C9")
    let skip = emit_jcc(CC_E)
    // movdqu xmm6, [rdi + 16]; movdqu xmm5, [rdi]; movdqu xmm0, [rsi]; pshufb xmm0, xmm6
    emit_hex("F3 0F 6F 77 10 F3 0F 6F 2F F3 0F 6F 06 66 0F 38 00 C6")
    let top = code_len
    // movdqu xmm1, [rdx]; pshufb xmm1, xmm6; pxor xmm0, xmm1
    emit_hex("F3 0F 6F 0A 66 0F 38 00 CE 66 0F EF C1")
    emit_gfmul()
    // add rdx, 16; dec rcx; jnz top
    emit_hex("48 83 C2 10 48 FF C9")
    emit_jcc_to(CC_NE, top)
    // pshufb xmm0, xmm6; movdqu [rsi], xmm0
    emit_hex("66 0F 38 00 C6 F3 0F 7F 06")
    patch_here(skip)
}

// Поворот 32-битных слов xmm-регистра reg влево на n (xmm4 — временный).
fn sse_rotl(reg: int, n: int) {
    sse_rr("66 0F 6F", 4, reg)
    sse_rri("66 0F 72", 6, reg, n)
    sse_rri("66 0F 72", 2, 4, 32 - n)
    sse_rr("66 0F EB", reg, 4)
}

// Четверть раунда ChaCha20 сразу для четырёх столбцов (строки — xmm0–xmm3).
fn chacha_quarter() {
    let paddd = "66 0F FE"
    let pxor = "66 0F EF"
    sse_rr(paddd, 0, 1)
    sse_rr(pxor, 3, 0)
    sse_rotl(3, 16)
    sse_rr(paddd, 2, 3)
    sse_rr(pxor, 1, 2)
    sse_rotl(1, 12)
    sse_rr(paddd, 0, 1)
    sse_rr(pxor, 3, 0)
    sse_rotl(3, 8)
    sse_rr(paddd, 2, 3)
    sse_rr(pxor, 1, 2)
    sse_rotl(1, 7)
}

// __chacha_block(состояние, куда): 64 байта ключевого потока ChaCha20 по
// состоянию из 16 слов (rdi), в rsi. Строки состояния — в xmm0–xmm3; диагонали
// получаются сдвигом строк (pshufd), как в известных реализациях на SSE2.
fn emit_chacha_block() {
    let pshufd = "66 0F 70"
    emit_hex("F3 0F 6F 07 F3 0F 6F 4F 10 F3 0F 6F 57 20 F3 0F 6F 5F 30")
    // mov eax, 10
    emit_hex("B8 0A 00 00 00")
    let top = code_len
    chacha_quarter()
    sse_rri(pshufd, 1, 1, 0x39)
    sse_rri(pshufd, 2, 2, 0x4E)
    sse_rri(pshufd, 3, 3, 0x93)
    chacha_quarter()
    sse_rri(pshufd, 1, 1, 0x93)
    sse_rri(pshufd, 2, 2, 0x4E)
    sse_rri(pshufd, 3, 3, 0x39)
    // dec eax; jnz top
    emit_hex("FF C8")
    emit_jcc_to(CC_NE, top)
    // прибавить исходное состояние и записать: movdqu xmm4, [rdi + 16i]; paddd; movdqu [rsi + 16i]
    for i in 0..4 {
        emit_hex("F3 0F 6F 67")
        emit8(i * 16)
        sse_rr("66 0F FE", i, 4)
        emit_hex("F3 0F 7F")
        emit8(0x46 + i * 8)
        emit8(i * 16)
    }
}

// ---- Длинная арифметика: части по 64 бита, младшие первыми ----

// Короткий переход назад (jcc rel8) на метку target.
fn emit_jcc8_back(cc: int, target: int) {
    emit8(0x70 + cc)
    emit8((target - (code_len + 1)) & 255)
}

// __mp_add(r, a, b, n) / __mp_sub: r = a ± b по n частям, → перенос (заём).
// rdi — r, rsi — a, rdx — b, rcx — n (больше 0). op: 0x13 adc, 0x1B sbb.
fn emit_mp_addsub(op: int) {
    // xor r8d, r8d (заодно CF = 0)
    emit_hex("45 31 C0")
    let top = code_len
    // mov rax, [rsi + r8*8]; adc/sbb rax, [rdx + r8*8]; mov [rdi + r8*8], rax
    emit_hex("4A 8B 04 C6 4A")
    emit8(op)
    emit_hex("04 C2 4A 89 04 C7")
    // inc r8; dec rcx; jnz top (inc и dec не трогают CF)
    emit_hex("49 FF C0 48 FF C9")
    emit_jcc8_back(CC_NE, top)
    emit_setcc(CC_B)
}

// __mont_mul(r, a, b, m, n, minv): r = a · b · 2^(-64n) mod m с точностью до
// одного вычитания m (r — n + 1 частей, верхняя 0 или 1; дальше — в lib/pk.kh).
// Схема CIOS (Koç, Acar, Kaliski, 1996); minv = -m^(-1) mod 2^64. rdi — r,
// rsi — a, rdx — b (уходит в r10), rcx — m, r8 — n (не меньше 2), r9 — minv.
// Промежуточное t (n + 2 частей) — на стеке, r15 — его адрес.
fn emit_mont_mul() {
    // push rbx, rbp, r12–r15; mov r10, rdx
    emit_hex("53 55 41 54 41 55 41 56 41 57 49 89 D2")
    // rax = (8n + 31) & -16; sub rsp, rax; mov rbp, rax
    emit_hex("4A 8D 04 C5 1F 00 00 00 48 83 E0 F0 48 29 C4 48 89 C5")
    // t = 0: xor eax, eax; xor r11d, r11d; lea rbx, [r8 + 2]
    emit_hex("31 C0 45 31 DB 49 8D 58 02")
    let zero = code_len
    // mov [rsp + r11*8], rax; inc r11; cmp r11, rbx; jb zero
    emit_hex("4A 89 04 DC 49 FF C3 49 39 DB")
    emit_jcc8_back(CC_B, zero)
    // mov r15, rsp; xor r11d, r11d
    emit_hex("49 89 E7 45 31 DB")
    let outer = code_len
    // r13 = a[i]; r14 = 0 (перенос); r12 = 0 (j)
    emit_hex("4E 8B 2C DE 45 31 F6 45 31 E4")
    let inner1 = code_len
    // t[j] += b[j] · a[i] + перенос
    // mov rax, [r10 + r12*8]; mul r13; add rax, r14; adc rdx, 0
    emit_hex("4B 8B 04 E2 49 F7 E5 4C 01 F0 48 83 D2 00")
    // add rax, [r15 + r12*8]; adc rdx, 0; mov [r15 + r12*8], rax; mov r14, rdx
    emit_hex("4B 03 04 E7 48 83 D2 00 4B 89 04 E7 49 89 D6")
    // inc r12; cmp r12, r8; jb inner1
    emit_hex("49 FF C4 4D 39 C4")
    emit_jcc8_back(CC_B, inner1)
    // t[n] += перенос; t[n + 1] += CF
    emit_hex("4F 01 34 C7 4B 83 54 C7 08 00")
    // r13 = t[0] · minv (младшие 64 бита)
    emit_hex("4D 8B 2F 4D 0F AF E9")
    // t[0] + m[0] · r13: младшая часть обнуляется, остаётся перенос
    // mov rax, [rcx]; mul r13; add rax, [r15]; adc rdx, 0; mov r14, rdx; mov r12d, 1
    emit_hex("48 8B 01 49 F7 E5 49 03 07 48 83 D2 00 49 89 D6 41 BC 01 00 00 00")
    let inner2 = code_len
    // t[j - 1] = t[j] + m[j] · r13 + перенос
    // mov rax, [rcx + r12*8]; mul r13; add rax, r14; adc rdx, 0
    emit_hex("4A 8B 04 E1 49 F7 E5 4C 01 F0 48 83 D2 00")
    // add rax, [r15 + r12*8]; adc rdx, 0; mov [r15 + r12*8 - 8], rax; mov r14, rdx
    emit_hex("4B 03 04 E7 48 83 D2 00 4B 89 44 E7 F8 49 89 D6")
    // inc r12; cmp r12, r8; jb inner2
    emit_hex("49 FF C4 4D 39 C4")
    emit_jcc8_back(CC_B, inner2)
    // t[n - 1] = t[n] + перенос; t[n] = t[n + 1] + CF; t[n + 1] = 0
    emit_hex("4B 8B 04 C7 4C 01 F0 4B 89 44 C7 F8 4B 8B 44 C7 08 48 83 D0 00 4B 89 04 C7")
    emit_hex("4B C7 44 C7 08 00 00 00 00")
    // inc r11; cmp r11, r8; jb outer
    emit_hex("49 FF C3 4D 39 C3")
    emit_jcc_to(CC_B, outer)
    // r = t - m (по n частям): xor r11d, r11d; mov rbx, r8 (счётчик, dec не трогает CF)
    emit_hex("45 31 DB 4C 89 C3")
    let sub = code_len
    // mov rax, [r15 + r11*8]; sbb rax, [rcx + r11*8]; mov [rdi + r11*8], rax; inc r11; dec rbx; jnz sub
    emit_hex("4B 8B 04 DF 4A 1B 04 D9 4A 89 04 DF 49 FF C3 48 FF CB")
    emit_jcc8_back(CC_NE, sub)
    // оставить t, если был заём и t[n] = 0: маска rax = -(заём) & -(t[n] ^ 1)
    // sbb rax, rax; mov rdx, [r15 + r8*8]; xor rdx, 1; neg rdx; and rax, rdx
    emit_hex("48 19 C0 4B 8B 14 C7 48 83 F2 01 48 F7 DA 48 21 D0")
    // r[i] ^= (r[i] ^ t[i]) & маска: xor r11d, r11d
    emit_hex("45 31 DB")
    let sel = code_len
    // mov rdx, [rdi + r11*8]; mov rbx, [r15 + r11*8]; xor rbx, rdx; and rbx, rax; xor rdx, rbx; mov [rdi + r11*8], rdx
    emit_hex("4A 8B 14 DF 4B 8B 1C DF 48 31 D3 48 21 C3 48 31 DA 4A 89 14 DF")
    // inc r11; cmp r11, r8; jb sel
    emit_hex("49 FF C3 4D 39 C3")
    emit_jcc8_back(CC_B, sel)
    // add rsp, rbp; pop r15–r12, rbp, rbx
    emit_hex("48 01 EC 41 5F 41 5E 41 5D 41 5C 5D 5B")
}

// __mod_add(r, a, b, m, n): r = a + b mod m; __mod_sub: r = a - b mod m
// (a, b < m). rdi — r, rsi — a, rdx — b, rcx — m, r8 — n. Без временной памяти:
// сложение, вычитание m и обратное прибавление m под маской.
fn emit_mod_addsub(add: bool) {
    // xor r9d, r9d; mov r10, r8
    emit_hex("45 31 C9 4D 89 C2")
    let l1 = code_len
    // mov rax, [rsi + r9*8]; adc/sbb rax, [rdx + r9*8]; mov [rdi + r9*8], rax; inc r9; dec r10; jnz l1
    emit_hex("4A 8B 04 CE 4A")
    if add {
        emit8(0x13)
    } else {
        emit8(0x1B)
    }
    emit_hex("04 CA 4A 89 04 CF 49 FF C1 49 FF CA")
    emit_jcc8_back(CC_NE, l1)
    // r11 = -(перенос или заём)
    emit_hex("4D 19 DB")
    if add {
        // r -= m; маска = -(заём) & ~(-перенос): вернуть m, если вычитать было не нужно
        emit_hex("45 31 C9 4D 89 C2")
        let l2 = code_len
        // mov rax, [rdi + r9*8]; sbb rax, [rcx + r9*8]; mov [rdi + r9*8], rax; inc r9; dec r10; jnz l2
        emit_hex("4A 8B 04 CF 4A 1B 04 C9 4A 89 04 CF 49 FF C1 49 FF CA")
        emit_jcc8_back(CC_NE, l2)
        // sbb rax, rax; not r11; and r11, rax
        emit_hex("48 19 C0 49 F7 D3 49 21 C3")
    }
    // r += m & r11; перенос — в rdx: and сбрасывает CF, поэтому adc по цепочке нельзя.
    // xor edx, edx; xor r9d, r9d; mov r10, r8
    emit_hex("31 D2 45 31 C9 4D 89 C2")
    let l3 = code_len
    // mov rax, [rcx + r9*8]; and rax, r11; add rax, rdx; setc dl; movzx edx, dl
    emit_hex("4A 8B 04 C9 4C 21 D8 48 01 D0 0F 92 C2 0F B6 D2")
    // add [rdi + r9*8], rax; adc rdx, 0; inc r9; dec r10; jnz l3
    emit_hex("4A 01 04 CF 48 83 D2 00 49 FF C1 49 FF CA")
    emit_jcc8_back(CC_NE, l3)
}

