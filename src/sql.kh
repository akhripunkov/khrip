// ============================================================================
// sql "...": запрос к PostgreSQL. Текст запроса, параметры и ожидаемая форма
// результата становятся местом запроса (site) в данных программы; рантайм
// (lib/db.kh) при запуске сверяет каждое место с базой (Parse + Describe), а
// потом выполняет запрос и раскладывает строки по ожидаемому типу.
//
// {выражение} — всегда параметр ($n), никогда не текст SQL. Компилятор
// переписывает привычные формы: {x} IS NULL — отдельный параметр bool;
// IN ({список}) — = ANY($n); INSERT INTO t {s} и SET {s} — поля структуры;
// '%{q}%' — сцепление с параметром (в LIKE его % и _ экранируются).
// ============================================================================

// Форма результата — из ожидаемого типа.
const SH_COUNT = 0
const SH_ONE = 1
const SH_OPT = 2
const SH_LIST = 3

// Виды параметров (по 4 слова: вид, описание типа, номер значения, номер поля).
const PK_VAL = 1
const PK_ISNULL = 2
const PK_LIKE = 3
const PK_TEXT = 4
const PK_FIELD = 5
const PK_COLUMN = 6
// поле T? задано: есть значение или в JSON пришёл явный null
const PK_GIVEN = 7

// Слова места запроса: см. lib/db.kh (SITE_*).
const SITE_WORDS = 24
// слово места: таблица вариантов ORDER BY {o}
const SITE_W_VARIANTS = 14
// слово места: ключи строк для очереди повторов tx (sql_row_keys)
const SITE_W_KEYS = 15
// сколько вариантов ORDER BY {o} у одного запроса
const SQL_MAX_ORDERS = 16

type SqlParam {
    kind: int
    ty: int
    v: int
    f: int
}

type Migration {
    n: int
    name: str
    sql: str
    tok: int
}

// разбирается параметр внутри '...' (для подсказки про литералы PostgreSQL)
var sql_quoted_param: bool
// компилируются начальные значения глобальных переменных (до подключения к базе)
var in_global_init: bool

// запросы маршрута вне tx: сколько уже было (запись после них — гонка);
// по веткам — наибольшее из путей, которые доходят до следующего оператора
var sql_outside: int

// let o = if/match ...: строки-литералы из ветвей-значений (для ORDER BY {o}).
var lit_on: bool
var lit_ok: bool
var lit_vals: [str]
// Последнее разобранное if/match-значение: первая лексема и позиция за ним.
// Набор ветвей годится, только если if/match — всё выражение, а не начало
// «if c \{ "a" } else \{ "b" } + id» или «match ... \{ ... }.replace(...)».
var ifv_from: int = -1
var ifv_to: int = -1

// Строки, которые даёт выражение toks[s..e]: строка-литерал, const или локальная
// с известным набором; [] — неизвестно.
fn lit_set(s: int, e: int) -> [str] {
    if e != s + 1 {
        return []
    }
    let t = toks[s]
    if t.kind == T_STR {
        return [strlits[t.val]]
    }
    if t.kind == T_IDENT {
        let li = find_local(t.text)
        if li >= 0 {
            return locals[li].lits
        }
        let si = sym_find(t.text)
        if si >= 0 && sym_kinds[si] == SK_CONST {
            let c = consts[sym_idxs[si]]
            if c.lit >= 0 {
                return [strlits[c.lit]]
            }
        }
    }
    return []
}

// Значение ветви toks[s..e] внутри let o = if/match: литерал — в набор; вложенный
// if/match (целиком) отметил свои ветви сам; иное — набор неизвестен.
fn lit_note(s: int, e: int) {
    if !lit_on || s >= toks.len() {
        return
    }
    let k = toks[s].kind
    if k == T_IF || k == T_MATCH {
        // свои ветви вложенный if/match отметил сам — если он и есть всё значение
        if ifv_from != s || ifv_to != e {
            lit_ok = false
        }
        return
    }
    let xs = lit_set(s, e)
    if xs.len() == 0 {
        lit_ok = false
        return
    }
    for x in xs {
        var seen = false
        for y in lit_vals {
            if y == x {
                seen = true
            }
        }
        if !seen {
            lit_vals.push(x)
        }
    }
}

// После ветки: если она ушла (return, break…), её запросы дальше не предшествуют.
fn sql_branch(before: int, div: bool) -> int {
    if div {
        return before
    }
    return sql_outside
}

fn sql_join(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}
var sql_root_used: bool
var sql_root_off: int
var sql_sites: [int]
var sql_migs: [Migration]
var uses_db: bool

// Корень для рантайма: [0] — таблица мест, [1] — таблица миграций.
fn sql_root() -> int {
    if !sql_root_used {
        sql_root_used = true
        sql_root_off = desc_reserve(4)
    }
    return DATA_BASE + sql_root_off
}

// ---- Запросы вне tx через вызовы ----
// Сколько запросов вне tx функция может выполнить (сама и через вызовы) и есть
// ли среди них запись. По лексемам и без учёта ветвей: лучше лишний tx { },
// чем пропущенная гонка «прочитал в помощнике — записал в маршруте».
var fs_state: [int]
var fs_count: [int]
var fs_write: [bool]

fn fn_sql_summary(fi: int) {
    while fs_state.len() < funcs.len() {
        fs_state.push(0)
        fs_count.push(0)
        fs_write.push(false)
    }
    if fs_state[fi] != 0 {
        return
    }
    fs_state[fi] = 1
    let f = funcs[fi]
    var n = 0
    var w = false
    if f.body >= 0 && !f.is_lib {
        var i = f.body
        while i < f.body_end {
            let t = toks[i]
            if t.kind == T_IDENT && t.text == "tx" && kind_at(i + 1) == '\{' {
                // запросы блока tx — одна транзакция
                i = sql_skip_block(i + 1)
                continue
            }
            if t.kind == T_SQL {
                n += 1
                if sql_lit_writes(sqllits[t.val]) {
                    w = true
                }
            } else if t.kind == T_IDENT && kind_at(i + 1) == '(' && (i == 0 || toks[i - 1].kind != '.') {
                let g = func_find(t.text)
                if g >= 0 && g != fi && !funcs[g].is_lib {
                    fn_sql_summary(g)
                    n += fs_count[g]
                    w = w || fs_write[g]
                }
            }
            i += 1
        }
    }
    fs_count[fi] = n
    fs_write[fi] = w
    fs_state[fi] = 2
}

// j — лексема «{» → лексема за парной «}».
fn sql_skip_block(j: int) -> int {
    var depth = 0
    var i = j
    while i < toks.len() && toks[i].kind != T_EOF {
        if toks[i].kind == '\{' {
            depth += 1
        } else if toks[i].kind == '}' {
            depth -= 1
            if depth == 0 {
                return i + 1
            }
        }
        i += 1
    }
    return i
}

fn sql_lit_writes(lit: SqlLit) -> bool {
    let text = lit.segs.join(" $0 ")
    return sql_target_table(text).byte_len() > 1 || sql_has_word(text, "delete") || sql_has_word(text, "merge")
}

// Вызов функции программы в маршруте вне tx: её запросы считаются, как свои.
fn sql_call_check(t: Token, fi: int) {
    if in_global_init && !funcs[fi].is_lib {
        fn_sql_summary(fi)
        if fs_count[fi] > 0 {
            error_tok(t, t.text + "() runs sql, and the initial value of a global is computed before the database is connected", "compute it in main, a route or an every task")
        }
        return
    }
    if route_ctx < 0 || tx_depth > 0 || inline_depth > 0 || funcs[fi].is_lib {
        return
    }
    fn_sql_summary(fi)
    let n = fs_count[fi]
    if n == 0 {
        return
    }
    if fs_write[fi] && (sql_outside > 0 || n >= 2 || loop_depth > 0) {
        var why = "another statement runs before it"
        if loop_depth > 0 {
            why = "it runs in a loop"
        } else if sql_outside == 0 {
            why = "it can run " + n.to_str() + " statements"
        }
        error_tok(t, t.text + "() writes to the database outside tx and " + why + ": another request can change the data in between", "put the statements of this request in tx \{ ... }")
    }
    sql_outside += n
}

// ---- Запрос T отвечает 404 ----
// Запрос формы T (ровно одна строка) без гарантированной строки отвечает 404,
// если строки нет. Маршрут, в котором (сам или через вызовы) есть такой
// запрос, обязан объявить 404: иначе тихий 404 там, где задача ждёт 401 или 422.

// по функциям: первый такой запрос (лексема) и есть ли он
var fn_404_tok: [Token]
var fn_404_has: [bool]
// 0 — не смотрели, 1 — смотрим, 2 — готово
var fn_404_state: [int]

fn sql_grow_404() {
    while fn_404_has.len() < funcs.len() {
        fn_404_tok.push(Token { kind: 0, val: 0, text: "", line: 0, col: 0, file: 0 })
        fn_404_has.push(false)
        fn_404_state.push(0)
    }
}

fn sql_note_404(at: Token) {
    if cur_fn < 0 {
        return
    }
    sql_grow_404()
    if !fn_404_has[cur_fn] {
        fn_404_has[cur_fn] = true
        fn_404_tok[cur_fn] = at
    }
}

// Есть ли в функции (сама или через вызовы функций программы) такой запрос.
fn fn_may_404(fi: int) -> bool {
    sql_grow_404()
    if fn_404_state[fi] != 0 {
        return fn_404_has[fi]
    }
    fn_404_state[fi] = 1
    let f = funcs[fi]
    if !fn_404_has[fi] && f.body >= 0 && !f.is_lib {
        var i = f.body
        while i < f.body_end && !fn_404_has[fi] {
            let t = toks[i]
            if t.kind == T_IDENT && kind_at(i + 1) == '(' && (i == 0 || toks[i - 1].kind != '.') {
                let g = func_find(t.text)
                if g >= 0 && g != fi && !funcs[g].is_lib && fn_may_404(g) {
                    fn_404_has[fi] = true
                    fn_404_tok[fi] = fn_404_tok[g]
                }
            }
            i += 1
        }
    }
    fn_404_state[fi] = 2
    return fn_404_has[fi]
}

fn sql_check_404() {
    for r in routes {
        var lists = false
        for v in r.variants {
            if v.status == 404 {
                lists = true
            }
        }
        if !lists && r.fi >= 0 && fn_may_404(r.fi) {
            // sql "..." или ch "..." — подсказка тем же словом
            var word = "sql"
            if fn_404_tok[r.fi].text == "ch" {
                word = "ch"
            }
            error_tok(fn_404_tok[r.fi], "this query answers 404 when no row matches, but route " + r.method + " \"" + r.path + "\" does not list 404", "add | 404 to the route, or answer yourself: let row: T = " + word + " ... else \{ return 401 }")
        }
    }
}

// Строка гарантирована самим запросом: INSERT ... VALUES/{v} с RETURNING без
// ON CONFLICT ... DO NOTHING; SELECT без FROM; SELECT с агрегатом без GROUP BY,
// HAVING, LIMIT, OFFSET и UNION.
fn sql_one_row(s: str) -> bool {
    let ws = sql_code_words(s)
    if ws.len() == 0 {
        return false
    }
    let first = ws[0].w
    if first == "insert" {
        var values = false
        for i in 0..ws.len() {
            let x = ws[i]
            if x.depth == 0 {
                if x.w == "values" {
                    values = true
                }
                if x.w == "select" || (x.w == "do" && i + 1 < ws.len() && ws[i + 1].w == "nothing") {
                    return false
                }
            }
        }
        return values && sql_top_returning(s)
    }
    if first != "select" {
        return false
    }
    var from = false
    var agg = false
    var sub = -1
    for i in 1..ws.len() {
        let x = ws[i]
        if sub >= 0 && x.depth < sub {
            sub = -1
        }
        if x.depth == 0 {
            if x.w == "group" || x.w == "having" || x.w == "limit" || x.w == "offset" || x.w == "union" || x.w == "intersect" || x.w == "except" || x.w == "fetch" || x.w == "window" {
                return false
            }
            if x.w == "from" {
                from = true
            }
        }
        if x.w == "select" && x.depth > 0 && sub < 0 {
            sub = x.depth
        }
        if !from && sub < 0 && (x.w == "count" || x.w == "sum" || x.w == "avg" || x.w == "min" || x.w == "max" || x.w == "bool_and" || x.w == "bool_or" || x.w == "array_agg" || x.w == "string_agg" || x.w == "json_agg" || x.w == "jsonb_agg" || x.w == "json_object_agg" || x.w == "jsonb_object_agg" || x.w == "exists") {
            agg = true
        }
    }
    return !from || agg
}

// После компиляции всех функций: таблицы мест и миграций.
fn sql_finish() {
    sql_check_404()
    if !sql_root_used {
        return
    }
    let st = desc_reserve(1 + sql_sites.len())
    desc_put(st, 0, sql_sites.len())
    for i in 0..sql_sites.len() {
        let a = sql_sites[i]
        desc_put(st, 1 + i, a)
    }
    let mt = desc_reserve(1 + 2 * sql_migs.len())
    desc_put(mt, 0, sql_migs.len())
    for i in 0..sql_migs.len() {
        let m = sql_migs[i]
        desc_put(mt, 1 + 2 * i, const_str(m.name))
        desc_put(mt, 2 + 2 * i, const_str(m.sql))
    }
    desc_put(sql_root_off, 0, DATA_BASE + st)
    desc_put(sql_root_off, 1, DATA_BASE + mt)
}

// Есть ли в программе (не в библиотеке) sql или migration N (PostgreSQL; ch "..."
// и migration ch N — ClickHouse, scan_uses_ch).
fn scan_uses_db() -> bool {
    var i = 0
    while i < toks.len() {
        let t = toks[i]
        if !files[t.file].is_lib && ((t.kind == T_SQL && !sqllits[t.val].ch) || (t.kind == T_IDENT && t.text == "migration" && kind_at(i + 1) == T_INT)) {
            return true
        }
        i += 1
    }
    return false
}

// ---- Действия, которые нельзя повторять (внутри tx) ----
// Функция «с действием»: зовёт fetch или sleep, меняет store — сама или через
// свои вызовы. Внутри tx такую функцию звать нельзя: блок может выполниться
// ещё раз после конфликта.

var fx_state: [int]
var fx_why: [str]

fn fn_effect(fi: int) -> str {
    while fx_state.len() < funcs.len() {
        fx_state.push(0)
        fx_why.push("")
    }
    if fx_state[fi] >= 2 {
        return fx_why[fi]
    }
    if fx_state[fi] == 1 {
        // цикл вызовов: ответ ещё не готов, «чистый» результат не запоминать
        fx_cycles += 1
        return ""
    }
    fx_state[fi] = 1
    let cycles = fx_cycles
    let f = funcs[fi]
    var why = ""
    if f.body >= 0 && !f.is_lib {
        var i = f.body
        while i < f.body_end && why == "" {
            let t = toks[i]
            if t.kind == T_SQL && sqllits[t.val].ch {
                why = "runs ch"
            } else if ch_table_call_at(fi, i) {
                why = "calls " + t.text + ".insert"
            }
            if t.kind == T_IDENT {
                let nk = kind_at(i + 1)
                let dotted = i > 0 && toks[i - 1].kind == '.'
                if why != "" {
                } else if (t.text == "fetch" && !dotted) || ((t.text == "sleep" || driver_io(t.text)) && nk == '(') {
                    why = "calls " + t.text
                } else if nk == '(' {
                    // f(...) и x.f(...)
                    let g = func_find(t.text)
                    if g >= 0 && g != fi && !funcs[g].is_lib {
                        let w = fn_effect(g)
                        if w != "" {
                            why = "calls " + t.text + "(), which " + w
                        }
                    }
                } else if !dotted {
                    let s = sym_find(t.text)
                    if s >= 0 && sym_kind(s) == SK_GLOBAL && fx_changes(i) {
                        if globals[sym_idx(s)].is_store {
                            why = "changes store " + t.text
                        } else {
                            why = "changes the global " + t.text
                        }
                    }
                }
            }
            i += 1
        }
    }
    fx_why[fi] = why
    if why != "" {
        fx_state[fi] = 3
    } else if fx_cycles == cycles {
        fx_state[fi] = 2
    } else {
        // зависел от функции, которую ещё считали: посчитать заново в следующий раз
        fx_state[fi] = 0
    }
    return why
}

var fx_cycles: int

// По функциям: какие параметры функция меняет (xs.push, b.n = ..., передаёт их
// функции, которая меняет), сама или через вызовы.
var pm_state: [int]
var pm_vals: [[bool]]

fn fn_param_mut(fi: int) -> [bool] {
    while pm_state.len() < funcs.len() {
        pm_state.push(0)
        pm_vals.push([])
    }
    let f = funcs[fi]
    if pm_state[fi] == 2 {
        return pm_vals[fi]
    }
    var res: [bool] = []
    for p in f.params {
        res.push(false)
    }
    if pm_state[fi] == 1 {
        return res
    }
    pm_state[fi] = 1
    if f.body >= 0 && !f.is_lib {
        for i in f.body..f.body_end {
            let t = toks[i]
            if t.kind != T_IDENT {
                continue
            }
            let dotted = i > 0 && toks[i - 1].kind == '.'
            if !dotted {
                for p in 0..f.params.len() {
                    if f.params[p].name == t.text && fx_mutates_through(i) {
                        res[p] = true
                    }
                }
            }
            if kind_at(i + 1) == '(' {
                let g = func_find(t.text)
                if g >= 0 && g != fi && !funcs[g].is_lib {
                    let gm = fn_param_mut(g)
                    var shift = 0
                    if dotted && i >= 2 && toks[i - 2].kind == T_IDENT {
                        // x.g(...): x — первый параметр g
                        shift = 1
                        for p in 0..f.params.len() {
                            if gm.len() > 0 && gm[0] && f.params[p].name == toks[i - 2].text {
                                res[p] = true
                            }
                        }
                    }
                    let roots = call_arg_roots(i + 1)
                    for a in 0..roots.len() {
                        if a + shift < gm.len() && gm[a + shift] {
                            for p in 0..f.params.len() {
                                if f.params[p].name == roots[a] {
                                    res[p] = true
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    pm_vals[fi] = res
    pm_state[fi] = 2
    return res
}

// Значение по имени toks[i] меняется через путь: x.f = ..., x[k] = ...,
// x.push(...), x.a.push(...) (простое x = ... параметр не меняет).
fn fx_mutates_through(i: int) -> bool {
    let k = kind_at(i + 1)
    if k != '.' && k != '[' {
        return false
    }
    return fx_changes(i)
}

// Имя toks[i] (глобальная) меняется здесь: x = / x += / x.f = / x[k] = /
// x.push(...) и т. п. (а не только читается: x[k], x.len(), x.f).
fn fx_changes(i: int) -> bool {
    var j = i + 1
    while j < toks.len() {
        let k = kind_at(j)
        if is_assign_op(k) {
            return true
        }
        if k == '.' && kind_at(j + 1) == T_IDENT {
            if kind_at(j + 2) == '(' {
                let m = toks[j + 1].text
                return rw_mutating(m) || m == "extend" || m == "set" || m == "delete"
            }
            j += 2
            continue
        }
        if k == '[' {
            j = matching_close(j) + 1
            continue
        }
        return false
    }
    return false
}

// ---- migration N `...` ----

fn prescan_migration() {
    let at = tok()
    advance()
    let nt = tok()
    if nt.kind != T_INT {
        error_tok(nt, "migration needs a number", "migration 1 `CREATE TABLE ...`")
        return
    }
    advance()
    let st = tok()
    if st.kind != T_STR {
        error_tok(st, "migration " + nt.val.to_str() + " needs its SQL in a string", "migration " + nt.val.to_str() + " `CREATE TABLE ...`")
        return
    }
    advance()
    for m in sql_migs {
        if m.n == nt.val {
            error_tok(nt, "two migrations numbered " + nt.val.to_str(), "give the newer one the next number")
            return
        }
    }
    if nt.val < 1 {
        error_tok(nt, "migration numbers start at 1", "")
        return
    }
    sql_migs.push(Migration { n: nt.val, name: nt.val.to_str(), sql: strlits[st.val], tok: pos - 3 })
}

// Имена в каталоге (getdents64); none — каталога нет.
fn dir_names(path: str) -> [str]? {
    let fd = syscall(2, __cstr(path), 0x10000, 0)
    if fd < 0 {
        return none
    }
    var out: [str] = []
    let buf = __alloc(8192)
    while true {
        let n = syscall(217, fd, buf, 8192)
        if n <= 0 {
            break
        }
        var off = 0
        while off < n {
            let reclen = load8(buf + off + 16) + load8(buf + off + 17) * 256
            var e = buf + off + 19
            var len = 0
            while load8(e + len) != 0 {
                len += 1
            }
            out.push(__str_copy(e, len))
            off += reclen
        }
    }
    syscall(3, fd)
    return out
}

// Файлы migrations/N_имя.sql рядом с главным файлом программы.
fn load_migration_files(main_path: str) {
    var dir = "migrations"
    var slash = main_path.byte_len() - 1
    while slash >= 0 && main_path.byte(slash) != '/' {
        slash -= 1
    }
    if slash >= 0 {
        dir = main_path.byte_slice(0, slash) + "/migrations"
    }
    let found = dir_names(dir)
    if found == none {
        return
    }
    let names = found ?? []
    for name in names {
        if !name.ends_with(".sql") {
            continue
        }
        var i = 0
        while i < name.byte_len() && is_digit(name.byte(i)) {
            i += 1
        }
        let n = name.byte_slice(0, i).to_int() ?? 0
        if i == 0 || n < 1 || (i < name.byte_len() - 4 && name.byte(i) != '_') {
            report_at(files.len() - 1, 1, 1, "migration file " + dir + "/" + name + " must be named N_name.sql (N = 1, 2, 3, ...)", "rename it, e.g. 1_init.sql")
            continue
        }
        let read = read_file(dir + "/" + name)
        if read == none {
            continue
        }
        let text = read ?? ""
        var dup = false
        for m in sql_migs {
            if m.n == n {
                dup = true
            }
        }
        if dup {
            report_at(files.len() - 1, 1, 1, "two migrations numbered " + n.to_str() + " (" + dir + "/" + name + ")", "give the newer one the next number")
            continue
        }
        sql_migs.push(Migration { n: n, name: n.to_str(), sql: text.replace("\r\n", "\n"), tok: -1 })
        uses_db = true
    }
}

// Миграции по возрастанию номера.
fn sort_migrations() {
    var i = 1
    while i < sql_migs.len() {
        var j = i
        while j > 0 && sql_migs[j - 1].n > sql_migs[j].n {
            let t = sql_migs[j]
            sql_migs[j] = sql_migs[j - 1]
            sql_migs[j - 1] = t
            j -= 1
        }
        i += 1
    }
    for m in sql_migs {
        sql_check_migration(m)
    }
}

// Миграция с CONCURRENTLY идёт вне транзакции: если сервер упадёт до записи о
// ней, следующий старт выполнит её снова — поэтому один оператор и IF NOT EXISTS.
fn sql_check_migration(m: Migration) {
    for h in sql_dialect(m.sql) {
        let msg = "migration " + m.n.to_str() + ": " + h.msg
        if m.tok >= 0 {
            error_tok(toks[m.tok], msg, h.fix)
        } else {
            report_at(files.len() - 1, 1, 1, msg, h.fix)
        }
        return
    }
    var conc = false
    var guarded = false
    var stmts = 0
    let ws = sql_code_words(m.sql)
    for i in 0..ws.len() {
        if ws[i].w == "concurrently" {
            conc = true
        }
        if ws[i].w == "if" && i + 2 < ws.len() && ws[i + 1].w == "not" && ws[i + 2].w == "exists" {
            guarded = true
        }
    }
    if !conc {
        return
    }
    let st = sql_states(m.sql)
    var tail = false
    for i in 0..m.sql.byte_len() {
        if st[i] == 0 {
            let c = m.sql.byte(i)
            if c == ';' {
                tail = true
            } else if tail && !sql_space(c) {
                stmts += 1
                tail = false
            }
        }
    }
    if stmts == 0 && guarded {
        return
    }
    let msg = "migration " + m.n.to_str() + " uses CONCURRENTLY, so it runs outside a transaction: it must be one statement with IF NOT EXISTS, or a crash before it is recorded blocks the next start"
    let fix = "migration " + m.n.to_str() + " `CREATE INDEX CONCURRENTLY IF NOT EXISTS ...` alone; other statements in the next migration"
    if m.tok >= 0 {
        error_tok(toks[m.tok], msg, fix)
    } else {
        report_at(files.len() - 1, 1, 1, msg, fix)
    }
}

// ---- Разбор текста SQL ----

fn sql_lower(c: int) -> int {
    if c >= 'A' && c <= 'Z' {
        return c + 32
    }
    return c
}

fn sql_space(c: int) -> bool {
    return c == ' ' || c == '\n' || c == '\t' || c == '\r'
}

fn sql_word_char(c: int) -> bool {
    return is_ident_char(c) || c == '$' || c == '"' || c == '.'
}

// Конец s без пробелов: длина.
fn sql_trim_end(s: str) -> int {
    var n = s.byte_len()
    while n > 0 && sql_space(s.byte(n - 1)) {
        n -= 1
    }
    return n
}

// s (до позиции n) кончается словом w (без учёта регистра)? → начало слова или -1.
fn sql_ends_word(s: str, n: int, w: str) -> int {
    var e = n
    while e > 0 && sql_space(s.byte(e - 1)) {
        e -= 1
    }
    let k = w.byte_len()
    if e < k {
        return -1
    }
    for i in 0..k {
        if sql_lower(s.byte(e - k + i)) != w.byte(i) {
            return -1
        }
    }
    if e - k > 0 && is_ident_char(s.byte(e - k - 1)) {
        return -1
    }
    return e - k
}

// s начинается (после пробелов) со слов ws? → сколько символов они занимают или 0.
fn sql_starts_words(s: str, ws: [str]) -> int {
    var p = 0
    for w in ws {
        while p < s.byte_len() && sql_space(s.byte(p)) {
            p += 1
        }
        if p + w.byte_len() > s.byte_len() {
            return 0
        }
        for i in 0..w.byte_len() {
            if sql_lower(s.byte(p + i)) != w.byte(i) {
                return 0
            }
        }
        p += w.byte_len()
        if p < s.byte_len() && is_ident_char(s.byte(p)) {
            return 0
        }
    }
    return p
}

// ---- Сканер текста SQL ----
// Состояние каждого символа: 0 — код, 1 — '...', 2 — "имя", 3 — -- комментарий,
// 4 — /* */, 5 — E'...' (с \-экранированием), 6 — $тег$...$тег$, 7 — `имя`
// (ClickHouse). Последний элемент — состояние после текста. Один сканер на всё:
// поиск слов, кавычек, таблиц и ошибок привычек видит одно и то же.
//
// sql_ch — текст ch "...": в '...' обратная косая черта экранирует, # —
// комментарий, `имя` — имя.
var sql_ch: bool

fn sql_states(s: str) -> [int] {
    var out: [int] = []
    var st = 0
    var tag = ""
    var i = 0
    let n = s.byte_len()
    while i < n {
        let c = s.byte(i)
        if st == 0 {
            if c == '\'' {
                st = 1
                if !sql_ch && i > 0 && (s.byte(i - 1) == 'e' || s.byte(i - 1) == 'E') && (i == 1 || !is_ident_char(s.byte(i - 2))) {
                    st = 5
                }
                out.push(st)
                i += 1
                continue
            }
            if sql_ch && c == '`' {
                st = 7
                out.push(7)
                i += 1
                continue
            }
            if c == '"' {
                st = 2
            } else if sql_ch && c == '#' {
                st = 3
            } else if c == '-' && i + 1 < n && s.byte(i + 1) == '-' {
                st = 3
            } else if c == '/' && i + 1 < n && s.byte(i + 1) == '*' {
                st = 4
                out.push(4)
                out.push(4)
                i += 2
                continue
            } else if c == '$' && (i == 0 || !is_ident_char(s.byte(i - 1))) && i + 1 < n && !is_digit(s.byte(i + 1)) {
                var j = i + 1
                while j < n && is_ident_char(s.byte(j)) {
                    j += 1
                }
                if j < n && s.byte(j) == '$' {
                    tag = s.byte_slice(i, j + 1)
                    while i <= j {
                        out.push(6)
                        i += 1
                    }
                    st = 6
                    continue
                }
            }
            out.push(st)
            i += 1
            continue
        }
        if st == 7 {
            out.push(7)
            if c == '`' {
                st = 0
            }
            i += 1
            continue
        }
        if st == 1 || st == 5 {
            out.push(st)
            if c == '\\' && (st == 5 || sql_ch) && i + 1 < n {
                out.push(st)
                i += 2
                continue
            }
            if c == '\'' {
                if i + 1 < n && s.byte(i + 1) == '\'' {
                    out.push(st)
                    i += 2
                    continue
                }
                st = 0
            }
            i += 1
            continue
        }
        if st == 2 {
            out.push(2)
            if c == '"' {
                st = 0
            }
            i += 1
            continue
        }
        if st == 3 {
            out.push(3)
            if c == '\n' {
                st = 0
            }
            i += 1
            continue
        }
        if st == 4 {
            out.push(4)
            if c == '*' && i + 1 < n && s.byte(i + 1) == '/' {
                out.push(4)
                i += 2
                st = 0
                continue
            }
            i += 1
            continue
        }
        // $тег$ ... $тег$
        if c == '$' && i + tag.byte_len() <= n && s.byte_slice(i, i + tag.byte_len()) == tag {
            for k in 0..tag.byte_len() {
                out.push(6)
            }
            i += tag.byte_len()
            st = 0
            continue
        }
        out.push(6)
        i += 1
    }
    out.push(st)
    return out
}

type SqlWord {
    w: str
    at: int
    depth: int
}

// Слова кода (в нижнем регистре) с глубиной скобок — без строк, имён в кавычках и комментариев.
fn sql_code_words(s: str) -> [SqlWord] {
    let st = sql_states(s)
    var out: [SqlWord] = []
    var depth = 0
    var i = 0
    let n = s.byte_len()
    while i < n {
        if st[i] != 0 {
            i += 1
            continue
        }
        let c = s.byte(i)
        if c == '(' {
            depth += 1
        } else if c == ')' {
            depth -= 1
        } else if is_alpha(c) && (i == 0 || !is_ident_char(s.byte(i - 1))) {
            let b = buf_new(8)
            let at = i
            while i < n && is_ident_char(s.byte(i)) {
                buf_byte(b, sql_lower(s.byte(i)))
                i += 1
            }
            out.push(SqlWord { w: buf_str(b), at: at, depth: depth })
            continue
        }
        i += 1
    }
    return out
}

// Начало открытой строки '...' в конце s (s кончается внутри неё) или -1.
fn sql_open_quote(s: str) -> int {
    let st = sql_states(s)
    let n = s.byte_len()
    if st[n] != 1 {
        return -1
    }
    var i = n - 1
    while i > 0 && st[i - 1] == 1 {
        i -= 1
    }
    return i
}

// Первое слово запроса (в нижнем регистре).
fn sql_first_word(s: str) -> str {
    let ws = sql_code_words(s)
    if ws.len() == 0 {
        return ""
    }
    return ws[0].w
}




// Имя таблицы в s с позиции p (необязательная схема, "кавычки"): без схемы.
fn sql_name_at(s: str, p0: int) -> str {
    var p = p0
    let n = s.byte_len()
    while p < n && sql_space(s.byte(p)) {
        p += 1
    }
    let b = buf_new(16)
    while p < n && (is_ident_char(s.byte(p)) || s.byte(p) == '.' || s.byte(p) == '"') {
        if s.byte(p) == '.' {
            buf_clear(b)
        } else if s.byte(p) == '"' {
            p += 1
            while p < n && s.byte(p) != '"' {
                buf_byte(b, s.byte(p))
                p += 1
            }
        } else {
            buf_byte(b, sql_lower(s.byte(p)))
        }
        p += 1
    }
    return buf_str(b)
}

// Таблицы, в которые пишет запрос (INSERT INTO t, UPDATE t — и в WITH):
// « t1 t2 ». Нарушение внешнего ключа в такой таблице — ссылка на то, чего нет
// (404); в другой — удаляют то, на что ещё ссылаются (409).
fn sql_target_table(s: str) -> str {
    let ws = sql_code_words(s)
    var out = " "
    for i in 0..ws.len() {
        let w = ws[i].w
        var after = -1
        if w == "insert" && i + 1 < ws.len() && ws[i + 1].w == "into" {
            after = ws[i + 1].at + 4
        } else if w == "update" {
            var prev = ""
            if i > 0 {
                prev = ws[i - 1].w
            }
            if prev != "for" && prev != "do" && prev != "on" && prev != "key" && prev != "no" {
                after = ws[i].at + 6
                if i + 1 < ws.len() && ws[i + 1].w == "only" {
                    after = ws[i + 1].at + 4
                }
            }
        }
        if after >= 0 {
            let name = sql_name_at(s, after)
            if name.byte_len() > 0 {
                out = out + name + " "
            }
        }
    }
    return out
}

// Ключ для слияния одинаковых параметров: только имена, поля, литералы и
// арифметика без вызовов (их значение не меняется между вхождениями).
fn sql_pure_key(from: int, to: int) -> str {
    let b = buf_new(16)
    var i = from
    while i < to {
        let k = toks[i].kind
        let ok = k == T_IDENT || k == '.' || k == T_INT || k == T_STR || k == T_FLOAT || k == T_TRUE || k == T_FALSE || k == '[' || k == ']' || k == '+' || k == '-' || k == '*'
        if !ok {
            return ""
        }
        if k == T_IDENT && i + 1 < to && toks[i + 1].kind == '(' {
            return ""
        }
        if k == T_STR {
            // у сырых строк текст токена одинаковый («`...`»): ключ — само значение
            buf_add(b, "\"" + strlits[toks[i].val] + "\"")
        } else {
            buf_add(b, toks[i].text)
        }
        buf_byte(b, ' ')
        i += 1
    }
    return buf_str(b)
}

// Имя столбца для подставленного поля: зарезервированные слова SQL — в кавычках.
fn sql_ident(name: str) -> str {
    let words = " all analyse analyze and any array as asc asymmetric authorization binary both case cast check collate collation column concurrently constraint create cross current_catalog current_date current_role current_schema current_time current_timestamp current_user default deferrable desc distinct do else end except false fetch for foreign freeze from full grant group having ilike in initially inner intersect into is isnull join lateral leading left like limit localtime localtimestamp natural not notnull null offset on only or order outer overlaps placing primary references returning right select session_user similar some symmetric table tablesample then to trailing true union unique user using variadic verbose when where window with "
    if words.contains(" " + name + " ") {
        return "\"" + name + "\""
    }
    return name
}

// Тип массива PostgreSQL для unnest списка значений поля.
fn sql_array_type(t: int) -> str {
    let k = tkind(ty_inner(t))
    if k == K_INT {
        return "bigint[]"
    }
    if k == K_FLOAT {
        return "float8[]"
    }
    if k == K_BOOL {
        return "boolean[]"
    }
    if k == K_STR {
        return "text[]"
    }
    return "jsonb[]"
}

fn sql_param_no(ps: [SqlParam], kind: int, ty: int, v: int, f: int) -> int {
    for i in 0..ps.len() {
        let p = ps[i]
        if p.kind == kind && p.v == v && p.f == f && p.ty == ty {
            return i + 1
        }
    }
    ps.push(SqlParam { kind: kind, ty: ty, v: v, f: f })
    return ps.len()
}

// Ошибки привычек вне строк и комментариев: несколько команд через ;.
fn sql_habits(at: Token, text: str) {
    let st = sql_states(text)
    var semi = false
    for i in 0..text.byte_len() {
        if st[i] == 0 {
            let c = text.byte(i)
            if c == ';' {
                semi = true
            } else if semi && !sql_space(c) {
                error_tok(at, "sql runs one statement; this one has several separated by ;", "write one sql per statement (inside tx \{ } if they belong together)")
                return
            }
        }
    }
}

fn sql_upper(s: str) -> str {
    let b = buf_new(s.byte_len())
    for i in 0..s.byte_len() {
        let c = s.byte(i)
        if c >= 'a' && c <= 'z' {
            buf_byte(b, c - 32)
        } else {
            buf_byte(b, c)
        }
    }
    return buf_str(b)
}

// Последний значащий символ кода перед i (пропуская пробелы) или -1.
fn sql_prev_code(s: str, st: [int], i: int) -> int {
    var j = i - 1
    while j >= 0 && (sql_space(s.byte(j)) || st[j] != 0) {
        j -= 1
    }
    return j
}

// Правила текста запроса: привычки других баз и ошибки, которые PostgreSQL
// пропустит молча (всё — ошибки с исправлением: предупреждений модель не видит).
type SqlHabit {
    msg: str
    fix: str
}

// Привычки других диалектов (MySQL, SQLite, SQL Server): PostgreSQL их не
// примет, а исправление известно заранее. Пусто — привычек нет.
fn sql_dialect(s: str) -> [SqlHabit] {
    var out: [SqlHabit] = []
    let ws = sql_code_words(s)
    let st = sql_states(s)
    let n = s.byte_len()
    for i in 0..n {
        if st[i] == 0 && s.byte(i) == '`' {
            out.push(SqlHabit { msg: "backticks quote names in MySQL; PostgreSQL does not know them", fix: "write the name as is, or in double quotes: \"order\"" })
            return out
        }
        if st[i] == 0 && s.byte(i) == '=' && i + 1 < n && s.byte(i + 1) == '=' && (i == 0 || (s.byte(i - 1) != '<' && s.byte(i - 1) != '>' && s.byte(i - 1) != '!' && s.byte(i - 1) != ':')) {
            out.push(SqlHabit { msg: "== is not SQL", fix: "a = b" })
            return out
        }
    }
    // внутри CREATE/ALTER TABLE (до следующего SELECT, VIEW и т. п.)
    var ddl = false
    for i in 0..ws.len() {
        let w = ws[i].w
        if w == "table" && i > 0 && (ws[i - 1].w == "create" || ws[i - 1].w == "alter" || ws[i - 1].w == "temp" || ws[i - 1].w == "temporary" || ws[i - 1].w == "unlogged") {
            ddl = true
        } else if w == "select" || w == "insert" || w == "update" || w == "delete" || w == "values" || w == "view" || w == "function" || w == "index" {
            ddl = false
        }
        var next = ""
        if i + 1 < ws.len() {
            next = ws[i + 1].w
        }
        var prev = ""
        if i > 0 {
            prev = ws[i - 1].w
        }
        // сразу после слова: «(» — вызов функции
        var p = ws[i].at + w.byte_len()
        while p < n && sql_space(s.byte(p)) {
            p += 1
        }
        let fcall = p < n && s.byte(p) == '('
        let typed = sql_type_word(w) && sql_type_slot(s, ws, i, ddl)
        // после «(»: число (IDENTITY(1,1), INT(11), DATETIME(6))
        var a = p + 1
        while a < n && sql_space(s.byte(a)) {
            a += 1
        }
        let num_arg = fcall && a < n && is_digit(s.byte(a))
        // определение своей функции с таким именем — не вызов
        let defn = prev == "function" || (ws[i].at > 0 && s.byte(ws[i].at - 1) == '.')
        var msg = ""
        var fix = ""
        if w == "insert" && next == "ignore" {
            msg = "INSERT IGNORE is MySQL"
            fix = "INSERT ... ON CONFLICT DO NOTHING (into T? to see whether a row was added)"
        } else if w == "replace" && next == "into" && i == 0 {
            msg = "REPLACE INTO is MySQL"
            fix = "INSERT ... ON CONFLICT (key) DO UPDATE SET col = EXCLUDED.col"
        } else if w == "duplicate" && prev == "on" && next == "key" {
            msg = "ON DUPLICATE KEY UPDATE is MySQL"
            fix = "ON CONFLICT (key) DO UPDATE SET col = EXCLUDED.col"
        } else if w == "limit" && sql_limit_comma(s, p) {
            msg = "LIMIT a, b is MySQL"
            fix = "LIMIT b OFFSET a"
        } else if w == "top" && prev == "select" && p < n && (is_digit(s.byte(p)) || s.byte(p) == '(' || s.byte(p) == '$') {
            msg = "SELECT TOP n is SQL Server"
            fix = "... ORDER BY ... LIMIT n"
        } else if fcall && !defn && (w == "ifnull" || w == "isnull" || w == "nvl") {
            msg = w + "() is not PostgreSQL"
            fix = "coalesce(a, b)"
        } else if fcall && !defn && (w == "getdate" || w == "curdate" || w == "sysdate" || w == "getutcdate") {
            msg = w + "() is not PostgreSQL"
            fix = "now() (current_date for the date)"
        } else if fcall && !defn && (w == "last_insert_id" || w == "lastval" || w == "scope_identity" || w == "last_insert_rowid") {
            msg = w + "() can return an id from another table or request"
            fix = "INSERT ... RETURNING id"
        } else if fcall && !defn && w == "group_concat" {
            msg = "group_concat() is MySQL"
            fix = "string_agg(x, ',')"
        } else if fcall && !defn && (w == "len" || w == "charindex" || w == "datediff") {
            msg = w + "() is SQL Server"
            fix = "length(s), strpos(s, sub), b - a (dates) or age(b, a)"
        } else if w == "auto_increment" || w == "autoincrement" || (w == "identity" && num_arg && prev != "as") {
            msg = sql_upper(w) + " is not PostgreSQL"
            fix = "id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY (or bigserial PRIMARY KEY)"
        } else if typed && (w == "datetime" || w == "datetime2") {
            msg = "DATETIME is not a PostgreSQL type"
            fix = "timestamptz"
        } else if typed && (w == "tinyint" || w == "mediumint") {
            msg = sql_upper(w) + " is not a PostgreSQL type"
            fix = "boolean for flags, smallint or integer for numbers"
        } else if typed && (w == "nvarchar" || w == "longtext" || w == "mediumtext") {
            msg = sql_upper(w) + " is not a PostgreSQL type"
            fix = "text"
        } else if typed && num_arg && (w == "int" || w == "integer" || w == "bigint" || w == "smallint") {
            msg = sql_upper(w) + "(n) is MySQL: the number is a display width"
            fix = sql_upper(w) + " without (n); bigint for ids and amounts"
        } else if w == "unsigned" && (prev == "int" || prev == "integer" || prev == "bigint" || prev == "smallint" || prev == "tinyint") && sql_only_space(s, ws[i - 1].at + prev.byte_len(), ws[i].at) {
            msg = "PostgreSQL has no unsigned numbers"
            fix = "bigint with CHECK (col >= 0)"
        } else if typed && !fcall && w == "money" {
            msg = "money depends on the server locale and rounds"
            fix = "bigint with the amount in cents"
        }
        if msg.byte_len() > 0 {
            out.push(SqlHabit { msg: msg, fix: fix })
            return out
        }
    }
    return out
}

// Слово ws[i] стоит на месте типа: после «::», после TYPE (ALTER COLUMN ...
// TYPE), или в определении столбца внутри CREATE/ALTER TABLE: «(имя тип»,
// «, имя тип», «ADD [COLUMN] имя тип». Имя — не ключевое слово.
fn sql_type_slot(s: str, ws: [SqlWord], i: int, ddl: bool) -> bool {
    var q = ws[i].at - 1
    while q >= 0 && sql_space(s.byte(q)) {
        q -= 1
    }
    if q < 0 {
        return false
    }
    if s.byte(q) == ':' {
        return true
    }
    // предыдущее: "имя" или слово вплотную; before — индекс слова перед именем
    var start = -1
    var before = i - 1
    if s.byte(q) == '"' {
        var r = q - 1
        while r >= 0 && s.byte(r) != '"' {
            r -= 1
        }
        if r < 0 {
            return false
        }
        start = r
    } else if i > 0 && ws[i - 1].at + ws[i - 1].w.byte_len() == q + 1 {
        let pw = ws[i - 1].w
        if pw == "type" {
            return ddl
        }
        if sql_reserved(pw) {
            return false
        }
        start = ws[i - 1].at
        before = i - 2
    } else {
        return false
    }
    if !ddl {
        return false
    }
    var r = start - 1
    while r >= 0 && sql_space(s.byte(r)) {
        r -= 1
    }
    if r < 0 {
        return false
    }
    if s.byte(r) == '(' || s.byte(r) == ',' {
        return true
    }
    if before >= 0 && ws[before].at + ws[before].w.byte_len() == r + 1 {
        return ws[before].w == "column" || ws[before].w == "add"
    }
    return false
}

// Типы других диалектов (и int с шириной): только их место проверяется.
fn sql_type_word(w: str) -> bool {
    for k in ["datetime", "datetime2", "tinyint", "mediumint", "nvarchar", "longtext", "mediumtext", "money", "int", "integer", "bigint", "smallint"] {
        if w == k {
            return true
        }
    }
    return false
}

// Ключевое слово SQL, которое не бывает именем столбца перед типом.
fn sql_reserved(w: str) -> bool {
    for k in ["select", "distinct", "all", "by", "on", "and", "or", "not", "as", "from", "where", "column", "add", "table", "constraint", "primary", "key", "unique", "check", "references", "default", "null", "foreign", "set", "with", "returning", "into", "values", "case", "when", "then", "else", "end", "in", "is", "like", "between", "exists", "only", "if", "using", "alter", "drop", "rename", "to"] {
        if w == k {
            return true
        }
    }
    return false
}

// Между позициями a и b только пробелы.
fn sql_only_space(s: str, a: int, b: int) -> bool {
    for k in a..b {
        if !sql_space(s.byte(k)) {
            return false
        }
    }
    return true
}

// После LIMIT с позиции p: число или $n, затем запятая (LIMIT a, b из MySQL).
fn sql_limit_comma(s: str, p0: int) -> bool {
    var p = p0
    let n = s.byte_len()
    if p < n && s.byte(p) == '$' {
        p += 1
    }
    let d = p
    while p < n && is_digit(s.byte(p)) {
        p += 1
    }
    if p == d {
        return false
    }
    while p < n && sql_space(s.byte(p)) {
        p += 1
    }
    return p < n && s.byte(p) == ','
}

fn sql_rules(at: Token, s: str, shape: int) {
    let ws = sql_code_words(s)
    if ws.len() == 0 {
        return
    }
    for h in sql_dialect(s) {
        error_tok(at, h.msg, h.fix)
        return
    }
    let first = ws[0].w
    var second = ""
    if ws.len() > 1 {
        second = ws[1].w
    }
    if first == "begin" || first == "commit" || first == "rollback" || first == "savepoint" || first == "release" || first == "start" || first == "abort" || (first == "set" && second == "transaction") {
        error_tok(at, sql_upper(first) + " inside sql: transactions are blocks", "tx \{ ... } runs its statements in one transaction and commits at the end")
        return
    }
    if (first == "set" && second != "local") || first == "reset" || first == "listen" || first == "unlisten" || first == "prepare" || first == "deallocate" || first == "discard" {
        error_tok(at, sql_upper(first) + " would stay on the pooled connection and leak into other requests", "SET LOCAL inside tx \{ }")
        return
    }
    if first == "create" || first == "alter" || first == "drop" || first == "grant" || first == "revoke" || first == "comment" {
        error_tok(at, sql_upper(first) + " belongs in a migration: the schema changes only through migrations", "migration N `...` with the next number")
        return
    }
    for x in ws {
        if x.w == "pg_advisory_lock" || x.w == "pg_try_advisory_lock" || x.w == "pg_advisory_unlock" {
            error_tok(at, x.w + " takes a session lock that stays on the pooled connection", "pg_advisory_xact_lock inside tx \{ }: it is released at commit")
            return
        }
    }
    // UPDATE/DELETE без WHERE
    let main = sql_main_word(s)
    if main == "update" || main == "delete" {
        var seen = false
        var has_where = false
        for x in ws {
            if x.depth == 0 {
                if x.w == main {
                    seen = true
                } else if seen && x.w == "where" {
                    has_where = true
                }
            }
        }
        if seen && !has_where {
            var table = sql_target_table(s).ascii_trim()
            for i in 0..ws.len() - 1 {
                if table.byte_len() == 0 && ws[i].w == "from" && ws[i].depth == 0 {
                    table = ws[i + 1].w
                }
            }
            error_tok(at, sql_upper(main) + " without WHERE changes every row of " + table, "add WHERE ...; write WHERE true if you mean every row")
            return
        }
    }
    // список со страницами без порядка
    if shape == SH_LIST {
        var lim = false
        var ord = false
        for i in 0..ws.len() {
            let x = ws[i]
            if x.depth == 0 {
                if x.w == "limit" || x.w == "offset" {
                    lim = true
                }
                if x.w == "order" && i + 1 < ws.len() && ws[i + 1].w == "by" {
                    ord = true
                }
            }
        }
        if lim && !ord {
            error_tok(at, "LIMIT without ORDER BY returns rows in no fixed order: pages repeat or skip rows", "ORDER BY id (or another unique key last)")
            return
        }
    }
    let st = sql_states(s)
    let n = s.byte_len()
    // = NULL, <> NULL: сравнение с NULL никогда не истинно
    for x in ws {
        if x.w == "null" {
            let q = sql_prev_code(s, st, x.at)
            if q >= 0 {
                let c = s.byte(q)
                var p = ' '
                if q > 0 {
                    p = s.byte(q - 1)
                }
                if (c == '>' && p == '<') || (c == '=' && p == '!') {
                    error_tok(at, "<> NULL is never true in SQL", "IS NOT NULL")
                    return
                }
                if c == '=' && p != '<' && p != '>' && p != '!' && p != ':' && !sql_in_set(s.byte_slice(0, q)) {
                    error_tok(at, "= NULL is never true in SQL", "IS NULL")
                    return
                }
            }
        }
    }
    // заполнители других драйверов: ?, :name, @name на месте значения
    for i in 0..n {
        if st[i] != 0 {
            continue
        }
        let c = s.byte(i)
        if c != '?' && c != ':' && c != '@' {
            continue
        }
        let q = sql_prev_code(s, st, i)
        let after_op = q >= 0 && (s.byte(q) == '=' || s.byte(q) == '<' || s.byte(q) == '>' || s.byte(q) == '(' || s.byte(q) == ',')
        if !after_op || (q == i - 1 && c == ':' && s.byte(q) == ':') {
            continue
        }
        var mark = ""
        if c == '?' {
            var j = i + 1
            while j < n && sql_space(s.byte(j)) {
                j += 1
            }
            if j >= n || s.byte(j) == ')' || s.byte(j) == ',' || s.byte(j) == ';' {
                mark = "?"
            }
        } else if i + 1 < n && is_alpha(s.byte(i + 1)) && (i == 0 || s.byte(i - 1) != ':') {
            var j = i + 1
            while j < n && is_ident_char(s.byte(j)) {
                j += 1
            }
            mark = s.byte_slice(i, j)
        }
        if mark.byte_len() > 0 {
            error_tok(at, "values go in place in sql: WHERE id = \{id}, not " + mark, "every \{expression} is sent as a parameter, never as SQL text")
            return
        }
    }
}

// Заполнители других драйверов ($1, %s) в исходном тексте (параметры — \0).
fn sql_habit_placeholder(at: Token, text: str) {
    let st = sql_states(text)
    let n = text.byte_len()
    for i in 0..n {
        if st[i] != 0 {
            continue
        }
        let c = text.byte(i)
        if c == '$' && i + 1 < n && is_digit(text.byte(i + 1)) && (i == 0 || !is_ident_char(text.byte(i - 1))) {
            error_tok(at, "values go in place in sql: WHERE id = \{id}, not $" + text.byte_slice(i + 1, i + 2), "every \{expression} is sent as a parameter, never as SQL text")
            return
        }
        if c == '%' && i + 1 < n && text.byte(i + 1) == 's' && (i + 2 >= n || !is_ident_char(text.byte(i + 2))) {
            error_tok(at, "values go in place in sql: WHERE id = \{id}, not %s", "every \{expression} is sent as a parameter, never as SQL text")
            return
        }
    }
}

// ---- Выражение sql ----

// Значения {выражение} запроса: каждое вычисляется и кладётся в стек;
// одинаковые чистые выражения ({id} дважды) — одно значение.
type SqlVals {
    // номер значения у каждого параметра
    vals: [int]
    // по значениям: тип, ключ слияния, текст выражения
    vtypes: [int]
    vkeys: [str]
    vtexts: [str]
    // по параметрам: лексема «(», начало и конец выражения
    ptoks: [Token]
    pfrom: [int]
    pto: [int]
    ok: bool
}

fn sql_parse_values(lit: SqlLit) -> SqlVals {
    let out = SqlVals { vals: [], vtypes: [], vkeys: [], vtexts: [], ptoks: [], pfrom: [], pto: [], ok: true }
    let n = lit.quoted.len()
    for i in 0..n {
        let pt = tok()
        out.ptoks.push(pt)
        if !expect_tok('(') {
            out.ok = false
            return out
        }
        let from = pos
        let saved = no_struct
        no_struct = false
        sql_quoted_param = lit.quoted[i]
        let et = parse_expr(ty_err)
        sql_quoted_param = false
        no_struct = saved
        let to = pos
        out.pfrom.push(from)
        out.pto.push(to)
        expect_tok(')')
        if et == ty_void || et == ty_never {
            error_tok(pt, "this expression has no value to send to the database", "")
        } else if et == ty_none {
            error_tok(pt, "none needs a type here", "write NULL in the SQL text instead")
        }
        let key = sql_pure_key(from, to)
        if key.byte_len() == 0 {
            // вызов мог изменить то, что вычислили раньше: дальше не сливать с прежними
            for j in 0..out.vkeys.len() {
                out.vkeys[j] = ""
            }
        }
        var vi = -1
        if key.byte_len() > 0 {
            for j in 0..out.vkeys.len() {
                let k = out.vkeys[j]
                if k == key && vi < 0 {
                    vi = j
                }
            }
        }
        if vi < 0 {
            vi = out.vtypes.len()
            out.vtypes.push(et)
            out.vkeys.push(key)
            out.vtexts.push(sql_tok_text(from, to))
            emit_push(RAX)
        }
        out.vals.push(vi)
    }
    return out
}

fn parse_sql(w: int) -> int {
    let at = tok()
    let lit = sqllits[at.val]
    if lit.ch {
        return parse_ch(w)
    }
    if in_global_init {
        error_tok(at, "sql in the initial value of a global runs before the database is connected", "compute it in main, a route or an every task")
    }
    advance()
    let n = lit.quoted.len()
    let sv = sql_parse_values(lit)
    if !sv.ok {
        return ty_err
    }
    let vals = sv.vals
    let vtypes = sv.vtypes
    let vtexts = sv.vtexts
    let ptoks = sv.ptoks
    let pfrom = sv.pfrom
    let pto = sv.pto
    sql_habit_placeholder(at, lit.segs.join("\0"))
    // форма результата — из ожидаемого типа
    var shape = SH_COUNT
    var rt = ty_int
    var inner = ty_err
    let optional_follow = kind() == T_ELSE || kind() == T_QQ
    if w != ty_err && w != ty_void && w != ty_never && w != ty_none {
        if tkind(w) == K_LIST {
            shape = SH_LIST
            inner = ty_elem(w)
            rt = w
            if tkind(inner) == K_OPT && tkind(ty_inner(inner)) == K_STRUCT {
                error_tok(at, "a row is never none: a list of rows is " + ty_name(ty_list(ty_inner(inner))), "let rows: " + ty_name(ty_list(ty_inner(inner))) + " = sql ...")
            }
        } else if tkind(w) == K_OPT {
            shape = SH_OPT
            inner = ty_inner(w)
            rt = w
        } else if optional_follow {
            shape = SH_OPT
            inner = w
            rt = ty_opt(w)
        } else {
            shape = SH_ONE
            inner = w
            rt = w
        }
    }
    // текст запроса с $n и переписываниями
    var segs: [str] = []
    for s in lit.segs {
        segs.push(s)
    }
    var cur = segs[0]
    var ps: [SqlParam] = []
    // сравнения с T? без проверки IS NULL: номер значения и место
    var cmp_v: [int] = []
    var cmp_at: [int] = []
    // строка '...' с параметрами внутри: она открыта (ещё не закрыта) и шаблон ли это LIKE
    var in_lit = false
    var lit_like = false
    // ORDER BY {o}: o — из строк-литералов, каждая даёт свой вариант запроса
    var order_vi = -1
    var order_lits: [str] = []
    for i in 0..n {
        let vi = vals[i]
        let vt = vtypes[vi]
        var next = segs[i + 1]
        let vk = tkind(vt)
        let isnull = sql_starts_words(next, ["is", "null"])
        let notnull = sql_starts_words(next, ["is", "not", "null"])
        let by = sql_ends_word(cur, cur.byte_len(), "by")
        if !lit.quoted[i] && by >= 0 && sql_ends_word(cur, by, "order") >= 0 {
            let x = vtexts[vi]
            let lits = lit_set(pfrom[i], pto[i])
            if lits.len() == 0 {
                error_tok(ptoks[i], "ORDER BY \{" + x + "}: a parameter here is a constant and sorts nothing", "let order = match " + x + " \{ \"price\" => \"price, id\", ... _ => return 400 \"bad sort\" }, then ORDER BY \{order}")
            } else if order_vi >= 0 {
                error_tok(ptoks[i], "one ORDER BY \{...} per query", "put the whole ORDER BY list in one string")
            } else if lits.len() > SQL_MAX_ORDERS {
                error_tok(ptoks[i], "ORDER BY \{" + x + "} has " + lits.len().to_str() + " variants, at most " + SQL_MAX_ORDERS.to_str(), "")
            } else {
                order_vi = vi
                order_lits = lits
            }
            cur = cur + "%%O%%" + next
            continue
        }
        if !lit.quoted[i] && sql_names_slot(cur, vk) {
            error_tok(ptoks[i], "\{" + vtexts[vi] + "} cannot name a table: values are sent as parameters, never as SQL text", "choose between whole queries with if/match")
        }
        if lit.quoted[i] {
            // '...{x}...' → ('...' || $n || '...'): скобки сохраняют приоритет
            // ('{d}'::date); в шаблоне LIKE % и _ значения — буквы
            if !in_lit {
                let q = sql_open_quote(cur)
                lit_like = q >= 0 && sql_like_context(cur, q)
                if q >= 0 {
                    cur = cur.byte_slice(0, q) + "(" + cur.byte_slice(q, cur.byte_len())
                    in_lit = true
                }
            }
            var pk = PK_TEXT
            if lit_like {
                pk = PK_LIKE
            }
            let no = sql_param_no(ps, pk, vt, vi, -1)
            cur = cur + "' || $" + no.to_str() + " || '"
            if in_lit {
                // закрывающая кавычка строки — в следующем куске (если там нет нового параметра)
                let close = sql_close_quote(next)
                if close >= 0 {
                    if lit_like && sql_starts_words(next.byte_slice(close + 1, next.byte_len()), ["escape"]) > 0 {
                        error_tok(ptoks[i], "ESCAPE with a value inside the pattern: % and _ in \{" + vtexts[vi] + "} are already escaped with \\", "drop the ESCAPE clause")
                    }
                    next = next.byte_slice(0, close + 1) + ")" + next.byte_slice(close + 1, next.byte_len())
                    in_lit = false
                }
            }
        } else if isnull > 0 || notnull > 0 {
            if vk != K_OPT {
                error_tok(ptoks[i], "\{" + vtexts[vi] + "} is " + ty_name(vt) + " and is never none, so IS NULL is always false here", "drop the IS NULL check, or make the value optional (" + ty_name(vt) + "?)")
            }
            let no = sql_param_no(ps, PK_ISNULL, ty_bool, vi, -1)
            if isnull > 0 {
                cur = cur + "$" + no.to_str()
                next = next.byte_slice(isnull, next.byte_len())
            } else {
                cur = cur + "(NOT $" + no.to_str() + ")"
                next = next.byte_slice(notnull, next.byte_len())
            }
        } else if vk == K_LIST && tkind(ty_elem(vt)) != K_STRUCT && sql_ends_in_open(cur) >= 0 && sql_starts_close(next) > 0 {
            // x IN ({xs}) → x = ANY($n); пустой список ничему не равен
            var head = cur.byte_slice(0, sql_ends_in_open(cur))
            var op = " = ANY($"
            let nt = sql_ends_word(head, head.byte_len(), "not")
            if nt >= 0 {
                head = head.byte_slice(0, nt)
                op = " <> ALL($"
            }
            let no = sql_param_no(ps, PK_VAL, vt, vi, -1)
            cur = head + op + no.to_str() + ")"
            next = next.byte_slice(sql_starts_close(next), next.byte_len())
        } else if (vk == K_STRUCT || (vk == K_LIST && tkind(ty_elem(vt)) == K_STRUCT)) && sql_insert_target(cur) {
            // INSERT INTO t {s}: поля структуры — столбцы; список структур — unnest
            let st = ty_inner(vt)
            var si = types[st].a
            if vk == K_LIST {
                si = types[ty_elem(vt)].a
            }
            let fs = structs[si].fields
            // таблица — для меток %%T (тип столбца) и %%D (DEFAULT столбца), которые
            // рантайм заменяет при запуске по каталогу базы (lib/db.kh)
            // имя — как написано (со схемой и кавычками): при запуске to_regclass
            // найдёт ту же таблицу, что и сам INSERT
            let table = cur.byte_slice(sql_insert_name_at(cur), sql_trim_end(cur))
            var names = ""
            var values = ""
            // для списка: столбцы unnest и что из них выбрать
            var cols = ""
            var picks = ""
            for j in 0..fs.len() {
                let f = fs[j]
                if j > 0 {
                    names = names + ", "
                    values = values + ", "
                    cols = cols + ", "
                    picks = picks + ", "
                }
                names = names + sql_ident(f.name)
                let mark = table + "." + f.name + "%%"
                // поле T? со значением none — DEFAULT столбца (без DEFAULT — NULL)
                let opt = tkind(f.ty) == K_OPT
                var fk = tkind(f.ty)
                if fk == K_OPT {
                    fk = tkind(ty_inner(f.ty))
                }
                if vk == K_LIST && fk == K_LIST {
                    // поле-список: unnest массива массивов не бывает — каждое
                    // значение едет как jsonb и становится массивом столбца
                    let no = sql_param_no(ps, PK_COLUMN, ty_list(f.ty), vi, j)
                    values = values + "$" + no.to_str() + "::jsonb[]"
                    let k = "k" + j.to_str()
                    cols = cols + k
                    let conv = "%%A:" + table + "." + f.name + ":" + k + "%%"
                    if opt {
                        picks = picks + "CASE WHEN " + k + " IS NULL THEN %%D:" + mark + " ELSE " + conv + " END"
                    } else {
                        picks = picks + conv
                    }
                } else if vk == K_LIST {
                    // unnest($n::<тип столбца>[]): дата, uuid, перечисление — как в таблице
                    let no = sql_param_no(ps, PK_COLUMN, ty_list(f.ty), vi, j)
                    values = values + "$" + no.to_str() + "::%%T:" + mark + "[]"
                    let k = "k" + j.to_str()
                    cols = cols + k
                    if opt {
                        picks = picks + "COALESCE(" + k + ", %%D:" + mark + ")"
                    } else {
                        picks = picks + k
                    }
                } else if opt {
                    let no = sql_param_no(ps, PK_FIELD, f.ty, vi, j)
                    values = values + "COALESCE($" + no.to_str() + "::%%T:" + mark + ", %%D:" + mark + ")"
                } else {
                    let no = sql_param_no(ps, PK_FIELD, f.ty, vi, j)
                    values = values + "$" + no.to_str()
                }
            }
            if vk == K_LIST {
                cur = cur + " (" + names + ") SELECT " + picks + " FROM unnest(" + values + ") AS u(" + cols + ")"
            } else {
                cur = cur + " (" + names + ") VALUES (" + values + ")"
            }
        } else if vk == K_STRUCT && sql_ends_word(cur, cur.byte_len(), "set") >= 0 {
            // SET {patch} — как JSON Merge Patch: поле T? без значения оставляет
            // столбец как был, явный null из JSON записывает NULL
            let fs = structs[types[vt].a].fields
            var parts = ""
            for j in 0..fs.len() {
                let f = fs[j]
                if j > 0 {
                    parts = parts + ", "
                }
                let no = sql_param_no(ps, PK_FIELD, f.ty, vi, j)
                let col = sql_ident(f.name)
                if tkind(f.ty) == K_OPT {
                    let given = sql_param_no(ps, PK_GIVEN, ty_bool, vi, j)
                    parts = parts + col + " = CASE WHEN $" + given.to_str() + " THEN $" + no.to_str() + " ELSE " + col + " END"
                } else {
                    parts = parts + col + " = $" + no.to_str()
                }
            }
            cur = cur + " " + parts
        } else {
            if vk == K_OPT && (sql_ends_cmp(cur) || sql_starts_cmp(next)) && !sql_in_set(cur) {
                cmp_v.push(vi)
                cmp_at.push(i)
            }
            let no = sql_param_no(ps, PK_VAL, vt, vi, -1)
            cur = cur + "$" + no.to_str()
        }
        cur = cur + next
    }
    for k in 0..cmp_v.len() {
        var guarded = false
        for p in ps {
            if p.kind == PK_ISNULL && p.v == cmp_v[k] {
                guarded = true
            }
        }
        if !guarded {
            let x = vtexts[cmp_v[k]]
            error_tok(ptoks[cmp_at[k]], "\{" + x + "} may be none, and a comparison with NULL is never true: rows would silently not match", "write (\{" + x + "} IS NULL OR column = \{" + x + "}), or unwrap it first: let v = " + x + " else \{ return 400 }")
        }
    }
    // варианты текста: по одному на строку ORDER BY {o}
    var texts: [str] = [cur]
    if order_lits.len() > 0 {
        texts = []
        for o in order_lits {
            let at_o = cur.byte_find("%%O%%") ?? 0
            texts.push(cur.byte_slice(0, at_o) + o + cur.byte_slice(at_o + 5, cur.byte_len()))
        }
        cur = texts[0]
    }
    sql_habits(at, cur)
    sql_rules(at, cur, shape)
    if shape == SH_ONE && !sql_one_row(cur) {
        sql_note_404(at)
    }
    // C: в маршруте запись после другого запроса вне tx — гонка «проверил, записал»
    let writes = sql_target_table(cur).byte_len() > 1 || sql_has_word(cur, "delete") || sql_has_word(cur, "merge")
    if route_ctx >= 0 && tx_depth == 0 && inline_depth == 0 {
        if writes && (sql_outside > 0 || loop_depth > 0) {
            var why = "another statement runs before it"
            if loop_depth > 0 {
                why = "it runs in a loop"
            }
            error_tok(at, "this write runs outside tx and " + why + ": another request can change the data in between", "put the statements of this request in tx \{ ... }")
        }
        sql_outside += 1
    }
    let first = sql_main_word(cur)
    let reads = first == "select" || first == "values" || first == "table"
    if shape == SH_COUNT && (reads || sql_top_returning(cur)) {
        error_tok(at, "sql needs to know the result type of this query", "let row: Row? = sql ... (one row or none), [Row] (all rows), Row (one row, 404 if none); Row is a type with the selected columns as fields")
    }
    // проверка против схемы из миграций (без базы) и места запроса в данных программы
    var sites: [int] = []
    var offs: [int] = []
    for text in texts {
        sq_check(at, lit, sql_unmark(text), shape, inner, ps)
        let off = sql_site(at, text, vtypes.len(), ps, shape, inner)
        offs.push(off)
        sites.push(DATA_BASE + off)
    }
    if order_lits.len() > 0 {
        // таблица вариантов: номер значения, число, затем пары (строка, место)
        let vt = desc_reserve(2 + 2 * order_lits.len())
        desc_put(vt, 0, order_vi)
        desc_put(vt, 1, order_lits.len())
        for j in 0..order_lits.len() {
            desc_put(vt, 2 + 2 * j, const_str(order_lits[j]))
            desc_put(vt, 3 + 2 * j, sites[j])
        }
        desc_put(offs[0], SITE_W_VARIANTS, DATA_BASE + vt)
    }
    let site = sites[0]
    sql_root()
    emit_mov_imm(RDI, site)
    emit_mov_rr(RSI, RSP)
    emit_call(rt_func("__db_run"))
    if vtypes.len() > 0 {
        emit_alu_imm(0, RSP, vtypes.len() * 8)
    }
    last_was_call = true
    return rt
}

// Параметр стоит на месте имени таблицы: FROM (верхнего уровня, не IS DISTINCT
// FROM), JOIN, UPDATE, INTO (кроме INSERT INTO t {структура}).
fn sql_names_slot(cur: str, vk: int) -> bool {
    let ws = sql_code_words(cur)
    let n = ws.len()
    if n == 0 {
        return false
    }
    let w = ws[n - 1].w
    if sql_ends_word(cur, cur.byte_len(), w) < 0 {
        return false
    }
    if w == "join" || w == "update" {
        return true
    }
    if w == "into" {
        return vk != K_STRUCT && vk != K_LIST
    }
    return w == "from" && ws[n - 1].depth == 0 && !(n > 1 && ws[n - 2].w == "distinct")
}

// Место запроса в данных программы (слова SITE_* из lib/db.kh) → смещение.
fn sql_site(at: Token, cur: str, nv: int, ps: [SqlParam], shape: int, inner: int) -> int {
    let off = desc_reserve(SITE_WORDS)
    let pt = desc_reserve(4 * ps.len() + 1)
    for i in 0..ps.len() {
        let p = ps[i]
        desc_put(pt, 4 * i, p.kind)
        desc_put(pt, 4 * i + 1, type_desc(p.ty))
        desc_put(pt, 4 * i + 2, p.v)
        desc_put(pt, 4 * i + 3, p.f)
    }
    desc_put(off, 0, const_str(cur))
    desc_put(off, 1, nv)
    desc_put(off, 2, ps.len())
    desc_put(off, 3, DATA_BASE + pt)
    desc_put(off, 4, shape)
    if shape != SH_COUNT {
        desc_put(off, 5, type_desc(inner))
    }
    desc_put(off, 6, const_str(src_place(at)))
    desc_put(off, 7, const_str(sql_target_table(cur)))
    desc_put(off, 8, sql_sites.len())
    let keys = sql_row_keys(cur, ps)
    if keys.len() > 0 {
        // число, затем пары («таблица.столбец», номер параметра с 0)
        let kt = desc_reserve(1 + 2 * keys.len())
        desc_put(kt, 0, keys.len())
        for j in 0..keys.len() {
            desc_put(kt, 1 + 2 * j, const_str(keys[j].name))
            desc_put(kt, 2 + 2 * j, keys[j].no)
        }
        desc_put(off, SITE_W_KEYS, DATA_BASE + kt)
    }
    sql_sites.push(DATA_BASE + off)
    return off
}

type SqlKey {
    name: str
    no: int
}

// Ключи строк для очереди повторов tx: для каждого «столбец = $n» в WHERE —
// «таблица.столбец» и номер параметра. Повтор после конфликта ждёт на ключах
// строк своей попытки: повторы за одну строку идут друг за другом, за разные —
// вместе. Неточный ключ стоит только лишнего ожидания, поэтому разбор простой:
// UPDATE, DELETE и SELECT из одной таблицы, сравнения до первого подзапроса.
fn sql_row_keys(cur: str, ps: [SqlParam]) -> [SqlKey] {
    var out: [SqlKey] = []
    let ws = sql_code_words(cur)
    if ws.len() < 2 {
        return out
    }
    var table = ""
    var where = -1
    let w0 = ws[0].w
    for x in ws {
        if x.depth == 0 && x.w == "from" && w0 == "select" && table.byte_len() == 0 {
            table = sql_name_at(cur, x.at + 4)
        }
        if x.depth == 0 && x.w == "where" && where < 0 {
            where = x.at + 5
        }
    }
    if w0 == "update" {
        var p = ws[0].at + 6
        if ws[1].w == "only" {
            p = ws[1].at + 4
        }
        table = sql_name_at(cur, p)
    } else if w0 == "delete" && ws[1].w == "from" {
        table = sql_name_at(cur, ws[1].at + 4)
    }
    if table.byte_len() == 0 || where < 0 {
        return out
    }
    // до первого подзапроса после WHERE
    var stop = cur.byte_len()
    for x in ws {
        if x.at > where && x.w == "select" && x.at < stop {
            stop = x.at
        }
    }
    let st = sql_states(cur)
    var i = where
    while i < stop {
        if st[i] != 0 || cur.byte(i) != '$' || i + 1 >= stop || !is_digit(cur.byte(i + 1)) {
            i += 1
            continue
        }
        var j = i + 1
        var no = 0
        while j < stop && is_digit(cur.byte(j)) {
            no = no * 10 + cur.byte(j) - '0'
            j += 1
        }
        // перед $n: «=», а не <=, >=, !=, :=, ==
        var k = i - 1
        while k > where && sql_space(cur.byte(k)) {
            k -= 1
        }
        // столбец слева: col, "Col" или t.col (таблица — главная, псевдоним не
        // разбираем)
        var col = ""
        let pc = cur.byte(k - 1)
        if cur.byte(k) == '=' && pc != '<' && pc != '>' && pc != '!' && pc != ':' && pc != '=' {
            k -= 1
            while k > where && sql_space(cur.byte(k)) {
                k -= 1
            }
            let b = buf_new(16)
            let e = k + 1
            while k >= where && (is_ident_char(cur.byte(k)) || cur.byte(k) == '"') {
                k -= 1
            }
            var q = k + 1
            let quoted = q < e && cur.byte(q) == '"'
            while q < e {
                if cur.byte(q) != '"' {
                    if quoted {
                        buf_byte(b, cur.byte(q))
                    } else {
                        buf_byte(b, sql_lower(cur.byte(q)))
                    }
                }
                q += 1
            }
            col = buf_str(b)
        }
        if col.byte_len() > 0 && !is_digit(col.byte(0)) && no >= 1 && no <= ps.len() && ps[no - 1].kind == PK_VAL {
            var dup = false
            for x in out {
                dup = dup || (x.no == no - 1 && x.name == table + "." + col)
            }
            if !dup {
                out.push(SqlKey { name: table + "." + col, no: no - 1 })
            }
        }
        i = j
    }
    return out
}

// Слово w в коде запроса (вне строк, имён в кавычках и комментариев).
fn sql_has_word(s: str, w: str) -> bool {
    for x in sql_code_words(s) {
        if x.w == w {
            return true
        }
    }
    return false
}

// RETURNING на верхнем уровне (не внутри WITH (...)).
fn sql_top_returning(s: str) -> bool {
    for x in sql_code_words(s) {
        if x.w == "returning" && x.depth == 0 {
            return true
        }
    }
    return false
}

// Главная команда: для WITH ... — первая SELECT/INSERT/UPDATE/DELETE/MERGE вне скобок.
fn sql_main_word(s: str) -> str {
    let ws = sql_code_words(s)
    if ws.len() == 0 {
        return ""
    }
    if ws[0].w != "with" {
        return ws[0].w
    }
    for x in ws {
        if x.depth == 0 && (x.w == "select" || x.w == "insert" || x.w == "update" || x.w == "delete" || x.w == "merge" || x.w == "values") {
            return x.w
        }
    }
    return "with"
}

// Текст выражения параметра (для сообщений).
fn sql_tok_text(from: int, to: int) -> str {
    var s = ""
    var i = from
    while i < to {
        let t = toks[i]
        if i > from && t.kind != '.' && toks[i - 1].kind != '.' && t.kind != '(' && t.kind != ')' && t.kind != '[' && t.kind != ']' && toks[i - 1].kind != '(' && toks[i - 1].kind != '[' {
            s = s + " "
        }
        s = s + t.text
        i += 1
    }
    return s
}

// Закрывающая кавычка строки '...', которая открыта в начале s (s начинается
// внутри неё), или -1. '' внутри — экранированная кавычка.
fn sql_close_quote(s: str) -> int {
    var i = 0
    let n = s.byte_len()
    while i < n {
        if sql_ch && s.byte(i) == '\\' {
            // ClickHouse: \' — кавычка внутри строки
            i += 2
            continue
        }
        if s.byte(i) == '\'' {
            if i + 1 < n && s.byte(i + 1) == '\'' {
                i += 2
                continue
            }
            return i
        }
        i += 1
    }
    return -1
}

// Строка '...' с начала q — шаблон LIKE: до неё в том же условии стоит LIKE,
// ILIKE или ~~ (name LIKE lower('%{q}%'), LIKE ANY (ARRAY['%{q}%']), ~~*).
fn sql_like_context(cur: str, q: int) -> bool {
    let head = cur.byte_slice(0, q)
    let ws = sql_code_words(head)
    var bound = 0
    var i = ws.len() - 1
    while i >= 0 {
        let w = ws[i].w
        // в ClickHouse — и функции notLike(s, p), notILike(s, p)
        if w == "like" || w == "ilike" || (sql_ch && (w == "notlike" || w == "notilike")) {
            return true
        }
        if w == "and" || w == "or" || w == "where" || w == "on" || w == "when" || w == "then" || w == "else" || w == "having" || w == "select" || w == "set" || w == "returning" || w == "values" {
            bound = ws[i].at
            i = -1
        }
        i -= 1
    }
    let st = sql_states(head)
    for j in bound..q - 1 {
        if st[j] == 0 && head.byte(j) == '~' && head.byte(j + 1) == '~' {
            return true
        }
    }
    return false
}

// Параметр — значение присваивания SET col = {x} (а не сравнение): ближайшее
// слово-раздел перед ним — SET.
fn sql_in_set(cur: str) -> bool {
    let ws = sql_code_words(cur)
    // глубина скобок у самого параметра
    let st = sql_states(cur)
    var depth = 0
    for j in 0..cur.byte_len() {
        if st[j] == 0 {
            if cur.byte(j) == '(' {
                depth += 1
            } else if cur.byte(j) == ')' {
                depth -= 1
            }
        }
    }
    var cases = 0
    var i = ws.len() - 1
    while i >= 0 {
        let x = ws[i]
        i -= 1
        if x.depth > depth {
            // подзапрос или вызов в прежнем элементе списка SET
            continue
        }
        if x.depth < depth {
            // параметр в скобках: (nick = {x}) — это сравнение
            return false
        }
        let w = x.w
        // CASE ... END прежнего элемента: идя назад, END открывает, CASE закрывает
        if w == "end" {
            cases += 1
            continue
        }
        if cases > 0 {
            if w == "case" {
                cases -= 1
            }
            continue
        }
        if w == "set" {
            return true
        }
        if w == "where" || w == "on" || w == "having" || w == "when" || w == "then" || w == "else" || w == "and" || w == "or" || w == "not" || w == "select" || w == "returning" || w == "values" || w == "case" || w == "join" || w == "using" || w == "from" || w == "limit" || w == "offset" || w == "by" || w == "filter" {
            return false
        }
    }
    return false
}

// Сравнение перед параметром: = <> != < > <= >= LIKE ILIKE (но не IS DISTINCT FROM,
// не => и ->).
fn sql_ends_cmp(cur: str) -> bool {
    let e = sql_trim_end(cur)
    if e == 0 {
        return false
    }
    if e >= 2 && (cur.byte_slice(e - 2, e) == "=>" || cur.byte_slice(e - 2, e) == "->" || cur.byte_slice(e - 2, e) == "#>") {
        return false
    }
    if e >= 3 && (cur.byte_slice(e - 3, e) == "->>" || cur.byte_slice(e - 3, e) == "#>>") {
        return false
    }
    let c = cur.byte(e - 1)
    if c == '=' || c == '<' || c == '>' {
        return true
    }
    return sql_ends_word(cur, e, "like") >= 0 || sql_ends_word(cur, e, "ilike") >= 0
}

// Сравнение после параметра: {x} = col.
fn sql_starts_cmp(next: str) -> bool {
    var p = 0
    while p < next.byte_len() && sql_space(next.byte(p)) {
        p += 1
    }
    if p >= next.byte_len() {
        return false
    }
    let c = next.byte(p)
    if c == '=' || c == '<' || c == '>' || (c == '!' && p + 1 < next.byte_len() && next.byte(p + 1) == '=') {
        return true
    }
    return sql_starts_words(next, ["like"]) > 0 || sql_starts_words(next, ["ilike"]) > 0
}

// cur кончается на «IN (»? → позиция начала IN или -1.
fn sql_ends_in_open(cur: str) -> int {
    var e = sql_trim_end(cur)
    if e == 0 || cur.byte(e - 1) != '(' {
        return -1
    }
    return sql_ends_word(cur, e - 1, "in")
}

// next начинается (после пробелов) с «)»? → сколько символов занимает.
fn sql_starts_close(next: str) -> int {
    var p = 0
    while p < next.byte_len() && sql_space(next.byte(p)) {
        p += 1
    }
    if p < next.byte_len() && next.byte(p) == ')' {
        return p + 1
    }
    return 0
}

// Текст без меток (для проверки без базы): «::%%T:...%%» и «[]» после неё
// убираются, %%D:...%% — NULL.
fn sql_unmark(s: str) -> str {
    if !s.contains("%%") {
        return s
    }
    let b = buf_new(s.byte_len())
    var i = 0
    let n = s.byte_len()
    while i < n {
        let cast = i + 5 < n && s.byte(i) == ':' && s.byte(i + 1) == ':' && s.byte(i + 2) == '%' && s.byte(i + 3) == '%' && s.byte(i + 4) == 'T'
        if cast || (i + 3 < n && s.byte(i) == '%' && s.byte(i + 1) == '%' && (s.byte(i + 2) == 'D' || s.byte(i + 2) == 'A') && s.byte(i + 3) == ':') {
            var j = i + 4
            while j + 1 < n && !(s.byte(j) == '%' && s.byte(j + 1) == '%') {
                j += 1
            }
            i = j + 2
            if !cast {
                buf_add(b, "NULL")
            } else if i + 1 < n && s.byte(i) == '[' && s.byte(i + 1) == ']' {
                i += 2
            }
            continue
        }
        buf_byte(b, s.byte(i))
        i += 1
    }
    return buf_str(b)
}

// Начало имени таблицы в конце cur («INSERT INTO имя»).
fn sql_insert_name_at(cur: str) -> int {
    var s = sql_trim_end(cur)
    while s > 0 && sql_word_char(cur.byte(s - 1)) {
        s -= 1
    }
    return s
}

// cur кончается на «INSERT INTO имя»?
fn sql_insert_target(cur: str) -> bool {
    var e = sql_trim_end(cur)
    var s = e
    while s > 0 && sql_word_char(cur.byte(s - 1)) {
        s -= 1
    }
    if s == e {
        return false
    }
    return sql_ends_word(cur, s, "into") >= 0 && sql_ends_word(cur, sql_ends_word(cur, s, "into"), "insert") >= 0
}

// ============================================================================
// ch "...": запрос к ClickHouse (docs/design/v0.13-drivers.md §2.8, §3.2).
// Тот же разбор, что у sql, с переключателями диалекта: {x} — параметр
// {pN:Тип} (тип — из типа Khrip), IS NULL — тот же параметр Nullable(T),
// IN ({xs}) — IN {pN:Array(T)}, '%{q}%' — concat(...). Место запроса — в
// данных программы (слова CHS_* в lib/chdb.kh); при запуске его проверяет
// сервер (DESCRIBE), исполняет __chdb_run.
// ============================================================================

// Виды операторов ch (слово места CHS_KIND)
const CHK_ROWS = 1
const CHK_KILL = 2
const CHK_INSERT_SELECT = 3
const CHK_MUTATION = 4
const CHK_STATEMENT = 5

// Слова места ch (lib/chdb.kh CHS_*)
const CH_SITE_WORDS = 24
const CHS_W_VARIANTS = 9

var ch_sites: [int]
var ch_root_used: bool
var ch_root_off: int
// в программе есть ClickHouse: ch "...", table, clickhouse ИМЯ =, migration ch
var uses_ch: bool

// Корень для рантайма (__chdb_root): [0] места ch, [1] соединения, [2] таблицы,
// [3] миграции, [4] места вставки t.insert.
fn ch_root() -> int {
    if !ch_root_used {
        ch_root_used = true
        ch_root_off = desc_reserve(8)
    }
    return DATA_BASE + ch_root_off
}

// Тип параметра ClickHouse для значения Khrip типа t; "" — не бывает.
fn ch_param_type(t: int) -> str {
    let k = tkind(t)
    if k == K_INT {
        return "Int64"
    }
    if k == K_FLOAT {
        return "Float64"
    }
    if k == K_BOOL {
        return "Bool"
    }
    if k == K_STR || is_enum(t) {
        return "String"
    }
    if k == K_LIST {
        let e = ch_param_type(ty_elem(t))
        if e.byte_len() == 0 {
            return ""
        }
        return "Array(" + e + ")"
    }
    if k == K_MAP {
        let kt = ch_param_type(types[t].a)
        let vt = ch_param_type(types[t].b)
        if kt.byte_len() == 0 || vt.byte_len() == 0 || kt.starts_with("Nullable") {
            return ""
        }
        return "Map(" + kt + ", " + vt + ")"
    }
    if k == K_OPT {
        let inner = ty_inner(t)
        let ik = tkind(inner)
        if ik == K_LIST || ik == K_MAP {
            return ""
        }
        let e = ch_param_type(inner)
        if e.byte_len() == 0 {
            return ""
        }
        return "Nullable(" + e + ")"
    }
    return ""
}

// Слово x — раздел запроса, а не столбец с тем же именем: LIMIT и OFFSET —
// перед числом или {параметром}, SETTINGS — перед «имя =», FORMAT — перед
// именем формата, после которого запрос кончается (или идёт SETTINGS).
fn ch_clause_word(s: str, st: [int], x: SqlWord) -> bool {
    if x.at > 0 && s.byte(x.at - 1) == '.' {
        return false
    }
    let n = s.byte_len()
    let p = ch_next_code(s, st, x.at + x.w.byte_len())
    if p >= n {
        return false
    }
    let c = s.byte(p)
    if x.w == "limit" || x.w == "offset" {
        return is_digit(c) || c == '\{'
    }
    if x.w != "settings" && x.w != "format" {
        return true
    }
    if !is_alpha(c) {
        return false
    }
    var q = p
    while q < n && is_ident_char(s.byte(q)) {
        q += 1
    }
    let r = ch_next_code(s, st, q)
    if x.w == "settings" {
        return r < n && s.byte(r) == '=' && !(r + 1 < n && s.byte(r + 1) == '=')
    }
    return r >= n || s.byte(r) == ';' || sql_starts_words(s.byte_slice(r, n), ["settings"]) > 0
}

// Следующий байт кода (не пробел, не строка, не комментарий) с позиции p0; n — нет.
fn ch_next_code(s: str, st: [int], p0: int) -> int {
    var p = p0
    let n = s.byte_len()
    while p < n && (sql_space(s.byte(p)) || st[p] != 0) {
        p += 1
    }
    return p
}

// Параметр — граница BETWEEN: cur кончается на BETWEEN или на BETWEEN ... AND.
fn ch_between_bound(cur: str) -> bool {
    let e = sql_trim_end(cur)
    if sql_ends_word(cur, e, "between") >= 0 {
        return true
    }
    if sql_ends_word(cur, e, "and") < 0 {
        return false
    }
    let ws = sql_code_words(cur)
    let n = ws.len()
    var i = n - 2
    while i >= 0 {
        let w = ws[i].w
        if w == "between" && ws[i].depth == ws[n - 1].depth {
            return true
        }
        if w == "and" || w == "or" || w == "where" || w == "prewhere" || w == "having" || w == "on" || w == "select" || w == "when" {
            return false
        }
        i -= 1
    }
    return false
}

// Незакрытые «(» кода в cur — позиции, от внешней к внутренней.
fn ch_open_parens(cur: str, st: [int]) -> [int] {
    var opens: [int] = []
    var depth = 0
    for j in 0..cur.byte_len() {
        if st[j] == 0 {
            let c = cur.byte(j)
            if c == '(' {
                if depth < opens.len() {
                    opens[depth] = j
                } else {
                    opens.push(j)
                }
                depth += 1
            } else if c == ')' && depth > 0 {
                depth -= 1
            }
        }
    }
    var out: [int] = []
    for k in 0..depth {
        out.push(opens[k])
    }
    return out
}

// Слово кода прямо перед «(» на позиции p (имя функции, IN) в нижнем регистре.
fn ch_word_before(cur: str, st: [int], p: int) -> str {
    var e = p
    while e > 0 && sql_space(cur.byte(e - 1)) && st[e - 1] == 0 {
        e -= 1
    }
    var b = e
    while b > 0 && is_ident_char(cur.byte(b - 1)) && st[b - 1] == 0 {
        b -= 1
    }
    return cur.byte_slice(b, e).ascii_lower()
}

// Функции, которые сами разбирают NULL: значение в них — не ловушка.
fn ch_null_aware(name: str) -> bool {
    return name == "coalesce" || name == "ifnull" || name == "isnull" || name == "isnotnull" || name == "assumenotnull" || name == "nullif" || name == "tonullable" || name == "if" || name == "multiif" || name == "isnullable"
}

// Параметр — аргумент isNull(...)/isNotNull(...): та же проверка, что IS NULL.
fn ch_null_check_call(cur: str) -> bool {
    let st = sql_states(cur)
    let opens = ch_open_parens(cur, st)
    if opens.len() == 0 {
        return false
    }
    let name = ch_word_before(cur, st, opens[opens.len() - 1])
    return name == "isnull" || name == "isnotnull"
}

// Параметр — аргумент функции или элемент IN (...) внутри условия WHERE,
// PREWHERE, HAVING или ON: с none вызов даст NULL, и строка не подойдёт.
// coalesce, ifNull и подобные вокруг — защита.
fn ch_null_arg(cur: str) -> bool {
    let st = sql_states(cur)
    let opens = ch_open_parens(cur, st)
    let d = opens.len()
    if d == 0 {
        return false
    }
    for k in 0..d {
        if ch_null_aware(ch_word_before(cur, st, opens[k])) {
            return false
        }
    }
    let name = ch_word_before(cur, st, opens[d - 1])
    if name.byte_len() == 0 {
        return false
    }
    for kw in ["and", "or", "not", "where", "prewhere", "having", "on", "when", "then", "else", "select", "from", "exists", "using", "join", "as", "values", "by", "array", "tuple"] {
        if name == kw {
            return false
        }
    }
    // раздел, в котором стоит вызов
    let ws = sql_code_words(cur)
    var i = ws.len() - 1
    while i >= 0 {
        let x = ws[i]
        i -= 1
        if x.depth >= d {
            continue
        }
        let w = x.w
        if w == "where" || w == "prewhere" || w == "having" || w == "on" {
            return true
        }
        if w == "select" || w == "by" || w == "from" || w == "limit" || w == "settings" || w == "set" || w == "values" || w == "join" || w == "using" || w == "update" || w == "with" {
            return false
        }
    }
    return false
}

// Параметр стоит в SETTINGS (последнее слово-раздел перед ним — SETTINGS).
fn ch_settings_slot(cur: str) -> bool {
    let ws = sql_code_words(cur)
    let st = sql_states(cur)
    var i = ws.len() - 1
    while i >= 0 {
        let w = ws[i].w
        if w == "settings" && ws[i].depth == 0 && ch_clause_word(cur, st, ws[i]) {
            return true
        }
        if w == "select" || w == "where" || w == "from" || w == "format" || w == "values" || w == "having" || w == "limit" {
            return false
        }
        i -= 1
    }
    return false
}

// Параметр на месте имени таблицы: FROM, JOIN, INTO, TABLE, UPDATE.
fn ch_names_slot(cur: str, vk: int) -> bool {
    let ws = sql_code_words(cur)
    let n = ws.len()
    if n == 0 {
        return false
    }
    let w = ws[n - 1].w
    if sql_ends_word(cur, cur.byte_len(), w) < 0 {
        return false
    }
    if w == "table" {
        return true
    }
    return sql_names_slot(cur, vk)
}

// x IN ({xs}) / x IN {xs}: → позиция в cur, с которой заменить хвост, и
// сколько символов next убрать (закрывающая скобка); -1 — не IN.
fn ch_in_head(cur: str) -> int {
    var e = sql_trim_end(cur)
    if e > 0 && cur.byte(e - 1) == '(' {
        if sql_ends_word(cur, e - 1, "in") >= 0 {
            return e - 1
        }
        return -1
    }
    if sql_ends_word(cur, e, "in") >= 0 {
        return e
    }
    return -1
}

// Связать ch ИМЯ с соединением: номер в ch_conns (0 — CLICKHOUSE_URL).
fn ch_conn_of(name: str, at: Token, col: int) -> int {
    if name.byte_len() == 0 {
        return 0
    }
    let ci = ch_conn_find(name)
    if ci < 0 {
        let t = Token { kind: T_IDENT, val: 0, text: name, line: at.line, col: col, file: at.file }
        error_tok(t, "unknown connection " + name, "declare it: clickhouse " + name + " = env(\"" + sql_upper(name) + "_CLICKHOUSE_URL\")")
        return 0
    }
    return ci
}

fn parse_ch(w: int) -> int {
    let at = tok()
    let lit = sqllits[at.val]
    if in_global_init {
        error_tok(at, "ch in the initial value of a global runs before the database is connected", "compute it in main, a route or an every task")
    }
    if tx_depth > 0 && !files[at.file].is_lib {
        error_tok(at, "ch inside tx: the block may run again after a conflict, and ClickHouse is not part of it", "call it before or after the tx block")
    }
    let conn = ch_conn_of(lit.conn, at, lit.conn_col)
    advance()
    let n = lit.quoted.len()
    let sv = sql_parse_values(lit)
    if !sv.ok {
        return ty_err
    }
    let vals = sv.vals
    let vtypes = sv.vtypes
    let vtexts = sv.vtexts
    let ptoks = sv.ptoks
    // форма результата — из ожидаемого типа
    var shape = SH_COUNT
    var rt = ty_int
    var inner = ty_err
    var explicit = false
    let optional_follow = kind() == T_ELSE || kind() == T_QQ
    if w != ty_err && w != ty_void && w != ty_never && w != ty_none {
        if is_db_result(w) {
            explicit = true
            rt = w
        } else if tkind(w) == K_LIST {
            shape = SH_LIST
            inner = ty_elem(w)
            rt = w
            if tkind(inner) == K_OPT && tkind(ty_inner(inner)) == K_STRUCT {
                error_tok(at, "a row is never none: a list of rows is " + ty_name(ty_list(ty_inner(inner))), "let rows: " + ty_name(ty_list(ty_inner(inner))) + " = ch ...")
            }
        } else if tkind(w) == K_OPT {
            shape = SH_OPT
            inner = ty_inner(w)
            rt = w
        } else if optional_follow {
            shape = SH_OPT
            inner = w
            rt = ty_opt(w)
        } else {
            shape = SH_ONE
            inner = w
            rt = w
        }
    }
    sql_ch = true
    var cur = lit.segs[0]
    var ps: [SqlParam] = []
    var pnames: [str] = []
    // сравнения с T? без проверки IS NULL: номер значения и место; значения с IS NULL
    var cmp_v: [int] = []
    var cmp_at: [int] = []
    var guarded: [int] = []
    var in_lit = false
    var lit_like = false
    // строка с параметром стоит там, где NULL не даст строке подойти
    var lit_trap = false
    var order_vi = -1
    var order_lits: [str] = []
    for i in 0..n {
        let vi = vals[i]
        let vt = vtypes[vi]
        var next = lit.segs[i + 1]
        let vk = tkind(vt)
        let x = vtexts[vi]
        let pt = ptoks[i]
        let isnull = sql_starts_words(next, ["is", "null"])
        let notnull = sql_starts_words(next, ["is", "not", "null"])
        let by = sql_ends_word(cur, cur.byte_len(), "by")
        if !lit.quoted[i] && by >= 0 && sql_ends_word(cur, by, "order") >= 0 {
            let lits = lit_set(sv.pfrom[i], sv.pto[i])
            if lits.len() == 0 {
                error_tok(pt, "ORDER BY \{" + x + "}: a parameter here is a constant and sorts nothing", "let order = match " + x + " \{ \"price\" => \"price, id\", ... _ => return 400 \"bad sort\" }, then ORDER BY \{order}")
            } else if order_vi >= 0 {
                error_tok(pt, "one ORDER BY \{...} per query", "put the whole ORDER BY list in one string")
            } else if lits.len() > SQL_MAX_ORDERS {
                error_tok(pt, "ORDER BY \{" + x + "} has " + lits.len().to_str() + " variants, at most " + SQL_MAX_ORDERS.to_str(), "")
            } else {
                order_vi = vi
                order_lits = lits
            }
            cur = cur + "%%O%%" + next
            continue
        }
        let row_like = vk == K_STRUCT || (vk == K_SUM && !is_enum(vt)) || (vk == K_LIST && (tkind(ty_elem(vt)) == K_STRUCT || (tkind(ty_elem(vt)) == K_SUM && !is_enum(ty_elem(vt)))))
        if !lit.quoted[i] && row_like && sql_insert_target(cur) {
            let table = cur.byte_slice(sql_insert_name_at(cur), sql_trim_end(cur)).replace("`", "")
            error_tok(pt, "insert rows with " + table + ".insert(rows)", ch_table_hint(table))
            cur = cur + "NULL" + next
            continue
        }
        if row_like {
            error_tok(pt, "a struct cannot be a ClickHouse parameter", "insert rows with " + ch_some_table() + ".insert(rows)")
            cur = cur + "NULL" + next
            continue
        }
        if vk == K_OPT && (tkind(ty_inner(vt)) == K_LIST || tkind(ty_inner(vt)) == K_MAP) {
            error_tok(pt, ty_name(vt) + " cannot be a ClickHouse parameter: arrays are never NULL", "use [] for none")
            cur = cur + "NULL" + next
            continue
        }
        if !lit.quoted[i] && ch_settings_slot(cur) {
            error_tok(pt, "values cannot go into SETTINGS: ClickHouse settings are literals", "")
        }
        if !lit.quoted[i] && ch_names_slot(cur, vk) {
            error_tok(pt, "\{" + x + "} cannot name a table: values are sent as parameters, never as SQL text", "choose between whole queries with if/match")
        }
        let ptype = ch_param_type(vt)
        if ptype.byte_len() == 0 && !lit.quoted[i] {
            error_tok(pt, ty_name(vt) + " cannot be a ClickHouse parameter", "send int, float, bool, str, enums, lists, maps or their optionals")
            cur = cur + "NULL" + next
            continue
        }
        if lit.quoted[i] {
            // '...{x}...' → concat('...', {pN:String}, '...'); в шаблоне LIKE
            // \, % и _ значения — буквы
            if !in_lit {
                let q = sql_open_quote(cur)
                lit_like = q >= 0 && sql_like_context(cur, q)
                if q >= 0 {
                    let head = cur.byte_slice(0, q)
                    lit_trap = lit_like || (sql_ends_cmp(head) && !sql_in_set(head)) || ch_null_arg(head)
                    cur = cur.byte_slice(0, q) + "concat(" + cur.byte_slice(q, cur.byte_len())
                    in_lit = true
                }
            }
            var pk = PK_TEXT
            if lit_like {
                pk = PK_LIKE
            }
            var stype = "String"
            if vk == K_OPT {
                stype = "Nullable(String)"
                // '%{q}%' с none — NULL: LIKE и сравнение не подойдут ни к чему
                if lit_trap {
                    cmp_v.push(vi)
                    cmp_at.push(i)
                }
            }
            let no = sql_param_no(ps, pk, vt, vi, -1)
            ch_param_name(pnames, no, x)
            cur = cur + "', \{p" + no.to_str() + ":" + stype + "}, '"
            if in_lit {
                let close = sql_close_quote(next)
                if close >= 0 {
                    if lit_like && sql_starts_words(next.byte_slice(close + 1, next.byte_len()), ["escape"]) > 0 {
                        error_tok(pt, "ESCAPE with a value inside the pattern: % and _ in \{" + x + "} are already escaped with \\", "drop the ESCAPE clause")
                    }
                    next = next.byte_slice(0, close + 1) + ")" + next.byte_slice(close + 1, next.byte_len())
                    in_lit = false
                }
            }
        } else if isnull > 0 || notnull > 0 {
            if vk != K_OPT {
                error_tok(pt, "\{" + x + "} is " + ty_name(vt) + " and is never none, so IS NULL is always false here", "drop the IS NULL check, or make the value optional (" + ty_name(vt) + "?)")
            }
            let no = sql_param_no(ps, PK_VAL, vt, vi, -1)
            ch_param_name(pnames, no, x)
            guarded.push(vi)
            cur = cur + "\{p" + no.to_str() + ":" + ptype + "}"
        } else if vk == K_LIST && ch_in_head(cur) >= 0 && (ch_in_head(cur) == sql_trim_end(cur) || sql_starts_close(next) > 0) {
            // x IN ({xs}) и x IN {xs} → IN {pN:Array(T)}; пустой список ничему не равен
            let head = ch_in_head(cur)
            let paren = head < sql_trim_end(cur)
            let no = sql_param_no(ps, PK_VAL, vt, vi, -1)
            ch_param_name(pnames, no, x)
            cur = cur.byte_slice(0, head) + " \{p" + no.to_str() + ":" + ptype + "}"
            if paren {
                next = next.byte_slice(sql_starts_close(next), next.byte_len())
            }
        } else {
            if vk == K_OPT && (((sql_ends_cmp(cur) || sql_starts_cmp(next)) && !sql_in_set(cur)) || ch_between_bound(cur) || ch_null_arg(cur)) {
                cmp_v.push(vi)
                cmp_at.push(i)
            }
            if vk == K_OPT && ch_null_check_call(cur) {
                guarded.push(vi)
            }
            let no = sql_param_no(ps, PK_VAL, vt, vi, -1)
            ch_param_name(pnames, no, x)
            cur = cur + "\{p" + no.to_str() + ":" + ptype + "}"
        }
        cur = cur + next
    }
    for k in 0..cmp_v.len() {
        var safe = false
        for g in guarded {
            if g == cmp_v[k] {
                safe = true
            }
        }
        if !safe {
            let x = vtexts[cmp_v[k]]
            error_tok(ptoks[cmp_at[k]], "\{" + x + "} may be none, and a comparison with NULL is never true: rows would silently not match", "write (\{" + x + "} IS NULL OR column = \{" + x + "}), or unwrap it first: let v = " + x + " else \{ return 400 }")
        }
    }
    var texts: [str] = [cur]
    if order_lits.len() > 0 {
        texts = []
        for o in order_lits {
            let at_o = cur.byte_find("%%O%%") ?? 0
            texts.push(cur.byte_slice(0, at_o) + o + cur.byte_slice(at_o + 5, cur.byte_len()))
        }
        cur = texts[0]
    }
    let kind = ch_rules(at, cur, shape)
    let rows = kind == CHK_ROWS || kind == CHK_KILL
    if kind == CHK_ROWS && shape == SH_COUNT && !explicit {
        error_tok(at, "ch needs to know the result type of this query", "let rows: [Row] = ch ...")
    }
    if explicit && rows {
        error_tok(at, "a failed read ends the request; DbResult is for writes", "let rows: [Row] = ch ...")
    }
    // число строк ClickHouse сообщает только у INSERT ... SELECT (written_rows);
    // мутации, DELETE FROM, TRUNCATE и прочие его не считают
    let counted = kind == CHK_INSERT_SELECT
    if !rows && counted && (shape == SH_LIST || shape == SH_OPT || (shape == SH_ONE && inner != ty_int)) {
        error_tok(at, "this ch statement returns no rows: it gives the number of written rows (int) or a DbResult", "drop the type, or write let n: int = ch ...")
    } else if !rows && !counted && shape != SH_COUNT {
        error_tok(at, "this ch statement gives no row count: ClickHouse does not count the rows of ALTER UPDATE/DELETE, DELETE FROM, TRUNCATE and the like", "write it as a statement, or let r: DbResult = ch ... to check the outcome")
    }
    if kind == CHK_KILL && shape == SH_ONE && inner == ty_int {
        // KILL QUERY ... в int — сколько запросов найдено
        shape = SH_COUNT
    }
    if shape == SH_ONE && kind == CHK_ROWS && !ch_one_row(cur) {
        sql_note_404(at)
    }
    var sites: [int] = []
    var offs: [int] = []
    for text in texts {
        let off = ch_site(at, text, vtypes.len(), ps, pnames, shape, inner, kind, conn, explicit)
        offs.push(off)
        sites.push(DATA_BASE + off)
    }
    sql_ch = false
    if order_lits.len() > 0 {
        let vt = desc_reserve(2 + 2 * order_lits.len())
        desc_put(vt, 0, order_vi)
        desc_put(vt, 1, order_lits.len())
        for j in 0..order_lits.len() {
            desc_put(vt, 2 + 2 * j, const_str(order_lits[j]))
            desc_put(vt, 3 + 2 * j, sites[j])
        }
        desc_put(offs[0], CHS_W_VARIANTS, DATA_BASE + vt)
    }
    ch_root()
    emit_mov_imm(RDI, sites[0])
    emit_mov_rr(RSI, RSP)
    emit_call(rt_func("__chdb_run"))
    if vtypes.len() > 0 {
        emit_alu_imm(0, RSP, vtypes.len() * 8)
    }
    last_was_call = true
    if explicit {
        return rt
    }
    if shape == SH_COUNT && !rows && !counted {
        return ty_void
    }
    if shape == SH_COUNT {
        return ty_int
    }
    return rt
}

// Имя параметра pN → текст выражения (для сообщений при запуске).
fn ch_param_name(names: [str], no: int, x: str) {
    while names.len() < no {
        names.push("")
    }
    names[no - 1] = x
}

// Подсказка E-CH2: объявить таблицу (или она уже объявлена).
fn ch_table_hint(table: str) -> str {
    if ch_table_find_server(table) >= 0 {
        return ""
    }
    var ty = table
    if ty.byte_len() > 1 && ty.ends_with("s") {
        ty = ty.byte_slice(0, ty.byte_len() - 1)
    }
    if ty.byte_len() > 0 && ty.byte(0) >= 'a' && ty.byte(0) <= 'z' {
        ty = sql_upper(ty.byte_slice(0, 1)) + ty.byte_slice(1, ty.byte_len())
    }
    return "declare the table: table " + table + ": " + ty
}

// Таблица для подсказок: первая объявленная или events.
fn ch_some_table() -> str {
    if ch_tables.len() > 0 {
        return ch_tables[0].name
    }
    return "events"
}

// Место ch в данных программы (слова CHS_* в lib/chdb.kh) → смещение.
fn ch_site(at: Token, cur: str, nv: int, ps: [SqlParam], pnames: [str], shape: int, inner: int, kind: int, conn: int, explicit: bool) -> int {
    let off = desc_reserve(CH_SITE_WORDS)
    let pt = desc_reserve(4 * ps.len() + 1)
    for i in 0..ps.len() {
        let p = ps[i]
        desc_put(pt, 4 * i, p.kind)
        desc_put(pt, 4 * i + 1, type_desc(p.ty))
        desc_put(pt, 4 * i + 2, p.v)
        var name = ""
        if i < pnames.len() {
            name = pnames[i]
        }
        desc_put(pt, 4 * i + 3, const_str(name))
    }
    desc_put(off, 0, const_str(cur))
    desc_put(off, 1, nv)
    desc_put(off, 2, ps.len())
    desc_put(off, 3, DATA_BASE + pt)
    desc_put(off, 4, shape)
    if shape != SH_COUNT {
        desc_put(off, 5, type_desc(inner))
    }
    if shape == SH_OPT {
        desc_put(off, 13, type_desc(ty_opt(inner)))
    }
    desc_put(off, 6, const_str(src_place(at)))
    desc_put(off, 7, kind)
    desc_put(off, 8, conn)
    desc_put(off, 10, ch_sites.len())
    if explicit {
        desc_put(off, 11, 1)
    }
    desc_put(off, 12, const_str(ch_main_table(cur)))
    desc_put(off, 15, const_str(ch_check_query(cur, kind)))
    if kind == CHK_INSERT_SELECT {
        desc_put(off, 16, const_str(ch_insert_columns(cur)))
    }
    ch_sites.push(DATA_BASE + off)
    return off
}

// INSERT INTO t (a, b) SELECT ...: явный список столбцов «a,b»; "" — нет.
fn ch_insert_columns(s: str) -> str {
    let ws = sql_code_words(s)
    for i in 0..ws.len() {
        if ws[i].depth == 0 && ws[i].w == "into" {
            var j = i + 1
            if j < ws.len() && ws[j].w == "table" {
                j += 1
            }
            if j >= ws.len() {
                return ""
            }
            // за именем таблицы (с базой — несколько слов через точку) — «(»
            var p = ws[j].at
            let n = s.byte_len()
            while p < n && (sql_word_char(s.byte(p)) || s.byte(p) == '`') {
                p += 1
            }
            while p < n && sql_space(s.byte(p)) {
                p += 1
            }
            if p >= n || s.byte(p) != '(' {
                return ""
            }
            // имена в кавычках не разбираются: тогда проверки нет
            var e = p
            while e < n && s.byte(e) != ')' {
                if s.byte(e) == '`' || s.byte(e) == '"' {
                    return ""
                }
                e += 1
            }
            var names: [str] = []
            for k in j + 1..ws.len() {
                if ws[k].depth == 1 && ws[k].at > p && ws[k].at < e {
                    names.push(s.byte_slice(ws[k].at, ws[k].at + ws[k].w.byte_len()))
                }
            }
            return names.join(",")
        }
    }
    return ""
}

// Запрос для проверки при запуске (DESCRIBE TABLE (...)) оператора без строк:
// у INSERT ... SELECT — его SELECT; у мутации и DELETE FROM — SELECT 1 FROM t
// WHERE условие (так сервер проверит имена и типы условия, ничего не меняя).
// "" — только EXPLAIN AST.
fn ch_check_query(s: str, kind: int) -> str {
    let ws = sql_code_words(s)
    if kind == CHK_INSERT_SELECT {
        for x in ws {
            if x.depth == 0 && (x.w == "select" || x.w == "with") {
                return s.byte_slice(x.at, s.byte_len())
            }
        }
        return ""
    }
    if kind == CHK_MUTATION || (kind == CHK_STATEMENT && ws.len() > 0 && ws[0].w == "delete") {
        let table = ch_main_table(s)
        for x in ws {
            if x.depth == 0 && x.w == "where" && table.byte_len() > 0 {
                return "SELECT 1 FROM " + table + " WHERE " + s.byte_slice(x.at + 5, s.byte_len())
            }
        }
    }
    return ""
}

// Таблица оператора (INSERT INTO t, ALTER TABLE t, DELETE FROM t, TRUNCATE t,
// OPTIMIZE TABLE t) — для проверки при запуске (EXISTS TABLE).
fn ch_main_table(s: str) -> str {
    let ws = sql_code_words(s)
    for i in 0..ws.len() {
        let x = ws[i]
        if x.depth == 0 && (x.w == "into" || x.w == "table" || (x.w == "from" && i > 0 && ws[i - 1].w == "delete")) {
            // INSERT INTO TABLE t: слово TABLE — не имя
            if x.w == "into" && i + 1 < ws.len() && ws[i + 1].w == "table" {
                continue
            }
            return sql_name_at(s, ch_skip_table_words(s, x.at + x.w.byte_len()))
        }
    }
    if ws.len() > 1 && ws[0].w == "truncate" {
        return sql_name_at(s, ch_skip_table_words(s, ws[0].at + 8))
    }
    return ""
}

// Позиция после слов TABLE, TEMPORARY, IF EXISTS перед именем таблицы.
fn ch_skip_table_words(s: str, p0: int) -> int {
    var p = p0
    let n = s.byte_len()
    var more = true
    while more {
        more = false
        for w in ["table", "temporary", "if", "exists"] {
            let e = sql_starts_words(s.byte_slice(p, n), [w])
            if !more && e > 0 {
                p += e
                more = true
            }
        }
    }
    return p
}

// Имя (простое, `в кавычках` или "в кавычках") с позиции p0 — без точки после.
fn ch_name_word(s: str, p0: int) -> str {
    var p = p0
    let n = s.byte_len()
    while p < n && sql_space(s.byte(p)) {
        p += 1
    }
    let b = buf_new(16)
    if p < n && (s.byte(p) == '`' || s.byte(p) == '"') {
        let q = s.byte(p)
        p += 1
        while p < n && s.byte(p) != q {
            buf_byte(b, s.byte(p))
            p += 1
        }
        p += 1
    } else {
        while p < n && is_ident_char(s.byte(p)) {
            buf_byte(b, s.byte(p))
            p += 1
        }
    }
    if p < n && s.byte(p) == '.' {
        return ""
    }
    return buf_str(b)
}

// Правила текста ch: привычки, DDL, FORMAT, SET, базы, ; — и вид оператора.
fn ch_rules(at: Token, s: str, shape: int) -> int {
    let ws = sql_code_words(s)
    if ws.len() == 0 {
        error_tok(at, "ch needs a query", "")
        return CHK_STATEMENT
    }
    let st = sql_states(s)
    let n = s.byte_len()
    // несколько операторов через ;
    var semi = false
    for i in 0..n {
        if st[i] == 0 {
            let c = s.byte(i)
            if c == ';' {
                semi = true
            } else if semi && !sql_space(c) {
                error_tok(at, "ch runs one statement; this one has several separated by ;", "write one ch per statement")
                return CHK_STATEMENT
            }
        }
    }
    // заполнители других драйверов: ?, :name, @name, $1
    for i in 0..n {
        if st[i] != 0 {
            continue
        }
        let c = s.byte(i)
        var mark = ""
        if c == '$' && i + 1 < n && is_digit(s.byte(i + 1)) && (i == 0 || !is_ident_char(s.byte(i - 1))) {
            mark = s.byte_slice(i, i + 2)
        } else if c == '?' || c == ':' || c == '@' {
            let q = sql_prev_code(s, st, i)
            let after_op = q >= 0 && (s.byte(q) == '=' || s.byte(q) == '<' || s.byte(q) == '>' || s.byte(q) == '(' || s.byte(q) == ',')
            if after_op && !(q == i - 1 && c == ':' && s.byte(q) == ':') {
                if c == '?' {
                    var j = i + 1
                    while j < n && sql_space(s.byte(j)) {
                        j += 1
                    }
                    if j >= n || s.byte(j) == ')' || s.byte(j) == ',' || s.byte(j) == ';' {
                        mark = "?"
                    }
                } else if i + 1 < n && is_alpha(s.byte(i + 1)) && (i == 0 || s.byte(i - 1) != ':') {
                    var j = i + 1
                    while j < n && is_ident_char(s.byte(j)) {
                        j += 1
                    }
                    mark = s.byte_slice(i, j)
                }
            }
        }
        if mark.byte_len() > 0 {
            error_tok(at, "values go in place in ch: WHERE id = \{id}, not " + mark, "every \{expression} is sent as a parameter, never as SQL text")
            return CHK_STATEMENT
        }
    }
    let first = ws[0].w
    let main = sql_main_word(s)
    var kind = CHK_STATEMENT
    if first == "create" || first == "drop" || first == "rename" || first == "attach" || first == "detach" || first == "exchange" || first == "undrop" || first == "grant" || first == "revoke" || first == "backup" || first == "restore" || first == "move" {
        error_tok(at, sql_upper(first) + " belongs in a migration: the schema changes only through migrations", "migration ch N `...` with the next number")
        return CHK_STATEMENT
    }
    if first == "set" {
        error_tok(at, "SET in ch has no effect on later queries", "put SETTINGS x = 1 at the end of the query")
        return CHK_STATEMENT
    }
    if first == "use" {
        error_tok(at, "USE in ch has no effect on later queries", "declare a connection for the other database: clickhouse NAME = env(\"NAME_CLICKHOUSE_URL\")")
        return CHK_STATEMENT
    }
    if first == "begin" || first == "commit" || first == "rollback" {
        error_tok(at, sql_upper(first) + " in ch: ClickHouse statements here run without transactions", "write each change as one statement")
        return CHK_STATEMENT
    }
    if main == "select" || first == "select" || first == "show" || first == "describe" || first == "desc" || first == "exists" || first == "explain" || first == "values" {
        kind = CHK_ROWS
    } else if first == "kill" {
        kind = CHK_KILL
    } else if first == "insert" {
        // VALUES и FORMAT — только до SELECT: дальше это могут быть столбцы
        var sel = false
        for x in ws {
            if x.w == "select" {
                sel = true
                break
            }
            if x.depth == 0 && (x.w == "values" || (x.w == "format" && ch_clause_word(s, st, x))) {
                let table = ch_main_table(s)
                error_tok(at, "insert rows with " + table + ".insert(rows)", ch_table_hint(table))
                return CHK_STATEMENT
            }
        }
        if !sel {
            let table = ch_main_table(s)
            error_tok(at, "insert rows with " + table + ".insert(rows)", ch_table_hint(table))
            return CHK_STATEMENT
        }
        kind = CHK_INSERT_SELECT
    } else if first == "alter" {
        // ALTER TABLE t [ON CLUSTER c] UPDATE/DELETE — мутация; иначе — схема
        var j = 1
        if ws.len() > 1 && ws[1].w == "table" {
            j = 2
        }
        // имя таблицы (с базой — два слова)
        j += 1
        if j < ws.len() && ws[j].at > 0 && s.byte(ws[j].at - 1) == '.' {
            j += 1
        }
        if j + 1 < ws.len() && ws[j].w == "on" && ws[j + 1].w == "cluster" {
            j += 3
        }
        if j < ws.len() && (ws[j].w == "update" || ws[j].w == "delete") {
            kind = CHK_MUTATION
        } else {
            error_tok(at, "ALTER belongs in a migration: the schema changes only through migrations", "migration ch N `...` with the next number")
            return CHK_STATEMENT
        }
    }
    // FORMAT: ответ читает сам Khrip
    for i in 0..ws.len() {
        let x = ws[i]
        if x.w == "format" && x.depth == 0 && ch_clause_word(s, st, x) {
            error_tok(at, "FORMAT in ch: Khrip reads the rows itself", "drop FORMAT ...; the expected type picks the result")
            return kind
        }
        if x.w == "wait_for_async_insert" {
            var p = x.at + x.w.byte_len()
            while p < n && sql_space(s.byte(p)) {
                p += 1
            }
            if p < n && s.byte(p) == '=' {
                p += 1
                while p < n && sql_space(s.byte(p)) {
                    p += 1
                }
                if (p < n && s.byte(p) == '0') || sql_starts_words(s.byte_slice(p, n), ["false"]) > 0 {
                    error_tok(at, "with wait_for_async_insert = 0 a failed insert is lost silently", "drop the setting; async_insert in the table block waits for the flush")
                    return kind
                }
            }
        }
    }
    // имена с базой: одна связь — одна база (khc test подменяет её)
    for i in 0..ws.len() {
        let x = ws[i]
        let w = x.w
        var db = ""
        if first == "show" && ws.len() > 1 && (ws[1].w == "tables" || ws[1].w == "dictionaries") && (w == "from" || w == "in") && x.depth == 0 {
            // SHOW TABLES FROM база
            db = ch_name_word(s, x.at + w.byte_len())
        } else if w == "from" || w == "join" || w == "into" || w == "table" || (i == 0 && (w == "describe" || w == "desc" || w == "truncate" || w == "exists")) {
            if w == "from" && i > 0 && ws[i - 1].w == "distinct" {
                continue
            }
            if x.depth > 0 && ch_in_call(s, st, x.at) {
                continue
            }
            db = ch_qualified_db(s, ch_skip_table_words(s, x.at + w.byte_len()))
        }
        if db.byte_len() > 0 && db.ascii_lower() != "system" && db.ascii_lower() != "information_schema" {
            error_tok(at, "ch names database " + db + ": one connection is one database (khc test replaces it)", "declare a connection: clickhouse " + db + " = env(\"" + sql_upper(db) + "_CLICKHOUSE_URL\"), then ch " + db + " \"...\"")
            return kind
        }
    }
    // = NULL, <> NULL
    for x in ws {
        if x.w == "null" {
            let q = sql_prev_code(s, st, x.at)
            if q >= 0 {
                let c = s.byte(q)
                var p = ' '
                if q > 0 {
                    p = s.byte(q - 1)
                }
                if (c == '>' && p == '<') || (c == '=' && p == '!') {
                    error_tok(at, "<> NULL is never true in SQL", "IS NOT NULL")
                    return kind
                }
                if c == '=' && p != '<' && p != '>' && p != '!' && p != ':' && p != '=' {
                    error_tok(at, "= NULL is never true in SQL", "IS NULL")
                    return kind
                }
            }
        }
    }
    // DELETE без WHERE
    if first == "delete" {
        var has_where = false
        for x in ws {
            if x.depth == 0 && x.w == "where" {
                has_where = true
            }
        }
        if !has_where {
            error_tok(at, "DELETE without WHERE changes every row of " + ch_main_table(s), "add WHERE ...; write WHERE true if you mean every row")
            return kind
        }
    }
    // список со страницами без порядка
    if shape == SH_LIST {
        var lim = false
        var ord = false
        for i in 0..ws.len() {
            let x = ws[i]
            if x.depth == 0 {
                if (x.w == "limit" || x.w == "offset") && ch_clause_word(s, st, x) {
                    lim = true
                }
                if x.w == "order" && i + 1 < ws.len() && ws[i + 1].w == "by" {
                    ord = true
                }
            }
        }
        if lim && !ord {
            error_tok(at, "LIMIT without ORDER BY returns rows in no fixed order: pages repeat or skip rows", "ORDER BY id (or another unique key last)")
            return kind
        }
    }
    return kind
}

// Слово на позиции at стоит внутри вызова функции (EXTRACT(DAY FROM t.ts)):
// ближайшая незакрытая «(» перед ним идёт сразу за именем.
fn ch_in_call(s: str, st: [int], at: int) -> bool {
    var depth = 0
    var i = at - 1
    while i >= 0 {
        if st[i] == 0 {
            let c = s.byte(i)
            if c == ')' {
                depth += 1
            } else if c == '(' {
                if depth == 0 {
                    var j = i - 1
                    while j >= 0 && sql_space(s.byte(j)) {
                        j -= 1
                    }
                    return j >= 0 && is_ident_char(s.byte(j))
                }
                depth -= 1
            }
        }
        i -= 1
    }
    return false
}

// Имя после позиции p: база в «база.таблица» или "".
fn ch_qualified_db(s: str, p0: int) -> str {
    var p = p0
    let n = s.byte_len()
    while p < n && sql_space(s.byte(p)) {
        p += 1
    }
    let b = buf_new(16)
    if p < n && (s.byte(p) == '`' || s.byte(p) == '"') {
        let q = s.byte(p)
        p += 1
        while p < n && s.byte(p) != q {
            buf_byte(b, s.byte(p))
            p += 1
        }
        p += 1
    } else {
        while p < n && is_ident_char(s.byte(p)) {
            buf_byte(b, s.byte(p))
            p += 1
        }
    }
    if b.len == 0 || p >= n || s.byte(p) != '.' {
        return ""
    }
    // база.функция( — табличная функция, не таблица
    var e = p + 1
    while e < n && (is_ident_char(s.byte(e)) || s.byte(e) == '`' || s.byte(e) == '"') {
        e += 1
    }
    if e < n && s.byte(e) == '(' {
        return ""
    }
    return buf_str(b)
}

// Строка гарантирована запросом ClickHouse: главный SELECT (и после WITH) без
// FROM или с агрегатом (count, uniq, quantile(...), countIf, ...) без GROUP BY,
// HAVING, LIMIT, UNION.
fn ch_one_row(s: str) -> bool {
    let ws = sql_code_words(s)
    let st = sql_states(s)
    var start = -1
    for i in 0..ws.len() {
        if start < 0 && ws[i].depth == 0 && ws[i].w == "select" {
            start = i
        }
    }
    if start < 0 {
        return false
    }
    var from = false
    var agg = false
    var sub = -1
    for i in start + 1..ws.len() {
        let x = ws[i]
        if sub >= 0 && x.depth < sub {
            sub = -1
        }
        if x.depth == 0 {
            if x.w == "group" || x.w == "having" || ((x.w == "limit" || x.w == "offset") && ch_clause_word(s, st, x)) || x.w == "union" || x.w == "intersect" || x.w == "except" || x.w == "fetch" || x.w == "window" || (x.w == "array" && i + 1 < ws.len() && ws[i + 1].w == "join") {
                return false
            }
            if x.w == "from" {
                from = true
            }
        }
        if x.w == "select" && x.depth > 0 && sub < 0 {
            sub = x.depth
        }
        if !from && sub < 0 && ch_call_at(s, x) && ch_agg_word(x.w) {
            agg = true
        }
    }
    return !from || agg
}

// Слово x — имя вызываемой функции: за ним «(».
fn ch_call_at(s: str, x: SqlWord) -> bool {
    var p = x.at + x.w.byte_len()
    while p < s.byte_len() && sql_space(s.byte(p)) {
        p += 1
    }
    return p < s.byte_len() && s.byte(p) == '('
}

// Агрегатная функция ClickHouse (имя в нижнем регистре), с комбинаторами
// If, Array, Merge, State, OrNull, OrDefault, Distinct.
fn ch_agg_word(w0: str) -> bool {
    var w = w0
    var changed = true
    while changed {
        changed = false
        for suffix in ["if", "array", "merge", "state", "ornull", "ordefault", "distinct"] {
            if w.byte_len() > suffix.byte_len() + 2 && w.ends_with(suffix) {
                w = w.byte_slice(0, w.byte_len() - suffix.byte_len())
                changed = true
            }
        }
    }
    if w.starts_with("quantile") || w.starts_with("uniq") || w.starts_with("median") || w.starts_with("grouparray") || w.starts_with("groupbit") || w.starts_with("stddev") || w.starts_with("var") || w.starts_with("covar") || w.starts_with("argm") || w.starts_with("any") {
        return true
    }
    for a in ["count", "sum", "avg", "min", "max", "groupuniqarray", "topk", "topkweighted", "corr", "summap", "minmap", "maxmap", "avgweighted", "entropy", "simplelinearregression", "sumwithoverflow", "sumkahan", "first_value", "last_value", "singlevalueornull", "bool_and", "bool_or", "every", "exists"] {
        if w == a {
            return true
        }
    }
    return false
}
