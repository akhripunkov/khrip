// ============================================================================
// Лексер: исходный текст → список токенов.
//
// Интерполяция разворачивается прямо здесь: "a{x}b" превращается в токены
// ( "a" + __to_str ( x ) + "b" ). Каждая { в строке начинает выражение;
// \{ — сама скобка.
// ============================================================================

const T_EOF = 0
const T_IDENT = 1
const T_INT = 2
const T_STR = 3
// число с точкой или порядком; val — биты double
const T_FLOAT = 4
// символьный литерал 'я' в коде программы; val — код символа. Тип — по
// ожидаемому (parse_atom): str из одного символа или int (код). В системном
// коде символьный литерал — T_INT, один байт ASCII
const T_CHAR = 5
const T_FN = 10
const T_LET = 11
const T_VAR = 12
const T_CONST = 13
const T_IF = 14
const T_ELSE = 15
const T_WHILE = 16
const T_RETURN = 17
const T_BREAK = 18
const T_CONTINUE = 19
const T_TYPE = 20
const T_FOR = 21
const T_IN = 22
const T_TRUE = 23
const T_FALSE = 24
const T_NONE = 25
const T_STORE = 26
const T_ROUTE = 27
const T_TEST = 28
const T_EXPECT = 29
const T_CALL = 30
const T_MATCH = 31
// sql "...": val — номер в sqllits; за токеном — по группе ( выражение ) на параметр
const T_SQL = 32
const T_EQ = 256
const T_NE = 257
const T_LE = 258
const T_GE = 259
const T_ANDAND = 260
const T_OROR = 261
const T_SHL = 262
const T_SHR = 263
const T_ARROW = 264
const T_DOTDOT = 265
const T_PLUSEQ = 266
const T_MINUSEQ = 267
const T_STAREQ = 268
const T_DOTDOTEQ = 269
const T_QQ = 270
const T_ELLIPSIS = 271
const T_SLASHEQ = 272
const T_PERCENTEQ = 273
const T_FATARROW = 274
const T_PLUSPLUS = 275
const T_MINUSMINUS = 276

type Token {
    kind: int
    val: int
    text: str
    line: int
    col: int
    file: int
}

type SrcFile {
    path: str
    text: str
    is_lib: bool
}

var toks: [Token]
var files: [SrcFile]
var strlits: [str]

// Системный код — библиотека, сгенерированный текст и программа с ключом
// --system (исходники компилятора): строки в нём — байты. Операции, которые в
// коде программы будут считать символы (len, s[i], срезы, for, find, lower, ...),
// здесь — ошибки с байтовой заменой: s.byte_len(), s.byte(i), s.byte_slice(a, b).
var system_mode: bool

fn system_file(fi: int) -> bool {
    return files[fi].is_lib || system_mode
}

fn system_code(t: Token) -> bool {
    return system_file(t.file)
}

// Байт для сообщений: 0xD1.
fn hex_byte(b: int) -> str {
    let d = "0123456789ABCDEF"
    return "0x" + d.byte_slice(b >> 4, (b >> 4) + 1) + d.byte_slice(b & 15, (b & 15) + 1)
}

// Символьная операция над str в системном коде: ошибка, которая называет замену.
fn system_str_error(t: Token, what: str, fix: str) {
    if system_code(t) {
        error_tok(t, what + " in system code: write " + fix, "system code (lib/, generated code, khc --system) treats str as bytes")
    }
}

// Текст запроса sql "...": куски между параметрами (их на один больше, чем
// параметров) и для каждого параметра — стоит ли он внутри кавычек SQL ('%{q}%').
type SqlLit {
    segs: [str]
    quoted: [bool]
    // строка и столбец начала каждого куска — для ошибок внутри запроса
    lines: [int]
    cols: [int]
}

var sqllits: [SqlLit]

var lx_text: str
var lx_p: int
var lx_line: int
var lx_line_start: int
var lx_file: int

fn is_alpha(c: int) -> bool {
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'
}

fn is_digit(c: int) -> bool {
    return c >= '0' && c <= '9'
}

fn is_ident_char(c: int) -> bool {
    return is_alpha(c) || is_digit(c)
}

fn keyword_kind(s: str) -> int {
    let n = s.byte_len()
    if n < 2 || n > 8 {
        return T_IDENT
    }
    if s == "fn" {
        return T_FN
    }
    if s == "let" {
        return T_LET
    }
    if s == "var" {
        return T_VAR
    }
    if s == "if" {
        return T_IF
    }
    if s == "else" {
        return T_ELSE
    }
    if s == "return" {
        return T_RETURN
    }
    if s == "for" {
        return T_FOR
    }
    if s == "in" {
        return T_IN
    }
    if s == "while" {
        return T_WHILE
    }
    if s == "true" {
        return T_TRUE
    }
    if s == "false" {
        return T_FALSE
    }
    if s == "none" {
        return T_NONE
    }
    if s == "type" {
        return T_TYPE
    }
    if s == "const" {
        return T_CONST
    }
    if s == "break" {
        return T_BREAK
    }
    if s == "continue" {
        return T_CONTINUE
    }
    if s == "store" {
        return T_STORE
    }
    if s == "route" {
        return T_ROUTE
    }
    if s == "test" {
        return T_TEST
    }
    if s == "expect" {
        return T_EXPECT
    }
    if s == "call" {
        return T_CALL
    }
    if s == "match" {
        return T_MATCH
    }
    return T_IDENT
}

fn add_tok(kind: int, val: int, start: int, len: int) {
    toks.push(Token {
        kind: kind,
        val: val,
        text: lx_text.byte_slice(start, start + len),
        line: lx_line,
        col: start - lx_line_start + 1,
        file: lx_file
    })
}

// Синтетический токен (из интерполяции) с текстом и местом исходной строки.
fn add_tok_text(kind: int, val: int, text: str, start: int) {
    toks.push(Token {
        kind: kind,
        val: val,
        text: text,
        line: lx_line,
        col: start - lx_line_start + 1,
        file: lx_file
    })
}

fn lex_error(msg: str, start: int) {
    report_at(lx_file, lx_line, start - lx_line_start + 1, msg, "")
}

fn three_char_kind(a: int, b: int, c: int) -> int {
    if a == '.' && b == '.' && c == '.' {
        return T_ELLIPSIS
    }
    if a == '.' && b == '.' && c == '=' {
        return T_DOTDOTEQ
    }
    return 0
}

fn two_char_kind(a: int, b: int) -> int {
    if b == '=' {
        if a == '=' {
            return T_EQ
        }
        if a == '!' {
            return T_NE
        }
        if a == '<' {
            return T_LE
        }
        if a == '>' {
            return T_GE
        }
        if a == '+' {
            return T_PLUSEQ
        }
        if a == '-' {
            return T_MINUSEQ
        }
        if a == '*' {
            return T_STAREQ
        }
        if a == '/' {
            return T_SLASHEQ
        }
        if a == '%' {
            return T_PERCENTEQ
        }
        return 0
    }
    if a == '&' && b == '&' {
        return T_ANDAND
    }
    if a == '|' && b == '|' {
        return T_OROR
    }
    if a == '<' && b == '<' {
        return T_SHL
    }
    if a == '>' && b == '>' {
        return T_SHR
    }
    if a == '-' && b == '>' {
        return T_ARROW
    }
    if a == '.' && b == '.' {
        return T_DOTDOT
    }
    if a == '?' && b == '?' {
        return T_QQ
    }
    if a == '=' && b == '>' {
        return T_FATARROW
    }
    if a == '+' && b == '+' {
        return T_PLUSPLUS
    }
    if a == '-' && b == '-' {
        return T_MINUSMINUS
    }
    return 0
}

fn is_single(c: int) -> bool {
    return c == '(' || c == ')' || c == '{' || c == '}' || c == '[' || c == ']' || c == ',' || c == ':' || c == '.' || c == '+' || c == '-' || c == '*' || c == '/' || c == '%' || c == '&' || c == '|' || c == '^' || c == '~' || c == '!' || c == '<' || c == '>' || c == '=' || c == '?' || c == ';'
}

// Один символ литерала с экранированием; lx_p сдвигается.
// Символ в lx_p — обычный или экранированный → его код; lx_p — за ним. Символ
// вне ASCII читается целиком (текст файла — UTF-8, это проверил lex_file).
fn lex_char(end: int) -> int {
    let start = lx_p
    let c = lx_text.byte(lx_p)
    if c >= 0x80 {
        let p = __str_ptr(lx_text)
        lx_p += __utf8_width(p, end, start)
        return __utf8_decode(p, end, start)
    }
    lx_p += 1
    if c != '\\' {
        return c
    }
    if lx_p >= end {
        lex_error("unfinished escape sequence", start)
        return 0
    }
    let e = lx_text.byte(lx_p)
    lx_p += 1
    if e == 'n' {
        return 10
    }
    if e == 't' {
        return 9
    }
    if e == 'r' {
        return 13
    }
    if e == '0' {
        return 0
    }
    if e == '\\' || e == '\'' || e == '"' || e == '\{' || e == '}' {
        return e
    }
    if e == 'u' || e == 'U' {
        return lex_unicode_escape(e, start, end)
    }
    lex_error("unknown escape sequence; use \\n \\t \\r \\0 \\\\ \\\" \\' \\u\{...} or \\\{ (for a regex, a raw string: `\\d+`)", start)
    return e
}

// Значение шестнадцатеричной цифры c или -1.
fn hex_digit(c: int) -> int {
    if is_digit(c) {
        return c - '0'
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10
    }
    return -1
}

// Число в шестнадцатеричной записи, не короче min цифр: 1F600, 00E9.
fn hex_text(v: int, min: int) -> str {
    let d = "0123456789ABCDEF"
    var s = ""
    var x = v
    var k = 0
    while x > 0 || k < min {
        s = d.byte_slice(x & 15, (x & 15) + 1) + s
        x = x >> 4
        k += 1
    }
    return s
}

// Символ cp строкой UTF-8.
fn char_text(cp: int) -> str {
    let b = buf_new(4)
    buf_utf8(b, cp)
    return buf_str(b)
}

// Число символов в s (правило Go, как у s.len() в программе).
fn char_count(s: str) -> int {
    return __utf8_go_count(__str_ptr(s), s.byte_len())
}

// Не больше n шестнадцатеричных цифр с lx_p → значение; сколько прочитано — в lx_hex_n.
var lx_hex_n: int

fn lex_hex(n: int, end: int) -> int {
    var v = 0
    lx_hex_n = 0
    while lx_hex_n < n && lx_p < end && hex_digit(lx_text.byte(lx_p)) >= 0 {
        v = v * 16 + hex_digit(lx_text.byte(lx_p))
        lx_p += 1
        lx_hex_n += 1
    }
    return v
}

// \uXXXX, \u{1–6 цифр} и \UXXXXXXXX (lx_p — за буквой u или U) → код символа.
// Суррогаты UTF-16 — не символы: \uD83D\uDE00 — ошибка с подсказкой \u{1F600}.
fn lex_unicode_escape(e: int, start: int, end: int) -> int {
    var v = 0
    if e == 'u' && lx_p < end && lx_text.byte(lx_p) == '\{' {
        lx_p += 1
        v = lex_hex(6, end)
        if lx_hex_n == 0 || lx_p >= end || lx_text.byte(lx_p) != '}' {
            lex_error("bad \\u\{...} escape: write 1 to 6 hex digits in braces, e.g. \\u\{e9}", start)
            return 0xFFFD
        }
        lx_p += 1
    } else {
        var n = 4
        if e == 'U' {
            n = 8
        }
        v = lex_hex(n, end)
        if lx_hex_n != n {
            lex_error("bad \\" + __str_from_byte(e) + " escape: write \\u\{e9}, \\u00e9 or \\U0001F600", start)
            return 0xFFFD
        }
    }
    if v >= 0xD800 && v < 0xE000 {
        var hint = "UTF-16 surrogates are not characters; write the code point, e.g. \\u\{1F600}"
        // пара \uD83D\uDE00 — подсказка с её значением; вторая половина
        // читается здесь же, чтобы ошибка была одна
        let q = lx_p
        if v < 0xDC00 && q + 6 <= end && lx_text.byte(q) == '\\' && lx_text.byte(q + 1) == 'u' {
            lx_p = q + 2
            let lo = lex_hex(4, end)
            if lx_hex_n == 4 && lo >= 0xDC00 && lo < 0xE000 {
                hint = "write \\u\{" + hex_text(0x10000 + ((v - 0xD800) << 10) + (lo - 0xDC00), 1) + "}"
            } else {
                lx_p = q
            }
        }
        report_at(lx_file, lx_line, start - lx_line_start + 1, "surrogate escape \\u" + hex_text(v, 4), hint)
        return 0xFFFD
    }
    if v > 0x10FFFF {
        lex_error("escape \\u\{" + hex_text(v, 1) + "} is above U+10FFFF, the largest code point", start)
        return 0xFFFD
    }
    return v
}

fn lex_number(end: int) -> int {
    var v = 0
    if lx_text.byte(lx_p) == '0' && lx_p + 1 < end && (lx_text.byte(lx_p + 1) == 'x' || lx_text.byte(lx_p + 1) == 'X') {
        lx_p += 2
        while lx_p < end {
            let c = lx_text.byte(lx_p)
            var d = -1
            if is_digit(c) {
                d = c - '0'
            } else if c >= 'a' && c <= 'f' {
                d = c - 'a' + 10
            } else if c >= 'A' && c <= 'F' {
                d = c - 'A' + 10
            } else if c != '_' {
                break
            }
            if d >= 0 {
                if v > 0x7FFFFFFFFFFFFFF {
                    lex_error("integer literal is too large", lx_p)
                    v = 0
                }
                v = v * 16 + d
            }
            lx_p += 1
        }
        return v
    }
    while lx_p < end && (is_digit(lx_text.byte(lx_p)) || lx_text.byte(lx_p) == '_') {
        let c = lx_text.byte(lx_p)
        if c != '_' {
            if v > 922337203685477580 {
                lex_error("integer literal is too large", lx_p)
                v = 0
            }
            v = v * 10 + (c - '0')
        }
        lx_p += 1
    }
    return v
}

// С позиции lx_p — дробное число: цифры, затем .цифра или порядок e5, e-5.
// 0..n и 3.max(4) — не дробные.
fn float_ahead(end: int) -> bool {
    var i = lx_p
    if lx_text.byte(i) == '0' && i + 1 < end && (lx_text.byte(i + 1) == 'x' || lx_text.byte(i + 1) == 'X') {
        return false
    }
    while i < end && (is_digit(lx_text.byte(i)) || lx_text.byte(i) == '_') {
        i += 1
    }
    if i + 1 < end && lx_text.byte(i) == '.' && is_digit(lx_text.byte(i + 1)) {
        return true
    }
    if i + 1 < end && (lx_text.byte(i) == 'e' || lx_text.byte(i) == 'E') {
        let n = lx_text.byte(i + 1)
        return is_digit(n) || ((n == '-' || n == '+') && i + 2 < end && is_digit(lx_text.byte(i + 2)))
    }
    return false
}

// Дробное число → биты double (точное округление — __dec_to_f64).
fn lex_float(end: int) -> int {
    let b = buf_new(32)
    while lx_p < end && (is_digit(lx_text.byte(lx_p)) || lx_text.byte(lx_p) == '_' || lx_text.byte(lx_p) == '.') {
        let c = lx_text.byte(lx_p)
        if c == '.' && !(lx_p + 1 < end && is_digit(lx_text.byte(lx_p + 1))) {
            break
        }
        if c != '_' {
            buf_byte(b, c)
        }
        lx_p += 1
    }
    var e = 0
    if lx_p < end && (lx_text.byte(lx_p) == 'e' || lx_text.byte(lx_p) == 'E') {
        lx_p += 1
        var neg = false
        if lx_text.byte(lx_p) == '-' || lx_text.byte(lx_p) == '+' {
            neg = lx_text.byte(lx_p) == '-'
            lx_p += 1
        }
        while lx_p < end && is_digit(lx_text.byte(lx_p)) {
            if e < 100000 {
                e = e * 10 + (lx_text.byte(lx_p) - '0')
            }
            lx_p += 1
        }
        if neg {
            e = 0 - e
        }
    }
    return __dec_to_f64(b.data, b.len, e)
}

fn add_strlit(s: str) -> int {
    strlits.push(s)
    return strlits.len() - 1
}

// Позиция закрывающей } выражения внутри строки (начало — сразу после {).
// В выражении могут быть свои строки: "{m["a"]}", "{x ?? "нет"}"; но начинаться
// со строки оно не может: "{" + x + "}" — это незакрытая {.
fn interp_end(from: int, end: int) -> int {
    var depth = 0
    var i = from
    while i < end && lx_text.byte(i) == ' ' {
        i += 1
    }
    if i < end && lx_text.byte(i) == '"' {
        return -1
    }
    while i < end {
        let c = lx_text.byte(i)
        if c == '\n' {
            return -1
        }
        if c == '"' {
            i += 1
            while i < end && lx_text.byte(i) != '"' {
                if lx_text.byte(i) == '\n' {
                    return -1
                }
                if lx_text.byte(i) == '\\' {
                    i += 1
                }
                i += 1
            }
            if i >= end {
                return -1
            }
            i += 1
            continue
        }
        if c == '\{' {
            depth += 1
        }
        if c == '}' {
            if depth == 0 {
                return i
            }
            depth -= 1
        }
        i += 1
    }
    return -1
}

// Путь маршрута и имя теста — без интерполяции: {id} в пути — параметр.
fn raw_string_here() -> bool {
    let n = toks.len()
    if n >= 1 && toks[n - 1].kind == T_TEST {
        return true
    }
    return n >= 2 && toks[n - 1].kind == T_IDENT && toks[n - 2].kind == T_ROUTE
}

// [from, to) — «3», «3,32» или «2,»?
fn is_quantifier(from: int, to: int) -> bool {
    var digits = 0
    var commas = 0
    var i = from
    while i < to {
        let c = lx_text.byte(i)
        if c >= '0' && c <= '9' {
            if commas == 0 {
                digits += 1
            }
        } else if c == ',' {
            commas += 1
        } else {
            return false
        }
        i += 1
    }
    return digits > 0 && commas <= 1
}

fn lex_string(end: int) {
    let start = lx_p
    lx_p += 1
    let b = buf_new(32)
    var parts = 0
    let raw = raw_string_here()
    while true {
        if lx_p >= end || lx_text.byte(lx_p) == '\n' {
            lex_error("unterminated string; close it with \" on the same line", start)
            return
        }
        let c = lx_text.byte(lx_p)
        if c == '"' {
            lx_p += 1
            break
        }
        if c == '\{' && !raw {
            let close = interp_end(lx_p + 1, end)
            if close < 0 {
                lex_error("unclosed \{ in string; write \\\{ for a literal brace", lx_p)
                // восстановление: строка — до последней кавычки в строке исходника
                var q = lx_p
                var last = -1
                while q < end && lx_text.byte(q) != '\n' {
                    if lx_text.byte(q) == '"' {
                        last = q
                    }
                    q += 1
                }
                if last >= 0 {
                    lx_p = last + 1
                } else {
                    lx_p = q
                }
                if parts > 0 {
                    // начатая интерполяция: закрыть группу ( "..." + ... )
                    add_tok_text('+', 0, "+", start)
                    add_tok_text(T_STR, add_strlit(""), "\"...\"", start)
                    add_tok_text(')', 0, ")", start)
                    return
                }
                add_tok(T_STR, add_strlit(""), start, lx_p - start)
                return
            }
            if is_quantifier(lx_p + 1, close) {
                // {3}, {3,32}, {2,}: число в фигурных скобках — текст (как в регулярных
                // выражениях), подставлять литерал смысла нет
                while lx_p <= close {
                    buf_byte(b, lx_text.byte(lx_p))
                    lx_p += 1
                }
                continue
            }
            if close == lx_p + 1 {
                lex_error("empty \{} in string; write \\\{} for literal braces", lx_p)
                lx_p += 2
                continue
            }
            if parts == 0 {
                add_tok_text('(', 0, "(", start)
            } else {
                add_tok_text('+', 0, "+", start)
            }
            add_tok_text(T_STR, add_strlit(buf_str(b)), "\"...\"", start)
            buf_clear(b)
            add_tok_text('+', 0, "+", start)
            add_tok_text(T_IDENT, 0, "__to_str", start)
            add_tok_text('(', 0, "(", start)
            lx_p += 1
            lex_range(close)
            add_tok_text(')', 0, ")", start)
            lx_p = close + 1
            parts += 1
            continue
        }
        buf_utf8(b, lex_char(end))
    }
    if parts == 0 {
        add_tok(T_STR, add_strlit(buf_str(b)), start, lx_p - start)
        return
    }
    if b.len > 0 {
        add_tok_text('+', 0, "+", start)
        add_tok_text(T_STR, add_strlit(buf_str(b)), "\"...\"", start)
    }
    add_tok_text(')', 0, ")", start)
}

// После слова sql (через пробелы, на той же строке) — "..." или `...`?
fn sql_string_next(end: int) -> bool {
    var q = lx_p
    while q < end && lx_text.byte(q) == ' ' {
        q += 1
    }
    return q < end && (lx_text.byte(q) == '"' || lx_text.byte(q) == '`')
}

// sql "..." или sql `...`: обычный SQL, строка может занимать несколько строк;
// {выражение} — параметр запроса. Внутри комментариев и "имён" SQL скобки — текст;
// {}, {3}, {1,2} — тоже текст (пустой массив, квантификатор). В "..." действуют
// экранирования Khrip, в `...` — только \{.
fn lex_sql(start: int, end: int) {
    let tok_line = lx_line
    let tok_col = start - lx_line_start + 1
    while lx_text.byte(lx_p) == ' ' {
        lx_p += 1
    }
    let close_ch = lx_text.byte(lx_p)
    let raw = close_ch == '`'
    let open = lx_p
    lx_p += 1
    let lit = SqlLit { segs: [], quoted: [], lines: [lx_line], cols: [lx_p - lx_line_start + 1] }
    let b = buf_new(64)
    // состояние SQL: 0 — код, 1 — '...', 2 — "имя", 3 — -- комментарий, 4 — /* */,
    // 5 — E'...' (с \-экранированием), 6 — $тег$...$тег$; параметры — только в 0 и 1
    var st = 0
    var dtag = ""
    // номер занят сразу: в параметре может встретиться свой sql "..."
    let li = sqllits.len()
    sqllits.push(lit)
    toks.push(Token { kind: T_SQL, val: li, text: "sql", line: tok_line, col: tok_col, file: lx_file })
    while true {
        if lx_p >= end {
            lex_error("unterminated sql string: close it with " + lx_text.byte_slice(open, open + 1), open)
            break
        }
        let c = lx_text.byte(lx_p)
        if c == close_ch {
            lx_p += 1
            break
        }
        if c == '\n' {
            buf_byte(b, c)
            lx_p += 1
            lx_line += 1
            lx_line_start = lx_p
            if st == 3 {
                st = 0
            }
            continue
        }
        if c == '\{' && (st == 5 || st == 6) {
            let close = interp_end(lx_p + 1, end)
            if close > lx_p + 1 && !is_quantifier(lx_p + 1, close) && !sql_array_literal(lx_p + 1, close) {
                lex_error("\{...} inside E'...' or $$...$$ is plain text, not a parameter", lx_p)
            }
        }
        if c == '\{' && (st == 0 || st == 1) {
            let close = interp_end(lx_p + 1, end)
            if close == lx_p + 1 || (close > 0 && is_quantifier(lx_p + 1, close)) || (close > 0 && st == 1 && sql_array_literal(lx_p + 1, close)) {
                // {} и {3,5} — текст
                while lx_p <= close {
                    buf_byte(b, lx_text.byte(lx_p))
                    lx_p += 1
                }
                continue
            }
            if close < 0 {
                lex_error("unclosed \{ in sql string; write \\\{ for a literal brace", lx_p)
                buf_byte(b, c)
                lx_p += 1
                continue
            }
            // ${x} (привычка шаблонов JS) — то же, что {x}
            if b.len > 0 && load8(b.data + b.len - 1) == '$' {
                b.len = b.len - 1
            }
            lit.segs.push(buf_str(b))
            buf_clear(b)
            lit.quoted.push(st == 1)
            add_tok_text('(', 0, "(", lx_p)
            lx_p += 1
            lex_range(close)
            add_tok_text(')', 0, ")", close)
            lx_p = close + 1
            lit.lines.push(lx_line)
            lit.cols.push(lx_p - lx_line_start + 1)
            continue
        }
        // символ: экранирование Khrip (в `...` — только \{) или как есть
        var ch = c
        if c == '\\' && (!raw || (lx_p + 1 < end && lx_text.byte(lx_p + 1) == '\{')) {
            ch = lex_char(end)
            if ch >= 0x80 {
                // \u{...}: символ вне ASCII — его байты UTF-8; состояние SQL
                // меняют только символы ASCII
                buf_utf8(b, ch)
                continue
            }
        } else {
            lx_p += 1
        }
        let nx = lx_p < end && lx_text.byte(lx_p) == '-'
        // состояние SQL по символу
        if st == 0 {
            let prev = b.len
            if ch == '\'' {
                st = 1
                // E'...': обратная косая черта экранирует кавычку
                if prev > 0 && (load8(b.data + prev - 1) == 'e' || load8(b.data + prev - 1) == 'E') && (prev == 1 || !is_ident_char(load8(b.data + prev - 2))) {
                    st = 5
                }
            } else if ch == '$' && (prev == 0 || !is_ident_char(load8(b.data + prev - 1))) && lx_p < end && !is_digit(lx_text.byte(lx_p)) {
                // $тег$ ... $тег$
                var j = lx_p
                while j < end && is_ident_char(lx_text.byte(j)) {
                    j += 1
                }
                if j < end && lx_text.byte(j) == '$' {
                    dtag = "$" + lx_text.byte_slice(lx_p, j + 1)
                    st = 6
                    buf_byte(b, ch)
                    while lx_p <= j {
                        buf_byte(b, lx_text.byte(lx_p))
                        lx_p += 1
                    }
                    continue
                }
            } else if ch == '"' {
                st = 2
            } else if ch == '-' && nx {
                st = 3
            } else if ch == '/' && lx_p < end && lx_text.byte(lx_p) == '*' {
                st = 4
            }
        } else if st == 1 {
            if ch == '\'' {
                st = 0
            }
        } else if st == 5 {
            if ch == '\\' && lx_p < end {
                buf_byte(b, ch)
                ch = lx_text.byte(lx_p)
                lx_p += 1
            } else if ch == '\'' {
                st = 0
            }
        } else if st == 6 {
            if ch == '$' && lx_p + dtag.byte_len() - 1 <= end && "$" + lx_text.byte_slice(lx_p, lx_p + dtag.byte_len() - 1) == dtag {
                buf_byte(b, ch)
                var k = 1
                while k < dtag.byte_len() {
                    buf_byte(b, lx_text.byte(lx_p))
                    lx_p += 1
                    k += 1
                }
                st = 0
                continue
            }
        } else if st == 2 {
            if ch == '"' {
                st = 0
            }
        } else if st == 4 {
            if ch == '*' && lx_p < end && lx_text.byte(lx_p) == '/' {
                st = 0
            }
        }
        buf_byte(b, ch)
    }
    lit.segs.push(buf_str(b))
    sqllits[li] = lit
}

// {...} в строке '...' SQL с запятой на верхнем уровне — литерал массива или
// пути jsonb ('{a,b}', '{1,2,3}'), а не выражение.
fn sql_array_literal(from: int, to: int) -> bool {
    var depth = 0
    var i = from
    while i < to {
        let c = lx_text.byte(i)
        if c == '(' || c == '[' || c == '\{' {
            depth += 1
        } else if c == ')' || c == ']' || c == '}' {
            depth -= 1
        } else if c == ',' && depth == 0 {
            return true
        } else if c == '"' {
            i += 1
            while i < to && lx_text.byte(i) != '"' {
                i += 1
            }
        }
        i += 1
    }
    return false
}

// В символьном литерале больше одного символа (первый — v, lx_p — за ним):
// ошибка с подсказкой и пропуск до закрывающей кавычки или конца строки.
// 'é', набранное как e + U+0301 (знак ударения отдельным символом), — тоже два
// символа: подсказка называет их.
fn char_lit_error(start: int, v: int, end: int) {
    var q = lx_p
    var n = 1
    var second = -1
    while q < end && lx_text.byte(q) != '\'' && lx_text.byte(q) != '\n' {
        let save = lx_p
        lx_p = q
        let c = lex_char(end)
        q = lx_p
        lx_p = save
        if n == 1 {
            second = c
        }
        n += 1
    }
    let text = lx_text.byte_slice(start + 1, q)
    var hint = "for text write \"" + text + "\""
    if n == 2 && combining_mark(second) {
        hint = "'" + text + "' here is " + lx_text.byte_slice(start + 1, lx_p) + " + U+" + hex_text(second, 4) + "; for text write \"" + text + "\""
    }
    report_at(lx_file, lx_line, start - lx_line_start + 1, "a character literal holds one character", hint)
    lx_p = q
}

// Комбинируемый знак (ударение, тильда и т. п.): основные блоки Unicode.
fn combining_mark(cp: int) -> bool {
    return (cp >= 0x300 && cp < 0x370) || (cp >= 0x1AB0 && cp < 0x1B00) || (cp >= 0x1DC0 && cp < 0x1E00) || (cp >= 0x20D0 && cp < 0x2100) || (cp >= 0xFE20 && cp < 0xFE30)
}

fn lex_range(end: int) {
    while lx_p < end {
        let c = lx_text.byte(lx_p)
        if c == '\n' {
            lx_p += 1
            lx_line += 1
            lx_line_start = lx_p
            continue
        }
        if c == ' ' || c == '\t' || c == '\r' {
            lx_p += 1
            continue
        }
        if c == '/' && lx_p + 1 < end && lx_text.byte(lx_p + 1) == '/' {
            while lx_p < end && lx_text.byte(lx_p) != '\n' {
                lx_p += 1
            }
            continue
        }
        let start = lx_p
        if is_alpha(c) {
            while lx_p < end && is_ident_char(lx_text.byte(lx_p)) {
                lx_p += 1
            }
            let word = lx_text.byte_slice(start, lx_p)
            if word == "sql" && sql_string_next(end) {
                lex_sql(start, end)
                continue
            }
            add_tok(keyword_kind(word), 0, start, lx_p - start)
            continue
        }
        if is_digit(c) {
            if float_ahead(end) {
                let bits = lex_float(end)
                add_tok(T_FLOAT, bits, start, lx_p - start)
                continue
            }
            let v = lex_number(end)
            add_tok(T_INT, v, start, lx_p - start)
            continue
        }
        if c == '\'' {
            lx_p += 1
            if lx_p >= end {
                lex_error("unterminated character literal", start)
                return
            }
            if lx_text.byte(lx_p) == '\n' {
                // перевод строки считает основной цикл
                lex_error("unterminated character literal", start)
                add_tok(T_INT, 0, start, 1)
                continue
            }
            var v = 0
            if lx_text.byte(lx_p) == '\'' {
                report_at(lx_file, lx_line, start - lx_line_start + 1, "empty character literal", "for an empty string write \"\"")
            } else {
                v = lex_char(end)
            }
            if lx_p >= end || lx_text.byte(lx_p) != '\'' {
                char_lit_error(start, v, end)
            } else if v >= 0x80 && system_file(lx_file) {
                // в системном коде символ — один байт ASCII; в сообщении — байты
                // символа в UTF-8
                let ub = buf_new(4)
                buf_utf8(ub, v)
                var bytes = ""
                var i = 0
                while i < ub.len {
                    bytes += " " + hex_byte(load8(ub.data + i))
                    i += 1
                }
                lex_error("non-ASCII character literal in system code: write its UTF-8 bytes as numbers:" + bytes, start)
            }
            // закрывающая кавычка; на переводе строки — стоп: его считает основной цикл
            if lx_p < end && lx_text.byte(lx_p) == '\'' {
                lx_p += 1
            }
            if system_file(lx_file) {
                add_tok(T_INT, v, start, lx_p - start)
            } else {
                add_tok(T_CHAR, v, start, lx_p - start)
            }
            continue
        }
        if c == '"' {
            lex_string(end)
            continue
        }
        if c == '`' {
            // сырая строка: без экранирования и подстановок, может занимать несколько строк
            let line0 = lx_line
            let col0 = start - lx_line_start + 1
            var q = lx_p + 1
            while q < end && lx_text.byte(q) != '`' {
                if lx_text.byte(q) == '\n' {
                    lx_line += 1
                    lx_line_start = q + 1
                }
                q += 1
            }
            if q >= end {
                lex_error("unterminated raw string: close it with `", start)
                lx_p = end
                return
            }
            let raw = lx_text.byte_slice(lx_p + 1, q)
            lx_p = q + 1
            toks.push(Token { kind: T_STR, val: add_strlit(raw), text: "`...`", line: line0, col: col0, file: lx_file })
            continue
        }
        if lx_p + 2 < end {
            let k3 = three_char_kind(c, lx_text.byte(lx_p + 1), lx_text.byte(lx_p + 2))
            if k3 != 0 {
                lx_p += 3
                add_tok(k3, 0, start, 3)
                continue
            }
        }
        if lx_p + 1 < end {
            let k = two_char_kind(c, lx_text.byte(lx_p + 1))
            if k != 0 {
                lx_p += 2
                add_tok(k, 0, start, 2)
                continue
            }
        }
        if is_single(c) {
            lx_p += 1
            if c != ';' {
                add_tok(c, 0, start, 1)
            }
            continue
        }
        lex_error("unexpected character '" + lx_text.byte_slice(start, start + 1) + "'", start)
        lx_p += 1
    }
}

fn lex_file(fi: int) {
    lx_file = fi
    lx_text = files[fi].text
    lx_p = 0
    lx_line = 1
    lx_line_start = 0
    // исходник — текст UTF-8: иначе символы и строки в нём не прочитать
    let n = lx_text.byte_len()
    let bad = __utf8_bad_at(__str_ptr(lx_text), n)
    if bad < n {
        var line = 1
        var ls = 0
        var i = 0
        while i < bad {
            if lx_text.byte(i) == '\n' {
                line += 1
                ls = i + 1
            }
            i += 1
        }
        report_at(fi, line, bad - ls + 1, "file is not valid UTF-8: byte " + hex_byte(lx_text.byte(bad)), "save the file in UTF-8")
    }
    lex_range(n)
}
