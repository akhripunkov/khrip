// Параметр или локальная с именем таблицы ClickHouse — обычное значение:
// функцию, которая только считает его длину, можно звать внутри tx.

migration 1 `
CREATE TABLE totals (id bigint PRIMARY KEY, n integer NOT NULL);
`

type Event { id: int, page: str }
table events: Event

fn count_all(events: [int]) -> int {
    let visits = events
    return visits.len() + events.len()
}

route POST "/totals/{id}" (id: int) -> 204 {
    tx {
        let n = count_all([1, 2, 3])
        sql "UPDATE totals SET n = {n} WHERE id = {id}"
    }
    return 204
}
