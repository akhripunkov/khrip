// Статус, объявленный без типа (| 409), не уходит с телом: return 409 "..." —
// ошибка, а не молча пропавшее сообщение (M2 ревью части 2 этапа токенов).
// expect: route_status_body.kh:9:16: error: status 409 has no body here
// expect: hint: declare | 409 str to send a message
// expect: route_status_body.kh:12:16: error: status 404 has no body here
// expect: hint: declare | 404 { why: str } to send it
route GET "/a" (n: int) -> str | 409 | 404 {
    if n > 1 {
        return 409 "taken"
    }
    if n > 2 {
        return 404 { why: "x" }
    }
    if n > 3 {
        return 409
    }
    return "x"
}

// x ?? 404 вне return — не ответ: подсказка с формами, которые отвечают.
store names: map[int, str]

route GET "/b/{id}" (id: int) -> str | 404 {
    let name = names[id] ?? 404
    return name
}
