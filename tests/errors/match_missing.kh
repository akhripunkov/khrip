type Shape = Circle { r: int } | Rect { w: int, h: int } | Empty

fn f(s: Shape, n: int) -> int {
    let a = match s {
        Circle c => c.r
    }
    let b = match n {
        1 => 10
    }
    let c = s.r
    let e = match s {
        Square q => 1
        _ => 2
    }
    return a + b + c + e
}

