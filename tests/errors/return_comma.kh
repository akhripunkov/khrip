// expect: hint: write return 400 "msg" (no comma)
// expect: return_comma.kh:23:19: error: a status and its value are written without a comma
// expect: return_comma.kh:30:19: error: a status and its value are written without a comma
// expect: hint: write return 409 "msg" (no comma) and declare the status: -> str | 409 str
// expect: return_comma.kh:37:16: error: this route returns str | 400 str, found int
// expect: hint: status 400 carries a str: return 400 "msg"
// expect: 4 errors
// return 400, "msg" из Python и Go: статус и значение пишутся без запятой —
// ошибка с подсказкой, и в маршруте, который возвращает int, и в маршруте со
// str. Если статус не объявлен, подсказка говорит и об этом. Число в начале
// выражения, когда статус уже объявлен с типом, не подсказывает объявить его
// ещё раз (было «-> str | 400 str | 400» — объявлен дважды).
route GET "/a" (n: int) -> int | 400 str {
    if n < 0 {
        return 400, "negative"
    }
    return n
}

route GET "/b" (n: int) -> str | 400 str {
    if n < 0 {
        return 400, "negative"
    }
    return "ok"
}

route GET "/c" (n: int) -> str {
    if n < 0 {
        return 409, "busy"
    }
    return "ok"
}

route GET "/d" (n: int) -> str | 400 str {
    if n < 0 {
        return 400 + n
    }
    return "ok"
}
