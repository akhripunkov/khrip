// expect: publish() calls ch_insert, and the tx block may run again after a conflict
fn publish() -> str {
    let client = ChConfig { url: "http://localhost:8123/" }
    return ch_insert(client, "events", ch_encode([1])).error
}
route POST "/write" -> 204 {
    tx {
        sql "DELETE FROM events"
        let error = publish()
        if error != "" {
            fail(503, error)
        }
    }
    return 204
}
