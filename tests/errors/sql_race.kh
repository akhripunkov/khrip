// expect: this write runs outside tx and another statement runs before it
// expect: put the statements of this request in tx { ... }
type A { id: int, balance: int }
route POST "/w/{id}" (id: int) -> 204 | 409 {
    let a: A = sql "SELECT id, balance FROM accounts WHERE id = {id}"
    if a.balance < 10 {
        return 409
    }
    sql "UPDATE accounts SET balance = balance - 10 WHERE id = {id}"
    return 204
}
