// Литерал без имени типа проверяется как T { ... }: недостающие и лишние поля,
// типы значений; у пустых {} — список недостающих полей. Без ожидаемого типа
// (A3) тип поля берётся из значения: none, повтор поля и поле без «:» (кроме
// сокращения { имя }) — ошибки.
type Point { x: int, y: int }
type Opts { limit: int = 10, sort: str }

fn main() {
    let a: Point = { x: 1 }
    let b: Point = { x: 1, y: 2, color: "red" }
    let c: Point = { x: "1", y: 2 }
    let d: Opts = {}
    let e = { name: none }
    let f = { n: 1, n: 2 }
    let g: Point = { x: 1, yy: 2 }
    let h = { x: 1, f(2) }
    print(a.x.to_str() + b.x.to_str() + c.x.to_str() + d.sort + f.n.to_str() + g.x.to_str())
    print(to_json(e) + to_json(h))
}

fn f(n: int) -> int {
    return n
}
