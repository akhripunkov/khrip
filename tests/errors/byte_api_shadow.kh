// expect: s.byte_len() is the built-in str method, not your fn byte_len
// expect: hint: call your function as byte_len(s), or rename it
// expect: s.ascii_trim() is the built-in str method, not your fn ascii_trim
// expect: hint: call your function as byte_find(s, ...), or rename it
// expect: 3 errors
// Байтовый API у str — встроенные методы: s.byte_len() не вызывает функцию
// программы с тем же именем (до v0.13 вызывал) — об этом говорит ошибка.
// Обычный вызов byte_len(s) и метод у другого типа — как раньше.
fn byte_len(s: str) -> int {
    return 1000 + s.len()
}

fn ascii_trim(s: str) -> str {
    return "T"
}

fn byte_find(s: str, x: str) -> int? {
    return 77
}

fn ascii_upper(xs: [int]) -> int {
    return xs.len()
}

fn main() {
    let s = " Abc "
    print(s.byte_len())
    print(s.ascii_trim())
    print(s.byte_find("b") ?? -1)
    print(byte_len(s))
    print(ascii_trim(s) + s.ascii_lower())
    print([1, 2].ascii_upper())
}
