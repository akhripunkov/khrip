// expect: this write runs outside tx and another statement runs before it
type Account { id: int, balance: int }
type Amount { amount: int }
fn account(id: int) -> Account {
    return sql "SELECT id, balance FROM accounts WHERE id = {id}"
}
route POST "/accounts/{id}/withdraw" (id: int, body: Amount) -> 204 | 404 | 409 str {
    let a = account(id)
    if a.balance < body.amount {
        return 409 "insufficient funds"
    }
    sql "UPDATE accounts SET balance = balance - {body.amount} WHERE id = {id}"
    return 204
}
