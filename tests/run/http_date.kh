// libs: lib/net.kh lib/json.kh lib/http.kh
// Дата для заголовка Date и экранирование JSON.

fn handle(req: i64) {
}

fn show_date(t: i64) {
    let out = alloc(32)
    format_http_date(out, t)
    write_n(STDOUT, out, 29)
    print("\n")
}

fn main() -> i64 {
    show_date(0)
    show_date(784111777)
    show_date(951782400)
    show_date(1792413688)
    show_date(4102444799)
    let s = "a\"b\\c\nd\te?f"
    store8(s + 9, 1)
    let b = buf_new(256)
    json_str(b, s)
    write_n(STDOUT, buf_ptr(b), buf_len(b))
    print("\n")
    return 0
}
