// Сравнение строк и хеш строковых ключей (этап скорости, часть 2, п. 1):
// __str_cmp ищет первый неравный байт словами (ctz по xor, хвост — словом
// внахлёст), __memeq сравнивает хвост словом внахлёст, а короткое — кусками
// по 4 байта, хеш map[str] берёт по 8 байт. Ответы <, <=, >, >=, ==, sort и
// sort_by по строке сверяются с побайтовым сравнением на 100 000 случайных пар
// (общие начала разной длины, байты 0–255, длины 0–40 и через границы слов);
// словарь со строковыми ключами разных видов (короткие, с общим началом и
// концом, длинные, отличающиеся одним байтом в любом месте, не-ASCII) — поиск,
// has, удаление и повторная вставка, а порядок keys() и values() — порядок
// вставки, а не хеша. Ожидаемый вывод — вывод этой программы с прежней
// библиотекой.

var seed: int = 3

fn rnd(n: int) -> int {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
    return (seed >> 8) % n
}

fn rnd_bytes(n: int) -> str {
    let b = buf_new(n + 8)
    for i in 0..n {
        let k = rnd(4)
        if k == 0 {
            buf_byte(b, rnd(256))
        } else {
            buf_byte(b, 'a' + rnd(3))
        }
    }
    return buf_str(b)
}

// Порядок по байтам (без знака), как strcmp: <0, 0 или >0.
fn ref_cmp(a: str, b: str) -> int {
    let n = a.byte_len()
    let m = b.byte_len()
    var i = 0
    while i < n && i < m {
        let d = a.byte(i) - b.byte(i)
        if d != 0 {
            return d
        }
        i += 1
    }
    return n - m
}

fn sign(x: int) -> int {
    if x < 0 {
        return -1
    }
    if x > 0 {
        return 1
    }
    return 0
}

fn main() -> int {
    var wrong = 0
    var lt = 0
    var eq = 0
    var words: [str] = []
    for t in 0..100000 {
        let pre = rnd_bytes([0, 1, 7, 8, 9, 15, 16, 17, 20, 23, 24, 31][rnd(12)])
        var a = pre + rnd_bytes(rnd(12))
        var b = pre + rnd_bytes(rnd(12))
        if rnd(8) == 0 {
            b = a
        }
        if rnd(16) == 0 {
            // срез: байты внутри другой строки
            a = (a + "zz").byte_slice(0, a.byte_len())
        }
        let want = sign(ref_cmp(a, b))
        var got = 0
        if a < b {
            got = -1
        } else if a > b {
            got = 1
        }
        if got != want || (a <= b) != (want <= 0) || (a >= b) != (want >= 0) || (a == b) != (want == 0) || (a != b) != (want != 0) {
            wrong += 1
            if wrong <= 5 {
                print("cmp mismatch at {t}: got {got}, want {want}")
            }
        }
        if want < 0 {
            lt += 1
        } else if want == 0 {
            eq += 1
        }
        if t % 50 == 0 {
            words.push(a)
        }
    }
    print("compare: 100000 pairs, less {lt}, equal {eq}, mismatches {wrong}")

    // сортировка: соседи по порядку, sort_by — устойчиво
    let sorted = words.copy().sort()
    var bad = 0
    for i in 1..sorted.len() {
        if ref_cmp(sorted[i - 1], sorted[i]) > 0 {
            bad += 1
        }
    }
    let by = words.copy().sort_by(w => w)
    for i in 0..by.len() {
        if by[i] != sorted[i] {
            bad += 1
        }
    }
    print("sort {sorted.len()} strings: out of order {bad}")
    wrong += bad

    // словарь: ключи разных видов
    var keys: [str] = []
    for i in 0..3000 {
        keys.push("k{i}")
        keys.push("{i}")
        keys.push("user_{i}@example.com")
        keys.push("prefix-common-part-{i}-suffix-common-part")
    }
    for i in 0..300 {
        // отличаются одним байтом в любом месте строки длиной 1–40
        let n = 1 + i % 40
        let b = buf_new(n)
        for j in 0..n {
            if j == (i * 7) % n {
                buf_byte(b, 'A' + i / 40)
            } else {
                buf_byte(b, 'x')
            }
        }
        keys.push(buf_str(b))
    }
    for i in 0..2000 {
        keys.push(rnd_bytes(rnd(30)))
    }
    keys.push("")
    keys.push("ключ")
    keys.push("ключи")
    var m: map[str, int] = {}
    var order: [str] = []
    for i in 0..keys.len() {
        let k = keys[i]
        if !m.has(k) {
            order.push(k)
        }
        m[k] = i
    }
    var miss = 0
    for i in 0..keys.len() {
        let v = m[keys[i]] ?? -1
        if v < 0 || keys[v] != keys[i] {
            miss += 1
        }
    }
    if m.has("absent-key") || m.has("k3000") || m.has("prefix-common-part-3000-suffix-common-part") {
        miss += 1
    }
    var same_order = m.keys().len() == order.len()
    if same_order {
        let ks = m.keys()
        for i in 0..order.len() {
            if ks[i] != order[i] {
                same_order = false
            }
        }
    }
    // удаление каждого третьего и повторная вставка в конец
    var removed = 0
    for i in 0..order.len() {
        if i % 3 == 0 {
            m.remove(order[i]) else {
                miss += 1
            }
            removed += 1
        }
    }
    for i in 0..order.len() {
        if (i % 3 == 0) == m.has(order[i]) {
            miss += 1
        }
    }
    for i in 0..order.len() {
        if i % 3 == 0 {
            m[order[i]] = -i
        }
    }
    var wanted: [str] = []
    for i in 0..order.len() {
        if i % 3 != 0 {
            wanted.push(order[i])
        }
    }
    for i in 0..order.len() {
        if i % 3 == 0 {
            wanted.push(order[i])
        }
    }
    let ks2 = m.keys()
    let vs2 = m.values()
    var order_ok = ks2.len() == wanted.len() && vs2.len() == wanted.len()
    if order_ok {
        for i in 0..wanted.len() {
            if ks2[i] != wanted[i] || vs2[i] != (m[wanted[i]] ?? 0) {
                order_ok = false
            }
        }
    }
    print("map: {keys.len()} inserts, {order.len()} keys, {removed} removed and inserted again, len {m.len()}, lookups wrong {miss}, insertion order {same_order} {order_ok}")
    if !same_order || !order_ok {
        wrong += 1
    }
    wrong += miss
    if wrong != 0 {
        return 1
    }
    return 0
}
