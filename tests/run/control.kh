// if / else if / else, циклы с break и continue, ранний return, вызов до определения.
fn classify(x: i64) -> i64 {
    if x < 0 {
        return -1
    } else if x == 0 {
        return 0
    } else if x < 10 {
        return 1
    } else {
        return 2
    }
}

fn main() -> i64 {
    println_int(classify(-5))
    println_int(classify(0))
    println_int(classify(7))
    println_int(classify(70))

    var total = 0
    var i = 0
    while i < 10 {
        i = i + 1
        if i == 3 {
            continue
        }
        var j = 0
        while 1 {
            if j >= i {
                break
            }
            total = total + 1
            j = j + 1
        }
        if i == 8 {
            break
        }
    }
    println_int(total)
    println_int(first_square_above(42))
    return 0
}

fn first_square_above(x: i64) -> i64 {
    var i = 0
    while i < 100 {
        if i * i > x {
            return i
        }
        i = i + 1
    }
    return -1
}
