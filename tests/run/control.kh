// if / else if / else, циклы, break и continue, ранний return, вызов до определения.
fn classify(x: int) -> int {
    if x < 0 {
        return -1
    } else if x == 0 {
        return 0
    } else if x < 10 {
        return 1
    } else {
        return 2
    }
}

fn main() {
    print(classify(-5))
    print(classify(0))
    print(classify(7))
    print(classify(70))
    var total = 0
    var i = 0
    while i < 10 {
        i += 1
        if i == 3 {
            continue
        }
        var j = 0
        while true {
            if j >= i {
                break
            }
            total += 1
            j += 1
        }
        if i == 8 {
            break
        }
    }
    print(total)
    print(first_square_above(42))
    var s = 0
    for k in 0..10 {
        if k % 2 == 0 {
            continue
        }
        if k > 7 {
            break
        }
        s += k
    }
    print(s)
    var t = 0
    for k in 1..=4 {
        t += k
    }
    print(t)
    if !(1 > 2) && (2 > 1 || false) {
        print("conditions ok")
    }
}

fn first_square_above(x: int) -> int {
    var i = 0
    while i < 100 {
        if i * i > x {
            return i
        }
        i += 1
    }
    return -1
}
