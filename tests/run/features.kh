// Возможности языка из KHRIP.md: типы с ..., сокращение полей, вызов как метод,
// срезы, for по индексам и диапазонам, словари, ??, let ... else.
const LIMIT = 3
const GREETING = "hi"

type Point {
    x: int
    y: int
}

type Named {
    name: str
    ...Point
}

var counter: int = 0

fn add(a: int, b: int) -> int {
    return a + b
}

fn describe(p: Point) -> str {
    return "({p.x}, {p.y})"
}

fn find_user(id: int) -> str? {
    if id == 1 {
        return "Ann"
    }
    return none
}

fn main() -> int {
    let p = Point { x: 1, y: 2 }
    let x = 5
    let y = 6
    let q = Point { x, y }
    let n = Named { name: "n", ...p }
    print(describe(p) + " " + q.describe() + " " + n.name + " {n.x}")
    var xs = [3, 1, 2]
    xs.push(10)
    xs.sort()
    print("{xs.len()} {xs[0]} {xs.last()} {xs.contains(10)} {xs.sum()}")
    let part = xs[1..3]
    print("{part.len()} {part[0]}")
    for i, v in xs {
        if i == 0 {
            continue
        }
        counter += v
    }
    for i in 0..=LIMIT {
        counter += i
    }
    print("counter {counter}")
    var m: map[str, int] = {}
    m["a"] = 1
    m["b"] = 2
    let lit = {"x": 1, "y": 2}
    let a = m["a"] ?? 0
    let ly = lit["y"] ?? 0
    print("{m.len()} {a} {ly}")
    print(m.has("c").to_str())
    for k, v in m {
        print("{k}={v}")
    }
    let name = find_user(1) ?? "nobody"
    let other = find_user(2) else {
        print("no user 2")
        return 0
    }
    print(name + other)
    return 0
}
