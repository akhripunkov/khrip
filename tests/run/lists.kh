// Списки: литералы, методы, срезы, сортировка, обход с индексом.
fn main() {
    var xs = [5, 3, 8, 1]
    xs.push(4)
    print(xs.len())
    print(xs[2])
    xs[0] = 50
    xs[1] += 7
    print(xs[0] + xs[1])
    print(xs.pop())
    print(xs.last())
    xs.sort()
    print(xs[0])
    print(xs[xs.len() - 1])
    print(xs.contains(8))
    print(xs.contains(9))
    let part = xs[1..3]
    print(part.len())
    print(part[0])
    var words = ["pear", "apple", "fig"]
    words.sort()
    print(words.join(","))
    for i, w in words {
        print("{i}:{w}")
    }
    var total = 0
    for x in xs {
        total += x
    }
    print(total)
    print(xs.sum())
    var empty: [str] = []
    print(empty.len())
    words.insert(0, "kiwi")
    print(words[0])
    print(words.remove_at(1))
    words.reverse()
    print(words.join(" "))
    print(words.index_of("kiwi") ?? -1)
}
