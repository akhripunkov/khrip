// Константы и глобальные переменные.
const ANSWER = 42
const NEG = -7
const CH = 'A'
const NAME = "khrip"
const ON = true
var counter: int
var start: int = 1000
var minus: int = -1
var names: [str]
var title: str = NAME + "!"

fn bump() -> int {
    counter += 1
    return counter
}

fn main() {
    print(ANSWER)
    print(NEG)
    print(CH)
    print(NAME)
    print(ON)
    print(start)
    print(minus)
    bump()
    bump()
    print(bump())
    start += counter
    print(start)
    names.push("a")
    names.push("b")
    print(names.len())
    print(title)
}
