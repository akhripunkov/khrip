    var m199 = ""
    for s in in199 {
        m199 += bit(s.matches(`(a?){5}a{5}`))
    }
    report(199, `(a?){5}a{5}`, in199, m199)
    // 200
    let x200 = ["aab", "aaabb", "aaaabb", "abbb"]
    let in200 = cat(pool, x200)
    var m200 = ""
    for s in in200 {
        m200 += bit(s.matches(`a{2,3}b{0,2}`))
    }
    report(200, `a{2,3}b{0,2}`, in200, m200)
    // 201
    let x201 = ["xxyyzz", "xzy"]
    let in201 = cat(pool, x201)
    var m201 = ""
    for s in in201 {
        m201 += bit(s.matches(`x*y*z*`))
    }
    report(201, `x*y*z*`, in201, m201)
    // 202
    let x202 = ["xzy", "xzya"]
    let in202 = cat(pool, x202)
    var m202 = ""
    for s in in202 {
        m202 += bit(s.matches(`(x|y|z)*`))
    }
    report(202, `(x|y|z)*`, in202, m202)
    // 203
    let in203 = pool
    var m203 = ""
    for s in in203 {
        m203 += bit(s.matches(`^a|b$`))
    }
    report(203, `^a|b$`, in203, m203)
    // 204
    let in204 = pool
    var m204 = ""
    for s in in204 {
        m204 += bit(s.matches(`a$|^b`))
    }
    report(204, `a$|^b`, in204, m204)
    // 205
    let x205 = ["b", "ab", "aab"]
    let in205 = cat(pool, x205)
    var m205 = ""
    for s in in205 {
        m205 += bit(s.matches(`(^|a)b`))
    }
    report(205, `(^|a)b`, in205, m205)
    // 206
    let x206 = ["a", "ab", "abb"]
    let in206 = cat(pool, x206)
    var m206 = ""
    for s in in206 {
        m206 += bit(s.matches(`a(b|$)`))
    }
    report(206, `a(b|$)`, in206, m206)
    // 207
    let in207 = pool
    var m207 = ""
    for s in in207 {
        m207 += bit(s.matches(`$^`))
    }
    report(207, `$^`, in207, m207)
    // 208
    let in208 = pool
    var m208 = ""
    for s in in208 {
        m208 += bit(s.matches(`^^a$$`))
    }
    report(208, `^^a$$`, in208, m208)
    // 209
    let in209 = pool
    var m209 = ""
    for s in in209 {
        m209 += bit(s.matches(`(a$)?b`))
    }
    report(209, `(a$)?b`, in209, m209)
    // 210
    let x210 = [unhex("61cc81"), "á"]
    let in210 = cat(pool, x210)
    var m210 = ""
    for s in in210 {
        m210 += bit(s.matches(`a\x{301}?`))
    }
    report(210, `a\x{301}?`, in210, m210)
    // 211
    let x211 = ["яя", "я", "яяя", "яa"]
    let in211 = cat(pool, x211)
    var m211 = ""
    for s in in211 {
        m211 += bit(s.matches(`[а-я]{2}`))
    }
    report(211, `[а-я]{2}`, in211, m211)
    // 212
    let x212 = ["ann@x.io", "ан@пример.рф", "a b@c", "a@b@c", "a b@c"]
    let in212 = cat(pool, x212)
    var m212 = ""
    for s in in212 {
        m212 += bit(s.matches(`[^@\s]+@[^@\s]+`))
    }
    report(212, `[^@\s]+@[^@\s]+`, in212, m212)
    // 213
    let x213 = ["Ѐӿ", "Ԁ"]
    let in213 = cat(pool, x213)
    var m213 = ""
    for s in in213 {
        m213 += bit(s.matches(`[\x{400}-\x{4FF}]+`))
    }
    report(213, `[\x{400}-\x{4FF}]+`, in213, m213)
}
