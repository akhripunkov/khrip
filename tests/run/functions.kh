// Рекурсия, много параметров, затенение имён, встраивание маленьких функций.
fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn ack(m: int, n: int) -> int {
    if m == 0 {
        return n + 1
    }
    if n == 0 {
        return ack(m - 1, 1)
    }
    return ack(m - 1, ack(m, n - 1))
}

fn many(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int) -> int {
    return a - b + c * d - e + f * g - h
}

fn shadow(x: int) -> int {
    let y = x * 2
    var r = x
    if true {
        let y = 100
        r += y
    }
    return r + y
}

fn sign(x: int) -> int {
    if x < 0 {
        return -1
    }
    if x > 0 {
        return 1
    }
    return 0
}

fn square(x: int) -> int {
    return x * x
}

fn greet(name: str) -> str {
    return "hi " + name
}

fn main() {
    print(fib(25))
    print(ack(2, 3))
    print(many(1, 2, 3, 4, 5, 6, 7, 8))
    print(shadow(5))
    print(sign(-9) + sign(0) * 10 + sign(4) * 100)
    print(square(square(3)))
    print(greet("Ann"))
    var acc = 0
    for i in 0..100 {
        acc += square(i) % 7 + sign(i - 50)
    }
    print(acc)
}
