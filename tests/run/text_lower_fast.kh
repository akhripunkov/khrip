// Быстрые пути регистра (этап скорости, часть 2, п. 1): lower() и upper()
// строки ASCII до 31 байта (__tx_case_ascii) и x.lower().contains(y) без копии
// (компилятор вызывает __text_contains_lower) — тот же ответ, что у отображения
// по символам через __case_map (ссылка ref_case) и поиска в его результате, на
// 120 000 случайных пар строк: ASCII со всеми байтами 0–127, ASCII вперемешку с
// не-ASCII (кириллица, K → k, İ → i̇, ß, ẞ, ǅ, ɐ, эмодзи, неправильные байты — в
// начале, в середине и в конце), только не-ASCII; длины 0–300 (через 8, 32 и
// границы слов); подстрока — пустая, кусок строки в нижнем регистре (ответ
// «да»), случайная, длиннее строки, конец строки и ещё байт, заглавная,
// не-ASCII. Результат lower — ещё
// и обычная строка: длина, склейка, ключ словаря. Вывод тот же с быстрым путём,
// без него (KHRIP_STR_COMPACT=0: обычные копии строк) и без SIMD; ожидаемый
// вывод совпадает с выводом этой программы, собранной прежней библиотекой
// (до быстрых путей: x.lower().contains(y) — копия и поиск).
// env:
// env: KHRIP_STR_COMPACT=0
// env: KHRIP_SIMD=0

var seed: int = 7

fn rnd(n: int) -> int {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
    return (seed >> 8) % n
}

fn hex_bytes(s: str) -> str {
    var r = ""
    for i in 0..s.byte_len() {
        if i > 0 {
            r += " "
        }
        r += s.byte(i).to_str()
    }
    return r
}

// Ссылка: каждый символ (правило Go) — через __case_map, неправильный байт — как есть.
fn ref_case(s: str, up: bool) -> str {
    let p = __str_ptr(s)
    let n = s.byte_len()
    let b = buf_new(n + 16)
    var i = 0
    while i < n {
        let w = __utf8_width(p, n, i)
        if w == 1 && load8(p + i) >= 0x80 {
            buf_byte(b, load8(p + i))
        } else {
            buf_utf8(b, __case_map(__utf8_decode(p, n, i), up))
        }
        i += w
    }
    return buf_str(b)
}

// Символ не из ASCII: кириллица, K (Кельвин), İ, ß, ẞ, ǅ, ɐ, Σ, эмодзи или
// неправильный байт.
fn other(b: Buf) {
    let k = rnd(10)
    if k == 0 {
        buf_utf8(b, 0x410 + rnd(64))
    } else if k == 1 {
        buf_utf8(b, 0x212A)
    } else if k == 2 {
        buf_utf8(b, 0x130)
    } else if k == 3 {
        buf_utf8(b, 0xDF)
    } else if k == 4 {
        buf_utf8(b, 0x1E9E)
    } else if k == 5 {
        buf_utf8(b, 0x1C5)
    } else if k == 6 {
        buf_utf8(b, 0x250)
    } else if k == 7 {
        buf_utf8(b, 0x3A3)
    } else if k == 8 {
        buf_utf8(b, 0x1F600 + rnd(16))
    } else {
        buf_byte(b, 0x80 + rnd(128))
    }
}

// Байт ASCII: чаще буквы и границы диапазонов букв (@ [ ` {), иногда любой 0–127.
fn ascii(b: Buf) {
    let k = rnd(10)
    if k < 4 {
        buf_byte(b, 'A' + rnd(26))
    } else if k < 7 {
        buf_byte(b, 'a' + rnd(26))
    } else if k == 7 {
        buf_byte(b, [64, 91, 96, 123, 90, 122, 65, 97, 32, 48][rnd(10)])
    } else {
        buf_byte(b, rnd(128))
    }
}

fn rnd_len() -> int {
    let k = rnd(20)
    if k < 12 {
        return rnd(17)
    }
    if k < 17 {
        return rnd(40)
    }
    if k < 19 {
        return 240 + rnd(30)
    }
    return rnd(301)
}

// Строка из n символов: mix 0 — только ASCII, 1 — с не-ASCII в случайных местах,
// 2 — не-ASCII только в начале или в конце, 3 — только не-ASCII.
fn rnd_str(n: int, mix: int) -> str {
    let b = buf_new(n + 8)
    let edge = rnd(2)
    for i in 0..n {
        var o = false
        if mix == 1 {
            o = rnd(8) == 0
        } else if mix == 2 {
            o = (edge == 0 && i == 0) || (edge == 1 && i == n - 1)
        } else if mix == 3 {
            o = true
        }
        if o {
            other(b)
        } else {
            ascii(b)
        }
    }
    return buf_str(b)
}

fn main() -> int {
    var cases = 0
    var found = 0
    var ascii_n = 0
    var changed = 0
    var wrong = 0
    var h = 0
    let mod = 1000000007
    var keys: map[str, int] = {}
    for t in 0..120000 {
        var mix = 0
        let km = rnd(10)
        if km >= 5 && km < 8 {
            mix = 1
        } else if km == 8 {
            mix = 2
        } else if km == 9 {
            mix = 3
        }
        let s = rnd_str(rnd_len(), mix)
        let lo = ref_case(s, false)
        let up = ref_case(s, true)
        // подстрока
        var sub = ""
        let ks = rnd(20)
        if ks < 2 {
            sub = ""
        } else if ks < 9 {
            let n = lo.byte_len()
            let a = rnd(n + 1)
            sub = lo.byte_slice(a, a + 1 + rnd(8))
        } else if ks < 12 {
            sub = rnd_str(1 + rnd(4), 0).lower()
        } else if ks < 15 {
            sub = rnd_str(rnd(6), rnd(4))
        } else if ks < 16 {
            sub = lo + rnd_str(1 + rnd(3), 0)
        } else if ks < 17 {
            // конец строки и ещё байт (0 — как нулевой байт за концом короткой
            // строки): совпадение не должно заходить за конец
            let n = lo.byte_len()
            sub = lo.byte_slice(n - 1 - rnd(9), n)
            let b = buf_new(sub.byte_len() + 1)
            buf_add(b, sub)
            buf_byte(b, [0, 0, 32, 97][rnd(4)])
            sub = buf_str(b)
        } else if ks < 19 {
            let n = up.byte_len()
            let a = rnd(n + 1)
            sub = up.byte_slice(a, a + 1 + rnd(5))
        } else {
            sub = rnd_str(1 + rnd(3), 3)
        }
        cases += 1
        let want = __str_contains(lo, sub)
        let got = s.lower().contains(sub)
        let l = s.lower()
        let got2 = l.contains(sub)
        let u = s.upper()
        if got != want || got2 != want || l != lo || u != up {
            wrong += 1
            if wrong <= 5 {
                print("mismatch: s [{hex_bytes(s)}] sub [{hex_bytes(sub)}]: contains {got}/{got2}, want {want}; lower ok {l == lo}, upper ok {u == up}")
            }
        }
        // результат — обычная строка
        if l.byte_len() != lo.byte_len() || (l + "|" + u).byte_len() != lo.byte_len() + up.byte_len() + 1 {
            wrong += 1
        }
        if t % 16 == 0 {
            keys[l] = t
            if (keys[lo] ?? -1) != t {
                wrong += 1
            }
        }
        if want {
            found += 1
        }
        if s.byte_len() == 0 || __utf8_scan(__str_ptr(s), s.byte_len()) == s.byte_len() {
            ascii_n += 1
        }
        if l != s {
            changed += 1
        }
        var bit = 0
        if want {
            bit = 1
        }
        h = (h * 31 + bit + 2 * (lo.byte_len() % 1000) + 3 * (up.byte_len() % 1000)) % mod
    }
    print("cases {cases}: contains true {found}, ascii {ascii_n}, lower changed {changed}, keys {keys.len()}")
    print("digest {h}")
    print("mismatches {wrong}")
    if wrong != 0 {
        return 1
    }
    return 0
}
