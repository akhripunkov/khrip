// UTF-8 без SIMD из lib/core.kh — по правилу Go: правильная последовательность
// (таблица 3-7 Unicode) — один символ, любой другой байт — отдельный символ
// U+FFFD. Ширина, код, первый неправильный байт, число символов и пропуск k
// символов сверяются с простой ссылкой (байты — вплотную к странице PROT_NONE);
// buf_utf8 — на всех кодах; постоянная память __perm_alloc выровнена, обнулена
// и не пересекается.

fn is_cont(b: int) -> bool {
    return (b & 0xC0) == 0x80
}

// Ширина правильной последовательности в байте i или 0.
fn ref_seq(p: int, n: int, i: int) -> int {
    let c = load8(p + i)
    if c < 0x80 {
        return 1
    }
    var len = 0
    var lo = 0x80
    var hi = 0xBF
    if c >= 0xC2 && c <= 0xDF {
        len = 2
    } else if c == 0xE0 {
        len = 3
        lo = 0xA0
    } else if c >= 0xE1 && c <= 0xEC {
        len = 3
    } else if c == 0xED {
        len = 3
        hi = 0x9F
    } else if c >= 0xEE && c <= 0xEF {
        len = 3
    } else if c == 0xF0 {
        len = 4
        lo = 0x90
    } else if c >= 0xF1 && c <= 0xF3 {
        len = 4
    } else if c == 0xF4 {
        len = 4
        hi = 0x8F
    } else {
        return 0
    }
    if i + len > n {
        return 0
    }
    let c1 = load8(p + i + 1)
    if c1 < lo || c1 > hi {
        return 0
    }
    for j in 2..len {
        if !is_cont(load8(p + i + j)) {
            return 0
        }
    }
    return len
}

fn ref_cp(p: int, i: int, w: int) -> int {
    let c = load8(p + i)
    if w == 1 {
        return c
    }
    var cp = 0
    if w == 2 {
        cp = c & 0x1F
    } else if w == 3 {
        cp = c & 0x0F
    } else {
        cp = c & 0x07
    }
    for j in 1..w {
        cp = cp * 64 + (load8(p + i + j) & 0x3F)
    }
    return cp
}

var checks: int = 0
var bad: int = 0

fn report(what: str, p: int, n: int, got: int, want: int) {
    checks += 1
    if got == want {
        return
    }
    bad += 1
    if bad <= 10 {
        var bytes = ""
        for i in 0..n {
            bytes += " " + load8(p + i).to_str()
        }
        print("mismatch {what}: n={n} got {got} want {want}:{bytes}")
    }
}

fn verify(what: str, ok: bool) {
    checks += 1
    if !ok {
        bad += 1
        if bad <= 10 {
            print("failed: {what}")
        }
    }
}

// Конец страницы, за которой — PROT_NONE: проверяемые байты кладутся вплотную к ней.
var page_end: int = 0

fn check(src: int, n: int) {
    let p = page_end - n
    __memcpy(p, src, n)
    for i in 0..n {
        var w = ref_seq(p, n, i)
        var cp = 0xFFFD
        if w == 0 {
            w = 1
        } else {
            cp = ref_cp(p, i, w)
        }
        report("width", p, n, __utf8_width(p, n, i), w)
        report("decode", p, n, __utf8_decode(p, n, i), cp)
    }
    // шаги по правилу Go: начало каждого символа и первый неправильный байт
    var first_bad = n
    var i = 0
    var k = 0
    while i < n {
        report("skip", p, n, __utf8_go_skip(p, n, k), i)
        var w = ref_seq(p, n, i)
        if w == 0 {
            if first_bad == n {
                first_bad = i
            }
            w = 1
        }
        i += w
        k += 1
    }
    report("skip", p, n, __utf8_go_skip(p, n, k), n)
    report("skip", p, n, __utf8_go_skip(p, n, k + 1), n)
    report("bad_at", p, n, __utf8_bad_at(p, n), first_bad)
    report("count", p, n, __utf8_go_count(p, n), k)
}

var seed: int = 11

fn rnd(n: int) -> int {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
    return (seed >> 8) % n
}

fn rnd_byte() -> int {
    let r = rnd(16)
    if r < 6 {
        return rnd(128)
    }
    if r < 11 {
        return 0x80 + rnd(64)
    }
    return 0xC0 + rnd(64)
}

// Байты v после a байтов ASCII и перед z байтами ASCII: так сдвигается место
// внутри слов по 8 байт, которые идут целиком.
fn put(p: int, v: [int], a: int, z: int) -> int {
    for i in 0..a {
        store8(p + i, 'a' + i)
    }
    for i in 0..v.len() {
        store8(p + a + i, v[i])
    }
    for i in 0..z {
        store8(p + a + v.len() + i, 'z' - i)
    }
    return a + v.len() + z
}

fn main() -> int {
    let pages = __mmap(2 * 4096)
    syscall(10, pages + 4096, 4096, 0)
    page_end = pages + 4096
    let p = __alloc(256)

    // все пары; тройки с ведущим E0–EF; четвёрки с ведущим F0–F4
    for b0 in 0..256 {
        for b1 in 0..256 {
            check(p, put(p, [b0, b1], (b0 + b1) % 9, b1 % 10))
            if b0 >= 0xE0 && b0 <= 0xEF {
                for b2 in 0..256 {
                    check(p, put(p, [b0, b1, b2], b2 % 9, 0))
                }
            }
            if b0 >= 0xF0 && b0 <= 0xF4 {
                for b2 in 0..256 {
                    for b3 in [0x80, 0xC0] {
                        check(p, put(p, [b0, b1, b2, b3], b2 % 9, b3 % 3))
                    }
                }
            }
        }
    }
    print("sequences: ok")

    // многоязычный текст с одной порчей и случайные байты
    let text = "Привет, мир! 日本語テキスト 😀🎉 ok naïve café Ελληνικά ¿qué? "
    let t = __str_ptr(text)
    let tn = text.byte_len()
    print("text: {__utf8_go_count(t, tn)} characters in {tn} bytes")
    for at in 0..tn {
        for b in [0x80, 0xBF, 0xC0, 0xE0, 0xED, 0xF0, 0xF4, 0xFF, 'a'] {
            __memcpy(p, t, tn)
            store8(p + at, b)
            check(p, tn)
            check(p, at + 1)
        }
    }
    for k in 0..20000 {
        let n = rnd(120)
        for i in 0..n {
            store8(p + i, rnd_byte())
        }
        check(p, n)
    }
    print("text and random bytes: ok")

    // buf_utf8 на каждом коде: ширина и код при обратном разборе; суррогаты
    // кодируются как есть, а читаются как неправильные байты
    let b = buf_new(8)
    for cp in 0..0x110000 {
        buf_clear(b)
        buf_utf8(b, cp)
        var w = 4
        if cp < 0x80 {
            w = 1
        } else if cp < 0x800 {
            w = 2
        } else if cp < 0x10000 {
            w = 3
        }
        var want = cp
        if cp >= 0xD800 && cp < 0xE000 {
            want = 0xFFFD
        }
        report("buf_utf8 len", b.data, b.len, b.len, w)
        report("buf_utf8", b.data, b.len, __utf8_decode(b.data, b.len, 0), want)
    }
    print("buf_utf8: ok")

    // постоянная память: блоки по 16 байт, обнулены, не пересекаются — и через
    // границы кусков по 64 КБ, и большие блоки отдельным mmap
    var blocks: [int] = []
    var sizes: [int] = []
    for i in 0..3000 {
        var n = 1 + (i * 37) % 300
        if i % 1000 == 999 {
            n = 16384 + i
        }
        let q = __perm_alloc(n)
        var ok = (q & 15) == 0
        for j in 0..n {
            if load8(q + j) != 0 {
                ok = false
            }
            store8(q + j, i & 255)
        }
        verify("perm_alloc {n}", ok)
        blocks.push(q)
        sizes.push(n)
    }
    for i in 0..blocks.len() {
        var ok = true
        for j in 0..sizes[i] {
            if load8(blocks[i] + j) != (i & 255) {
                ok = false
            }
        }
        verify("perm_alloc overlap {i}", ok)
    }
    print("perm_alloc: ok")

    print("checks: {checks}, mismatches: {bad}")
    if bad > 0 {
        return 1
    }
    return 0
}
