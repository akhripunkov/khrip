// Двоеточие в подстановке внутри строки, сырой строки или символа — не формат
// (R2 перепроверки части 2 этапа токенов).
fn main() {
    let x: str? = none
    let c = "a"
    print("v={x ?? `a:b`}")
    print("w={x ?? "c:d"}")
    print("z={c == ":"} {':'.len()}")
    let h = 9
    let m = 5
    print("{h}:{m}")
}
