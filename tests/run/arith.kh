// Арифметика, приоритеты как в Go, границы int.
fn main() {
    print(2 + 3 * 4)
    print((2 + 3) * 4)
    print(10 - 4 - 3)
    print(100 / 7)
    print(100 % 7)
    print(-100 / 7)
    print(-100 % 7)
    print(1 << 20)
    print(-1024 >> 3)
    print(0xFF & 0x0F | 0x30)
    print(6 ^ 3)
    print(~5)
    print(- -7)
    print(1 + 2 == 3)
    print(3 < 2)
    print(9223372036854775807)
    print(-9223372036854775807 - 1)
    print(123456789 * 1000)
    let a = 17
    let b = 5
    print(a / b + a % b * 2)
    print(1_000_000)
}
