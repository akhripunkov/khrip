// Строки: экранирование, интерполяция, методы, срезы, сравнение.
fn main() {
    print("tab:\t|")
    print("quotes: \"x\" 'y' \\")
    print("braces: \{x} \{} \{\"k\": 1}")
    let name = "Khrip"
    let n = 3
    print("hello, {name}! n={n}, next={n + 1}, ok={n > 2}")
    print('\n')
    print('A')
    let s = "  Hello, World  "
    print(s.trim())
    print(s.trim().lower())
    print(s.trim().upper())
    print(s.contains("World"))
    print(s.trim().starts_with("Hell"))
    print(s.trim().ends_with("ld"))
    let t = s.trim()
    print(t[0..5])
    print(t[7..])
    print(t[..4])
    print(t.len())
    print(t[1])
    print(t.find("o") ?? -1)
    print(t.find("zz") ?? -1)
    print("a-b-c".split("-").len())
    print("a-b-c".replace("-", "+"))
    print("ab".repeat(3))
    print("42".to_int() ?? 0)
    print("4x2".to_int() ?? -1)
    print("-17".to_int() ?? 0)
    print("abc" < "abd")
    print("b" > "abc")
    print("same" == "same")
    var acc = ""
    for c in "xyz" {
        acc += c.to_str() + ","
    }
    print(acc)
    var b = "a"
    b += "b"
    print(b)
}
