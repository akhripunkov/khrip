// Именованное соединение: clickhouse ИМЯ = выражение, таблицы in ИМЯ (и at
// "имя на сервере"), migration ИМЯ N, ch ИМЯ "...".
clickhouse metrics = env("METRICS_CLICKHOUSE_URL")

migration metrics 1 `CREATE TABLE hits (ts DateTime, page String) ENGINE = MergeTree ORDER BY ts`

type Hit { ts: int, page: str }

table hits: Hit in metrics
table recent: Hit in metrics at "hits"

fn main() {
    hits.insert([Hit { ts: 1, page: "/" }])
    recent.insert(Hit { ts: 2, page: "/b" })
    let n: int = ch metrics "SELECT count() FROM hits"
    print(n)
}
