// Именованное соединение в сервере на настоящем ClickHouse (H2 ревью части 2
// этапа токенов): маршруты пишут и читают через него, khc test — во временной базе.
clickhouse metrics = env("METRICS_CLICKHOUSE_URL")

migration metrics 1 `CREATE TABLE hits (ts DateTime, page String) ENGINE = MergeTree ORDER BY ts`

type Hit { ts: int, page: str }

table hits: Hit in metrics

route POST "/hits" (body: [Hit]) -> 202 { inserted: int } {
    return 202 { inserted: hits.insert(body) }
}

route GET "/hits/count" -> int {
    return ch metrics "SELECT count() FROM hits"
}

test "named connection in a server" {
    expect (call POST "/hits" [{ ts: 1, page: "/" }, { ts: 2, page: "/a" }]).status == 202
    expect (call GET "/hits/count").body == "2"
}
