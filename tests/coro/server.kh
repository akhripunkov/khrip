// Сервер для tests/coro.sh: запросы, которые ждут (sleep, fetch), не держат поток.

store log: [str]

fn deep(n: int, ms: int) -> int {
    if n == 0 {
        sleep(ms)
        return 0
    }
    return deep(n - 1, ms) + 1
}

route GET "/sleep" (ms: int, tag: str = "") -> str {
    sleep(ms)
    return "slept {tag}"
}

route GET "/deep" (n: int) -> int {
    return deep(n, 20)
}

// запрос к самому себе: с одним потоком без сопрограмм он ждал бы себя вечно
route GET "/self" (port: int) -> str {
    let r = fetch GET "http://127.0.0.1:{port}/sleep?ms=20&tag=inner"
    return "{r.status} {r.body}"
}

route GET "/boom" () -> str {
    sleep(5)
    let xs = [1, 2]
    return "{xs[5]}"
}

route GET "/deny" () -> str {
    sleep(5)
    fail(403, "denied")
    return ""
}

route POST "/log" (text: str) -> int {
    log.push(text + "-a")
    sleep(10)
    log.push(text + "-b")
    return log.len()
}

route GET "/log" () -> int {
    return log.len()
}

// fetch к сервису tests/coro/upstream.py дважды: второй раз — по тому же
// соединению, если ответ это позволяет
route GET "/twice" (port: int, path: str) -> str {
    let a = fetch GET "http://127.0.0.1:{port}/{path}"
    let b = fetch GET "http://127.0.0.1:{port}/{path}"
    return "{a.status}:{a.body}|{b.status}:{b.body}"
}

route POST "/post" (port: int) -> str {
    let r = fetch POST "http://127.0.0.1:{port}/len" "x"
    return "{r.status}:{r.body}"
}

// ---- Кэш строк через ожидание (docs/design/v0.13-utf8.md, §8) ----
// /walk идёт срезами по строке в 64 КБ и засыпает каждые nap шагов; пока он
// спит, на том же потоке работают другие запросы со своими строками (/text).
// Кэш строк — в арене запроса, поэтому после пробуждения курсор на месте, и
// проход остаётся линейным. Счёт __strc_scanned — на поток, так что /walk
// складывает только свои отрезки между ожиданиями (на одном потоке сопрограмма
// между ними не прерывается).

fn text_of(seed: int, size: int) -> str {
    let parts = ["съешь", " же ", "ещё", "этих", "мягких", "😀", "French", "булок", "ǅ", "日本"]
    var out: [str] = []
    var x = seed
    var bytes = 0
    while bytes < size {
        x = (x * 1103515245 + 12345) % 2147483648
        let p = parts[(x >> 8) % parts.len()]
        out.push(p)
        bytes += p.byte_len()
    }
    return out.join("")
}

fn mix(h: int, s: str) -> int {
    var r = h
    for i in 0..s.byte_len() {
        r = (r * 31 + s.byte(i)) % 1000000007
    }
    return r
}

route GET "/walk" (seed: int, nap: int) -> str {
    let s = text_of(seed, 65536)
    var t0 = __strc_scanned()
    var own = 0
    let n = s.len()
    var h = 0
    var i = 0
    var steps = 0
    while i < n {
        h = mix(h, s[i..i + 8])
        h = mix(h, s[i])
        i += 8
        steps += 1
        if nap > 0 && steps % nap == 0 {
            own += __strc_scanned() - t0
            sleep(1)
            t0 = __strc_scanned()
        }
    }
    own += __strc_scanned() - t0
    let bound = 4 * s.byte_len()
    if own > bound {
        return "{n} {h} scanned {own} > {bound}"
    }
    return "{n} {h} linear"
}

route GET "/text" (seed: int) -> str {
    let s = text_of(seed, 3000)
    let n = s.len()
    var h = n
    var i = n - 1
    while i >= 0 {
        h = mix(h, s[i])
        i -= 3
    }
    h = mix(h, s.lower())
    h = mix(h, s[n / 3..n / 2])
    return "{n} {h}"
}

// ---- Окна без блокировки store (lib/gc.kh, docs/design/v0.13-store-gc.md §6) ----
// Пишущий запрос держит строку store и список в арене со ссылкой на неё через
// fetch к себе: в окне блокировка отпущена, и запись контекста опубликована.
// Пока он ждёт, читающий запрос (/marks) и пишущие (/log) на том же потоке
// идут без задержки; после окна указатели те же.
store marks: [str]

route POST "/hold" (port: int, ms: int, tag: str) -> str {
    marks.push("held-" + tag)
    let mine = marks[marks.len() - 1]
    let keep = [mine, "x"]
    let r = fetch GET "http://127.0.0.1:{port}/sleep?ms={ms}&tag={tag}"
    marks.push("after-" + tag)
    if mine != "held-" + tag || keep[0] != mine {
        return "lost"
    }
    return "{r.status} {r.body} {mine}"
}

route GET "/marks" () -> int {
    return marks.len()
}

// Хеш пароля — тоже окно: PBKDF2 без блокировки, по частям между ожиданиями.
route POST "/hash" (tag: str) -> str {
    marks.push("hash-" + tag)
    let mine = marks[marks.len() - 1]
    let h = hash_password(mine)
    if !check_password(mine, h) || check_password("other", h) {
        return "wrong hash"
    }
    return mine
}

// Проверки сборщика (сервер собран с KHRIP_GC_VERIFY): сколько раз проверено
// начало сборки и сколько опубликованных записей при этом встретилось.
route GET "/gcv" () -> str {
    return "{__gc_vstarts} {__gc_vlinked}"
}
