// Пример главы skill/khrip/postgresql.md на настоящем PostgreSQL
// (tests/skill/check.py дописывает этот файл к нему).
test "postgresql chapter" {
    let a = call POST "/accounts" { owner: "ann" }
    expect a.status == 201
    let ann: Account? = from_json(a.body)
    expect ann != none
    expect ann.balance == 0
    expect ann.note == none
    expect parse_time(ann.created_at) != none
    let b = call POST "/accounts" { owner: "bob", note: "vip" }
    let bob: Account? = from_json(b.body)
    expect bob != none
    expect bob.note == "vip"
    sql "UPDATE accounts SET balance = 100 WHERE id = {ann.id}"
    expect (call POST "/transfers" { from: ann.id, to: bob.id, amount: 30 }).status == 204
    expect (call POST "/transfers" { from: ann.id, to: bob.id, amount: 71 }).status == 409
    expect (call POST "/transfers" { from: ann.id, to: 999, amount: 1 }).status == 404
    let left: int = sql "SELECT balance FROM accounts WHERE id = {ann.id}"
    let got: int = sql "SELECT balance FROM accounts WHERE id = {bob.id}"
    expect left == 70
    expect got == 30
}
