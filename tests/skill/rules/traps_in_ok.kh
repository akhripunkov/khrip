// Правильная половина: формы Khrip.
// in: SKILL.md
// rule: `x in xs`, `k in m` → `xs.contains(x)`, `m.has(k)`; `d.get(k, v)` → `m[k] ?? v`.
// rule: `{x:.2f}` → `{x.round_to(2)}`
fn main() {
    let xs = [1, 2]
    let m = {"a": 1}
    let x = 2
    let price = 1.2345
    if xs.contains(x) {
        print("yes")
    }
    print("{m.has("a")} {m["b"] ?? 0} {price.round_to(2)}")
}
