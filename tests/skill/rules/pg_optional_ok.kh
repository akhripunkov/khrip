// То же без приведения — правильно (khc check без базы проверяет запрос по миграциям).
// in: postgresql.md
// rule: compare an optional exactly as `({x} IS NULL OR col = {x})`
// compiles
migration 1 `CREATE TABLE items (id bigserial PRIMARY KEY, name text NOT NULL)`

type Item { id: int, name: str }

route GET "/items" (before: int?) -> [Item] {
    return sql "SELECT * FROM items WHERE ({before} IS NULL OR id < {before}) ORDER BY id"
}
