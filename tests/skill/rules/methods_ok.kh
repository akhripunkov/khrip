// Правильная половина: методы встроенных, len в обеих формах, своя функция —
// и функция, и метод первого аргумента.
// in: SKILL.md
// rule: Built-ins are methods (`xs.sum()`, `a.max(b)`; `len(xs)` too); a function you declare is also a method of its first argument; `print`, `to_json`, `url_encode` and the calls below are functions only.
fn twice(n: int) -> int {
    return n * 2
}

fn main() {
    let xs = [1, 2]
    let a = 3
    print("{xs.sum()} {a.max(2)} {len(xs)} {xs.len()} {twice(a)} {a.twice()}")
    print(" x ".trim() + url_encode("a b") + to_json(xs))
}
