// Вне tx каждый оператор фиксируется сам: запись после другого оператора — ошибка.
// in: postgresql.md
// rule: Outside `tx` each statement commits on its own, so in a route a write after another statement (or in a loop) is an error
migration 1 `CREATE TABLE accounts (id bigserial PRIMARY KEY, balance bigint NOT NULL DEFAULT 0)`

type Account { id: int, balance: int }

route POST "/accounts/{id}/take" (id: int) -> 204 | 404 | 409 str {
    let a: Account = sql "SELECT * FROM accounts WHERE id = {id}"
    if a.balance < 10 {
        return 409 "insufficient funds"
    }
    sql "UPDATE accounts SET balance = balance - 10 WHERE id = {id}"
    return 204
}
