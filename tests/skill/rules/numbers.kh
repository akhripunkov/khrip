// Целое деление и явные преобразования; литерал int — это float там, где ждут float.
// in: SKILL.md
// rule: int *literal* → float (`t * 2`); otherwise `n.to_float()`, `x.to_int()`, `x.round()`: int and float never mix, `7 / 2` is 3.
fn main() {
    let a = 7
    let t = 1.25
    print("{a / 2} {a % 2} {t * 2} {a.to_float() / 2} {(t * 3).round()} {(t * 3).to_int()}")
}
