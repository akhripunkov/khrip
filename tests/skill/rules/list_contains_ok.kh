// Правильная половина: int, str, bool — contains и index_of; прочие — any.
// in: SKILL.md
// rule: `contains index_of` (int, str, bool; else `xs.any(x => x == v)`)
fn main() {
    let fs = [1.5, 2.5]
    print("{[1, 2].contains(2)} {["a"].index_of("a") ?? -1} {[true].contains(false)}")
    print("{fs.any(x => x == 1.5)}")
}
