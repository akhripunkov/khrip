// { в начале оператора и в ветке match — блок, литерал пишется в скобках.
// in: SKILL.md
// rule: At a statement start and in a `match` arm `{` opens a block: write `({ ... })`.
// expect: a struct literal at the start of a statement needs parentheses or its type: ({ x: ... })
// expect: a struct literal as a match arm needs parentheses or its type: ({ x: ... })
fn main() {
    let s = "a"
    let p = match s {
        "a" => { x: 1 }
        _ => ({ x: 2 })
    }
    { x: 1 }
}
