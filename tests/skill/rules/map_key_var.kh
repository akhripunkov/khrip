// {k: v} — структура с полем k; с переменной k это ошибка, а не словарь.
// in: SKILL.md
// rule: `{k: v}` with a variable `k` is an error.
// rule: let ages = {"ann": 30, (key): 41} // map keys: "text" or (expression)
// expect: ambiguous literal: 'k' is a field name here and also a variable
fn main() {
    let k = "a"
    let m = {k: 1}
    print(to_json(m))
}
