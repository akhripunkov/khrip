type ChSample {
    id: int
    name: str
    active: bool
    score: float
    maybe_score: float?
    note: str?
    tags: [str]
    numbers: [int?]
    flags: [bool]
}

fn require(ok: bool, label: str) {
    if !ok {
        eprint("FAIL " + label + ": " + ch_error())
        exit(1)
    }
}

fn raw_bytes(values: [int]) -> str {
    let b = buf_new(values.len())
    for v in values { buf_byte(b, v) }
    return buf_str(b)
}

// Заголовок RowBinaryWithNamesAndTypes: число столбцов, имена, типы.
fn rb_header(b: Buf, names: [str], types: [str]) {
    __ch_varint(b, names.len())
    for n in names { __ch_string(b, n) }
    for t in types { __ch_string(b, t) }
}

fn bits(f: float) -> int {
    let v: int = __cast(f)
    return v
}

fn le(b: Buf, v: int, width: int) {
    for i in 0..width { buf_byte(b, (v >> (i * 8)) & 255) }
}

type Exotic { f: float, u: str, d: float, e: str, t: int, big: int, flag: bool, maybe: str? }

// Ответ DESCRIBE: name, type, default_type.
fn describe(rows: [[str]]) -> str {
    let b = buf_new(256)
    rb_header(b, ["name", "type", "default_type", "comment"], ["String", "String", "String", "String"])
    for r in rows {
        for v in r { __ch_string(b, v) }
        __ch_string(b, "")
    }
    return buf_str(b)
}

// Цифры Decimal из float так, как их пишет ch_insert, или "error: ...".
fn dec_away(x: float, scale: int, precision: int) -> str {
    let d = __ch_decimal_digits(x.to_str(), scale, precision, CHD_AWAY)
    if d.error != "" {
        return "error: " + d.error
    }
    if d.negative {
        return "-" + d.digits
    }
    return d.digits
}

type Row { id: int, ts: int, page: str, note: str?, score: float, tags: [str], ok: bool }

// Типы ClickHouse, их чтение и вставка под схему (В6, С6, Н11) — без сервера.
fn typed_codecs() {
    // Float32: точное расширение и округление к ближайшему чётному
    require(__ch_f32_to_f64(0x3FC00000) == bits(1.5), "Float32 1.5")
    require(__ch_f32_to_f64(0x00000001) == bits(1.401298464324817e-45), "Float32 smallest subnormal")
    require(__ch_f32_to_f64(0xFF800000) == bits(0.0 - 1.0 / 0.0), "Float32 -Inf")
    require(__ch_f64_to_f32(bits(1.5)) == 0x3FC00000, "Float32 from 1.5")
    require(__ch_f64_to_f32(bits(0.1)) == 0x3DCCCCCD, "Float32 from 0.1 rounds to nearest")
    require(__ch_f64_to_f32(bits(16777217.0)) == 0x4B800000, "Float32 tie rounds to even")
    require(__ch_f64_to_f32(bits(3.4028234663852886e38)) == 0x7F7FFFFF, "Float32 max")
    require(__ch_f64_to_f32(bits(3.5e38)) == -1, "Float32 overflow is an error")
    require(__ch_f64_to_f32(bits(1.0e-46)) == 0, "Float32 underflow to zero")
    require(__ch_f64_to_f32(bits(1.0e-40)) == 0x000116C2, "Float32 subnormal")
    // Decimal в ch_insert: по кратчайшей десятичной записи, половина — от нуля
    require(dec_away(1.005, 2, 10) == "101", "Decimal 1.005 -> 1.01")
    require(dec_away(-12.345, 2, 10) == "-1235", "Decimal half away from zero")
    require(dec_away(1.0e-7, 2, 10) == "0", "Decimal tiny value")
    require(dec_away(1.5e20, 0, 38) == "150000000000000000000", "Decimal beyond int")
    require(dec_away(123456789.0, 2, 10) == "error: does not fit Decimal(10, 2)", "Decimal precision")
    require(dec_away(0.0 / 0.0, 2, 10) == "error: is not a decimal number", "Decimal NaN")
    require(dec_away(12345678901234567000.0, 0, 38) == "12345678901234567000", "trailing zeros of a whole float")
    require(dec_away(-0.00105, 5, 10) == "-105", "digits of a fraction")
    // Decimal128/256: целое без запятой шире int пишется словами (Decimal(38, 18)
    // денег и токенов), предел — точность P
    let d128 = buf_new(32)
    require(__ch_decimal_put(d128, __ch_decimal_digits((10.5).to_str(), 18, 38, CHD_AWAY), 16, true) && d128.len == 16 && load64(d128.data) == -7946744073709551616 && load64(d128.data + 8) == 0, "Decimal128 10.5 at scale 18")
    let n128 = buf_new(32)
    require(__ch_decimal_put(n128, __ch_decimal_digits((0.0 - 10.5).to_str(), 18, 38, CHD_AWAY), 16, true) && load64(n128.data) == 7946744073709551616 && load64(n128.data + 8) == -1, "Decimal128 negative")
    let d256 = buf_new(32)
    require(__ch_decimal_put(d256, __ch_decimal_digits((1.5).to_str(), 40, 76, CHD_AWAY), 32, true) && d256.len == 32 && load64(d256.data) == -7570531732156317696 && load64(d256.data + 8) == 1494890120908054401 && load64(d256.data + 16) == 44 && load64(d256.data + 24) == 0, "Decimal256 1.5 at scale 40")
    require(dec_away(1.0e20, 18, 38) == "error: does not fit Decimal(38, 18)" && dec_away(9.9e19, 18, 38) == "99000000000000000000000000000000000000", "Decimal128 precision")
    let d64 = buf_new(16)
    require(__ch_decimal_put(d64, __ch_decimal_digits((1.5).to_str(), 2, 18, CHD_AWAY), 8, true) && d64.len == 8 && load64(d64.data) == 150, "Decimal64 stays in int")
    // разбор типов
    let en = __ch_type_of("Enum8('it\\'s' = -2, 'a,b' = 1)") ?? __ChType { op: -1 }
    require(en.op == CHT_ENUM && en.names[0] == "it's" && en.values[0] == -2 && en.names[1] == "a,b", "Enum names with escapes")
    let lc = __ch_type_of("LowCardinality(Nullable(String))") ?? __ChType { op: -1 }
    require(lc.op == CHT_NULLABLE && lc.text == "LowCardinality(Nullable(String))", "LowCardinality is its inner type")
    let dec = __ch_type_of("Decimal(38, 5)") ?? __ChType { op: -1 }
    require(dec.op == CHT_DEC && dec.width == 16 && dec.scale == 5, "Decimal width")
    let dt = __ch_type_of("DateTime64(6, 'Europe/Moscow')") ?? __ChType { op: -1 }
    require(dt.op == CHT_DT64 && dt.scale == 6, "DateTime64 scale")
    require(__ch_type_of("Map(String, Array(UInt8))") != none && __ch_type_of("Array(") == none, "unknown and broken types")
    // чтение: Float32, UUID, Decimal128, Enum16, DateTime64, Int128, UInt8 как bool, Nullable
    let b = buf_new(256)
    rb_header(b, ["f", "u", "d", "e", "t", "big", "flag", "maybe"], ["Float32", "UUID", "Decimal(20, 3)", "Enum16('x' = -300, 'y' = 2)", "DateTime64(3)", "Int128", "UInt8", "LowCardinality(Nullable(String))"])
    le(b, 0x3FC00000, 4)
    le(b, 0x61F0C4045CB311E7, 8)
    le(b, 0x6AD3DBA0, 4)
    le(b, 0x907BA600, 4)
    le(b, -12345, 8)
    le(b, -1, 8)
    le(b, -300, 2)
    le(b, 1700000000123, 8)
    le(b, -5, 8)
    le(b, -1, 8)
    buf_byte(b, 1)
    buf_byte(b, 0)
    __ch_string(b, "z")
    let exotic: [Exotic]? = ch_decode(buf_str(b))
    require(to_json(exotic ?? []) == "[\{\"f\":1.5,\"u\":\"61f0c404-5cb3-11e7-907b-a6006ad3dba0\",\"d\":-12.345,\"e\":\"x\",\"t\":1700000000123,\"big\":-5,\"flag\":true,\"maybe\":\"z\"}]", "exotic column types")
    let wide_dec = buf_new(64)
    rb_header(wide_dec, ["value"], ["Decimal(38, 0)"])
    le(wide_dec, 0, 8)
    le(wide_dec, -1, 8)
    le(wide_dec, 0, 8)
    le(wide_dec, 1, 8)
    let decs: [float]? = ch_decode(buf_str(wide_dec))
    require(to_json(decs ?? []) == "[-18446744073709552000,18446744073709552000]", "Decimal128 beyond int64")
    let huge = buf_new(64)
    rb_header(huge, ["value"], ["UInt128"])
    le(huge, 1, 8)
    le(huge, 1, 8)
    let wide: [int]? = ch_decode(buf_str(huge))
    require(wide == none && ch_error().contains("does not fit"), "UInt128 beyond int")
    let nb = buf_new(64)
    rb_header(nb, ["value"], ["Nullable(String)"])
    buf_byte(nb, 1)
    let strict: [str]? = ch_decode(buf_str(nb))
    require(strict == none && ch_error().contains("does not match Khrip type str"), "Nullable needs T?")
    // вставка под схему: сужение, флаги NULL, массивы
    let schema = describe([["id", "UInt64", ""], ["ts", "DateTime", ""], ["page", "LowCardinality(String)", ""], ["note", "Nullable(String)", ""], ["score", "Float32", ""], ["tags", "Array(FixedString(2))", ""], ["ok", "UInt8", ""], ["twice", "UInt64", "MATERIALIZED"]])
    let rows = [Row { id: 7, ts: 1700000000, page: "/", note: none, score: 0.5, tags: ["ab", "c"], ok: true }]
    let body = ch_encode(rows)
    let r = __ChReader { p: __str_ptr(body), end: __str_ptr(body) + body.byte_len() }
    let count = __ch_read_varint(r)
    var cols: [str] = []
    var srcs: [str] = []
    for i in 0..count { cols.push(__ch_read_str(r)) }
    for i in 0..count { srcs.push(__ch_read_str(r)) }
    let plan = __ch_insert_plan(schema, cols, srcs)
    require(plan.error == "" && !plan.same, "insert plan: " + plan.error)
    let out = __ch_transcode(r, cols, plan)
    let wanted = buf_new(128)
    rb_header(wanted, ["id", "ts", "page", "note", "score", "tags", "ok"], ["UInt64", "DateTime", "LowCardinality(String)", "Nullable(String)", "Float32", "Array(FixedString(2))", "UInt8"])
    le(wanted, 7, 8)
    le(wanted, 1700000000, 4)
    __ch_string(wanted, "/")
    buf_byte(wanted, 1)
    le(wanted, 0x3F000000, 4)
    buf_byte(wanted, 2)
    buf_add(wanted, "ab")
    buf_add(wanted, "c")
    buf_byte(wanted, 0)
    buf_byte(wanted, 1)
    require(r.error == "" && out == buf_str(wanted), "transcoded batch: " + r.error)
    require(__ch_insert_plan(describe([["id", "Int64", ""]]), cols, srcs).error == "table has no column 'ts'", "missing column")
    require(__ch_insert_plan(describe([["id", "Int64", "ALIAS"]]), ["id"], ["Int64"]).error == "column 'id' is ALIAS and cannot be inserted", "alias column")
    require(__ch_insert_plan(describe([["id", "Tuple(Int64, String)", ""]]), ["id"], ["Int64"]).error == "column 'id': Khrip int cannot be written to ClickHouse Tuple(Int64, String)", "unsupported column type")
    let same = __ch_insert_plan(describe([["id", "Int64", ""], ["v", "Nullable(String)", ""]]), ["id", "v"], ["Int64", "Nullable(String)"])
    require(same.error == "" && same.same, "matching types send the batch as is")
}

// ---- Типизированный слой (lib/chdb.kh): планы в секундах Khrip ----
// Описания типов собираются вручную — те же слова, что пишет компилятор.

fn d_scalar(k: int) -> int {
    let d = __alloc(8)
    store64(d, k)
    return d
}

fn d_wrap(k: int, inner: int) -> int {
    let d = __alloc(16)
    store64(d, k)
    store64(d + 8, inner)
    return d
}

fn d_struct(name: str, names: [str], descs: [int]) -> int {
    let n = names.len()
    let d = __alloc(32 + n * 40)
    store64(d, D_STRUCT)
    store64(d + 8, n)
    store64(d + 16, __cast(name))
    store64(d + 24, -1)
    for i in 0..n {
        let f = d + 32 + i * 40
        store64(f, __cast(names[i]))
        store64(f + 8, __cast("\"" + names[i] + "\":"))
        store64(f + 16, descs[i])
        store64(f + 24, 0)
        store64(f + 32, 0)
    }
    return d
}

// Перечисление: значения вариантов — свои слова (как адреса вариантов без полей).
fn d_enum(name: str, labels: [str]) -> int {
    let n = labels.len()
    let d = __alloc(32 + n * 24)
    store64(d, D_SUM)
    store64(d + 8, n)
    store64(d + 16, __cast(name))
    store64(d + 24, 1)
    for i in 0..n {
        let e = d + 32 + i * 24
        store64(e, __cast(labels[i]))
        store64(e + 8, 0)
        store64(e + 16, __alloc(8))
    }
    return d
}

fn enum_word(d: int, i: int) -> int {
    return load64(d + 32 + i * 24 + 16)
}

fn ty(text: str) -> __ChType {
    return __ch_type_of(text) ?? __ChType { op: -1 }
}

fn write_one(p: __ChTWrite, v: int) -> str {
    let b = buf_new(64)
    let err = buf_new(16)
    if !__ch_twrite(b, p, v, err) {
        return "error: " + buf_str(err)
    }
    return buf_str(b)
}

fn le_bytes(v: int, width: int) -> str {
    let b = buf_new(width)
    le(b, v, width)
    return buf_str(b)
}

fn typed_layer() {
    // ответ сервера: код ошибки и сводка
    require(__ch_code_of("Code: 241. DB::Exception: Memory limit (total) exceeded") == 241, "exception code from the body")
    require(__ch_code_of("no code here") == 0, "no exception code")
    require(__ch_summary_int("\{\"read_rows\":\"1\",\"written_rows\":\"12345\",\"result_rows\":\"0\"}", "written_rows") == 12345, "summary written_rows")
    require(__ch_summary_int("", "written_rows") == -1, "no summary")
    // типы: Map, IP, Nothing, LowCardinality без обёртки
    let map = ty("Map(LowCardinality(String), Array(Nullable(UInt32)))")
    require(map.op == CHT_MAP && __ch_type_of("Map(String)") == none, "Map type")
    let mk: __ChType = __cast(map.key)
    require(mk.op == CHT_STR && mk.plain == "String" && mk.text == "LowCardinality(String)", "LowCardinality plain text")
    require(ty("IPv4").op == CHT_IPV4 && ty("IPv6").op == CHT_IPV6 && ty("Nullable(Nothing)").op == CHT_NULLABLE, "IP and Nothing types")
    // числа произвольной ширины и Decimal
    require(__ch_wide_text(__str_ptr(le_bytes(-1, 8) + le_bytes(-1, 8)), 16, true) == "-1", "Int128 -1")
    require(__ch_wide_text(__str_ptr(le_bytes(0, 8) + le_bytes(1, 8)), 16, false) == "18446744073709551616", "UInt128 2^64")
    require(__ch_wide_text(__str_ptr(le_bytes(-1, 8).repeat(4)), 32, false) == "115792089237316195423570985008687907853269984665640564039457584007913129639935", "UInt256 max")
    let wb = buf_new(16)
    require(__ch_wide_put(wb, true, "18446744073709551617", 16, true) && __ch_wide_text(wb.data, 16, true) == "-18446744073709551617", "Int128 from digits")
    require(!__ch_wide_put(buf_new(16), false, "170141183460469231731687303715884105728", 16, true), "Int128 overflow")
    // Int128/Int256/UInt128/UInt256 из текста: знак и границы столбца
    let ds0 = d_scalar(D_STR)
    let u128 = __ch_twrite_plan(ty("UInt128"), ds0, false, 0) ?? __ChTWrite { op: 0 }
    let i128 = __ch_twrite_plan(ty("Int128"), ds0, false, 0) ?? __ChTWrite { op: 0 }
    let u256 = __ch_twrite_plan(ty("UInt256"), ds0, false, 0) ?? __ChTWrite { op: 0 }
    let i256 = __ch_twrite_plan(ty("Int256"), ds0, false, 0) ?? __ChTWrite { op: 0 }
    require(write_one(u128, __cast("-1")) == "error: '-1' is out of range for UInt128", "UInt128 refuses -1")
    // NaN и бесконечность — не числа столбца
    let dfl = d_scalar(D_FLOAT)
    let f64 = __ch_twrite_plan(ty("Float64"), dfl, false, 0) ?? __ChTWrite { op: 0 }
    let f32 = __ch_twrite_plan(ty("Float32"), dfl, false, 0) ?? __ChTWrite { op: 0 }
    let dec = __ch_twrite_plan(ty("Decimal(12, 2)"), dfl, false, 0) ?? __ChTWrite { op: 0 }
    let inf = 1.0 / 0.0
    let nan = inf - inf
    require(write_one(f64, bits(1.5)) == le_bytes(bits(1.5), 8), "Float64 1.5")
    require(write_one(f64, bits(nan)).starts_with("error: ") && write_one(f64, bits(nan)).ends_with(" is not a finite number"), "Float64 refuses NaN")
    require(write_one(f64, bits(inf)).ends_with(" is not a finite number"), "Float64 refuses Inf")
    require(write_one(f32, bits(0.0 - inf)).ends_with(" is not a finite number"), "Float32 refuses -Inf")
    require(write_one(dec, bits(inf)).ends_with(" is not a finite number"), "Decimal refuses Inf")
    require(write_one(u128, __cast("340282366920938463463374607431768211455")) == raw_bytes([255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255]), "UInt128 max")
    require(write_one(u128, __cast("340282366920938463463374607431768211456")) == "error: '340282366920938463463374607431768211456' is out of range for UInt128", "UInt128 max + 1")
    require(write_one(i128, __cast("-170141183460469231731687303715884105728")) == le_bytes(0, 8) + le_bytes(-9223372036854775807 - 1, 8), "Int128 min")
    require(write_one(i128, __cast("170141183460469231731687303715884105728")) == "error: '170141183460469231731687303715884105728' is out of range for Int128", "Int128 max + 1")
    require(write_one(i128, __cast("-0")) == le_bytes(0, 8) + le_bytes(0, 8), "Int128 -0")
    require(write_one(u256, __cast("115792089237316195423570985008687907853269984665640564039457584007913129639935")) == raw_bytes([255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255,255]), "UInt256 max")
    require(write_one(i256, __cast("-57896044618658097711785492504343953926634992332820282019728792003956564819968")) == le_bytes(0, 8).repeat(3) + le_bytes(-9223372036854775807 - 1, 8), "Int256 min")
    require(write_one(u256, __cast("1.5")) == "error: '1.5' has more than 0 decimal places", "UInt256 fraction")
    require(__ch_decimal_text(__str_ptr(le_bytes(-1205, 8)), 8, 2) == "-12.05" && __ch_decimal_text(__str_ptr(le_bytes(5, 4)), 4, 3) == "0.005", "Decimal text keeps the scale")
    let half = __ch_decimal_digits("0.125", 2, 10, CHD_EVEN)
    let up = __ch_decimal_digits("0.135", 2, 10, CHD_EVEN)
    let even = __ch_decimal_digits("2.5", 0, 10, CHD_EVEN)
    require(half.digits == "12" && up.digits == "14" && even.digits == "2", "Decimal from float rounds half to even")
    require(__ch_decimal_digits("12.345", 2, 10, CHD_EXACT).error == "has more than 2 decimal places", "Decimal from str is exact")
    require(__ch_decimal_digits("12.3400", 2, 10, CHD_EXACT).digits == "1234", "trailing zeros are exact")
    require(__ch_decimal_digits("123456789.5", 2, 10, CHD_EXACT).error == "does not fit Decimal(10, 2)", "Decimal precision")
    require(__ch_decimal_digits("1e+21", 0, 38, CHD_EVEN).digits == "1000000000000000000000", "Decimal from 1e+21")
    require(__ch_decimal_digits("abc", 2, 10, CHD_EXACT).error == "is not a decimal number", "Decimal text syntax")
    let neg = __ch_decimal_digits("-0.001", 2, 10, CHD_EVEN)
    require(neg.digits == "0" && !neg.negative, "negative zero after rounding")
    // время: секунды Khrip и ISO 8601
    require((__ch_iso_units("2026-10-23", 0) ?? 0) == 1792713600, "ISO date")
    require((__ch_iso_units("2026-10-23T05:06:07Z", 0) ?? 0) == 1792731967, "ISO date and time")
    require((__ch_iso_units("2026-10-23 05:06:07+03:00", 0) ?? 0) == 1792731967 - 10800, "ISO with offset")
    require((__ch_iso_units("2026-10-23T05:06:07.120Z", 3) ?? 0) == 1792731967120, "ISO with milliseconds")
    require(__ch_iso_units("2026-10-23T05:06:07.123Z", 0) == none && __ch_iso_units("2026-13-01", 0) == none, "ISO fraction and month")
    require(__ch_dt64_text(-1, 3) == "1969-12-31T23:59:59.999Z" && __ch_day_text(19000) == "2022-01-08", "DateTime64 and Date text")
    // IP
    require(__ch_ipv4_parse("192.168.0.1") == 0xC0A80001 && __ch_ipv4_parse("1.2.3") < 0 && __ch_ipv4_parse("01.2.3.4") < 0, "IPv4 parse")
    let v6 = buf_new(16)
    require(__ch_ipv6_put(v6, "2001:db8::1") && __ch_ipv6_text(v6.data) == "2001:db8::1", "IPv6 compressed")
    let v4in6 = buf_new(16)
    require(__ch_ipv6_put(v4in6, "10.0.0.1") && __ch_ipv6_text(v4in6.data) == "::ffff:10.0.0.1", "IPv4 in IPv6")
    require(!__ch_ipv6_put(buf_new(16), "1:::2") && !__ch_ipv6_put(buf_new(16), "1:2:3:4:5:6:7:8:9"), "bad IPv6")
    // планы чтения: секунды, Decimal и DateTime64(p > 0) в int — отказ
    let di = d_scalar(D_INT)
    let ds = d_scalar(D_STR)
    let df = d_scalar(D_FLOAT)
    let why = buf_new(16)
    require(__ch_tread_plan(ty("DateTime64(3)"), di, 0, why) == none && buf_str(why) == "dt64", "DateTime64(3) into int refused")
    require(__ch_tread_plan(ty("Decimal(12, 2)"), di, 0, buf_new(16)) == none, "Decimal(12, 2) into int refused")
    require(__ch_tread_plan(ty("Nullable(String)"), ds, 0, buf_new(16)) == none, "Nullable needs T?")
    require(__ch_tread_plan(ty("LowCardinality(String)"), ds, 0, buf_new(16)) != none && __ch_tread_plan(ty("UInt64"), di, 0, buf_new(16)) != none, "LowCardinality and UInt64")
    let level = d_enum("Level", ["debug", "info"])
    require(__ch_tread_plan(ty("Enum8('debug' = 1, 'info' = 2, 'error' = 3)"), level, 0, buf_new(16)) == none, "Enum label without a Khrip variant")
    // чтение строк: Date в секундах, DateTime64 в ISO, Enum в перечисление,
    // Map, лишний столбец пропущен, поле без столбца — none
    let row = d_struct("R", ["day", "at", "lvl", "attrs", "note", "amount"], [di, ds, level, d_wrap(D_MAP, 0), d_wrap(D_OPT, ds), ds])
    store64(row + 32 + 3 * 40 + 16, __alloc(24))
    let md = load64(row + 32 + 3 * 40 + 16)
    store64(md, D_MAP)
    store64(md + 8, ds)
    store64(md + 16, di)
    let rb = buf_new(256)
    rb_header(rb, ["day", "skip", "AT", "lvl", "attrs", "amount"], ["Date", "Array(String)", "DateTime64(3)", "Enum8('debug' = 1, 'info' = 2)", "Map(String, UInt16)", "Decimal(9, 2)"])
    le(rb, 19000, 2)
    buf_byte(rb, 1)
    __ch_string(rb, "x")
    le(rb, 1700000000123, 8)
    le(rb, 2, 1)
    buf_byte(rb, 1)
    __ch_string(rb, "k")
    le(rb, 7, 2)
    le(rb, -1205, 4)
    let got = __ch_tdecode(buf_str(rb), row)
    require(got.error == "" && got.count == 1, "typed decode: " + got.error)
    let first = __lget(got.rows, 0)
    let at: str = __cast(load64(first + 8))
    let amount: str = __cast(load64(first + 40))
    let attrs: map[str, int] = __cast(load64(first + 24))
    require(load64(first) == 19000 * 86400 && at == "2023-11-14T22:13:20.123Z" && load64(first + 16) == enum_word(level, 1) && (attrs["k"] ?? 0) == 7 && load64(first + 32) == 0 && amount == "-12.05", "typed row values")
    let bad = buf_new(64)
    rb_header(bad, ["day"], ["DateTime64(3)"])
    let mismatch = __ch_tdecode(buf_str(bad), d_struct("D", ["day"], [di]))
    require(mismatch.header && mismatch.error == "column day is DateTime64(3), but the Khrip type is int", "header checked before values")
    let missing = __ch_tdecode(buf_str(bad), d_struct("D", ["other"], [di]))
    require(missing.header && missing.error == "field other has no column: the query returns day", "missing field")
    let big = buf_new(64)
    rb_header(big, ["n"], ["UInt64"])
    le(big, -1, 8)
    require(__ch_tdecode(buf_str(big), di).error == "column n: ClickHouse unsigned value does not fit Khrip int", "UInt64 overflow names the column")
    // планы записи: секунды, диапазоны, Decimal, Enum, none → DEFAULT
    require(__ch_twrite_plan(ty("Decimal(12, 2)"), di, false, 0) == none, "int into Decimal(12, 2) refused")
    require(__ch_twrite_plan(ty("String"), d_wrap(D_OPT, ds), false, 0) == none, "str? into String without DEFAULT refused")
    let dflt = __ch_twrite_plan(ty("String"), d_wrap(D_OPT, ds), true, 0) ?? __ChTWrite { op: 0 }
    require(dflt.dst_null && write_one(dflt, 0) == raw_bytes([1]) && write_one(dflt, __cast("ab")) == raw_bytes([0, 2]) + "ab", "none becomes DEFAULT through NULL")
    require(__ch_twrite_plan(ty("Enum8('debug' = 1)"), level, false, 0) == none, "Khrip variant missing from Enum8")
    let day = __ch_twrite_plan(ty("Date"), di, false, 0) ?? __ChTWrite { op: 0 }
    require(write_one(day, 19000 * 86400 + 3600) == le_bytes(19000, 2) && write_one(day, -1) == "error: -1 is out of range for Date", "int seconds into Date")
    let ts = __ch_twrite_plan(ty("DateTime"), di, false, 0) ?? __ChTWrite { op: 0 }
    require(write_one(ts, 4294967296) == "error: 4294967296 is out of range for DateTime", "DateTime range")
    let ms = __ch_twrite_plan(ty("DateTime64(3, 'UTC')"), di, false, 0) ?? __ChTWrite { op: 0 }
    require(write_one(ms, 1700000000) == le_bytes(1700000000000, 8), "int seconds into DateTime64(3)")
    let iso = __ch_twrite_plan(ty("DateTime64(3)"), ds, false, 0) ?? __ChTWrite { op: 0 }
    require(write_one(iso, __cast("2023-11-14T22:13:20.123Z")) == le_bytes(1700000000123, 8) && write_one(iso, __cast("yesterday")) == "error: 'yesterday' is not an ISO 8601 date and time for DateTime64(3)", "ISO into DateTime64(3)")
    let u8 = __ch_twrite_plan(ty("UInt64"), di, false, 0) ?? __ChTWrite { op: 0 }
    require(write_one(u8, -1) == "error: -1 is out of range for UInt64", "UInt64 range")
    let money = __ch_twrite_plan(ty("Decimal(12, 2)"), ds, false, 0) ?? __ChTWrite { op: 0 }
    require(write_one(money, __cast("12.34")) == le_bytes(1234, 8) && write_one(money, __cast("1.005")) == "error: '1.005' has more than 2 decimal places", "str into Decimal is exact")
    let rounded = __ch_twrite_plan(ty("Decimal(12, 2)"), df, false, 0) ?? __ChTWrite { op: 0 }
    let x: int = __cast(0.125)
    require(write_one(rounded, x) == le_bytes(12, 8), "float into Decimal half to even")
    let lvl = __ch_twrite_plan(ty("Enum8('debug' = 1, 'info' = 2, 'error' = 3)"), level, false, 0) ?? __ChTWrite { op: 0 }
    require(write_one(lvl, enum_word(level, 1)) == le_bytes(2, 1), "Khrip enum into Enum8")
    let label = __ch_twrite_plan(ty("LowCardinality(String)"), level, false, 0) ?? __ChTWrite { op: 0 }
    require(write_one(label, enum_word(level, 0)) == raw_bytes([5]) + "debug", "Khrip enum into String")
    let ip = __ch_twrite_plan(ty("IPv6"), ds, false, 0) ?? __ChTWrite { op: 0 }
    require(write_one(ip, __cast("::1")).byte_len() == 16 && write_one(ip, __cast("nope")) == "error: 'nope' is not an IP address", "IPv6 from text")
}

fn main() -> int {
    let original = [
        ChSample { id: -9223372036854775807 - 1, name: "Привет\0\n\\", active: true, score: 2.5, maybe_score: -3.125, note: none, tags: ["a", "", "б"], numbers: [1, none, -4], flags: [true, false, true] },
        ChSample { id: 9223372036854775807, name: "", active: false, score: -0.25, maybe_score: none, note: "", tags: [], numbers: [], flags: [] }
    ]
    let body = ch_encode(original)
    require(body.byte_len() > 0 && ch_error() == "", "encode")
    let decoded: [ChSample]? = ch_decode(body)
    require(decoded != none, "decode")
    require(to_json(decoded ?? []) == to_json(original), "all supported types roundtrip")
    let empty: [ChSample] = []
    let empty_back: [ChSample]? = ch_decode(ch_encode(empty))
    require(empty_back != none && (empty_back ?? []).len() == 0, "empty typed batch")
    for n in 0..body.byte_len() {
        let cut: [ChSample]? = ch_decode(body.byte_slice(0, n))
        // Only a complete header or a complete row boundary is valid.
        if cut != none {
            let rows = cut ?? []
            require(rows.len() < original.len(), "truncation did not invent rows")
            require(ch_encode(rows) == body.byte_slice(0, n), "truncation accepts only row boundaries")
        }
    }
    let wrong: [int]? = ch_decode(body)
    require(wrong == none && ch_error().byte_len() > 0, "wrong result shape")
    let scalar: [int]? = ch_decode(ch_encode([-4, 0, 9223372036854775807]))
    require(to_json(scalar ?? []) == "[-4,0,9223372036854775807]", "scalar rows")
    let boolean: [bool]? = ch_decode(ch_encode([true, false]))
    require(to_json(boolean ?? []) == "[true,false]", "packed booleans")
    // A forged length must be rejected before allocating or dereferencing it.
    let huge: [int]? = ch_decode(raw_bytes([255,255,255,255,255,255,255,255,255,255]))
    require(huge == none, "oversized varint")
    let noncanonical: [int]? = ch_decode(raw_bytes([129,0]))
    require(noncanonical == none, "noncanonical varint")
    typed_codecs()
    typed_layer()
    print("ClickHouse codec: ok")
    return 0
}
