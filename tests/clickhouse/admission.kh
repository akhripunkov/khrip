type AdmissionResult { ok: bool, unknown: bool, error: str }

route GET "/ready" -> str { return "ready" }

route GET "/active" -> int { return load64(__ctx() + CTX_CHACTIVE) }

route GET "/waiting" -> int { return __wq_len(__ctx() + CTX_CHWAIT) }

route GET "/run/{mode}" (mode: str, timeout_ms: int = 5000, inflight: int = 2) -> AdmissionResult {
    let config = ChConfig {
        url: (env("CH_MOCK_URL") ?? "http://127.0.0.1:18371") + "/" + mode,
        timeout_ms,
        max_inflight: inflight
    }
    let r = ch_query(config, "SELECT 1")
    return AdmissionResult { ok: r.ok, unknown: r.unknown_outcome, error: r.error }
}

// Порядок обслуживания: mock запоминает номера путей /order/n.
route GET "/order/{n}" (n: int) -> AdmissionResult {
    let config = ChConfig { url: (env("CH_MOCK_URL") ?? "http://127.0.0.1:18371") + "/order/" + n.to_str(), timeout_ms: 10000, max_inflight: 1 }
    let r = ch_query(config, "SELECT 1")
    return AdmissionResult { ok: r.ok, unknown: r.unknown_outcome, error: r.error }
}

// Н12: max_execution_time — остаток срока на момент отправки (ожидание места
// в очереди в него уже не входит).
route GET "/budget" (timeout_ms: int = 1000) -> str {
    let config = ChConfig { url: (env("CH_MOCK_URL") ?? "http://127.0.0.1:18371") + "/echo", timeout_ms, max_inflight: 2 }
    let r = ch_query(config, "SELECT 1")
    if !r.ok { fail(500, r.error) }
    return r.body
}

route POST "/fault/{mode}" (mode: int) -> int | 409 str {
    let guard = __DbHttp { c: -1, tag: 0, deadline: now_ms() + 5000, input: buf_new(16) }
    store64(__ctx() + CTX_CHHELD, __cast(guard))
    if !__dh_acquire(guard, 2) { fail(500, "test admission timed out") }
    sleep(5)
    if mode == 0 { fail(409, "lease released after fail") }
    let values = [1]
    return values[mode]
}

// Окно __ch_run без блокировки store (docs/design/v0.13-store-gc.md §6.5):
// пишущий запрос держит строку store, пока ждёт ClickHouse (mock /hold —
// 0,4 с); тем временем на том же единственном потоке читают store (/marks).
store marks: [str]

route POST "/stored/{tag}" (tag: str) -> AdmissionResult {
    marks.push("held-" + tag)
    let mine = marks[marks.len() - 1]
    let config = ChConfig { url: (env("CH_MOCK_URL") ?? "http://127.0.0.1:18371") + "/hold", timeout_ms: 5000, max_inflight: 2 }
    let r = ch_query(config, "SELECT 1")
    marks.push("after-" + tag)
    if mine != "held-" + tag {
        return AdmissionResult { ok: false, unknown: false, error: "store string changed across the window" }
    }
    return AdmissionResult { ok: r.ok, unknown: r.unknown_outcome, error: r.error }
}

route GET "/marks" -> int { return marks.len() }
