type ChEvent {
    id: int
    name: str
    active: bool
    score: float
    note: str?
    tags: [str]
    numbers: [int?]
}

// Типичная аналитическая таблица: UInt64, DateTime, LowCardinality(String),
// Nullable(String), Float32, Array(String).
type ChHit {
    id: int
    ts: int
    page: str
    referrer: str?
    score: float
    tags: [str]
}

type ChWide {
    uid: str
    kind: str
    amount: float
    at_ms: int
    day: int
    code: str
    small: int
    flag: int
    on: bool
    maybe: int?
}

type ChWideText { uid: str, kind: str, amount: str, at_ms: str, day: str, code: str, small: str, flag: str, on: str, maybe: str? }
type Doubled { id: int, doubled: int }
type HitCountry { id: int, country: int }
type Narrow { id: int, e: str, code: str }
type Dec { n: int, a: float, b: float, p: float }
type DecText { a: str, b: str, p: str }
type Optional { id: int, name: str? }

fn need(ok: bool, label: str) {
    if !ok {
        eprint("FAIL " + label + ": " + ch_error())
        exit(1)
    }
}

fn successful(r: ChResult, label: str) {
    if !r.ok {
        eprint("FAIL " + label + " [" + r.status.to_str() + "]: " + r.error)
        exit(1)
    }
}

fn refused(r: ChResult, label: str, text: str) {
    if r.ok || r.unknown_outcome || !r.error.contains(text) {
        eprint("FAIL " + label + ": ok=" + r.ok.to_str() + " error=" + r.error)
        exit(1)
    }
}

fn table_count(c: ChConfig, table: str) -> int {
    let r = ch_query_params(c, "SELECT count() AS value FROM \{t:Identifier}", {"t": table})
    successful(r, "count " + table)
    let n: [int]? = ch_decode(r.body)
    return (n ?? [-1])[0]
}

fn main() -> int {
    let c = ChConfig {
        url: env("CLICKHOUSE_URL") ?? "http://127.0.0.1:18123/",
        database: env("CLICKHOUSE_DATABASE") ?? "khrip_test",
        user: env("CLICKHOUSE_USER") ?? "khrip",
        password: env("CLICKHOUSE_PASSWORD") ?? "test-only"
    }
    // база тестов (CLICKHOUSE_DATABASE, по умолчанию khrip_test) создаётся
    // здесь, а не стендом tests/databases/run.sh
    successful(ch_query_params(ChConfig { ...c, database: "default" }, "CREATE DATABASE IF NOT EXISTS \{d:Identifier}", {"d": c.database}), "create database")
    let table = "kh_events_" + random_str(12)
    successful(ch_query_params(c, "CREATE TABLE \{t:Identifier} (id Int64, name String, active Bool, score Float64, note Nullable(String), tags Array(String), numbers Array(Nullable(Int64))) ENGINE=Memory", {"t": table}), "create")
    let original = [
        ChEvent { id: 1, name: "Привет\0\n\\", active: true, score: 2.5, note: none, tags: ["a", "", "б"], numbers: [1, none, -4] },
        ChEvent { id: 2, name: "", active: false, score: -0.25, note: "", tags: [], numbers: [] }
    ]
    successful(ch_insert(c, table, ch_encode(original)), "binary insert")
    let result = ch_query_params(c, "SELECT numbers,score,id,tags,name,note,active FROM \{t:Identifier} ORDER BY id", {"t": table})
    successful(result, "binary select")
    let actual: [ChEvent]? = ch_decode(result.body)
    need(actual != none && to_json(actual ?? []) == to_json(original), "typed reordered columns")
    let odd = "a'\\\t\n\r\0; DROP TABLE " + table
    let bound = ch_query_params(c, "SELECT \{value:String} AS value", {"value": odd})
    successful(bound, "bound parameter")
    let text: [str]? = ch_decode(bound.body)
    need((text ?? [""])[0] == odd, "parameters preserve bytes and cannot inject SQL")
    let number = ch_query_params(c, "SELECT \{n:Int64} AS value", {"n": "-42"})
    successful(number, "integer parameter")
    let nums: [int]? = ch_decode(number.body)
    need((nums ?? [0])[0] == -42, "integer parameter roundtrip")
    // Н9: NULL параметром; \N в строке — текст; 64 КиБ не-ASCII (в адресе
    // байт занимал три, и сервер отвергал поле больше 128 КиБ)
    let null_param = ch_query_params(c, "SELECT \{s:Nullable(String)} AS value", {"s": ch_null()})
    successful(null_param, "NULL parameter")
    let nulls: [str?]? = ch_decode(null_param.body)
    need(nulls != none && (nulls ?? ["x"])[0] == none, "ch_null() is NULL")
    let literal = ch_query_params(c, "SELECT \{s:Nullable(String)} AS value", {"s": "\\N"})
    let literals: [str?]? = ch_decode(literal.body)
    need(((literals ?? [none])[0] ?? "") == "\\N", "a \\N string stays text")
    let wide = "я".repeat(32768)
    let long = ch_query_params(c, "SELECT lengthUTF8(\{s:String}) AS value, \{s:String} = repeat('я', 32768) AS same", {"s": wide})
    successful(long, "64 KiB non-ASCII parameter")
    type_check_long(long.body)
    let ints = ch_query(c, "SELECT toInt8(-128) AS value UNION ALL SELECT toInt8(127)")
    successful(ints, "narrow integers")
    let small: [int]? = ch_decode(ints.body)
    need((small ?? []).contains(-128) && (small ?? []).contains(127), "signed integer extension")
    let uints = ch_query(c, "SELECT toUInt64(18446744073709551615) AS value")
    successful(uints, "UInt64 response")
    let overflow: [int]? = ch_decode(uints.body)
    need(overflow == none && ch_error().contains("does not fit"), "UInt64 overflow rejected")
    let error = ch_query_params(c, "SELECT no_such_column FROM \{t:Identifier}", {"t": table})
    need(!error.ok && error.status >= 400 && error.error.byte_len() > 0, "server error")
    let late = ch_query(c, "SELECT throwIf(number=9) FROM numbers(10) SETTINGS max_block_size=1")
    need(!late.ok, "late server error not reported as success")
    let denied = ChConfig { ...c, password: "wrong-password" }
    need(!ch_query(denied, "SELECT 1").ok, "authentication failure")
    successful(ch_query(c, "SELECT 1"), "connection usable after errors")
    let bounded = ChConfig { ...c, max_response_bytes: 100 }
    let large = ch_query(bounded, "SELECT repeat('x', 1000) AS value")
    need(!large.ok, "bounded response")
    // С5: серверного max_result_bytes нет — сервер считал байты блоков (у
    // String ещё и смещения), и 4 МБ ответа упирались в лимит 16 МиБ
    let strings = ch_query(c, "SELECT toString(number % 10) AS value FROM numbers(2000000)")
    successful(strings, "2M short strings within max_response_bytes")
    need(strings.body.byte_len() == 4000014, "2M short strings size")
    let timeout = ChConfig { ...c, timeout_ms: 100 }
    let started = now_ms()
    let slow = ch_query(timeout, "SELECT sleep(2) AS value")
    need(!slow.ok && now_ms() - started < 1500, "deadline")
    // A timeout never promises server cancellation. Cancel using the returned ID.
    successful(ch_cancel(c, slow.query_id), "explicit cancellation")

    // В6: вставка под настоящие типы столбцов. Int32 вместо Int64 — сужение с
    // проверкой диапазона, а не отказ сервера.
    let narrow = "kh_narrow_" + random_str(12)
    successful(ch_query_params(c, "CREATE TABLE \{t:Identifier} (id Int32, name String, active Bool, score Float64, note Nullable(String), tags Array(String), numbers Array(Nullable(Int64))) ENGINE=Memory", {"t": narrow}), "create Int32 schema")
    successful(ch_insert(c, narrow, ch_encode(original)), "int narrowed to Int32")
    let too_big = [ChEvent { ...original[0], id: 3000000000 }]
    refused(ch_insert(c, narrow, ch_encode(too_big)), "Int32 range", "column 'id' (Int32): value 3000000000 is out of range")
    need(table_count(c, narrow) == 2, "rejected batch wrote nothing")
    successful(ch_query_params(c, "DROP TABLE \{t:Identifier}", {"t": narrow}), "drop Int32 schema")
    let mismatched = "kh_wrong_" + random_str(12)
    successful(ch_query_params(c, "CREATE TABLE \{t:Identifier} (id String, name String) ENGINE=Memory", {"t": mismatched}), "create wrong schema")
    refused(ch_insert(c, mismatched, ch_encode(original)), "incompatible column", "column 'id': Khrip int cannot be written to ClickHouse String")
    successful(ch_query_params(c, "DROP TABLE \{t:Identifier}", {"t": mismatched}), "drop wrong schema")

    let hits = "kh_hits_" + random_str(12)
    successful(ch_query_params(c, "CREATE TABLE \{t:Identifier} (id UInt64, ts DateTime, page LowCardinality(String), referrer Nullable(String), score Float32, tags Array(String), visits UInt32 DEFAULT 1, doubled UInt64 MATERIALIZED id * 2) ENGINE=MergeTree ORDER BY id", {"t": hits}), "create analytic table")
    let views = [
        ChHit { id: 1, ts: 1700000000, page: "/", referrer: none, score: 0.5, tags: ["new", "mobile"] },
        ChHit { id: 2, ts: 4294967295, page: "/pricing", referrer: "https://example.com/", score: -1.25, tags: [] }
    ]
    let misses = __ch_schema_misses()
    successful(ch_insert(c, hits, ch_encode(views)), "analytic insert")
    successful(ch_insert(c, hits, ch_encode([ChHit { ...views[0], id: 3 }])), "second analytic insert")
    need(__ch_schema_misses() == misses + 1, "DESCRIBE once per table and process")
    let read = ch_query_params(c, "SELECT id, ts, page, referrer, score, tags FROM \{t:Identifier} WHERE id < 3 ORDER BY id", {"t": hits})
    successful(read, "analytic select")
    let back: [ChHit]? = ch_decode(read.body)
    need(to_json(back ?? []) == to_json(views), "analytic roundtrip (UInt64, DateTime, LowCardinality, Nullable, Float32)")
    refused(ch_insert(c, hits, ch_encode([ChHit { ...views[0], id: -1 }])), "UInt64 range", "column 'id' (UInt64): value -1 is out of range")
    refused(ch_insert(c, hits, ch_encode([ChHit { ...views[0], ts: 4294967296 }])), "DateTime range", "column 'ts' (DateTime): value 4294967296 is out of range")
    refused(ch_insert(c, hits, ch_encode([ChHit { ...views[0], score: 1.0e300 }])), "Float32 range", "column 'score' (Float32): value 1e+300 exceeds Float32")
    refused(ch_insert(c, hits, ch_encode([Doubled { id: 9, doubled: 18 }])), "materialized column", "column 'doubled' is MATERIALIZED and cannot be inserted")
    // таблицу изменили после кэша: незнакомый столбец — повторный DESCRIBE
    successful(ch_query_params(c, "ALTER TABLE \{t:Identifier} ADD COLUMN country UInt32 DEFAULT 0", {"t": hits}), "add column")
    successful(ch_insert(c, hits, ch_encode([HitCountry { id: 10, country: 31 }])), "insert after ALTER ADD COLUMN")
    // + 4 — ещё и отказы выше (три диапазона и MATERIALIZED): ошибка по схеме
    // из кэша её перепроверяет — таблицу могли изменить
    need(__ch_schema_misses() == misses + 6, "unknown column asks DESCRIBE again")
    // тип столбца сменился: заголовок пакета с прежним типом сервер отвергает
    // до чтения строк — схема заново, та же вставка проходит
    successful(ch_query_params(c, "ALTER TABLE \{t:Identifier} MODIFY COLUMN country UInt64", {"t": hits}), "modify column")
    successful(ch_insert(c, hits, ch_encode([HitCountry { id: 11, country: 49 }])), "insert after ALTER MODIFY COLUMN")
    need(__ch_schema_misses() == misses + 7, "server header rejection asks DESCRIBE again")
    need(table_count(c, hits) == 5, "analytic row count")
    successful(ch_query_params(c, "DROP TABLE \{t:Identifier}", {"t": hits}), "drop analytic table")

    // Остальные типы чтения и записи: UUID, Enum8, Decimal, DateTime64(3),
    // Date, FixedString, Int8, UInt8, Bool, Nullable(Int32).
    let typed = "kh_typed_" + random_str(12)
    successful(ch_query_params(c, "CREATE TABLE \{t:Identifier} (uid UUID, kind Enum8('view' = 1, 'it''s' = -2), amount Decimal(10, 2), at_ms DateTime64(3, 'UTC'), day Date, code FixedString(4), small Int8, flag UInt8, on Bool, maybe Nullable(Int32)) ENGINE=Memory", {"t": typed}), "create typed table")
    let rows = [
        ChWide { uid: "61f0c404-5cb3-11e7-907b-a6006ad3dba0", kind: "it's", amount: 1.005, at_ms: 1700000000123, day: 19000, code: "ab", small: -128, flag: 255, on: true, maybe: none },
        ChWide { uid: "00000000-0000-0000-0000-00000000000F", kind: "view", amount: -12.34, at_ms: 0, day: 0, code: "abcd", small: 127, flag: 0, on: false, maybe: -7 }
    ]
    successful(ch_insert(c, typed, ch_encode(rows)), "typed insert")
    let typed_text = ch_query_params(c, "SELECT toString(uid) AS uid, toString(kind) AS kind, toString(amount) AS amount, toString(at_ms) AS at_ms, toString(day) AS day, hex(code) AS code, toString(small) AS small, toString(flag) AS flag, toString(on) AS on, toString(maybe) AS maybe FROM \{t:Identifier} ORDER BY small", {"t": typed})
    successful(typed_text, "typed select as text")
    let texts: [ChWideText]? = ch_decode(typed_text.body)
    need(to_json(texts ?? []) == "[\{\"uid\":\"61f0c404-5cb3-11e7-907b-a6006ad3dba0\",\"kind\":\"it's\",\"amount\":\"1.01\",\"at_ms\":\"2023-11-14 22:13:20.123\",\"day\":\"2022-01-08\",\"code\":\"61620000\",\"small\":\"-128\",\"flag\":\"255\",\"on\":\"true\",\"maybe\":null},\{\"uid\":\"00000000-0000-0000-0000-00000000000f\",\"kind\":\"view\",\"amount\":\"-12.34\",\"at_ms\":\"1970-01-01 00:00:00.000\",\"day\":\"1970-01-01\",\"code\":\"61626364\",\"small\":\"127\",\"flag\":\"0\",\"on\":\"false\",\"maybe\":\"-7\"}]", "server sees the intended values")
    let typed_back = ch_query_params(c, "SELECT uid, kind, amount, at_ms, day, code, small, flag, on, maybe FROM \{t:Identifier} ORDER BY small", {"t": typed})
    let wide_rows: [ChWide]? = ch_decode(typed_back.body)
    need(to_json(wide_rows ?? []) == "[\{\"uid\":\"61f0c404-5cb3-11e7-907b-a6006ad3dba0\",\"kind\":\"it's\",\"amount\":1.01,\"at_ms\":1700000000123,\"day\":19000,\"code\":\"ab\\u0000\\u0000\",\"small\":-128,\"flag\":255,\"on\":true,\"maybe\":null},\{\"uid\":\"00000000-0000-0000-0000-00000000000f\",\"kind\":\"view\",\"amount\":-12.34,\"at_ms\":0,\"day\":0,\"code\":\"abcd\",\"small\":127,\"flag\":0,\"on\":false,\"maybe\":-7}]", "typed read: UUID and Enum as str, Decimal as float, dates in raw units")
    refused(ch_insert(c, typed, ch_encode([ChWide { ...rows[0], kind: "click" }])), "unknown Enum name", "column 'kind' (Enum8('it\\'s' = -2, 'view' = 1)): 'click' is not one of its values")
    refused(ch_insert(c, typed, ch_encode([ChWide { ...rows[0], uid: "not-a-uuid" }])), "malformed UUID", "is not a UUID")
    refused(ch_insert(c, typed, ch_encode([ChWide { ...rows[0], amount: 123456789.0 }])), "Decimal precision", "does not fit Decimal(10, 2)")
    refused(ch_insert(c, typed, ch_encode([ChWide { ...rows[0], code: "abcde" }])), "FixedString length", "column 'code' (FixedString(4)): 5 bytes do not fit")
    refused(ch_insert(c, typed, ch_encode([ChWide { ...rows[0], small: 128 }])), "Int8 range", "column 'small' (Int8): value 128 is out of range -128..127")
    successful(ch_query_params(c, "DROP TABLE \{t:Identifier}", {"t": typed}), "drop typed table")

    // ALTER расширил столбцы после кэша схемы: значения, верные для новых типов,
    // не отвергаются клиентом по старым (повторный DESCRIBE).
    let widened = "kh_widen_" + random_str(12)
    successful(ch_query_params(c, "CREATE TABLE \{t:Identifier} (id UInt8, e Enum8('a' = 1, 'b' = 2), code FixedString(2)) ENGINE=MergeTree ORDER BY tuple()", {"t": widened}), "create narrow table")
    successful(ch_insert(c, widened, ch_encode([Narrow { id: 1, e: "a", code: "xy" }])), "narrow insert")
    successful(ch_query_params(c, "ALTER TABLE \{t:Identifier} MODIFY COLUMN id UInt16, MODIFY COLUMN e Enum8('a' = 1, 'b' = 2, 'c' = 3), MODIFY COLUMN code FixedString(4)", {"t": widened}), "widen columns")
    let before_widen = __ch_schema_misses()
    successful(ch_insert(c, widened, ch_encode([Narrow { id: 300, e: "a", code: "xy" }])), "UInt16 value after ALTER")
    successful(ch_insert(c, widened, ch_encode([Narrow { id: 2, e: "c", code: "xy" }])), "new Enum value after ALTER")
    successful(ch_insert(c, widened, ch_encode([Narrow { id: 3, e: "b", code: "wxyz" }])), "longer FixedString after ALTER")
    need(__ch_schema_misses() == before_widen + 1, "widened schema asked once")
    refused(ch_insert(c, widened, ch_encode([Narrow { id: 70000, e: "a", code: "xy" }])), "UInt16 range with a fresh schema", "column 'id' (UInt16): value 70000 is out of range 0..65535")
    need(table_count(c, widened) == 4, "widened row count")
    successful(ch_query_params(c, "DROP TABLE \{t:Identifier}", {"t": widened}), "drop widened table")

    // Decimal128/256: целое без запятой шире int (Decimal(38, 18) у денег и
    // токенов) пишется словами, а не отвергается.
    let decimals = "kh_dec_" + random_str(12)
    successful(ch_query_params(c, "CREATE TABLE \{t:Identifier} (n Int64, a Decimal(38, 18), b Decimal(76, 30), p Decimal(18, 10)) ENGINE=Memory", {"t": decimals}), "create decimal table")
    successful(ch_insert(c, decimals, ch_encode([
        Dec { n: 1, a: 10.5, b: 1.5, p: 1.5 },
        Dec { n: 2, a: -1000.25, b: -0.000001, p: -9.25 },
        Dec { n: 3, a: 12345678901234567000.0, b: 123456789012345678901234567890.0, p: 0.0 }
    ])), "Decimal128 and Decimal256 insert")
    let dec_text = ch_query_params(c, "SELECT toString(a) AS a, toString(b) AS b, toString(p) AS p FROM \{t:Identifier} ORDER BY n", {"t": decimals})
    successful(dec_text, "decimal select as text")
    let dec_rows: [DecText]? = ch_decode(dec_text.body)
    need(to_json(dec_rows ?? []) == "[\{\"a\":\"10.5\",\"b\":\"1.5\",\"p\":\"1.5\"},\{\"a\":\"-1000.25\",\"b\":\"-0.000001\",\"p\":\"-9.25\"},\{\"a\":\"12345678901234567000\",\"b\":\"123456789012345680000000000000\",\"p\":\"0\"}]", "server sees exact wide decimals")
    let dec_back = ch_query_params(c, "SELECT n, a, b, p FROM \{t:Identifier} ORDER BY n", {"t": decimals})
    let dec_floats: [Dec]? = ch_decode(dec_back.body)
    // чтение во float — с точностью float (__ch_decimal_float): сравнение с допуском
    let back = dec_floats ?? []
    need(back.len() == 3 && back[0].a == 10.5 && back[0].b == 1.5 && back[1].p == -9.25 && (back[1].a + 1000.25).abs() < 0.000000001 && (back[2].b / 123456789012345678901234567890.0 - 1.0).abs() < 0.000000000000001, "wide decimals read back as float")
    refused(ch_insert(c, decimals, ch_encode([Dec { n: 4, a: 1.0e20, b: 0.0, p: 0.0 }])), "Decimal(38, 18) precision", "value 100000000000000000000 does not fit Decimal(38, 18)")
    successful(ch_query_params(c, "DROP TABLE \{t:Identifier}", {"t": decimals}), "drop decimal table")
    let strict = "kh_strict_" + random_str(12)
    successful(ch_query_params(c, "CREATE TABLE \{t:Identifier} (id Int64, name String) ENGINE=Memory", {"t": strict}), "create strict table")
    refused(ch_insert(c, strict, ch_encode([Optional { id: 1, name: "x" }])), "optional into non-Nullable", "column 'name' is String, not Nullable, but the Khrip field is optional (str?)")
    refused(ch_insert(c, strict, ch_encode([Optional { id: 1, name: "x" }]).byte_slice(0, 5)), "truncated batch", "")
    successful(ch_query_params(c, "DROP TABLE \{t:Identifier}", {"t": strict}), "drop strict table")

    var batch: [ChEvent] = []
    for i in 0..1000 {
        batch.push(ChEvent { id: i + 3, name: "bulk", active: true, score: 1.25, note: none, tags: ["batch"], numbers: [] })
    }
    successful(ch_insert(c, table, ch_encode(batch)), "1000-row batch")
    need(table_count(c, table) == 1002, "bulk count")
    need(!ch_insert(c, table + "; DROP TABLE anything", ch_encode(original)).ok, "identifier injection rejected")
    successful(ch_query_params(c, "DROP TABLE \{t:Identifier}", {"t": table}), "drop")
    // Async inserts acknowledge a completed flush, not just an in-memory queue.
    let async_table = "kh_async_" + random_str(12)
    successful(ch_query_params(c, "CREATE TABLE \{t:Identifier} (value Int64) ENGINE=MergeTree ORDER BY value", {"t": async_table}), "create async table")
    let async = ChConfig { ...c, async_insert: true }
    successful(ch_insert(async, async_table, ch_encode([11,12,13])), "async insert waits for flush")
    need(table_count(c, async_table) == 3, "async rows visible immediately after acknowledgement")
    successful(ch_query_params(c, "DROP TABLE \{t:Identifier}", {"t": async_table}), "drop async table")

    // С4: пользователь с readonly=1 выполняет SELECT. Менять настройки он не
    // может: max_execution_time не отправляется при server_timeout: false.
    // (GRANT и DROP USER не принимают параметр Identifier: имя — литерал)
    successful(ch_query(c, "DROP USER IF EXISTS kh_ro_client_test"), "drop old readonly user")
    successful(ch_query(c, "CREATE USER kh_ro_client_test IDENTIFIED WITH sha256_password BY 'kh-ro-client-test' SETTINGS readonly = 1"), "create readonly user")
    successful(ch_query(c, "GRANT SELECT ON system.one TO kh_ro_client_test"), "grant readonly user")
    let ro = ChConfig { ...c, user: "kh_ro_client_test", password: "kh-ro-client-test", server_timeout: false }
    let one = ch_query(ro, "SELECT 1 AS value")
    successful(one, "readonly SELECT 1")
    let ones: [int]? = ch_decode(one.body)
    need((ones ?? [0])[0] == 1, "readonly SELECT 1 value")
    successful(ch_query_params(ro, "SELECT \{n:Int64} AS value", {"n": "5"}), "readonly SELECT with parameters")
    let hinted = ch_query(ChConfig { ...ro, server_timeout: true }, "SELECT 1 AS value")
    refused(hinted, "readonly with server_timeout", "(ChConfig server_timeout: false sends no max_execution_time)")
    successful(ch_query(c, "DROP USER kh_ro_client_test"), "drop readonly user")
    print("ClickHouse integration: ok")
    return 0
}

type LongCheck { value: int, same: bool }

fn type_check_long(body: str) {
    let rows: [LongCheck]? = ch_decode(body)
    need(rows != none && (rows ?? [])[0].value == 32768 && (rows ?? [])[0].same, "64 KiB non-ASCII parameter value")
}
