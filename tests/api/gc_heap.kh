// Куча store (lib/gc.kh, шаг 3 docs/design/v0.13-store-gc.md): объекты всех
// видов и размеров — строки одним объектом, ячейки int?, структуры по маске
// ссылок (и с полями больше 63 — каждое слово ссылка), варианты, списки без
// ссылок и со ссылками, словари, объекты больше 32 КБ (свой спан). Проверка
// графа и кучи (__gc_verify_graph) подтверждает: каждая ссылка — на начало
// выделенного объекта, у каждого слова со ссылкой — бит PTRB, учёт байтов кучи
// сходится.

type Point { x: int, y: int }

type Item {
    name: str
    tags: [str]
    score: int?
    ratio: float?
    at: Point
    flags: [bool]
    ok: bool
}

type Shape = Circle { r: float } | Poly { pts: [Point], label: str } | Empty

type Nothing {}

type Wide {
    f0: str,
    f1: int,
    f2: str,
    f3: int,
    f4: str,
    f5: int,
    f6: str,
    f7: int,
    f8: str,
    f9: int,
    f10: str,
    f11: int,
    f12: str,
    f13: int,
    f14: str,
    f15: int,
    f16: str,
    f17: int,
    f18: str,
    f19: int,
    f20: str,
    f21: int,
    f22: str,
    f23: int,
    f24: str,
    f25: int,
    f26: str,
    f27: int,
    f28: str,
    f29: int,
    f30: str,
    f31: int,
    f32: str,
    f33: int,
    f34: str,
    f35: int,
    f36: str,
    f37: int,
    f38: str,
    f39: int,
    f40: str,
    f41: int,
    f42: str,
    f43: int,
    f44: str,
    f45: int,
    f46: str,
    f47: int,
    f48: str,
    f49: int,
    f50: str,
    f51: int,
    f52: str,
    f53: int,
    f54: str,
    f55: int,
    f56: str,
    f57: int,
    f58: str,
    f59: int,
    f60: str,
    f61: int,
    f62: str,
    f63: int,
    f64: str,
    f65: int,
    f66: str,
    f67: int,
    f68: str,
    f69: int
}

store items: map[str, Item]
store nums: [int]
store words: [str]
store shapes: [Shape]
store wides: [Wide]
store texts: [str]
store nothings: [Nothing]
store scores: map[int, int?]

test "objects of every kind and size live in the store heap" {
    for i in 0..300 {
        items["item-{i}"] = Item { name: "n".repeat(i % 40), tags: ["t{i}", "u"], score: i, ratio: none, at: Point { x: i, y: -i }, flags: [true, false], ok: true }
    }
    for i in 0..300 {
        if i % 3 == 0 {
            items.remove("item-{i}")
        }
    }
    for i in 0..10000 {
        nums.push(i)
    }
    for i in 0..6000 {
        words.push("w{i}")
    }
    shapes.push(Circle { r: 1.5 })
    shapes.push(Poly { pts: [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }], label: "p" + "q" })
    shapes.push(Empty)
    wides.push(Wide { f0: "w0" + "", f1: 1, f2: "w2" + "", f3: 3, f4: "w4" + "", f5: 5, f6: "w6" + "", f7: 7, f8: "w8" + "", f9: 9, f10: "w10" + "", f11: 11, f12: "w12" + "", f13: 13, f14: "w14" + "", f15: 15, f16: "w16" + "", f17: 17, f18: "w18" + "", f19: 19, f20: "w20" + "", f21: 21, f22: "w22" + "", f23: 23, f24: "w24" + "", f25: 25, f26: "w26" + "", f27: 27, f28: "w28" + "", f29: 29, f30: "w30" + "", f31: 31, f32: "w32" + "", f33: 33, f34: "w34" + "", f35: 35, f36: "w36" + "", f37: 37, f38: "w38" + "", f39: 39, f40: "w40" + "", f41: 41, f42: "w42" + "", f43: 43, f44: "w44" + "", f45: 45, f46: "w46" + "", f47: 47, f48: "w48" + "", f49: 49, f50: "w50" + "", f51: 51, f52: "w52" + "", f53: 53, f54: "w54" + "", f55: 55, f56: "w56" + "", f57: 57, f58: "w58" + "", f59: 59, f60: "w60" + "", f61: 61, f62: "w62" + "", f63: 63, f64: "w64" + "", f65: 65, f66: "w66" + "", f67: 67, f68: "w68" + "", f69: 69 })
    for n in [0, 1, 15, 16, 17, 255, 256, 1000, 5000, 40000] {
        texts.push("x".repeat(n))
    }
    nothings.push(Nothing {})
    nothings.push(Nothing {})
    for i in 0..100 {
        scores[i] = i * i
    }
    expect items.len() == 200
    expect nums[9999] == 9999
    expect words[5999] == "w5999"
    expect texts[9].len() == 40000
    expect wides[0].f68 == "w68"
    expect wides[0].f69 == 69
    expect scores[99] == 9801
    __gc_verify_graph("test")
}

test "a change of store under the shared lock is an error, not a race" {
    // так работает маршрут, который компилятор счёл читающим (src/rw.kh):
    // блокировка разделяемая, и изменение контейнера store — паника
    __store_unlock()
    store64(__ctx() + CTX_STORE_MODE, 1)
    __store_lock()
    nums.push(1)
    expect false
}

test "a pointer word without its pointer bit stops the program" {
    let it: int = __cast(items["item-1"])
    // поле tags (слово 1) ссылается на список store: снять его бит PTRB
    let b = (it + 8 - STORE_REGION) >> 3
    let a = GC_PTRB + (b >> 6) * 8
    store64(a, load64(a) & ~(1 << (b & 63)))
    __gc_verify_graph("test")
    expect false
}
