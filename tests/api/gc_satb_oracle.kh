// Оракул барьера SATB (docs/design/v0.13-store-gc.md §7.5): те же 10 тысяч
// случайных операций, что в gc_oracle.kh, и ещё операции над большим списком
// и большим словарём (их массивы больше 16 КБ — кадры: remove_at, insert,
// reverse, sort_by, xs[i] = v, pop, push, set, remove, перестройка) — а сборка
// всё это время идёт: в начале каждой сотни операций тест начинает её,
// публикуя себя (свою арену он передаёт сам), после каждой операции — шаг
// разметки, в конце сотни — конец разметки и уборка. JSON store до конца
// сборки и после совпадают, граф цел (__gc_verify_run: ни одной ссылки в
// освобождённую память), а с KHRIP_GC_VERIFY проверка конца разметки находит
// помеченным всё живое.

type Tag { name: str, weight: int? }

type Shape = Circle { r: float } | Box { w: int, h: int } | Point

type Rec {
    id: int
    name: str
    tags: [Tag]
    props: map[str, str]
    shape: Shape?
    score: int?
    nums: [int]
}

type Node { name: str, next: Node? }

var recs: map[int, Rec] = {}
var order: [Rec] = []
var rings: map[int, Node] = {}
var seed: int = 88172645463325252
var ops: int = 0
var checks: int = 0
var pool: [Tag] = []
var bigm: map[int, Tag] = {}

fn rnd() -> int {
    var x = seed
    x = x ^ (x << 13)
    x = x ^ ((x >> 7) & 0x1FFFFFFFFFFFFFF)
    x = x ^ (x << 17)
    seed = x
    return (x >> 8) & 0xFFFFFFFFFFFF
}

fn new_rec(id: int, r: int) -> Rec {
    var tags: [Tag] = []
    for i in 0..r % 4 {
        var w: int? = none
        if i % 2 == 0 {
            w = r % 1000 + i
        }
        tags.push(Tag { name: "tag {r % 97} {i}", weight: w })
    }
    var shape: Shape? = none
    if r % 4 == 1 {
        shape = Circle { r: (r % 100).to_float() / 4.0 }
    } else if r % 4 == 2 {
        shape = Box { w: r % 50, h: r % 30 }
    } else if r % 4 == 3 {
        shape = Point
    }
    var score: int? = none
    if r % 3 != 0 {
        score = r % 10000
    }
    return Rec { id: id, name: "rec {id}/{r % 1000}", tags: tags, props: { "a": "{r}" }, shape: shape, score: score, nums: [r % 7, r % 11] }
}

fn ring(n: int, r: int) -> Node {
    let first = Node { name: "ring {r} 0", next: none }
    var x = first
    for i in 1..n {
        let y = Node { name: "ring {r} {i}", next: none }
        x.next = y
        x = y
    }
    x.next = first
    return first
}

fn step() {
    let r = rnd()
    let k = r % 150
    let op = (r >> 20) % 34
    ops += 1
    if op >= 18 {
        big_step(op, r)
        return
    }
    if op <= 2 {
        recs[k] = new_rec(k, r)
        return
    }
    if op == 3 {
        recs.remove(k)
        return
    }
    if op == 9 {
        if order.len() > 0 {
            order.remove_at((r >> 30) % order.len())
        }
        return
    }
    if op == 14 {
        let at = (r >> 30) % 5
        if (r >> 40) % 3 == 0 {
            rings.remove(at)
        } else {
            rings[at] = ring(1 + (r >> 33) % 40, r % 1000)
        }
        return
    }
    if op == 16 {
        if order.len() > 20 {
            order.truncate(order.len() / 2)
        }
        return
    }
    if op == 17 {
        if (r >> 30) % 20 == 0 {
            order.clear()
        }
        return
    }
    let x = recs[k] else {
        return
    }
    if op == 4 {
        x.name = "renamed {ops}"
    } else if op == 5 {
        x.tags.push(Tag { name: "pushed {ops}", weight: ops })
    } else if op == 6 {
        if x.tags.len() > 0 {
            if r % 2 == 0 {
                x.tags.pop()
            } else {
                x.tags.remove_at((r >> 30) % x.tags.len())
            }
        }
    } else if op == 7 {
        x.props["p{r % 10}"] = "v{ops}"
    } else if op == 8 {
        x.props.remove("p{r % 10}")
    } else if op == 10 {
        order.push(x)
    } else if op == 11 {
        // общий объект: тег другой записи
        if let y = recs[(r >> 30) % 150] {
            if y.tags.len() > 0 {
                x.tags.push(y.tags[0])
            }
        }
    } else if op == 12 {
        if r % 4 == 0 {
            x.shape = none
        } else if r % 4 == 1 {
            x.shape = Box { w: ops % 77, h: 1 }
        } else {
            x.shape = Circle { r: 0.5 }
        }
    } else if op == 13 {
        if r % 2 == 0 {
            x.tags.sort_by(t => t.name)
        } else {
            x.tags.reverse()
        }
    } else {
        x.score = ops
        x.nums.push(ops)
        if x.nums.len() > 6 {
            x.nums.insert(0, -ops)
            x.nums.truncate(3)
        }
    }
}

// большой список и большой словарь: кадры разметки
fn big_step(op: int, r: int) {
    let n = pool.len()
    if op == 18 {
        if n > 2200 {
            pool.remove_at((r >> 30) % n)
        }
    } else if op == 19 {
        pool.insert((r >> 30) % (n + 1), Tag { name: "ins {ops}", weight: ops })
    } else if op == 20 {
        if (r >> 30) % 9 == 0 {
            pool.reverse()
        } else if (r >> 30) % 9 == 1 {
            pool.sort_by(t => t.name)
        }
    } else if op == 21 {
        if n > 0 {
            pool[(r >> 30) % n] = Tag { name: "set {ops}", weight: none }
        }
    } else if op == 22 {
        if n > 2200 && r % 2 == 0 {
            pool.pop()
        } else {
            pool.push(Tag { name: "push {ops}", weight: r % 100 })
        }
    } else if op == 23 || op == 24 {
        bigm[(r >> 30) % 4000] = Tag { name: "m {ops}", weight: ops }
    } else if op == 25 {
        bigm.remove((r >> 30) % 4000)
    } else {
        move_step(op, r)
    }
}

// Перенос: значение уходит с одного места (барьер серит его) и ложится в
// другое — возможно, уже размеченное. Без барьера оно осталось бы
// непомеченным, хотя достижимо.
fn move_step(op: int, r: int) {
    let a = (r >> 30) % 150
    let b = (r >> 38) % 150
    let n = pool.len()
    if op == 26 {
        // запись — из словаря в список (remove) или под другой ключ
        if let x = recs[a] {
            recs.remove(a)
            if r % 2 == 0 {
                order.push(x)
            } else {
                recs[b] = x
            }
        }
    } else if op == 27 {
        // тег — из записи в запись (pop / remove_at)
        if let x = recs[a] {
            if let y = recs[b] {
                if x.tags.len() > 0 {
                    if r % 2 == 0 {
                        y.tags.push(x.tags.pop())
                    } else {
                        y.tags.insert(0, x.tags.remove_at((r >> 12) % x.tags.len()))
                    }
                }
            }
        }
    } else if op == 28 {
        // элемент большого списка — на другое место (remove_at, xs[i] = v)
        if n > 2 {
            let t = pool.remove_at((r >> 12) % n)
            if r % 2 == 0 {
                pool.insert((r >> 22) % (n - 1), t)
            } else {
                let j = (r >> 22) % (n - 1)
                let old = pool[j]
                pool[j] = t
                pool.push(old)
            }
        }
    } else if op == 29 {
        // поле — в поле другой записи (x.f = v)
        if let x = recs[a] {
            if let y = recs[b] {
                let s = x.shape
                x.shape = none
                y.shape = s
                if x.tags.len() > 0 {
                    let t = x.tags[0]
                    x.tags[0] = Tag { name: "swap {ops}", weight: none }
                    y.tags.push(t)
                }
            }
        }
    } else if op == 30 {
        // значение словаря — в список записи или под другой ключ (перезапись)
        if let t = bigm[a] {
            bigm[a] = Tag { name: "over {ops}", weight: ops }
            if let y = recs[b] {
                y.tags.push(t)
            } else {
                bigm[4000 + b] = t
            }
        }
    } else if op == 31 {
        // хвост списка — в другой список (truncate)
        if let x = recs[a] {
            if let y = recs[b] {
                if x.tags.len() > 1 {
                    let t = x.tags[x.tags.len() - 1]
                    x.tags.truncate(1)
                    y.tags.push(t)
                }
            }
        }
    } else if op == 32 {
        // ключ и значение — из очищенного словаря свойств в другой
        if let x = recs[a] {
            if let y = recs[b] {
                for k, v in x.props {
                    y.props[k] = v
                }
                let keep = x.props.keys()
                if (r >> 12) % 4 == 0 {
                    // ключи — из очищенного словаря в другой
                    x.props.clear()
                    for k in keep {
                        y.props[k] = "kept {ops}"
                    }
                } else if keep.len() > 0 {
                    // ключ и значение — из словаря (remove) в другой
                    let k = keep[(r >> 14) % keep.len()]
                    let v = x.props[k] ?? ""
                    x.props.remove(k)
                    y.props[k] = v
                }
            }
        }
    } else {
        // запись — в order и обратно в recs (pop)
        if order.len() > 0 {
            let x = order.pop()
            recs[a] = x
        }
    }
}

// кольца: от начала до начала, имена подряд
fn walk_rings() -> str {
    var out = ""
    for i in 0..5 {
        if let start = rings[i] {
            out += "[{i}]"
            var at = start
            var n = 0
            while n < 100 {
                out += at.name + ";"
                let nx = at.next else {
                    out += "broken"
                    break
                }
                let a: int = __cast(nx)
                let b: int = __cast(start)
                if a == b {
                    break
                }
                at = nx
                n += 1
            }
        }
    }
    return out
}

fn snapshot() -> str {
    return to_json(recs) + "|" + to_json(order) + "|" + walk_rings() + "|" + to_json(pool) + "|" + to_json(bigm)
}

fn run(n: int) -> bool {
    var ok = true
    for i in 0..n {
        if ops % 100 == 0 {
            __gc_begin()
        }
        step()
        __gc_step(40)
        if ops % 100 == 0 {
            let before = snapshot()
            __gc_finish()
            __gc_verify_run("oracle", false)
            let after = snapshot()
            checks += 1
            if after != before {
                ok = false
            }
        }
    }
    return ok
}

test "build the big list and map" {
    for i in 0..2500 {
        pool.push(Tag { name: "pool {i}", weight: i })
        bigm[i] = Tag { name: "bigm {i}", weight: none }
    }
    __gc_collect()
}

test "operations 1-1000" {
    expect run(1000)
}

test "operations 1001-2000" {
    expect run(1000)
}

test "operations 2001-3000" {
    expect run(1000)
}

test "operations 3001-4000" {
    expect run(1000)
}

test "operations 4001-5000" {
    expect run(1000)
}

test "operations 5001-6000" {
    expect run(1000)
}

test "operations 6001-7000" {
    expect run(1000)
}

test "operations 7001-8000" {
    expect run(1000)
}

test "operations 8001-9000" {
    expect run(1000)
}

test "operations 9001-10000" {
    expect run(1000)
    expect checks == 100
    expect recs.len() > 50 && pool.len() > 2200 && bigm.len() > 1500
}
