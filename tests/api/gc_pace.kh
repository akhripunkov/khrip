// Темп сборок (docs/design/v0.13-store-gc.md §8.2, §8.3): цель — живое · 1,5
// (KHRIP_GC = 50 по умолчанию, множитель запаса m всегда 1: и когда почти всё
// живо, и когда выжило меньше половины); мягкий предел (KHRIP_GC_LIMIT_MB, здесь —
// __gc_set_limit_mb) держит цель не выше себя, но не ниже 1,1 · живого;
// пишущий запрос, который выделяет, пока идёт разметка, а куча выше 1,5 · цели,
// при последнем отпускании (под своей исключительной блокировкой) помогает
// разметке куском, а если разметка кончилась — делает и её конец; между целью
// и 1,5 · цели — по счёту выделенного; читающий запрос и окно не помогают.
// Цель здесь — цель сборки: цель или куча в начале сборки, если та выше.
// tests/run.sh запускает файл ещё и с KHRIP_GC_LIMIT_MB=3 (первый тест
// сверяет цель с ним) и проверяет, что с запасом 100 % по умолчанию, без
// мягкого предела, без помощи писателя и без помощи по счёту тесты падают. С
// KHRIP_GC_STRESS цель — от помеченного и шага, и цифры цели не проверяются.

type Item { name: str, n: int }

store items: [Item]
store blob: str = ""
store small: [Item]

const MB = 1048576

fn exact() -> bool {
    return (env("KHRIP_GC_STRESS") ?? "") != "1"
}

// цель по живому: max(4 МБ, живое · 1,5) (KHRIP_GC = 50)
fn goal_for(live: int) -> int {
    let g = live + live / 2
    if g < 4 * MB {
        return 4 * MB
    }
    return g
}

// пишущий запрос: строка n байт в store
route POST "/blob/{n}" (n: int) -> 204 {
    blob = "b".repeat(n)
    return 204
}

// то же, но с окном (sleep) после выделения
route POST "/blob-wait/{n}" (n: int) -> 204 {
    blob = "w".repeat(n)
    sleep(1)
    return 204
}

route GET "/count" -> int {
    return items.len()
}

test "KHRIP_GC_LIMIT_MB caps the goal from the start" {
    let mb = (env("KHRIP_GC_LIMIT_MB") ?? "").to_int() ?? 0
    let s = __gc_stats()
    expect !exact() || mb == 0 || s.goal == mb * MB
    expect !exact() || mb > 0 || s.goal == 4 * MB
    __gc_set_limit_mb(0)
}

// между сборками — немного нового живого
fn collect_after_push(k: int) {
    small.push(Item { name: "kept {k}", n: k })
    __gc_collect()
}

// раньше цель росла как живое · (1 + m), и m удваивался до 8 сборками, где
// выживало больше 0,85 кучи (смена фазы — рост, затем замены — копила мусор до
// 9 × живого)
test "the goal stays 1.5 x live while nearly everything survives" {
    for i in 0..60000 {
        items.push(Item { name: "item {i} xxxxxxxxxxxxxxxx", n: i })
    }
    collect_after_push(1)
    collect_after_push(2)
    collect_after_push(3)
    collect_after_push(4)
    let s = __gc_stats()
    // выше наименьшей цели (4 МБ): запас виден
    expect s.live > 3 * MB
    expect !exact() || s.goal == goal_for(s.live)
    collect_after_push(5)
    expect !exact() || __gc_stats().goal == goal_for(__gc_stats().live)
}

test "the goal stays 1.5 x live when less than half survives" {
    items = []
    __gc_collect()
    let s = __gc_stats()
    expect !exact() || s.goal == goal_for(s.live)
}

// сборка целиком сразу после доделки идущей (__gc_collect посреди разметки)
// начинается с только что убранной кучи — цель та же
test "a whole collection right after a finished cycle keeps the goal" {
    for i in 0..20000 {
        items.push(Item { name: "item {i} xxxxxxxxxxxxxxxx", n: i })
    }
    __gc_collect()
    for round in 0..4 {
        // 70% кучи — мусор
        for i in 0..14000 {
            items[i] = Item { name: "repl {i} {round} yyyyyyyyyyyy", n: i }
        }
        __gc_begin_from_roots()
        __gc_collect()
    }
    let s = __gc_stats()
    expect !exact() || s.goal == goal_for(s.live)
}

test "the soft limit caps the goal, but not below 1.1 x live" {
    for i in 0..60000 {
        items.push(Item { name: "item {i} yyyyyyyyyyyyyyyy", n: i })
    }
    __gc_collect()
    let live = __gc_stats().live
    expect live > 2 * MB
    __gc_set_limit_mb(2)
    expect !exact() || __gc_stats().goal == live + live / 10
    __gc_set_limit_mb(8)
    expect !exact() || __gc_stats().goal == 8 * MB
    __gc_collect()
    expect !exact() || __gc_stats().goal == 8 * MB
    __gc_set_limit_mb(0)
    expect !exact() || __gc_stats().goal == goal_for(__gc_stats().live)
}

test "a writer's final release assists marking above 1.5 x goal" {
    __gc_set_limit_mb(1)
    let a0 = __gc_stats().assists
    __gc_begin_from_roots()
    // 8 МБ в store посреди разметки: куча выше 1,5 · цели (тест store не
    // держит, запрос берёт его сам — исключительно)
    expect (call POST "/blob/8000000").status == 204
    expect __gc_stats().assists > a0
    __gc_set_limit_mb(0)
}

test "a reader does not assist, a window does not assist" {
    // мусор до начала сборки (порог высокий: точка сборки после call не
    // собирает), затем, уже посреди разметки, цель ниже 2/3 кучи; тест store
    // не держит
    __gc_set_limit_mb(64)
    __gc_collect()
    expect (call POST "/blob/20000000").status == 204
    let a0 = __gc_stats().assists
    __gc_begin_from_roots()
    __gc_set_limit_mb(1)
    expect (call GET "/count").body == "80000"
    expect !exact() || __gc_stats().assists == a0
    __gc_begin_from_roots()
    expect (call POST "/blob-wait/30000000").status == 204
    let n = __gc_stats().assists - a0
    expect n == 1 || (!exact() && n <= 1)
    __gc_set_limit_mb(0)
}

test "an assist that finishes marking also ends it" {
    items = []
    blob = ""
    for i in 0..50 {
        small.push(Item { name: "small {i}", n: i })
    }
    __gc_set_limit_mb(1)
    __gc_collect()
    let e0 = __gc_stats().assist_ends
    __gc_begin_from_roots()
    expect (call POST "/blob/4000000").status == 204
    expect !exact() || __gc_stats().assist_ends == e0 + 1
    __gc_set_limit_mb(0)
}

test "between the goal and 1.5 x goal a writer pays for what it allocated" {
    for i in 0..20000 {
        items.push(Item { name: "item {i} zzzzzzzzzzzzzzzz", n: i })
    }
    blob = ""
    __gc_collect()
    let s = __gc_stats()
    let a0 = s.assists
    __gc_begin_from_roots()
    // куча — между целью и 1,5 · цели
    let n = s.goal + s.goal / 4 - s.heap
    expect n > 0
    expect (call POST "/blob/{n}").status == 204
    let t = __gc_stats()
    expect t.heap > s.goal && t.heap < s.goal + s.goal / 2
    expect t.assists > a0
}
