// Эталонный сервер на Khrip: те же /plaintext и /json, что у Go и C#.
// JSON собирается на каждый запрос, как и у них. Сборка: build/khc -o server server.kh

type Message {
    message: str
}

route GET "/plaintext" -> str {
    return "Hello, World!"
}

route GET "/json" -> Message {
    return Message { message: "Hello, World!" }
}
