fn main() {
    let q = args()[1]
    let reps = 20000
    let words = ["apple", "steel", "green", "pro", "mini", "ultra", "classic", "smart", "eco", "max"]
    var xs: [str] = []
    for i in 0..2000 {
        xs.push("{words[i % 10]} {words[(i * 7) % 10]} {i}".upper()[0..1] + "{words[i % 10]} {words[(i * 7) % 10]} {i}"[1..])
    }
    let ql = q.lower()
    var t = 0
    for r in 0..reps {
        let s = xs[r % 2000]
        if s.lower().contains(ql) {
            t += 1
        }
    }
    print(t)
}
