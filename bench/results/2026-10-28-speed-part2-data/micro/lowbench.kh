fn main() {
    let n = (args()[1]).to_int() ?? 8
    let reps = 20000
    var base = ""
    for i in 0..n {
        base += ["A", "b", "C", "d", " ", "1"][i % 6]
    }
    // разные строки, чтобы не было кэша
    var xs: [str] = []
    for i in 0..64 {
        xs.push(base[0..n - 1] + ["x", "Y"][i % 2])
    }
    var t = 0
    for r in 0..reps {
        let s = xs[r % 64]
        let l = s.lower()
        t += l.byte_len()
    }
    print(t)
}
