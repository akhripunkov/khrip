store mm: map[int, map[int, str]]
store junk: [str]

route POST "/setup/{n}/{k}" (n: int, k: int) -> int {
    for i in 0..n {
        var e: map[int, str] = {}
        mm[i] = e
    }
    for j in 0..k {
        for i in 0..n {
            let im = mm[i] else {
                return -1
            }
            im[j] = "v{j}"
        }
    }
    return mm.len()
}

// one more key into every inner map
route POST "/step/{n}/{k}" (n: int, k: int) -> int {
    for i in 0..n {
        let im = mm[i] else {
            return -1
        }
        im[k] = "v{k}"
    }
    return n
}

route POST "/garbage/{n}" (n: int) -> int {
    for j in 0..n {
        junk.push("garbage string number {j} with some padding to make it longer")
        if j % 1000 == 999 {
            junk = []
        }
    }
    return n
}
