// Вычислительные задачи: те же, что в go/main.go и csharp/Program.cs.
// Запуск: compute fib | compute sieve

fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// Количество простых чисел не больше n.
fn sieve(n: int) -> int {
    var composite = [false] * (n + 1)
    var count = 0
    for i in 2..n + 1 {
        if composite[i] {
            continue
        }
        count += 1
        var j = i * i
        while j <= n {
            composite[j] = true
            j += i
        }
    }
    return count
}

fn main() -> int {
    let a = args()
    if a.len() == 2 && a[1] == "fib" {
        print(fib(38))
    } else if a.len() == 2 && a[1] == "sieve" {
        print(sieve(20000000))
    } else {
        eprint("usage: compute fib|sieve")
        return 2
    }
    return 0
}
