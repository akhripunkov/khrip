// Заглушки для сборки загрузчиком (boot). Настоящий компилятор делает всё это
// встроенными средствами; здесь — простые функции с тем же смыслом.

var __boot_ctx: int

// Контекст потока (в khc — fs:[0]).
fn __ctx() -> int {
    if __boot_ctx == 0 {
        __boot_ctx = syscall(9, 0, 256, 3, 0x22, -1, 0)
    }
    return __boot_ctx
}

// Смена типа без изменения значения (в khc — встроенная).
fn __cast(x: int) -> int {
    return x
}

// В программах, собранных загрузчиком, паника всегда завершает процесс.
fn __panic_recover() {
}

// Потоков и store у загрузчика нет.
fn __store_lock() {
}

// Куча store (lib/gc.kh): ядро ссылается на неё, но без store в неё не попадает.
fn __salloc(n: int, kind: int, mask: int) -> int {
    exit(101)
    return 0
}

fn __salloc_for(h: int, n: int, kind: int, mask: int) -> int {
    exit(101)
    return 0
}

fn __store_mut(h: int) {
}

// Барьер SATB (lib/gc.kh): разметки у загрузчика нет.
fn __gc_shade(w: int) {
}

fn __gc_old_array(h: int) {
}

fn __gc_old_slots(m: int) {
}

fn __gc_old_at(m: int, a: int) {
}

fn __gc_vacate(h: int, from: int) {
}

fn __gc_remove_at(h: int, v: int, i: int, n: int) {
}

fn __gc_permute(h: int) {
}

fn __gc_map_removed(m: int, idx: int, v: int) {
}

fn __gc_map_cleared(m: int, n: int) {
}

fn __store_panic() {
}

fn __store_for(h: int) -> bool {
    return false
}

// Точка входа: загрузчик вызывает её после инициализации глобальных переменных.
fn __start(argc: int, argv: int) -> int {
    __argc = argc
    __argv = argv
    return main()
}
