fn __store_panic() {
}

// Рост словаря по частям (lib/core.kh): словарей store у загрузчика нет.
fn __gc_lazy_alloc(n: int, kind: int) -> int {
    exit(101)
    return 0
}

fn __gc_lazy_extend(p: int, n: int, kind: int) -> int {
    return 0
}

fn __gc_abandon(bytes: int) {
