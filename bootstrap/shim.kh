// Заглушки для сборки загрузчиком (boot). Настоящий компилятор делает всё это
// встроенными средствами; здесь — простые функции с тем же смыслом.

var __boot_ctx: int

// Контекст потока (в khc — fs:[0]).
fn __ctx() -> int {
    if __boot_ctx == 0 {
        __boot_ctx = syscall(9, 0, 256, 3, 0x22, -1, 0)
    }
    return __boot_ctx
}

// 32-битные чтение и запись (в khc — встроенные; словари lib/core.kh).
fn load32(p: int) -> int {
    return load8(p) | (load8(p + 1) << 8) | (load8(p + 2) << 16) | (load8(p + 3) << 24)
}

fn store32(p: int, v: int) {
    store8(p, v & 255)
    store8(p + 1, (v >> 8) & 255)
    store8(p + 2, (v >> 16) & 255)
    store8(p + 3, (v >> 24) & 255)
}

// Адрес байтов и длина строки (в khc — встроенные; два вида строк, lib/core.kh).
fn __str_ptrw(s: int) -> int {
    return load64(s) & 0xFFFFFFFFFFFF
}

fn __str_lenw(s: int) -> int {
    let n = (load64(s) >> 48) & 0xFFFF
    if n != 0 {
        return n
    }
    return load64(s + 8)
}

// Смена типа без изменения значения (в khc — встроенная).
fn __cast(x: int) -> int {
    return x
}

// В программах, собранных загрузчиком, паника всегда завершает процесс.
fn __panic_recover() {
}

// Потоков и store у загрузчика нет.
fn __store_lock() {
}

// Куча store (lib/gc.kh): ядро ссылается на неё, но без store в неё не попадает.
fn __salloc(n: int, kind: int, mask: int) -> int {
    exit(101)
    return 0
}

// Выделения из store нет: размер — как у __alloc.
fn __salloc_size(n: int) -> int {
    return (n + 15) & ~15
}

// Списков в store нет.
fn __salloc_list(h: int, cap: int, es: int) -> int {
    return __salloc(cap * es, 0, 0)
}

fn __salloc_list_inplace(h: int, cap: int, es: int) -> bool {
    return false
}

fn __store_room(p: int) -> int {
    return 0
}

// Кучи store нет: ни один адрес не в ней.
fn __in_store(p: int) -> bool {
    return false
}

fn __store_on() -> bool {
    return false
}

fn __salloc_for(h: int, n: int, kind: int, mask: int) -> int {
    exit(101)
    return 0
}

fn __store_mut(h: int) {
}

// Барьер SATB (lib/gc.kh): разметки у загрузчика нет.
fn __gc_insert_full(h: int, len: int) {
}

fn __gc_shade(w: int) {
}

fn __gc_old_array(h: int) {
