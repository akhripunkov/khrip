// ClickHouse HTTP(S) client and RowBinary codec. No external libraries.
// SQL values use ClickHouse {name:Type} parameters, never string substitution.
// Results are materialized with an explicit byte limit. Batch INSERT writes the
// encoded body directly, without concatenating it with SQL or HTTP headers.

type ChConfig {
    url: str
    database: str = "default"
    user: str = "default"
    password: str = ""
    timeout_ms: int = 10000
    max_request_bytes: int = 16777216
    max_response_bytes: int = 16777216
    // Admission threshold against all active ClickHouse operations on this
    // worker. Use the same limit across configs for one fixed per-worker cap.
    max_inflight: int = 32
    // Server-side batching is opt-in. Always wait for the flush acknowledgement.
    async_insert: bool = false
    // Сервер прекращает запрос, когда клиент уже перестал ждать: каждый запрос
    // несёт max_execution_time — остаток timeout_ms на момент отправки.
    // Пользователь с readonly=1 (или профиль, где max_execution_time
    // ограничен) менять эту настройку не может: для него — false.
    server_timeout: bool = true
}

type ChResult {
    ok: bool = false
    status: int = 0
    body: str = ""
    error: str = ""
    query_id: str = ""
    // The server may have applied a write whose response was lost. Never retry
    // solely because ok is false; use idempotency/deduplication at application level.
    unknown_outcome: bool = false
}

fn __ch_urlencode(s: str) -> str {
    let b = buf_new(s.byte_len() + 16)
    let hex = "0123456789ABCDEF"
    for i in 0..s.byte_len() {
        let c = s.byte(i)
        if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~' {
            buf_byte(b, c)
        } else {
            buf_byte(b, '%')
            buf_byte(b, hex.byte(c >> 4))
            buf_byte(b, hex.byte(c & 15))
        }
    }
    return buf_str(b)
}

// Значение параметра NULL для ch_query_params (тип параметра — Nullable(T)).
// Первый байт 0xFF в UTF-8 не встречается: с текстом значение не совпадёт.
fn ch_null() -> str {
    let b = buf_new(16)
    buf_byte(b, 255)
    buf_add(b, "khrip:NULL")
    return buf_str(b)
}

fn __ch_is_null(s: str) -> bool {
    return s.byte_len() == 11 && s.byte(0) == 255 && s.byte_slice(1, 11) == "khrip:NULL"
}

// Значения параметров ClickHouse разбирает в формате escaped (как TabSeparated):
// \N — NULL, обратная косая черта и управляющие символы экранируются.
fn __ch_param(s: str) -> str {
    if __ch_is_null(s) {
        return "\\N"
    }
    let b = buf_new(s.byte_len() + 16)
    for i in 0..s.byte_len() {
        let c = s.byte(i)
        if c == '\\' {
            buf_add(b, "\\\\")
        } else if c == '\n' {
            buf_add(b, "\\n")
        } else if c == '\r' {
            buf_add(b, "\\r")
        } else if c == '\t' {
            buf_add(b, "\\t")
        } else if c == 0 {
            buf_add(b, "\\0")
        } else {
            buf_byte(b, c)
        }
    }
    return buf_str(b)
}

fn __ch_identifier(s: str) -> bool {
    if s.byte_len() == 0 || s.byte_len() > 256 {
        return false
    }
    for i in 0..s.byte_len() {
        let c = s.byte(i)
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (i > 0 && c >= '0' && c <= '9')) {
            return false
        }
    }
    return true
}

fn __ch_config_error(c: ChConfig) -> str {
    if c.timeout_ms <= 0 || c.timeout_ms > 3600000 {
        return "ClickHouse timeout_ms must be between 1 and 3600000"
    }
    if c.max_inflight < 1 || c.max_inflight > 128 {
        return "ClickHouse max_inflight must be between 1 and 128"
    }
    if c.max_request_bytes <= 0 || c.max_request_bytes > 134217728 || c.max_response_bytes <= 0 || c.max_response_bytes > 134217728 {
        return "ClickHouse byte limits must be between 1 and 134217728"
    }
    if c.url.byte_len() > 4096 || c.database.byte_len() > 256 || c.user.byte_len() > 1024 || c.password.byte_len() > 4096 {
        return "ClickHouse configuration exceeds size limits"
    }
    for i in 0..c.url.byte_len() {
        let ch = c.url.byte(i)
        if ch <= 32 || ch >= 127 || ch == '@' || ch == '?' || ch == '#' || ch == '\\' {
            return "ClickHouse URL must be HTTP(S) without credentials, query parameters or fragments"
        }
    }
    if __parse_url(c.url) == none {
        return "invalid ClickHouse HTTP(S) URL"
    }
    return ""
}

// Поле multipart/form-data.
fn __ch_part(b: Buf, boundary: str, name: str, value: str) {
    buf_add(b, "--" + boundary + "\r\nContent-Disposition: form-data; name=\"" + name + "\"\r\n\r\n")
    buf_add(b, value)
    buf_add(b, "\r\n")
}

// Граница multipart, которой нет ни в запросе, ни в значениях.
fn __ch_boundary(query: str, values: [str]) -> str {
    for attempt in 0..8 {
        let boundary = "khrip-" + random_str(32)
        var clash = query.byte_find(boundary) != none
        for v in values {
            if !clash && v.byte_find(boundary) != none {
                clash = true
            }
        }
        if !clash {
            return boundary
        }
    }
    return ""
}

// Запрос к ClickHouse до срока until (0 — timeout_ms от начала). Всё, что
// читает c, query, payload и params (они могут лежать в store), — до окна без
// блокировки store: срок, пределы, адрес, байты запроса. В окне — только обмен
// __dh_exchange по свежим строкам арены.
// Настройки — только нужные операции: insert добавляет input_format_*, и
// пользователь с readonly=1 выполняет SELECT (server_timeout: false).
fn __ch_run(c: ChConfig, query: str, payload: str, params: map[str, str], insert: bool, cancel: bool, until: int) -> ChResult {
    let conferr = __ch_config_error(c)
    if conferr.byte_len() > 0 {
        return ChResult { error: conferr }
    }
    var deadline = now_ms() + c.timeout_ms
    if until > 0 {
        deadline = until
    }
    let max = c.max_response_bytes
    let inflight = c.max_inflight
    let budget = c.server_timeout
    if query.byte_len() > c.max_request_bytes || payload.byte_len() > c.max_request_bytes - query.byte_len() {
        return ChResult { error: "ClickHouse request exceeds max_request_bytes" }
    }
    if params.len() > 128 {
        return ChResult { error: "too many ClickHouse parameters" }
    }
    let u = __parse_url(c.url) else {
        return ChResult { error: "invalid ClickHouse URL" }
    }
    let id = "khrip-" + random_str(24)
    var target = u.target + "?database=" + __ch_urlencode(c.database) + "&query_id=" + id
    // параметры обработчика HTTP, а не настройки: их принимает и readonly=1
    target += "&default_format=RowBinaryWithNamesAndTypes&wait_end_of_query=1&buffer_size=" + max.to_str()
    // Настройки, от которых зависит разбор ответа, — со значениями по умолчанию:
    // readonly=1 разрешает задать настройку, равную текущей. Серверного
    // max_result_bytes нет: сервер считает байты блоков в памяти, а не ответа;
    // предел ответа max_response_bytes проверяет клиент (__dh_take).
    target += "&send_progress_in_http_headers=0&enable_http_compression=0&output_format_binary_encode_types_in_binary_format=0"
    if insert {
        target += "&input_format_with_names_use_header=1&input_format_with_types_use_header=1&input_format_skip_unknown_fields=0"
    }
    if c.async_insert && !cancel {
        target += "&async_insert=1&wait_for_async_insert=1"
    }
    var sql = query
    var body = payload
    var ctype = "application/octet-stream"
    if params.len() > 0 {
        // Параметры — поля multipart/form-data, а не адрес: значение идёт
        // байтами как есть. В адресе байт не-ASCII занимал бы три, а ClickHouse
        // ограничивает поле 128 КиБ (http_max_field_value_size).
        if query.byte_len() > 131072 || payload.byte_len() > 0 {
            return ChResult { error: "ClickHouse query with parameters exceeds 131072 bytes" }
        }
        var values: [str] = []
        for k, v in params {
            if !__ch_identifier(k) || v.byte_len() > 65536 {
                return ChResult { error: "invalid ClickHouse parameter name or value over 65536 bytes: " + k }
            }
            values.push(__ch_param(v))
        }
        let boundary = __ch_boundary(query, values)
        if boundary == "" {
            return ChResult { error: "cannot choose a multipart boundary for ClickHouse parameters" }
        }
        let b = buf_new(query.byte_len() + 512)
        __ch_part(b, boundary, "query", query)
        var i = 0
        for k, v in params {
            __ch_part(b, boundary, "param_" + k, values[i])
            i += 1
        }
        buf_add(b, "--" + boundary + "--\r\n")
        sql = ""
        body = __str_new(b.data, b.len)
        ctype = "multipart/form-data; boundary=" + boundary
    }
    let auth = __b64_encode(c.user + ":" + c.password)
    var head = "POST " + target
    if budget {
        head += "&max_execution_time="
    }
    let rest = " HTTP/1.1\r\nHost: {u.host}:{u.port}\r\nAuthorization: Basic {auth}\r\nContent-Type: {ctype}\r\nAccept-Encoding: identity\r\nContent-Length: {sql.byte_len() + body.byte_len()}\r\n\r\n"
    let ctx = __ctx()
    let held = load64(ctx + CTX_STORE_HELD) != 0
    if held {
        __store_unlock()
    }
    let r = __dh_exchange(u, head, rest, budget, sql, body, deadline, max, inflight)
    if held {
        __store_lock()
    }
    if r.status == 0 {
        return ChResult { error: r.body, query_id: id, unknown_outcome: (r.headers["x-khrip-unknown-outcome"] ?? "") == "1" }
    }
    let code = r.headers["x-clickhouse-exception-code"] ?? "0"
    if r.status < 200 || r.status >= 300 || code != "0" {
        var error = r.body
        if budget && (code == "164" || code == "452") && error.byte_find("max_execution_time") != none {
            error = error.ascii_trim() + " (ChConfig server_timeout: false sends no max_execution_time)"
        }
        return ChResult { status: r.status, error, query_id: id }
    }
    if r.headers.has("x-khrip-eof-framing") {
        // длины нет, конец — закрытие соединения: обрыв выглядел бы как конец
        return ChResult { status: r.status, body: r.body, error: "ClickHouse response is framed only by connection close; the body may be truncated", query_id: id, unknown_outcome: true }
    }
    return ChResult { ok: true, status: r.status, body: r.body, query_id: id }
}

// SELECT without FORMAT defaults to RowBinaryWithNamesAndTypes, for ch_decode.
// DDL and other SQL are supported as well. No automatic retries: after a network
// failure the caller must treat a write's outcome as unknown.
// Запрос — литерал или const (компилятор: src/drivers.kh): значения — только
// параметрами {name:Type} через ch_query_params.
fn ch_query(c: ChConfig, query: str) -> ChResult {
    return __ch_run(c, query, "", {}, false, false, 0)
}

fn ch_query_params(c: ChConfig, query: str, params: map[str, str]) -> ChResult {
    return __ch_run(c, query, "", params, false, false, 0)
}

fn __ch_error_set(message: str) {
    if load64(__ctx() + CTX_WORKER) != 0 {
        let worker = __w()
        worker.json_err = message
    } else {
        __json_last_err = message
    }
}

fn ch_error() -> str {
    return json_error()
}

fn __ch_varint(b: Buf, value: int) {
    var n = value
    while n >= 128 {
        buf_byte(b, (n & 127) | 128)
        n = n >> 7
    }
    buf_byte(b, n)
}

fn __ch_type(d: int, depth: int) -> str {
    if depth > 32 {
        return ""
    }
    let kind = load64(d)
    if kind == D_INT { return "Int64" }
    if kind == D_FLOAT { return "Float64" }
    if kind == D_BOOL { return "Bool" }
    if kind == D_STR { return "String" }
    if kind == D_OPT || kind == D_LIST {
        let inner = __ch_type(load64(d + 8), depth + 1)
        if inner.byte_len() == 0 { return "" }
        if kind == D_OPT && (load64(load64(d + 8)) == D_LIST || load64(load64(d + 8)) == D_OPT) {
            return ""
        }
        if kind == D_OPT { return "Nullable(" + inner + ")" }
        return "Array(" + inner + ")"
    }
    return ""
}

fn __ch_string(b: Buf, value: str) {
    __ch_varint(b, value.byte_len())
    buf_add(b, value)
}

fn __ch_write(b: Buf, v0: int, d: int, depth: int) -> bool {
    if depth > 32 || b.len > 134217728 {
        __ch_error_set("RowBinary nesting or byte limit exceeded")
        return false
    }
    let kind = load64(d)
    var v = v0
    if kind == D_OPT {
        if v == 0 {
            buf_byte(b, 1)
            return true
        }
        buf_byte(b, 0)
        let inner = load64(d + 8)
        if __is_scalar(inner) {
            v = load64(v)
        }
        return __ch_write(b, v, inner, depth + 1)
    }
    if kind == D_INT || kind == D_FLOAT {
        buf_reserve(b, 8)
        store64(b.data + b.len, v)
        b.len += 8
        return true
    }
    if kind == D_BOOL {
        buf_byte(b, v)
        return true
    }
    if kind == D_STR {
        let s: str = __cast(v)
        if s.byte_len() > 134217728 - b.len - 10 {
            __ch_error_set("RowBinary string exceeds byte limit")
            return false
        }
        __ch_varint(b, s.byte_len())
        buf_add(b, s)
        return true
    }
    if kind == D_LIST {
        let n = load64(v + 8)
        __ch_varint(b, n)
        for i in 0..n {
            if !__ch_write(b, __lget(v, i), load64(d + 8), depth + 1) {
                return false
            }
        }
        return true
    }
    if kind == D_STRUCT {
        for i in 0..load64(d + 8) {
            if !__ch_write(b, load64(v + i * 8), __field_desc(d, i), depth + 1) {
                return false
            }
        }
        return true
    }
    __ch_error_set("unsupported RowBinary type")
    return false
}

fn __ch_encode(v: int, d: int) -> str {
    __ch_error_set("")
    if load64(d) != D_LIST {
        __ch_error_set("ch_encode expects a list of rows")
        return ""
    }
    let b = buf_new(4096)
    let inner = load64(d + 8)
    var names: [str] = []
    var types: [str] = []
    if load64(inner) == D_STRUCT {
        let n = load64(inner + 8)
        for i in 0..n {
            names.push(__cast(load64(__field(inner, i))))
            types.push(__ch_type(__field_desc(inner, i), 0))
        }
    } else {
        names.push("value")
        types.push(__ch_type(inner, 0))
    }
    if names.len() == 0 || names.len() > 1024 || types.contains("") {
        __ch_error_set("unsupported RowBinary column type or column count")
        return ""
    }
    __ch_varint(b, names.len())
    for name in names { __ch_string(b, name) }
    for ty in types { __ch_string(b, ty) }
    for i in 0..load64(v + 8) {
        if !__ch_write(b, __lget(v, i), inner, 0) {
            return ""
        }
    }
    if b.len > 134217728 {
        __ch_error_set("RowBinary byte limit exceeded")
        return ""
    }
    // The private buffer is never mutated after return: retain its bytes instead
    // of copying the entire batch a second time.
    return __str_new(b.data, b.len)
}

type __ChReader {
    p: int
    end: int
    error: str = ""
    // Сколько памяти арены уже заняли декодированные значения (оценка): массивы
    // и мелкие столбцы занимают в памяти больше, чем в ответе.
    cost: int = 0
    // ошибка — значение не подошло к типу столбца (диапазон, Enum, длина):
    // ch_insert со схемой из кэша спрашивает её заново
    schema: bool = false
}

// Предел оценки памяти результата ch_decode.
const CH_DECODE_BUDGET = 536870912

fn __ch_need(r: __ChReader, n: int) -> bool {
    if r.error.byte_len() > 0 {
        return false
    }
    if n < 0 || n > r.end - r.p {
        r.error = "truncated RowBinary value"
        return false
    }
    return true
}

fn __ch_read_varint(r: __ChReader) -> int {
    var n = 0
    var shift = 0
    while shift < 63 {
        if !__ch_need(r, 1) {
            return 0
        }
        let c = load8(r.p)
        r.p += 1
        n = n | ((c & 127) << shift)
        if c < 128 {
            if shift > 0 && c == 0 {
                r.error = "noncanonical RowBinary varint"
            }
            return n
        }
        shift += 7
    }
    r.error = "RowBinary length exceeds signed 64-bit range"
    return 0
}

fn __ch_read_str(r: __ChReader) -> str {
    let n = __ch_read_varint(r)
    if !__ch_need(r, n) {
        return ""
    }
    let value = __str_new(r.p, n)
    r.p += n
    return value
}

// ---- Типы ClickHouse ----
// Строка типа (заголовок ответа, DESCRIBE) разбирается один раз в узлы
// __ChType. Декодер и вставка идут по готовому плану и не сравнивают строки
// типов на каждом значении.
const CHT_OTHER = 0
const CHT_INT = 1
const CHT_BOOL = 2
const CHT_F32 = 3
const CHT_F64 = 4
const CHT_STR = 5
const CHT_FIXED = 6
const CHT_UUID = 7
const CHT_DEC = 8
const CHT_DATE = 9
const CHT_DATE32 = 10
const CHT_DATETIME = 11
const CHT_DT64 = 12
const CHT_ENUM = 13
const CHT_NULLABLE = 14
const CHT_ARRAY = 15

type __ChType {
    op: int
    // байт на значение: целые, Decimal, FixedString(N), Enum, даты
    width: int = 0
    signed: bool = false
    // Decimal(P, S) — P и S; DateTime64(n) — n
    precision: int = 0
    scale: int = 0
    // Nullable, Array: __ChType элемента
    inner: int = 0
    // Enum: имена и значения
    names: [str] = []
    values: [int] = []
    // запись типа как есть; у LowCardinality(T) — вместе с обёрткой
    text: str = ""
}

type __ChTypeParser {
    s: str
    p: int = 0
    error: bool = false
}

fn __cht_byte(t: __ChTypeParser) -> int {
    if t.p >= t.s.byte_len() {
        return -1
    }
    return t.s.byte(t.p)
}

fn __cht_spaces(t: __ChTypeParser) {
    while __cht_byte(t) == ' ' {
        t.p += 1
    }
}

fn __cht_expect(t: __ChTypeParser, c: int) -> bool {
    __cht_spaces(t)
    if __cht_byte(t) != c {
        t.error = true
        return false
    }
    t.p += 1
    return true
}

fn __cht_name(t: __ChTypeParser) -> str {
    __cht_spaces(t)
    let start = t.p
    while true {
        let c = __cht_byte(t)
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') {
            break
        }
        t.p += 1
    }
    return t.s.byte_slice(start, t.p)
}

fn __cht_int(t: __ChTypeParser) -> int {
    __cht_spaces(t)
    var neg = false
    if __cht_byte(t) == '-' {
        neg = true
        t.p += 1
    }
    let start = t.p
    var n = 0
    while __cht_byte(t) >= '0' && __cht_byte(t) <= '9' {
        if n > 100000000000 {
            t.error = true
            return 0
        }
        n = n * 10 + __cht_byte(t) - '0'
        t.p += 1
    }
    if t.p == start {
        t.error = true
    }
    if neg {
        return 0 - n
    }
    return n
}

// 'текст' с экранированием через \ — так ClickHouse пишет имена Enum и пояса.
fn __cht_quoted(t: __ChTypeParser) -> str {
    __cht_spaces(t)
    if __cht_byte(t) != '\'' {
        t.error = true
        return ""
    }
    t.p += 1
    let b = buf_new(16)
    while true {
        let c = __cht_byte(t)
        if c < 0 {
            t.error = true
            return ""
        }
        t.p += 1
        if c == '\'' {
            break
        }
        if c == '\\' {
            let e = __cht_byte(t)
            if e < 0 {
                t.error = true
                return ""
            }
            t.p += 1
            if e == 'n' {
                buf_byte(b, '\n')
            } else if e == 't' {
                buf_byte(b, '\t')
            } else if e == 'r' {
                buf_byte(b, '\r')
            } else if e == '0' {
                buf_byte(b, 0)
            } else {
                buf_byte(b, e)
            }
            continue
        }
        buf_byte(b, c)
    }
    return buf_str(b)
}

// Аргументы типа, который драйвер не разбирает (Tuple, Map, IPv4, ...):
// скобки с вложенностью и строки в кавычках.
fn __cht_skip_args(t: __ChTypeParser) {
    var depth = 0
    while true {
        let c = __cht_byte(t)
        if c < 0 {
            t.error = true
            return
        }
        if c == '\'' {
            __cht_quoted(t)
            continue
        }
        t.p += 1
        if c == '(' {
            depth += 1
        } else if c == ')' {
            depth -= 1
            if depth == 0 {
                return
            }
        }
    }
}

fn __cht_int_type(ty: __ChType, name: str) -> bool {
    var signed = true
    var bits = name
    if name.starts_with("UInt") {
        signed = false
        bits = name.byte_slice(4, name.byte_len())
    } else if name.starts_with("Int") {
        bits = name.byte_slice(3, name.byte_len())
    } else {
        return false
    }
    var width = 0
    if bits == "8" {
        width = 1
    } else if bits == "16" {
        width = 2
    } else if bits == "32" {
        width = 4
    } else if bits == "64" {
        width = 8
    } else if bits == "128" {
        width = 16
    } else if bits == "256" {
        width = 32
    } else {
        return false
    }
    ty.op = CHT_INT
    ty.width = width
    ty.signed = signed
    return true
}

fn __cht_decimal(t: __ChTypeParser, ty: __ChType, precision: int, scale: int) {
    if precision < 1 || precision > 76 || scale < 0 || scale > precision {
        t.error = true
        return
    }
    ty.op = CHT_DEC
    ty.precision = precision
    ty.scale = scale
    ty.signed = true
    ty.width = 32
    if precision <= 9 {
        ty.width = 4
    } else if precision <= 18 {
        ty.width = 8
    } else if precision <= 38 {
        ty.width = 16
    }
}

fn __cht_parse(t: __ChTypeParser, depth: int) -> __ChType {
    __cht_spaces(t)
    let start = t.p
    let name = __cht_name(t)
    let ty = __ChType { op: CHT_OTHER }
    if name.byte_len() == 0 || depth > 32 {
        t.error = true
        return ty
    }
    if name == "Nullable" || name == "Array" || name == "LowCardinality" {
        if !__cht_expect(t, '(') {
            return ty
        }
        let inner = __cht_parse(t, depth + 1)
        __cht_expect(t, ')')
        if name == "LowCardinality" {
            // в RowBinary LowCardinality(T) записывается как T
            inner.text = t.s.byte_slice(start, t.p)
            return inner
        }
        ty.op = CHT_ARRAY
        if name == "Nullable" {
            ty.op = CHT_NULLABLE
        }
        ty.inner = __cast(inner)
    } else if __cht_int_type(ty, name) {
    } else if name == "Bool" {
        ty.op = CHT_BOOL
        ty.width = 1
    } else if name == "Float32" {
        ty.op = CHT_F32
        ty.width = 4
    } else if name == "Float64" {
        ty.op = CHT_F64
        ty.width = 8
    } else if name == "String" {
        ty.op = CHT_STR
    } else if name == "UUID" {
        ty.op = CHT_UUID
        ty.width = 16
    } else if name == "Date" {
        ty.op = CHT_DATE
        ty.width = 2
    } else if name == "Date32" {
        ty.op = CHT_DATE32
        ty.width = 4
        ty.signed = true
    } else if name == "FixedString" {
        __cht_expect(t, '(')
        ty.width = __cht_int(t)
        __cht_expect(t, ')')
        if ty.width < 1 || ty.width > 16777216 {
            t.error = true
        }
        ty.op = CHT_FIXED
    } else if name == "DateTime" {
        // DateTime('пояс'): пояс влияет на текст, не на значение
        if __cht_byte(t) == '(' {
            __cht_skip_args(t)
        }
        ty.op = CHT_DATETIME
        ty.width = 4
    } else if name == "DateTime64" {
        __cht_expect(t, '(')
        ty.scale = __cht_int(t)
        __cht_spaces(t)
        if __cht_byte(t) == ',' {
            t.p += 1
            __cht_quoted(t)
        }
        __cht_expect(t, ')')
        if ty.scale < 0 || ty.scale > 9 {
            t.error = true
        }
        ty.op = CHT_DT64
        ty.width = 8
        ty.signed = true
    } else if name == "Decimal" {
        __cht_expect(t, '(')
        let p = __cht_int(t)
        var s = 0
        __cht_spaces(t)
        if __cht_byte(t) == ',' {
            t.p += 1
            s = __cht_int(t)
        }
        __cht_expect(t, ')')
        __cht_decimal(t, ty, p, s)
    } else if name == "Decimal32" || name == "Decimal64" || name == "Decimal128" || name == "Decimal256" {
        __cht_expect(t, '(')
        let s = __cht_int(t)
        __cht_expect(t, ')')
        var p = 76
        if name == "Decimal32" {
            p = 9
        } else if name == "Decimal64" {
            p = 18
        } else if name == "Decimal128" {
            p = 38
        }
        __cht_decimal(t, ty, p, s)
    } else if name == "Enum8" || name == "Enum16" {
        __cht_expect(t, '(')
        while !t.error {
            ty.names.push(__cht_quoted(t))
            __cht_expect(t, '=')
            ty.values.push(__cht_int(t))
            __cht_spaces(t)
            if __cht_byte(t) != ',' {
                break
            }
            t.p += 1
        }
        __cht_expect(t, ')')
        ty.op = CHT_ENUM
        ty.width = 1
        if name == "Enum16" {
            ty.width = 2
        }
        ty.signed = true
    } else if __cht_byte(t) == '(' {
        __cht_skip_args(t)
    }
    ty.text = t.s.byte_slice(start, t.p)
    return ty
}

// Тип по записи ClickHouse; none — запись не разобрать.
fn __ch_type_of(text: str) -> __ChType? {
    let t = __ChTypeParser { s: text }
    let ty = __cht_parse(t, 0)
    __cht_spaces(t)
    if t.error || t.p != text.byte_len() {
        return none
    }
    return ty
}

// ---- Числа ----

// Целое из width байт (младший первым); старшие байты Int128/Int256 должны
// повторять знак (иначе r.error: значение не помещается в int).
fn __ch_get_int(r: __ChReader, width: int, signed: bool) -> int {
    if !__ch_need(r, width) {
        return 0
    }
    let p = r.p
    r.p += width
    if width == 1 {
        let v = load8(p)
        if signed {
            return (v << 56) >> 56
        }
        return v
    }
    if width == 2 {
        let v = load8(p) | (load8(p + 1) << 8)
        if signed {
            return (v << 48) >> 48
        }
        return v
    }
    if width == 4 {
        let v = load32(p)
        if signed {
            return (v << 32) >> 32
        }
        return v
    }
    let v = load64(p)
    var fill = 0
    if v < 0 {
        fill = -1
    }
    if !signed && v < 0 {
        r.error = "ClickHouse unsigned value does not fit Khrip int"
        return 0
    }
    var i = 8
    while i < width {
        if load64(p + i) != fill {
            r.error = "ClickHouse integer does not fit Khrip int"
            return 0
        }
        i += 8
    }
    return v
}

// Целое v в width байт (Int128/Int256 — с расширением знака).
fn __ch_put_int(b: Buf, v: int, width: int) {
    buf_reserve(b, 32)
    store64(b.data + b.len, v)
    var fill = 0
    if v < 0 {
        fill = -1
    }
    var i = 8
    while i < width {
        store64(b.data + b.len + i, fill)
        i += 8
    }
    b.len += width
}

// Float32 (биты) → float (биты Float64): точно.
fn __ch_f32_to_f64(bits: int) -> int {
    let sign = ((bits >> 31) & 1) << 63
    let e = (bits >> 23) & 255
    var m = bits & 0x7FFFFF
    if e == 255 {
        return sign | (0x7FF << 52) | (m << 29)
    }
    if e == 0 {
        if m == 0 {
            return sign
        }
        // субнормальное: m · 2^-149 — нормализовать
        var e2 = -126
        while (m & 0x800000) == 0 {
            m = m << 1
            e2 -= 1
        }
        return sign | ((e2 + 1023) << 52) | ((m & 0x7FFFFF) << 29)
    }
    return sign | ((e - 127 + 1023) << 52) | (m << 29)
}

// float (биты Float64) → биты Float32: к ближайшему, при равенстве — к чётному.
// -1 — конечное число больше наибольшего Float32.
fn __ch_f64_to_f32(bits: int) -> int {
    let sign = ((bits >> 63) & 1) << 31
    let e = (bits >> 52) & 0x7FF
    let m = bits & 0xFFFFFFFFFFFFF
    if e == 0x7FF {
        if m == 0 {
            return sign | 0x7F800000
        }
        return sign | 0x7FC00000 | (m >> 29)
    }
    if e == 0 {
        // субнормальные Float64 меньше любого Float32
        return sign
    }
    var exp = e - 1023
    if exp > 127 {
        return -1
    }
    let mant = m | (1 << 52)
    var shift = 29
    if exp < -126 {
        shift = 29 - 126 - exp
    }
    if shift > 53 {
        return sign
    }
    var q = mant >> shift
    let rem = mant & ((1 << shift) - 1)
    let half = 1 << (shift - 1)
    if rem > half || (rem == half && (q & 1) == 1) {
        q += 1
    }
    if exp >= -126 {
        if q == (1 << 24) {
            q = q >> 1
            exp += 1
        }
        if exp > 127 {
            return -1
        }
        return sign | ((exp + 127) << 23) | (q & 0x7FFFFF)
    }
    // субнормальное Float32; перенос до 2^23 даёт наименьшее нормальное
    return sign | q
}

// Целое без запятой Decimal (width байт) → float: точно, пока |значение| < 2^53
// (до 15–16 значащих цифр), дальше — ближайшее представимое с ошибкой до 1 ulp.
fn __ch_decimal_float(r: __ChReader, width: int, scale: int) -> int {
    if !__ch_need(r, width) {
        return 0
    }
    let p = r.p
    r.p += width
    var f = 0.0
    if width == 4 {
        f = ((load32(p) << 32) >> 32).to_float()
    } else {
        let low = load64(p)
        var fill = 0
        if low < 0 {
            fill = -1
        }
        var fits = true
        var i = 8
        while i < width {
            if load64(p + i) != fill {
                fits = false
            }
            i += 8
        }
        if fits {
            f = low.to_float()
        } else {
            // модуль числа (дополнительный код — со знаком старшего слова),
            // затем Σ слово·2^(64·i) от старших слов: без вычитания близких чисел
            let n = width / 8
            let words = __alloc(width)
            __memcpy(words, p, width)
            let negative = load64(p + width - 8) < 0
            if negative {
                var carry = 1
                for k in 0..n {
                    let w = ~load64(words + k * 8)
                    store64(words + k * 8, w + carry)
                    if carry == 1 && w != -1 {
                        carry = 0
                    }
                }
            }
            var k = n
            while k > 0 {
                k -= 1
                let w = load64(words + k * 8)
                var u = w.to_float()
                if w < 0 {
                    u = ((w >> 1) & 0x7FFFFFFFFFFFFFFF).to_float() * 2.0 + (w & 1).to_float()
                }
                f = f * 18446744073709551616.0 + u
            }
            if negative {
                f = 0.0 - f
            }
        }
    }
    let v = f / __pow10f(scale)
    return __cast(v)
}

// Кратчайшая десятичная запись float (её печатает Khrip: 1.005 — это 1.005, а
// не 1.00499...): знак, цифры без ведущих и хвостовых нулей (count штук, до 17)
// и порядок: 12345678901234567000 — это 12345678901234567 · 10^3.
type __ChDigits {
    neg: bool = false
    digits: int = 0
    count: int = 0
    exp: int = 0
}

// none — NaN или ±Inf.
fn __ch_digits(x: float) -> __ChDigits? {
    let d = __ChDigits {}
    let text = x.to_str()
    var i = 0
    if text.byte(0) == '-' {
        d.neg = true
        i = 1
    }
    var point = false
    // нули после значащих цифр: войдут в digits, только если за ними есть цифра
    var zeros = 0
    while i < text.byte_len() {
        let c = text.byte(i)
        if c >= '0' && c <= '9' {
            if c == '0' && d.digits > 0 {
                zeros += 1
            } else if c != '0' {
                if d.count + zeros >= 17 {
                    return none
                }
                for k in 0..zeros {
                    d.digits = d.digits * 10
                }
                d.digits = d.digits * 10 + c - '0'
                d.count += zeros + 1
                zeros = 0
            }
            if point {
                d.exp -= 1
            }
        } else if c == '.' {
            point = true
        } else if c == 'e' {
            // e+21, e-7
            var e = 0
            var j = i + 2
            while j < text.byte_len() {
                e = e * 10 + text.byte(j) - '0'
                j += 1
            }
            if text.byte(i + 1) == '-' {
                e = 0 - e
            }
            d.exp += e
            break
        } else {
            // NaN, Infinity
            return none
        }
        i += 1
    }
    d.exp += zeros
    return d
}

// float → целое без запятой для Decimal(P, S): по кратчайшей десятичной записи
// числа, половина — от нуля. none — NaN, ±Inf, |значение| ≥ 10^P или не
// помещается в int (Decimal128/256 тогда пишет __ch_decimal_wide).
fn __ch_decimal_units(x: float, scale: int, precision: int) -> int? {
    let d = __ch_digits(x) else {
        return none
    }
    let neg = d.neg
    let digits = d.digits
    let shift = d.exp + scale
    var units = digits
    if shift >= 0 {
        for k in 0..shift {
            if units > 922337203685477580 {
                return none
            }
            units = units * 10
        }
    } else if shift < -18 {
        units = 0
    } else {
        let div = __pow10i(0 - shift)
        units = digits / div
        if (digits % div) * 2 >= div {
            units += 1
        }
    }
    if precision <= 18 && units >= __pow10i(precision) {
        return none
    }
    if neg {
        return 0 - units
    }
    return units
}

// Decimal128/256, целое без запятой которого больше int: цифры числа · 10^сдвиг
// по 32 бита в слове (умножение на 10 не переполняет int), затем width байт
// младшими вперёд, отрицательное — в дополнительном коде. Сдвиг здесь ≥ 0: с
// отрицательным значение меньше цифр и поместилось в int. false — не
// помещается в Decimal(P, S): цифр с нулями сдвига больше P.
fn __ch_decimal_wide(b: Buf, x: float, scale: int, precision: int, width: int) -> bool {
    let d = __ch_digits(x) else {
        return false
    }
    let shift = d.exp + scale
    if width < 16 || shift < 0 || d.count + shift > precision {
        return false
    }
    let n = width / 4
    let limbs = __alloc(n * 8)
    __memset(limbs, 0, n * 8)
    store64(limbs, d.digits & 0xFFFFFFFF)
    store64(limbs + 8, d.digits >> 32)
    for k in 0..shift {
        var carry = 0
        for i in 0..n {
            let v = load64(limbs + i * 8) * 10 + carry
            store64(limbs + i * 8, v & 0xFFFFFFFF)
            carry = v >> 32
        }
    }
    if d.neg {
        // −v = ~v + 1
        var carry = 1
        for i in 0..n {
            let v = (load64(limbs + i * 8) ^ 0xFFFFFFFF) + carry
            store64(limbs + i * 8, v & 0xFFFFFFFF)
            carry = v >> 32
        }
    }
    buf_reserve(b, width)
    for i in 0..n {
        store32(b.data + b.len + i * 4, load64(limbs + i * 8))
    }
    b.len += width
    return true
}

// ---- UUID ----
// В RowBinary UUID — две половины по 64 бита, каждая младшим байтом вперёд:
// старшая (первые 16 цифр), затем младшая.

fn __ch_uuid_text(r: __ChReader) -> str {
    if !__ch_need(r, 16) {
        return ""
    }
    let hex = "0123456789abcdef"
    let b = buf_new(36)
    for half in 0..2 {
        let v = load64(r.p + half * 8)
        for k in 0..16 {
            if (half == 0 && (k == 8 || k == 12)) || (half == 1 && (k == 0 || k == 4)) {
                buf_byte(b, '-')
            }
            buf_byte(b, hex.byte((v >> (60 - k * 4)) & 15))
        }
    }
    r.p += 16
    return buf_str(b)
}

// Канонический UUID (8-4-4-4-12, цифры в любом регистре) → 16 байт в b.
fn __ch_uuid_put(b: Buf, s: str) -> bool {
    if s.byte_len() != 36 {
        return false
    }
    var halves = [0, 0]
    var digits = 0
    for i in 0..36 {
        let c = s.byte(i)
        if i == 8 || i == 13 || i == 18 || i == 23 {
            if c != '-' {
                return false
            }
            continue
        }
        let d = __hex_val(c)
        if d < 0 {
            return false
        }
        let h = digits / 16
        halves[h] = (halves[h] << 4) | d
        digits += 1
    }
    buf_reserve(b, 16)
    store64(b.data + b.len, halves[0])
    store64(b.data + b.len + 8, halves[1])
    b.len += 16
    return true
}

// ---- Чтение результата ----
// План столбца собирается один раз после заголовка: что читать (ширина, знак,
// флаг NULL, массив, LowCardinality снят разбором типа) и что получить (ячейка
// для T? над скаляром, размер элемента списка). Значения читаются по плану без
// разбора строк типов и без выделений, кроме самих значений результата.

type __ChRead {
    // CHT_INT (целые, Bool, даты — в сырых единицах), CHT_F64, CHT_F32,
    // CHT_DEC, CHT_STR, CHT_FIXED, CHT_UUID, CHT_ENUM, CHT_ARRAY
    op: int
    width: int = 8
    signed: bool = false
    scale: int = 0
    // перед значением — флаг NULL (Nullable)
    nullable: bool = false
    // T? над скаляром: значение — в своей ячейке
    box: bool = false
    // в bool: только 0 и 1
    flag: bool = false
    // Array: размер элемента списка и план элемента
    es: int = 8
    item: int = 0
    // Enum → str: имена по значениям (готовые строки, без выделения)
    names: [str] = []
    values: [int] = []
}

fn __ch_read_plan(ty: __ChType, d: int, depth: int) -> __ChRead? {
    if depth > 32 {
        return none
    }
    let k = load64(d)
    if k == D_OPT {
        let inner = load64(d + 8)
        var t = ty
        if ty.op == CHT_NULLABLE {
            t = __cast(ty.inner)
        }
        let p = __ch_read_plan(t, inner, depth + 1) else {
            return none
        }
        if p.nullable {
            return none
        }
        p.nullable = ty.op == CHT_NULLABLE
        p.box = __is_scalar(inner)
        return p
    }
    let op = ty.op
    if op == CHT_NULLABLE {
        // Nullable — только в поле T?
        return none
    }
    if k == D_LIST {
        if op != CHT_ARRAY {
            return none
        }
        let inner = load64(d + 8)
        let item = __ch_read_plan(__cast(ty.inner), inner, depth + 1) else {
            return none
        }
        var es = 8
        if load64(inner) == D_BOOL {
            es = 1
        }
        return __ChRead { op: CHT_ARRAY, es, item: __cast(item) }
    }
    if k == D_INT {
        if op == CHT_INT {
            return __ChRead { op: CHT_INT, width: ty.width, signed: ty.signed }
        }
        // даты — в сырых единицах: дни, секунды, 10^-n секунды DateTime64(n)
        if op == CHT_DATE || op == CHT_DATETIME {
            return __ChRead { op: CHT_INT, width: ty.width }
        }
        if op == CHT_DATE32 || op == CHT_DT64 {
            return __ChRead { op: CHT_INT, width: ty.width, signed: true }
        }
        return none
    }
    if k == D_BOOL {
        if op == CHT_BOOL || (op == CHT_INT && ty.width == 1 && !ty.signed) {
            return __ChRead { op: CHT_INT, width: 1, flag: true }
        }
        return none
    }
    if k == D_FLOAT {
        if op == CHT_F64 || op == CHT_F32 {
            return __ChRead { op }
        }
        if op == CHT_DEC {
            return __ChRead { op, width: ty.width, scale: ty.scale }
        }
        return none
    }
    if k == D_STR {
        if op == CHT_STR || op == CHT_UUID {
            return __ChRead { op }
        }
        if op == CHT_FIXED {
            return __ChRead { op, width: ty.width }
        }
        if op == CHT_ENUM {
            return __ChRead { op, width: ty.width, signed: true, names: ty.names, values: ty.values }
        }
        return none
    }
    return none
}

// Наименьшее число байт значения по плану: по нему список строк результата
// заводится сразу нужной длины (без копий при росте).
fn __ch_min_bytes(p: __ChRead) -> int {
    if p.nullable || p.op == CHT_STR || p.op == CHT_ARRAY {
        return 1
    }
    if p.op == CHT_F64 {
        return 8
    }
    if p.op == CHT_F32 {
        return 4
    }
    if p.op == CHT_UUID {
        return 16
    }
    return p.width
}

fn __ch_cost(r: __ChReader, n: int) {
    r.cost += n
    if r.cost > CH_DECODE_BUDGET && r.error.byte_len() == 0 {
        r.error = "RowBinary result needs more than 512 MiB of request memory; select fewer rows or columns"
    }
}

fn __ch_get(r: __ChReader, p: __ChRead) -> int {
    if p.nullable {
        if !__ch_need(r, 1) {
            return 0
        }
        let flag = load8(r.p)
        r.p += 1
        if flag == 1 {
            return 0
        }
        if flag != 0 {
            r.error = "invalid RowBinary nullable flag"
            return 0
        }
    }
    let op = p.op
    var v = 0
    if op == CHT_INT {
        v = __ch_get_int(r, p.width, p.signed)
        if p.flag && v != 0 && v != 1 {
            r.error = "ClickHouse UInt8 is not a boolean"
            return 0
        }
    } else if op == CHT_STR {
        let n = __ch_read_varint(r)
        if !__ch_need(r, n) {
            return 0
        }
        v = __cast(__str_new(r.p, n))
        r.p += n
        __ch_cost(r, 16)
    } else if op == CHT_F64 {
        if !__ch_need(r, 8) {
            return 0
        }
        v = load64(r.p)
        r.p += 8
    } else if op == CHT_ARRAY {
        let n = __ch_read_varint(r)
        // каждый элемент — хотя бы байт ответа
        if r.error.byte_len() > 0 || n > r.end - r.p {
            r.error = "RowBinary array length exceeds the response"
            return 0
        }
        let es = p.es
        __ch_cost(r, 48 + n * es)
        if r.error.byte_len() > 0 {
            return 0
        }
        let h = __list_new(n, es)
        let data = load64(h)
        let item: __ChRead = __cast(p.item)
        for i in 0..n {
            let x = __ch_get(r, item)
            if r.error.byte_len() > 0 {
                return 0
            }
            if es == 1 {
                store8(data + i, x)
            } else {
                store64(data + i * 8, x)
            }
        }
        store64(h + 8, n)
        v = h
    } else if op == CHT_F32 {
        if !__ch_need(r, 4) {
            return 0
        }
        v = __ch_f32_to_f64(load32(r.p))
        r.p += 4
    } else if op == CHT_DEC {
        v = __ch_decimal_float(r, p.width, p.scale)
    } else if op == CHT_FIXED {
        if !__ch_need(r, p.width) {
            return 0
        }
        v = __cast(__str_new(r.p, p.width))
        r.p += p.width
        __ch_cost(r, 16)
    } else if op == CHT_UUID {
        v = __cast(__ch_uuid_text(r))
        __ch_cost(r, 64)
    } else if op == CHT_ENUM {
        let code = __ch_get_int(r, p.width, true)
        var found = -1
        for i in 0..p.values.len() {
            if p.values[i] == code {
                found = i
                break
            }
        }
        if found < 0 {
            r.error = "ClickHouse Enum value " + code.to_str() + " has no name"
            return 0
        }
        v = __cast(p.names[found])
    }
    if p.box {
        let cell = __alloc(8)
        store64(cell, v)
        __ch_cost(r, 16)
        return cell
    }
    return v
}

// Описание Khrip-типа для ошибок: int, str?, [float]...
fn __ch_khrip_name(d: int) -> str {
    let k = load64(d)
    if k == D_INT {
        return "int"
    }
    if k == D_FLOAT {
        return "float"
    }
    if k == D_BOOL {
        return "bool"
    }
    if k == D_STR {
        return "str"
    }
    if k == D_OPT {
        return __ch_khrip_name(load64(d + 8)) + "?"
    }
    if k == D_LIST {
        return "[" + __ch_khrip_name(load64(d + 8)) + "]"
    }
    return "value"
}

fn __ch_decode(body: str, d: int) -> int {
    __ch_error_set("")
    if load64(d) != D_LIST || body.byte_len() > 134217728 {
        __ch_error_set("ch_decode expects a bounded RowBinaryWithNamesAndTypes result and a list type")
        return 0
    }
    let row = load64(d + 8)
    let kind = load64(row)
    let r = __ChReader { p: __str_ptr(body), end: __str_ptr(body) + body.byte_len() }
    let count = __ch_read_varint(r)
    var wanted = 1
    if kind == D_STRUCT {
        wanted = load64(row + 8)
    }
    if r.error.byte_len() > 0 || count != wanted || count <= 0 || count > 1024 {
        __ch_error_set("RowBinary column count does not match the result type")
        return 0
    }
    var names: [str] = []
    for i in 0..count {
        let name = __ch_read_str(r)
        if names.contains(name) {
            r.error = "duplicate RowBinary column name"
        }
        names.push(name)
    }
    // поле структуры и план чтения каждого столбца — один раз
    let fields = __alloc(count * 8)
    let plans = __alloc(count * 8)
    var row_bytes = 0
    for i in 0..count {
        let text = __ch_read_str(r)
        if r.error.byte_len() > 0 {
            break
        }
        var field = 0
        var desc = row
        if kind == D_STRUCT {
            field = -1
            for j in 0..wanted {
                let name: str = __cast(load64(__field(row, j)))
                if name == names[i] {
                    field = j
                    desc = __field_desc(row, j)
                    break
                }
            }
            if field < 0 {
                r.error = "RowBinary column '" + names[i] + "' has no matching field"
                break
            }
        }
        store64(fields + i * 8, field)
        var plan = 0
        if let ty = __ch_type_of(text) {
            if let p = __ch_read_plan(ty, desc, 0) {
                plan = __cast(p)
            }
        }
        if plan == 0 {
            r.error = "RowBinary column '" + names[i] + "' type " + text + " does not match Khrip type " + __ch_khrip_name(desc)
            break
        }
        store64(plans + i * 8, plan)
        row_bytes += __ch_min_bytes(__cast(plan))
    }
    var es = 8
    if kind == D_BOOL {
        es = 1
    }
    // строк не больше, чем остаток / наименьшая строка; не больше остатка / 8,
    // чтобы список не превышал размер ответа
    let rows: [int] = __cast(__list_new(((r.end - r.p) / row_bytes.max(8)).max(16), es))
    if kind == D_STRUCT {
        let size = load64(row + 8) * 8 + 16
        while r.p < r.end && r.error.byte_len() == 0 {
            let value = __struct_alloc(row)
            for i in 0..count {
                store64(value + load64(fields + i * 8) * 8, __ch_get(r, __cast(load64(plans + i * 8))))
            }
            rows.push(value)
            __ch_cost(r, size)
        }
    } else {
        let plan: __ChRead = __cast(load64(plans))
        while r.p < r.end && r.error.byte_len() == 0 {
            rows.push(__ch_get(r, plan))
            __ch_cost(r, es)
        }
    }
    if r.error.byte_len() > 0 {
        __ch_error_set(r.error)
        return 0
    }
    return __cast(rows)
}

// ---- Вставка под схему таблицы ----
// ch_encode пишет типы Khrip (Int64, Float64, Bool, String, Nullable, Array), а
// настоящие таблицы — UInt64, DateTime, LowCardinality(String), Nullable(String),
// Float32... ch_insert узнаёт типы столбцов (DESCRIBE, кэш процесса) и
// перекодирует пакет под них с проверкой диапазона. Заголовок нового пакета —
// настоящие типы: сервер сверяет их со схемой (input_format_with_types_use_header),
// так что устаревший кэш даёт ошибку, а не неверные байты.

// Перевод значения: из типа пакета ch_encode в тип столбца.
const CHC_COPY = 1
const CHC_INT = 2
const CHC_F32 = 3
const CHC_DEC = 4
const CHC_STR = 5
const CHC_FIXED = 6
const CHC_ENUM = 7
const CHC_UUID = 8
const CHC_ARRAY = 9

type __ChConv {
    op: int
    // в пакете перед значением флаг NULL / в столбце нужен флаг NULL
    src_null: bool = false
    dst_null: bool = false
    // байт значения в столбце; CHC_COPY — сколько байт копировать
    width: int = 8
    // CHC_INT: допустимые значения
    lo: int = 0
    hi: int = 0
    // CHC_DEC
    scale: int = 0
    precision: int = 0
    // CHC_ARRAY: __ChConv элемента
    item: int = 0
    // CHC_ENUM
    names: [str] = []
    values: [int] = []
    column: str = ""
    target: str = ""
}

// Тип пакета ch_encode → имя Khrip для ошибок.
fn __ch_source_name(ty: __ChType) -> str {
    if ty.op == CHT_NULLABLE {
        return __ch_source_name(__cast(ty.inner)) + "?"
    }
    if ty.op == CHT_ARRAY {
        return "[" + __ch_source_name(__cast(ty.inner)) + "]"
    }
    if ty.op == CHT_INT {
        return "int"
    }
    if ty.op == CHT_F64 {
        return "float"
    }
    if ty.op == CHT_BOOL {
        return "bool"
    }
    if ty.op == CHT_STR {
        return "str"
    }
    return ty.text
}

// Границы значений DateTime64(n) в его единицах: 1900-01-01 .. 2299-12-31.
fn __ch_dt64_range(scale: int) -> [int] {
    let unit = __pow10i(scale)
    var hi = 9223372036854775807
    if scale < 9 {
        hi = 10413791999 * unit + unit - 1
    }
    return [-2208988800 * unit, hi]
}

// План перевода столбца column из src (пакет) в dst (таблица); error — почему нельзя.
fn __ch_conv_plan(column: str, src: __ChType, dst: __ChType, depth: int, error: Buf) -> __ChConv? {
    if depth > 32 {
        buf_add(error, "column '" + column + "' nests too deep")
        return none
    }
    var s = src
    var t = dst
    let conv = __ChConv { op: 0, column, target: dst.text }
    if t.op == CHT_NULLABLE {
        conv.dst_null = true
        t = __cast(t.inner)
    }
    if s.op == CHT_NULLABLE {
        if !conv.dst_null {
            buf_add(error, "column '" + column + "' is " + dst.text + ", not Nullable, but the Khrip field is optional (" + __ch_source_name(src) + ")")
            return none
        }
        conv.src_null = true
        s = __cast(s.inner)
    }
    let so = s.op
    let to = t.op
    if so == CHT_ARRAY && to == CHT_ARRAY {
        let item = __ch_conv_plan(column, __cast(s.inner), __cast(t.inner), depth + 1, error) else {
            return none
        }
        conv.op = CHC_ARRAY
        conv.item = __cast(item)
        return conv
    }
    if so == CHT_INT && s.width == 8 && s.signed {
        conv.op = CHC_INT
        conv.width = t.width
        if to == CHT_INT {
            if t.signed {
                if t.width >= 8 {
                    conv.op = CHC_COPY
                    conv.lo = -9223372036854775807 - 1
                    conv.hi = 9223372036854775807
                } else {
                    conv.hi = (1 << (t.width * 8 - 1)) - 1
                    conv.lo = 0 - conv.hi - 1
                }
            } else {
                conv.lo = 0
                conv.hi = 9223372036854775807
                if t.width < 8 {
                    conv.hi = (1 << (t.width * 8)) - 1
                }
            }
            if conv.op == CHC_COPY && t.width > 8 {
                conv.op = CHC_INT
            }
            return conv
        }
        // даты и время — в сырых единицах (дни, секунды, 10^-n секунды)
        if to == CHT_DATE {
            conv.hi = 65535
            return conv
        }
        if to == CHT_DATE32 {
            conv.lo = -25567
            conv.hi = 120529
            return conv
        }
        if to == CHT_DATETIME {
            conv.hi = 4294967295
            return conv
        }
        if to == CHT_DT64 {
            let range = __ch_dt64_range(t.scale)
            conv.lo = range[0]
            conv.hi = range[1]
            return conv
        }
    }
    if so == CHT_F64 {
        if to == CHT_F64 {
            conv.op = CHC_COPY
            return conv
        }
        if to == CHT_F32 {
            conv.op = CHC_F32
            return conv
        }
        if to == CHT_DEC {
            conv.op = CHC_DEC
            conv.width = t.width
            conv.scale = t.scale
            conv.precision = t.precision
            return conv
        }
    }
    if so == CHT_BOOL && (to == CHT_BOOL || (to == CHT_INT && t.width == 1 && !t.signed)) {
        conv.op = CHC_COPY
        conv.width = 1
        return conv
    }
    if so == CHT_STR {
        if to == CHT_STR {
            conv.op = CHC_STR
            return conv
        }
        if to == CHT_FIXED {
            conv.op = CHC_FIXED
            conv.width = t.width
            return conv
        }
        if to == CHT_ENUM {
            conv.op = CHC_ENUM
            conv.width = t.width
            conv.names = t.names
            conv.values = t.values
            return conv
        }
        if to == CHT_UUID {
            conv.op = CHC_UUID
            return conv
        }
    }
    buf_add(error, "column '" + column + "': Khrip " + __ch_source_name(src) + " cannot be written to ClickHouse " + dst.text)
    return none
}

fn __ch_conv_fail(r: __ChReader, v: __ChConv, what: str) -> bool {
    if r.error.byte_len() == 0 {
        r.error = "column '" + v.column + "' (" + v.target + "): " + what
        r.schema = true
    }
    return false
}

// Одно значение пакета → байты столбца в b.
fn __ch_conv_value(r: __ChReader, b: Buf, v: __ChConv) -> bool {
    if v.src_null {
        if !__ch_need(r, 1) {
            return false
        }
        let flag = load8(r.p)
        r.p += 1
        if flag > 1 {
            r.error = "invalid RowBinary nullable flag"
            return false
        }
        buf_byte(b, flag)
        if flag == 1 {
            return true
        }
    } else if v.dst_null {
        buf_byte(b, 0)
    }
    let op = v.op
    if op == CHC_COPY {
        if !__ch_need(r, v.width) {
            return false
        }
        buf_add_raw(b, r.p, v.width)
        r.p += v.width
        return true
    }
    if op == CHC_STR {
        let n = __ch_read_varint(r)
        if !__ch_need(r, n) {
            return false
        }
        __ch_varint(b, n)
        buf_add_raw(b, r.p, n)
        r.p += n
        return true
    }
    if op == CHC_INT {
        let x = __ch_get_int(r, 8, true)
        if r.error.byte_len() > 0 {
            return false
        }
        if x < v.lo || x > v.hi {
            return __ch_conv_fail(r, v, "value " + x.to_str() + " is out of range " + v.lo.to_str() + ".." + v.hi.to_str())
        }
        __ch_put_int(b, x, v.width)
        return true
    }
    if op == CHC_ARRAY {
        let n = __ch_read_varint(r)
        if r.error.byte_len() > 0 || n > r.end - r.p {
            r.error = "RowBinary array length exceeds the batch"
            return false
        }
        __ch_varint(b, n)
        let item: __ChConv = __cast(v.item)
        for i in 0..n {
            if !__ch_conv_value(r, b, item) {
                return false
            }
        }
        return true
    }
    if op == CHC_F32 {
        if !__ch_need(r, 8) {
            return false
        }
        let bits = __ch_f64_to_f32(load64(r.p))
        if bits < 0 {
            let x: float = __cast(load64(r.p))
            return __ch_conv_fail(r, v, "value " + x.to_str() + " exceeds Float32")
        }
        r.p += 8
        buf_reserve(b, 8)
        store32(b.data + b.len, bits)
        b.len += 4
        return true
    }
    if op == CHC_DEC {
        if !__ch_need(r, 8) {
            return false
        }
        let x: float = __cast(load64(r.p))
        r.p += 8
        let units = __ch_decimal_units(x, v.scale, v.precision) else {
            if __ch_decimal_wide(b, x, v.scale, v.precision, v.width) {
                return true
            }
            return __ch_conv_fail(r, v, "value " + x.to_str() + " does not fit Decimal(" + v.precision.to_str() + ", " + v.scale.to_str() + ")")
        }
        __ch_put_int(b, units, v.width)
        return true
    }
    // остальные — из строки
    let s = __ch_read_str(r)
    if r.error.byte_len() > 0 {
        return false
    }
    if op == CHC_FIXED {
        if s.byte_len() > v.width {
            return __ch_conv_fail(r, v, s.byte_len().to_str() + " bytes do not fit")
        }
        buf_add(b, s)
        for i in s.byte_len()..v.width {
            buf_byte(b, 0)
        }
        return true
    }
    if op == CHC_ENUM {
        for i in 0..v.names.len() {
            if v.names[i] == s {
                __ch_put_int(b, v.values[i], v.width)
                return true
            }
        }
        return __ch_conv_fail(r, v, "'" + s + "' is not one of its values")
    }
    if op == CHC_UUID {
        if !__ch_uuid_put(b, s) {
            return __ch_conv_fail(r, v, "'" + s + "' is not a UUID (8-4-4-4-12 hexadecimal digits)")
        }
        return true
    }
    return __ch_conv_fail(r, v, "unsupported conversion")
}

// План вставки: столбцы пакета против ответа DESCRIBE.
type __ChInsertPlan {
    convs: [int] = []
    types: [str] = []
    // типы совпали: пакет уходит как есть
    same: bool = true
    error: str = ""
}

fn __ch_insert_plan(schema: str, cols: [str], srcs: [str]) -> __ChInsertPlan {
    let plan = __ChInsertPlan {}
    // ответ DESCRIBE: name, type, default_type, ... — все String
    let r = __ChReader { p: __str_ptr(schema), end: __str_ptr(schema) + schema.byte_len() }
    let width = __ch_read_varint(r)
    if r.error.byte_len() > 0 || width < 3 || width > 64 {
        plan.error = "unexpected DESCRIBE result"
        return plan
    }
    var heads: [str] = []
    for i in 0..width {
        heads.push(__ch_read_str(r))
    }
    for i in 0..width {
        if __ch_read_str(r) != "String" {
            r.error = "unexpected DESCRIBE column type"
        }
    }
    let at_name = heads.index_of("name") ?? -1
    let at_type = heads.index_of("type") ?? -1
    let at_kind = heads.index_of("default_type") ?? -1
    var names: [str] = []
    var types: [str] = []
    var kinds: [str] = []
    while r.p < r.end && r.error.byte_len() == 0 {
        for i in 0..width {
            let v = __ch_read_str(r)
            if i == at_name {
                names.push(v)
            } else if i == at_type {
                types.push(v)
            } else if i == at_kind {
                kinds.push(v)
            }
        }
    }
    if r.error.byte_len() > 0 || at_name < 0 || at_type < 0 || at_kind < 0 || names.len() != types.len() || names.len() != kinds.len() {
        plan.error = "unexpected DESCRIBE result"
        return plan
    }
    let error = buf_new(64)
    for i in 0..cols.len() {
        let col = cols[i]
        let at = names.index_of(col) else {
            plan.error = "table has no column '" + col + "'"
            return plan
        }
        let kind = kinds[at]
        if kind == "MATERIALIZED" || kind == "ALIAS" {
            plan.error = "column '" + col + "' is " + kind + " and cannot be inserted"
            return plan
        }
        let src = __ch_type_of(srcs[i]) else {
            plan.error = "invalid RowBinary type header " + srcs[i]
            return plan
        }
        let dst = __ch_type_of(types[at]) else {
            plan.error = "column '" + col + "' has unsupported ClickHouse type " + types[at]
            return plan
        }
        let conv = __ch_conv_plan(col, src, dst, 0, error) else {
            plan.error = buf_str(error)
            return plan
        }
        plan.convs.push(__cast(conv))
        plan.types.push(types[at])
        if srcs[i] != types[at] {
            plan.same = false
        }
    }
    return plan
}

// Пакет под схему: заголовок с настоящими типами, затем строки. start — начало
// строк в body. Ошибку пишет в r.
fn __ch_transcode(r: __ChReader, cols: [str], plan: __ChInsertPlan) -> str {
    let b = buf_new(r.end - r.p + 4096)
    __ch_varint(b, cols.len())
    for name in cols {
        __ch_string(b, name)
    }
    for ty in plan.types {
        __ch_string(b, ty)
    }
    let n = plan.convs.len()
    let convs = __alloc(n * 8)
    for i in 0..n {
        store64(convs + i * 8, plan.convs[i])
    }
    while r.p < r.end && r.error.byte_len() == 0 {
        for i in 0..n {
            if !__ch_conv_value(r, b, __cast(load64(convs + i * 8))) {
                return ""
            }
        }
        if b.len > 134217728 {
            r.error = "RowBinary byte limit exceeded"
            return ""
        }
    }
    if r.error.byte_len() > 0 {
        return ""
    }
    return __str_new(b.data, b.len)
}

// ---- Кэш схем (на процесс) ----
// Ответ DESCRIBE по ключу SHA-256(адрес, база, таблица), копия — в своём mmap.
// Блок кэша (mmap, создаётся под замком постоянной памяти __store_rw + 48):
// [0] — мьютекс, [8] — следующее место для замены, [16] — счётчик поколений,
// [24] — сколько раз спрашивали DESCRIBE (для тестов), с 64 — записи по 64
// байта: ключ (32), адрес копии, длина, поколение.
// Под мьютексом нет выделений арены: паника не оставит его закрытым.
const CH_SCHEMAS = 60
const CH_SCHEMA_ENTRY = 64
var __ch_schemas: int

fn __ch_schema_block() -> int {
    if __ch_schemas == 0 {
        __store_rw_init()
        let lock = __store_rw + 48
        __mutex_lock(lock)
        if __ch_schemas == 0 {
            let p = syscall(SYS_MMAP, 0, 4096, 3, 0x22, -1, 0)
            if p > 0 {
                __ch_schemas = p
            }
        }
        __mutex_unlock(lock)
    }
    return __ch_schemas
}

fn __ch_schema_key(url: str, database: str, table: str) -> int {
    let text = url + "\n" + database + "\n" + table
    let key = __alloc(32)
    __hash(32, __str_ptr(text), text.byte_len(), key)
    return key
}

fn __ch_schema_find(blk: int, key: int) -> int {
    for i in 0..CH_SCHEMAS {
        let e = blk + 64 + i * CH_SCHEMA_ENTRY
        if load64(e + 32) != 0 && __memeq(e, key, 32) {
            return e
        }
    }
    return 0
}

fn __ch_pages(n: int) -> int {
    return (n + 4096) & ~4095
}

// Копия схемы в арене или "" — нет в кэше.
fn __ch_schema_get(key: int) -> str {
    let blk = __ch_schema_block()
    if blk == 0 {
        return ""
    }
    for attempt in 0..4 {
        __mutex_lock(blk)
        let e = __ch_schema_find(blk, key)
        var ptr = 0
        var len = 0
        var gen = 0
        if e != 0 {
            ptr = load64(e + 32)
            len = load64(e + 40)
            gen = load64(e + 48)
        }
        __mutex_unlock(blk)
        if ptr == 0 {
            return ""
        }
        // память — до мьютекса; под ним только копия той же записи
        let copy = __alloc(len + 1)
        __mutex_lock(blk)
        let same = load64(e + 32) == ptr && load64(e + 48) == gen
        if same {
            __memcpy(copy, ptr, len)
        }
        __mutex_unlock(blk)
        if same {
            return __str_new(copy, len)
        }
    }
    return ""
}

fn __ch_schema_put(key: int, data: str) {
    let blk = __ch_schema_block()
    if blk == 0 || data.byte_len() == 0 {
        return
    }
    let size = data.byte_len()
    let copy = syscall(SYS_MMAP, 0, __ch_pages(size), 3, 0x22, -1, 0)
    if copy < 0 {
        return
    }
    __memcpy(copy, __str_ptr(data), size)
    __mutex_lock(blk)
    var e = __ch_schema_find(blk, key)
    if e == 0 {
        for i in 0..CH_SCHEMAS {
            let f = blk + 64 + i * CH_SCHEMA_ENTRY
            if e == 0 && load64(f + 32) == 0 {
                e = f
            }
        }
    }
    if e == 0 {
        let slot = load64(blk + 8) % CH_SCHEMAS
        store64(blk + 8, slot + 1)
        e = blk + 64 + slot * CH_SCHEMA_ENTRY
    }
    let old = load64(e + 32)
    let old_len = load64(e + 40)
    let gen = load64(blk + 16) + 1
    store64(blk + 16, gen)
    __memcpy(e, key, 32)
    store64(e + 32, copy)
    store64(e + 40, size)
    store64(e + 48, gen)
    __mutex_unlock(blk)
    // старую копию больше никто не читает: копируют только под мьютексом,
    // сверив поколение
    if old != 0 {
        syscall(SYS_MUNMAP, old, __ch_pages(old_len))
    }
}

fn __ch_schema_drop(key: int) {
    let blk = __ch_schema_block()
    if blk == 0 {
        return
    }
    __mutex_lock(blk)
    let e = __ch_schema_find(blk, key)
    var old = 0
    var old_len = 0
    if e != 0 {
        old = load64(e + 32)
        old_len = load64(e + 40)
        store64(e + 32, 0)
        store64(e + 48, 0)
    }
    __mutex_unlock(blk)
    if old != 0 {
        syscall(SYS_MUNMAP, old, __ch_pages(old_len))
    }
}

// Сколько раз процесс спрашивал схему таблицы (DESCRIBE).
fn __ch_schema_misses() -> int {
    let blk = __ch_schema_block()
    if blk == 0 {
        return 0
    }
    return load64(blk + 24)
}

// DESCRIBE таблицы → в кэш; ответ — схема (тело) или ошибка.
fn __ch_describe(c: ChConfig, table: str, key: int, deadline: int) -> ChResult {
    let blk = __ch_schema_block()
    if blk != 0 {
        __xadd(blk + 24, 1)
    }
    let d = __ch_run(c, "DESCRIBE TABLE " + table, "", {}, false, false, deadline)
    if d.ok {
        __ch_schema_put(key, d.body)
    }
    return d
}

// Сервер отверг заголовок пакета до чтения строк — тип столбца сменился (Code
// 117 «while reading header») или столбца нет (Code 16): ничего не записано.
fn __ch_header_rejected(r: ChResult) -> bool {
    if r.ok || r.unknown_outcome || r.status < 400 {
        return false
    }
    return (r.error.starts_with("Code: 117.") && r.error.byte_find("(while reading header)") != none) || r.error.starts_with("Code: 16.")
}

// Вставка строк body с адреса rows под схему schema (ответ DESCRIBE). none —
// схема из кэша (fresh: false) устарела: столбца нет, значение не подошло к
// типу или сервер отверг заголовок — после ALTER. Тогда ch_insert спрашивает
// DESCRIBE и вставляет ещё раз: до сервера ничего не дошло или он ничего не
// записал. Со свежей схемой ошибка возвращается.
fn __ch_insert_with(c: ChConfig, table: str, target: str, cols: [str], quoted: [str], srcs: [str], body: str, rows: int, schema: str, fresh: bool, key: int, deadline: int) -> ChResult? {
    let plan = __ch_insert_plan(schema, cols, srcs)
    if plan.error != "" {
        if !fresh {
            return none
        }
        return ChResult { error: "ch_insert into " + table + ": " + plan.error }
    }
    var payload = body
    if !plan.same {
        let r = __ChReader { p: rows, end: __str_ptr(body) + body.byte_len() }
        payload = __ch_transcode(r, cols, plan)
        if r.error.byte_len() > 0 {
            if r.schema && !fresh {
                return none
            }
            return ChResult { error: "ch_insert into " + table + ": " + r.error }
        }
    }
    let query = "INSERT INTO " + target + " (" + quoted.join(",") + ") FORMAT RowBinaryWithNamesAndTypes\n"
    let result = __ch_run(c, query, payload, {}, true, false, deadline)
    if !result.ok && result.status >= 400 {
        // схема в кэше могла устареть: следующая вставка спросит DESCRIBE снова
        __ch_schema_drop(key)
        if !fresh && __ch_header_rejected(result) {
            return none
        }
    }
    return result
}

// Пакет ch_encode → в таблицу. Типы столбцов — из DESCRIBE (один раз на
// процесс для адреса, базы и таблицы; заново — когда пакет не подошёл к схеме
// из кэша или сервер отверг вставку), значения сужаются с проверкой диапазона:
// int → Int8..Int64, UInt8..UInt64, Date/Date32/DateTime/DateTime64(n) в сырых
// единицах; float → Float32, Decimal; bool → Bool, UInt8; str → String,
// FixedString(N), LowCardinality(String), Enum8/16, UUID; T? → Nullable(T); [T]
// → Array(T). Срок timeout_ms — на всю вставку вместе с DESCRIBE.
fn ch_insert(c: ChConfig, table: str, body: str) -> ChResult {
    let deadline = now_ms() + c.timeout_ms.max(1)
    let parts = table.split(".")
    if parts.len() == 0 || parts.len() > 2 {
        return ChResult { error: "invalid ClickHouse table" }
    }
    var names: [str] = []
    for p in parts {
        if !__ch_identifier(p) {
            return ChResult { error: "invalid ClickHouse table identifier" }
        }
        names.push("`" + p + "`")
    }
    var database = c.database
    if parts.len() == 2 {
        database = parts[0]
    }
    let r = __ChReader { p: __str_ptr(body), end: __str_ptr(body) + body.byte_len() }
    let count = __ch_read_varint(r)
    if r.error.byte_len() > 0 || count <= 0 || count > 1024 {
        return ChResult { error: "ch_insert requires a ch_encode RowBinaryWithNamesAndTypes body" }
    }
    var cols: [str] = []
    var quoted: [str] = []
    for i in 0..count {
        let col = __ch_read_str(r)
        if !__ch_identifier(col) || cols.contains(col) {
            return ChResult { error: "invalid or duplicate ClickHouse column identifier" }
        }
        cols.push(col)
        quoted.push("`" + col + "`")
    }
    var srcs: [str] = []
    for i in 0..count {
        let ty = __ch_read_str(r)
        if ty.byte_len() == 0 || ty.byte_len() > 4096 || r.error.byte_len() > 0 {
            return ChResult { error: "invalid RowBinary type header" }
        }
        srcs.push(ty)
    }
    let key = __ch_schema_key(c.url, database, parts[parts.len() - 1])
    let target = names.join(".")
    let cached = __ch_schema_get(key)
    if cached != "" {
        if let done = __ch_insert_with(c, table, target, cols, quoted, srcs, body, r.p, cached, false, key, deadline) {
            return done
        }
    }
    // схемы нет в кэше или таблицу изменили после того, как она туда попала
    let d = __ch_describe(c, target, key, deadline)
    if !d.ok {
        return d
    }
    return __ch_insert_with(c, table, target, cols, quoted, srcs, body, r.p, d.body, true, key, deadline) ?? ChResult { error: "ch_insert into " + table + ": the table schema changed during the insert" }
}

// Cancellation is explicit and requires KILL QUERY privileges. A cancelled
// INSERT may already have committed: cancellation is never a rollback promise.
fn ch_cancel(c: ChConfig, query_id: str) -> ChResult {
    return __ch_run(c, "KILL QUERY WHERE query_id = \{id:String} SYNC", "", {"id": query_id}, false, true, 0)
}
