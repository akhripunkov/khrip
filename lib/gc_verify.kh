// Проверки сборщика store (KHRIP_GC_VERIFY, docs/design/v0.13-store-gc.md
// §8.7): граф store от корней и куча после загрузки и после каждого запроса,
// задачи и теста, который держал store монопольно; владелец метаданных (I5),
// нули нового слота и яд освобождённого (0xDE) при выделении общим путём;
// дерево кучки страниц каждые 1024 операции; в каждой сборке — записи в
// начале, независимая разметка до уборки (ни один живой объект не уйдёт в
// уборку) и куча после неё. Файл подключается к программе со store, только если её собирают с
// KHRIP_GC_VERIFY в окружении, и к khc test (src/main.kh); иначе — заглушки
// lib/gc_noverify.kh, и кода проверок в программе нет.

// KHRIP_GC_VERIFY=1: проверки, и каждое выделение — общим путём (с проверками
// владельца и нулей); =fast: те же проверки, но быстрый путь выделения
// остаётся — так проверяется и он.
// KHRIP_GC_STRESS без KHRIP_GC_VERIFY — как KHRIP_GC_VERIFY=1.
fn __gc_verify_init() {
    if let v = env("KHRIP_GC_VERIFY") {
        __gc_verify = v == "1" || v == "fast"
        __gc_verify_slow = v == "1"
    } else if __gc_stress {
        __gc_verify = true
        __gc_verify_slow = true
    }
    // отказ памяти на hbuf передачи арены (tests/gc.sh, tests/run.sh):
    // запасной путь __pin_self_fallback; hbuf — каждый раз, hbuf2 — только
    // при росте hbuf, который уже есть (часть арены в нём)
    let f = env("KHRIP_GC_FAULT") ?? ""
    __gcv_hbuf_fault = 0
    if f == "hbuf" {
        __gcv_hbuf_fault = 1
    } else if f == "hbuf2" {
        __gcv_hbuf_fault = 2
    }
    __gc_slow_update()
}

var __gcv_hbuf_fault: int

fn __gc_hbuf_fault(cap: int) -> bool {
    return __gcv_hbuf_fault == 1 || (__gcv_hbuf_fault == 2 && cap > 0)
}

// KHRIP_GC_VERIFY: каждые 1024 операции — дерево против карты.
fn __ph_tick(ph: int) {
    if __gc_verify {
        let n = load64(ph + PH_OPS) + 1
        store64(ph + PH_OPS, n)
        if (n & 1023) == 0 {
            let e = __ph_check(ph)
            if e.byte_len() > 0 {
                __gc_fatal(e)
            }
        }
    }
}

// Дерево и граница занятых против карты free: "" или что не так.
fn __ph_check(ph: int) -> str {
    let t = load64(ph + PH_TREE)
    let fr = load64(ph + PH_FREE)
    let cap = load64(ph + PH_CAP)
    let nl = cap >> 6
    for j in 0..nl {
        let w = load64(fr + (j << 3))
        var pre = 64
        var suf = 64
        var best = 64
        if w != -1 {
            pre = __ctz(~w)
            suf = __clz(~w)
            best = __run_max(w)
        }
        let x = t + ((nl + j) << 4)
        if load64(x) != (pre | (suf << 32)) || load64(x + 8) != best {
            return "page heap: leaf {j} does not match the free map"
        }
    }
    // узлы — по уже проверенным детям
    var lo = nl >> 1
    var cs = 64
    while lo >= 1 {
        for i in lo..lo * 2 {
            let l = t + (i << 5)
            let lpre = load64(l) & 0xFFFFFFFF
            let lsuf = load64(l) >> 32
            let rpre = load64(l + 16) & 0xFFFFFFFF
            let rsuf = load64(l + 16) >> 32
            var pre = lpre
            if lpre == cs {
                pre = cs + rpre
            }
            var suf = rsuf
            if rsuf == cs {
                suf = cs + lsuf
            }
            var best = load64(l + 8)
            if load64(l + 24) > best {
                best = load64(l + 24)
            }
            if lsuf + rpre > best {
                best = lsuf + rpre
            }
            if load64(t + (i << 4)) != (pre | (suf << 32)) || load64(t + (i << 4) + 8) != best {
                return "page heap: node {i} does not match its children"
            }
        }
        lo = lo >> 1
        cs = cs * 2
    }
    // выше границы занятых — свободные страницы и те, чью память сейчас
    // возвращает сборщик (заняты, но с released, __ph_scav_take)
    let hw = load64(ph + PH_HW)
    if hw > cap {
        return "page heap: the high-water mark {hw} is above the capacity"
    }
    var p = hw
    while p < cap {
        let wi = p >> 6
        let m = __bits_mask(p & 63, 64)
        if ((load64(fr + (wi << 3)) | load64(load64(ph + PH_REL) + (wi << 3))) & m) != m {
            return "page heap: a page above the high-water mark {hw} is taken"
        }
        p = (wi + 1) << 6
    }
    if hw > 0 && __bits_any(fr, hw - 1, hw, true) {
        return "page heap: the high-water mark {hw} is above a free page"
    }
    return ""
}

// I5: метаданные кучи меняет только владелец мьютекса писателей — тот, кто
// держит store монопольно (запрос, задача, тест, загрузка).
fn __gc_check_owner() {
    if load64(__ctx() + CTX_STORE_HELD) != 1 || load64(__store_rw) == 0 {
        __gc_fatal("the store heap changed without the writers' lock (I5)")
    }
    __gc_check_slow()
}

// Пока идёт разметка, выделение — только общим путём: быстрый путь не ставит
// бит MARK, и новый объект ушёл бы в уборку живым. Разметку включает и
// выключает только __gc_set_marking.
fn __gc_check_slow() {
    if __gc_marking != 0 && !__gc_slow {
        __gc_fatal("marking is on, but allocation takes the fast path (set it with __gc_set_marking)")
    }
}

// Новый слот — нули: в свободную память никто не писал.
fn __gc_check_zero(p: int, n: int) {
    var i = 0
    while i < n {
        if load64(p + i) != 0 {
            __gc_fatal("a free slot at " + __gc_hex(p) + " was written")
        }
        i += 8
    }
}

// Новый слот в памяти, где уже были объекты (NEEDZERO): уборка залила
// освобождённые слоты ядом 0xDE, а память, где объектов не было, — нули.
// Другое слово — запись после освобождения или второй хозяин слота
// (потерянное обновление).
fn __gc_check_poison(p: int, n: int) {
    let poison = -0x2121212121212122
    var i = 0
    while i < n {
        let w = load64(p + i)
        if w != 0 && w != poison {
            __gc_fatal("a freed slot at " + __gc_hex(p) + " was written after it was freed (word at +{i})")
        }
        i += 8
    }
}

// Конец запроса, задачи или теста под исключительной блокировкой: граф и куча
// store снова проверяются (молча, если всё верно).
fn __gc_verify_release() {
    if __gc_verify && load64(__ctx() + CTX_STORE_HELD) == 1 {
        __gc_check_slow()
        __gc_verify_run("request", false)
    }
}

// Начало сборки (§7.2 п. 5, §8.7 п. 1) — на каждом исключительном взятии
// store (acquiring: так проверяется и время между сборками) и в начале каждой
// сборки: никто другой store сейчас не держит, и каждый контекст, который брал
// store в своей работе, держит указатели в store только через опубликованную
// запись (I3). self — запись взявшего (она уже отозвана) или собирающего
// контекста (опубликована на время сборки, или он со store закончил: тогда её
// не проверяют). Опубликованная запись — у контекста, который брал store, и
// она в списке своего потока (списки записанных потоков содержат ровно
// опубликованные записи); передачи арены вне разметки нет (I9), а во время
// разметки — только этой сборки, и под исключительной блокировкой никто не
// смотрит арену (ни GC, ни SELF).
fn __gc_verify_start(self: int) {
    __gc_verify_records(self, true)
}

fn __gc_verify_records(self: int, acquiring: bool) {
    __gc_vstarts += 1
    var linked = 0
    var r = load64(__gc_reg)
    while r != 0 {
        let rec: __Pin = __cast(r)
        if r == self {
            if acquiring && rec.linked {
                __gc_fatal("the record of the context that took store is still published (I4)")
            }
        } else {
            if rec.touched && !rec.linked {
                __gc_fatal("a context released store in the middle of its work without publishing its record (I3)")
            }
            if rec.linked && !rec.touched {
                __gc_fatal("a published record of a context that did not take store (I4)")
            }
        }
        if rec.linked {
            linked += 1
        }
        let a = rec.ast
        let st = a & 7
        if st != PIN_IDLE {
            if __gc_phase != GC_PH_MARK || (a >> 3) != __gc_cycle_no {
                __gc_fatal("an arena hand-off outside marking (I9)")
            }
            if st == PIN_GC || st == PIN_SELF || st > PIN_DONE {
                __gc_fatal("an arena is being scanned under the exclusive lock (I9)")
            }
        }
        r = rec.all
    }
    var listed = 0
    let nt = load64(__gc_reg + 8)
    for i in 0..nt {
        let c = load64(__gc_reg + 16 + i * 8)
        var p = 0
        if c != 0 {
            p = load64(c + CTX_PINLIST)
        }
        var prev = 0
        while p != 0 {
            let rec: __Pin = __cast(p)
            if !rec.linked || rec.prev != prev {
                __gc_fatal("a thread's list of published records is broken (I4)")
            }
            listed += 1
            prev = p
            p = rec.next
        }
    }
    if listed != linked {
        __gc_fatal("{linked} records are published, but {listed} are in the threads' lists (I4)")
    }
    __gc_vlinked += linked
}

// Начало сборки (§8.7 п. 2), под исключительной блокировкой: всё, что
// достижимо сейчас, — снимок (бит на каждые 16 байт STORE ниже __gc_hwb, как
// MARK). Независимо от разметки: корни, слова записей потоков (по реестру
// всех записей, без массива записей) и слова их арен [lo, hi) — прямо из
// записей, без захвата, кусков арен и hbuf, — и всё, до чего от них доходят
// биты PTRB. Конец разметки проверяет, что помечен каждый объект снимка: SATB
// обещает ровно это, и потерянный разметкой (слово записи, кусок арены,
// барьер, после которого объект держит только ожидающий контекст) находится,
// даже если он больше ни от чего не достижим.
var __gcv_snap: int
var __gcv_snapsz: int

fn __gc_verify_snap() {
    __gcv_snapsz = ((__gc_hwb >> 10) + 1) * 8
    __gcv_snap = syscall(SYS_MMAP, 0, __gcv_snapsz, 3, 0x4022, -1, 0)
    let st = syscall(SYS_MMAP, 0, 64, 3, 0x22, -1, 0)
    if __gcv_snap < 0 || st < 0 {
        __gcv_snap = 0
        eprint("khrip: gc verify (start): skipped, no memory for the snapshot")
        return
    }
    store64(st, __gcv_map(st, 1024 * 16))
    store64(st + 16, 1024)
    store64(st + 48, -1)
    let roots = __gc_roots()
    for i in 0..load64(roots) {
        __gcv_snap_word(st, load64(load64(roots + 8 + i * 16)))
    }
    var r = load64(__gc_reg)
    while r != 0 {
        let rec: __Pin = __cast(r)
        if rec.linked {
            for j in 0..rec.len {
                __gcv_snap_word(st, load64(rec.buf + j * 8))
            }
            var p = rec.lo
            if rec.hi - rec.lo >= STRC_SIZE {
                p = rec.lo + STRC_SIZE
            }
            while p < rec.hi {
                let w = load64(p)
                if (w >> 38) == 0x40 {
                    __gcv_snap_word(st, w)
                }
                p += 8
            }
        }
        r = rec.all
    }
    while load64(st + 8) > 0 && load64(st + 56) == 0 {
        let k = load64(st + 8) - 1
        store64(st + 8, k)
        let o = load64(load64(st) + k * 16)
        if ((load64(__gc_span_of(o) + S_INFO) >> 48) & F_NOSCAN) == 0 {
            let e = o + __gc_obj_size(o)
            var q = o
            while q < e {
                if ((load64(((q >> 9) << 3) + GC_PTRB_P) >> ((q >> 3) & 63)) & 1) != 0 {
                    __gcv_snap_word(st, load64(q))
                }
                q += 8
            }
        }
    }
    if load64(st + 56) != 0 {
        syscall(SYS_MUNMAP, __gcv_snap, __gcv_snapsz)
        __gcv_snap = 0
        eprint("khrip: gc verify (start): skipped, no memory for the snapshot")
    }
    if load64(st) != 0 {
        syscall(SYS_MUNMAP, load64(st), load64(st + 16) * 16)
    }
    syscall(SYS_MUNMAP, st, 64)
}

// Слово снимка: объект, внутри которого оно лежит, — в снимок; первая встреча
// — в стек.
fn __gcv_snap_word(st: int, w: int) {
    let o = __gc_obj_of(w)
    if o == 0 {
        return
    }
    let g = (o - STORE_REGION) >> 4
    let a = __gcv_snap + ((g >> 6) << 3)
    let b = 1 << (g & 63)
    if (load64(a) & b) == 0 {
        store64(a, load64(a) | b)
        __gcv_push(st, o, 0)
    }
}

// Конец разметки, до уборки: помечен каждый объект снимка начала (иначе
// уборка освободила бы объект, который был достижим в начале сборки), а затем
// — граф от корней по типам (__gc_verify_run: каждая ссылка, ещё и помечена ли
// её цель; так находится и объект, выделенный во время разметки без бита MARK)
// вместе с кучей (до уборки в ней и мусор, и __heap_live его считает).
// Записи, опубликованные во время разметки, не проверяются: их неточные слова
// стека и арены бывают устаревшими (указывают на мусор начала сборки).
var __gcv_marks: bool

fn __gc_verify_marks() {
    if __gcv_snap != 0 {
        for k in 0..__gcv_snapsz >> 3 {
            var lost = load64(__gcv_snap + k * 8)
            if lost != 0 {
                lost = lost & ~load64(GC_MARK + k * 8)
            }
            if lost != 0 {
                let o = STORE_REGION + (((k << 6) + __ctz(lost)) << 4)
                __gc_fatal("an object at " + __gc_hex(o) + " reachable at the start of the cycle is not marked (the marker lost it, or a barrier is missing)")
            }
        }
        syscall(SYS_MUNMAP, __gcv_snap, __gcv_snapsz)
        __gcv_snap = 0
    }
    __gcv_marks = true
    __gc_verify_run("gc", false)
    __gcv_marks = false
}

// После уборки (§8.7): уборка оставила ровно живое (помеченное разметкой и
// выделенное чёрным за время разметки, kept — байт оставленных объектов); куча
// согласована — учёт байтов, свободные слоты без битов PTRB, записи спанов,
// кучка страниц.
fn __gc_verify_swept(kept: int) {
    if kept != __heap_marked {
        __gc_fatal("the sweep kept {kept} bytes, but marking counted {__heap_marked} ({__gc_black_bytes} of them allocated black)")
    }
    let st = syscall(SYS_MMAP, 0, 64, 3, 0x22, -1, 0)
    if st < 0 {
        return
    }
    store64(st + 48, -1)
    __gc_verify_heap(st, "sweep")
    syscall(SYS_MUNMAP, st, 64)
}

// Проверка графа и кучи со строкой об итоге.
fn __gc_verify_graph(when: str) {
    __gc_verify_run(when, true)
}

// Обход store от корней (__gc_roots(): [n, (адрес глобальной, описание её
// типа) × n], src/api.kh, gc_root_table) по описаниям типов: каждый указатель
// графа — 0, адрес в DATA или в выделенном объекте STORE (I1: ни арены, ни
// обычной памяти потока, ни свободных слотов); ссылка на объект — его начало
// (у варианта — начало + 8); у каждого слова объекта store, где лежит ссылка
// на другой объект store, стоит бит PTRB, а спан объекта — не NOSCAN (иначе
// сборщик не увидел бы ссылку). Объекты в DATA — литералы, варианты без полей,
// ячейки значений по умолчанию — не обходятся: их не освобождают и не
// копируют. Без рекурсии (список в миллион звеньев — не миллион кадров): стек
// пар (значение, описание) и множество пройденных адресов (общие объекты и
// циклы обходятся один раз) — в своих кусках mmap, они возвращаются системе в
// конце; память store, арены и потока проверка не меняет (кроме сообщений).
// Перед обходом — куча (__gc_verify_heap).
//
// Состояние (кусок mmap): [0] стек, [8] пар в нём, [16] его размер в парах,
// [24] множество (открытая адресация, 0 — пусто), [32] адресов в нём, [40] его
// размер, [48] номер корня, от которого идёт обход (−1 — проверка кучи), [56] 1,
// если системе не хватило памяти на стек или множество: тогда обход
// прекращается с предупреждением — проверка не валит программу, которая сама
// пережила нехватку памяти (ответ 500 после отказа памяти store).
fn __gc_verify_run(when: str, loud: bool) {
    let roots = __gc_roots()
    let n = load64(roots)
    let st = syscall(SYS_MMAP, 0, 64, 3, 0x22, -1, 0)
    if st < 0 {
        eprint("khrip: gc verify ({when}): skipped, no memory for the check")
        return
    }
    store64(st, __gcv_map(st, 1024 * 16))
    store64(st + 16, 1024)
    store64(st + 24, __gcv_map(st, 4096 * 8))
    store64(st + 40, 4096)
    store64(st + 48, -1)
    __gc_verify_heap(st, when)
    for i in 0..n {
        if load64(st + 56) != 0 {
            break
        }
        store64(st + 48, i)
        __gcv_push(st, load64(load64(roots + 8 + i * 16)), load64(roots + 16 + i * 16))
        while load64(st + 8) > 0 && load64(st + 56) == 0 {
            let k = load64(st + 8) - 1
            store64(st + 8, k)
            let e = load64(st) + k * 16
            __gcv_visit(st, when, load64(e), load64(e + 8))
        }
    }
    let objs = load64(st + 32)
    let short = load64(st + 56) != 0
    if load64(st) != 0 {
        syscall(SYS_MUNMAP, load64(st), load64(st + 16) * 16)
    }
    if load64(st + 24) != 0 {
        syscall(SYS_MUNMAP, load64(st + 24), load64(st + 40) * 8)
    }
    syscall(SYS_MUNMAP, st, 64)
    if short {
        eprint("khrip: gc verify ({when}): stopped after {objs} objects, no memory for the walk")
    } else if loud {
        eprint("khrip: gc verify ({when}): {n} roots, {objs} objects in STORE, every pointer in STORE or DATA")
    }
}

// Память обхода: кусок mmap или 0, если система не дала, — тогда обход
// прекращается ([56] состояния).
fn __gcv_map(st: int, size: int) -> int {
    let p = syscall(SYS_MMAP, 0, size, 3, 0x22, -1, 0)
    if p < 0 {
        store64(st + 56, 1)
        return 0
    }
    return p
}

// Куча: дерево кучки страниц; у каждой занятой страницы — спан, записи спанов
// согласованы с картой страниц и таблицей классов; биты START — только в
// началах слотов; у свободных слотов и спанов NOSCAN биты PTRB — нули; сумма
// размеров выделенных объектов — __heap_live. Пока идёт уборка, объект спана,
// который она ещё не прошла, жив, только если он помечен (остальные она
// освободит); бит MARK вне разметки — только у объектов (START) таких спанов.
fn __gc_verify_heap(st: int, when: str) {
    __gc_check_slow()
    let ph = __gc_ph
    let e = __ph_check(ph)
    if e.byte_len() > 0 {
        __gcv_fail(st, when, e)
    }
    let fr = load64(ph + PH_FREE)
    let hw = load64(ph + PH_HW)
    var live = 0
    var pg = 0
    let rl = load64(ph + PH_REL)
    while pg < hw {
        let pm = load32(GC_PAGEMAP + (pg << 2))
        // свободная страница или та, чью память сейчас возвращает сборщик
        if (((load64(fr + ((pg >> 6) << 3)) | load64(rl + ((pg >> 6) << 3))) >> (pg & 63)) & 1) != 0 {
            if pm != 0 {
                __gcv_fail(st, when, "free page {pg} belongs to a span")
            }
            pg += 1
            continue
        }
        if pm != pg + 1 {
            __gcv_fail(st, when, "page {pg} is taken but does not start a span")
        }
        live += __gcv_span(st, when, pg)
        let np = load64(GC_SPANS + (pg << 6) + S_INFO) & 0xFFFFFFFF
        pg += np
    }
    if live != __heap_live {
        __gcv_fail(st, when, "objects take {live} bytes, but the heap counts {__heap_live}")
    }
}

// Спан с первой страницей pg → байт в его выделенных объектах.
fn __gcv_span(st: int, when: str, pg: int) -> int {
    let s = GC_SPANS + (pg << 6)
    let base = STORE_REGION + (pg << GC_PAGE_SHIFT)
    let info = load64(s + S_INFO)
    let np = info & 0xFFFFFFFF
    let sc = (info >> 32) & 0xFFFF
    let fl = info >> 48
    let fr = load64(__gc_ph + PH_FREE)
    if load64(s + S_BASE) != base || (fl & F_INUSE) == 0 || np < 1 || pg + np > load64(__gc_ph + PH_HW) {
        __gcv_fail(st, when, "span at page {pg}: a broken record")
    }
    for i in 1..np {
        if load32(GC_PAGEMAP + ((pg + i) << 2)) != pg + 1 || __bits_any(fr, pg + i, pg + i + 1, true) {
            __gcv_fail(st, when, "span at page {pg}: page {pg + i} is not its own")
        }
    }
    // все биты START спана: слова [g0, g0 + np · 8); пока идёт уборка, спан
    // ещё не убран (unswept) — живы только помеченные; вне разметки бит MARK —
    // только у объектов неубранного спана
    let g0 = (base - STORE_REGION) >> 4
    let unswept = __gc_phase == GC_PH_SWEEP && load64(s + S_SWEEPGEN) != __gc_sweepgen
    var bits = 0
    for j in 0..np * 8 {
        let sw = load64(GC_START + ((g0 >> 6) << 3) + (j << 3))
        let mw = load64(GC_MARK + ((g0 >> 6) << 3) + (j << 3))
        bits += __popcount(sw)
        if (mw & ~sw) != 0 || (mw != 0 && !unswept && __gc_phase != GC_PH_MARK) {
            __gcv_fail(st, when, "span at page {pg}: a mark bit on no object, or outside marking in a swept span")
        }
    }
    let noscan = (fl & F_NOSCAN) != 0
    if noscan && __bits_any(GC_PTRB, (base - STORE_REGION) >> 3, ((base - STORE_REGION) >> 3) + np * 1024, true) {
        __gcv_fail(st, when, "span at page {pg}: NOSCAN, but pointer bits are set")
    }
    if (fl & F_LARGE) != 0 {
        if sc != 0 || load64(s + S_SIZE) > np << GC_PAGE_SHIFT || load64(s + S_SIZE) == 0 || (load64(s + S_SIZE) & (GC_PAGE - 1)) != 0 || load64(s + S_MAGIC) != 1 << 32 || load64(s + S_FAST) != 0 || bits > 1 || (bits == 1 && !__gc_bit(GC_START, base)) {
            __gcv_fail(st, when, "large span at page {pg}: a broken record")
        }
        if unswept && !__gc_bit(GC_MARK, base) {
            return 0
        }
        // объект — его страницы (S_SIZE), запас за ним в живое не входит
        return bits * load64(s + S_SIZE)
    }
    let c = sc >> 1
    let es = load64(s + S_SIZE)
    let ne = load64(s + S_MAGIC) >> 32
    let lim = base + ne * es
    let fi = load64(s + S_FREE)
    let fast = load64(s + S_FAST)
    if c < 1 || c > GC_CLASSES || es != load64(__gc_tab + 1024 + c * 8) || np != load64(__gc_tab + 2048 + c * 8) || ne != (np << GC_PAGE_SHIFT) / es || lim != base + ne * es || fi < base || fi > lim || (fi - base) % es != 0 || noscan != ((sc & 1) != 0) || (fast != 0 && (fast != lim || (fl & F_NEEDZERO) != 0)) {
        __gcv_fail(st, when, "span at page {pg}: a broken record")
    }
    var objs = 0
    var live = 0
    for i in 0..ne {
        let p = base + i * es
        if __gc_bit(GC_START, p) {
            objs += 1
            if !unswept || __gc_bit(GC_MARK, p) {
                live += 1
            }
        } else if !noscan && __bits_any(GC_PTRB, (p - STORE_REGION) >> 3, ((p - STORE_REGION) >> 3) + (es >> 3), true) {
            __gcv_fail(st, when, "a free slot at " + __gc_hex(p) + " has pointer bits")
        }
    }
    if objs != bits {
        __gcv_fail(st, when, "span at page {pg}: START bits outside the starts of slots")
    }
    return live * es
}

// Значение v с описанием d: проверить его адрес, а у объекта в store — и его
// внутренние указатели, ссылки — в стек. У каждого слова объекта, где по типу
// лежит ссылка, — бит PTRB, что бы в нём ни лежало сейчас (none, свободное
// место списка или словаря): ссылку туда запишут потом, не трогая PTRB.
fn __gcv_visit(st: int, when: str, v: int, d: int) {
    var t = d
    // T? ссылки — то же слово, что и сама ссылка (none — 0)
    while load64(t) == D_OPT && !__is_scalar(load64(t + 8)) {
        t = load64(t + 8)
    }
    let k = load64(t)
    if k == D_INT || k == D_BOOL || k == D_FLOAT || v == 0 {
        return
    }
    __gcv_ptr(st, when, v, "a value", true)
    if __in_data(v) || !__gcv_first(st, v) {
        return
    }
    if k == D_STR {
        let len = load64(v + 8)
        if len > 0 {
            let p = load64(v)
            __gcv_ptr(st, when, p, "string bytes", false)
            __gcv_word(st, when, v)
            if __in_store(p) && __gc_obj_of(p) + __gc_obj_size(__gc_obj_of(p)) < p + len {
                __gcv_fail(st, when, "string bytes at " + __gc_hex(p) + " run past their object")
            }
        }
        return
    }
    if k == D_LIST {
        let data = load64(v)
        __gcv_ptr(st, when, data, "list data", true)
        __gcv_slot(st, when, v)
        let ed = load64(t + 8)
        let n = load64(v + 8)
        let cap = __list_cap(v)
        if __in_store(v) {
            // список store: заголовок — слот 16 байт, массив [bool] — с 8-го
            // байта своего слота, массив слов — с начала (lib/core.kh)
            let es = __list_es(v)
            let o = __gc_obj_of(data)
            if __gc_obj_size(__gc_obj_of(v)) != 16 || (es == 1) != (load64(ed) == D_BOOL) || (es == 1 && data != o + 8) || (es == 8 && data != o) {
                __gcv_fail(st, when, "a store list at " + __gc_hex(v) + " has a broken header or data at " + __gc_hex(data))
            }
        }
        if n > cap {
            __gcv_fail(st, when, "a list at " + __gc_hex(v) + " has " + n.to_str() + " elements for room of " + cap.to_str())
        }
        if !__is_scalar(ed) {
            for i in 0..n {
                __gcv_child(st, when, data + i * 8, ed)
            }
            for i in n..cap {
                __gcv_slot(st, when, data + i * 8)
            }
        }
        return
    }
    if k == D_MAP {
        // записи по порядку: ключи [0], значения [16], признаки [24] — массивы
        // прямо в заголовке, таблица [32]; записей и ёмкость — u32 в слове 48
        let keys = load64(v)
        let vals = load64(v + 16)
        let alive = load64(v + 24)
        __gcv_ptr(st, when, keys, "map keys", true)
        __gcv_ptr(st, when, vals, "map values", true)
        __gcv_ptr(st, when, alive, "map entries", true)
        __gcv_ptr(st, when, load64(v + 32), "map slots", true)
        __gcv_slot(st, when, v)
        __gcv_slot(st, when, v + 16)
        __gcv_slot(st, when, v + 24)
        __gcv_slot(st, when, v + 32)
        let kd = load64(t + 8)
        let vd = load64(t + 16)
        let fl = load32(v + 44)
        let es = __map_esf(fl)
        if ((fl & MAP_STR) != 0) != (load64(kd) == D_STR) || ((fl & MAP_BYTES) != 0) != (load64(vd) == D_BOOL) {
            __gcv_fail(st, when, "a map at " + __gc_hex(v) + " has flags " + fl.to_str() + " that do not match its type")
        }
        let n = load32(v + 48)
        let cap = load32(v + 52)
        if n > cap || n > __map_limit(v) {
            __gcv_fail(st, when, "a map at " + __gc_hex(v) + " has " + n.to_str() + " entries for room of " + cap.to_str())
        }
        // массивы вмещают ёмкость: ключи и значения — в своих объектах
        __gcv_room(st, when, keys, cap * 8, "map keys")
        __gcv_room(st, when, vals, cap * es, "map values")
        __gcv_room(st, when, alive, cap, "map entries")
        __gcv_room(st, when, load64(v + 32), (load32(v + 40) + 1) * 4, "map slots")
        // свободное место массивов: туда запишут ключи и значения-ссылки
        if !__is_scalar(kd) {
            for i in n..cap {
                __gcv_slot(st, when, keys + i * 8)
            }
        }
        if !__is_scalar(vd) {
            for i in n..cap {
                __gcv_slot(st, when, vals + i * 8)
            }
        }
        var live = 0
        for i in 0..n {
            if load8(alive + i) != 0 {
                live += 1
                if !__is_scalar(kd) {
                    __gcv_child(st, when, keys + i * 8, kd)
                }
                if !__is_scalar(vd) {
                    __gcv_child(st, when, vals + i * 8, vd)
                }
            }
        }
        if live != load64(v + 8) {
            __gcv_fail(st, when, "a map at " + __gc_hex(v) + " counts " + load64(v + 8).to_str() + " live entries, its entries say " + live.to_str())
        }
        // рост по частям (lib/core.kh): новые массивы (на c2 записей, слово 88)
        // и таблица в G (0 — остаётся старая), записи [0, w) уже перенесены;
        // пока новая память не готова, записей нет, а её свободное место без
        // PTRB
        __gcv_slot(st, when, v + 56)
        let g = load64(v + 56)
        if g != 0 {
            __gcv_ptr(st, when, g, "map growth", true)
            for j in 0..4 {
                if j < 3 || load64(g + j * 8) != 0 {
                    __gcv_ptr(st, when, load64(g + j * 8), "map growth arrays", true)
                }
                __gcv_slot(st, when, g + j * 8)
            }
            let w = load64(g + 48)
            let c2 = load64(g + 88)
            let ready = load64(g + 64) == 0
            if w > 0 && !ready {
                __gcv_fail(st, when, "a growing map at " + __gc_hex(v) + " moved entries before its new arrays were ready")
            }
            if w > c2 || load64(g + 40) > n {
                __gcv_fail(st, when, "a growing map at " + __gc_hex(v) + " has a broken growth state")
            }
            if ready {
                for i in w..c2 {
                    if !__is_scalar(kd) {
                        __gcv_slot(st, when, load64(g) + i * 8)
                    }
                    if !__is_scalar(vd) {
                        __gcv_slot(st, when, load64(g + 8) + i * 8)
                    }
                }
            }
            for i in 0..w {
                if load8(load64(g + 16) + i) != 0 {
                    if !__is_scalar(kd) {
                        __gcv_child(st, when, load64(g) + i * 8, kd)
                    }
                    if !__is_scalar(vd) {
                        __gcv_child(st, when, load64(g + 8) + i * 8, vd)
                    }
                }
            }
        }
        return
    }
    var sd = t
    if k == D_SUM {
        let e = __variant_entry(t, v)
        if e == 0 {
            __gcv_fail(st, when, "a variant with an unknown tag at " + __gc_hex(v))
        }
        sd = load64(e + 8)
    } else if k != D_STRUCT {
        // ячейка int?, bool? или float?
        return
    }
    let nf = load64(sd + 8)
    for i in 0..nf {
        let fd = __field_desc(sd, i)
        if !__is_scalar(fd) {
            __gcv_child(st, when, v + i * 8, fd)
        }
    }
}

// Массив p (начало объекта store) вмещает n байт.
fn __gcv_room(st: int, when: str, p: int, n: int, what: str) {
    if !__in_store(p) {
        return
    }
    let o = __gc_obj_of(p)
    if o != 0 && o + __gc_obj_size(o) < p + n {
        __gcv_fail(st, when, what + " at " + __gc_hex(p) + " is shorter than " + n.to_str() + " bytes")
    }
}

// Ссылка в слове slot объекта (описание d): бит PTRB слова, затем — в стек.
fn __gcv_child(st: int, when: str, slot: int, d: int) {
    __gcv_slot(st, when, slot)
    __gcv_push(st, load64(slot), d)
}

// Слово slot объекта store, где по типу лежит ссылка: у него бит PTRB, а спан
// объекта — не NOSCAN, что бы в слове ни лежало.
fn __gcv_slot(st: int, when: str, slot: int) {
    if !__in_store(slot) {
        return
    }
    if (((load64(__gc_span_of(slot) + S_INFO) >> 48) & F_NOSCAN) != 0) || ((load64(((slot >> 9) << 3) + GC_PTRB_P) >> ((slot >> 3) & 63)) & 1) == 0 {
        __gcv_fail(st, when, "a reference slot without its pointer bit at " + __gc_hex(slot))
    }
}

// Слово slot объекта store ссылается на другой объект store: у слова есть бит
// PTRB, а спан объекта — не NOSCAN (ссылка на свой же объект — байты строки в
// её заголовке — не нужна сборщику). Так проверяется заголовок строки: его
// байты бывают и в том же объекте.
fn __gcv_word(st: int, when: str, slot: int) {
    let v = load64(slot)
    if !__in_store(slot) || !__in_store(v) {
        return
    }
    let so = __gc_obj_of(slot)
    if so != 0 && so == __gc_obj_of(v) {
        return
    }
    if (((load64(__gc_span_of(slot) + S_INFO) >> 48) & F_NOSCAN) != 0) || ((load64(GC_PTRB + (((slot - STORE_REGION) >> 9) << 3)) >> (((slot - STORE_REGION) >> 3) & 63)) & 1) == 0 {
        __gcv_fail(st, when, "a store pointer without its pointer bit at " + __gc_hex(slot))
    }
}

// Указатель p — в DATA или в выделенном объекте STORE; exact — на его начало
// (у варианта — на начало + 8).
fn __gcv_ptr(st: int, when: str, p: int, what: str, exact: bool) {
    if __in_data(p) {
        return
    }
    if !__in_store(p) {
        __gcv_fail(st, when, what + " at " + __gc_hex(p) + ", outside STORE and DATA")
    }
    let o = __gc_obj_of(p)
    if o == 0 {
        __gcv_fail(st, when, what + " at " + __gc_hex(p) + ", outside the objects of STORE (or unmarked in a span the sweep has not reached)")
    }
    if exact && p != o && p != o + 8 {
        __gcv_fail(st, when, what + " at " + __gc_hex(p) + ", inside the object at " + __gc_hex(o))
    }
    if __gcv_marks && !__gc_bit(GC_MARK, o) {
        __gcv_fail(st, when, what + " at " + __gc_hex(p) + ", live but not marked")
    }
}

fn __gcv_fail(st: int, when: str, what: str) {
    let i = load64(st + 48)
    if i < 0 {
        eprint("khrip: gc verify ({when}): the store heap: {what}")
    } else {
        let d = load64(__gc_roots() + 16 + i * 16)
        eprint("khrip: gc verify ({when}): root {i} ({__desc_name(d)}) reaches {what}")
    }
    exit(101)
}

fn __gc_hex(x: int) -> str {
    let digits = "0123456789abcdef"
    var r = ""
    var sh = 60
    while sh >= 0 {
        let h = (x >> sh) & 15
        if h != 0 || r.byte_len() > 0 || sh == 0 {
            r += digits.byte_slice(h, h + 1)
        }
        sh -= 4
    }
    return "0x" + r
}

fn __gcv_push(st: int, v: int, d: int) {
    let n = load64(st + 8)
    let cap = load64(st + 16)
    if load64(st + 56) != 0 {
        return
    }
    if n == cap {
        let s = __gcv_map(st, cap * 2 * 16)
        if s == 0 {
            return
        }
        __memcpy(s, load64(st), n * 16)
        syscall(SYS_MUNMAP, load64(st), cap * 16)
        store64(st, s)
        store64(st + 16, cap * 2)
    }
    let e = load64(st) + n * 16
    store64(e, v)
    store64(e + 8, d)
    store64(st + 8, n + 1)
}

// Первая встреча с адресом p: true и p — в множестве; false — уже был.
fn __gcv_first(st: int, p: int) -> bool {
    var cap = load64(st + 40)
    if load64(st + 56) != 0 {
        return false
    }
    if (load64(st + 32) + 1) * 2 > cap {
        // множество вдвое больше
        let old = load64(st + 24)
        let t = __gcv_map(st, cap * 2 * 8)
        if t == 0 {
            return false
        }
        for i in 0..cap {
            let k = load64(old + i * 8)
            if k != 0 {
                __gcv_place(t, cap * 2, k)
            }
        }
        syscall(SYS_MUNMAP, old, cap * 8)
        cap *= 2
        store64(st + 24, t)
        store64(st + 40, cap)
    }
    let t = load64(st + 24)
    var i = __addr_hash(p) & (cap - 1)
    while true {
        let k = load64(t + i * 8)
        if k == p {
            return false
        }
        if k == 0 {
            store64(t + i * 8, p)
            store64(st + 32, load64(st + 32) + 1)
            return true
        }
        i = (i + 1) & (cap - 1)
    }
    return false
}

fn __gcv_place(t: int, cap: int, p: int) {
    var i = __addr_hash(p) & (cap - 1)
    while load64(t + i * 8) != 0 {
        i = (i + 1) & (cap - 1)
    }
    store64(t + i * 8, p)
}

// KHRIP_GC_STRESS без потока сборщика (khc test): шаг сборки вместо сборки
// целиком — в точке внутри работы (жёсткий предел; self — запись контекста,
// он держит store исключительно) и в окне (self = 0: запись уже опубликована,
// блокировку сборщика взял вызывающий). Нет сборки — начать (в точке внутри
// работы контекст публикует себя на время начала и, отзывая запись, сам
// передаёт свою арену); идёт разметка — GC_STRESS_WORK единиц, а кончилась —
// её конец; идёт уборка — GC_STRESS_WORK единиц уборки. Так разметка и уборка
// идут, пока тесты меняют store и выделяют: барьеры, правило частичного
// массива, передача арен и выделение во время уборки работают на всём наборе.
fn __gc_stress_step(self: int) -> bool {
    __gc_busy = true
    if __gc_phase == GC_PH_IDLE {
        if self != 0 {
            __pin_publish(self)
        }
        __gc_begin_cycle(self, GC_WHY_STRESS)
        if self != 0 {
            __pin_withdraw(__cast(self))
        }
    } else if __gc_phase == GC_PH_MARK {
        if __gc_mark(0, GC_STRESS_WORK, false) {
            let t0 = __gc_now_us()
            __gc_terminate_try()
            __gc_term_stats(t0)
        }
    } else {
        __gc_st_sweeps += 1
        if __gc_sweep(0, GC_STRESS_WORK) {
            if !__gc_has_thread {
                __gc_scavenge(false, true, __gc_runs)
            }
            __gc_report()
        }
    }
    __gc_busy = false
    return true
}
