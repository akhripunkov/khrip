// Ядро стандартной библиотеки Khrip: память, строки, списки, словари, вывод.
// Подключается к каждой программе автоматически.
//
// Представление значений (одно машинное слово на значение):
//   int, bool    — само число;
//   str          — адрес заголовка {ptr, len}; строки неизменяемы;
//   [T]          — адрес заголовка {data, len, cap}, data — массив слов;
//   map[K, V]    — адрес заголовка словаря (см. ниже);
//   структура    — адрес полей, по 8 байт на поле;
//   T?           — для ссылочных типов 0 значит none; int? и bool? — адрес ячейки.
//
// Функции с префиксом __ — внутренние: их вызывает код, который генерирует
// компилятор. Методы встроенных типов — функции __str_<имя>, __list_<имя>,
// __map_<имя>, __int_<имя>: вызов s.contains(x) — это __str_contains(s, x).
// T, K и V в сигнатурах — тип элемента, ключа и значения получателя.

const SYS_READ = 0
const SYS_WRITE = 1
const SYS_OPEN = 2
const SYS_CLOSE = 3
const SYS_MMAP = 9
const SYS_MUNMAP = 11
const SYS_EXIT = 60
const SYS_EXIT_GROUP = 231

const STDOUT = 1
const STDERR = 2

// ---- Контекст потока ----
// Первое слово контекста — указатель на него самого: компилятор читает текущий
// контекст как fs:[0]. Остальные поля — состояние выделителя памяти и рантайма.

const CTX_SELF = 0
// текущий выделитель: следующий свободный байт и конец доступной памяти.
// Правило I1: байты под заголовком строки, до которой можно дойти, не меняются.
// Память, где лежали байты строк, снова идёт в дело только при обнулении арены в
// __arena_end (кэш строк умирает вместе с ней), после отката CTX_PTR в __call
// (за ним — __strc_clear) и в сборке мусора store (она меняет __store_epoch).
// Подмена CTX_PTR на свежую память и возврат (x509.kh, db.kh) — не откат. Новый
// откат CTX_PTR назад обязан вызвать __strc_clear(): кэш строк (lib/text.kh)
// узнаёт строку по адресу и длине байтов.
const CTX_PTR = 8
const CTX_END = 16
// обычная память потока, пока выделение идёт из арены запроса
const CTX_SAVE_PTR = 24
const CTX_SAVE_END = 32
// арена потока: начало и конец подключённой части (0 — арены нет)
const CTX_ARENA = 40
const CTX_ARENA_END = 48
// арена (или обычная память), пока выделение идёт из кучи store (0 — не идёт;
// CTX_PTR и CTX_END в это время — нули, и каждое __alloc уходит в __alloc_slow,
// а оттуда — в __salloc, lib/gc.kh)
const CTX_PSAVE_PTR = 56
const CTX_PSAVE_END = 64
// поток держит блокировку store
const CTX_STORE_HELD = 72
// состояние HTTP-сервера потока
const CTX_WORKER = 80
// куда вернуться при панике (буфер __setjmp) или 0
const CTX_CATCH = 88
// текст последней паники
const CTX_PANIC = 96
// HTTP-сервер потока
const CTX_SERVER = 104
// 1 — запрос только читает store (так решил компилятор): блокировка разделяемая
const CTX_STORE_MODE = 112
// текущая сопрограмма (lib/rt.kh) или 0
const CTX_CORO = 120
// соединение с базой, которое держит транзакция запроса (lib/pg.kh), или 0
const CTX_PGHELD = 128
// поля, которые пришли в JSON явным null (lib/api.kh): map[адрес структуры, биты] или 0
const CTX_JNULLS = 136
// Незавершённые операции внешних драйверов: свои у каждой сопрограммы.
// Хуки __db_end закрывают их до освобождения арены, в том числе после panic.
const CTX_MONGOHELD = 144
const CTX_CHHELD = 152
// TLS ещё не передан драйверу: освобождается при panic в рукопожатии.
const CTX_TLS_PENDING = 160
// слова [8, CTX_CO_END) — свои у каждой сопрограммы: при переключении они
// сохраняются и загружаются (CTX_SELF и всё дальше — общие для потока).
// 168–191 свободны: проект сборщика (docs/design/v0.13-store-gc.md §3.3)
// кладёт сюда запись закрепления сопрограммы (PINREC = 168, CTX_CO_END = 176).
const CTX_CO_END = 168
// Слова 192–223 и 232–239 — временные буферы системных вызовов: timespec
// now_ms (192) и __poll (208) в lib/rt.kh, peek и setsockopt (232) в fetch.kh и
// pg.kh. Слово 224 свободно (проект сборщика: REGISTERED).
// Запись JSON (lib/api.kh; она не переключает сопрограммы): глубина вложенности
const CTX_JDEPTH = 240
// множество структур на пути глубже 1000 или 0
const CTX_JPATH = 248
// свободные соединения fetch этого потока (lib/fetch.kh) или 0
const CTX_POOL = 256
// проверенные цепочки сертификатов этого потока (lib/x509.kh) или 0
const CTX_VCACHE = 264
// соединения с базой этого потока (lib/pg.kh) или 0
const CTX_PGPOOL = 272
// поток уже в панике из-за памяти: остаток арены (запас) — на её обработку
const CTX_MEMPANIC = 280
// пул MongoDB этого потока (lib/mongo.kh) или 0
const CTX_MONGOPOOL = 288
// операции ClickHouse этого потока (lib/db_http.kh): сколько идёт сейчас и
// очередь ждущих места (__slot_take в lib/rt.kh) или 0
const CTX_CHACTIVE = 296
const CTX_CHWAIT = 304
// запас в конце арены для ответа 500 и журнала после исчерпания памяти
const ARENA_RESERVE = 16777216
// кэш строк потока (lib/text.kh) для кода вне арены: fn main, __init_globals,
// загрузка store; у запроса кэш — в начале его арены (__arena_begin)
const CTX_STRC = 1024
const STRC_SIZE = 1024
// байты строк, которые поток прочитал проверкой UTF-8 и обходами (__strc_scanned)
const CTX_SCANNED = 2048
// контекст — одна страница (__thread_init)
const CTX_SIZE = 4096

const CHUNK = 1048576
const BIG = 262144

// Области адресов. Арена запроса освобождается целиком после ответа, поэтому
// всё, что переживает запрос (store), копируется в постоянную память. Принадлежность
// адреса определяется по старшим битам: арены — [32 ТБ, 64 ТБ) (адрес >> 45 == 1),
// по 1 ГБ на арену, store — адрес >> 40 == 0x10.
const ARENA_REGION = 0x200000000000
const ARENA_SIZE = 0x40000000
const ARENA_SLOTS = 32703
// Арена загрузки (lib/gc.kh, __store_boot) — 64 ГБ сразу за ARENA_SLOTS аренами
// запросов, ARENA_REGION + ARENA_SLOTS · ARENA_SIZE: начальные значения
// глобальных пользователя и восстановление KHRIP_DATA. Её адреса — тоже арена
// (адрес >> 45 == 1).
const BOOT_ARENA = 0x3FEFC0000000
const BOOT_ARENA_SIZE = 0x1000000000
const STORE_REGION = 0x100000000000
const STORE_SIZE = 0x4000000000
const COMMIT = 4194304

// Виды объектов кучи store (lib/gc.kh, __salloc): K_NOSCAN — в объекте нет
// ссылок (строка, ячейка int?, [int]); K_PTRS — каждое слово может быть
// ссылкой; K_MASK — ссылки — слова, отмеченные битами маски (бит i — слово i).
const K_NOSCAN = 0
const K_PTRS = 1
const K_MASK = 2

// ---- Паники ----

const PANIC_INDEX = 1
const PANIC_OVERFLOW = 2
const PANIC_DIV_ZERO = 3
const PANIC_EMPTY = 4
const PANIC_SLICE = 5
const PANIC_UNWRAP = 6
const PANIC_MEMORY = 7

var __argc: int
var __argv: int

fn exit(code: int) {
    syscall(SYS_EXIT_GROUP, code)
}

// ---- Память ----

fn __mmap(size: int) -> int {
    let p = syscall(SYS_MMAP, 0, size, 3, 0x22, -1, 0)
    if p < 0 {
        __panic(PANIC_MEMORY, "mmap")
    }
    return p
}

// Обнулённая память, выровненная на 16 байт. Мелкие блоки нарезаются из кусков
// текущего региона потока; освобождения нет — регион сбрасывается целиком.
fn __alloc(n: int) -> int {
    let size = (n + 15) & ~15
    let c = __ctx()
    let p = load64(c + CTX_PTR)
    if p + size <= load64(c + CTX_END) {
        store64(c + CTX_PTR, p + size)
        return p
    }
    return __alloc_slow(c, size)
}

// Вернуть хвост последнего блока: p выделен __alloc(old), нужно только new байт.
// Хвост не трогали — он нулевой, как и положено свободной памяти. Если после p
// уже выделяли, блок остаётся как есть.
fn __alloc_trim(p: int, old: int, new: int) {
    let c = __ctx()
    if load64(c + CTX_PTR) == p + ((old + 15) & ~15) {
        store64(c + CTX_PTR, p + ((new + 15) & ~15))
    }
}

fn __alloc_slow(c: int, size: int) -> int {
    if load64(c + CTX_PSAVE_PTR) != 0 {
        // идёт выделение из store (__pmode_on): объект — в куче store; вид
        // неизвестен, поэтому каждое его слово — возможная ссылка
        return __salloc(size, K_PTRS, 0)
    }
    let p = load64(c + CTX_PTR)
    if __in_arena(p) {
        // арена: зарезервированная область подключается кусками
        var limit = load64(c + CTX_ARENA) + __arena_size(load64(c + CTX_ARENA))
        if load64(c + CTX_MEMPANIC) == 0 {
            limit -= ARENA_RESERVE
        }
        let end = load64(c + CTX_END)
        var new_end = (p + size + COMMIT - 1) & ~(COMMIT - 1)
        if new_end > limit {
            if load64(c + CTX_MEMPANIC) == 0 {
                // запрос исчерпал свою память: паника (500), а запас — на неё
                store64(c + CTX_MEMPANIC, 1)
                __panic(PANIC_MEMORY, "region")
            }
            // исчерпан и запас: без выделений сообщить и выйти (иначе паника
            // выделяет память, снова паникует — и так до переполнения стека)
            let fixed = "panic: out of memory: the request used all of its 1 GB arena\n"
            syscall(1, 2, __str_ptr(fixed), __str_len(fixed))
            syscall(231, 101)
        }
        if new_end > end && syscall(10, end, new_end - end, 3) < 0 {
            __panic(PANIC_MEMORY, "mprotect")
        }
        store64(c + CTX_END, new_end)
        store64(c + CTX_PTR, p + size)
        return p
    }
    if size >= BIG {
        return __mmap(size)
    }
    let q = __mmap(CHUNK)
    store64(c + CTX_PTR, q + size)
    store64(c + CTX_END, q + CHUNK)
    return q
}

// Резерв адресов без памяти: память подключается по мере выделения.
fn __reserve(at: int, size: int) -> bool {
    // MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE
    let p = syscall(SYS_MMAP, at, size, 0, 0x22 | 0x4000 | 0x100000, -1, 0)
    return p == at
}

fn __in_arena(p: int) -> bool {
    return (p >> 45) == 1
}

// Размер арены с началом base: у арены загрузки — BOOT_ARENA_SIZE.
fn __arena_size(base: int) -> int {
    if base == BOOT_ARENA {
        return BOOT_ARENA_SIZE
    }
    return ARENA_SIZE
}

fn __in_store(p: int) -> bool {
    return (p >> 40) == (STORE_REGION >> 40)
}

// Память для внутренностей объекта h (рост списка, таблица словаря): объект
// вне арены не должен ссылаться на арену. У объекта в store память — в store,
// у объекта библиотеки в обычной памяти (запасы соединений, планировщик,
// состояние сервера) — в обычной памяти потока: в store её не найти от корней
// store, и блокировка store ей не нужна.
fn __alloc_for(h: int, n: int) -> int {
    return __alloc_for_k(h, n, K_PTRS, 0)
}

// То же с видом объекта для кучи store (kind, mask — как у __salloc).
fn __alloc_for_k(h: int, n: int, kind: int, mask: int) -> int {
    let c = __ctx()
    if load64(c + CTX_PSAVE_PTR) != 0 {
        // выделение уже идёт из store
        return __salloc(n, kind, mask)
    }
    if __in_store(h) {
        __pmode_on()
        let p = __salloc(n, kind, mask)
        __pmode_off()
        return p
    }
    if __in_arena(load64(c + CTX_PTR)) && !__in_arena(h) {
        return __alloc_heap(n)
    }
    return __alloc(n)
}

// Память вида kind: из кучи store, если выделение идёт из store, иначе — как
// __alloc.
fn __alloc_k(n: int, kind: int, mask: int) -> int {
    if load64(__ctx() + CTX_PSAVE_PTR) != 0 {
        return __salloc(n, kind, mask)
    }
    return __alloc(n)
}

// Обнулённая память в обычной памяти потока, где бы ни шло выделение сейчас:
// курсор обычной памяти — в CTX_PTR, пока нет ни арены, ни store; в
// CTX_SAVE_PTR, пока идёт арена (и store поверх неё); в CTX_PSAVE_PTR, если
// store включён поверх обычной памяти. Блокировку store не берёт.
fn __alloc_heap(n: int) -> int {
    let size = (n + 15) & ~15
    let c = __ctx()
    var at = c + CTX_PTR
    if load64(c + CTX_PSAVE_PTR) != 0 {
        at = c + CTX_PSAVE_PTR
    }
    if __in_arena(load64(at)) {
        at = c + CTX_SAVE_PTR
    }
    // пары «курсор, конец» лежат рядом: CTX_END = CTX_PTR + 8 и т. д.
    let p = load64(at)
    if p + size <= load64(at + 8) {
        store64(at, p + size)
        return p
    }
    if size >= BIG {
        return __mmap(size)
    }
    let q = __mmap(CHUNK)
    store64(at, q + size)
    store64(at + 8, q + CHUNK)
    return q
}

// ---- Постоянная память store: куча store (lib/gc.kh) ----

// Куча store готова (__store_init в lib/gc.kh): до этого (глобальные до
// загрузки, fn main программы с тестами) и в программах без store значения
// живут в обычной памяти, и копировать их некуда.
var __gc_ready: bool
// Идёт разметка сборщика (шаг 6 docs/design/v0.13-store-gc.md): новые объекты
// store сразу помечены. Пока сборщика нет — всегда 0.
var __gc_marking: int
// Номер сборки мусора store: сборщик увеличивает его под исключительной
// блокировкой, и кэши строк (lib/text.kh) с другим номером очищаются — их
// ключи могли указывать на освобождённую память.
var __store_epoch: int

// Переключить выделение на кучу store. → false, если уже переключено или
// кучи нет. Признак переключения — сохранённый курсор CTX_PSAVE_PTR, а
// CTX_PTR = CTX_END = 0: быстрый путь __alloc не проходит, и __alloc_slow
// отдаёт объект из кучи store.
fn __pmode_on() -> bool {
    let c = __ctx()
    if load64(c + CTX_PSAVE_PTR) != 0 || !__gc_ready {
        return false
    }
    __store_lock()
    if load64(c + CTX_STORE_HELD) == 2 {
        // компилятор решил, что маршрут только читает (src/rw.kh), а он пишет:
        // лучше ответ 500, чем гонка с другими читателями
        __panic_msg("internal: a read-only route changes store")
    }
    if load64(c + CTX_PTR) == 0 {
        // поток ещё ничего не выделял: курсор — признак, ему нельзя быть нулём
        __alloc(16)
    }
    store64(c + CTX_PSAVE_PTR, load64(c + CTX_PTR))
    store64(c + CTX_PSAVE_END, load64(c + CTX_END))
    store64(c + CTX_PTR, 0)
    store64(c + CTX_END, 0)
    return true
}

fn __pmode_off() {
    let c = __ctx()
    store64(c + CTX_PTR, load64(c + CTX_PSAVE_PTR))
    store64(c + CTX_END, load64(c + CTX_PSAVE_END))
    store64(c + CTX_PSAVE_PTR, 0)
}

// Изменение контейнера h (список, словарь): у контейнера в store — только под
// исключительной блокировкой. Иначе маршрут, который компилятор счёл
// читающим (src/rw.kh), менял бы store одновременно с другими читателями и
// (шаг 6) с разметкой сборщика: лучше ответ 500, чем гонка.
fn __store_mut(h: int) {
    if (h >> 40) == (STORE_REGION >> 40) && load64(__ctx() + CTX_STORE_HELD) != 1 {
        __store_mut_slow()
    }
}

fn __store_mut_slow() {
    __panic_msg("internal: store changed without the exclusive store lock")
}

// Блокировка store (__store_lock, __store_unlock) — в lib/rt.kh: ей нужны
// атомарные операции.

// ---- Арена запроса: своя у каждой сопрограммы (и у потока задач, и у тестов) ----

// Подключить арену с началом base к контексту cx (номер арены выдаёт
// __arena_take в lib/rt.kh, арена загрузки — BOOT_ARENA). Арена — 1 ГБ адресов
// (арена загрузки — 64 ГБ): если система разрешает, они сразу доступны на
// запись (страницы появятся при первом касании, соседние арены — одна область
// для ядра), иначе подключаются кусками по COMMIT.
fn __arena_attach(cx: int, base: int) {
    let size = __arena_size(base)
    // MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE
    let p = syscall(SYS_MMAP, base, size, 3, 0x22 | 0x4000 | 0x100000, -1, 0)
    var end = base + size
    if p != base {
        if !__reserve(base, size) {
            __panic(PANIC_MEMORY, "arena region")
        }
        end = base
    }
    store64(cx + CTX_ARENA, base)
    store64(cx + CTX_ARENA_END, end)
}

// Дальше память выделяется из арены.
fn __arena_begin() {
    let c = __ctx()
    store64(c + CTX_MEMPANIC, 0)
    store64(c + CTX_SAVE_PTR, load64(c + CTX_PTR))
    store64(c + CTX_SAVE_END, load64(c + CTX_END))
    store64(c + CTX_PTR, load64(c + CTX_ARENA))
    // последние ARENA_RESERVE байт — запас на ответ 500 после исчерпания памяти:
    // быстрый путь выделения до них не доходит
    var end = load64(c + CTX_ARENA_END)
    let cap = load64(c + CTX_ARENA) + __arena_size(load64(c + CTX_ARENA)) - ARENA_RESERVE
    if end > cap {
        end = cap
    }
    store64(c + CTX_END, end)
    // кэш строк запроса (lib/text.kh) — первые STRC_SIZE байт арены; он
    // обнуляется вместе с ареной в __arena_end
    let blk = __alloc(STRC_SIZE)
    store64(blk, __store_epoch)
}

// Очистить кэш строк запроса (кроме номера сборки store): после отката CTX_PTR
// назад по тем же адресам появятся другие строки (правило I1 у CTX_PTR).
fn __strc_clear() {
    let c = __ctx()
    let a = load64(c + CTX_ARENA)
    let d = load64(c + CTX_PTR) - a
    if a != 0 && d >= STRC_SIZE && d < __arena_size(a) {
        __memset(a + 8, 0, STRC_SIZE - 8)
    }
}

// Освободить всё, что выделено в арене, и вернуться к обычной памяти.
// Арена обнуляется: выделитель обещает нулевую память.
fn __arena_end() {
    let c = __ctx()
    let base = load64(c + CTX_ARENA)
    let used = load64(c + CTX_PTR) - base
    let end = load64(c + CTX_END)
    if used > 8 * COMMIT {
        // большой запрос: вернуть страницы системе (они вернутся нулевыми)
        syscall(28, base, (used + 4095) & ~4095, 4)
    } else {
        __memset(base, 0, used)
    }
    store64(c + CTX_ARENA_END, end)
    store64(c + CTX_PTR, load64(c + CTX_SAVE_PTR))
    store64(c + CTX_END, load64(c + CTX_SAVE_END))
}

fn __memcpy(dst: int, src: int, n: int) {
    var i = 0
    while i + 8 <= n {
        store64(dst + i, load64(src + i))
        i += 8
    }
    while i < n {
        store8(dst + i, load8(src + i))
        i += 1
    }
}

// В khc — встроенная (rep stosb).
fn __memset(dst: int, b: int, n: int) {
    var i = 0
    while i < n {
        store8(dst + i, b)
        i += 1
    }
}

fn __memeq(a: int, b: int, n: int) -> bool {
    var i = 0
    while i + 8 <= n {
        if load64(a + i) != load64(b + i) {
            return false
        }
        i += 8
    }
    while i < n {
        if load8(a + i) != load8(b + i) {
            return false
        }
        i += 1
    }
    return true
}

// ---- Паника: ошибка во время выполнения ----

fn __panic_text(kind: int) -> str {
    if kind == PANIC_INDEX {
        return "index out of range"
    }
    if kind == PANIC_OVERFLOW {
        return "integer overflow"
    }
    if kind == PANIC_DIV_ZERO {
        return "division by zero"
    }
    if kind == PANIC_EMPTY {
        return "empty list"
    }
    if kind == PANIC_SLICE {
        return "slice out of range"
    }
    if kind == PANIC_UNWRAP {
        return "value is none"
    }
    if kind == PANIC_MEMORY {
        return "out of memory"
    }
    return "panic"
}

// Паника: текст запоминается в контексте; внутри запроса или теста управление
// возвращается в рантайм (__panic_recover), иначе программа завершается.
// Паника с готовым текстом.
fn __panic_msg(text: str) {
    let msg = "panic: " + text
    let mh: int = __cast(msg)
    store64(__ctx() + CTX_PANIC, mh)
    __panic_recover()
    eprint(msg)
    exit(101)
}

fn __panic(kind: int, at: str) {
    if kind == PANIC_MEMORY && load64(__ctx() + CTX_MEMPANIC) != 0 {
        // память кончилась: текст без выделений, и не исчерпать запас повторно
        let fixed = "panic: out of memory: the request used all of its 1 GB arena"
        store64(__ctx() + CTX_PANIC, __cast(fixed))
        __panic_recover()
        eprint(fixed)
        exit(101)
    }
    let msg = "panic: " + __panic_text(kind) + " at " + at
    let mh: int = __cast(msg)
    store64(__ctx() + CTX_PANIC, mh)
    __panic_recover()
    eprint(msg)
    exit(101)
}

// ---- Строки ----

fn __str_new(ptr: int, len: int) -> str {
    let h = __alloc(16)
    store64(h, ptr)
    store64(h + 8, len)
    return __cast(h)
}

// Копия байтов в новую строку.
fn __str_copy(ptr: int, len: int) -> str {
    let p = __alloc(len + 1)
    __memcpy(p, ptr, len)
    return __str_new(p, len)
}

// Копия байтов в новую строку одним объектом: [заголовок {ptr, len}][байты][0],
// ptr = адрес объекта + 16. Так строки копируются в store (__deep_copy): один
// объект кучи store без ссылок вместо двух, а срез такой строки (ptr внутри
// объекта) указывает в тот же объект.
fn __str_copy_store(ptr: int, len: int) -> str {
    let h = __alloc_k(len + 17, K_NOSCAN, 0)
    store64(h, h + 16)
    store64(h + 8, len)
    __memcpy(h + 16, ptr, len)
    return __cast(h)
}

fn __str_ptr(s: str) -> int {
    let h: int = __cast(s)
    return load64(h)
}

fn __str_len(s: str) -> int {
    let h: int = __cast(s)
    return load64(h + 8)
}

fn __str_eq(a: str, b: str) -> bool {
    let n = __str_len(a)
    if n != __str_len(b) {
        return false
    }
    return __memeq(__str_ptr(a), __str_ptr(b), n)
}

// <0, 0 или >0, как strcmp
fn __str_cmp(a: str, b: str) -> int {
    let an = __str_len(a)
    let bn = __str_len(b)
    let ap = __str_ptr(a)
    let bp = __str_ptr(b)
    var n = an
    if bn < n {
        n = bn
    }
    // равные куски по 8 байт пропускаются целиком
    var i = 0
    while i + 8 <= n && load64(ap + i) == load64(bp + i) {
        i += 8
    }
    while i < n {
        let d = load8(ap + i) - load8(bp + i)
        if d != 0 {
            return d
        }
        i += 1
    }
    return an - bn
}

fn __str_concat(a: str, b: str) -> str {
    let an = __str_len(a)
    let bn = __str_len(b)
    let p = __alloc(an + bn + 1)
    __memcpy(p, __str_ptr(a), an)
    __memcpy(p + an, __str_ptr(b), bn)
    return __str_new(p, an + bn)
}

// ---- Байтовый API ----
// Длина, байт, срез и поиск в байтах; смена регистра и обрезка пробелов — только
// ASCII. Системный код (компилятор и библиотека) работает со строками только так:
// s.byte_len() и s.byte(i) khc встраивает, s.byte_slice(a, b) вызывает __str_slice
// напрямую; загрузчик (boot) находит эти функции по имени.

fn __str_byte_len(self: str) -> int {
    return __str_len(self)
}

fn __str_byte(self: str, i: int) -> int {
    if i < 0 || i >= __str_len(self) {
        __panic(PANIC_INDEX, "str")
    }
    return load8(__str_ptr(self) + i)
}

// Байты [from, to) без копирования; символ UTF-8 может разрезаться.
fn __str_byte_slice(self: str, from: int, to: int) -> str {
    return __str_slice(self, from, to)
}

// Границы среза прижимаются к [0, len], как в Python и JS: xs[a..a + n] не
// паникует, а берёт, сколько есть.
fn __clamp(v: int, lo: int, hi: int) -> int {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

// Подстрока [from, to) без копирования байтов.
fn __str_slice(self: str, from: int, to: int) -> str {
    let n = __str_len(self)
    let a = __clamp(from, 0, n)
    let b = __clamp(to, a, n)
    return __str_new(__str_ptr(self) + a, b - a)
}

// Первое вхождение sub с байта from: индекс байта или -1. Отрицательное from —
// с начала строки (как у срезов).
fn __str_byte_find_from(self: str, sub: str, from: int) -> int {
    let n = __str_len(self)
    let m = __str_len(sub)
    let p = __str_ptr(self)
    let q = __str_ptr(sub)
    var i = from
    if i < 0 {
        i = 0
    }
    if m == 0 {
        if i <= n {
            return i
        }
        return -1
    }
    // сравнение целиком — только там, где совпал первый байт
    let first = load8(q)
    let last = n - m
    while i <= last {
        if load8(p + i) == first && __memeq(p + i + 1, q + 1, m - 1) {
            return i
        }
        i += 1
    }
    return -1
}

fn __str_byte_find(self: str, sub: str) -> int? {
    let i = __str_byte_find_from(self, sub, 0)
    if i < 0 {
        return none
    }
    return i
}

fn __str_contains(self: str, sub: str) -> bool {
    return __str_byte_find_from(self, sub, 0) >= 0
}

fn __str_starts_with(self: str, prefix: str) -> bool {
    let m = __str_len(prefix)
    return m <= __str_len(self) && __memeq(__str_ptr(self), __str_ptr(prefix), m)
}

fn __str_ends_with(self: str, suffix: str) -> bool {
    let n = __str_len(self)
    let m = __str_len(suffix)
    return m <= n && __memeq(__str_ptr(self) + n - m, __str_ptr(suffix), m)
}

fn __is_space(c: int) -> bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

// Без пробелов ASCII (SP HT CR LF) по краям.
fn __str_ascii_trim(self: str) -> str {
    let p = __str_ptr(self)
    var a = 0
    var b = __str_len(self)
    while a < b && __is_space(load8(p + a)) {
        a += 1
    }
    while b > a && __is_space(load8(p + b - 1)) {
        b -= 1
    }
    return __str_new(p + a, b - a)
}

// Смена регистра ASCII по 4 байта за шаг (SWAR): в каждой половине слова
// старший бит байта в m отмечает буквы from..from+25; m >> 2 — это 0x20 в тех же
// байтах. Половины по 32 бита — чтобы сложение не переполняло int.
fn __case4(v: int, below: int, past: int) -> int {
    let h = v & 0x7F7F7F7F
    return ((h + below) & ~(h + past) & ~v & 0x80808080) >> 2
}

// Копия [src, src + n) в новую строку; буквы в диапазоне [lo, lo + 25] меняют
// регистр (xor 0x20). below = 0x80 - lo, past = 0x80 - lo - 26 в каждом байте.
fn __str_case(self: str, lo: int, below: int, past: int) -> str {
    let n = __str_len(self)
    let src = __str_ptr(self)
    let p = __alloc(n + 1)
    var i = 0
    while i + 8 <= n {
        let x = load64(src + i)
        let a = x & 0xFFFFFFFF
        let b = (x >> 32) & 0xFFFFFFFF
        store64(p + i, x ^ (__case4(a, below, past) | (__case4(b, below, past) << 32)))
        i += 8
    }
    while i < n {
        var c = load8(src + i)
        if c >= lo && c < lo + 26 {
            c = c ^ 32
        }
        store8(p + i, c)
        i += 1
    }
    return __str_new(p, n)
}

fn __str_ascii_lower(self: str) -> str {
    return __str_case(self, 'A', 0x3F3F3F3F, 0x25252525)
}

fn __str_ascii_upper(self: str) -> str {
    return __str_case(self, 'a', 0x1F1F1F1F, 0x05050505)
}

fn __str_split(self: str, sep: str) -> [str] {
    var parts: [str] = []
    let m = __str_len(sep)
    var start = 0
    if m == 0 {
        parts.push(self)
        return parts
    }
    while true {
        let i = __str_byte_find_from(self, sep, start)
        if i < 0 {
            break
        }
        parts.push(__str_slice(self, start, i))
        start = i + m
    }
    parts.push(__str_slice(self, start, __str_len(self)))
    return parts
}

fn __str_replace(self: str, old: str, new: str) -> str {
    let m = __str_len(old)
    if m == 0 {
        return self
    }
    let b = buf_new(__str_len(self) + 16)
    var start = 0
    while true {
        let i = __str_byte_find_from(self, old, start)
        if i < 0 {
            break
        }
        buf_add_raw(b, __str_ptr(self) + start, i - start)
        buf_add(b, new)
        start = i + m
    }
    buf_add_raw(b, __str_ptr(self) + start, __str_len(self) - start)
    return buf_str(b)
}

fn __str_repeat(self: str, n: int) -> str {
    let b = buf_new(__str_len(self) * n + 1)
    var i = 0
    while i < n {
        buf_add(b, self)
        i += 1
    }
    return buf_str(b)
}

// Целое без знака или со знаком «-» → значение; -1 в *ok, если не число.
fn __parse_int(p: int, n: int, ok: int) -> int {
    store64(ok, 0)
    if n == 0 || n > 20 {
        return 0
    }
    var i = 0
    var neg = false
    if load8(p) == '-' {
        neg = true
        i = 1
        if n == 1 {
            return 0
        }
    }
    var v = 0
    while i < n {
        let c = load8(p + i)
        if c < '0' || c > '9' {
            return 0
        }
        v = v * 10 + (c - '0')
        i += 1
    }
    store64(ok, 1)
    if neg {
        return -v
    }
    return v
}

fn __str_to_int(self: str) -> int? {
    let ok = __alloc(8)
    let v = __parse_int(__str_ptr(self), __str_len(self), ok)
    if load64(ok) == 0 {
        return none
    }
    return v
}

fn __int_to_str(self: int) -> str {
    let b = buf_new(24)
    buf_int(b, self)
    return buf_str(b)
}

fn __bool_to_str(self: bool) -> str {
    if self {
        return "true"
    }
    return "false"
}

fn __str_to_str(self: str) -> str {
    return self
}

// Копия строки с нулевым байтом на конце — для системных вызовов.
fn __cstr(s: str) -> int {
    let n = __str_len(s)
    let p = __alloc(n + 1)
    __memcpy(p, __str_ptr(s), n)
    return p
}

// Строка из байтов с нулём на конце (argv, environ).
fn __str_from_c(p: int) -> str {
    var n = 0
    while load8(p + n) != 0 {
        n += 1
    }
    return __str_new(p, n)
}

// ---- UTF-8 без SIMD ----
// Этот файл компилирует и загрузчик, поэтому здесь — только простые чтения и
// циклы. Символ — по правилу Go: правильная последовательность (таблица 3-7
// Unicode: без лишне длинных форм, суррогатов и значений больше U+10FFFF) — один
// символ, любой другой байт — отдельный символ U+FFFD. Нужны лексеру и как
// запасной путь там, где текст неправильный. ~0x7F7F7F7F7F7F7F7F — старшие биты
// всех восьми байтов слова: слово без них — 8 байтов ASCII.

// Ширина символа в байте i (i < n): 1–4.
fn __utf8_width(p: int, n: int, i: int) -> int {
    let c = load8(p + i)
    if c < 0xC2 || c > 0xF4 {
        return 1
    }
    var w = 2
    var lo = 0x80
    var hi = 0xBF
    if c >= 0xF0 {
        w = 4
        if c == 0xF0 {
            lo = 0x90
        } else if c == 0xF4 {
            hi = 0x8F
        }
    } else if c >= 0xE0 {
        w = 3
        if c == 0xE0 {
            lo = 0xA0
        } else if c == 0xED {
            hi = 0x9F
        }
    }
    if i + w > n {
        return 1
    }
    let c1 = load8(p + i + 1)
    if c1 < lo || c1 > hi {
        return 1
    }
    var j = 2
    while j < w {
        if (load8(p + i + j) & 0xC0) != 0x80 {
            return 1
        }
        j += 1
    }
    return w
}

// Код символа в байте i (i < n) или 0xFFFD, если там неправильный байт.
fn __utf8_decode(p: int, n: int, i: int) -> int {
    let c = load8(p + i)
    if c < 0x80 {
        return c
    }
    let w = __utf8_width(p, n, i)
    if w == 1 {
        return 0xFFFD
    }
    var cp = c & (0x7F >> w)
    var j = 1
    while j < w {
        cp = (cp << 6) | (load8(p + i + j) & 0x3F)
        j += 1
    }
    return cp
}

// Смещение первого неправильного байта в [p, p + n) или n.
fn __utf8_bad_at(p: int, n: int) -> int {
    let high = ~0x7F7F7F7F7F7F7F7F
    var i = 0
    while i < n {
        if i + 8 <= n && (load64(p + i) & high) == 0 {
            i += 8
            continue
        }
        if load8(p + i) < 0x80 {
            i += 1
            continue
        }
        let w = __utf8_width(p, n, i)
        if w == 1 {
            return i
        }
        i += w
    }
    return n
}

// Число символов в [p, p + n).
fn __utf8_go_count(p: int, n: int) -> int {
    let high = ~0x7F7F7F7F7F7F7F7F
    var i = 0
    var k = 0
    while i < n {
        if i + 8 <= n && (load64(p + i) & high) == 0 {
            i += 8
            k += 8
            continue
        }
        i += __utf8_width(p, n, i)
        k += 1
    }
    return k
}

// Смещение начала символа k (k >= 0) или n, если символов не больше k.
fn __utf8_go_skip(p: int, n: int, k: int) -> int {
    let high = ~0x7F7F7F7F7F7F7F7F
    var i = 0
    var left = k
    while left > 0 && i < n {
        if left >= 8 && i + 8 <= n && (load64(p + i) & high) == 0 {
            i += 8
            left -= 8
            continue
        }
        i += __utf8_width(p, n, i)
        left -= 1
    }
    return i
}

// ---- Буфер для сборки байтов ----

type Buf {
    data: int
    len: int
    cap: int
    // память буфера — из mmap и растёт через mmap: так растут буферы, которые
    // живут дольше запроса (ответ потока), — не за счёт арены и не в store
    mm: bool
}

fn buf_new(cap: int) -> Buf {
    var c = cap
    if c < 16 {
        c = 16
    }
    return Buf { data: __alloc(c), len: 0, cap: c, mm: false }
}

fn buf_mm(cap: int) -> Buf {
    let c = (cap + 4095) & ~4095
    return Buf { data: __mmap(c), len: 0, cap: c, mm: true }
}

// Вернуть системе память буфера mm, выросшего больше max байт.
fn buf_shrink(b: Buf, max: int) {
    if b.mm && b.cap > max {
        syscall(SYS_MUNMAP, b.data, b.cap)
        b.cap = (max + 4095) & ~4095
        b.data = __mmap(b.cap)
        b.len = 0
    }
}

fn buf_reserve(b: Buf, n: int) {
    if b.len + n <= b.cap {
        return
    }
    var c = b.cap * 2
    while c < b.len + n {
        c *= 2
    }
    if b.mm {
        c = (c + 4095) & ~4095
        let q = __mmap(c)
        __memcpy(q, b.data, b.len)
        syscall(SYS_MUNMAP, b.data, b.cap)
        b.data = q
        b.cap = c
        return
    }
    let bh: int = __cast(b)
    let p = __alloc_for(bh, c)
    __memcpy(p, b.data, b.len)
    b.data = p
    b.cap = c
}

fn buf_add_raw(b: Buf, p: int, n: int) {
    buf_reserve(b, n)
    __memcpy(b.data + b.len, p, n)
    b.len += n
}

fn buf_add(b: Buf, s: str) {
    buf_add_raw(b, __str_ptr(s), __str_len(s))
}

fn buf_byte(b: Buf, c: int) {
    buf_reserve(b, 1)
    store8(b.data + b.len, c)
    b.len += 1
}

// Символ cp (не суррогат, не больше 0x10FFFF) в UTF-8.
fn buf_utf8(b: Buf, cp: int) {
    if cp < 0x80 {
        buf_byte(b, cp)
    } else if cp < 0x800 {
        buf_byte(b, 0xC0 | (cp >> 6))
        buf_byte(b, 0x80 | (cp & 63))
    } else if cp < 0x10000 {
        buf_byte(b, 0xE0 | (cp >> 12))
        buf_byte(b, 0x80 | ((cp >> 6) & 63))
        buf_byte(b, 0x80 | (cp & 63))
    } else {
        buf_byte(b, 0xF0 | (cp >> 18))
        buf_byte(b, 0x80 | ((cp >> 12) & 63))
        buf_byte(b, 0x80 | ((cp >> 6) & 63))
        buf_byte(b, 0x80 | (cp & 63))
    }
}

fn buf_int(b: Buf, x: int) {
    buf_reserve(b, 24)
    if x == 0 {
        store8(b.data + b.len, '0')
        b.len += 1
        return
    }
    var v = x
    if v < 0 {
        store8(b.data + b.len, '-')
        b.len += 1
    }
    let tmp = __alloc(24)
    var i = 24
    while v != 0 {
        var d = v % 10
        if d < 0 {
            d = -d
        }
        i -= 1
        store8(tmp + i, '0' + d)
        v = v / 10
    }
    __memcpy(b.data + b.len, tmp + i, 24 - i)
    b.len += 24 - i
}

fn buf_clear(b: Buf) {
    b.len = 0
}

// Содержимое буфера как строка (копия).
fn buf_str(b: Buf) -> str {
    return __str_copy(b.data, b.len)
}

// ---- Списки ----
// Заголовок: [0] data, [8] len, [16] cap, [24] размер элемента — 8 байт,
// а у [bool] — 1 байт.

fn __list_new(cap: int, esize: int) -> int {
    var c = cap
    if c < 4 {
        c = 4
    }
    let h = __alloc(32)
    store64(h, __alloc(c * esize))
    store64(h + 16, c)
    store64(h + 24, esize)
    return h
}

// То же с видами объектов для кучи store: в заголовке ссылка — только data
// (слово 0); в data ссылки — элементы, если elem_ref.
fn __list_new_k(cap: int, esize: int, elem_ref: bool) -> int {
    var c = cap
    if c < 4 {
        c = 4
    }
    var kind = K_NOSCAN
    if elem_ref {
        kind = K_PTRS
    }
    let h = __alloc_k(32, K_MASK, 1)
    store64(h, __alloc_k(c * esize, kind, 0))
    store64(h + 16, c)
    store64(h + 24, esize)
    return h
}

fn __lget(h: int, i: int) -> int {
    if load64(h + 24) == 1 {
        return load8(load64(h) + i)
    }
    return load64(load64(h) + i * 8)
}

fn __lset(h: int, i: int, v: int) {
    if load64(h + 24) == 1 {
        store8(load64(h) + i, v)
        return
    }
    store64(load64(h) + i * 8, v)
}

fn __list_grow(h: int, need: int) {
    var cap = load64(h + 16) * 2
    while cap < need {
        cap *= 2
    }
    let es = load64(h + 24)
    // новый массив списка в store — того же вида, что старый ([int] — без ссылок)
    var kind = K_PTRS
    if __in_store(h) {
        kind = __gc_kind_of(load64(h))
    }
    let data = __alloc_for_k(h, cap * es, kind, 0)
    __memcpy(data, load64(h), load64(h + 8) * es)
    store64(h, data)
    store64(h + 16, cap)
}

fn __list_push(self: [T], v: T) {
    let h: int = __cast(self)
    __store_mut(h)
    let len = load64(h + 8)
    if len == load64(h + 16) {
        __list_grow(h, len + 1)
    }
    __lset(h, len, __cast(v))
    store64(h + 8, len + 1)
}

fn __list_pop(self: [T]) -> T {
    let h: int = __cast(self)
    __store_mut(h)
    let len = load64(h + 8)
    if len == 0 {
        __panic(PANIC_EMPTY, "pop")
    }
    store64(h + 8, len - 1)
    let v = __lget(h, len - 1)
    if __in_store(h) {
        __lset(h, len - 1, 0)
    }
    return __cast(v)
}

fn __list_last(self: [T]) -> T {
    let h: int = __cast(self)
    let len = load64(h + 8)
    if len == 0 {
        __panic(PANIC_EMPTY, "last")
    }
    return __cast(__lget(h, len - 1))
}

fn __list_clear(self: [T]) {
    let h: int = __cast(self)
    __store_mut(h)
    __list_vacate(h, 0)
    store64(h + 8, 0)
}

fn __list_truncate(self: [T], n: int) {
    let h: int = __cast(self)
    __store_mut(h)
    if n >= 0 && n < load64(h + 8) {
        __list_vacate(h, n)
        store64(h + 8, n)
    }
}

// Список в store: элементы [from, len) больше не его — их слоты обнуляются,
// чтобы в массиве не оставалось ссылок на то, что из него уже убрано.
fn __list_vacate(h: int, from: int) {
    if __in_store(h) {
        let es = load64(h + 24)
        __memset(load64(h) + from * es, 0, (load64(h + 8) - from) * es)
    }
}

fn __list_insert(self: [T], i: int, v: T) {
    let h: int = __cast(self)
    __store_mut(h)
    let len = load64(h + 8)
    if i < 0 || i > len {
        __panic(PANIC_INDEX, "insert")
    }
    if len == load64(h + 16) {
        __list_grow(h, len + 1)
    }
    var j = len
    while j > i {
        __lset(h, j, __lget(h, j - 1))
        j -= 1
    }
    __lset(h, i, __cast(v))
    store64(h + 8, len + 1)
}

fn __list_remove_at(self: [T], i: int) -> T {
    let h: int = __cast(self)
    __store_mut(h)
    let len = load64(h + 8)
    if i < 0 || i >= len {
        __panic(PANIC_INDEX, "remove_at")
    }
    let v = __lget(h, i)
    var j = i
    while j + 1 < len {
        __lset(h, j, __lget(h, j + 1))
        j += 1
    }
    if __in_store(h) {
        __lset(h, len - 1, 0)
    }
    store64(h + 8, len - 1)
    return __cast(v)
}

// Разворачивает список на месте и возвращает его же (для цепочек).
fn __list_reverse(self: [T]) -> [T] {
    let h: int = __cast(self)
    __store_mut(h)
    var a = 0
    var b = load64(h + 8) - 1
    while a < b {
        let t = __lget(h, a)
        __lset(h, a, __lget(h, b))
        __lset(h, b, t)
        a += 1
        b -= 1
    }
    return self
}

fn __list_copy(self: [T]) -> [T] {
    let h: int = __cast(self)
    let len = load64(h + 8)
    let es = load64(h + 24)
    let n = __list_new(len, es)
    __memcpy(load64(n), load64(h), len * es)
    store64(n + 8, len)
    return __cast(n)
}

// [x] * n — список из n повторений.
fn __list_repeat(self: [T], n: int) -> [T] {
    let h: int = __cast(self)
    let len = load64(h + 8)
    let es = load64(h + 24)
    var count = n
    if count < 0 {
        count = 0
    }
    let r = __list_new(len * count, es)
    let bytes = len * es
    store64(r + 8, len * count)
    if len == 1 {
        // один элемент: память уже обнулена, остальное заполняется
        let v = __lget(h, 0)
        if v == 0 {
            return __cast(r)
        }
        if es == 1 {
            __memset(load64(r), v, count)
            return __cast(r)
        }
        var k = 0
        let d = load64(r)
        while k < count {
            store64(d + k * 8, v)
            k += 1
        }
        return __cast(r)
    }
    var i = 0
    while i < count {
        __memcpy(load64(r) + i * bytes, load64(h), bytes)
        i += 1
    }
    return __cast(r)
}

fn __list_join(self: [str], sep: str) -> str {
    let b = buf_new(64)
    var i = 0
    for s in self {
        if i > 0 {
            buf_add(b, sep)
        }
        buf_add(b, s)
        i += 1
    }
    return buf_str(b)
}

fn __list_sum(self: [int]) -> int {
    var total = 0
    for x in self {
        total += x
    }
    return total
}

// ---- Ввод и вывод ----

fn __write(fd: int, s: str) {
    var p = __str_ptr(s)
    var n = __str_len(s)
    while n > 0 {
        let w = syscall(SYS_WRITE, fd, p, n)
        if w <= 0 {
            return
        }
        p += w
        n -= w
    }
}

// Печатает строку и перевод строки.
fn print(s: str) {
    let n = __str_len(s)
    let p = __alloc(n + 1)
    __memcpy(p, __str_ptr(s), n)
    store8(p + n, '\n')
    __write(STDOUT, __str_new(p, n + 1))
}

fn eprint(s: str) {
    let n = __str_len(s)
    let p = __alloc(n + 1)
    __memcpy(p, __str_ptr(s), n)
    store8(p + n, '\n')
    __write(STDERR, __str_new(p, n + 1))
}

// Печать без перевода строки.
fn write(s: str) {
    __write(STDOUT, s)
}

fn read_file(path: str) -> str? {
    let fd = syscall(SYS_OPEN, __cstr(path), 0, 0)
    if fd < 0 {
        return none
    }
    let b = buf_new(65536)
    while true {
        buf_reserve(b, 65536)
        let n = syscall(SYS_READ, fd, b.data + b.len, b.cap - b.len)
        if n < 0 {
            syscall(SYS_CLOSE, fd)
            return none
        }
        if n == 0 {
            break
        }
        b.len += n
    }
    syscall(SYS_CLOSE, fd)
    return __str_new(b.data, b.len)
}

// Записывает строку в файл; executable — сделать файл исполняемым.
fn write_file(path: str, content: str, executable: bool) -> bool {
    var mode = 420
    if executable {
        mode = 493
    }
    let fd = syscall(SYS_OPEN, __cstr(path), 0x241, mode)
    if fd < 0 {
        return false
    }
    var p = __str_ptr(content)
    var n = __str_len(content)
    while n > 0 {
        let w = syscall(SYS_WRITE, fd, p, n)
        if w <= 0 {
            syscall(SYS_CLOSE, fd)
            return false
        }
        p += w
        n -= w
    }
    syscall(SYS_CLOSE, fd)
    return true
}

// Аргументы командной строки, включая имя программы.
fn args() -> [str] {
    var list: [str] = []
    var i = 0
    while i < __argc {
        list.push(__str_from_c(load64(__argv + i * 8)))
        i += 1
    }
    return list
}

fn env(name: str) -> str? {
    var e = __argv + (__argc + 1) * 8
    let n = __str_len(name)
    while load64(e) != 0 {
        let s = load64(e)
        if __memeq(s, __str_ptr(name), n) && load8(s + n) == '=' {
            return __str_from_c(s + n + 1)
        }
        e += 8
    }
    return none
}

fn __str_from_byte(c: int) -> str {
    let p = __alloc(2)
    store8(p, c)
    return __str_new(p, 1)
}

fn __int_abs(self: int) -> int {
    if self < 0 {
        return -self
    }
    return self
}

fn __int_min(self: int, other: int) -> int {
    if other < self {
        return other
    }
    return self
}

fn __int_max(self: int, other: int) -> int {
    if other > self {
        return other
    }
    return self
}

// ---- Списки: срезы, поиск, сортировка ----

fn __list_slice(self: [T], from: int, to: int) -> [T] {
    let h: int = __cast(self)
    let a = __clamp(from, 0, load64(h + 8))
    let b = __clamp(to, a, load64(h + 8))
    let es = load64(h + 24)
    let n = __list_new(b - a, es)
    __memcpy(load64(n), load64(h) + a * es, (b - a) * es)
    store64(n + 8, b - a)
    return __cast(n)
}

fn __list_contains_int(self: [int], v: int) -> bool {
    for x in self {
        if x == v {
            return true
        }
    }
    return false
}

fn __list_contains_str(self: [str], v: str) -> bool {
    for x in self {
        if x == v {
            return true
        }
    }
    return false
}

fn __list_index_of_int(self: [int], v: int) -> int? {
    var i = 0
    for x in self {
        if x == v {
            return i
        }
        i += 1
    }
    return none
}

fn __list_index_of_str(self: [str], v: str) -> int? {
    var i = 0
    for x in self {
        if x == v {
            return i
        }
        i += 1
    }
    return none
}

// Сортировка слиянием по словам; by_str — сравнивать как строки.
fn __sort_words(data: int, n: int, by_str: bool) {
    if n < 2 {
        return
    }
    let tmp = __alloc(n * 8)
    var width = 1
    while width < n {
        var lo = 0
        while lo < n {
            var mid = lo + width
            if mid > n {
                mid = n
            }
            var hi = lo + 2 * width
            if hi > n {
                hi = n
            }
            var a = lo
            var b = mid
            var k = lo
            while k < hi {
                var take_a = false
                if a < mid && b < hi {
                    let x = load64(data + a * 8)
                    let y = load64(data + b * 8)
                    if by_str {
                        take_a = __str_cmp(__cast(x), __cast(y)) <= 0
                    } else {
                        take_a = x <= y
                    }
                } else {
                    take_a = a < mid
                }
                if take_a {
                    store64(tmp + k * 8, load64(data + a * 8))
                    a += 1
                } else {
                    store64(tmp + k * 8, load64(data + b * 8))
                    b += 1
                }
                k += 1
            }
            lo += 2 * width
        }
        __memcpy(data, tmp, n * 8)
        width *= 2
    }
}

// Устойчивая сортировка списка по ключам (int или str, по одному на элемент):
// слияние снизу вверх по массиву номеров. Возвращает тот же список.
fn __sort_by(self: [T], keys: [int], by_str: bool) -> [T] {
    let h: int = __cast(self)
    __store_mut(h)
    let kh: int = __cast(keys)
    let n = load64(h + 8)
    let kd = load64(kh)
    var a = __alloc(n * 8 + 8)
    var t = __alloc(n * 8 + 8)
    var i = 0
    while i < n {
        store64(a + i * 8, i)
        i += 1
    }
    var width = 1
    while width < n {
        var lo = 0
        while lo < n {
            var mid = lo + width
            if mid > n {
                mid = n
            }
            var hi = lo + 2 * width
            if hi > n {
                hi = n
            }
            var x = lo
            var y = mid
            var o = lo
            while o < hi {
                var take_x = y >= hi
                if x < mid && y < hi {
                    let kx = load64(kd + load64(a + x * 8) * 8)
                    let ky = load64(kd + load64(a + y * 8) * 8)
                    if by_str {
                        take_x = __str_cmp(__cast(kx), __cast(ky)) <= 0
                    } else {
                        take_x = kx <= ky
                    }
                }
                if x < mid && take_x {
                    store64(t + o * 8, load64(a + x * 8))
                    x += 1
                } else {
                    store64(t + o * 8, load64(a + y * 8))
                    y += 1
                }
                o += 1
            }
            lo += 2 * width
        }
        let sw = a
        a = t
        t = sw
        width *= 2
    }
    // переставить элементы по номерам
    let es = load64(h + 24)
    let data = load64(h)
    let copy = __alloc(n * es + 8)
    __memcpy(copy, data, n * es)
    i = 0
    while i < n {
        let from = load64(a + i * 8)
        if es == 1 {
            store8(data + i, load8(copy + from))
        } else {
            store64(data + i * 8, load64(copy + from * 8))
        }
        i += 1
    }
    return self
}

// ---- Длинные целые: [int] по 32 бита, младшие первыми ----
// Нужны для точного перевода десятичной записи в double и обратно.

fn __big_trim(a: [int]) {
    while a.len() > 0 && a[a.len() - 1] == 0 {
        a.pop()
    }
}

// a = a × m + add; m и add меньше 2^31.
fn __big_mul_add(a: [int], m: int, add: int) {
    var carry = add
    var i = 0
    while i < a.len() {
        let v = a[i] * m + carry
        a[i] = v & 0xFFFFFFFF
        carry = v >> 32
        i += 1
    }
    while carry > 0 {
        a.push(carry & 0xFFFFFFFF)
        carry = carry >> 32
    }
}

fn __big_word(a: [int], i: int) -> int {
    if i < a.len() {
        return a[i]
    }
    return 0
}

fn __big_bitlen(a: [int]) -> int {
    var n = a.len()
    while n > 0 && a[n - 1] == 0 {
        n -= 1
    }
    if n == 0 {
        return 0
    }
    var top = a[n - 1]
    var b = 0
    while top > 0 {
        b += 1
        top = top >> 1
    }
    return (n - 1) * 32 + b
}

fn __big_bit(a: [int], i: int) -> int {
    return (__big_word(a, i / 32) >> (i % 32)) & 1
}

// a << n — новое число.
fn __big_shl(a: [int], n: int) -> [int] {
    var r: [int] = []
    let bits = n % 32
    var w = 0
    while w < n / 32 {
        r.push(0)
        w += 1
    }
    var carry = 0
    for x in a {
        let v = (x << bits) | carry
        r.push(v & 0xFFFFFFFF)
        carry = v >> 32
    }
    if carry > 0 {
        r.push(carry)
    }
    return r
}

fn __big_cmp(a: [int], b: [int]) -> int {
    let la = __big_bitlen(a)
    let lb = __big_bitlen(b)
    if la != lb {
        if la < lb {
            return -1
        }
        return 1
    }
    var i = (la + 31) / 32 - 1
    while i >= 0 {
        let x = __big_word(a, i)
        let y = __big_word(b, i)
        if x != y {
            if x < y {
                return -1
            }
            return 1
        }
        i -= 1
    }
    return 0
}

// a -= b, где a >= b.
fn __big_sub(a: [int], b: [int]) {
    var borrow = 0
    var i = 0
    while i < a.len() {
        var v = a[i] - __big_word(b, i) - borrow
        borrow = 0
        if v < 0 {
            v += 0x100000000
            borrow = 1
        }
        a[i] = v
        i += 1
    }
}

// Частное n / d; n становится остатком.
fn __big_divmod(n: [int], d: [int]) -> [int] {
    var q: [int] = []
    let ln = __big_bitlen(n)
    var w = 0
    while w <= ln / 32 {
        q.push(0)
        w += 1
    }
    var r: [int] = []
    var i = ln - 1
    while i >= 0 {
        __big_mul_add(r, 2, __big_bit(n, i))
        if __big_cmp(r, d) >= 0 {
            __big_sub(r, d)
            q[i / 32] = q[i / 32] | (1 << (i % 32))
        }
        i -= 1
    }
    n.clear()
    for x in r {
        n.push(x)
    }
    __big_trim(n)
    __big_trim(q)
    return q
}

fn __big_pow10(e: int) -> [int] {
    var d: [int] = []
    d.push(1)
    var j = 0
    while j < e {
        __big_mul_add(d, 10, 0)
        j += 1
    }
    return d
}

// Десятичная мантисса (цифры в [p, p + n), точка пропускается) × 10^exp → биты
// double с округлением к ближайшему (при равенстве — к чётному). Знак — у вызывающего.
fn __dec_to_f64(p: int, n: int, exp: int) -> int {
    var x: [int] = []
    var e10 = exp
    var frac = false
    var nd = 0
    var i = 0
    while i < n {
        let c = load8(p + i)
        if c == '.' {
            frac = true
        } else if c >= '0' && c <= '9' {
            if x.len() > 0 || c != '0' {
                nd += 1
            }
            if nd <= 40 {
                __big_mul_add(x, 10, c - '0')
                if frac {
                    e10 -= 1
                }
            } else if !frac {
                e10 += 1
            }
        }
        i += 1
    }
    __big_trim(x)
    let bl = __big_bitlen(x)
    if bl == 0 {
        return 0
    }
    if e10 + nd > 310 {
        return 0x7FF0000000000000
    }
    if e10 + nd < -326 {
        return 0
    }
    var sticky = 0
    var exp2 = 0
    var q = x
    if e10 >= 0 {
        var j = 0
        while j < e10 {
            __big_mul_add(q, 10, 0)
            j += 1
        }
    } else {
        let d = __big_pow10(0 - e10)
        var k = __big_bitlen(d) - bl + 55
        if k < 0 {
            k = 0
        }
        let num = __big_shl(x, k)
        q = __big_divmod(num, d)
        if num.len() > 0 {
            sticky = 1
        }
        exp2 = 0 - k
    }
    // value = q × 2^exp2 (+ остаток); q → 53 бита
    let L = __big_bitlen(q)
    var mant = 0
    var shift = L - 53
    if shift <= 0 {
        var b = 0
        while b < L {
            if __big_bit(q, b) == 1 {
                mant = mant | (1 << b)
            }
            b += 1
        }
        mant = mant << (0 - shift)
    } else {
        var b = 0
        while b < 53 {
            if __big_bit(q, shift + b) == 1 {
                mant = mant | (1 << b)
            }
            b += 1
        }
        let half = __big_bit(q, shift - 1)
        var below = sticky
        b = 0
        while b < shift - 1 && below == 0 {
            if __big_bit(q, b) == 1 {
                below = 1
            }
            b += 1
        }
        if half == 1 && (below == 1 || (mant & 1) == 1) {
            mant += 1
            if mant == 0x20000000000000 {
                mant = mant >> 1
                shift += 1
            }
        }
    }
    let e = exp2 + shift + 52
    if e > 1023 {
        return 0x7FF0000000000000
    }
    if e < -1022 {
        // денормализованное число
        let sh = -1022 - e
        if sh > 53 {
            return 0
        }
        let half = (mant >> (sh - 1)) & 1
        let rest = mant & ((1 << (sh - 1)) - 1)
        var m = mant >> sh
        if half == 1 && (rest != 0 || sticky == 1 || (m & 1) == 1) {
            m += 1
        }
        return m
    }
    return ((e + 1023) << 52) | (mant & 0xFFFFFFFFFFFFF)
}

// Целое → биты double (точно до 2^53, дальше — с округлением).
fn __int_to_f64_bits(v: int) -> int {
    if v == 0 {
        return 0
    }
    var sign = 0
    if v < 0 {
        sign = 1 << 63
    }
    let s = __int_to_str(v)
    return sign | __dec_to_f64(__str_ptr(s), s.byte_len(), 0)
}

// x == v, где x — int? или bool? (ячейка или 0).
fn __opt_eq_word(box: int, v: int) -> bool {
    return box != 0 && load64(box) == v
}

// x == v, где x — str? (0 — none).
fn __opt_eq_str(a: int, b: int) -> bool {
    if a == 0 {
        return false
    }
    return __str_eq(__cast(a), __cast(b))
}

fn __list_sort_int(self: [int]) -> [int] {
    let h: int = __cast(self)
    __store_mut(h)
    __sort_words(load64(h), load64(h + 8), false)
    return self
}

fn __list_sort_str(self: [str]) -> [str] {
    let h: int = __cast(self)
    __store_mut(h)
    __sort_words(load64(h), load64(h + 8), true)
    return self
}

// ---- Словари ----
// Записи хранятся по порядку вставки в списках keys, vals и alive (1 — жива);
// slots — открытая адресация: номер записи + 1, 0 — пусто, -1 — удалено.
// Заголовок: [0] keys, [8] count, [16] vals, [24] alive, [32] slots, [40] mask,
// [48] строковые ключи, [56] удалённые записи.

fn __map_new(str_keys: int) -> int {
    let m = __alloc(64)
    store64(m, __list_new(8, 8))
    store64(m + 16, __list_new(8, 8))
    store64(m + 24, __list_new(8, 8))
    store64(m + 32, __alloc(16 * 8))
    store64(m + 40, 15)
    store64(m + 48, str_keys)
    return m
}

// Пустой словарь на n записей с видами объектов для кучи store: в заголовке
// ссылки — keys, vals, alive и slots (слова 0, 2, 3, 4); в массивах ссылки —
// строковые ключи и значения, если vals_ref; alive и slots — числа.
fn __map_new_k(str_keys: int, vals_ref: bool, n: int) -> int {
    var size = 16
    while size < n * 4 {
        size *= 2
    }
    let m = __alloc_k(64, K_MASK, 0x1D)
    store64(m, __list_new_k(n, 8, str_keys != 0))
    store64(m + 16, __list_new_k(n, 8, vals_ref))
    store64(m + 24, __list_new_k(n, 8, false))
    store64(m + 32, __alloc_k(size * 8, K_NOSCAN, 0))
    store64(m + 40, size - 1)
    store64(m + 48, str_keys)
    return m
}

// Пустой словарь на n записей: n вставок обходятся без перестройки.
fn __map_new_cap(str_keys: int, n: int) -> int {
    var size = 16
    while size < n * 4 {
        size *= 2
    }
    let m = __alloc(64)
    store64(m, __list_new(n, 8))
    store64(m + 16, __list_new(n, 8))
    store64(m + 24, __list_new(n, 8))
    store64(m + 32, __alloc(size * 8))
    store64(m + 40, size - 1)
    store64(m + 48, str_keys)
    return m
}

fn __map_hash(m: int, k: int) -> int {
    if load64(m + 48) != 0 {
        let p = load64(k)
        let n = load64(k + 8)
        var h = 5381
        var i = 0
        while i < n {
            h = (h * 33 + load8(p + i)) & 0xFFFFFFFFFFFF
            i += 1
        }
        return h
    }
    let lo = k & 0xFFFFFFF
    let hi = (k >> 28) & 0xFFFFFFF
    return (lo * 0x9E3779B) ^ (hi * 0x7FEB352) ^ (k >> 56)
}

fn __map_key_eq(m: int, a: int, b: int) -> bool {
    if load64(m + 48) != 0 {
        return __str_eq(__cast(a), __cast(b))
    }
    return a == b
}

fn __word_at(list: int, i: int) -> int {
    return load64(load64(list) + i * 8)
}

// Номер записи с ключом k или -1.
fn __map_find(m: int, k: int) -> int {
    let slots = load64(m + 32)
    let mask = load64(m + 40)
    var i = __map_hash(m, k) & mask
    while true {
        let e = load64(slots + i * 8)
        if e == 0 {
            return -1
        }
        if e > 0 && __map_key_eq(m, __word_at(load64(m), e - 1), k) {
            return e - 1
        }
        i = (i + 1) & mask
    }
    return -1
}

// Номер слота, где лежит запись idx.
fn __map_slot_of(m: int, k: int, idx: int) -> int {
    let slots = load64(m + 32)
    let mask = load64(m + 40)
    var i = __map_hash(m, k) & mask
    while load64(slots + i * 8) != idx + 1 {
        i = (i + 1) & mask
    }
    return i
}

fn __map_place(m: int, k: int, idx: int) {
    let slots = load64(m + 32)
    let mask = load64(m + 40)
    var i = __map_hash(m, k) & mask
    while load64(slots + i * 8) > 0 {
        i = (i + 1) & mask
    }
    store64(slots + i * 8, idx + 1)
}

// Перестройка: выбросить удалённые записи и увеличить таблицу.
fn __map_rehash(m: int) {
    let keys = load64(m)
    let vals = load64(m + 16)
    let alive = load64(m + 24)
    let n = load64(keys + 8)
    var w = 0
    var r = 0
    while r < n {
        if __word_at(alive, r) != 0 {
            store64(load64(keys) + w * 8, __word_at(keys, r))
            store64(load64(vals) + w * 8, __word_at(vals, r))
            store64(load64(alive) + w * 8, 1)
            w += 1
        }
        r += 1
    }
    if __in_store(m) {
        // слоты [w, n) освободились: в store в них не остаётся старых ссылок
        __memset(load64(keys) + w * 8, 0, (n - w) * 8)
        __memset(load64(vals) + w * 8, 0, (n - w) * 8)
        __memset(load64(alive) + w * 8, 0, (n - w) * 8)
    }
    store64(keys + 8, w)
    store64(vals + 8, w)
    store64(alive + 8, w)
    store64(m + 56, 0)
    var size = 16
    while size < w * 4 {
        size *= 2
    }
    store64(m + 32, __alloc_for_k(m, size * 8, K_NOSCAN, 0))
    store64(m + 40, size - 1)
    var i = 0
    while i < w {
        __map_place(m, __word_at(keys, i), i)
        i += 1
    }
}

fn __map_set(m: int, k: int, v: int) {
    __store_mut(m)
    let idx = __map_find(m, k)
    if idx >= 0 {
        store64(load64(load64(m + 16)) + idx * 8, v)
        return
    }
    let used = load64(load64(m) + 8) + 1
    if used * 2 > load64(m + 40) {
        __map_rehash(m)
    }
    let keys: [int] = __cast(load64(m))
    let vals: [int] = __cast(load64(m + 16))
    let alive: [int] = __cast(load64(m + 24))
    keys.push(k)
    vals.push(v)
    alive.push(1)
    store64(m + 8, load64(m + 8) + 1)
    __map_place(m, k, keys.len() - 1)
}

fn __map_get_ref(m: int, k: int) -> int {
    let idx = __map_find(m, k)
    if idx < 0 {
        return 0
    }
    return __word_at(load64(m + 16), idx)
}

fn __map_get_box(m: int, k: int) -> int {
    let idx = __map_find(m, k)
    if idx < 0 {
        return 0
    }
    let b = __alloc(8)
    store64(b, __word_at(load64(m + 16), idx))
    return b
}

fn __map_get_or0(m: int, k: int) -> int {
    let idx = __map_find(m, k)
    if idx < 0 {
        return 0
    }
    return __word_at(load64(m + 16), idx)
}

fn __map_get_or_empty(m: int, k: int) -> int {
    let idx = __map_find(m, k)
    if idx < 0 {
        let e: int = __cast("")
        return e
    }
    return __word_at(load64(m + 16), idx)
}

fn __map_has(m: int, k: int) -> bool {
    return __map_find(m, k) >= 0
}

// Удаляет ключ → значение или 0, если ключа не было.
fn __map_remove_word(m: int, k: int, found: int) -> int {
    __store_mut(m)
    store64(found, 0)
    let idx = __map_find(m, k)
    if idx < 0 {
        return 0
    }
    let s = __map_slot_of(m, k, idx)
    store64(load64(m + 32) + s * 8, -1)
    store64(load64(load64(m + 24)) + idx * 8, 0)
    store64(m + 8, load64(m + 8) - 1)
    store64(m + 56, load64(m + 56) + 1)
    store64(found, 1)
    let v = __word_at(load64(m + 16), idx)
    if __in_store(m) {
        // мёртвая запись в store не держит ни ключ, ни значение
        store64(load64(load64(m)) + idx * 8, 0)
        store64(load64(load64(m + 16)) + idx * 8, 0)
    }
    return v
}

fn __map_remove_ref(m: int, k: int) -> int {
    let found = __alloc(8)
    return __map_remove_word(m, k, found)
}

fn __map_remove_box(m: int, k: int) -> int {
    let found = __alloc(8)
    let v = __map_remove_word(m, k, found)
    if load64(found) == 0 {
        return 0
    }
    let b = __alloc(8)
    store64(b, v)
    return b
}

fn __map_collect(m: int, which: int, esize: int) -> int {
    let src = load64(m + which)
    let alive = load64(m + 24)
    let n = load64(src + 8)
    let out = __list_new(load64(m + 8), esize)
    let outl: [int] = __cast(out)
    var i = 0
    while i < n {
        if __word_at(alive, i) != 0 {
            outl.push(__word_at(src, i))
        }
        i += 1
    }
    return out
}

fn __map_keys(m: int) -> int {
    return __map_collect(m, 0, 8)
}

// esize — размер элемента результата: 1 для словарей с bool-значениями.
fn __map_values(m: int, esize: int) -> int {
    return __map_collect(m, 16, esize)
}

fn __map_clear(m: int) {
    __store_mut(m)
    if __in_store(m) {
        let n = load64(load64(m) + 8)
        __memset(load64(load64(m)), 0, n * 8)
        __memset(load64(load64(m + 16)), 0, n * 8)
        __memset(load64(load64(m + 24)), 0, n * 8)
    }
    store64(load64(m) + 8, 0)
    store64(load64(m + 16) + 8, 0)
    store64(load64(m + 24) + 8, 0)
    store64(m + 8, 0)
    store64(m + 56, 0)
    // словарь в store: новая таблица — тоже в постоянной памяти, не в арене
    store64(m + 32, __alloc_for_k(m, 16 * 8, K_NOSCAN, 0))
    store64(m + 40, 15)
}

fn __list_contains_bool(self: [bool], v: bool) -> bool {
    for x in self {
        if x == v {
            return true
        }
    }
    return false
}

fn __list_index_of_bool(self: [bool], v: bool) -> int? {
    var i = 0
    for x in self {
        if x == v {
            return i
        }
        i += 1
    }
    return none
}
