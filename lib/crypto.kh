// SHA-256, HMAC-SHA256 и PBKDF2: sha256(text), hash_password, check_password.
// Пароль хранится как «pbkdf2_sha256$итерации$соль$хеш» (соль — 16 случайных
// байт); проверка сравнивает без раннего выхода.

const PBKDF2_ITER = 100000

fn __hex_val(c: int) -> int {
    if c >= '0' && c <= '9' {
        return c - '0'
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10
    }
    if c >= 'A' && c <= 'F' {
        return c - 'A' + 10
    }
    return -1
}

// Таблицы констант живут всё время работы программы (mmap, не арена); если
// два потока построят их одновременно, одна страница просто лишняя.
var __k256: int
var __k512: int

// Константы K (64 слова по 32 бита) и за ними маска pshufb для SHA-NI.
fn __sha_kt() -> int {
    if __k256 != 0 {
        return __k256
    }
    let hex = "428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5 d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174 e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da 983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967 27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85 a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070 19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3 748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2"
    let t = __mmap(4096)
    var n = 0
    var v = 0
    for i in 0..hex.byte_len() {
        let c = hex.byte(i)
        if c == ' ' {
            store32(t + n * 4, v)
            n += 1
            v = 0
        } else {
            v = v * 16 + __hex_val(c)
        }
    }
    store32(t + n * 4, v)
    store64(t + 256, 0x0405060700010203)
    store64(t + 264, 0x0c0d0e0f08090a0b)
    __k256 = t
    return t
}

// Состояние — 8 слов по 32 бита.
fn __sha_init(st: int) {
    store32(st, 0x6a09e667)
    store32(st + 4, 0xbb67ae85)
    store32(st + 8, 0x3c6ef372)
    store32(st + 12, 0xa54ff53a)
    store32(st + 16, 0x510e527f)
    store32(st + 20, 0x9b05688c)
    store32(st + 24, 0x1f83d9ab)
    store32(st + 28, 0x5be0cd19)
}

// Один 64-байтовый блок p в состояние st; k — константы. Оба пути —
// машинный код компилятора: инструкции SHA-NI, если процессор их знает, иначе
// обычные 32-битные (src/simd.kh). w не нужен: расписание — на стеке.
fn __sha_block(st: int, p: int, k: int, w: int) {
    if __simd_sha {
        __simd_sha256(st, p, k)
        return
    }
    __sha256_x64(st, p, k)
}

// Состояние → 32 байта (старшими вперёд).
fn __sha_out(st: int, out: int) {
    for i in 0..8 {
        let v = load32(st + i * 4)
        store8(out + i * 4, (v >> 24) & 255)
        store8(out + i * 4 + 1, (v >> 16) & 255)
        store8(out + i * 4 + 2, (v >> 8) & 255)
        store8(out + i * 4 + 3, v & 255)
    }
}

// Последние байты сообщения [p, p + n) с дополнением; total — длина всего
// сообщения в байтах (вместе с уже сжатыми блоками).
fn __sha_finish(st: int, p: int, n: int, total: int, k: int, w: int) {
    let blk = __alloc(128)
    __memset(blk, 0, 128)
    __memcpy(blk, p, n)
    store8(blk + n, 0x80)
    var size = 64
    if n >= 56 {
        size = 128
    }
    let bits = total * 8
    for i in 0..8 {
        store8(blk + size - 1 - i, (bits >> (i * 8)) & 255)
    }
    __sha_block(st, blk, k, w)
    if size == 128 {
        __sha_block(st, blk + 64, k, w)
    }
}

fn __sha256(p: int, n: int, out: int) {
    let st = __alloc(32)
    let k = __sha_kt()
    let w = __alloc(512)
    __sha_init(st)
    let full = n / 64
    for i in 0..full {
        __sha_block(st, p + i * 64, k, w)
    }
    __sha_finish(st, p + full * 64, n - full * 64, n, k, w)
    __sha_out(st, out)
}

fn __hex_bytes(p: int, n: int) -> str {
    let digits = "0123456789abcdef"
    let b = buf_new(n * 2)
    for i in 0..n {
        let v = load8(p + i)
        buf_byte(b, digits.byte(v >> 4))
        buf_byte(b, digits.byte(v & 15))
    }
    return __str_new(b.data, b.len)
}

// SHA-256 текста — 64 шестнадцатеричные цифры.
fn sha256(text: str) -> str {
    let out = __alloc(32)
    __sha256(__str_ptr(text), text.byte_len(), out)
    return __hex_bytes(out, 32)
}

// ---- HMAC-SHA256 и PBKDF2 ----

// Состояние после блока «ключ ^ pad» (ключ длиннее 64 байт сначала хешируется).
fn __hmac_state(key: int, klen: int, pad: int, k: int, w: int) -> int {
    let blk = __alloc(64)
    __memset(blk, 0, 64)
    if klen > 64 {
        __sha256(key, klen, blk)
    } else {
        __memcpy(blk, key, klen)
    }
    for i in 0..64 {
        store8(blk + i, load8(blk + i) ^ pad)
    }
    let st = __alloc(32)
    __sha_init(st)
    __sha_block(st, blk, k, w)
    return st
}

// HMAC короткого (до 55 байт) сообщения по готовым состояниям ist и ost.
fn __hmac_short(ist: int, ost: int, msg: int, mlen: int, out: int, k: int, w: int, st: int) {
    __memcpy(st, ist, 32)
    __sha_finish(st, msg, mlen, 64 + mlen, k, w)
    let inner = __alloc(32)
    __sha_out(st, inner)
    __memcpy(st, ost, 32)
    __sha_finish(st, inner, 32, 96, k, w)
    __sha_out(st, out)
}

// Состояние → 32 байта digest в out (слова старшими байтами вперёд).
fn __sha_put(st: int, out: int) {
    for i in 0..8 {
        let v = load32(st + i * 4)
        store32(out + i * 4, ((v >> 24) & 0xFF) | ((v >> 8) & 0xFF00) | ((v << 8) & 0xFF0000) | ((v << 24) & 0xFF000000))
    }
}

// Блок для хеша 32 байт после блока ключа: [32 байта | 0x80 | нули | длина 768 бит].
fn __hmac32_block() -> int {
    let b = __alloc(64)
    __memset(b, 0, 64)
    store8(b + 32, 0x80)
    store8(b + 62, 0x03)
    return b
}

// PBKDF2-HMAC-SHA256, 32 байта результата. Каждая итерация — два сжатия
// по готовым блокам, без выделения памяти.
fn __pbkdf2(pw: str, salt: int, slen: int, iter: int, out: int) {
    let k = __sha_kt()
    let w = __alloc(512)
    let st = __alloc(32)
    let ist = __hmac_state(__str_ptr(pw), pw.byte_len(), 0x36, k, w)
    let ost = __hmac_state(__str_ptr(pw), pw.byte_len(), 0x5c, k, w)
    let msg = __alloc(64)
    __memcpy(msg, salt, slen)
    store32(msg + slen, 0x01000000)
    let ib = __hmac32_block()
    let ob = __hmac32_block()
    __hmac_short(ist, ost, msg, slen + 4, ib, k, w, st)
    __memcpy(out, ib, 32)
    for i in 1..iter {
        if (i & 1023) == 0 {
            // 16 мс вычислений не держат весь поток: другие запросы идут между частями
            __co_yield()
        }
        __memcpy(st, ist, 32)
        __sha_block(st, ib, k, w)
        __sha_put(st, ob)
        __memcpy(st, ost, 32)
        __sha_block(st, ob, k, w)
        __sha_put(st, ib)
        for j in 0..4 {
            store64(out + j * 8, load64(out + j * 8) ^ load64(ib + j * 8))
        }
    }
}

// PBKDF2 считается без блокировки store, как fetch ждёт сеть: медленная
// проверка пароля не задерживает остальные запросы.
fn __pbkdf2_unlocked(pw: str, salt: int, slen: int, iter: int, out: int) {
    let held = load64(__ctx() + CTX_STORE_HELD) != 0
    if held {
        __store_unlock()
    }
    __pbkdf2(pw, salt, slen, iter, out)
    if held {
        __store_lock()
    }
}

fn __unhex(s: str, out: int) -> int {
    let n = s.byte_len() / 2
    for i in 0..n {
        store8(out + i, __hex_val(s.byte(2 * i)) * 16 + __hex_val(s.byte(2 * i + 1)))
    }
    return n
}

// Пароль для хранения: соль и медленный хеш, сам пароль не восстановить.
fn hash_password(password: str) -> str {
    let salt = __alloc(16)
    __random_bytes(salt, 16)
    let dk = __alloc(32)
    __pbkdf2_unlocked(password, salt, 16, PBKDF2_ITER, dk)
    return "pbkdf2_sha256$" + PBKDF2_ITER.to_str() + "$" + __hex_bytes(salt, 16) + "$" + __hex_bytes(dk, 32)
}

fn check_password(password: str, stored: str) -> bool {
    let parts = stored.split("$")
    if parts.len() != 4 || parts[0] != "pbkdf2_sha256" || parts[2].byte_len() > 64 {
        return false
    }
    let iter = parts[1].to_int() ?? 0
    if iter < 1 {
        return false
    }
    let salt = __alloc(32)
    let slen = __unhex(parts[2], salt)
    let dk = __alloc(32)
    __pbkdf2_unlocked(password, salt, slen, iter, dk)
    let got = __hex_bytes(dk, 32)
    if got.byte_len() != parts[3].byte_len() {
        return false
    }
    // без раннего выхода: время сравнения не зависит от места расхождения
    var diff = 0
    for i in 0..got.byte_len() {
        diff = diff | (got.byte(i) ^ parts[3].byte(i))
    }
    return diff == 0
}

// ---- SHA-512, SHA-384 и хеш по частям (для TLS) ----

// 64-битные слова из шестнадцатеричной строки «слово слово ...» в p: по
// половинам, потому что такие числа не помещаются в int со знаком.
fn __hex_words64(hex: str, p: int) {
    var n = 0
    var i = 0
    while i + 16 <= hex.byte_len() {
        var hi = 0
        var lo = 0
        for j in 0..8 {
            hi = hi * 16 + __hex_val(hex.byte(i + j))
            lo = lo * 16 + __hex_val(hex.byte(i + 8 + j))
        }
        store32(p + n * 8, lo)
        store32(p + n * 8 + 4, hi)
        n += 1
        i += 17
    }
}

// Константы SHA-512: 80 слов.
fn __sha512_kt() -> int {
    if __k512 != 0 {
        return __k512
    }
    let t = __mmap(4096)
    __hex_words64("428a2f98d728ae22 7137449123ef65cd b5c0fbcfec4d3b2f e9b5dba58189dbbc 3956c25bf348b538 59f111f1b605d019 923f82a4af194f9b ab1c5ed5da6d8118 d807aa98a3030242 12835b0145706fbe 243185be4ee4b28c 550c7dc3d5ffb4e2 72be5d74f27b896f 80deb1fe3b1696b1 9bdc06a725c71235 c19bf174cf692694 e49b69c19ef14ad2 efbe4786384f25e3 0fc19dc68b8cd5b5 240ca1cc77ac9c65 2de92c6f592b0275 4a7484aa6ea6e483 5cb0a9dcbd41fbd4 76f988da831153b5 983e5152ee66dfab a831c66d2db43210 b00327c898fb213f bf597fc7beef0ee4 c6e00bf33da88fc2 d5a79147930aa725 06ca6351e003826f 142929670a0e6e70 27b70a8546d22ffc 2e1b21385c26c926 4d2c6dfc5ac42aed 53380d139d95b3df 650a73548baf63de 766a0abb3c77b2a8 81c2c92e47edaee6 92722c851482353b a2bfe8a14cf10364 a81a664bbc423001 c24b8b70d0f89791 c76c51a30654be30 d192e819d6ef5218 d69906245565a910 f40e35855771202a 106aa07032bbd1b8 19a4c116b8d2d0c8 1e376c085141ab53 2748774cdf8eeb99 34b0bcb5e19b48a8 391c0cb3c5c95a63 4ed8aa4ae3418acb 5b9cca4f7763e373 682e6ff3d6b2b8a3 748f82ee5defb2fc 78a5636f43172f60 84c87814a1f0ab72 8cc702081a6439ec 90befffa23631e28 a4506cebde82bde9 bef9a3f7b2c67915 c67178f2e372532b ca273eceea26619c d186b8c721c0c207 eada7dd6cde0eb1e f57d4f7fee6ed178 06f067aa72176fba 0a637dc5a2c898a6 113f9804bef90dae 1b710b35131c471b 28db77f523047d84 32caab7b40c72493 3c9ebe0a15c9bebc 431d67c49c100d4c 4cc5d4becb3e42b6 597f299cfc657e2a 5fcb6fab3ad6faec 6c44198c4a475817", t)
    __k512 = t
    return t
}

// Хеш по частям: SHA-256 (32 байта), SHA-384 (48) или SHA-512 (64). Копия (__hash_copy)
// позволяет взять хеш начала сообщения и продолжить — так считает TLS.
type __Hash {
    // длина результата: 32, 48 или 64
    size: int
    // состояние (8 слов по 32 или 64 бита), неполный блок и его длина
    st: int
    blk: int
    n: int
    total: int
    // константы K
    k: int
}

fn __hash_block_len(h: __Hash) -> int {
    if h.size == 32 {
        return 64
    }
    return 128
}

fn __hash_new(size: int) -> __Hash {
    let st = __alloc(64)
    var k = 0
    if size == 32 {
        __sha_init(st)
        k = __sha_kt()
    } else if size == 64 {
        __hex_words64("6a09e667f3bcc908 bb67ae8584caa73b 3c6ef372fe94f82b a54ff53a5f1d36f1 510e527fade682d1 9b05688c2b3e6c1f 1f83d9abfb41bd6b 5be0cd19137e2179", st)
        k = __sha512_kt()
    } else {
        __hex_words64("cbbb9d5dc1059ed8 629a292a367cd507 9159015a3070dd17 152fecd8f70e5939 67332667ffc00b31 8eb44a8768581511 db0c2e0d64f98fa7 47b5481dbefa4fa4", st)
        k = __sha512_kt()
    }
    return __Hash { size, st, blk: __alloc(128), n: 0, total: 0, k }
}

fn __hash_compress(h: __Hash, p: int) {
    if h.size == 32 {
        __sha_block(h.st, p, h.k, 0)
    } else {
        __sha512_x64(h.st, p, h.k)
    }
}

fn __hash_update(h: __Hash, p: int, n: int) {
    let bl = __hash_block_len(h)
    var i = 0
    h.total += n
    if h.n > 0 {
        let take = (bl - h.n).min(n)
        __memcpy(h.blk + h.n, p, take)
        h.n += take
        i = take
        if h.n < bl {
            return
        }
        __hash_compress(h, h.blk)
        h.n = 0
    }
    while i + bl <= n {
        __hash_compress(h, p + i)
        i += bl
    }
    __memcpy(h.blk, p + i, n - i)
    h.n = n - i
}

fn __hash_copy(h: __Hash) -> __Hash {
    let c = __Hash { size: h.size, st: __alloc(64), blk: __alloc(128), n: h.n, total: h.total, k: h.k }
    __memcpy(c.st, h.st, 64)
    __memcpy(c.blk, h.blk, 128)
    return c
}

// Результат в out; сам h после этого не годится — нужна копия до вызова.
fn __hash_final(h: __Hash, out: int) {
    let bl = __hash_block_len(h)
    let lenb = bl / 8
    __memset(h.blk + h.n, 0, bl - h.n)
    store8(h.blk + h.n, 0x80)
    if h.n + 1 > bl - lenb {
        __hash_compress(h, h.blk)
        __memset(h.blk, 0, bl)
    }
    let bits = h.total * 8
    for i in 0..8 {
        store8(h.blk + bl - 1 - i, (bits >> (i * 8)) & 255)
    }
    __hash_compress(h, h.blk)
    if h.size == 32 {
        __sha_out(h.st, out)
        return
    }
    for i in 0..h.size / 8 {
        let lo = load32(h.st + i * 8)
        let hi = load32(h.st + i * 8 + 4)
        for j in 0..4 {
            store8(out + i * 8 + j, (hi >> (24 - j * 8)) & 255)
            store8(out + i * 8 + 4 + j, (lo >> (24 - j * 8)) & 255)
        }
    }
}

fn __hash(size: int, p: int, n: int, out: int) {
    let h = __hash_new(size)
    __hash_update(h, p, n)
    __hash_final(h, out)
}

// HMAC с SHA-256 (size 32), SHA-384 (48) или SHA-512 (64).
fn __hmac(size: int, key: int, klen: int, msg: int, mlen: int, out: int) {
    var bl = 128
    if size == 32 {
        bl = 64
    }
    let k0 = __alloc(128)
    __memset(k0, 0, 128)
    if klen > bl {
        __hash(size, key, klen, k0)
    } else {
        __memcpy(k0, key, klen)
    }
    let pad = __alloc(128)
    for i in 0..bl {
        store8(pad + i, load8(k0 + i) ^ 0x36)
    }
    let inner = __hash_new(size)
    __hash_update(inner, pad, bl)
    __hash_update(inner, msg, mlen)
    let ih = __alloc(64)
    __hash_final(inner, ih)
    for i in 0..bl {
        store8(pad + i, load8(k0 + i) ^ 0x5c)
    }
    let outer = __hash_new(size)
    __hash_update(outer, pad, bl)
    __hash_update(outer, ih, size)
    __hash_final(outer, out)
}

// HKDF (RFC 5869): извлечь ключ из ikm с солью.
fn __hkdf_extract(size: int, salt: int, slen: int, ikm: int, ilen: int, out: int) {
    __hmac(size, salt, slen, ikm, ilen, out)
}

// HKDF-Expand: len байт ключевого материала из prk и info.
fn __hkdf_expand(size: int, prk: int, info: int, ilen: int, out: int, len: int) {
    let t = __alloc(64 + ilen + 1)
    var tlen = 0
    var done = 0
    var i = 1
    let block = __alloc(64)
    while done < len {
        __memcpy(t + tlen, info, ilen)
        store8(t + tlen + ilen, i)
        __hmac(size, prk, size, t, tlen + ilen + 1, block)
        let take = (len - done).min(size)
        __memcpy(out + done, block, take)
        done += take
        __memcpy(t, block, size)
        tlen = size
        i += 1
    }
}

// HKDF-Expand-Label из TLS 1.3 (RFC 8446, 7.1): метка «tls13 label».
fn __hkdf_label(size: int, secret: int, label: str, ctx: int, clen: int, out: int, len: int) {
    let full = "tls13 " + label
    let info = __alloc(4 + full.byte_len() + clen)
    store8(info, len >> 8)
    store8(info + 1, len & 255)
    store8(info + 2, full.byte_len())
    __memcpy(info + 3, __str_ptr(full), full.byte_len())
    store8(info + 3 + full.byte_len(), clen)
    __memcpy(info + 4 + full.byte_len(), ctx, clen)
    __hkdf_expand(size, secret, info, 4 + full.byte_len() + clen, out, len)
}
