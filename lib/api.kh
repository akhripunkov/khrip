// API-слой: описания типов, копирование в постоянную память (store), JSON,
// ответы маршрутов, разбор параметров, тесты. Подключается к программам,
// где есть route, store или test (и к тем, что вызывают to_json/from_json).
//
// Описание типа строит компилятор (type_desc в src/api.kh), оно лежит в данных
// программы. Слова описания:
//   str, int, bool — [D_STR], [D_INT], [D_BOOL]
//   [T]            — [D_LIST, T]
//   map[K, V]      — [D_MAP, K, V]
//   T?             — [D_OPT, T]
//   структура      — [D_STRUCT, n, имя, метка, поле × n, маска ссылок]; поле —
//                    5 слов: имя, «"имя":», описание, вид значения по умолчанию и
//                    оно само (0 — нет, 1 — слово, 2 — пустой список с размером
//                    элемента, 3 — пустой словарь); метка ≥ 0 у вариантов (лежит
//                    по адресу − 8); маска: бит i — поле i ссылка, бит 63 — полей
//                    больше 63 (для кучи store, __struct_alloc)
//   вариант        — [D_SUM, n, имя, все без полей?, (имя, описание, значение
//                    варианта без полей или 0) × n]

const D_STR = 1
const D_INT = 2
const D_BOOL = 3
const D_LIST = 4
const D_MAP = 5
const D_OPT = 6
const D_STRUCT = 7
const D_SUM = 8
const D_FLOAT = 9

const CT_TEXT = 1
const CT_JSON = 2

// Ответ теста на вызов call.
type Response {
    status: int
    body: str
    // имена заголовков — строчными буквами
    headers: map[str, str] = {}
}

type __Req {
    method: str
    path: str
    query: str
    body: str
    // строки заголовков «Имя: значение\r\n...»
    headers: str = ""
}

// Состояние обработки запросов потока (CTX_WORKER).
type __Worker {
    status: int
    ctype: int
    body: Buf
    jb: int
    json_err: str
    testing: bool
    // текущий запрос (__Req) или 0; заголовки ответа от set_header
    cur: int
    extra: Buf
    // код из fail() или 0
    failed: int
}

fn __w() -> __Worker {
    return __cast(load64(__ctx() + CTX_WORKER))
}

// Буферы ответа живут дольше запроса и растут через mmap (buf_mm): не за счёт
// арены запроса и не в store.
fn __worker_new() -> __Worker {
    return __Worker { status: 0, ctype: 0, body: buf_mm(4096), jb: __alloc(64), json_err: "", testing: false, cur: 0, extra: buf_mm(4096), failed: 0 }
}

fn __worker_init() -> __Worker {
    let w = __worker_new()
    store64(__ctx() + CTX_WORKER, __cast(w))
    return w
}

fn __is_scalar(d: int) -> bool {
    let k = load64(d)
    return k == D_INT || k == D_BOOL || k == D_FLOAT
}

fn __field(d: int, i: int) -> int {
    return d + 32 + i * 40
}

fn __field_desc(d: int, i: int) -> int {
    return load64(d + 32 + i * 40 + 16)
}

// Память под структуру по описанию: у варианта перед полями — метка. Хотя бы
// одно слово: у структур без полей разные адреса, как у всех объектов.
fn __struct_alloc(d: int) -> int {
    var n = load64(d + 8)
    if n < 1 {
        n = 1
    }
    let tag = load64(d + 24)
    if __store_on() {
        // в store: виды слов — по маске описания (lib/gc.kh)
        return __struct_salloc(d, n, tag)
    }
    if tag < 0 {
        return __alloc(n * 8)
    }
    let p = __alloc(n * 8 + 8)
    store64(p, tag)
    return p + 8
}

// Описание варианта значения v типа-варианта d.
fn __variant_entry(d: int, v: int) -> int {
    let tag = load64(v - 8)
    let n = load64(d + 8)
    for i in 0..n {
        let e = d + 32 + i * 24
        if load64(load64(e + 8) + 24) == tag {
            return e
        }
    }
    return 0
}

// ---- Копирование в постоянную память ----
// Store ссылается только на store и на данные программы (DATA: литералы,
// варианты без полей). Арена освобождается после ответа, а обычная память
// потока (строки из файла KHRIP_DATA, env) store не принадлежит. Поэтому
// значение, которое кладут внутрь объекта вне арены, копируется, если оно не в
// store и не в DATA. Барьеры для сборщика (__barrier_at, __barrier_idx,
// __persist_root) — шаг 6 docs/design/v0.13-store-gc.md. __in_store — в
// lib/core.kh.

// DATA — [DATA_BASE, __data_end()), DATA_BASE = 0x20000000 (src/emit.kh).
fn __in_data(p: int) -> bool {
    return p >= 0x20000000 && p < __data_end()
}

fn __barrier(obj: int, v: int, d: int) -> int {
    if __in_arena(obj) || v == 0 || __in_store(v) || __in_data(v) {
        return v
    }
    return __persist_copy(v, d)
}

fn __persist(v: int, d: int) -> int {
    if __is_scalar(d) || v == 0 || __in_store(v) || __in_data(v) {
        return v
    }
    return __persist_copy(v, d)
}

fn __persist_copy(v: int, d: int) -> int {
    if !__gc_ready {
        // store ещё нет (глобальные до __store_init, main программы с test):
        // всё живёт в обычной памяти, копировать некуда
        return v
    }
    let on = __pmode_on()
    let r = __deep_copy(v, d)
    if on {
        __pmode_off()
    }
    return r
}

// Память под состояние копии st (st = 0 — под само состояние) в арене, пока
// выделение идёт из store: через сохранённый курсор CTX_PSAVE_PTR (вне store —
// обычное выделение). Нулевая, как у __alloc. Если в арене запроса до запаса
// ARENA_RESERVE места уже нет, — отдельный кусок mmap (заголовок: следующий
// кусок, размер; список — в st + 48), его вернёт системе __deep_copy: копия не
// должна обрывать запрос паникой «нет памяти» там, где ей хватило бы своей.
fn __dc_alloc(st: int, n: int) -> int {
    let c = __ctx()
    let p = load64(c + CTX_PSAVE_PTR)
    if p == 0 {
        return __alloc(n)
    }
    let size = (n + 15) & ~15
    if p + size <= load64(c + CTX_PSAVE_END) {
        store64(c + CTX_PSAVE_PTR, p + size)
        return p
    }
    let a = load64(c + CTX_ARENA)
    if __in_arena(p) && p + size > a + __arena_size(a) - ARENA_RESERVE {
        let q = __mmap(size + 16)
        store64(q + 8, size + 16)
        if st != 0 {
            store64(q, load64(st + 48))
            store64(st + 48, q)
        }
        return q + 16
    }
    // место кончилось: обычный путь (он подключит память арены), потом снова
    // store
    __pmode_off()
    let q = __alloc(size)
    __pmode_on()
    return q
}

// Хеш адреса объекта: объекты выровнены на 16 байт.
fn __addr_hash(p: int) -> int {
    let x = p >> 4
    return ((x & 0xFFFFFFF) * 0x9E3779B) ^ ((x >> 28) * 0x7FEB352)
}

// Копия значения v (описание d) в текущей памяти — в store, его включил
// __persist_copy. Без рекурсии: стек работы из троек (слот, значение, описание)
// и таблица пересылки «исходный адрес → копия». Оболочка копии создаётся и
// попадает в таблицу раньше детей, поэтому каждый объект копируется один раз:
// общие части значения остаются общими, а циклы не зацикливают копирование.
// В оболочку сначала ложатся исходные слова, слоты детей, которые надо
// копировать, стек перезаписывает потом. Строки и ячейки T? — листья.
// Состояние — в арене (через сохранённый курсор, __dc_alloc), не в store: [0]
// таблица пересылки, [8] пар в ней, [16] её размер в парах, [24] стек, [32]
// троек в нём, [40] его размер, [48] куски mmap, если арена кончилась. До 16
// пар таблица — перебор, дальше — открытая адресация, заполненная не больше
// чем наполовину.
fn __deep_copy(v: int, d: int) -> int {
    if __dc_leaf(d) {
        // строка или ячейка T?: таблицы не нужны
        return __dc_copy(0, v, d)
    }
    let c = __ctx()
    let mark = load64(c + CTX_PSAVE_PTR)
    let st = __dc_alloc(0, 64 + 16 * 16 + 8 * 24)
    if __in_arena(mark) && !__in_arena(st) {
        // само состояние — в куске mmap: он первый в списке
        store64(st + 48, st - 16)
    }
    store64(st, st + 64)
    store64(st + 16, 16)
    store64(st + 24, st + 64 + 16 * 16)
    store64(st + 40, 8)
    let r = __dc_copy(st, v, d)
    while load64(st + 32) > 0 {
        let n = load64(st + 32) - 1
        store64(st + 32, n)
        let e = load64(st + 24) + n * 24
        let slot = load64(e)
        store64(slot, __dc_copy(st, load64(e + 8), load64(e + 16)))
    }
    // состояние больше не нужно: арена непрерывна, и место снова свободно (и
    // снова нулевое, как обещает выделитель); куски mmap — системе
    if __in_arena(mark) {
        var q = load64(st + 48)
        while q != 0 {
            let next = load64(q)
            syscall(SYS_MUNMAP, q, load64(q + 8))
            q = next
        }
        __memset(mark, 0, load64(c + CTX_PSAVE_PTR) - mark)
        store64(c + CTX_PSAVE_PTR, mark)
    }
    return r
}

// Значение типа d — лист: строка или ячейка T? (в том числе под T? ссылки).
fn __dc_leaf(d: int) -> bool {
    var t = d
    while load64(t) == D_OPT {
        if __is_scalar(load64(t + 8)) {
            return true
        }
        t = load64(t + 8)
    }
    return load64(t) == D_STR
}

fn __dc_copy(st: int, v: int, d: int) -> int {
    let k = load64(d)
    if k == D_INT || k == D_BOOL || k == D_FLOAT || v == 0 || __in_store(v) || __in_data(v) {
        return v
    }
    if k == D_STR {
        let s = __str_copy_store(load64(v), load64(v + 8))
        return __cast(s)
    }
    if k == D_OPT {
        let inner = load64(d + 8)
        if __is_scalar(inner) {
            let b = __alloc_k(8, K_NOSCAN, 0)
            store64(b, load64(v))
            return b
        }
        return __dc_copy(st, v, inner)
    }
    let f = __dc_find(st, v)
    if f != 0 {
        return f
    }
    if k == D_LIST {
        let ed = load64(d + 8)
        let n = load64(v + 8)
        let es = load64(v + 24)
        let h = __list_new_k(n, es, !__is_scalar(ed))
        __dc_put(st, v, h)
        let data = load64(h)
        __memcpy(data, load64(v), n * es)
        store64(h + 8, n)
        if !__is_scalar(ed) {
            for i in 0..n {
                __dc_push(st, data + i * 8, load64(data + i * 8), ed)
            }
        }
        return h
    }
    if k == D_MAP {
        return __dc_map(st, v, d)
    }
    var sd = d
    if k == D_SUM {
        let e = __variant_entry(d, v)
        if e == 0 {
            return v
        }
        sd = load64(e + 8)
    } else if k != D_STRUCT {
        return v
    }
    let n = load64(sd + 8)
    let s = __struct_alloc(sd)
    __dc_put(st, v, s)
    __memcpy(s, v, n * 8)
    for i in 0..n {
        let fd = __field_desc(sd, i)
        if !__is_scalar(fd) {
            __dc_push(st, s + i * 8, load64(s + i * 8), fd)
        }
    }
    return s
}

// Словарь: живые записи — по порядку, сразу с ключами (ключи — листья),
// значения-ссылки — через стек работы. Перестройки во время копии нет.
fn __dc_map(st: int, v: int, d: int) -> int {
    let kd = load64(d + 8)
    let vd = load64(d + 16)
    let m = __map_new_k(load64(v + 48), !__is_scalar(vd), load64(v + 8))
    __dc_put(st, v, m)
    let keys = load64(load64(m))
    let vals = load64(load64(m + 16))
    let alive = load64(load64(m + 24))
    let refs = !__is_scalar(vd)
    let n = load64(load64(v) + 8)
    var w = 0
    for i in 0..n {
        if __word_at(load64(v + 24), i) != 0 {
            let key = __dc_copy(st, __word_at(load64(v), i), kd)
            store64(keys + w * 8, key)
            store64(vals + w * 8, __word_at(load64(v + 16), i))
            store64(alive + w * 8, 1)
            __map_place(m, key, w)
            if refs {
                __dc_push(st, vals + w * 8, load64(vals + w * 8), vd)
            }
            w += 1
        }
    }
    store64(load64(m) + 8, w)
    store64(load64(m + 16) + 8, w)
    store64(load64(m + 24) + 8, w)
    store64(m + 8, w)
    return m
}

// Копия src из таблицы пересылки или 0.
fn __dc_find(st: int, src: int) -> int {
    let t = load64(st)
    let cap = load64(st + 16)
    if cap == 16 {
        let n = load64(st + 8)
        for i in 0..n {
            if load64(t + i * 16) == src {
                return load64(t + i * 16 + 8)
            }
        }
        return 0
    }
    var i = __addr_hash(src) & (cap - 1)
    while true {
        let k = load64(t + i * 16)
        if k == src {
            return load64(t + i * 16 + 8)
        }
        if k == 0 {
            return 0
        }
        i = (i + 1) & (cap - 1)
    }
    return 0
}

fn __dc_put(st: int, src: int, dst: int) {
    let n = load64(st + 8)
    let cap = load64(st + 16)
    store64(st + 8, n + 1)
    if cap == 16 && n < 16 {
        let t = load64(st)
        store64(t + n * 16, src)
        store64(t + n * 16 + 8, dst)
        return
    }
    if (n + 1) * 2 > cap {
        // таблица вдвое больше (после перебора — сразу на 64 пары)
        var ncap = cap * 2
        if cap == 16 {
            ncap = 64
        }
        let old = load64(st)
        let t = __dc_alloc(st, ncap * 16)
        for i in 0..cap {
            let k = load64(old + i * 16)
            if k != 0 {
                __dc_place(t, ncap, k, load64(old + i * 16 + 8))
            }
        }
        store64(st, t)
        store64(st + 16, ncap)
    }
    __dc_place(load64(st), load64(st + 16), src, dst)
}

fn __dc_place(t: int, cap: int, src: int, dst: int) {
    var i = __addr_hash(src) & (cap - 1)
    while load64(t + i * 16) != 0 {
        i = (i + 1) & (cap - 1)
    }
    store64(t + i * 16, src)
    store64(t + i * 16 + 8, dst)
}

// Слот slot получит копию src. Если копировать не нужно, в слоте уже src.
fn __dc_push(st: int, slot: int, src: int, d: int) {
    if src == 0 || __in_store(src) || __in_data(src) {
        return
    }
    let n = load64(st + 32)
    let cap = load64(st + 40)
    if n == cap {
        let s = __dc_alloc(st, cap * 2 * 24)
        __memcpy(s, load64(st + 24), n * 24)
        store64(st + 24, s)
        store64(st + 40, cap * 2)
    }
    let e = load64(st + 24) + n * 24
    store64(e, slot)
    store64(e + 8, src)
    store64(e + 16, d)
    store64(st + 32, n + 1)
}

// ---- JSON: запись ----
// Глубину пути считает слово CTX_JDEPTH: вход в список, словарь, структуру или
// вариант — +1, выход — −1. Глубже JSON_DEEP структуры на пути отмечаются в
// множестве CTX_JPATH: всякий цикл проходит через структуру (список или словарь
// без неё не содержит сам себя), и встреча структуры, которая уже на пути, —
// цикл. Глубже JSON_MAX_DEPTH — паника ради стека.

const JSON_DEEP = 1000
const JSON_MAX_DEPTH = 10000
// размер множества: на пути не бывает больше JSON_MAX_DEPTH − JSON_DEEP
// структур, так что оно заполнено не больше чем на 55%
const JSON_PATH_SLOTS = 16384

// Начало записи: глубина и множество — с нуля (паника в прошлой записи могла
// оставить их какими угодно).
fn __json_begin() {
    let c = __ctx()
    store64(c + CTX_JDEPTH, 0)
    store64(c + CTX_JPATH, 0)
}

fn __json_in(v: int, d: int) {
    let c = __ctx()
    let n = load64(c + CTX_JDEPTH) + 1
    store64(c + CTX_JDEPTH, n)
    if n > JSON_DEEP {
        __json_path_add(v, d, n)
    }
}

fn __json_out(v: int, d: int) {
    let c = __ctx()
    let n = load64(c + CTX_JDEPTH)
    store64(c + CTX_JDEPTH, n - 1)
    if n > JSON_DEEP && load64(d) == D_STRUCT {
        __json_path_del(v)
    }
}

// Множество структур на пути: открытая адресация, 0 — пусто. Структуры уходят
// с пути в обратном порядке, поэтому удалить — просто обнулить слот: цепочки
// проб оставшихся (они вставлены раньше) через него не идут.
fn __json_path_add(v: int, d: int, n: int) {
    if n > JSON_MAX_DEPTH {
        __panic_msg("value is nested deeper than 10000 levels")
    }
    if load64(d) != D_STRUCT {
        return
    }
    let c = __ctx()
    var set = load64(c + CTX_JPATH)
    if set == 0 {
        set = __alloc(JSON_PATH_SLOTS * 8)
        store64(c + CTX_JPATH, set)
    }
    var i = __addr_hash(v) & (JSON_PATH_SLOTS - 1)
    while load64(set + i * 8) != 0 {
        if load64(set + i * 8) == v {
            let name: str = __cast(load64(d + 16))
            __panic_msg("value has a cycle at " + name)
        }
        i = (i + 1) & (JSON_PATH_SLOTS - 1)
    }
    store64(set + i * 8, v)
}

fn __json_path_del(v: int) {
    let set = load64(__ctx() + CTX_JPATH)
    var i = __addr_hash(v) & (JSON_PATH_SLOTS - 1)
    while load64(set + i * 8) != v && load64(set + i * 8) != 0 {
        i = (i + 1) & (JSON_PATH_SLOTS - 1)
    }
    store64(set + i * 8, 0)
}

fn __hex_digit(x: int) -> int {
    if x < 10 {
        return '0' + x
    }
    return 'a' + x - 10
}

// Строка JSON в кавычках. Безопасные участки копируются целиком.
fn __json_str(b: Buf, s: str) {
    let p = __str_ptr(s)
    let n = s.byte_len()
    buf_reserve(b, n + 2)
    buf_byte(b, '"')
    var start = 0
    var i = 0
    while true {
        i += __find_json_special(p + i, n - i)
        if i >= n {
            break
        }
        let c = load8(p + i)
        buf_add_raw(b, p + start, i - start)
        if c == '"' {
            buf_add(b, "\\\"")
        } else if c == '\\' {
            buf_add(b, "\\\\")
        } else if c == '\n' {
            buf_add(b, "\\n")
        } else if c == '\r' {
            buf_add(b, "\\r")
        } else if c == '\t' {
            buf_add(b, "\\t")
        } else {
            buf_add(b, "\\u00")
            buf_byte(b, __hex_digit(c >> 4))
            buf_byte(b, __hex_digit(c & 15))
        }
        i += 1
        start = i
    }
    buf_add_raw(b, p + start, n - start)
    buf_byte(b, '"')
}

// Стек на уровень вложенности — маленький кадр __json_enc и кадр функции
// контейнера (T? раскрывается без своего кадра): 10000 уровней помещаются в
// стек потока.
fn __json_enc(b: Buf, v: int, d: int) {
    var x = v
    var t = d
    var k = load64(t)
    while k == D_OPT {
        if x == 0 {
            buf_add(b, "null")
            return
        }
        t = load64(t + 8)
        k = load64(t)
        if k == D_INT || k == D_BOOL || k == D_FLOAT {
            x = load64(x)
        }
    }
    if k == D_STRUCT {
        __json_enc_struct(b, x, t)
    } else if k == D_LIST {
        __json_enc_list(b, x, t)
    } else if k == D_SUM {
        __json_enc_sum(b, x, t)
    } else if k == D_MAP {
        __json_enc_map(b, x, t)
    } else {
        __json_enc_scalar(b, x, k)
    }
}

fn __json_enc_scalar(b: Buf, v: int, k: int) {
    if k == D_INT {
        buf_int(b, v)
        return
    }
    if k == D_STR {
        __json_str(b, __cast(v))
        return
    }
    if k == D_FLOAT {
        // бесконечность и NaN в JSON не записать
        if (v >> 52) & 0x7FF == 0x7FF {
            buf_add(b, "null")
            return
        }
        __json_float(b, v)
        return
    }
    if k == D_BOOL {
        if v != 0 {
            buf_add(b, "true")
        } else {
            buf_add(b, "false")
        }
    }
}

fn __json_enc_struct(b: Buf, v: int, d: int) {
    let n = load64(d + 8)
    __json_in(v, d)
    buf_byte(b, '\{')
    for i in 0..n {
        if i > 0 {
            buf_byte(b, ',')
        }
        buf_add(b, __cast(load64(__field(d, i) + 8)))
        __json_enc(b, load64(v + i * 8), __field_desc(d, i))
    }
    buf_byte(b, '}')
    __json_out(v, d)
}

fn __json_enc_list(b: Buf, v: int, d: int) {
    let ed = load64(d + 8)
    let n = load64(v + 8)
    __json_in(v, d)
    buf_byte(b, '[')
    for i in 0..n {
        if i > 0 {
            buf_byte(b, ',')
        }
        __json_enc(b, __lget(v, i), ed)
    }
    buf_byte(b, ']')
    __json_out(v, d)
}

fn __json_enc_map(b: Buf, v: int, d: int) {
    let vd = load64(d + 16)
    let str_keys = load64(v + 48) != 0
    let n = load64(load64(v) + 8)
    __json_in(v, d)
    buf_byte(b, '\{')
    var first = true
    for i in 0..n {
        if __word_at(load64(v + 24), i) == 0 {
            continue
        }
        if !first {
            buf_byte(b, ',')
        }
        first = false
        let key = __word_at(load64(v), i)
        if str_keys {
            __json_str(b, __cast(key))
        } else {
            buf_byte(b, '"')
            buf_int(b, key)
            buf_byte(b, '"')
        }
        buf_byte(b, ':')
        __json_enc(b, __word_at(load64(v + 16), i), vd)
    }
    buf_byte(b, '}')
    __json_out(v, d)
}

// Вариант: без полей у всех — строка с именем, иначе объект с полем "type".
fn __json_enc_sum(b: Buf, v: int, d: int) {
    let e = __variant_entry(d, v)
    if e == 0 {
        buf_add(b, "null")
        return
    }
    let name: str = __cast(load64(e))
    if load64(d + 24) != 0 {
        __json_str(b, name)
        return
    }
    let vd = load64(e + 8)
    __json_in(v, vd)
    buf_add(b, "\{\"type\":")
    __json_str(b, name)
    let n = load64(vd + 8)
    for i in 0..n {
        buf_byte(b, ',')
        buf_add(b, __cast(load64(__field(vd, i) + 8)))
        __json_enc(b, load64(v + i * 8), __field_desc(vd, i))
    }
    buf_byte(b, '}')
    __json_out(v, vd)
}

// Строка в кавычках JSON.
fn __json_quote(s: str) -> str {
    let b = buf_new(s.byte_len() + 8)
    __json_str(b, s)
    return __str_new(b.data, b.len)
}

fn __json_encode(v: int, d: int) -> str {
    let b = buf_new(64)
    __json_begin()
    __json_enc(b, v, d)
    return __str_new(b.data, b.len)
}

// ---- JSON: чтение ----

type __Json {
    p: int
    end: int
    err: str
}

fn __jd_ws(j: __Json) {
    while j.p < j.end {
        let c = load8(j.p)
        if c != ' ' && c != '\n' && c != '\r' && c != '\t' {
            return
        }
        j.p += 1
    }
}

fn __jd_peek(j: __Json) -> int {
    __jd_ws(j)
    if j.p >= j.end {
        return -1
    }
    return load8(j.p)
}

fn __jd_found(j: __Json) -> str {
    if j.p >= j.end {
        return "end of input"
    }
    var n = 0
    while j.p + n < j.end && n < 12 && load8(j.p + n) != '\n' {
        n += 1
    }
    return "'" + __str_new(j.p, n) + "'"
}

fn __jd_fail(j: __Json, at: str, msg: str) {
    if j.err.byte_len() > 0 {
        return
    }
    if at.byte_len() > 0 {
        j.err = at + ": " + msg
    } else {
        j.err = msg
    }
}

fn __jd_expect(j: __Json, at: str, what: str) {
    __jd_fail(j, at, "expected " + what + ", found " + __jd_found(j))
}

fn __jd_word(j: __Json, w: str) -> bool {
    let n = w.byte_len()
    if j.p + n <= j.end && __memeq(j.p, __str_ptr(w), n) {
        j.p += n
        return true
    }
    return false
}

fn __jd_hex4(j: __Json) -> int {
    if j.p + 4 > j.end {
        return -1
    }
    var v = 0
    for i in 0..4 {
        let h = __hex_val(load8(j.p + i))
        if h < 0 {
            return -1
        }
        v = v * 16 + h
    }
    j.p += 4
    return v
}

// Строка: без экранирования — без копирования (ссылка на входные байты).
fn __jd_str(j: __Json, at: str) -> str {
    if __jd_peek(j) != '"' {
        __jd_expect(j, at, "a string")
        return ""
    }
    j.p += 1
    let start = j.p
    j.p += __find_json_special(j.p, j.end - j.p)
    if j.p < j.end && load8(j.p) == '"' {
        let s = __str_new(start, j.p - start)
        j.p += 1
        return s
    }
    let b = buf_new(j.p - start + 16)
    buf_add_raw(b, start, j.p - start)
    while j.p < j.end {
        let k = __find_json_special(j.p, j.end - j.p)
        buf_add_raw(b, j.p, k)
        j.p += k
        if j.p >= j.end {
            break
        }
        let c = load8(j.p)
        if c == '"' {
            j.p += 1
            return __str_new(b.data, b.len)
        }
        if c < 0x20 {
            __jd_fail(j, at, "control character in a string")
            return ""
        }
        if j.p + 1 >= j.end {
            break
        }
        let e = load8(j.p + 1)
        j.p += 2
        if e == 'n' {
            buf_byte(b, '\n')
        } else if e == 't' {
            buf_byte(b, '\t')
        } else if e == 'r' {
            buf_byte(b, '\r')
        } else if e == 'b' {
            buf_byte(b, 8)
        } else if e == 'f' {
            buf_byte(b, 12)
        } else if e == '"' || e == '\\' || e == '/' {
            buf_byte(b, e)
        } else if e == 'u' {
            var cp = __jd_hex4(j)
            if cp < 0 {
                __jd_fail(j, at, "bad \\u escape")
                return ""
            }
            if cp >= 0xD800 && cp < 0xDC00 && __jd_word(j, "\\u") {
                let lo = __jd_hex4(j)
                if lo >= 0xDC00 && lo < 0xE000 {
                    cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
                }
            }
            buf_utf8(b, cp)
        } else {
            __jd_fail(j, at, "bad escape in a string")
            return ""
        }
    }
    __jd_fail(j, at, "unterminated string")
    return ""
}

fn __jd_int(j: __Json, at: str) -> int {
    let c = __jd_peek(j)
    var neg = false
    if c == '-' {
        neg = true
        j.p += 1
    }
    let start = j.p
    var v = 0
    while j.p < j.end {
        let d = load8(j.p)
        if d < '0' || d > '9' {
            break
        }
        if v > 922337203685477580 {
            __jd_fail(j, at, "integer is too large")
            return 0
        }
        v = v * 10 + (d - '0')
        j.p += 1
    }
    if j.p == start {
        if neg {
            j.p -= 1
        }
        __jd_expect(j, at, "an integer")
        return 0
    }
    if j.p < j.end && (load8(j.p) == '.' || load8(j.p) == 'e' || load8(j.p) == 'E') {
        __jd_fail(j, at, "expected an integer, found a fractional number")
        return 0
    }
    if neg {
        return -v
    }
    return v
}

fn __jd_float(j: __Json, at: str) -> int {
    __jd_ws(j)
    let start = j.p
    while j.p < j.end {
        let c = load8(j.p)
        if (c >= '0' && c <= '9') || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E' {
            j.p += 1
        } else {
            break
        }
    }
    let f = __float_parse(start, j.p - start) else {
        j.p = start
        __jd_expect(j, at, "a number")
        return 0
    }
    let bits: int = __cast(f)
    return bits
}

// Пропуск любого значения (поля, которых нет в типе).
fn __jd_skip(j: __Json, at: str) {
    let c = __jd_peek(j)
    if c == '"' {
        __jd_str(j, at)
        return
    }
    if c == '\{' || c == '[' {
        j.p += 1
        var close = ']'
        if c == '\{' {
            close = '}'
        }
        if __jd_peek(j) == close {
            j.p += 1
            return
        }
        while j.err.byte_len() == 0 {
            if c == '\{' {
                __jd_str(j, at)
                if __jd_peek(j) != ':' {
                    __jd_expect(j, at, "':'")
                    return
                }
                j.p += 1
            }
            __jd_skip(j, at)
            let e = __jd_peek(j)
            j.p += 1
            if e == close {
                return
            }
            if e != ',' {
                j.p -= 1
                __jd_expect(j, at, "',' or '" + __str_from_byte(close) + "'")
                return
            }
        }
        return
    }
    if __jd_word(j, "true") || __jd_word(j, "false") || __jd_word(j, "null") {
        return
    }
    if c == '-' || (c >= '0' && c <= '9') {
        j.p += 1
        while j.p < j.end {
            let d = load8(j.p)
            if (d >= '0' && d <= '9') || d == '.' || d == 'e' || d == 'E' || d == '+' || d == '-' {
                j.p += 1
            } else {
                break
            }
        }
        return
    }
    __jd_expect(j, at, "a JSON value")
}

fn __jd_join(at: str, name: str) -> str {
    if at.byte_len() == 0 {
        return name
    }
    return at + "." + name
}

fn __jd(j: __Json, d: int, at: str) -> int {
    let k = load64(d)
    let c = __jd_peek(j)
    if k == D_INT {
        return __jd_int(j, at)
    }
    if k == D_FLOAT {
        return __jd_float(j, at)
    }
    if k == D_STR {
        return __cast(__jd_str(j, at))
    }
    if k == D_BOOL {
        if __jd_word(j, "true") {
            return 1
        }
        if __jd_word(j, "false") {
            return 0
        }
        __jd_expect(j, at, "true or false")
        return 0
    }
    if k == D_OPT {
        if __jd_word(j, "null") {
            return 0
        }
        let inner = load64(d + 8)
        let v = __jd(j, inner, at)
        if __is_scalar(inner) {
            let b = __alloc(8)
            store64(b, v)
            return b
        }
        return v
    }
    if k == D_LIST {
        let ed = load64(d + 8)
        var es = 8
        if load64(ed) == D_BOOL {
            es = 1
        }
        let xs: [int] = __cast(__list_new(4, es))
        if c != '[' {
            __jd_expect(j, at, "an array")
            return __cast(xs)
        }
        j.p += 1
        if __jd_peek(j) == ']' {
            j.p += 1
            return __cast(xs)
        }
        while j.err.byte_len() == 0 {
            xs.push(__jd(j, ed, at + "[" + xs.len().to_str() + "]"))
            let e = __jd_peek(j)
            if e == ']' {
                j.p += 1
                break
            }
            if e != ',' {
                __jd_expect(j, at, "',' or ']'")
                break
            }
            j.p += 1
        }
        return __cast(xs)
    }
    if k == D_MAP {
        let kd = load64(d + 8)
        let vd = load64(d + 16)
        let str_keys = load64(kd) == D_STR
        var sk = 0
        if str_keys {
            sk = 1
        }
        let m = __map_new(sk)
        if c != '\{' {
            __jd_expect(j, at, "an object")
            return m
        }
        j.p += 1
        if __jd_peek(j) == '}' {
            j.p += 1
            return m
        }
        while j.err.byte_len() == 0 {
            let key = __jd_str(j, at)
            if __jd_peek(j) != ':' {
                __jd_expect(j, at, "':'")
                break
            }
            j.p += 1
            var kw = 0
            if str_keys {
                kw = __cast(key)
            } else {
                let ki = key.to_int() else {
                    __jd_fail(j, at, "key '" + key + "' is not an integer")
                    break
                }
                kw = ki
            }
            __map_set(m, kw, __jd(j, vd, __jd_join(at, key)))
            let e = __jd_peek(j)
            if e == '}' {
                j.p += 1
                break
            }
            if e != ',' {
                __jd_expect(j, at, "',' or '}'")
                break
            }
            j.p += 1
        }
        return m
    }
    if k == D_SUM {
        return __jd_sum(j, d, at)
    }
    if k == D_STRUCT {
        let n = load64(d + 8)
        let s = __struct_alloc(d)
        if c != '\{' {
            __jd_expect(j, at, "an object")
            return s
        }
        j.p += 1
        var seen = 0
        if __jd_peek(j) == '}' {
            j.p += 1
        } else {
            while j.err.byte_len() == 0 {
                let key = __jd_str(j, at)
                if __jd_peek(j) != ':' {
                    __jd_expect(j, at, "':'")
                    break
                }
                j.p += 1
                var fi = -1
                for i in 0..n {
                    let fname: str = __cast(load64(__field(d, i)))
                    if fname == key {
                        fi = i
                        break
                    }
                }
                if fi < 0 {
                    __jd_skip(j, __jd_join(at, key))
                } else {
                    if fi < 62 && __jd_peek(j) == 'n' && load64(__field_desc(d, fi)) == D_OPT {
                        __json_null_mark(s, fi)
                    }
                    store64(s + fi * 8, __jd(j, __field_desc(d, fi), __jd_join(at, key)))
                    if fi < 62 {
                        seen = seen | (1 << fi)
                    }
                }
                let e = __jd_peek(j)
                if e == '}' {
                    j.p += 1
                    break
                }
                if e != ',' {
                    __jd_expect(j, at, "',' or '}'")
                    break
                }
                j.p += 1
            }
        }
        if j.err.byte_len() == 0 {
            for i in 0..n {
                if i < 62 && (seen & (1 << i)) == 0 {
                    let f = __field(d, i)
                    let dk = load64(f + 24)
                    if dk == 1 {
                        store64(s + i * 8, load64(f + 32))
                    } else if dk == 2 {
                        store64(s + i * 8, __list_new(4, load64(f + 32)))
                    } else if dk == 3 {
                        store64(s + i * 8, __map_new(load64(f + 32)))
                    } else if load64(load64(f + 16)) != D_OPT {
                        let fname: str = __cast(load64(f))
                        __jd_fail(j, at, "missing field '" + __jd_join(at, fname) + "'")
                        break
                    }
                }
            }
        }
        return s
    }
    return 0
}

// Явный null в JSON (а не отсутствующее поле): так SET \{patch} в sql отличает
// «снять значение» от «не трогать» (JSON Merge Patch). Отметки живут до конца запроса.
fn __json_null_mark(s: int, fi: int) {
    let cx = __ctx()
    var m = load64(cx + CTX_JNULLS)
    if m == 0 {
        m = __map_new(0)
        store64(cx + CTX_JNULLS, m)
    }
    let mm: map[int, int] = __cast(m)
    mm[s] = (mm[s] ?? 0) | (1 << fi)
}

fn __json_null_sent(s: int, fi: int) -> bool {
    let m = load64(__ctx() + CTX_JNULLS)
    if m == 0 || fi >= 62 {
        return false
    }
    let mm: map[int, int] = __cast(m)
    return ((mm[s] ?? 0) & (1 << fi)) != 0
}

fn __sum_names(d: int) -> str {
    var r = ""
    let n = load64(d + 8)
    for i in 0..n {
        if i > 0 {
            r += ", "
        }
        let name: str = __cast(load64(d + 32 + i * 24))
        r += name
    }
    return r
}

// Значение поля "type" объекта; позиция чтения не меняется.
fn __jd_type_tag(j: __Json, at: str) -> str {
    let save = j.p
    j.p += 1
    var r = ""
    var found = false
    while j.err.byte_len() == 0 && __jd_peek(j) != '}' {
        let key = __jd_str(j, at)
        if __jd_peek(j) != ':' {
            __jd_expect(j, at, "':'")
            break
        }
        j.p += 1
        if key == "type" {
            r = __jd_str(j, __jd_join(at, "type"))
            found = true
            break
        }
        __jd_skip(j, at)
        if __jd_peek(j) == ',' {
            j.p += 1
        }
    }
    if !found && j.err.byte_len() == 0 {
        __jd_fail(j, at, "missing field 'type'")
    }
    j.p = save
    return r
}

fn __jd_sum(j: __Json, d: int, at: str) -> int {
    let n = load64(d + 8)
    var name = ""
    if load64(d + 24) != 0 {
        name = __jd_str(j, at)
    } else {
        if __jd_peek(j) != '\{' {
            __jd_expect(j, at, "an object")
            return 0
        }
        name = __jd_type_tag(j, at)
    }
    if j.err.byte_len() > 0 {
        return 0
    }
    for i in 0..n {
        let e = d + 32 + i * 24
        let vn: str = __cast(load64(e))
        if vn == name {
            let unit = load64(e + 16)
            if unit != 0 {
                if load64(d + 24) == 0 {
                    __jd_skip(j, at)
                }
                return unit
            }
            return __jd(j, load64(e + 8), at)
        }
    }
    __jd_fail(j, at, "unknown variant '" + name + "', expected one of: " + __sum_names(d))
    return 0
}

// Значение типа T? из текста JSON: none, если текст не подходит (текст ошибки —
// в __json_error()). Для int и bool результат — ячейка.
fn __json_decode(s: str, d: int) -> int {
    let j = __Json { p: __str_ptr(s), end: __str_ptr(s) + s.byte_len(), err: "" }
    let v = __jd(j, d, "")
    if j.err.byte_len() == 0 && __jd_peek(j) != -1 {
        __jd_fail(j, "", "unexpected " + __jd_found(j) + " after the value")
    }
    if j.err.byte_len() > 0 {
        if load64(__ctx() + CTX_WORKER) != 0 {
            let w = __w()
            w.json_err = j.err
        } else {
            __json_last_err = j.err
        }
        return 0
    }
    if __is_scalar(d) {
        let b = __alloc(8)
        store64(b, v)
        return b
    }
    return v
}

var __json_last_err: str

// Текст ошибки последнего from_json.
fn json_error() -> str {
    if load64(__ctx() + CTX_WORKER) != 0 {
        return __w().json_err
    }
    return __json_last_err
}

// ---- Ответы маршрутов ----

fn __reason(status: int) -> str {
    if status == 200 {
        return "OK"
    }
    if status == 201 {
        return "Created"
    }
    if status == 202 {
        return "Accepted"
    }
    if status == 204 {
        return "No Content"
    }
    if status == 301 {
        return "Moved Permanently"
    }
    if status == 302 {
        return "Found"
    }
    if status == 304 {
        return "Not Modified"
    }
    if status == 400 {
        return "Bad Request"
    }
    if status == 401 {
        return "Unauthorized"
    }
    if status == 403 {
        return "Forbidden"
    }
    if status == 404 {
        return "Not Found"
    }
    if status == 405 {
        return "Method Not Allowed"
    }
    if status == 409 {
        return "Conflict"
    }
    if status == 413 {
        return "Payload Too Large"
    }
    if status == 422 {
        return "Unprocessable Entity"
    }
    if status == 429 {
        return "Too Many Requests"
    }
    if status == 431 {
        return "Request Header Fields Too Large"
    }
    if status == 500 {
        return "Internal Server Error"
    }
    if status == 501 {
        return "Not Implemented"
    }
    if status == 503 {
        return "Service Unavailable"
    }
    return "Unknown"
}

// Ответ со значением: str — текстом, остальное — JSON.
fn __reply(status: int, v: int, d: int) {
    let w = __w()
    w.status = status
    buf_clear(w.body)
    if load64(d) == D_STR {
        w.ctype = CT_TEXT
        let s: str = __cast(v)
        buf_add(w.body, s)
        return
    }
    w.ctype = CT_JSON
    __json_begin()
    __json_enc(w.body, v, d)
}

// Ответ без значения: у 204 и 304 тела нет, у остальных — текст статуса.
fn __reply_status(status: int) {
    let w = __w()
    w.status = status
    buf_clear(w.body)
    w.ctype = CT_TEXT
    if status != 204 && status != 304 {
        buf_add(w.body, __reason(status))
    }
}

fn __reply_text(status: int, text: str) {
    let w = __w()
    w.status = status
    w.ctype = CT_TEXT
    buf_clear(w.body)
    buf_add(w.body, text)
}

fn __reply_json_error() {
    __reply_text(400, "invalid JSON body: " + __w().json_err)
}

// ---- Разбор пути и строки запроса ----

fn __path_segs(p: str) -> [str] {
    var segs: [str] = []
    let n = p.byte_len()
    var start = 1
    var i = 1
    while i <= n {
        if i == n || p.byte(i) == '/' {
            segs.push(p.byte_slice(start, i))
            start = i + 1
        }
        i += 1
    }
    return segs
}

// Текст для строки запроса: всё, кроме букв, цифр и - _ . ~, — как %XX.
fn url_encode(s: str) -> str {
    let b = buf_new(s.byte_len() + 8)
    for i in 0..s.byte_len() {
        let c = s.byte(i)
        if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~' {
            buf_byte(b, c)
        } else {
            buf_byte(b, '%')
            buf_byte(b, __hex_digit(c >> 4) - 32 * ((c >> 4) / 10))
            buf_byte(b, __hex_digit(c & 15) - 32 * ((c & 15) / 10))
        }
    }
    return __str_new(b.data, b.len)
}

fn __url_decode(s: str) -> str {
    let n = s.byte_len()
    var plain = true
    for i in 0..n {
        let c = s.byte(i)
        if c == '%' || c == '+' {
            plain = false
            break
        }
    }
    if plain {
        return s
    }
    let b = buf_new(n)
    var i = 0
    while i < n {
        let c = s.byte(i)
        if c == '+' {
            buf_byte(b, ' ')
        } else if c == '%' && i + 2 < n && __hex_val(s.byte(i + 1)) >= 0 && __hex_val(s.byte(i + 2)) >= 0 {
            buf_byte(b, __hex_val(s.byte(i + 1)) * 16 + __hex_val(s.byte(i + 2)))
            i += 2
        } else {
            buf_byte(b, c)
        }
        i += 1
    }
    return __str_new(b.data, b.len)
}

// Значение параметра name из строки запроса «a=1&b=2» или none.
fn __query(q: str, name: str) -> str? {
    let n = q.byte_len()
    var start = 0
    var i = 0
    while i <= n {
        if i == n || q.byte(i) == '&' {
            let part = q.byte_slice(start, i)
            let eq = part.byte_find("=") ?? part.byte_len()
            if __url_decode(part.byte_slice(0, eq)) == name {
                if eq >= part.byte_len() {
                    return ""
                }
                return __url_decode(part.byte_slice(eq + 1, part.byte_len()))
            }
            start = i + 1
        }
        i += 1
    }
    return none
}

fn __param_int(s: str, name: str) -> int? {
    let v = s.to_int() else {
        __reply_text(400, "parameter '" + name + "' must be an integer, found '" + s + "'")
        return none
    }
    return v
}

fn __param_float(s: str, name: str) -> float? {
    let v = s.to_float() else {
        __reply_text(400, "parameter '" + name + "' must be a number, found '" + s + "'")
        return none
    }
    return v
}

fn __param_bool(s: str, name: str) -> bool? {
    if s == "true" || s == "1" {
        return true
    }
    if s == "false" || s == "0" {
        return false
    }
    __reply_text(400, "parameter '" + name + "' must be true or false, found '" + s + "'")
    return none
}

fn __missing(name: str) {
    __reply_text(400, "missing query parameter '" + name + "'")
}

// ---- Один запрос: маршрутизатор под защитой от паник ----

fn __pmode_reset() {
    if load64(__ctx() + CTX_PSAVE_PTR) != 0 {
        __pmode_off()
    }
}

// Заголовок текущего запроса (имя без учёта регистра) или none.
fn header(name: str) -> str? {
    if load64(__ctx() + CTX_WORKER) == 0 {
        return none
    }
    let w = __w()
    if w.cur == 0 {
        return none
    }
    let r: __Req = __cast(w.cur)
    let want = name.ascii_lower()
    for line in r.headers.split("\r\n") {
        let c = line.byte_find(":") ?? 0
        if c > 0 && line.byte_slice(0, c).ascii_trim().ascii_lower() == want {
            return line.byte_slice(c + 1, line.byte_len()).ascii_trim()
        }
    }
    return none
}

// Заголовок ответа текущего запроса (Location, Retry-After, Set-Cookie, ...).
fn set_header(name: str, value: str) {
    if load64(__ctx() + CTX_WORKER) == 0 {
        return
    }
    let w = __w()
    // перевод строки в заголовке — подмена ответа; такие символы выбрасываются
    buf_add(w.extra, name.replace("\r", "").replace("\n", "") + ": " + value.replace("\r", "").replace("\n", "") + "\r\n")
}

// Прервать текущий запрос из любой функции: ответ status с текстом message
// ("" — стандартный текст: "Unauthorized"). Заголовки от set_header остаются,
// изменения store до вызова — тоже.
fn fail(status: int, message: str = "") {
    let w = __w()
    var msg = message
    if w.cur != 0 && status >= 100 && status <= 599 {
        w.failed = status
    } else {
        msg = "panic: fail({status}) outside a request"
        if w.cur != 0 {
            msg = "panic: fail({status}): not an HTTP status"
        }
    }
    let mh: int = __cast(msg)
    store64(__ctx() + CTX_PANIC, mh)
    __panic_recover()
    eprint(msg)
    exit(101)
}

fn __serve_one(w: __Worker, req: __Req) {
    let c = __ctx()
    let prev = load64(c + CTX_CATCH)
    w.status = 0
    buf_clear(w.body)
    buf_clear(w.extra)
    w.cur = __cast(req)
    store64(c + CTX_STORE_MODE, 0)
    store64(c + CTX_JNULLS, 0)
    if __setjmp(w.jb) == 0 {
        store64(c + CTX_CATCH, w.jb)
        __dispatch(req)
    } else {
        __pmode_reset()
        let msg: str = __cast(load64(c + CTX_PANIC))
        if w.failed > 0 {
            if msg.byte_len() == 0 {
                __reply_status(w.failed)
            } else {
                __reply_text(w.failed, msg)
            }
            w.failed = 0
        } else {
            buf_clear(w.extra)
            if w.testing {
                __reply_text(500, msg)
            } else {
                eprint(msg)
                __reply_text(500, "Internal Server Error")
            }
        }
    }
    store64(c + CTX_CATCH, prev)
    store64(c + CTX_JNULLS, 0)
    __db_end()
    __gc_verify_release()
    __store_unlock()
    store64(c + CTX_STORE_MODE, 0)
    w.cur = 0
}

// ---- Тесты: khc test ----

var __tests_run: int
var __tests_failed: int
var __test_bad: bool
var __test_log: str

fn __tests_init() {
    __store_boot(false)
    __arena_init()
    let w = __worker_init()
    w.testing = true
    __db_init()
}

fn __test_begin(name: str, jb: int) {
    store64(__ctx() + CTX_JNULLS, 0)
    __test_bad = false
    __test_log = ""
    __tests_run += 1
    store64(__ctx() + CTX_CATCH, jb)
    __arena_begin()
}

fn __test_fail(msg: str) {
    __test_bad = true
    __test_log = __test_log + "    " + msg + "\n"
}

fn __test_end(name: str) {
    let c = __ctx()
    if load64(c + CTX_CATCH) == 0 {
        // тест прерван паникой
        __pmode_reset()
        let msg: str = __cast(load64(c + CTX_PANIC))
        __test_fail(msg)
    }
    store64(c + CTX_CATCH, 0)
    __db_end()
    __gc_verify_release()
    __store_unlock()
    if __test_bad {
        __tests_failed += 1
        write("FAIL  " + name + "\n" + __test_log)
    } else {
        print("ok    " + name)
    }
    __arena_end()
}

fn __tests_done() -> int {
    __db_done()
    let passed = __tests_run - __tests_failed
    print("{__tests_run} tests: {passed} passed, {__tests_failed} failed")
    if __tests_failed > 0 {
        return 1
    }
    return 0
}

fn __expect(ok: bool, at: str, text: str) {
    if !ok {
        __test_fail(at + ": expect " + text)
    }
}

// expect x != none: значения нет — тест останавливается.
fn __expect_some(ok: bool, at: str, text: str) {
    if !ok {
        __panic_msg(at + ": expect " + text + " — the test stops here")
    }
}

fn __expect_eq(l: str, r: str, want_eq: bool, at: str, text: str) {
    if (l == r) != want_eq {
        __test_fail(at + ": expect " + text + "\n      left:  " + l + "\n      right: " + r)
    }
}

// Заголовки «Имя: значение\r\n...» → словарь со строчными именами.
fn __header_map(text: str) -> map[str, str] {
    var m: map[str, str] = {}
    for line in text.split("\r\n") {
        let c = line.byte_find(":") ?? 0
        if c > 0 {
            m[line.byte_slice(0, c).ascii_trim().ascii_lower()] = line.byte_slice(c + 1, line.byte_len()).ascii_trim()
        }
    }
    return m
}

fn __call(method: str, target: str, body: int, d: int, headers: int) -> Response {
    let w = __w()
    var htext = ""
    if headers != 0 {
        let hm: map[str, str] = __cast(headers)
        for k, v in hm {
            htext += k + ": " + v + "\r\n"
        }
    }
    var path = target
    var query = ""
    if let q = target.byte_find("?") {
        path = target.byte_slice(0, q)
        query = target.byte_slice(q + 1, target.byte_len())
    }
    var text = ""
    if d != 0 {
        if load64(d) == D_STR {
            text = __cast(body)
        } else {
            text = __json_encode(body, d)
        }
    }
    let req = __Req { method: method, path: path, query: query, body: text, headers: htext }
    // как в сервере: всё, что запрос выделил в арене, освобождается после ответа
    let c = __ctx()
    let mark = load64(c + CTX_PTR)
    // запрос — со своим соединением с базой, не с транзакцией теста
    let held = load64(c + CTX_PGHELD)
    store64(c + CTX_PGHELD, 0)
    // запрос работает под блокировкой store теста и в конце её отпускает
    let th = load64(c + CTX_STORE_HELD)
    __serve_one(w, req)
    store64(c + CTX_PGHELD, held)
    if th != 0 {
        // тест держал блокировку — снова держит (CTX_STORE_MODE сброшен в 0:
        // монопольно); точка сборки для тестов (__gc_test_point) — шаг 5
        // docs/design/v0.13-store-gc.md
        __store_lock()
    }
    let used = load64(c + CTX_PTR) - mark
    __memset(mark, 0, used)
    store64(c + CTX_PTR, mark)
    // строки запроса умерли, а их адреса займут новые: кэш строк — заново
    __strc_clear()
    return Response { status: w.status, body: buf_str(w.body), headers: __header_map(buf_str(w.extra)) }
}
