// Рантайм программ, собранных khc: точка входа, контекст потока, паники,
// блокировка store.

const SYS_ARCH_PRCTL = 158
const ARCH_SET_FS = 0x1002
const SYS_FUTEX = 202
const FUTEX_WAIT_PRIVATE = 128
const FUTEX_WAKE_PRIVATE = 129

// Компилятор начинает программу с «mov rdi, rsp; call __entry».
fn __entry(sp: int) {
    __thread_init()
    __argc = load64(sp)
    __argv = sp + 8
    __simd_init()
    __init_globals()
    exit(__main())
}

// ---- SIMD: 3 — AVX2 и быстрый PDEP, 2 — AVX2, 1 — SSE2, 0 — побайтно
// (KHRIP_SIMD может понизить) ----
// Здесь же — режим кэша строк (KHRIP_STRCACHE).

var __simd_level: int
// SHA-256 инструкциями процессора (SHA-NI); KHRIP_SIMD=0 выключает
var __simd_sha: bool

fn __simd_init() {
    var lvl = 1
    if __cpu_avx2() {
        lvl = 2
        if __cpu_pdep() {
            lvl = 3
        }
    }
    if let s = env("KHRIP_SIMD") {
        let v = s.to_int() ?? lvl
        if v >= 0 && v < lvl {
            lvl = v
        }
    }
    __simd_level = lvl
    __simd_sha = lvl > 0 && __cpu_sha()
    // кэш строк (lib/text.kh): off — без него, stress — проверочный режим
    if let m = env("KHRIP_STRCACHE") {
        if m == "off" {
            __strc_mode = STRC_OFF
        } else if m == "stress" {
            __strc_mode = STRC_STRESS
        }
    }
}

// Индекс первого байта b в [p, p + n) или n.
fn __find_byte(p: int, n: int, b: int) -> int {
    return __simd_find_byte(p, n, b)
}

// Индекс первого '"', '\\' или управляющего байта или n.
fn __find_json_special(p: int, n: int) -> int {
    return __simd_find_json(p, n)
}

// То же | 1 << 62, если до этого места встретился байт >= 0x80 (строку
// тогда нужно проверить на UTF-8).
fn __find_json_hi(p: int, n: int) -> int {
    return __simd_find_json_hi(p, n)
}

// Индекс начала «\r\n\r\n» или n.
fn __find_crlf2(p: int, n: int) -> int {
    return __simd_find_crlf2(p, n)
}

// Контекст потока: регион памяти и указатель на себя в fs:[0].
fn __thread_init() {
    let ctx = __mmap(CTX_SIZE)
    store64(ctx + CTX_SELF, ctx)
    syscall(SYS_ARCH_PRCTL, ARCH_SET_FS, ctx)
}

// Паника внутри обработчика запроса или теста не завершает процесс:
// управление возвращается туда, где был вызван __setjmp.
fn __panic_recover() {
    let c = __ctx()
    let jb = load64(c + CTX_CATCH)
    if jb != 0 {
        store64(c + CTX_CATCH, 0)
        __longjmp(jb)
    }
}

// Паника из проверки в скомпилированном коде: место — номер файла и строка.
fn __panic_at(kind: int, loc: int) {
    __panic(kind, __file_name(loc >> 24) + ":" + (loc & 0xFFFFFF).to_str())
}

// ---- Время ----

// Секунды с 1970-01-01 (UTC).
fn now() -> int {
    return syscall(201, 0)
}

// Миллисекунды с 1970-01-01 (UTC).
fn now_ms() -> int {
    let ts = __ctx() + 192
    syscall(228, 0, ts)
    return load64(ts) * 1000 + load64(ts + 8) / 1000000
}

fn __pad(v: int, width: int) -> str {
    var r = v.to_str()
    while r.byte_len() < width {
        r = "0" + r
    }
    return r
}

// Время t (секунды с 1970-01-01 UTC) в ISO 8601: 2026-10-19T15:04:05Z.
fn time_iso(t: int) -> str {
    var days = t / 86400
    var secs = t % 86400
    if secs < 0 {
        secs += 86400
        days -= 1
    }
    // дни → дата (civil_from_days Говарда Хиннанта)
    let z = days + 719468
    var era = z / 146097
    if z < 0 {
        era = (z - 146096) / 146097
    }
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    var month = mp + 3
    if mp >= 10 {
        month = mp - 9
    }
    var year = yoe + era * 400
    if month <= 2 {
        year += 1
    }
    return __pad(year, 4) + "-" + __pad(month, 2) + "-" + __pad(day, 2) + "T" + __pad(secs / 3600, 2) + ":" + __pad(secs / 60 % 60, 2) + ":" + __pad(secs % 60, 2) + "Z"
}

// Дни от 1970-01-01 до даты (days_from_civil Говарда Хиннанта).
fn __days_from_civil(y0: int, m: int, d: int) -> int {
    var y = y0
    if m <= 2 {
        y -= 1
    }
    var era = y / 400
    if y < 0 {
        era = (y - 399) / 400
    }
    let yoe = y - era * 400
    var mp = m - 3
    if m <= 2 {
        mp = m + 9
    }
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

fn __days_in_month(y: int, m: int) -> int {
    if m == 2 {
        if y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) {
            return 29
        }
        return 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30
    }
    return 31
}

// n цифр с позиции i или -1.
fn __digits(s: str, i: int, n: int) -> int {
    if i + n > s.byte_len() {
        return -1
    }
    var v = 0
    for k in i..i + n {
        let c = s.byte(k)
        if c < '0' || c > '9' {
            return -1
        }
        v = v * 10 + c - '0'
    }
    return v
}

// «YYYY-MM-DD» с позиции 0: дни от 1970-01-01 или none.
fn __parse_ymd(s: str) -> int? {
    let y = __digits(s, 0, 4)
    let m = __digits(s, 5, 2)
    let d = __digits(s, 8, 2)
    if s.byte_len() < 10 || s.byte(4) != '-' || s.byte(7) != '-' || y < 0 || m < 1 || m > 12 || d < 1 || d > __days_in_month(y, m) {
        return none
    }
    return __days_from_civil(y, m, d)
}

// Дата «2026-10-19» → секунды с 1970 (полночь UTC), неверная дата — none.
fn parse_date(s: str) -> int? {
    if s.byte_len() != 10 {
        return none
    }
    let days = __parse_ymd(s) else {
        return none
    }
    return days * 86400
}

// Время ISO 8601 / RFC 3339 → секунды с 1970: «2026-10-19T15:04:05Z», дробные
// секунды отбрасываются, смещение «+03:00» учитывается. Неверное — none.
fn parse_time(s: str) -> int? {
    let days = __parse_ymd(s) else {
        return none
    }
    let h = __digits(s, 11, 2)
    let mi = __digits(s, 14, 2)
    let sec = __digits(s, 17, 2)
    if s.byte_len() < 20 || (s.byte(10) != 'T' && s.byte(10) != 't' && s.byte(10) != ' ') || s.byte(13) != ':' || s.byte(16) != ':' || h < 0 || h > 23 || mi < 0 || mi > 59 || sec < 0 || sec > 59 {
        return none
    }
    var i = 19
    if s.byte(i) == '.' {
        i += 1
        let from = i
        while i < s.byte_len() && s.byte(i) >= '0' && s.byte(i) <= '9' {
            i += 1
        }
        if i == from {
            return none
        }
    }
    var offset = 0
    if i == s.byte_len() - 1 && (s.byte(i) == 'Z' || s.byte(i) == 'z') {
        offset = 0
    } else if i == s.byte_len() - 6 && (s.byte(i) == '+' || s.byte(i) == '-') && s.byte(i + 3) == ':' {
        let oh = __digits(s, i + 1, 2)
        let om = __digits(s, i + 4, 2)
        if oh < 0 || oh > 23 || om < 0 || om > 59 {
            return none
        }
        offset = oh * 3600 + om * 60
        if s.byte(i) == '-' {
            offset = -offset
        }
    } else {
        return none
    }
    return days * 86400 + h * 3600 + mi * 60 + sec - offset
}

// ---- Случайность (getrandom) ----

fn __random_bytes(p: int, n: int) {
    var off = 0
    while off < n {
        let r = syscall(318, p + off, n - off, 0)
        if r > 0 {
            off += r
        }
    }
}

// Случайная строка из n латинских букв и цифр: коды, токены, ключи.
fn random_str(n: int) -> str {
    let abc = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    let b = buf_new(n + 1)
    let raw = __alloc(64)
    var i = 64
    while b.len < n {
        if i >= 64 {
            __random_bytes(raw, 64)
            i = 0
        }
        let v = load8(raw + i)
        i += 1
        // без перекоса: 248 = 4 × 62
        if v < 248 {
            buf_byte(b, abc.byte(v % 62))
        }
    }
    return __str_new(b.data, b.len)
}

// ---- Мьютекс на futex: 0 — свободен, 1 — занят, 2 — занят и есть ждущие ----

fn __mutex_lock(m: int) {
    if __cas(m, 0, 1) {
        return
    }
    while true {
        if __xchg(m, 2) == 0 {
            return
        }
        syscall(SYS_FUTEX, m, FUTEX_WAIT_PRIVATE, 2, 0, 0, 0)
    }
}

fn __mutex_unlock(m: int) {
    if __xchg(m, 0) == 2 {
        syscall(SYS_FUTEX, m, FUTEX_WAKE_PRIVATE, 1, 0, 0, 0)
    }
}

// Блокировка store: маршруты, которые store не меняют (так решил компилятор:
// src/rw.kh), идут параллельно; остальные — по одному и без читателей.
// Слова в __store_rw: [0] — мьютекс писателей, [8] — число читателей,
// [16] — писатель ждёт или работает, [24] — сколько читателей спит.
var __store_rw: int
// Сколько раз store брали на запись: по нему видно, что store могли изменить.
var __store_touches: int

fn __store_rw_init() {
    if __store_rw == 0 {
        __store_rw = __mmap(64)
    }
}

// Этот запрос только читает store.
fn __store_shared() {
    store64(__ctx() + CTX_STORE_MODE, 1)
}

fn __store_read_lock(rw: int) {
    while true {
        if load64(rw + 16) == 0 {
            __xadd(rw + 8, 1)
            if load64(rw + 16) == 0 {
                return
            }
            // пришёл писатель: уступить ему
            if __xadd(rw + 8, -1) == 1 {
                syscall(SYS_FUTEX, rw + 8, FUTEX_WAKE_PRIVATE, 1, 0, 0, 0)
            }
        }
        __xadd(rw + 24, 1)
        if load64(rw + 16) != 0 {
            syscall(SYS_FUTEX, rw + 16, FUTEX_WAIT_PRIVATE, 1, 0, 0, 0)
        }
        __xadd(rw + 24, -1)
    }
}

fn __store_lock() {
    let c = __ctx()
    if load64(c + CTX_STORE_HELD) != 0 {
        return
    }
    __store_rw_init()
    let rw = __store_rw
    if load64(c + CTX_STORE_MODE) == 1 {
        __store_read_lock(rw)
        store64(c + CTX_STORE_HELD, 2)
        return
    }
    __mutex_lock(rw)
    __xchg(rw + 16, 1)
    while true {
        let r = load64(rw + 8)
        if r == 0 {
            break
        }
        syscall(SYS_FUTEX, rw + 8, FUTEX_WAIT_PRIVATE, r, 0, 0, 0)
    }
    store64(c + CTX_STORE_HELD, 1)
    __store_touches += 1
}

fn __store_unlock() {
    let c = __ctx()
    let held = load64(c + CTX_STORE_HELD)
    if held == 0 {
        return
    }
    store64(c + CTX_STORE_HELD, 0)
    let rw = __store_rw
    if held == 2 {
        if __xadd(rw + 8, -1) == 1 && load64(rw + 16) != 0 {
            syscall(SYS_FUTEX, rw + 8, FUTEX_WAKE_PRIVATE, 1, 0, 0, 0)
        }
        return
    }
    __xchg(rw + 16, 0)
    if load64(rw + 24) != 0 {
        syscall(SYS_FUTEX, rw + 16, FUTEX_WAKE_PRIVATE, 0x7FFFFFFF, 0, 0, 0)
    }
    __mutex_unlock(rw)
}

// ---- Постоянная память ----
// Неизменяемые данные на всё время процесса (таблица символов, программы
// регулярных выражений): куски по 64 КБ из mmap, блок от 16 КБ — свой mmap.
// Память обнулена. Выделитель потока (CTX_PTR) не переключается, поэтому паника
// не может оставить его переключённым. В блоке __store_rw: [48] — замок,
// [56] — текущий кусок; первое слово куска — его свободное место.
const PERM_CHUNK = 65536
const PERM_BIG = 16384

fn __perm_alloc(n: int) -> int {
    if n >= PERM_BIG {
        return __mmap(n)
    }
    let size = (n + 15) & ~15
    __store_rw_init()
    let lock = __store_rw + 48
    __mutex_lock(lock)
    var c = load64(__store_rw + 56)
    if c == 0 || load64(c) + size > c + PERM_CHUNK {
        // без __mmap: его паника оставила бы замок закрытым
        c = syscall(SYS_MMAP, 0, PERM_CHUNK, 3, 0x22, -1, 0)
        if c < 0 {
            __mutex_unlock(lock)
            __panic(PANIC_MEMORY, "mmap")
        }
        store64(c, c + 16)
        store64(__store_rw + 56, c)
    }
    let p = load64(c)
    store64(c, p + size)
    __mutex_unlock(lock)
    return p
}

// ---- Арены ----

// Начало свободной арены или 0, если адреса арен кончились. Счётчик — слово
// [32] в блоке __store_rw: его создают до запуска потоков.
fn __arena_take() -> int {
    __store_rw_init()
    let slot = __xadd(__store_rw + 32, 1)
    if slot >= ARENA_SLOTS {
        return 0
    }
    return ARENA_REGION + slot * ARENA_SIZE
}

// Арена для текущего контекста (поток задач, тесты).
fn __arena_init() {
    let base = __arena_take()
    if base == 0 {
        __panic(PANIC_MEMORY, "arena region")
    }
    __arena_attach(__ctx(), base)
}

// ---- Сопрограммы ----
// Запрос сервера выполняется в сопрограмме. Когда ему нужно ждать сеть (fetch)
// или время (sleep), он останавливается, и поток тем временем выполняет другие
// запросы; синтаксиса для этого нет — функция просто возвращается позже.
//
// Стек запросов у потока один: сопрограммы выполняются на нём по очереди.
// Кадры остановленной сопрограммы копируются в кучу, только когда на стеке
// нужно выполнить другую, и перед продолжением возвращаются на те же адреса,
// поэтому указатели внутрь стека остаются верными. Ждущий запрос занимает
// столько памяти, какова глубина его стека (обычно несколько КБ), каждому
// запросу доступен весь стек, а запросы, которые не ждут, ничего не копируют.
//
// Переключение — __setjmp/__longjmp и часть контекста потока [8, CTX_CO_END):
// выделитель, арена, блокировка store, состояние запроса — своя у сопрограммы.
// Планировщик и цикл событий — в lib/http.kh.

const SYS_POLL = 7
const SYS_NANOSLEEP = 35
const SYS_EPOLL_CTL = 233
const EPOLL_CTL_ADD = 1
const EPOLL_CTL_DEL = 2
const EPOLL_CTL_MOD = 3
const EPOLLIN = 1
const EPOLLOUT = 4
const EPOLLERR = 8
const EPOLLHUP = 16
const EPOLLONESHOT = 0x40000000

// Планировщик сопрограмм потока.
type __Sched {
    ep: int
    // куда сопрограмма возвращает управление (буфер __setjmp)
    jb: int
    // контекст потока [8, CTX_CO_END) планировщика, пока работает сопрограмма
    ctx: int
    // вершина стека запросов
    top: int
    // сопрограмма, чьи кадры сейчас лежат на стеке запросов, или 0
    on_stack: int
    // сроки ожидания: двоичная куча сопрограмм по deadline
    heap: int
    heap_len: int
    // struct epoll_event для epoll_ctl
    ev: int
}

type __Co {
    sch: __Sched
    // где продолжить (буфер __setjmp)
    jb: int
    // контекст [8, CTX_CO_END), пока работают другие
    ctx: int
    // копия кадров со стека запросов, пока на нём работают другие
    stk: int
    stk_len: int
    stk_cap: int
    started: bool
    // ждёт события или срока
    parked: bool
    done: bool
    deadline: int
    // место в куче сроков или -1
    hidx: int
    // события, с которыми сопрограмму разбудили (0 — вышел срок)
    revents: int
    // для сервера: __Worker и задание (lib/http.kh)
    w: int
    job: int
}

fn __heap_at(s: __Sched, i: int) -> __Co {
    return __cast(load64(s.heap + i * 8))
}

fn __heap_set(s: __Sched, i: int, co: __Co) {
    store64(s.heap + i * 8, __cast(co))
    co.hidx = i
}

fn __heap_up(s: __Sched, at: int) {
    var i = at
    let co = __heap_at(s, i)
    while i > 0 {
        let parent = (i - 1) / 2
        let p = __heap_at(s, parent)
        if p.deadline <= co.deadline {
            break
        }
        __heap_set(s, i, p)
        i = parent
    }
    __heap_set(s, i, co)
}

fn __heap_down(s: __Sched, at: int) {
    var i = at
    let co = __heap_at(s, i)
    while true {
        var m = 2 * i + 1
        if m >= s.heap_len {
            break
        }
        if m + 1 < s.heap_len && __heap_at(s, m + 1).deadline < __heap_at(s, m).deadline {
            m += 1
        }
        let child = __heap_at(s, m)
        if child.deadline >= co.deadline {
            break
        }
        __heap_set(s, i, child)
        i = m
    }
    __heap_set(s, i, co)
}

// Места в куче хватает всегда: её размер — наибольшее число сопрограмм потока.
fn __heap_push(s: __Sched, co: __Co) {
    __heap_set(s, s.heap_len, co)
    s.heap_len += 1
    __heap_up(s, s.heap_len - 1)
}

fn __heap_remove(s: __Sched, co: __Co) {
    let i = co.hidx
    if i < 0 {
        return
    }
    co.hidx = -1
    s.heap_len -= 1
    if i == s.heap_len {
        return
    }
    let last = __heap_at(s, s.heap_len)
    __heap_set(s, i, last)
    __heap_up(s, i)
    __heap_down(s, last.hidx)
}

// Остановить сопрограмму co до того, как планировщик её разбудит.
fn __co_park(co: __Co) {
    co.parked = true
    if __setjmp(co.jb) == 0 {
        __longjmp(co.sch.jb)
    }
}

// Ждать без сопрограммы: весь поток (тесты, фоновые задачи, программы без route).
fn __poll(fd: int, events: int, ms: int) -> int {
    let p = __ctx() + 208
    if fd < 0 {
        store64(p, ms / 1000)
        store64(p + 8, ms % 1000 * 1000000)
        syscall(SYS_NANOSLEEP, p, 0)
        return 0
    }
    // struct pollfd: int fd, short events, short revents
    store64(p, (fd & 0xFFFFFFFF) | (events << 32))
    if syscall(SYS_POLL, p, 1, ms) <= 0 {
        return 0
    }
    return (load64(p) >> 48) & 0xFFFF
}

// Ждать, пока fd будет готов к events (EPOLLIN, EPOLLOUT), но не дольше ms
// миллисекунд (ms < 0 — без срока); fd < 0 — просто ждать ms. → события или 0,
// если вышел срок. В сопрограмме ждёт только она: поток выполняет другие
// запросы. Блокировка store на время ожидания отпускается — иначе ждали бы все.
fn __co_wait(fd: int, events: int, ms: int) -> int {
    let c = __ctx()
    if load64(c + CTX_PSAVE_PTR) != 0 {
        __panic_msg("internal: waiting while copying into store")
    }
    let held = load64(c + CTX_STORE_HELD)
    if held != 0 {
        __store_unlock()
    }
    var r = 0
    let cv = load64(c + CTX_CORO)
    var ok = cv != 0
    if ok && fd >= 0 {
        let co: __Co = __cast(cv)
        let s = co.sch
        store64(s.ev, events | EPOLLONESHOT)
        store64(s.ev + 4, cv)
        // такой fd epoll не принимает (обычный файл): ждать как без сопрограммы
        ok = syscall(SYS_EPOLL_CTL, s.ep, EPOLL_CTL_ADD, fd, s.ev) == 0
    }
    if !ok {
        r = __poll(fd, events, ms)
    } else {
        let co: __Co = __cast(cv)
        let s = co.sch
        co.revents = 0
        if ms >= 0 {
            co.deadline = now_ms() + ms
            __heap_push(s, co)
        }
        __co_park(co)
        // проснулась любым путём (событие, срок, уведомление, пока стояла в
        // очереди готовых): записи в куче сроков не остаться — иначе её снимут
        // второй раз с несуществующего места
        if co.hidx >= 0 {
            __heap_remove(s, co)
        }
        if fd >= 0 {
            syscall(SYS_EPOLL_CTL, s.ep, EPOLL_CTL_DEL, fd, s.ev)
        }
        r = co.revents
    }
    if held != 0 {
        __store_lock()
    }
    return r
}

// Разбудить остановленную сопрограмму cv на следующем шаге планировщика (её
// ожидание закончится так, будто вышел срок). Только для того же потока.
fn __co_notify(cv: int) {
    let co: __Co = __cast(cv)
    if !co.parked {
        return
    }
    let s = co.sch
    if co.hidx >= 0 {
        __heap_remove(s, co)
    }
    co.deadline = 0
    __heap_push(s, co)
}

// Пауза на ms миллисекунд. В запросе сервера поток тем временем выполняет
// другие запросы.
fn sleep(ms: int) {
    if ms >= 0 {
        __co_wait(-1, 0, ms)
    }
}

// Дать поработать другим запросам потока (долгие вычисления: хеш пароля).
fn __co_yield() {
    if load64(__ctx() + CTX_CORO) != 0 {
        __co_wait(-1, 0, 0)
    }
}
