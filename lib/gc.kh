// Сборщик мусора store (docs/design/v0.13-store-gc.md): куча store (§4:
// классы размеров, спаны, кучка страниц, битовые карты), загрузка store (§5.3),
// записи контекстов (§3.4, §6: что держат запросы, задачи и тесты, когда
// отпускают store посреди работы) и сама сборка (§7, §8). Сборка пока целиком
// инкрементальная (шаг 6a проекта): начало — под исключительной блокировкой,
// разметка — кусками под мьютексом писателей (читающие запросы идут дальше,
// пишущие — между кусками, с барьером SATB), конец разметки и уборка — тоже под
// ним. Уборка кусками — шаг 6b.
//
// Программы без store вместо этого файла получают lib/nostore.kh; проверки
// (KHRIP_GC_VERIFY) — в lib/gc_verify.kh или заглушки lib/gc_noverify.kh;
// самопроверка кучки страниц — lib/gc_test.kh (src/main.kh).

// Признак проверок сборщика __gc_verify — в lib/core.kh (его смотрит и код
// рантайма, общий с программами без store).
// Проверки и при каждом выделении (KHRIP_GC_VERIFY=1): быстрого пути нет
var __gc_verify_slow: bool
// Выделение — только общим путём (__salloc_slow): идут проверки при каждом
// выделении или разметка. Признак пересчитывает __gc_slow_update; разметку
// включает и выключает только __gc_set_marking.
var __gc_slow: bool

// ---- Настройки (§8.6) ----
// KHRIP_GC — запас кучи над живыми данными в процентах (100) или off: сборки
// нет (выделение — те же классы размеров); KHRIP_GC_MIN_MB — наименьшая цель
// (4 МБ); KHRIP_GC_LOG=1 — строка о каждой сборке в stderr; KHRIP_GC_STRESS=1
// — сборка очень часто: цель — помеченное + 64 КБ (у большой кучи — плюс
// четверть помеченного), а запрос или тест, который выделил столько, собирает
// сам (с проверками, если они есть в программе).
var __gc_pct: int
var __gc_min: int
var __gc_log: bool
var __gc_stress: bool
// KHRIP_GC_SLICE_US — кусок разметки, мкс (200; с KHRIP_GC_STRESS — 5)
var __gc_slice_us: int
const GC_MB = 1048576
const GC_STRESS_STEP = 65536
const GC_MAX = 0x7FFFFFFFFFFFFFFF

// Настройки сборщика из окружения.
fn __gc_init() {
    __gc_pct = 100
    __gc_min = 4 * GC_MB
    if let v = env("KHRIP_GC") {
        if v == "off" {
            __gc_pct = -1
        } else if let n = v.to_int() {
            if n > 0 && n <= 100000 {
                __gc_pct = n
            }
        }
    }
    if let v = env("KHRIP_GC_MIN_MB") {
        if let n = v.to_int() {
            if n >= 1 && n <= 1000000 {
                __gc_min = n * GC_MB
            }
        }
    }
    __gc_log = (env("KHRIP_GC_LOG") ?? "") == "1"
    __gc_stress = (env("KHRIP_GC_STRESS") ?? "") == "1"
    __gc_slice_us = 200
    if __gc_stress {
        __gc_slice_us = 5
    }
    if let n = (env("KHRIP_GC_SLICE_US") ?? "").to_int() {
        if n >= 1 && n <= 1000000 {
            __gc_slice_us = n
        }
    }
    __gc_goal = GC_MAX
    __gc_trigger = GC_MAX
    __gc_hard = GC_MAX
    __gc_limit = GC_MAX
    __gc_verify_init()
}

fn __gc_slow_update() {
    __gc_slow = __gc_verify_slow || __gc_marking != 0
}

// Разметка: пока она идёт, каждый новый объект помечен, а быстрый путь
// __salloc бит MARK не ставит, — поэтому вместе с __gc_marking меняется и
// __gc_slow. Другого способа менять __gc_marking нет.
fn __gc_set_marking(on: bool) {
    if on {
        __gc_marking = 1
    } else {
        __gc_marking = 0
    }
    __gc_slow_update()
}

// ---- Раскладка (§3.1, §3.2) ----
// STORE — 256 ГБ адресов с STORE_REGION (lib/core.kh), страницы по 8 КБ.
// Метаданные — по постоянным адресам в области GCMETA; адреса резервируются в
// __store_init (PROT_NONE), а память подключается вместе с памятью STORE
// (__gc_commit_to), поэтому работает и при строгом учёте памяти ядром.
//   GC_START   — бит на 16 байт: здесь начинается выделенный объект;
//   GC_MARK    — бит на 16 байт: пометка сборщика (шаг 5);
//   GC_PTRB    — бит на 8 байт: в слове может лежать ссылка (у объектов, в
//                которых ссылки ищут); у свободной памяти биты — нули;
//   GC_PAGEMAP — u32 на страницу: первая страница спана + 1 (0 — нет спана);
//   GC_SPANS   — 64 байта на страницу: запись спана лежит у его первой страницы;
//   GC_PHEAP   — кучка страниц: карты free, dirty, released и дерево.
// Бит адреса p: номер g = (p − STORE_REGION) >> 4 (у PTRB — >> 3), слово g >> 6,
// бит g & 63; младший бит — меньший адрес.

const GCMETA = 0x180000000000
const GCMETA_SIZE = 0x304000000
const GC_START = 0x180000000000
const GC_MARK = 0x180080000000
const GC_PTRB = 0x180100000000
const GC_PAGEMAP = 0x180200000000
const GC_SPANS = 0x180240000000
const GC_PHEAP = 0x180300000000
// Слово START адреса p — ((p >> 10) << 3) + GC_START_P, бит — (p >> 4) & 63;
// слово PTRB — ((p >> 9) << 3) + GC_PTRB_P, бит — (p >> 3) & 63 (STORE_REGION
// кратен 2^10): GC_START_P = GC_START − (STORE_REGION >> 7), GC_PTRB_P =
// GC_PTRB − (STORE_REGION >> 6). Так быстрый путь __salloc обходится без
// вычитания начала STORE.
const GC_START_P = 0x17E000000000
const GC_PTRB_P = 0x17C100000000
// части кучки страниц: по 4 МБ на карты (2^25 страниц), 16 МБ на дерево
const GC_PH_PART = 0x400000
const GC_PAGE = 8192
const GC_PAGE_SHIFT = 13
// страниц в STORE: STORE_SIZE / GC_PAGE
const GC_MAX_PAGES = 0x2000000
// самый большой класс размеров; объект больше — свой спан из целых страниц
const GC_SMALL_MAX = 32768
// классов размеров (1..GC_CLASSES; 0 — нет класса)
const GC_CLASSES = 65

// Запись спана (8 слов, GC_SPANS + первая страница · 64):
//   [0]  base — адрес первого объекта;
//   [8]  страниц (32 бита) | класс спана sc (16) | флаги (16);
//   [16] размер слота (у большого спана — все его байты);
//   [24] freeindex — адрес, с которого искать свободный слот (до него свободных
//        нет до следующей уборки);
//   [32] sweepgen — номер уборки, которая прошла спан (или при которой он
//        создан): спан с другим номером ещё не убран;
//   [40] magic (32) | объектов в спане (32); magic = ⌈2^32 / размер⌉: номер слота
//        смещения off — (off · magic) >> 32, точно для смещений спана (меньше
//        80 КБ); у большого — 0 | 1;
//   [48] следующий спан списка частично занятых (первая страница + 1, 0 —
//        конец) | свободных слотов при последней уборке << 32;
//   [56] конец слотов для быстрого пути __salloc или 0, если слоты надо
//        обнулять (NEEDZERO): тогда каждое выделение идёт общим путём.
// Класс спана sc = класс · 2 + 1, если в объектах нет ссылок (NOSCAN).
const S_BASE = 0
const S_INFO = 8
const S_SIZE = 16
const S_FREE = 24
const S_SWEEPGEN = 32
const S_MAGIC = 40
const S_NEXT = 48
const S_FAST = 56
const F_INUSE = 1
const F_NOSCAN = 2
const F_LARGE = 4
const F_NEEDZERO = 8

// Таблицы классов (кусок mmap, __gc_classes): [0..313) — класс по размеру
// (байт): до 1024 байт — номер (n + 15) >> 4, дальше — 56 + ((n + 127) >> 7);
// с 1024 — размер объекта класса (слово), с 2048 — страниц в его спане.
var __gc_tab: int
// текущий спан каждого класса спана (слово на sc) или __gc_none
var __gc_cur: int
// пустая запись спана: слотов в ней нет
var __gc_none: int
// кучка страниц STORE (состояние — см. __ph_init)
var __gc_ph: int
// байт STORE, к которым подключена память (кратно COMMIT)
var __gc_committed: int
// последний __gc_pages взял страницы, где уже были объекты
var __gc_took_dirty: bool
// байт в выделенных объектах (по размерам классов и целым страницам)
var __heap_live: int
// номер уборки: разметка его увеличивает, и все спаны становятся неубранными
var __gc_sweepgen: int
// списки частично занятых спанов (кусок mmap, по 16 байт на класс спана):
// первая и последняя страница + 1 (0 — пусто); уборка дописывает спаны в
// конец по адресам, выделение берёт с головы — самый низкий адрес (§4.2)
var __gc_partial: int

// Резерв адресов STORE и GCMETA, таблицы классов, кучка страниц. Повторный
// вызов ничего не делает.
fn __store_init() {
    if __gc_ready {
        return
    }
    if !__reserve(STORE_REGION, STORE_SIZE) || !__reserve(GCMETA, GCMETA_SIZE) {
        __panic(PANIC_MEMORY, "store region")
    }
    __gc_init()
    __gc_classes()
    __gc_none = __mmap(64)
    __gc_cur = __mmap((GC_CLASSES + 1) * 16)
    for i in 0..(GC_CLASSES + 1) * 2 {
        store64(__gc_cur + i * 8, __gc_none)
    }
    __gc_ph = __mmap(128)
    __ph_init(__gc_ph, GC_PHEAP, GC_PHEAP + GC_PH_PART, GC_PHEAP + 2 * GC_PH_PART, GC_PHEAP + 3 * GC_PH_PART, 512, GC_MAX_PAGES, true)
    __gc_reg = __mmap(16 + GC_MAX_THREADS * 8)
    __gc_partial = __mmap((GC_CLASSES + 1) * 32)
    __gc_ctl = __mmap(64)
    __gc_runs = __mmap(GC_SCAV_RUNS * 16)
    __gc_ready = true
}

// Классы размеров — таблица Go (runtime/sizeclasses.go) от 16 байт до 32 КБ
// без класса 24 байта: объекты лежат по границе 16 байт (бит START на 16
// байт). Хвост спана — не больше 12,5%. До 256 байт классы кратны 16, как и
// округление __alloc, а степени двойки (массивы списков, слоты словарей) —
// ровно классы. В таблице на класс три байта: размер / 16 (два байта, младший
// первым) и страниц в спане.
fn __gc_classes() {
    let src = __data_hex("01 00 01 02 00 01 03 00 01 04 00 01 05 00 01 06 00 01 07 00 01 08 00 01 09 00 01 0A 00 01 0B 00 01 0C 00 01 0D 00 01 0E 00 01 0F 00 01 10 00 01 12 00 01 14 00 01 16 00 01 18 00 01 1A 00 01 1C 00 01 1E 00 01 20 00 01 24 00 01 28 00 01 2C 00 01 30 00 01 38 00 01 40 00 01 48 00 01 50 00 01 58 00 02 60 00 01 70 00 02 80 00 01 90 00 02 A8 00 01 C0 00 03 C8 00 02 D8 00 03 00 01 01 30 01 03 50 01 02 80 01 03 98 01 04 A8 01 05 B0 01 06 00 02 01 50 02 07 60 02 06 80 02 05 A8 02 04 00 03 03 50 03 05 80 03 07 00 04 02 80 04 09 A8 04 07 00 05 05 50 05 08 00 06 03 A8 06 0A 00 07 07 00 08 04")
    let t = __mmap(4096)
    for j in 1..GC_CLASSES + 1 {
        let e = src + (j - 1) * 3
        store64(t + 1024 + j * 8, (load8(e) | (load8(e + 1) << 8)) << 4)
        store64(t + 2048 + j * 8, load8(e + 2))
    }
    // наименьший класс, вмещающий размер: номер i в таблице — размеры до
    // i · 16 (до 1 КБ) или до (i − 56) · 128
    var c = 1
    for i in 0..313 {
        var n = i * 16
        if i > 64 {
            n = (i - 56) * 128
        }
        while load64(t + 1024 + c * 8) < n {
            c += 1
        }
        store8(t + i, c)
    }
    __gc_tab = t
}

// ---- Выделение (§4.2) ----

// Объект store из n байт вида kind (K_NOSCAN, K_PTRS или K_MASK с маской
// mask — lib/core.kh). Только в режиме store (__pmode_on), то есть под
// исключительной блокировкой: метаданные кучи меняет только владелец мьютекса
// писателей (I5). Память нулевая; START отмечает начало объекта, PTRB — слова,
// где могут быть ссылки (у K_PTRS — все слова объекта, хвост слота — нули).
//
// Быстрый путь — объект до 1 КБ, слот freeindex текущего спана класса
// свободен, спан не требует обнуления, нет ни разметки, ни проверок
// (__gc_slow); всё остальное — __salloc_slow. У класса без спана текущий —
// пустая запись __gc_none (freeindex = конец = 0), поэтому проверять 0 не
// нужно.
fn __salloc(n: int, kind: int, mask: int) -> int {
    if n > 1024 || __gc_slow {
        return __salloc_slow(n, kind, mask)
    }
    var sc = load8(__gc_tab + ((n + 15) >> 4)) << 1
    if kind == K_NOSCAN {
        sc += 1
    }
    let s = load64(__gc_cur + (sc << 3))
    let p = load64(s + S_FREE)
    if p < load64(s + S_FAST) {
        let a = ((p >> 10) << 3) + GC_START_P
        let w = load64(a)
        let b = 1 << ((p >> 4) & 63)
        if (w & b) == 0 {
            store64(a, w | b)
            let es = load64(s + S_SIZE)
            store64(s + S_FREE, p + es)
            __heap_live += es
            if kind != K_NOSCAN {
                var m = mask
                if kind == K_PTRS {
                    if n > 504 {
                        __gc_ptrbits(p, n, kind, mask)
                        return p
                    }
                    m = (1 << ((n + 7) >> 3)) - 1
                }
                // объект до 64 слов задевает одно или два слова карты PTRB
                let pa = ((p >> 9) << 3) + GC_PTRB_P
                let sh = (p >> 3) & 63
                store64(pa, load64(pa) | (m << sh))
                if sh != 0 {
                    let hi = (m >> (64 - sh)) & ((1 << sh) - 1)
                    if hi != 0 {
                        store64(pa + 8, load64(pa + 8) | hi)
                    }
                }
            }
            return p
        }
    }
    return __salloc_slow(n, kind, mask)
}

// Общий путь __salloc: любой размер, поиск слота, новый спан, обнуление,
// разметка, проверки.
fn __salloc_slow(n: int, kind: int, mask: int) -> int {
    if __gc_verify {
        __gc_check_owner()
    }
    var c = 0
    if n <= 1024 {
        c = load8(__gc_tab + ((n + 15) >> 4))
    } else if n <= GC_SMALL_MAX {
        c = load8(__gc_tab + 56 + ((n + 127) >> 7))
    } else {
        return __salloc_large(n, kind, mask)
    }
    var sc = c * 2
    if kind == K_NOSCAN {
        sc += 1
    }
    let cur = __gc_cur + sc * 8
    var s = load64(cur)
    var p = __span_take(s)
    if p == 0 {
        s = __gc_refill(sc)
        store64(cur, s)
        p = __span_take(s)
    }
    let es = load64(s + S_SIZE)
    if __gc_marking != 0 {
        // новый объект — чёрный (§7.5): разметка его не смотрит, уборка
        // оставит; его байты — в живое этой сборки
        __gc_bit_set(GC_MARK, p)
        __gc_black_bytes += es
        __gc_black_objs += 1
    }
    if ((load64(s + S_INFO) >> 48) & F_NEEDZERO) != 0 {
        if __gc_verify {
            __gc_check_poison(p, es)
        }
        __memset(p, 0, es)
    } else if __gc_verify {
        __gc_check_zero(p, es)
    }
    if kind != K_NOSCAN {
        __gc_ptrbits(p, n, kind, mask)
    }
    __heap_live += es
    if __heap_live >= __gc_trigger && !__gc_poked {
        __gc_poke()
    }
    return p
}

// Спан для класса спана sc, когда в текущем места нет: голова списка частично
// занятых (убранный спан с самым низким адресом), иначе новый спан.
fn __gc_refill(sc: int) -> int {
    let h = __gc_partial + sc * 16
    let head = load64(h)
    if head == 0 {
        return __span_new(sc)
    }
    let s = GC_SPANS + ((head - 1) << 6)
    let nx = load64(s + S_NEXT) & 0xFFFFFFFF
    store64(h, nx)
    if nx == 0 {
        store64(h + 8, 0)
    }
    store64(s + S_NEXT, load64(s + S_NEXT) & ~0xFFFFFFFF)
    return s
}

// Память для объекта h (рост контейнера store) или любая память в режиме
// store (lib/core.kh, __alloc_for_k): из кучи store. K_LIST_DATA — новый массив
// списка h того же вида, что нынешний.
fn __salloc_for(h: int, n: int, kind: int, mask: int) -> int {
    var k = kind
    if k == K_LIST_DATA {
        k = __gc_kind_of(load64(h))
    }
    if __store_on() {
        return __salloc(n, k, mask)
    }
    // рост контейнера store вне копии: здесь можно собрать (§8.4)
    __gc_hard_check()
    __pmode_on()
    let p = __salloc(n, k, mask)
    __pmode_off()
    return p
}

// Структура по описанию d в куче store (lib/api.kh, __struct_alloc): ссылки
// объекта — поля по маске описания (у варианта — со сдвигом на слово метки);
// полей больше 63 — каждое слово ссылка.
fn __struct_salloc(d: int, n: int, tag: int) -> int {
    var mask = load64(d + 32 + load64(d + 8) * 40)
    var kind = K_MASK
    if mask < 0 {
        kind = K_PTRS
    } else if tag >= 0 {
        mask = mask << 1
    }
    if mask == 0 {
        kind = K_NOSCAN
    }
    if tag < 0 {
        return __salloc(n * 8, kind, mask)
    }
    let p = __salloc(n * 8 + 8, kind, mask)
    store64(p, tag)
    return p + 8
}

// Идёт ли выделение из store (__pmode_on).
fn __store_on() -> bool {
    return load64(__ctx() + CTX_PSAVE_PTR) != 0
}

// Выделять ли память для внутренностей объекта h из store: выделение идёт из
// store или объект сам в store (__alloc_for_k, lib/core.kh).
fn __store_for(h: int) -> bool {
    return load64(__ctx() + CTX_PSAVE_PTR) != 0 || __in_store(h)
}

// Изменение контейнера h (список, словарь; lib/core.kh): у контейнера в store
// — только под исключительной блокировкой. Иначе маршрут, который компилятор
// счёл читающим (src/rw.kh), менял бы store одновременно с другими читателями
// и с разметкой сборщика: лучше ответ 500, чем гонка.
fn __store_mut(h: int) {
    if (h >> 40) == (STORE_REGION >> 40) && load64(__ctx() + CTX_STORE_HELD) != 1 {
        __store_mut_slow()
    }
}

fn __store_mut_slow() {
    __panic_msg("internal: store changed without the exclusive store lock")
}

// Паника (lib/core.kh) во время выделения из store (__pmode_on) сначала
// выходит из него: её текст строится в арене. Иначе паника из-за нехватки
// памяти store паниковала бы снова на своём тексте (и так до переполнения
// стека), а текст лежал бы в store, где на него не ссылается ни один корень.
fn __store_panic() {
    if __store_on() {
        __pmode_off()
    }
}

// Первый свободный слот спана s от freeindex (бит START снят) — его адрес, или
// 0, если свободных нет. Слот занимается.
fn __span_take(s: int) -> int {
    var p = load64(s + S_FREE)
    let es = load64(s + S_SIZE)
    let lim = load64(s + S_BASE) + (load64(s + S_MAGIC) >> 32) * es
    while p < lim {
        let g = (p - STORE_REGION) >> 4
        let a = GC_START + ((g >> 6) << 3)
        let w = load64(a)
        let b = 1 << (g & 63)
        if (w & b) == 0 {
            store64(a, w | b)
            store64(s + S_FREE, p + es)
            return p
        }
        p += es
    }
    store64(s + S_FREE, lim)
    return 0
}

// Новый спан класса спана sc из страниц кучки.
fn __span_new(sc: int) -> int {
    let c = sc >> 1
    let es = load64(__gc_tab + 1024 + c * 8)
    let np = load64(__gc_tab + 2048 + c * 8)
    let pg = __gc_pages(np)
    let base = STORE_REGION + (pg << GC_PAGE_SHIFT)
    var fl = F_INUSE
    if (sc & 1) != 0 {
        fl = fl | F_NOSCAN
    }
    if __gc_took_dirty {
        fl = fl | F_NEEDZERO
    }
    let ne = (np << GC_PAGE_SHIFT) / es
    let s = GC_SPANS + (pg << 6)
    store64(s + S_BASE, base)
    store64(s + S_INFO, np | (sc << 32) | (fl << 48))
    store64(s + S_SIZE, es)
    store64(s + S_FREE, base)
    store64(s + S_SWEEPGEN, __gc_sweepgen)
    store64(s + S_MAGIC, ((0x100000000 + es - 1) / es) | (ne << 32))
    store64(s + S_NEXT, 0)
    if (fl & F_NEEDZERO) == 0 {
        store64(s + S_FAST, base + ne * es)
    } else {
        store64(s + S_FAST, 0)
    }
    __gc_pagemap_set(pg, np, pg + 1)
    return s
}

// Спан после уборки, где остались объекты: свободные слоты ищутся
// снова с начала (freeindex — адрес первого слота), а быстрый путь закрыт
// (S_FAST = 0) — освобождённые слоты надо обнулять при выделении (NEEDZERO).
// Биты START и PTRB освобождённых слотов уборка уже сняла.
fn __span_rewind(s: int) {
    store64(s + S_FREE, load64(s + S_BASE))
    store64(s + S_FAST, 0)
    store64(s + S_INFO, load64(s + S_INFO) | (F_NEEDZERO << 48))
}

// Спан, где не осталось объектов, — страницы кучке: биты START, MARK и
// PTRB его памяти снимаются (у свободной памяти они нули), записи карты
// страниц — нули, запись спана — не INUSE; страницы — свободны и грязны (их
// следующий спан обнулит). Байты объектов из __heap_live вычитает вызывающий.
fn __span_free(s: int) {
    let base = load64(s + S_BASE)
    let np = load64(s + S_INFO) & 0xFFFFFFFF
    let pg = (base - STORE_REGION) >> GC_PAGE_SHIFT
    let g = (base - STORE_REGION) >> 4
    __bits_put(GC_START, g, g + (np << 9), false)
    __bits_put(GC_MARK, g, g + (np << 9), false)
    __bits_put(GC_PTRB, g << 1, (g << 1) + (np << 10), false)
    __gc_pagemap_set(pg, np, 0)
    store64(s + S_INFO, 0)
    store64(s + S_FREE, 0)
    store64(s + S_FAST, 0)
    __ph_free(__gc_ph, pg, np)
}

// Объект больше GC_SMALL_MAX — свой спан из целых страниц.
fn __salloc_large(n: int, kind: int, mask: int) -> int {
    let np = (n + GC_PAGE - 1) >> GC_PAGE_SHIFT
    let pg = __gc_pages(np)
    let base = STORE_REGION + (pg << GC_PAGE_SHIFT)
    let bytes = np << GC_PAGE_SHIFT
    var fl = F_INUSE | F_LARGE
    if kind == K_NOSCAN {
        fl = fl | F_NOSCAN
    }
    let s = GC_SPANS + (pg << 6)
    store64(s + S_BASE, base)
    store64(s + S_INFO, np | (fl << 48))
    store64(s + S_SIZE, bytes)
    store64(s + S_FREE, base + bytes)
    store64(s + S_SWEEPGEN, __gc_sweepgen)
    store64(s + S_MAGIC, 1 << 32)
    store64(s + S_NEXT, 0)
    store64(s + S_FAST, 0)
    __gc_pagemap_set(pg, np, pg + 1)
    __gc_bit_set(GC_START, base)
    if __gc_marking != 0 {
        __gc_bit_set(GC_MARK, base)
        __gc_black_bytes += bytes
        __gc_black_objs += 1
    }
    if __gc_took_dirty {
        if __gc_verify {
            __gc_check_poison(base, bytes)
        }
        __memset(base, 0, bytes)
    } else if __gc_verify {
        __gc_check_zero(base, bytes)
    }
    if kind != K_NOSCAN {
        __gc_ptrbits(base, n, kind, mask)
    }
    __heap_live += bytes
    if __heap_live >= __gc_trigger && !__gc_poked {
        __gc_poke()
    }
    return base
}

// Биты PTRB объекта p из n байт: у K_PTRS — единицы на каждое слово, у K_MASK —
// маска. Остальные биты слота — уже нули (у свободной памяти они нули).
fn __gc_ptrbits(p: int, n: int, kind: int, mask: int) {
    let b = (p - STORE_REGION) >> 3
    var m = mask
    if kind == K_PTRS {
        let k = (n + 7) >> 3
        if k >= 64 {
            __bits_put(GC_PTRB, b, b + k, true)
            return
        }
        m = (1 << k) - 1
    }
    let sh = b & 63
    let a = GC_PTRB + ((b >> 6) << 3)
    store64(a, load64(a) | (m << sh))
    if sh != 0 {
        let hi = (m >> (64 - sh)) & ((1 << sh) - 1)
        if hi != 0 {
            store64(a + 8, load64(a + 8) | hi)
        }
    }
}

// np страниц для спана: первые подходящие по адресу из кучки, память к ним
// подключена. __gc_took_dirty — на них уже были объекты (их надо обнулять).
fn __gc_pages(np: int) -> int {
    let ph = __gc_ph
    let pg = __ph_find(ph, np)
    if pg < 0 {
        __panic(PANIC_MEMORY, "region")
    }
    let end = (pg + np) << GC_PAGE_SHIFT
    if end > __gc_committed {
        __gc_commit_to(end)
    }
    __gc_took_dirty = __ph_take(ph, pg, np)
    return pg
}

fn __gc_pagemap_set(pg: int, np: int, v: int) {
    var i = 0
    while i < np {
        store32(GC_PAGEMAP + ((pg + i) << 2), v)
        i += 1
    }
}

// Подключить память STORE до end байт (кратно COMMIT) и метаданные к ней:
// START, MARK, PTRB, PAGEMAP и SPANS — по паре в таблице: смещение от GCMETA
// в гигабайтах и сдвиг (байт метаданных — байт STORE >> сдвиг).
fn __gc_commit_to(end: int) {
    let old = __gc_committed
    let nw = (end + COMMIT - 1) & ~(COMMIT - 1)
    if nw > STORE_SIZE {
        __panic(PANIC_MEMORY, "region")
    }
    __gc_mprotect(STORE_REGION, old, nw)
    let t = __data_hex("00 07 02 07 04 06 08 0B 09 07")
    for i in 0..5 {
        let sh = load8(t + i * 2 + 1)
        __gc_mprotect(GCMETA + (load8(t + i * 2) << 30), old >> sh, nw >> sh)
    }
    __gc_committed = nw
}

// Память [base + from, base + to) — на чтение и запись (по целым страницам ОС).
fn __gc_mprotect(base: int, from: int, to: int) {
    let a = from & ~4095
    let b = (to + 4095) & ~4095
    if b > a && syscall(10, base + a, b - a, 3) < 0 {
        __panic(PANIC_MEMORY, "mprotect")
    }
}

// Вид памяти, где лежит p (массив списка в store): K_NOSCAN — спан без
// ссылок, иначе K_PTRS. Рост списка наследует вид старого массива (§4.4).
fn __gc_kind_of(p: int) -> int {
    let off = p - STORE_REGION
    if off < 0 || off >= __gc_committed {
        return K_PTRS
    }
    let e = load32(GC_PAGEMAP + ((off >> GC_PAGE_SHIFT) << 2))
    if e == 0 {
        return K_PTRS
    }
    if ((load64(GC_SPANS + ((e - 1) << 6) + S_INFO) >> 48) & F_NOSCAN) != 0 {
        return K_NOSCAN
    }
    return K_PTRS
}

// Начало выделенного объекта, внутри которого лежит p, или 0: p вне занятых
// страниц STORE, в хвосте спана или в свободном слоте.
fn __gc_obj_of(p: int) -> int {
    let off = p - STORE_REGION
    if off < 0 || off >= (load64(__gc_ph + PH_HW) << GC_PAGE_SHIFT) {
        return 0
    }
    let e = load32(GC_PAGEMAP + ((off >> GC_PAGE_SHIFT) << 2))
    if e == 0 {
        return 0
    }
    let s = GC_SPANS + ((e - 1) << 6)
    let fl = load64(s + S_INFO) >> 48
    if (fl & F_INUSE) == 0 {
        return 0
    }
    let base = load64(s + S_BASE)
    var slot = base
    if (fl & F_LARGE) == 0 {
        let mg = load64(s + S_MAGIC)
        let i = ((p - base) * (mg & 0xFFFFFFFF)) >> 32
        if i >= mg >> 32 {
            return 0
        }
        slot = base + i * load64(s + S_SIZE)
    }
    if !__gc_bit(GC_START, slot) {
        return 0
    }
    return slot
}

// Размер слота объекта o (начало выделенного объекта).
fn __gc_obj_size(o: int) -> int {
    return load64(__gc_span_of(o) + S_SIZE)
}

// Спан, в котором лежит p (p в занятой странице STORE).
fn __gc_span_of(p: int) -> int {
    let e = load32(GC_PAGEMAP + (((p - STORE_REGION) >> GC_PAGE_SHIFT) << 2))
    return GC_SPANS + ((e - 1) << 6)
}

// ---- Битовые карты ----

// Бит адреса p в карте START или MARK.
fn __gc_bit(bm: int, p: int) -> bool {
    let g = (p - STORE_REGION) >> 4
    return ((load64(bm + ((g >> 6) << 3)) >> (g & 63)) & 1) != 0
}

fn __gc_bit_set(bm: int, p: int) {
    let g = (p - STORE_REGION) >> 4
    let a = bm + ((g >> 6) << 3)
    store64(a, load64(a) | (1 << (g & 63)))
}

// Биты [lo, hi) одного слова (0 ≤ lo < hi ≤ 64).
fn __bits_mask(lo: int, hi: int) -> int {
    if hi - lo == 64 {
        return -1
    }
    return ((1 << (hi - lo)) - 1) << lo
}

// Биты [from, to) карты bm — единицы (one) или нули.
fn __bits_put(bm: int, from: int, to: int, one: bool) {
    var i = from
    while i < to {
        let wi = i >> 6
        var hi = to - (wi << 6)
        if hi > 64 {
            hi = 64
        }
        let m = __bits_mask(i & 63, hi)
        let a = bm + (wi << 3)
        if one {
            store64(a, load64(a) | m)
        } else {
            store64(a, load64(a) & ~m)
        }
        i = (wi << 6) + hi
    }
}

// Есть ли единица (one) или ноль (!one) среди битов [from, to) карты bm.
fn __bits_any(bm: int, from: int, to: int, one: bool) -> bool {
    var i = from
    while i < to {
        let wi = i >> 6
        var hi = to - (wi << 6)
        if hi > 64 {
            hi = 64
        }
        let m = __bits_mask(i & 63, hi)
        var w = load64(bm + (wi << 3))
        if !one {
            w = ~w
        }
        if (w & m) != 0 {
            return true
        }
        i = (wi << 6) + hi
    }
    return false
}

// Самая длинная серия единиц в слове.
fn __run_max(w: int) -> int {
    var x = w
    var k = 0
    while x != 0 {
        x = x & ((x >> 1) & 0x7FFFFFFFFFFFFFFF)
        k += 1
    }
    return k
}

// ---- Кучка страниц (§3.2) ----
// Состояние ph (16 слов):
const PH_CAP = 0
// одна за самой верхней занятой страницей
const PH_HW = 8
// карты: бит на страницу; free — свободна, dirty — на ней были объекты с тех
// пор, как её память вернули системе (свободная грязная страница, скорее
// всего, занимает память), released — память возвращена системе. Свободная
// страница с released — чистая; занятая с released — её память сейчас
// возвращает сборщик (__gc_scavenge): спана на ней нет, и взять её нельзя.
const PH_FREE = 16
const PH_DIRTY = 24
const PH_REL = 32
// дерево: узел i — 16 байт, [0] pre | suf << 32, [8] best (страниц)
const PH_TREE = 40
// наибольшая ёмкость (страниц)
const PH_MAX = 48
// операций с последней проверки дерева (KHRIP_GC_VERIFY)
const PH_OPS = 56
// 1 — кучка STORE: память карт и дерева подключается при росте ёмкости
const PH_COMMIT = 64
//
// Ёмкость cap — степень двойки, не меньше 64 страниц; страницы до cap, кроме
// занятых, свободны (и за ph_hw — все). Листья дерева — слова карты free (по
// 64 страницы), их L = cap / 64; узлы 1..2L−1 в порядке кучи, лист j — узел
// L + j. У узла: pre — свободных страниц подряд от его начала, suf — до его
// конца, best — самая длинная серия свободных внутри. Узлы обновляются сразу
// при каждом взятии и возврате, за O(np / 64 + log L); когда ёмкости не
// хватает, она удваивается и дерево строится заново, за O(L).

fn __ph_init(ph: int, fr: int, dt: int, rl: int, tr: int, cap: int, max: int, commit: bool) {
    store64(ph + PH_CAP, cap)
    store64(ph + PH_HW, 0)
    store64(ph + PH_FREE, fr)
    store64(ph + PH_DIRTY, dt)
    store64(ph + PH_REL, rl)
    store64(ph + PH_TREE, tr)
    store64(ph + PH_MAX, max)
    store64(ph + PH_OPS, 0)
    var cm = 0
    if commit {
        cm = 1
        __ph_commit(ph, cap)
    }
    store64(ph + PH_COMMIT, cm)
    __bits_put(fr, 0, cap, true)
    __ph_rebuild(ph)
}

// Память карт и дерева кучки STORE для ёмкости cap.
fn __ph_commit(ph: int, cap: int) {
    __gc_mprotect(load64(ph + PH_FREE), 0, cap >> 3)
    __gc_mprotect(load64(ph + PH_DIRTY), 0, cap >> 3)
    __gc_mprotect(load64(ph + PH_REL), 0, cap >> 3)
    __gc_mprotect(load64(ph + PH_TREE), 0, (cap >> 1) + 16)
}

// Удвоить ёмкость. → false, если она уже наибольшая.
fn __ph_grow(ph: int) -> bool {
    let cap = load64(ph + PH_CAP)
    if cap >= load64(ph + PH_MAX) {
        return false
    }
    if load64(ph + PH_COMMIT) != 0 {
        __ph_commit(ph, cap * 2)
    }
    __bits_put(load64(ph + PH_FREE), cap, cap * 2, true)
    store64(ph + PH_CAP, cap * 2)
    __ph_rebuild(ph)
    return true
}

// Лист i дерева t по слову карты free.
fn __ph_leaf(t: int, i: int, w: int) {
    var pre = 64
    var suf = 64
    var best = 64
    if w != -1 {
        pre = __ctz(~w)
        suf = __clz(~w)
        best = __run_max(w)
    }
    store64(t + (i << 4), pre | (suf << 32))
    store64(t + (i << 4) + 8, best)
}

// Узел i по детям, у которых по cs страниц.
fn __ph_node(t: int, i: int, cs: int) {
    let l = t + (i << 5)
    let lw = load64(l)
    let rw = load64(l + 16)
    let lpre = lw & 0xFFFFFFFF
    let lsuf = lw >> 32
    let rpre = rw & 0xFFFFFFFF
    let rsuf = rw >> 32
    var pre = lpre
    if lpre == cs {
        pre = cs + rpre
    }
    var suf = rsuf
    if rsuf == cs {
        suf = cs + lsuf
    }
    var best = load64(l + 8)
    let rb = load64(l + 24)
    if rb > best {
        best = rb
    }
    if lsuf + rpre > best {
        best = lsuf + rpre
    }
    store64(t + (i << 4), pre | (suf << 32))
    store64(t + (i << 4) + 8, best)
}

// Дерево целиком по карте free.
fn __ph_rebuild(ph: int) {
    let t = load64(ph + PH_TREE)
    let fr = load64(ph + PH_FREE)
    let nl = load64(ph + PH_CAP) >> 6
    for j in 0..nl {
        __ph_leaf(t, nl + j, load64(fr + (j << 3)))
    }
    var lo = nl >> 1
    var cs = 64
    while lo >= 1 {
        for i in lo..lo * 2 {
            __ph_node(t, i, cs)
        }
        lo = lo >> 1
        cs = cs * 2
    }
}

// Узлы над страницами [from, to) после изменения карты free.
fn __ph_update(ph: int, from: int, to: int) {
    let t = load64(ph + PH_TREE)
    let fr = load64(ph + PH_FREE)
    let nl = load64(ph + PH_CAP) >> 6
    var a = from >> 6
    var b = (to - 1) >> 6
    var i = a
    while i <= b {
        __ph_leaf(t, nl + i, load64(fr + (i << 3)))
        i += 1
    }
    a = (nl + a) >> 1
    b = (nl + b) >> 1
    var cs = 64
    while a >= 1 {
        i = a
        while i <= b {
            __ph_node(t, i, cs)
            i += 1
        }
        a = a >> 1
        b = b >> 1
        cs = cs * 2
    }
}

// Первая по адресу серия из np свободных страниц в пределах ёмкости или −1.
// В узле: влево, если там есть серия; иначе серия на стыке (её начало — самое
// левое из возможных); иначе вправо. В листе — перебор битов слова.
fn __ph_first_fit(ph: int, np: int) -> int {
    let t = load64(ph + PH_TREE)
    let nl = load64(ph + PH_CAP) >> 6
    if load64(t + 24) < np {
        return -1
    }
    var i = 1
    var lo = 0
    var size = load64(ph + PH_CAP)
    while i < nl {
        let cs = size >> 1
        let l = t + (i << 5)
        if load64(l + 8) >= np {
            i = i * 2
            size = cs
            continue
        }
        let lsuf = load64(l) >> 32
        if lsuf + (load64(l + 16) & 0xFFFFFFFF) >= np {
            return lo + cs - lsuf
        }
        i = i * 2 + 1
        lo += cs
        size = cs
    }
    let w = load64(load64(ph + PH_FREE) + ((i - nl) << 3))
    var run = 0
    for j in 0..64 {
        if ((w >> j) & 1) != 0 {
            run += 1
            if run >= np {
                return lo + j + 1 - np
            }
        } else {
            run = 0
        }
    }
    __gc_fatal("page heap: the tree promises a run the leaf does not have")
    return -1
}

// Первая по адресу серия из np свободных страниц, с ростом ёмкости; −1 — нет
// места и при наибольшей ёмкости.
fn __ph_find(ph: int, np: int) -> int {
    while true {
        let pg = __ph_first_fit(ph, np)
        if pg >= 0 {
            return pg
        }
        if !__ph_grow(ph) {
            return -1
        }
    }
    return -1
}

// Занять страницы [pg, pg + np) (они свободны). → true, если на какой-то из
// них уже были объекты.
fn __ph_take(ph: int, pg: int, np: int) -> bool {
    let fr = load64(ph + PH_FREE)
    if __gc_verify && __bits_any(fr, pg, pg + np, false) {
        __gc_fatal("page heap: a taken page is not free")
    }
    let dirty = __bits_any(load64(ph + PH_DIRTY), pg, pg + np, true)
    __bits_put(fr, pg, pg + np, false)
    __bits_put(load64(ph + PH_REL), pg, pg + np, false)
    __ph_update(ph, pg, pg + np)
    if pg + np > load64(ph + PH_HW) {
        store64(ph + PH_HW, pg + np)
    }
    __ph_tick(ph)
    return dirty
}

// Вернуть страницы [pg, pg + np) (они заняты): свободны и грязны; граница
// занятых опускается за свободные страницы под ней.
fn __ph_free(ph: int, pg: int, np: int) {
    let fr = load64(ph + PH_FREE)
    if __gc_verify && __bits_any(fr, pg, pg + np, true) {
        __gc_fatal("page heap: a freed page is already free")
    }
    __bits_put(fr, pg, pg + np, true)
    __bits_put(load64(ph + PH_DIRTY), pg, pg + np, true)
    __ph_update(ph, pg, pg + np)
    __ph_lower_hw(ph, pg, np)
    __ph_tick(ph)
}

// Страницы [pg, pg + np) только что стали свободными: если они были верхними
// занятыми, граница занятых опускается за свободные страницы под ними.
fn __ph_lower_hw(ph: int, pg: int, np: int) {
    let fr = load64(ph + PH_FREE)
    var hw = load64(ph + PH_HW)
    if pg + np != hw {
        return
    }
    hw = pg
    while hw > 0 {
        let top = (hw - 1) & 63
        let w = load64(fr + (((hw - 1) >> 6) << 3))
        if top == 63 && w == -1 {
            hw -= 64
        } else if ((w >> top) & 1) != 0 {
            hw -= 1
        } else {
            break
        }
    }
    store64(ph + PH_HW, hw)
}

// Сборщик возвращает память свободных страниц [pg, pg + np) системе
// (__gc_scavenge): пока она возвращается без блокировки, страницы заняты (их
// не возьмёт спан), а released отмечает, что спана на них нет. Граница занятых
// не меняется.
fn __ph_scav_take(ph: int, pg: int, np: int) {
    let fr = load64(ph + PH_FREE)
    if __gc_verify && __bits_any(fr, pg, pg + np, false) {
        __gc_fatal("page heap: a page to release is not free")
    }
    __bits_put(fr, pg, pg + np, false)
    __bits_put(load64(ph + PH_REL), pg, pg + np, true)
    __ph_update(ph, pg, pg + np)
    __ph_tick(ph)
}

// Память страниц [pg, pg + np) возвращена: страницы снова свободны, чистые
// (released, не dirty) — спан на них обнулять не нужно.
fn __ph_scav_done(ph: int, pg: int, np: int) {
    let fr = load64(ph + PH_FREE)
    __bits_put(fr, pg, pg + np, true)
    __bits_put(load64(ph + PH_DIRTY), pg, pg + np, false)
    __ph_update(ph, pg, pg + np)
    __ph_lower_hw(ph, pg, np)
    __ph_tick(ph)
}

// ---- Записи контекстов (§3.4, §6) ----
// Запрос, задача или тест, который взял store и отпускает его посреди работы
// (ожидание сети или времени, хеш пароля: __store_release_keep в lib/rt.kh),
// публикует запись: слова со значением в STORE из своих регистров, стека,
// слов контекста [8, CTX_CO_END), __Worker и буферов __setjmp, а арену —
// только границами [lo, hi) (её сборщик просмотрит, только если сборка
// придётся на окно). Следующее взятие store отзывает запись. Так сборщик
// найдёт всё, что держит контекст без блокировки, и не будет его ждать.
//
// Запись одна на контекст: на сопрограмму (создаётся в __co_new) и на поток
// вне сопрограмм (при первом взятии store). Опубликованные записи потока —
// двусвязный список с головой в CTX_PINLIST; меняет его только контекст этого
// потока, держа блокировку store (I4). Публикация и отзыв строго чередуются с
// блокировкой: опубликована — только между __store_release_keep и следующим
// __store_lock (или __store_release_final после паники в окне).

// Запись контекста. Память — обычная память потока (__alloc_heap), не арена:
// запись живёт, пока жив контекст. Поле ast — первое: его адрес — адрес
// записи (__cas).
type __Pin {
    // передача арены сборщику: (номер сборки << 3) | состояние PIN_*
    ast: int
    // соседи в списке опубликованных записей потока (0 — конец)
    next: int
    prev: int
    // опубликована
    linked: bool
    // контекст брал store в этой работе (запрос, задача, тест)
    touched: bool
    // вершина стека контекста: стек копируется от регистра rsp до неё
    top: int
    // регистры при публикации (буфер __setjmp, 64 байта)
    regs: int
    // слова со значением в STORE (mmap, растёт вдвое): len из cap
    buf: int
    len: int
    cap: int
    // арена [lo, hi) при публикации; lo == hi — арены нет
    lo: int
    hi: int
    // байт [lo, hi), которые сборщик уже просмотрел в этой сборке
    aoff: int
    // слова арены, которые просмотрел сам контекст при передаче (mmap)
    hbuf: int
    hlen: int
    hcap: int
    // __gc_cycle_no при публикации (отчёт о долгих держателях, §8.6)
    pub_cycle: int
    // KHRIP_GC_VERIFY: хеш слов со значением в STORE в [lo, hi) (W1)
    whash: int
    // следующая запись в реестре всех записей (__gc_reg)
    all: int
}

// размер __Pin: 19 полей по 8 байт; полей в __Worker (lib/api.kh) — запись
// копирует их. Обе цифры сверяет с типами tests/api/gc_records.kh.
const PIN_BYTES = 152
const WORKER_WORDS = 9
// начальный буфер слов записи (байт)
const PIN_BUF0 = 4096
// потоков, которые могут публиковать записи: рабочие (не больше THREADS_MAX,
// lib/http.kh), поток задач и поток сборщика
const GC_MAX_THREADS = 4096
// Состояния передачи арены (ast & 7, §6.2–6.3): сборщик ещё не смотрел арену
// (PENDING), смотрит кусок (GC), её смотрит сам контекст (SELF) и передал
// найденное (HANDED), сборщик закончил (DONE). Вне разметки — IDLE.
const PIN_IDLE = 0
const PIN_PENDING = 1
const PIN_GC = 2
const PIN_SELF = 3
const PIN_HANDED = 4
const PIN_DONE = 5

// Реестр (кусок mmap, __store_init): [0] — последняя созданная запись (по
// полю all — все остальные), [8] — сколько потоков записано, [16 + 8·i] —
// контекст потока i (CTX_PINLIST — его опубликованные записи).
var __gc_reg: int
// номер сборки
var __gc_cycle_no: int
// KHRIP_GC_VERIFY: сколько раз проверено начало сборки (__gc_verify_start) и
// сколько опубликованных записей при этом встретилось
var __gc_vstarts: int
var __gc_vlinked: int

// Новая запись контекста с вершиной стека top (lib/http.kh, __co_new; для
// потока — __pin_acquired). Память — обычная память потока; запись — в
// реестр, без блокировки (CAS).
fn __pin_new(top: int) -> int {
    let r = __alloc_heap(PIN_BYTES)
    let rec: __Pin = __cast(r)
    rec.top = top
    rec.regs = __alloc_heap(64)
    while true {
        let h = load64(__gc_reg)
        rec.all = h
        if __cas(__gc_reg, h, r) {
            break
        }
    }
    return r
}

// Взятие store (__store_lock, блокировка уже взята): контекст брал store в этой
// работе; опубликованная запись отзывается. У потока вне сопрограмм запись
// создаётся при первом взятии. Без кучи store (до __store_init) указателей в
// store нет и запись не нужна.
fn __pin_acquired(c: int) {
    var r = load64(c + CTX_PINREC)
    if r == 0 {
        if !__gc_ready {
            return
        }
        r = __pin_new(__pin_top(c))
        store64(c + CTX_PINREC, r)
    }
    let rec: __Pin = __cast(r)
    rec.touched = true
    if rec.linked {
        __pin_withdraw(rec)
    }
    if __gc_verify && load64(c + CTX_STORE_HELD) == 1 {
        __gc_verify_start(r)
    }
}

// Вершина стека контекста: у сопрограммы — стек запросов потока, иначе — стек
// потока (CTX_STACK_TOP: __entry, __thread_main).
fn __pin_top(c: int) -> int {
    let cv = load64(c + CTX_CORO)
    if cv != 0 {
        let co: __Co = __cast(cv)
        return co.sch.top
    }
    return load64(c + CTX_STACK_TOP)
}

// Публикация (__store_release_keep; блокировка ещё взята): регистры (__setjmp
// здесь: то, что вызвавшие держат в rbx, rbp, r12–r15, либо ещё в регистрах,
// либо сохранено в их кадрах, I7), весь стек от rsp до вершины, слова
// контекста [8, CTX_CO_END) (текст паники, CTX_JNULLS, ...), __Worker и буферы
// __setjmp запроса и CTX_CATCH — копируются слова со значением в STORE; арена
// запоминается границами: [начало арены, CTX_PTR). Затем запись — в список
// потока.
fn __pin_publish(r: int) {
    if r == 0 {
        return
    }
    let rec: __Pin = __cast(r)
    if __gc_verify {
        __gc_check_slow()
        if rec.linked {
            __gc_fatal("a context record is published twice (I4)")
        }
    }
    __setjmp(rec.regs)
    let sp = load64(rec.regs + 8)
    if sp >= rec.top {
        // стек не был бы скопирован: лучше остановиться, чем потерять указатели
        __oom_exit("khrip: internal: a store context record without its stack top\n")
    }
    rec.len = 0
    __pin_take(rec, rec.regs, 8)
    __pin_take(rec, sp, (rec.top - sp) >> 3)
    let c = __ctx()
    __pin_take(rec, c + 8, (CTX_CO_END - 8) >> 3)
    let wv = load64(c + CTX_WORKER)
    if wv != 0 {
        let w: __Worker = __cast(wv)
        __pin_take(rec, wv, WORKER_WORDS)
        __pin_take(rec, w.jb, 8)
    }
    let cj = load64(c + CTX_CATCH)
    if cj != 0 {
        __pin_take(rec, cj, 8)
    }
    let p = load64(c + CTX_PTR)
    if __in_arena(p) {
        rec.lo = load64(c + CTX_ARENA)
        rec.hi = p
    } else {
        rec.lo = 0
        rec.hi = 0
    }
    if __gc_verify {
        rec.whash = __pin_hash(rec.lo, rec.hi)
    }
    rec.pub_cycle = __gc_cycle_no
    __gc_register_thread(c)
    let h = load64(c + CTX_PINLIST)
    rec.next = h
    rec.prev = 0
    if h != 0 {
        let hr: __Pin = __cast(h)
        hr.prev = r
    }
    store64(c + CTX_PINLIST, r)
    rec.linked = true
}

// Слова [p, p + 8n) со значением в STORE — в буфер записи. Места в буфере —
// на все n слов (__simd_pinscan): он растёт вдвое, новый кусок mmap — с копией
// занятых слов, старый — системе.
fn __pin_take(rec: __Pin, p: int, n: int) {
    if n <= 0 {
        return
    }
    if rec.len + n > rec.cap {
        let nc = __pin_cap(rec.cap, rec.len + n)
        let nb = __mmap(nc * 8)
        if rec.len > 0 {
            __memcpy(nb, rec.buf, rec.len * 8)
        }
        if rec.buf != 0 {
            syscall(SYS_MUNMAP, rec.buf, rec.cap * 8)
        }
        rec.buf = nb
        rec.cap = nc
    }
    rec.len += __simd_pinscan(p, n, rec.buf + rec.len * 8)
}

// Вместимость буфера слов на need слов: вдвое, начальная — PIN_BUF0 байт.
fn __pin_cap(cap: int, need: int) -> int {
    var nc = cap
    if nc == 0 {
        nc = PIN_BUF0 >> 3
    }
    while nc < need {
        nc *= 2
    }
    return nc
}

// Отзыв (взятие store, блокировка уже взята): запись уходит из списка потока.
// С KHRIP_GC_VERIFY арена ниже опубликованной границы должна быть той же
// (W1). Если сборка, начатая в окне, ещё не досмотрела арену (PENDING),
// контекст досматривает её сам и передаёт найденное (HANDED, I9): после отзыва
// он снова пишет в арену; если сборщик смотрит её кусок (GC; так бывает только
// у читателя — писатель держит мьютекс писателей, и кусков нет) — подождать
// (кусок не больше GC_ACHUNK байт). IDLE, DONE, HANDED — делать нечего.
fn __pin_withdraw(rec: __Pin) {
    let c = __ctx()
    let r: int = __cast(rec)
    if rec.prev == 0 {
        if __gc_verify && load64(c + CTX_PINLIST) != r {
            __gc_fatal("a published record is not in its thread's list (I4)")
        }
        store64(c + CTX_PINLIST, rec.next)
    } else {
        let pv: __Pin = __cast(rec.prev)
        pv.next = rec.next
    }
    if rec.next != 0 {
        let nx: __Pin = __cast(rec.next)
        nx.prev = rec.prev
    }
    rec.next = 0
    rec.prev = 0
    rec.linked = false
    if __gc_verify && __pin_hash(rec.lo, rec.hi) != rec.whash {
        __gc_fatal("code in a store window changed a store pointer in the arena below the published bound (W1)")
    }
    var spins = 0
    while true {
        let s = rec.ast
        let st = s & 7
        if st == PIN_PENDING {
            if __cas(r, s, (s & ~7) | PIN_SELF) {
                __pin_self_scan(rec)
                rec.ast = (s & ~7) | PIN_HANDED
                break
            }
        } else if st == PIN_GC {
            __gc_spin(spins)
            spins += 1
        } else {
            break
        }
    }
}

// Передача (PENDING → SELF): контекст сам просматривает непросмотренную часть
// арены [lo + aoff, hi) в hbuf; сборщик разберёт найденное (§6.3). Без паники:
// запись в SELF ждёт конец разметки, и паника здесь оставила бы его ждать
// вечно, — нехватка памяти тут, как в самом сборщике, — конец программы
// (__gc_scratch).
fn __pin_self_scan(rec: __Pin) {
    let from = __pin_arena_from(rec)
    let n = (rec.hi - from) >> 3
    rec.hlen = 0
    if n <= 0 {
        return
    }
    if n > rec.hcap {
        let nc = __pin_cap(rec.hcap, n)
        let nb = __gc_scratch(nc * 8)
        if rec.hbuf != 0 {
            syscall(SYS_MUNMAP, rec.hbuf, rec.hcap * 8)
        }
        rec.hbuf = nb
        rec.hcap = nc
    }
    rec.hlen = __simd_pinscan(from, n, rec.hbuf)
}

// KHRIP_GC_VERIFY: хеш слов со значением в STORE в [lo, hi) вместе с их
// адресами (W1). Кэш строк в начале арены (STRC_SIZE байт, lib/text.kh) не в
// счёт: его ключи — адреса для сравнения, не ссылки (устаревшие ключи
// снимает номер сборки __store_epoch).
fn __pin_hash(lo: int, hi: int) -> int {
    var p = lo
    if hi - lo >= STRC_SIZE {
        p = lo + STRC_SIZE
    }
    var h = 0
    while p < hi {
        let w = load64(p)
        if (w >> 38) == 0x40 {
            h = (h ^ w ^ (p << 1)) * 0x100000001B3
        }
        p += 8
    }
    return h
}

// Последнее отпускание без блокировки (__store_release_final): → true, если
// запись опубликована (паника в окне) — тогда блокировка берётся снова, и
// отзыв идёт под ней; иначе работа просто закончена. С KHRIP_GC_VERIFY
// контекст, который брал store и не держит ни блокировки, ни опубликованной
// записи, — нарушение I3 (отпускание мимо __store_release_keep): проверка
// начала сборки видит только другие контексты, а единственный (khc test)
// попадается здесь.
fn __pin_unfinished(c: int) -> bool {
    let r = load64(c + CTX_PINREC)
    if r == 0 {
        return false
    }
    let rec: __Pin = __cast(r)
    if rec.linked {
        return true
    }
    if __gc_verify && rec.touched {
        // брал store и отпустил его без записи, а теперь заканчивает работу:
        // всё это время сборщик не видел, что он держит
        __gc_fatal("a context released store in the middle of its work without publishing its record (I3)")
    }
    rec.touched = false
    return false
}

// Последнее отпускание под блокировкой (__store_release_final): проверки
// сборщика (граф и куча после работы под исключительной блокировкой), хук
// писателя — сборка, если куча дошла до жёсткого предела (§8.4; с
// KHRIP_GC_STRESS — каждые 64 КБ): публиковать ничего не нужно, контекст со
// store закончил (I8). Кроме запроса внутри call теста (__gc_nested): его
// последнее отпускание — не конец работы теста, кадры и арена теста над ним
// ещё держат указатели в store; собирать — точке сборки теста сразу после
// запроса, которая публикует тест. Помощь разметке — шаг 6b. Работа
// закончена.
fn __pin_final(c: int) {
    __gc_verify_release()
    let r = load64(c + CTX_PINREC)
    if __heap_live >= __gc_limit && load64(c + CTX_STORE_HELD) == 1 && !__gc_busy && !__store_on() && !__gc_nested(c) {
        __gc_collect_now(r, GC_WHY_RELEASE)
    }
    if r != 0 {
        let rec: __Pin = __cast(r)
        rec.touched = false
    }
}

// Запрос вложен в call теста (lib/api.kh, __call): __serve_one вернул в
// CTX_CATCH буфер теста (у запроса сервера, задачи, сохранения, загрузки и в
// конце теста там 0; так же их различает __mongo_request_end). Его последнее
// отпускание — не конец работы контекста: тест над ним держит свои значения.
fn __gc_nested(c: int) -> bool {
    return load64(c + CTX_CATCH) != 0
}

// KHRIP_GC_VERIFY (__co_put): сопрограмма закончила запрос последним
// отпусканием, её запись не опубликована (W3).
fn __pin_check_idle(r: int) {
    if r != 0 {
        let rec: __Pin = __cast(r)
        if rec.linked || rec.touched {
            __gc_fatal("a finished request left its context record published (W3)")
        }
    }
}

// Поток — в реестр при первой публикации (флаг CTX_REGISTERED): сборщик
// обходит списки записей записанных потоков.
fn __gc_register_thread(c: int) {
    if load64(c + CTX_REGISTERED) != 0 {
        return
    }
    let i = __xadd(__gc_reg + 8, 1)
    if i >= GC_MAX_THREADS {
        __oom_exit("khrip: more than 4096 threads hold store pointers\n")
    }
    store64(__gc_reg + 16 + i * 8, c)
    store64(c + CTX_REGISTERED, 1)
}

// ---- Сборка (§7) ----
// Цикл: начало под исключительной блокировкой — номер сборки, корни, слова
// опубликованных записей (в массив записей), их арены (в список захваченных);
// разметка кусками под мьютексом писателей (__store_lock_marker); конец
// разметки и уборка всех спанов — тоже под ним. Читающие запросы идут всё это
// время: граф они не меняют, а всё, что они достают из store, достижимо и
// будет помечено. Пишущие идут между кусками: каждое затирание ссылки сначала
// серит старое значение (SATB, I6: барьеры компилятора __barrier_at,
// __barrier_idx и __persist_root в lib/api.kh, хуки операций контейнеров в
// lib/core.kh), а каждый новый объект сразу помечен (чёрный, __salloc_slow).
// Так к концу разметки помечено всё, что было достижимо в начале, и всё новое;
// остальное уходит в уборку.
//
// Начинает сборку поток сборщика (по порогу). Целиком («остановкой мира»)
// собирает тот, кто держит store исключительно: запрос или задача у жёсткого
// предела (опубликовав себя), последнее отпускание у жёсткого предела, тест
// (после call и в конце теста), __gc_collect(). Идущую разметку они
// дорабатывают с того, что есть (§8.4), затем делают новую сборку целиком: в
// её начале каждый контекст, который держит указатели в store без блокировки,
// опубликовал запись (I3), а сам собирающий опубликован или со store
// закончил (I8).

// Фазы (§7.1)
const GC_PH_IDLE = 0
const GC_PH_MARK = 1
const GC_PH_SWEEP = 2
// Кто собирает (журнал): поток сборщика — по порогу и после простоя; запрос
// или задача посреди работы у жёсткого предела; последнее отпускание у
// жёсткого предела; khc test; __gc_collect() и шаги тестов; окно в khc test
// с KHRIP_GC_STRESS; сборка раз в две минуты; шаг KHRIP_GC_STRESS в khc test
const GC_WHY_PACE = 1
const GC_WHY_IDLE = 2
const GC_WHY_EMERGENCY = 3
const GC_WHY_RELEASE = 4
const GC_WHY_TEST = 5
const GC_WHY_CALL = 6
const GC_WHY_WINDOW = 7
const GC_WHY_FORCED = 8
const GC_WHY_STRESS = 9
// запись опубликована столько сборок назад — долгий держатель (§8.6)
const GC_LONG = 10
// тиков (по секунде) без выделений — простой: всё свободное — системе
const GC_IDLE_TICKS = 10
// store брали на запись, а сборки не было две минуты — сборка (мкс)
const GC_FORCE_US = 120000000
// серий страниц за один возврат памяти системе
const GC_SCAV_RUNS = 256
// стек потока сборщика
const GC_STACK = 1048576
// madvise(MADV_DONTNEED): страницы — системе, при следующем касании — нули
const GC_SYS_MADVISE = 28
const GC_DONTNEED = 4
const GC_SYS_SCHED_YIELD = 24
// Разметка (§7.4): объект больше GC_FRAME_MIN байт смотрится кусками по
// GC_CHUNK байт — кадр; кадров не больше GC_FRAMES, остальные большие ждут в
// отложенных. Порог и кусок — 4 КБ (512 слов), а не 16 КБ (2048 слов), как в
// проекте: 2048 ссылок на холодные разбросанные объекты — 160–200 мкс, почти
// весь кусок разметки, и куски выходили за 0,3 мс. Арена —
// кусками по GC_ACHUNK байт, слова записей — по GC_PIN_BATCH. Часы — через
// каждые GC_CLOCK_WORK единиц работы: единица — маленький объект или 8 слов
// объекта больше; кусок кадра, кусок арены и пачка слов записей — не меньше
// GC_CLOCK_WORK, так что после каждого из них часы смотрятся сразу.
const GC_FRAME_MIN = 4096
const GC_CHUNK = 4096
const GC_FRAMES = 8
const GC_ACHUNK = 262144
const GC_PIN_BATCH = 1024
const GC_CLOCK_WORK = 256
// Конец разметки (§7.6): дорисовать дольше GC_TERM_US — отпустить мьютекс и
// продолжить кусками; с GC_TERM_TRIES-й попытки — до конца
const GC_TERM_US = 2000
const GC_TERM_TRIES = 4
// шаг KHRIP_GC_STRESS в khc test — столько единиц разметки; сборка начинается,
// когда выделено столько байт сверх помеченного (в khc test у кучи больше
// 32 КБ — четверть помеченного; с потоком сборщика — всегда столько)
const GC_STRESS_WORK = 256
const GC_STRESS_TEST_STEP = 8192

var __gc_phase: int
// идёт сборка или кусок разметки: повторно не входить
var __gc_busy: bool
// байт помеченных объектов: после последней сборки — живые данные
var __heap_marked: int
// Темп (§8.2): цель, порог, жёсткий предел. __gc_limit — порог сборки внутри
// работы (__gc_hard_check, последнее отпускание): жёсткий предел, а с
// KHRIP_GC_STRESS — помеченное + шаг.
var __gc_goal: int
var __gc_trigger: int
var __gc_hard: int
var __gc_limit: int
// поток сборщика уже разбужен в этом цикле
var __gc_poked: bool
// сборка под блокировкой контекста оставила возврат памяти потоку сборщика
var __gc_scav_due: bool
// __store_touches в начале последней сборки и её конец (мкс): простой и
// сборка раз в две минуты смотрят, брали ли store на запись с тех пор
var __gc_touches: int
var __gc_last_us: int
// поток сборщика запущен (__gc_spawn)
var __gc_has_thread: bool
// слово futex потока сборщика (кусок mmap): 1 — его будят
var __gc_ctl: int
// серии страниц возврата памяти для сборок под блокировкой (у потока
// сборщика — свои: он возвращает память без блокировки)
var __gc_runs: int
// граница занятых страниц в начале сборки, байт от STORE_REGION: объекты выше
// неё созданы во время разметки — чёрные
var __gc_hwb: int
// серый стек: пары (слот, размер слота), кусок mmap
var __gc_grey: int
var __gc_gn: int
var __gc_gcap: int
// массив записей: слова опубликованных записей, скопированные в начале (запись
// может смениться, пока идёт разметка); разобраны [0, __gc_pinpos)
var __gc_pins: int
var __gc_npins: int
var __gc_pinpos: int
var __gc_pincap: int
// захваченные арены: записи, чью арену просмотрит разметка (кусок mmap);
// [0, __gc_capdone) — уже DONE
var __gc_capl: int
var __gc_ncap: int
var __gc_capcap: int
var __gc_capdone: int
// кадры: GC_FRAMES × (объект, байт просмотрено, размер слота); отложенные —
// пары (объект, размер)
var __gc_fr: int
var __gc_nfr: int
var __gc_ovf: int
var __gc_novf: int
var __gc_ovfcap: int
// KHRIP_GC_VERIFY: слова арен, которые разметка нашла сама (их проверит конец
// разметки: арена контекста, который продолжил, уже другая)
var __gc_vw: int
var __gc_nvw: int
var __gc_vwcap: int
// помечено в этой сборке: байт и объектов; выделено во время разметки (чёрное)
var __gc_marked_bytes: int
var __gc_marked_objs: int
var __gc_black_bytes: int
var __gc_black_objs: int
// попыток конца разметки в этой сборке
var __gc_term_tries: int
// последняя сборка (журнал, __gc_stats): кто, куча до неё, записи и слова,
// арены, их байты и сколько передали сами контексты, долгие держатели, времена
// (мкс), возвращено системе, память страниц store после неё
var __gc_st_why: int
var __gc_st_before: int
var __gc_st_after: int
var __gc_st_recs: int
var __gc_st_words: int
var __gc_st_arenas: int
var __gc_st_abytes: int
var __gc_st_handoffs: int
var __gc_st_long: int
var __gc_st_long_age: int
var __gc_st_long_words: int
var __gc_st_start: int
var __gc_st_mark: int
var __gc_st_sweep: int
var __gc_st_release: int
var __gc_st_pause: int
// инкрементальная сборка: кусков, самый долгий, конец разметки (мкс), кто
// доделал её целиком (0 — она сама)
var __gc_st_inc: bool
var __gc_st_slices: int
var __gc_st_slice_max: int
var __gc_st_term: int
var __gc_st_fin: int
// конец начала и время от него до конца разметки (мкс)
var __gc_st_t1: int
var __gc_st_wall: int
// возврат памяти этой сборки отдан потоку сборщика
var __gc_st_relhanded: bool
var __gc_st_released: int
var __gc_st_rss: int
// за всё время: паузы сборок целиком (мкс), наибольшая, байт возвращено
// системе
var __gc_total_pause: int
var __gc_max_pause: int
var __gc_total_released: int

// Память сборщика — только куски mmap: если система откажет, продолжать нельзя
// (метаданные полуразмечены), и сообщение — без выделений.
fn __gc_scratch(n: int) -> int {
    let p = syscall(SYS_MMAP, 0, n, 3, 0x22, -1, 0)
    if p < 0 {
        __oom_exit("khrip: out of memory in the store collector\n")
    }
    return p
}

// Память сборщика растёт: кусок на need элементов по es байт и больше —
// вместимость вдвое, не меньше 256, — с копией первых n элементов старого
// куска (на cap элементов); старый — системе. Новая вместимость — в
// __gc_regrow_cap.
var __gc_regrow_cap: int

fn __gc_regrow(old: int, n: int, cap: int, es: int, need: int) -> int {
    var nc = cap * 2
    if nc < 256 {
        nc = 256
    }
    while nc < need {
        nc *= 2
    }
    let nb = __gc_scratch(nc * es)
    if n > 0 {
        __memcpy(nb, old, n * es)
    }
    if old != 0 {
        syscall(SYS_MUNMAP, old, cap * es)
    }
    __gc_regrow_cap = nc
    return nb
}

// Микросекунды монотонных часов (слова 192–207 контекста — временный буфер
// системного вызова, как у now_ms).
fn __gc_now_us() -> int {
    let ts = __ctx() + 192
    syscall(228, 1, ts)
    return load64(ts) * 1000000 + load64(ts + 8) / 1000
}

// Поток спит us микросекунд (тот же буфер контекста).
fn __gc_sleep_us(us: int) {
    let ts = __ctx() + 192
    store64(ts, us / 1000000)
    store64(ts + 8, (us % 1000000) * 1000)
    syscall(SYS_NANOSLEEP, ts, 0)
}

// Сборка целиком под исключительной блокировкой вызывающего (мьютекс
// писателей, читателей нет): идущая разметка сначала дорабатывается
// (__gc_finish_stw), затем — новая сборка от начала до уборки. self — запись
// собирающего контекста или 0 (поток сборщика): она опубликована (запрос
// посреди работы, тест после call) или контекст со store уже закончил
// (последнее отпускание, конец теста, I8). Затем возврат памяти
// (__gc_release_locked) и строка журнала.
fn __gc_collect_now(self: int, why: int) {
    __gc_busy = true
    while __gc_phase == GC_PH_MARK {
        __gc_finish_stw(why)
    }
    __gc_begin_cycle(self, why)
    __gc_st_inc = false
    __gc_complete()
    __gc_busy = false
    __gc_release_locked()
    __gc_report()
}

// Идущая разметка дорабатывается под исключительной блокировкой вызывающего с
// того, что есть (§8.4): захваченные арены, слова записей, серое, кадры; затем
// конец разметки и уборка. Строка журнала — о ней (by — кто доработал). Сам
// вызывающий публиковаться не обязан: всё, что он держал в начале сборки, — в
// её записи (иначе он не держал ничего), а всё, что достал потом, достижимо и
// помечено или чёрное.
fn __gc_finish_stw(by: int) {
    __gc_st_fin = by
    __gc_complete()
    __gc_report()
}

// Разметка до конца, её конец и уборка под исключительной блокировкой (сборка
// целиком и доделка идущей): времена — в журнал и паузы.
fn __gc_complete() {
    let t0 = __gc_now_us()
    __gc_mark(0, 0, true)
    __gc_mark_done()
    let t2 = __gc_after(t0)
    __gc_st_pause = t2 - t0
    if !__gc_st_inc {
        __gc_st_pause += __gc_st_start
    }
    __gc_total_pause += __gc_st_pause
    if __gc_st_pause > __gc_max_pause {
        __gc_max_pause = __gc_st_pause
    }
}

// После конца разметки (начатого в t0): уборка, темп, времена. → конец.
fn __gc_after(t0: int) -> int {
    let t1 = __gc_now_us()
    __gc_sweep_all()
    __gc_pace()
    let t2 = __gc_now_us()
    __gc_st_term = t1 - t0
    __gc_st_wall = t1 - __gc_st_t1
    __gc_st_sweep = t2 - t1
    __gc_st_after = __heap_live
    __gc_st_release = 0
    __gc_st_relhanded = false
    __gc_st_released = 0
    __gc_last_us = t2
    return t2
}

// Возврат памяти после сборки, которую контекст сделал под своей
// исключительной блокировкой (запрос, задача, тест). Есть поток сборщика —
// возврат ему: он вернёт память без блокировки, а не в паузе запроса. Нет
// (khc test) — здесь, и его время — часть паузы (журнал, __gc_stats).
fn __gc_release_locked() {
    if __gc_has_thread {
        __gc_scav_due = true
        __gc_st_relhanded = true
        store64(__gc_ctl, 1)
        syscall(SYS_FUTEX, __gc_ctl, FUTEX_WAKE_PRIVATE, 1, 0, 0, 0)
        return
    }
    let t0 = __gc_now_us()
    __gc_scavenge(false, true, __gc_runs)
    let dt = __gc_now_us() - t0
    __gc_st_release = dt
    __gc_st_pause += dt
    __gc_total_pause += dt
    if __gc_st_pause > __gc_max_pause {
        __gc_max_pause = __gc_st_pause
    }
}

// Начало инкрементальной сборки (поток сборщика, шаги тестов и
// KHRIP_GC_STRESS) — под исключительной блокировкой, со временем начала.
fn __gc_begin_cycle(self: int, why: int) {
    let t0 = __gc_now_us()
    __gc_st_why = why
    __gc_st_inc = true
    __gc_st_before = __heap_live
    __gc_start(self)
    let t1 = __gc_now_us()
    __gc_st_t1 = t1
    __gc_st_start = t1 - t0
}

// Начало (§7.2): номер сборки и номер кэшей строк (их ключи могли бы указать на
// память, которую освободит уборка, lib/text.kh), разметка включена, корни,
// записи. С KHRIP_GC_VERIFY сначала — каждый контекст, который брал store в
// своей работе и не держит его сейчас, опубликовал запись (кроме собирающего).
// Разметки здесь нет: корни только серятся, слова записей копируются.
fn __gc_start(self: int) {
    if __gc_verify {
        __gc_verify_records(self, false)
    }
    __gc_cycle_no += 1
    __store_epoch += 1
    __gc_touches = __store_touches
    __gc_set_marking(true)
    __gc_phase = GC_PH_MARK
    __gc_hwb = load64(__gc_ph + PH_HW) << GC_PAGE_SHIFT
    __gc_marked_bytes = 0
    __gc_marked_objs = 0
    __gc_black_bytes = 0
    __gc_black_objs = 0
    __gc_term_tries = 0
    __gc_npins = 0
    __gc_pinpos = 0
    __gc_nvw = 0
    __gc_st_slices = 0
    __gc_st_slice_max = 0
    __gc_st_mark = 0
    __gc_st_term = 0
    __gc_st_fin = 0
    __gc_st_handoffs = 0
    if __gc_fr == 0 {
        __gc_fr = __gc_scratch(GC_FRAMES * 24)
    }
    let roots = __gc_roots()
    let n = load64(roots)
    for i in 0..n {
        __gc_resolve(load64(load64(roots + 8 + i * 16)))
    }
    __gc_capture()
}

// Записи (§6.3): слова каждой опубликованной записи — в массив записей (их
// разберёт разметка; сама запись может смениться, как только контекст
// продолжит), арена — в список захваченных (PENDING): её просмотрит разметка, а
// если контекст продолжит раньше, — он сам при отзыве (__pin_withdraw).
fn __gc_capture() {
    __gc_ncap = 0
    __gc_capdone = 0
    __gc_st_recs = 0
    __gc_st_words = 0
    __gc_st_arenas = 0
    __gc_st_abytes = 0
    __gc_st_long = 0
    __gc_st_long_age = 0
    __gc_st_long_words = 0
    let nt = load64(__gc_reg + 8)
    for i in 0..nt {
        let c = load64(__gc_reg + 16 + i * 8)
        var r = 0
        if c != 0 {
            r = load64(c + CTX_PINLIST)
        }
        while r != 0 {
            let rec: __Pin = __cast(r)
            __gc_pins_add(rec.buf, rec.len)
            __gc_st_recs += 1
            __gc_st_words += rec.len
            if rec.hi > rec.lo {
                rec.aoff = 0
                rec.ast = (__gc_cycle_no << 3) | PIN_PENDING
                __gc_cap_push(r)
                __gc_st_arenas += 1
                __gc_st_abytes += rec.hi - rec.lo
            }
            let age = __gc_cycle_no - rec.pub_cycle
            if age >= GC_LONG {
                __gc_st_long += 1
                __gc_st_long_words += rec.len
                if age > __gc_st_long_age {
                    __gc_st_long_age = age
                }
            }
            r = rec.next
        }
    }
}

// n слов с адреса p — в массив записей (растёт вдвое).
fn __gc_pins_add(p: int, n: int) {
    if n <= 0 {
        return
    }
    if __gc_npins + n > __gc_pincap {
        __gc_pins = __gc_regrow(__gc_pins, __gc_npins, __gc_pincap, 8, __gc_npins + n)
        __gc_pincap = __gc_regrow_cap
    }
    __memcpy(__gc_pins + __gc_npins * 8, p, n * 8)
    __gc_npins += n
}

fn __gc_cap_push(r: int) {
    if __gc_ncap == __gc_capcap {
        __gc_capl = __gc_regrow(__gc_capl, __gc_ncap, __gc_capcap, 8, 0)
        __gc_capcap = __gc_regrow_cap
    }
    store64(__gc_capl + __gc_ncap * 8, r)
    __gc_ncap += 1
}

// Слово w — возможная ссылка (§7.3): точная (поле, элемент) или нет (слово
// записи), на начало объекта или внутрь (срез строки, вариант — начало + 8).
// Объект, внутри которого оно лежит, помечается, а если в нём есть ссылки, —
// в серый стек. Вне занятых в начале сборки страниц STORE, в хвосте спана и в
// свободном слоте слово ничего не значит; объект, выделенный во время
// разметки, уже помечен.
fn __gc_resolve(w: int) {
    let off = w - STORE_REGION
    if off < 0 || off >= __gc_hwb {
        return
    }
    let sb = load32(GC_PAGEMAP + ((off >> GC_PAGE_SHIFT) << 2))
    if sb == 0 {
        return
    }
    let s = GC_SPANS + ((sb - 1) << 6)
    let fl = load64(s + S_INFO) >> 48
    if (fl & F_INUSE) == 0 {
        return
    }
    let base = load64(s + S_BASE)
    let es = load64(s + S_SIZE)
    var slot = base
    if (fl & F_LARGE) == 0 {
        let mg = load64(s + S_MAGIC)
        let i = ((w - base) * (mg & 0xFFFFFFFF)) >> 32
        if i >= mg >> 32 {
            return
        }
        slot = base + i * es
    }
    let a = ((slot >> 10) << 3) + GC_START_P
    let b = 1 << ((slot >> 4) & 63)
    if (load64(a) & b) == 0 {
        return
    }
    let am = a + (GC_MARK - GC_START)
    let m = load64(am)
    if (m & b) != 0 {
        return
    }
    store64(am, m | b)
    __gc_marked_bytes += es
    __gc_marked_objs += 1
    if (fl & F_NOSCAN) == 0 {
        if __gc_gn == __gc_gcap {
            __gc_grey_grow()
        }
        let e = __gc_grey + (__gc_gn << 4)
        store64(e, slot)
        store64(e + 8, es)
        __gc_gn += 1
    }
}

fn __gc_grey_grow() {
    __gc_grey = __gc_regrow(__gc_grey, __gc_gn, __gc_gcap, 16, 4096)
    __gc_gcap = __gc_regrow_cap
}

// Слова [p, p + n) объекта с битом PTRB — ссылки (у остальных слов бита нет):
// их цели помечаются.
fn __gc_scan(p: int, n: int) {
    var b = (p - STORE_REGION) >> 3
    let e = b + (n >> 3)
    while b < e {
        let wi = b >> 6
        var hi = e - (wi << 6)
        if hi > 64 {
            hi = 64
        }
        var m = load64(GC_PTRB + (wi << 3)) & __bits_mask(b & 63, hi)
        let at = STORE_REGION + (wi << 9)
        while m != 0 {
            __gc_resolve(load64(at + (__ctz(m) << 3)))
            m = m & (m - 1)
        }
        b = (wi << 6) + hi
    }
}

// Одна единица работы разметки в порядке §7.4: захваченные арены, слова
// записей, серый стек, верхний кадр, отложенные. → сколько работы сделано
// (единица — примерно объект) или −1: работы нет, кроме арен, которые смотрят
// сами их контексты (SELF).
fn __gc_mark_unit() -> int {
    if __gc_capdone < __gc_ncap {
        let w = __gc_cap_unit()
        if w > 0 {
            return w
        }
    }
    if __gc_pinpos < __gc_npins {
        let a = __gc_pinpos
        var e = a + GC_PIN_BATCH
        if e > __gc_npins {
            e = __gc_npins
        }
        var j = a
        while j < e {
            __gc_resolve(load64(__gc_pins + j * 8))
            j += 1
        }
        __gc_pinpos = e
        return 1 + ((e - a) >> 2)
    }
    if __gc_gn > 0 {
        __gc_gn -= 1
        let g = __gc_grey + (__gc_gn << 4)
        let o = load64(g)
        let es = load64(g + 8)
        if es > GC_FRAME_MIN {
            __gc_frame_push(o, es)
            return 1
        }
        __gc_scan(o, es)
        return 1 + (es >> 6)
    }
    if __gc_nfr > 0 {
        return __gc_frame_unit()
    }
    if __gc_novf > 0 {
        __gc_novf -= 1
        let g = __gc_ovf + (__gc_novf << 4)
        __gc_frame_push(load64(g), load64(g + 8))
        return 1
    }
    return -1
}

// Одна захваченная арена (§6.3), первая, с которой есть что делать: PENDING —
// кусок до GC_ACHUNK байт (на это время — GC: контекст, который продолжит,
// подождёт его); HANDED — слова, которые нашёл сам контекст. Законченная
// (DONE) уходит в начало списка. SELF пропускается: арену смотрит контекст.
// → работа или 0, если делать нечего.
fn __gc_cap_unit() -> int {
    var i = __gc_capdone
    while i < __gc_ncap {
        let r = load64(__gc_capl + i * 8)
        let rec: __Pin = __cast(r)
        let s = rec.ast
        let st = s & 7
        if st == PIN_PENDING {
            // CAS не удался — контекст только что взял арену себе (SELF):
            // смотреть ту же запись снова
            if __cas(r, s, (s & ~7) | PIN_GC) {
                let from = __pin_arena_from(rec)
                var to = from + GC_ACHUNK
                if to > rec.hi {
                    to = rec.hi
                }
                __gc_resolve_range(from, to)
                rec.aoff = to - rec.lo
                if to < rec.hi {
                    rec.ast = s
                    return 1 + ((to - from) >> 9)
                }
                return __gc_cap_done(r, i, 1 + ((to - from) >> 9))
            }
        } else if st == PIN_HANDED {
            let n = rec.hlen
            var j = 0
            while j < n {
                __gc_resolve(load64(rec.hbuf + j * 8))
                j += 1
            }
            // признак передачи в этой сборке: проверка конца разметки возьмёт
            // слова арены из hbuf (новая сборка снова обнулит aoff)
            rec.aoff = -1
            __gc_st_handoffs += 1
            return __gc_cap_done(r, i, 1 + (n >> 2))
        } else {
            i += 1
        }
    }
    return 0
}

// Захваченная запись r (номер i в списке) закончена: DONE и в начало списка,
// к законченным. → work.
fn __gc_cap_done(r: int, i: int, work: int) -> int {
    let rec: __Pin = __cast(r)
    rec.ast = (rec.ast & ~7) | PIN_DONE
    let a = __gc_capl + i * 8
    let b = __gc_capl + __gc_capdone * 8
    store64(a, load64(b))
    store64(b, r)
    __gc_capdone += 1
    return work
}

// Начало непросмотренной части арены записи. Кэш строк в начале арены
// (STRC_SIZE байт, lib/text.kh) — ключи для сравнения, а не ссылки: их не
// смотрят ни разметка, ни хеш W1 (__pin_hash).
fn __pin_arena_from(rec: __Pin) -> int {
    var p = rec.lo + rec.aoff
    if rec.hi - rec.lo >= STRC_SIZE && p < rec.lo + STRC_SIZE {
        p = rec.lo + STRC_SIZE
    }
    return p
}

// Слова [from, to) со значением в STORE — возможные ссылки.
fn __gc_resolve_range(from: int, to: int) {
    var p = from
    while p < to {
        let w = load64(p)
        if (w >> 38) == 0x40 {
            __gc_resolve(w)
            if __gc_verify {
                __gc_vnote(w)
            }
        }
        p += 8
    }
}

// Кадры (§7.4): объект больше GC_FRAME_MIN байт смотрится кусками по GC_CHUNK
// байт, после того как разобраны дети предыдущего куска (серое — раньше
// кадров), поэтому серый стек не растёт на элемент длинного списка. Кадр —
// (объект, байт просмотрено, размер слота); их стек не глубже GC_FRAMES
// (смотрится верхний), остальные большие ждут в отложенных и становятся
// кадром, когда кадр уходит. Пока объект — кадр, перестановки внутри него
// соблюдают правило частичного массива (__gc_moved, __gc_permute).
fn __gc_frame_push(o: int, es: int) {
    if __gc_nfr == GC_FRAMES {
        if __gc_novf == __gc_ovfcap {
            __gc_ovf = __gc_regrow(__gc_ovf, __gc_novf, __gc_ovfcap, 16, 0)
            __gc_ovfcap = __gc_regrow_cap
        }
        let g = __gc_ovf + (__gc_novf << 4)
        store64(g, o)
        store64(g + 8, es)
        __gc_novf += 1
        return
    }
    let f = __gc_fr + __gc_nfr * 24
    store64(f, o)
    store64(f + 8, 0)
    store64(f + 16, es)
    __gc_nfr += 1
}

// Следующий кусок верхнего кадра; кадр кончился — уходит, а его место
// занимает отложенный.
fn __gc_frame_unit() -> int {
    let f = __gc_fr + (__gc_nfr - 1) * 24
    let o = load64(f)
    let pos = load64(f + 8)
    let es = load64(f + 16)
    var n = es - pos
    if n > GC_CHUNK {
        n = GC_CHUNK
    }
    if n > 0 {
        __gc_scan(o + pos, n)
        store64(f + 8, pos + n)
    }
    if pos + n >= es {
        __gc_nfr -= 1
        if __gc_novf > 0 {
            __gc_novf -= 1
            let g = __gc_ovf + (__gc_novf << 4)
            __gc_frame_push(load64(g), load64(g + 8))
        }
    }
    return 1 + (n >> 4)
}

// Разметка (§7.4): единицы работы по порядку, пока она не кончится, — не
// дольше us мкс (часы — через каждые GC_CLOCK_WORK единиц), если us > 0, и не
// больше work единиц, если work > 0. Кусок (spin = false) кончается, когда
// осталось разве что арены, которые смотрят их контексты (SELF); конец
// разметки и сборка целиком (spin) их дожидаются — контекст смотрит свою арену
// и от сборщика ничего не ждёт (§6.3). → true, если разметка кончилась; false
// — время или работа вышли.
fn __gc_mark(us: int, work: int, spin: bool) -> bool {
    var t0 = 0
    if us > 0 {
        t0 = __gc_now_us()
    }
    var done = 0
    var since = 0
    var spins = 0
    while true {
        var w = __gc_mark_unit()
        if w < 0 {
            if !spin || __gc_capdone >= __gc_ncap {
                return true
            }
            __gc_spin(spins)
            spins += 1
            w = 1
        }
        done += w
        since += w
        if work > 0 && done >= work {
            return false
        }
        if us > 0 && since >= GC_CLOCK_WORK {
            since = 0
            if __gc_now_us() - t0 >= us {
                return false
            }
        }
    }
    return true
}

// Ожидание другого потока (арена, которую смотрит её контекст или сборщик):
// пауза процессора, иногда — уступить ядро.
fn __gc_spin(n: int) {
    if (n & 1023) == 1023 {
        syscall(GC_SYS_SCHED_YIELD)
    } else {
        __cpu_pause()
    }
}

// Конец разметки (§7.6) под мьютексом писателей, сразу за куском, который её
// закончил: доделать захваченные арены (SELF — дождаться) и серое не дольше
// GC_TERM_US. Не успели — false: мьютекс отпускается, разметка идёт кусками
// дальше; с GC_TERM_TRIES-й попытки — до конца.
fn __gc_terminate_try() -> bool {
    __gc_term_tries += 1
    var us = GC_TERM_US
    if __gc_term_tries >= GC_TERM_TRIES {
        us = 0
    }
    if !__gc_mark(us, 0, true) {
        return false
    }
    __gc_mark_done()
    return true
}

// Разметка кончилась (§7.6): серого, кадров и слов записей нет, каждая
// захваченная арена просмотрена (DONE). С KHRIP_GC_VERIFY — независимая
// проверка разметки до уборки (§8.7). Захваченные записи снова IDLE (I9);
// разметка выключена; живое — помеченное разметкой и выделенное за время
// разметки (чёрное); номер уборки растёт, и каждый спан становится неубранным;
// текущих спанов и частично занятых больше нет (I10): выделение возьмёт только
// убранные спаны.
fn __gc_mark_done() {
    var i = 0
    while i < __gc_ncap {
        let rec: __Pin = __cast(load64(__gc_capl + i * 8))
        if (rec.ast & 7) != PIN_DONE {
            __gc_fatal("a captured arena was not marked by the end of marking (I9)")
        }
        rec.ast = PIN_IDLE
        i += 1
    }
    // проверка смотрит слова записей, арен и hbuf переданных (aoff < 0), не ast
    if __gc_verify {
        __gc_verify_marks()
    }
    __gc_ncap = 0
    __gc_capdone = 0
    __gc_npins = 0
    __gc_pinpos = 0
    __gc_nvw = 0
    __gc_set_marking(false)
    __gc_phase = GC_PH_SWEEP
    __heap_marked = __gc_marked_bytes + __gc_black_bytes
    __heap_live = __heap_marked
    __gc_sweepgen += 1
    for j in 0..(GC_CLASSES + 1) * 2 {
        store64(__gc_cur + j * 8, __gc_none)
        store64(__gc_partial + j * 16, 0)
        store64(__gc_partial + j * 16 + 8, 0)
    }
    __gc_poked = false
}

// Уборка всех спанов по адресам (§7.7): спан без объектов — страницы кучке,
// спан со свободными слотами — в конец списка частично занятых своего класса.
// Память разметки больше 1 МБ — системе.
fn __gc_sweep_all() {
    var kept = 0
    let hw = load64(__gc_ph + PH_HW)
    var pg = 0
    while pg < hw {
        if load32(GC_PAGEMAP + (pg << 2)) != pg + 1 {
            pg += 1
            continue
        }
        let s = GC_SPANS + (pg << 6)
        let np = load64(s + S_INFO) & 0xFFFFFFFF
        if load64(s + S_SWEEPGEN) != __gc_sweepgen {
            kept += __gc_sweep_span(s)
        }
        pg += np
    }
    __gc_phase = GC_PH_IDLE
    if __gc_gcap * 16 > GC_MB {
        syscall(SYS_MUNMAP, __gc_grey, __gc_gcap * 16)
        __gc_grey = 0
        __gc_gcap = 0
    }
    if __gc_pincap * 8 > GC_MB {
        syscall(SYS_MUNMAP, __gc_pins, __gc_pincap * 8)
        __gc_pins = 0
        __gc_pincap = 0
    }
    if __gc_verify {
        __gc_verify_swept(kept)
    }
}

// Уборка спана s → байт в оставшихся объектах. Освобождённый слот (START без
// MARK) теряет START и биты PTRB (у свободной памяти их нет, §4.2), с
// KHRIP_GC_VERIFY — заполняется 0xDE (выделение проверит, что в него не
// писали); MARK снимается у всех.
fn __gc_sweep_span(s: int) -> int {
    let info = load64(s + S_INFO)
    let np = info & 0xFFFFFFFF
    let fl = info >> 48
    let base = load64(s + S_BASE)
    let es = load64(s + S_SIZE)
    store64(s + S_SWEEPGEN, __gc_sweepgen)
    if (fl & F_LARGE) != 0 {
        let am = ((base >> 10) << 3) + GC_START_P + (GC_MARK - GC_START)
        let b = 1 << ((base >> 4) & 63)
        if (load64(am) & b) != 0 {
            store64(am, load64(am) & ~b)
            return es
        }
        if __gc_verify {
            __memset(base, 0xDE, es)
        }
        __span_free(s)
        return 0
    }
    let noscan = (fl & F_NOSCAN) != 0
    let w0 = (base - STORE_REGION) >> 10
    let sa = GC_START + (w0 << 3)
    let ma = GC_MARK + (w0 << 3)
    let nw = np << 3
    // сначала — сколько объектов останется: спан без них уходит целиком
    // (__span_free снимает все его биты), и по слотам идти не нужно
    var alloc = 0
    for j in 0..nw {
        let sw = load64(sa + j * 8)
        if sw != 0 {
            alloc += __popcount(sw & load64(ma + j * 8))
        }
    }
    if alloc == 0 {
        if __gc_verify {
            for j in 0..nw {
                var sw = load64(sa + j * 8)
                while sw != 0 {
                    __memset(STORE_REGION + ((w0 + j) << 10) + (__ctz(sw) << 4), 0xDE, es)
                    sw = sw & (sw - 1)
                }
            }
        }
        __span_free(s)
        return 0
    }
    for j in 0..nw {
        var sw = load64(sa + j * 8)
        let mw = load64(ma + j * 8)
        var freed = sw & ~mw
        if freed != 0 {
            sw = sw & mw
            store64(sa + j * 8, sw)
            let at = STORE_REGION + ((w0 + j) << 10)
            while freed != 0 {
                let p = at + (__ctz(freed) << 4)
                if __gc_verify {
                    __memset(p, 0xDE, es)
                }
                if !noscan {
                    __gc_ptrb_clear(p, es)
                }
                freed = freed & (freed - 1)
            }
        }
        if mw != 0 {
            store64(ma + j * 8, 0)
        }
    }
    let nfree = (load64(s + S_MAGIC) >> 32) - alloc
    store64(s + S_NEXT, nfree << 32)
    if nfree > 0 {
        __span_rewind(s)
        let h = __gc_partial + ((info >> 32) & 0xFFFF) * 16
        let pg1 = ((base - STORE_REGION) >> GC_PAGE_SHIFT) + 1
        if load64(h) == 0 {
            store64(h, pg1)
        } else {
            let t = GC_SPANS + ((load64(h + 8) - 1) << 6)
            store64(t + S_NEXT, (load64(t + S_NEXT) & ~0xFFFFFFFF) | pg1)
        }
        store64(h + 8, pg1)
    }
    return alloc * es
}

// Биты PTRB слота p из es байт — нули (свободная память, §4.2). Слот до 64
// слов задевает одно или два слова карты.
fn __gc_ptrb_clear(p: int, es: int) {
    let k = es >> 3
    if k > 64 {
        let pb = (p - STORE_REGION) >> 3
        __bits_put(GC_PTRB, pb, pb + k, false)
        return
    }
    var m = -1
    if k < 64 {
        m = (1 << k) - 1
    }
    let pa = ((p >> 9) << 3) + GC_PTRB_P
    let sh = (p >> 3) & 63
    store64(pa, load64(pa) & ~(m << sh))
    if sh != 0 && sh + k > 64 {
        store64(pa + 8, load64(pa + 8) & ~((m >> (64 - sh)) & ((1 << sh) - 1)))
    }
}

// Число единиц в слове (SWAR).
fn __popcount(x: int) -> int {
    var v = x - ((x >> 1) & 0x5555555555555555)
    v = (v & 0x3333333333333333) + ((v >> 2) & 0x3333333333333333)
    v = (v + (v >> 4)) & 0x0F0F0F0F0F0F0F0F
    return ((v * 0x0101010101010101) >> 56) & 0xFF
}

// ---- Барьер SATB и правило частичного массива (§7.5) ----
// Пока идёт разметка, значение, которое затирают или убирают из объекта store
// или из корня, сначала серится: разметка найдёт всё, что было достижимо в
// начале сборки. Меняет store только тот, кто держит его исключительно
// (__store_mut), — значит, и мьютекс писателей: метаданные сборщика меняет
// только его владелец (I5). Списки и словари вне store (временные значения,
// читающие запросы) не серят ничего.
//
// Хуки lib/core.kh и lib/api.kh вызываются всегда; каждый — короткая функция,
// которую компилятор встраивает: без разметки — одна загрузка и переход,
// работа — в функциях *_now. В программах без store хуки — пустые заглушки
// (lib/nostore.kh, bootstrap/shim.kh): ни кода, ни вызова.

// x.f = v (__barrier_at): старое значение поля объекта store.
fn __gc_field(obj: int, off: int) {
    if __in_store(obj) {
        __store_mut(obj)
        if __gc_marking != 0 {
            __gc_resolve(load64(obj + off))
        }
    }
}

// xs[i] = v (__barrier_idx): старый элемент списка store, если i в границах
// (за границей присваивание и так паника).
fn __gc_elem(xs: int, i: int) {
    if __in_store(xs) {
        __store_mut(xs)
        if __gc_marking != 0 && i >= 0 && i < load64(xs + 8) {
            __gc_resolve(load64(load64(xs) + i * 8))
        }
    }
}

// Корень slot получает новое значение (__persist_root).
fn __gc_root(slot: int) {
    if __gc_marking != 0 {
        __gc_shade_root(slot)
    }
}

// Слово w уходит из контейнера store (pop, ключ и значение словаря; вызывающий
// проверил, что контейнер в store).
fn __gc_shade(w: int) {
    if __gc_marking != 0 {
        __gc_resolve(w)
    }
}

// Рост списка h: заголовок больше не ссылается на старый массив (новый —
// чёрный, разметка его не смотрит).
fn __gc_old_array(h: int) {
    if __gc_marking != 0 {
        __gc_shade_in(h, load64(h))
    }
}

// Новая таблица слотов словаря m (перестройка, clear).
fn __gc_old_slots(m: int) {
    if __gc_marking != 0 {
        __gc_shade_in(m, load64(m + 32))
    }
}

// Значение по адресу a словаря m затирается (__map_set).
fn __gc_old_at(m: int, a: int) {
    if __gc_marking != 0 {
        __gc_shade_in(m, load64(a))
    }
}

// Элементы [from, len) списка store h уходят (truncate, clear).
fn __gc_vacate(h: int, from: int) {
    if __gc_marking != 0 && load64(h + 24) == 8 {
        __gc_shade_words(h, load64(h) + from * 8, load64(h + 8) - from)
    }
}

// remove_at(i) списка h из n элементов: ушедший элемент v и правило
// частичного массива.
fn __gc_remove_at(h: int, v: int, i: int, n: int) {
    if __gc_marking != 0 {
        __gc_remove_at_now(h, v, i, n)
    }
}

// Перестановка элементов списка h (reverse, sort, sort_by; массивы ключей и
// значений словаря при сжатии).
fn __gc_permute(h: int) {
    if __gc_marking != 0 {
        __gc_permute_now(h, load64(h), load64(h + 8))
    }
}

// Запись idx словаря store m удалена: ключ-строка и значение v уходят.
fn __gc_map_removed(m: int, idx: int, v: int) {
    if __gc_marking != 0 {
        __gc_map_removed_now(m, idx, v)
    }
}

// Словарь store m очищен: n записей уходят.
fn __gc_map_cleared(m: int, n: int) {
    if __gc_marking != 0 {
        __gc_map_cleared_now(m, n)
    }
}

// Значение w уходит из контейнера h, если тот в store.
fn __gc_shade_in(h: int, w: int) {
    if __in_store(h) {
        __gc_resolve(w)
    }
}

// n слов с адреса p уходят из контейнера h; у массива без ссылок (NOSCAN)
// серить нечего.
fn __gc_shade_words(h: int, p: int, n: int) {
    if !__in_store(h) || n <= 0 || __gc_kind_of(p) == K_NOSCAN {
        return
    }
    var i = 0
    while i < n {
        __gc_resolve(load64(p + i * 8))
        i += 1
    }
}

fn __gc_remove_at_now(h: int, v: int, i: int, n: int) {
    __gc_shade_in(h, v)
    __gc_moved(h, load64(h), i, n)
}

fn __gc_map_removed_now(m: int, idx: int, v: int) {
    if load64(m + 48) != 0 {
        __gc_resolve(__word_at(load64(m), idx))
    }
    __gc_resolve(v)
}

fn __gc_map_cleared_now(m: int, n: int) {
    if load64(m + 48) != 0 {
        __gc_shade_words(m, load64(load64(m)), n)
    }
    __gc_shade_words(m, load64(load64(m + 16)), n)
}

// Корень slot (глобальная store, var теста): старое значение серится. Менять
// корень может только тот, кто держит store исключительно.
fn __gc_shade_root(slot: int) {
    if load64(__ctx() + CTX_STORE_HELD) != 1 {
        __store_mut_slow()
    }
    __gc_resolve(load64(slot))
}

// Кадр, внутри которого лежит адрес p, или 0.
fn __gc_frame_at(p: int) -> int {
    var k = 0
    while k < __gc_nfr {
        let f = __gc_fr + k * 24
        let o = load64(f)
        if p >= o && p < o + load64(f + 16) {
            return f
        }
        k += 1
    }
    return 0
}

// remove_at(i) списка h с массивом d из n элементов (до сдвига): элементы
// (i, n) сдвигаются на слово вниз. Если массив — кадр и граница просмотренного
// между ними, элемент на границе перешёл бы в просмотренную часть
// непросмотренным — он серится (такой один; остальные остаются по свою
// сторону границы).
fn __gc_moved(h: int, d: int, i: int, n: int) {
    if __gc_nfr == 0 || !__in_store(h) {
        return
    }
    let f = __gc_frame_at(d)
    if f == 0 {
        return
    }
    let bound = load64(f) + load64(f + 8)
    if bound > d + i * 8 && bound < d + n * 8 {
        __gc_resolve(load64(bound))
    }
}

// Перестановка элементов [0, n) массива d контейнера h (reverse, sort,
// sort_by, сжатие при перестройке словаря): если массив — кадр, его
// непросмотренная часть серится целиком, и кадр закончен (O(n), как и сама
// перестановка).
fn __gc_permute_now(h: int, d: int, n: int) {
    if __gc_nfr == 0 || !__in_store(h) {
        return
    }
    let f = __gc_frame_at(d)
    if f == 0 {
        return
    }
    var p = load64(f) + load64(f + 8)
    if p < d {
        p = d
    }
    let e = d + n * 8
    while p < e {
        __gc_resolve(load64(p))
        p += 8
    }
    store64(f + 8, load64(f + 16))
}

// ---- Шаги сборки для тестов (tests/api/gc_*.kh) ----
// Тест начинает сборку, делает разметку по шагам, меняет store между ними и
// заканчивает её — так проверяется каждая строка таблицы SATB (§7.5). Тест
// держит store исключительно или не держит (тогда блокировка сборщика — на
// время шага).

// Начать сборку: контекст публикует себя на время начала (его указатели — в
// массиве записей; арену, когда продолжит, он передаст сам, __pin_withdraw).
// Идущая разметка сначала доделывается.
fn __gc_begin() {
    let c = __ctx()
    let held = load64(c + CTX_STORE_HELD)
    if !__gc_ready || held == 2 || __gc_busy {
        return
    }
    if held == 0 {
        __store_lock_gc()
    }
    __gc_busy = true
    if __gc_phase == GC_PH_MARK {
        __gc_finish_stw(GC_WHY_CALL)
    }
    let r = load64(c + CTX_PINREC)
    __pin_publish(r)
    __gc_begin_cycle(r, GC_WHY_CALL)
    if r != 0 {
        __pin_withdraw(__cast(r))
    }
    __gc_busy = false
    if held == 0 {
        __store_unlock_gc()
    }
}

// Начать сборку, как поток сборщика: ни стек, ни арена вызывающего в начало не
// попадают. Только для тестов барьера, которые не пользуются ни одним
// указателем в store, полученным до вызова (всё достают заново от корней):
// иначе случайное старое слово на стеке пометило бы объект, который тест
// прячет, и пропущенный барьер остался бы незамеченным.
fn __gc_begin_from_roots() {
    let c = __ctx()
    let held = load64(c + CTX_STORE_HELD)
    if !__gc_ready || held == 2 || __gc_busy {
        return
    }
    if held == 0 {
        __store_lock_gc()
    }
    __gc_busy = true
    if __gc_phase == GC_PH_MARK {
        __gc_finish_stw(GC_WHY_CALL)
    }
    __gc_begin_cycle(load64(c + CTX_PINREC), GC_WHY_CALL)
    __gc_busy = false
    if held == 0 {
        __store_unlock_gc()
    }
}

// n единиц разметки. → true, если разметка кончилась (или её нет).
fn __gc_step(n: int) -> bool {
    let held = load64(__ctx() + CTX_STORE_HELD)
    if __gc_phase != GC_PH_MARK || held == 2 {
        return __gc_phase != GC_PH_MARK
    }
    if held == 0 {
        __store_lock_gc()
    }
    let fin = __gc_mark(0, n, false)
    if held == 0 {
        __store_unlock_gc()
    }
    return fin
}

// Доделать разметку, конец разметки и уборка.
fn __gc_finish() {
    let held = load64(__ctx() + CTX_STORE_HELD)
    if __gc_phase != GC_PH_MARK || held == 2 || __gc_busy {
        return
    }
    if held == 0 {
        __store_lock_gc()
    }
    __gc_busy = true
    __gc_finish_stw(GC_WHY_CALL)
    __gc_busy = false
    if held == 0 {
        __store_unlock_gc()
    }
}

// Контекст передал арену сам в идущей (или только что законченной) сборке:
// продолжил посреди разметки, начатой, пока он ждал, раньше, чем сборщик
// досмотрел его арену (tests/gc.sh: держатели по видам окон). Оценка: конец
// разметки возвращает записи в IDLE, и тогда — false.
fn __gc_handed_off() -> bool {
    let r = load64(__ctx() + CTX_PINREC)
    if r == 0 {
        return false
    }
    let rec: __Pin = __cast(r)
    let s = rec.ast
    let st = s & 7
    return (s >> 3) == __gc_cycle_no && (st == PIN_HANDED || st == PIN_SELF || (st == PIN_DONE && rec.aoff < 0))
}

// Сколько больших объектов ждут в отложенных (кадров уже GC_FRAMES).
fn __gc_overflow() -> int {
    return __gc_novf
}

// Сколько байт массива, где лежит p, просмотрено (p — кадр), или −1.
fn __gc_frame_pos(p: int) -> int {
    let f = __gc_frame_at(p)
    if f == 0 {
        return -1
    }
    return load64(f + 8)
}

// Помечен ли объект, в котором лежит p (0 — не объект store).
fn __gc_is_marked(p: int) -> bool {
    let o = __gc_obj_of(p)
    return o != 0 && __gc_bit(GC_MARK, o)
}

// Выделен ли объект, в котором лежит p.
fn __gc_is_allocated(p: int) -> bool {
    return __gc_obj_of(p) != 0
}

// ---- Темп и пределы (§8.2, §8.4; m = 1 до шага 6b) ----

// По помеченному после сборки: цель — помеченное · (1 + KHRIP_GC/100), не
// меньше KHRIP_GC_MIN_MB; порог — 70% запаса; жёсткий предел — вдвое выше цели,
// но не меньше цели + 64 МБ. KHRIP_GC=off — сборки нет. KHRIP_GC_STRESS — цель
// — помеченное + шаг (64 КБ, а у кучи больше 256 КБ — четверть помеченного);
// с потоком сборщика следующая сборка начинается, как только выделено 8 КБ
// после уборки (под нагрузкой разметка идёт почти всё время, и почти каждый
// запрос встречает её; в простое сборку по-прежнему делает простой), а порог
// сборки внутри работы — помеченное + max(512 КБ, четверть помеченного):
// разметку обычно доделывает поток, кусками, а запрос, который выделил
// больше, собирает сам и сбрасывает чёрный мусор долгой разметки; без
// него (khc test) — четверть помеченного, но не меньше 8 КБ: с него начинаются
// шаги сборки (__gc_stress_step), и маленький store тестов размечается, пока
// тест его меняет.
fn __gc_pace() {
    let m = __heap_marked
    if __gc_pct < 0 {
        __gc_goal = GC_MAX
        __gc_trigger = GC_MAX
        __gc_hard = GC_MAX
        __gc_limit = GC_MAX
        return
    }
    var goal = m + (m / 100) * __gc_pct + (m % 100) * __gc_pct / 100
    if goal < __gc_min {
        goal = __gc_min
    }
    // KHRIP_GC_STRESS: шаг — 64 КБ, а у большой кучи — четверть помеченного,
    // иначе работа сборок росла бы как квадрат кучи
    var step = m / 4
    if step < GC_STRESS_STEP {
        step = GC_STRESS_STEP
    }
    if __gc_stress {
        goal = m + step
    }
    __gc_goal = goal
    __gc_trigger = m + (goal - m) / 10 * 7
    var hard = goal * 2
    if hard < goal + 64 * GC_MB {
        hard = goal + 64 * GC_MB
    }
    __gc_hard = hard
    __gc_limit = hard
    if __gc_stress {
        var least = GC_STRESS_TEST_STEP
        if __gc_has_thread {
            __gc_trigger = m + GC_STRESS_TEST_STEP
            least = 8 * GC_STRESS_STEP
        }
        var over = m / 4
        if over < least {
            over = least
        }
        __gc_limit = m + over
    }
}

// Разбудить поток сборщика (из __salloc_slow: куча дошла до порога) — раз за
// цикл. Без потока (khc test) сборку запустит точка сборки теста.
fn __gc_poke() {
    __gc_poked = true
    if __gc_has_thread {
        store64(__gc_ctl, 1)
        syscall(SYS_FUTEX, __gc_ctl, FUTEX_WAKE_PRIVATE, 1, 0, 0, 0)
    }
}

// Жёсткий предел (§8.4) — перед копированием в store (__persist_copy) и ростом
// контейнера store (__salloc_for), до __pmode_on. Запрос или задача держит
// store исключительно посреди работы, и поток сборщика его не дождётся:
// контекст публикует себя (I7: всё, что живо через вызов, — в rbx, rbp, r12–r15
// или в памяти), собирает и отзывает запись. С KHRIP_GC_STRESS без потока
// сборщика (khc test) — шаг сборки (__gc_stress_step): начало у порога, а
// пока идёт разметка — в каждой точке.
fn __gc_hard_check() {
    if __heap_live < __gc_limit {
        if !__gc_stress || __gc_has_thread || __gc_phase != GC_PH_MARK {
            return
        }
    }
    if load64(__ctx() + CTX_STORE_HELD) != 1 || __gc_busy || __store_on() {
        return
    }
    if __gc_stress && !__gc_has_thread && __gc_stress_step(load64(__ctx() + CTX_PINREC)) {
        return
    }
    __gc_emergency(GC_WHY_EMERGENCY)
}

// Сборка посреди работы под исключительной блокировкой: запись опубликована
// на время сборки (единственный случай, когда она опубликована при взятой
// блокировке), затем отозвана.
fn __gc_emergency(why: int) {
    let r = load64(__ctx() + CTX_PINREC)
    if r == 0 {
        return
    }
    __pin_publish(r)
    __gc_collect_now(r, why)
    __pin_withdraw(__cast(r))
}

// Точка сборки khc test (§6.8): потока сборщика в тестах нет. После call
// (end = false) тест держит указатели в store и публикует себя; в конце теста
// (end) со store он закончил. Собирает, если куча дошла до порога, а с
// KHRIP_GC_STRESS — всегда.
fn __gc_test_point(end: bool) {
    if !__gc_ready || __gc_pct < 0 || __gc_busy {
        return
    }
    if !__gc_stress && __heap_live < __gc_trigger {
        return
    }
    if !end {
        __gc_collect_self(GC_WHY_TEST)
        return
    }
    if load64(__ctx() + CTX_STORE_HELD) != 0 {
        return
    }
    __store_lock_gc()
    __gc_collect_now(load64(__ctx() + CTX_PINREC), GC_WHY_TEST)
    __store_unlock_gc()
}

// KHRIP_GC_STRESS без потока сборщика (khc test): окно (__store_release_keep,
// блокировка уже отпущена) — тоже точка сборки, как будто в окно попал кусок
// разметки потока сборщика: контекст опубликовал себя и не держит store. Шаг
// сборки (__gc_stress_step); сборка, начатая здесь, захватывает арену окна, и
// контекст, продолжив, передаёт её сам.
fn __gc_window_point() {
    if !__gc_stress || __gc_has_thread || __gc_busy || __gc_pct < 0 || !__gc_ready {
        return
    }
    __store_lock_gc()
    __gc_stress_step(0)
    __store_unlock_gc()
}

// Сборка из контекста, который держит указатели в store: если он держит store
// исключительно — как у жёсткого предела; если не держит — блокировка
// сборщика и запись, опубликованная на время сборки (тест после call,
// __gc_collect). Разделяемая блокировка — собрать нельзя.
fn __gc_collect_self(why: int) {
    let c = __ctx()
    let held = load64(c + CTX_STORE_HELD)
    if held == 1 {
        if !__store_on() {
            __gc_emergency(why)
        }
        return
    }
    if held != 0 {
        return
    }
    __store_lock_gc()
    let r = load64(c + CTX_PINREC)
    __pin_publish(r)
    __gc_collect_now(r, why)
    if r != 0 {
        __pin_withdraw(__cast(r))
    }
    __store_unlock_gc()
}

// Сборка сейчас (тесты, замеры): контекст публикует себя на время сборки.
// Работает и с KHRIP_GC=off.
fn __gc_collect() {
    if !__gc_ready || __gc_busy {
        return
    }
    __gc_collect_self(GC_WHY_CALL)
}

// Состояние сборщика для тестов и замеров.
type __GcStats {
    // сборок
    cycles: int
    // байт в выделенных объектах сейчас
    heap: int
    // живое по последней сборке (помеченное и чёрное): байт и объектов
    live: int
    objects: int
    // цель и порог следующей сборки
    goal: int
    trigger: int
    // страниц до границы занятых
    pages: int
    // байт возвращено системе за всё время
    released: int
    // наибольшая пауза сборки целиком, мкс
    max_pause_us: int
    // идёт разметка
    marking: bool
    // выделено чёрным в последней (или идущей) сборке: байт
    black: int
}

fn __gc_stats() -> __GcStats {
    return __GcStats { cycles: __gc_cycle_no, heap: __heap_live, live: __heap_marked, objects: __gc_marked_objs + __gc_black_objs, goal: __gc_goal, trigger: __gc_trigger, pages: load64(__gc_ph + PH_HW), released: __gc_total_released, max_pause_us: __gc_max_pause, marking: __gc_marking != 0, black: __gc_black_bytes }
}

// ---- Возврат памяти системе (§4.8) ----

// Свободные грязные страницы (на них были объекты, их память, скорее всего,
// занята) — системе, сверху вниз, пока их не останется на retain байт:
// max(1 МБ, 1,1 · цель − занятое), а после простоя (idle) — ни одной. С ними
// — целые страницы метаданных (START, MARK, PTRB, карта страниц, записи
// спанов), которые описывают только эти страницы. locked — вызывающий держит
// store исключительно и не отпускает (сборка внутри работы, тест): всё под
// блокировкой; иначе (поток сборщика) кучка меняется под мьютексом писателей
// (__store_lock_marker), а madvise идёт без блокировки — страницы тем
// временем заняты (__ph_scav_take). runs — место на GC_SCAV_RUNS серий. →
// байт возвращено.
fn __gc_scavenge(idle: bool, locked: bool, runs: int) -> int {
    if !locked {
        __store_lock_marker()
    }
    let ph = __gc_ph
    let fr = load64(ph + PH_FREE)
    let dt = load64(ph + PH_DIRTY)
    var top = __gc_committed >> GC_PAGE_SHIFT
    if top > load64(ph + PH_CAP) {
        top = load64(ph + PH_CAP)
    }
    var fd = 0
    var used = 0
    var wi = 0
    while (wi << 6) < top {
        var valid = -1
        if (wi << 6) + 64 > top {
            valid = (1 << (top - (wi << 6))) - 1
        }
        let f = load64(fr + (wi << 3))
        fd += __popcount(f & load64(dt + (wi << 3)) & valid)
        used += __popcount(~f & valid)
        wi += 1
    }
    var retain = 0
    if !idle {
        retain = __gc_goal + __gc_goal / 10 - (used << GC_PAGE_SHIFT)
        if retain < GC_MB {
            retain = GC_MB
        }
    }
    var need = (fd << GC_PAGE_SHIFT) - retain
    var n = 0
    var pg = top
    while need > 0 && n < GC_SCAV_RUNS {
        let e = __gc_scav_prev(fr, dt, pg) + 1
        if e <= 0 {
            break
        }
        var a = e - 1
        while a > 0 && __gc_scav_page(fr, dt, a - 1) {
            a -= 1
        }
        let most = (need + GC_PAGE - 1) >> GC_PAGE_SHIFT
        if e - a > most {
            a = e - most
        }
        __ph_scav_take(ph, a, e - a)
        store64(runs + n * 16, a)
        store64(runs + n * 16 + 8, e - a)
        n += 1
        need -= (e - a) << GC_PAGE_SHIFT
        pg = a
    }
    if !locked {
        __store_unlock_marker()
    }
    var bytes = 0
    for i in 0..n {
        let a = load64(runs + i * 16) << GC_PAGE_SHIFT
        let b = a + (load64(runs + i * 16 + 8) << GC_PAGE_SHIFT)
        syscall(GC_SYS_MADVISE, STORE_REGION + a, b - a, GC_DONTNEED)
        __gc_meta_drop(GC_START, a >> 7, b >> 7)
        __gc_meta_drop(GC_MARK, a >> 7, b >> 7)
        __gc_meta_drop(GC_PTRB, a >> 6, b >> 6)
        __gc_meta_drop(GC_SPANS, a >> 7, b >> 7)
        __gc_meta_drop(GC_PAGEMAP, a >> 11, b >> 11)
        bytes += b - a
    }
    if !locked {
        __store_lock_marker()
    }
    for i in 0..n {
        __ph_scav_done(ph, load64(runs + i * 16), load64(runs + i * 16 + 8))
    }
    if !locked {
        __store_unlock_marker()
    }
    __gc_st_released = bytes
    __gc_total_released += bytes
    __gc_st_rss = ((used + fd) << GC_PAGE_SHIFT) - bytes
    return bytes
}

// Свободна и грязна ли страница pg.
fn __gc_scav_page(fr: int, dt: int, pg: int) -> bool {
    let wi = pg >> 6
    return (((load64(fr + (wi << 3)) & load64(dt + (wi << 3))) >> (pg & 63)) & 1) != 0
}

// Самая верхняя свободная грязная страница ниже pg или −1.
fn __gc_scav_prev(fr: int, dt: int, pg: int) -> int {
    var p = pg
    while p > 0 {
        let wi = (p - 1) >> 6
        let nb = p - (wi << 6)
        var x = load64(fr + (wi << 3)) & load64(dt + (wi << 3))
        if nb < 64 {
            x = x & ((1 << nb) - 1)
        }
        if x != 0 {
            return (wi << 6) + 63 - __clz(x)
        }
        p = wi << 6
    }
    return -1
}

// Метаданные [base + lo, base + hi) — системе целыми страницами внутри
// диапазона (соседние страницы описывают и другие страницы STORE).
fn __gc_meta_drop(base: int, lo: int, hi: int) {
    let l = (lo + 4095) & ~4095
    let h = hi & ~4095
    if h > l {
        syscall(GC_SYS_MADVISE, base + l, h - l, GC_DONTNEED)
    }
}

// ---- Поток сборщика (§8.1) ----

// Запустить поток сборщика: сервер и программа с одними every — после
// загрузки, если в программе есть корни store и сборка не выключена.
fn __gc_spawn() {
    if __gc_pct < 0 || __gc_has_thread || load64(__gc_roots()) == 0 {
        return
    }
    let stack = syscall(SYS_MMAP, 0, GC_STACK, 3, 0x22 | 0x4000, -1, 0)
    if stack < 0 {
        __panic(PANIC_MEMORY, "mmap")
    }
    __gc_has_thread = true
    // с потоком сборщика другой порог сборки внутри работы (KHRIP_GC_STRESS)
    __gc_pace()
    // загрузка — не запись после сборки: отсчёт простоя и двух минут — отсюда
    __gc_touches = __store_touches
    __gc_last_us = __gc_now_us()
    __spawn(stack + GC_STACK, -2)
}

// Поток сборщика (lib/http.kh, __thread_main(-2)): ждёт, пока его разбудят
// (куча дошла до порога или сборка под чужой блокировкой оставила ему возврат
// памяти), но не дольше секунды; начало сборки — под исключительной
// блокировкой сборщика, разметка, её конец и уборка — кусками под мьютексом
// писателей, возврат памяти — без блокировки. Десять секунд без выделений в
// store — простой (раз на период): сборка, если с прошлой выделено больше 1 МБ
// или store брали на запись, и вся свободная память — системе. Store брали на
// запись, а сборки не было две минуты — сборка. Строки журнала — в своей арене
// потока.
fn __gc_thread_main() {
    __arena_init()
    let ts = __alloc(16)
    let runs = __gc_scratch(GC_SCAV_RUNS * 16)
    var idle = 0
    var last_live = -1
    var last_cycle = -1
    var idle_done = false
    while true {
        store64(ts, 1)
        store64(ts + 8, 0)
        syscall(SYS_FUTEX, __gc_ctl, FUTEX_WAIT_PRIVATE, 0, ts, 0, 0)
        if load64(__gc_ctl) != 0 || __heap_live >= __gc_trigger {
            __gc_thread_cycle(GC_WHY_PACE, runs)
            idle = 0
            idle_done = false
            continue
        }
        if __heap_live == last_live && __gc_cycle_no == last_cycle {
            idle += 1
        } else {
            idle = 0
            idle_done = false
        }
        if idle >= GC_IDLE_TICKS && !idle_done {
            // простой — раз на период без выделений: сборка, если с прошлой
            // выделено больше 1 МБ или store брали на запись (удаления и
            // замены освобождают, не выделяя), и всё свободное — системе
            idle_done = true
            if __heap_live > __heap_marked + GC_MB || __store_touches != __gc_touches {
                __gc_thread_cycle(GC_WHY_IDLE, runs)
            } else {
                __gc_scavenge(true, false, runs)
            }
        } else if __store_touches != __gc_touches && __gc_now_us() - __gc_last_us >= GC_FORCE_US {
            // store меняют, а куча не растёт (одни удаления): сборка раз в
            // две минуты, как у Go
            __gc_thread_cycle(GC_WHY_FORCED, runs)
        }
        last_live = __heap_live
        last_cycle = __gc_cycle_no
    }
}

// Сборка потока сборщика: начало (если сборки нет и, по порогу, куча дошла до
// него), разметка кусками, возврат памяти (и тот, что оставила сборка под
// чужой блокировкой), строка журнала.
fn __gc_thread_cycle(why: int, runs: int) {
    __store_lock_gc()
    store64(__gc_ctl, 0)
    var ran = false
    if __gc_phase == GC_PH_IDLE && (why != GC_WHY_PACE || __heap_live >= __gc_trigger) {
        __gc_begin_cycle(0, why)
        ran = true
    }
    let scav = __gc_scav_due
    __gc_scav_due = false
    if !ran {
        __gc_poked = false
    }
    __store_unlock_gc()
    var done = false
    if ran {
        done = __gc_thread_mark()
    }
    if ran || scav {
        __gc_scavenge(why == GC_WHY_IDLE, false, runs)
    }
    if done && __gc_log {
        __arena_begin()
        eprint(__gc_line())
        __arena_end()
    }
}

// Разметка кусками (§7.4, §8.1): кусок — не дольше KHRIP_GC_SLICE_US под
// мьютексом писателей, между кусками — пауза в три куска (разметке — четверть
// времени; подстройка под давление кучи — шаг 6b), чтобы писатели шли: мьютекс
// не честный, и сразу взятый снова он им бы не достался. Кусок, который
// закончил разметку, — тут же и конец разметки (§7.6) с уборкой. → true, если
// сборку закончил поток; false — её доделал кто-то другой (сборка внутри
// работы, __gc_collect).
fn __gc_thread_mark() -> bool {
    let k = __gc_cycle_no
    while true {
        __gc_sleep_us(__gc_slice_us * 3)
        __store_lock_marker()
        if __gc_phase != GC_PH_MARK || __gc_cycle_no != k {
            __store_unlock_marker()
            return false
        }
        __gc_busy = true
        let t0 = __gc_now_us()
        let fin = __gc_mark(__gc_slice_us, 0, false)
        var t1 = __gc_now_us()
        var done = false
        if fin {
            if __gc_terminate_try() {
                __gc_after(t1)
                done = true
            } else {
                // конец разметки не уложился в GC_TERM_US: это был ещё кусок
                t1 = __gc_now_us()
            }
        }
        let dt = t1 - t0
        __gc_st_slices += 1
        __gc_st_mark += dt
        if dt > __gc_st_slice_max {
            __gc_st_slice_max = dt
        }
        __gc_busy = false
        __store_unlock_marker()
        if done {
            return true
        }
    }
    return false
}

// ---- Журнал (KHRIP_GC_LOG=1, §8.6) ----

// Строка о последней сборке — в stderr (сборка внутри работы и в тестах).
fn __gc_report() {
    if __gc_log {
        eprint(__gc_line())
    }
}

fn __gc_why(w: int) -> str {
    if w == GC_WHY_IDLE {
        return "idle"
    } else if w == GC_WHY_EMERGENCY {
        return "in request"
    } else if w == GC_WHY_RELEASE {
        return "at release"
    } else if w == GC_WHY_TEST {
        return "test"
    } else if w == GC_WHY_CALL {
        return "explicit"
    } else if w == GC_WHY_WINDOW {
        return "window"
    } else if w == GC_WHY_FORCED {
        return "forced"
    } else if w == GC_WHY_STRESS {
        return "stress"
    }
    return "pace"
}

// Инкрементальная сборка: начало (мкс), разметка — сумма кусков, их число и
// самый долгий, и сколько она шла, конец разметки (мкс) или сколько заняла
// доделка целиком; сборка целиком — пауза и её начало и разметка. Затем уборка
// и возврат памяти.
fn __gc_line() -> str {
    var line = "gc {__gc_cycle_no} ({__gc_why(__gc_st_why)}"
    if __gc_st_fin != 0 {
        line += ", finished {__gc_why(__gc_st_fin)}"
    }
    line += "): heap {__gc_mbs(__gc_st_before)}->{__gc_mbs(__gc_st_after)} MB, live {__gc_mbs(__heap_marked)} MB ({__gc_marked_objs + __gc_black_objs} obj, {__gc_black_objs} black), m 1, pins {__gc_st_recs} rec/{__gc_st_words} words, arenas {__gc_st_arenas} ({(__gc_st_abytes + 1023) / 1024} KB, {__gc_st_handoffs} handed off), "
    if !__gc_st_inc {
        line += "pause {__gc_ms(__gc_st_pause)} ms (start {__gc_ms(__gc_st_start)}, mark {__gc_ms(__gc_st_term)})"
    } else {
        line += "start {__gc_st_start} µs, mark {__gc_ms(__gc_st_mark)} ms in {__gc_st_slices} slices (max {__gc_st_slice_max} µs) over {__gc_ms(__gc_st_wall)} ms, "
        if __gc_st_fin != 0 {
            line += "finished in {__gc_ms(__gc_st_term)} ms"
        } else {
            line += "term {__gc_st_term} µs ({__gc_term_tries} tries)"
        }
    }
    line += ", sweep {__gc_ms(__gc_st_sweep)} ms"
    if __gc_st_relhanded {
        line += ", pages released by the GC thread"
    } else if __gc_st_fin == 0 {
        line += ", released {__gc_mbs(__gc_st_released)} MB in {__gc_ms(__gc_st_release)} ms, rss-store {__gc_mbs(__gc_st_rss)} MB"
    }
    if __gc_st_long > 0 {
        line += ", long holders {__gc_st_long} ({__gc_st_long_age} cycles, {__gc_st_long_words} words)"
    }
    return line + ", next at {__gc_mbs(__gc_trigger)} MB"
}

// Байты в мегабайтах с одним знаком.
fn __gc_mbs(b: int) -> str {
    if b == GC_MAX {
        return "-"
    }
    let t = (b * 10 + GC_MB / 2) / GC_MB
    return "{t / 10}.{t % 10}"
}

// Микросекунды в миллисекундах с двумя знаками.
fn __gc_ms(us: int) -> str {
    let f = (us % 1000) / 10
    if f < 10 {
        return "{us / 1000}.0{f}"
    }
    return "{us / 1000}.{f}"
}

// ---- Загрузка ----

// Начало программы со store (__serve, __run_timers — с load, __tests_init —
// без): постоянная память, начальные значения глобальных пользователя
// (__init_stores) и, если load, восстановление из KHRIP_DATA. Всё временное —
// значения инициализаторов до копии, текст файла, разобранное значение —
// выделяется в арене загрузки BOOT_ARENA (64 ГБ адресов, MAP_NORESERVE), а в
// store значения копирует __persist (store_write в __init_stores и в
// __store_restore). После загрузки граф store — только STORE и DATA (I1), и
// арена целиком возвращается системе: из пика памяти (файл, разобранное
// значение, временное декодера, store) остаётся только store.
fn __store_boot(load: bool) {
    __store_init()
    __store_rw_init()
    __store_lock()
    let c = __ctx()
    let pa = load64(c + CTX_ARENA)
    let pe = load64(c + CTX_ARENA_END)
    __arena_attach(c, BOOT_ARENA)
    __arena_begin()
    __init_stores()
    if __gc_verify {
        __gc_verify_graph("boot")
    }
    var restored = false
    if load {
        restored = __load_store()
    }
    // Арена больше не нужна: снова обычная память потока, а арена — системе
    // целиком (__arena_end обнулил бы до 32 МБ её страниц ради следующего
    // запроса, а у арены загрузки его не будет). В неё не указывает никто:
    // store — копия, а JSON-null восстановления и кэш строк арены (её первые
    // STRC_SIZE байт) уходят вместе с ней.
    store64(c + CTX_PTR, load64(c + CTX_SAVE_PTR))
    store64(c + CTX_END, load64(c + CTX_SAVE_END))
    syscall(SYS_MUNMAP, BOOT_ARENA, BOOT_ARENA_SIZE)
    store64(c + CTX_ARENA, pa)
    store64(c + CTX_ARENA_END, pe)
    store64(c + CTX_JNULLS, 0)
    if restored && __gc_verify {
        __gc_verify_graph("restore")
    }
    // всё, что построено при загрузке, живо: от этого — темп сборок (§5.3)
    __heap_marked = __heap_live
    __gc_pace()
    __store_release_final()
    __store_saved = __store_touches
}

// ---- Проверки (KHRIP_GC_VERIFY=1) ----

// Ошибка проверки — конец программы: граф или куча store уже неверны, и
// продолжать значит портить данные дальше. Выделение из store выключается
// раньше, чем строится сообщение.
fn __gc_fatal(what: str) {
    if load64(__ctx() + CTX_PSAVE_PTR) != 0 {
        __pmode_off()
    }
    eprint("khrip: gc verify: " + what)
    exit(101)
}
