// Сборщик мусора store (docs/design/v0.13-store-gc.md). Пока здесь куча store
// (§4: классы размеров, спаны, кучка страниц, битовые карты) и загрузка store
// (§5.3). Записи и сама сборка — следующие шаги проекта (§14); пока память
// store только выделяется.
//
// Программы без store вместо этого файла получают lib/nostore.kh; проверки
// (KHRIP_GC_VERIFY) — в lib/gc_verify.kh или заглушки lib/gc_noverify.kh;
// самопроверка кучки страниц — lib/gc_test.kh (src/main.kh).

// Проверки сборщика включены (KHRIP_GC_VERIFY, lib/gc_verify.kh)
var __gc_verify: bool
// проверки и при каждом выделении (KHRIP_GC_VERIFY=1): быстрого пути нет
var __gc_verify_slow: bool
// Выделение — только общим путём (__salloc_slow): идут проверки при каждом
// выделении или разметка. Признак пересчитывает __gc_slow_update; разметку
// включает и выключает только __gc_set_marking.
var __gc_slow: bool

// Настройки сборщика из окружения.
fn __gc_init() {
    __gc_verify_init()
}

fn __gc_slow_update() {
    __gc_slow = __gc_verify_slow || __gc_marking != 0
}

// Разметка (шаг 6): пока она идёт, каждый новый объект помечен, а быстрый путь
// __salloc бит MARK не ставит, — поэтому вместе с __gc_marking меняется и
// __gc_slow. Другого способа менять __gc_marking нет.
fn __gc_set_marking(on: bool) {
    if on {
        __gc_marking = 1
    } else {
        __gc_marking = 0
    }
    __gc_slow_update()
}

// ---- Раскладка (§3.1, §3.2) ----
// STORE — 256 ГБ адресов с STORE_REGION (lib/core.kh), страницы по 8 КБ.
// Метаданные — по постоянным адресам в области GCMETA; адреса резервируются в
// __store_init (PROT_NONE), а память подключается вместе с памятью STORE
// (__gc_commit_to), поэтому работает и при строгом учёте памяти ядром.
//   GC_START   — бит на 16 байт: здесь начинается выделенный объект;
//   GC_MARK    — бит на 16 байт: пометка сборщика (шаг 5);
//   GC_PTRB    — бит на 8 байт: в слове может лежать ссылка (у объектов, в
//                которых ссылки ищут); у свободной памяти биты — нули;
//   GC_PAGEMAP — u32 на страницу: первая страница спана + 1 (0 — нет спана);
//   GC_SPANS   — 64 байта на страницу: запись спана лежит у его первой страницы;
//   GC_PHEAP   — кучка страниц: карты free, dirty, released и дерево.
// Бит адреса p: номер g = (p − STORE_REGION) >> 4 (у PTRB — >> 3), слово g >> 6,
// бит g & 63; младший бит — меньший адрес.

const GCMETA = 0x180000000000
const GCMETA_SIZE = 0x304000000
const GC_START = 0x180000000000
const GC_MARK = 0x180080000000
const GC_PTRB = 0x180100000000
const GC_PAGEMAP = 0x180200000000
const GC_SPANS = 0x180240000000
const GC_PHEAP = 0x180300000000
// Слово START адреса p — ((p >> 10) << 3) + GC_START_P, бит — (p >> 4) & 63;
// слово PTRB — ((p >> 9) << 3) + GC_PTRB_P, бит — (p >> 3) & 63 (STORE_REGION
// кратен 2^10): GC_START_P = GC_START − (STORE_REGION >> 7), GC_PTRB_P =
// GC_PTRB − (STORE_REGION >> 6). Так быстрый путь __salloc обходится без
// вычитания начала STORE.
const GC_START_P = 0x17E000000000
const GC_PTRB_P = 0x17C100000000
// части кучки страниц: по 4 МБ на карты (2^25 страниц), 16 МБ на дерево
const GC_PH_PART = 0x400000
const GC_PAGE = 8192
const GC_PAGE_SHIFT = 13
// страниц в STORE: STORE_SIZE / GC_PAGE
const GC_MAX_PAGES = 0x2000000
// самый большой класс размеров; объект больше — свой спан из целых страниц
const GC_SMALL_MAX = 32768
// классов размеров (1..GC_CLASSES; 0 — нет класса)
const GC_CLASSES = 65

// Запись спана (8 слов, GC_SPANS + первая страница · 64):
//   [0]  base — адрес первого объекта;
//   [8]  страниц (32 бита) | класс спана sc (16) | флаги (16);
//   [16] размер слота (у большого спана — все его байты);
//   [24] freeindex — адрес, с которого искать свободный слот (до него свободных
//        нет до следующей уборки);
//   [32] sweepgen (шаг 5);
//   [40] magic (32) | объектов в спане (32); magic = ⌈2^32 / размер⌉: номер слота
//        смещения off — (off · magic) >> 32, точно для смещений спана (меньше
//        80 КБ); у большого — 0 | 1;
//   [48] следующий спан списка частично занятых (шаг 5);
//   [56] конец слотов для быстрого пути __salloc или 0, если слоты надо
//        обнулять (NEEDZERO): тогда каждое выделение идёт общим путём.
// Класс спана sc = класс · 2 + 1, если в объектах нет ссылок (NOSCAN).
const S_BASE = 0
const S_INFO = 8
const S_SIZE = 16
const S_FREE = 24
const S_SWEEPGEN = 32
const S_MAGIC = 40
const S_NEXT = 48
const S_FAST = 56
const F_INUSE = 1
const F_NOSCAN = 2
const F_LARGE = 4
const F_NEEDZERO = 8

// Таблицы классов (кусок mmap, __gc_classes): [0..313) — класс по размеру
// (байт): до 1024 байт — номер (n + 15) >> 4, дальше — 56 + ((n + 127) >> 7);
// с 1024 — размер объекта класса (слово), с 2048 — страниц в его спане.
var __gc_tab: int
// текущий спан каждого класса спана (слово на sc) или __gc_none
var __gc_cur: int
// пустая запись спана: слотов в ней нет
var __gc_none: int
// кучка страниц STORE (состояние — см. __ph_init)
var __gc_ph: int
// байт STORE, к которым подключена память (кратно COMMIT)
var __gc_committed: int
// последний __gc_pages взял страницы, где уже были объекты
var __gc_took_dirty: bool
// байт в выделенных объектах (по размерам классов и целым страницам)
var __heap_live: int
// номер уборки (шаг 5)
var __gc_sweepgen: int

// Резерв адресов STORE и GCMETA, таблицы классов, кучка страниц. Повторный
// вызов ничего не делает.
fn __store_init() {
    if __gc_ready {
        return
    }
    if !__reserve(STORE_REGION, STORE_SIZE) || !__reserve(GCMETA, GCMETA_SIZE) {
        __panic(PANIC_MEMORY, "store region")
    }
    __gc_init()
    __gc_classes()
    __gc_none = __mmap(64)
    __gc_cur = __mmap((GC_CLASSES + 1) * 16)
    for i in 0..(GC_CLASSES + 1) * 2 {
        store64(__gc_cur + i * 8, __gc_none)
    }
    __gc_ph = __mmap(128)
    __ph_init(__gc_ph, GC_PHEAP, GC_PHEAP + GC_PH_PART, GC_PHEAP + 2 * GC_PH_PART, GC_PHEAP + 3 * GC_PH_PART, 512, GC_MAX_PAGES, true)
    __gc_ready = true
}

// Классы размеров — таблица Go (runtime/sizeclasses.go) от 16 байт до 32 КБ
// без класса 24 байта: объекты лежат по границе 16 байт (бит START на 16
// байт). Хвост спана — не больше 12,5%. До 256 байт классы кратны 16, как и
// округление __alloc, а степени двойки (массивы списков, слоты словарей) —
// ровно классы. В таблице на класс три байта: размер / 16 (два байта, младший
// первым) и страниц в спане.
fn __gc_classes() {
    let src = __data_hex("01 00 01 02 00 01 03 00 01 04 00 01 05 00 01 06 00 01 07 00 01 08 00 01 09 00 01 0A 00 01 0B 00 01 0C 00 01 0D 00 01 0E 00 01 0F 00 01 10 00 01 12 00 01 14 00 01 16 00 01 18 00 01 1A 00 01 1C 00 01 1E 00 01 20 00 01 24 00 01 28 00 01 2C 00 01 30 00 01 38 00 01 40 00 01 48 00 01 50 00 01 58 00 02 60 00 01 70 00 02 80 00 01 90 00 02 A8 00 01 C0 00 03 C8 00 02 D8 00 03 00 01 01 30 01 03 50 01 02 80 01 03 98 01 04 A8 01 05 B0 01 06 00 02 01 50 02 07 60 02 06 80 02 05 A8 02 04 00 03 03 50 03 05 80 03 07 00 04 02 80 04 09 A8 04 07 00 05 05 50 05 08 00 06 03 A8 06 0A 00 07 07 00 08 04")
    let t = __mmap(4096)
    for j in 1..GC_CLASSES + 1 {
        let e = src + (j - 1) * 3
        store64(t + 1024 + j * 8, (load8(e) | (load8(e + 1) << 8)) << 4)
        store64(t + 2048 + j * 8, load8(e + 2))
    }
    // наименьший класс, вмещающий размер: номер i в таблице — размеры до
    // i · 16 (до 1 КБ) или до (i − 56) · 128
    var c = 1
    for i in 0..313 {
        var n = i * 16
        if i > 64 {
            n = (i - 56) * 128
        }
        while load64(t + 1024 + c * 8) < n {
            c += 1
        }
        store8(t + i, c)
    }
    __gc_tab = t
}

// ---- Выделение (§4.2) ----

// Объект store из n байт вида kind (K_NOSCAN, K_PTRS или K_MASK с маской
// mask — lib/core.kh). Только в режиме store (__pmode_on), то есть под
// исключительной блокировкой: метаданные кучи меняет только владелец мьютекса
// писателей (I5). Память нулевая; START отмечает начало объекта, PTRB — слова,
// где могут быть ссылки (у K_PTRS — все слова объекта, хвост слота — нули).
//
// Быстрый путь — объект до 1 КБ, слот freeindex текущего спана класса
// свободен, спан не требует обнуления, нет ни разметки, ни проверок
// (__gc_slow); всё остальное — __salloc_slow. У класса без спана текущий —
// пустая запись __gc_none (freeindex = конец = 0), поэтому проверять 0 не
// нужно.
fn __salloc(n: int, kind: int, mask: int) -> int {
    if n > 1024 || __gc_slow {
        return __salloc_slow(n, kind, mask)
    }
    var sc = load8(__gc_tab + ((n + 15) >> 4)) << 1
    if kind == K_NOSCAN {
        sc += 1
    }
    let s = load64(__gc_cur + (sc << 3))
    let p = load64(s + S_FREE)
    if p < load64(s + S_FAST) {
        let a = ((p >> 10) << 3) + GC_START_P
        let w = load64(a)
        let b = 1 << ((p >> 4) & 63)
        if (w & b) == 0 {
            store64(a, w | b)
            let es = load64(s + S_SIZE)
            store64(s + S_FREE, p + es)
            __heap_live += es
            if kind != K_NOSCAN {
                var m = mask
                if kind == K_PTRS {
                    if n > 504 {
                        __gc_ptrbits(p, n, kind, mask)
                        return p
                    }
                    m = (1 << ((n + 7) >> 3)) - 1
                }
                // объект до 64 слов задевает одно или два слова карты PTRB
                let pa = ((p >> 9) << 3) + GC_PTRB_P
                let sh = (p >> 3) & 63
                store64(pa, load64(pa) | (m << sh))
                if sh != 0 {
                    let hi = (m >> (64 - sh)) & ((1 << sh) - 1)
                    if hi != 0 {
                        store64(pa + 8, load64(pa + 8) | hi)
                    }
                }
            }
            return p
        }
    }
    return __salloc_slow(n, kind, mask)
}

// Общий путь __salloc: любой размер, поиск слота, новый спан, обнуление,
// разметка, проверки.
fn __salloc_slow(n: int, kind: int, mask: int) -> int {
    if __gc_verify {
        __gc_check_owner()
    }
    var c = 0
    if n <= 1024 {
        c = load8(__gc_tab + ((n + 15) >> 4))
    } else if n <= GC_SMALL_MAX {
        c = load8(__gc_tab + 56 + ((n + 127) >> 7))
    } else {
        return __salloc_large(n, kind, mask)
    }
    var sc = c * 2
    if kind == K_NOSCAN {
        sc += 1
    }
    let cur = __gc_cur + sc * 8
    var s = load64(cur)
    var p = __span_take(s)
    if p == 0 {
        s = __span_new(sc)
        store64(cur, s)
        p = __span_take(s)
    }
    let es = load64(s + S_SIZE)
    if __gc_marking != 0 {
        __gc_bit_set(GC_MARK, p)
    }
    if ((load64(s + S_INFO) >> 48) & F_NEEDZERO) != 0 {
        __memset(p, 0, es)
    } else if __gc_verify {
        __gc_check_zero(p, es)
    }
    if kind != K_NOSCAN {
        __gc_ptrbits(p, n, kind, mask)
    }
    __heap_live += es
    return p
}

// Память для объекта h (рост контейнера store) или любая память в режиме
// store (lib/core.kh, __alloc_for_k): из кучи store. K_LIST_DATA — новый массив
// списка h того же вида, что нынешний.
fn __salloc_for(h: int, n: int, kind: int, mask: int) -> int {
    var k = kind
    if k == K_LIST_DATA {
        k = __gc_kind_of(load64(h))
    }
    if __store_on() {
        return __salloc(n, k, mask)
    }
    __pmode_on()
    let p = __salloc(n, k, mask)
    __pmode_off()
    return p
}

// Структура по описанию d в куче store (lib/api.kh, __struct_alloc): ссылки
// объекта — поля по маске описания (у варианта — со сдвигом на слово метки);
// полей больше 63 — каждое слово ссылка.
fn __struct_salloc(d: int, n: int, tag: int) -> int {
    var mask = load64(d + 32 + load64(d + 8) * 40)
    var kind = K_MASK
    if mask < 0 {
        kind = K_PTRS
    } else if tag >= 0 {
        mask = mask << 1
    }
    if mask == 0 {
        kind = K_NOSCAN
    }
    if tag < 0 {
        return __salloc(n * 8, kind, mask)
    }
    let p = __salloc(n * 8 + 8, kind, mask)
    store64(p, tag)
    return p + 8
}

// Идёт ли выделение из store (__pmode_on).
fn __store_on() -> bool {
    return load64(__ctx() + CTX_PSAVE_PTR) != 0
}

// Выделять ли память для внутренностей объекта h из store: выделение идёт из
// store или объект сам в store (__alloc_for_k, lib/core.kh).
fn __store_for(h: int) -> bool {
    return load64(__ctx() + CTX_PSAVE_PTR) != 0 || __in_store(h)
}

// Изменение контейнера h (список, словарь; lib/core.kh): у контейнера в store
// — только под исключительной блокировкой. Иначе маршрут, который компилятор
// счёл читающим (src/rw.kh), менял бы store одновременно с другими читателями
// и (шаг 6) с разметкой сборщика: лучше ответ 500, чем гонка.
fn __store_mut(h: int) {
    if (h >> 40) == (STORE_REGION >> 40) && load64(__ctx() + CTX_STORE_HELD) != 1 {
        __store_mut_slow()
    }
}

fn __store_mut_slow() {
    __panic_msg("internal: store changed without the exclusive store lock")
}

// Паника (lib/core.kh) во время выделения из store (__pmode_on) сначала
// выходит из него: её текст строится в арене. Иначе паника из-за нехватки
// памяти store паниковала бы снова на своём тексте (и так до переполнения
// стека), а текст лежал бы в store, где на него не ссылается ни один корень.
fn __store_panic() {
    if __store_on() {
        __pmode_off()
    }
}

// Первый свободный слот спана s от freeindex (бит START снят) — его адрес, или
// 0, если свободных нет. Слот занимается.
fn __span_take(s: int) -> int {
    var p = load64(s + S_FREE)
    let es = load64(s + S_SIZE)
    let lim = load64(s + S_BASE) + (load64(s + S_MAGIC) >> 32) * es
    while p < lim {
        let g = (p - STORE_REGION) >> 4
        let a = GC_START + ((g >> 6) << 3)
        let w = load64(a)
        let b = 1 << (g & 63)
        if (w & b) == 0 {
            store64(a, w | b)
            store64(s + S_FREE, p + es)
            return p
        }
        p += es
    }
    store64(s + S_FREE, lim)
    return 0
}

// Новый спан класса спана sc из страниц кучки.
fn __span_new(sc: int) -> int {
    let c = sc >> 1
    let es = load64(__gc_tab + 1024 + c * 8)
    let np = load64(__gc_tab + 2048 + c * 8)
    let pg = __gc_pages(np)
    let base = STORE_REGION + (pg << GC_PAGE_SHIFT)
    var fl = F_INUSE
    if (sc & 1) != 0 {
        fl = fl | F_NOSCAN
    }
    if __gc_took_dirty {
        fl = fl | F_NEEDZERO
    }
    let ne = (np << GC_PAGE_SHIFT) / es
    let s = GC_SPANS + (pg << 6)
    store64(s + S_BASE, base)
    store64(s + S_INFO, np | (sc << 32) | (fl << 48))
    store64(s + S_SIZE, es)
    store64(s + S_FREE, base)
    store64(s + S_SWEEPGEN, __gc_sweepgen)
    store64(s + S_MAGIC, ((0x100000000 + es - 1) / es) | (ne << 32))
    store64(s + S_NEXT, 0)
    if (fl & F_NEEDZERO) == 0 {
        store64(s + S_FAST, base + ne * es)
    } else {
        store64(s + S_FAST, 0)
    }
    __gc_pagemap_set(pg, np, pg + 1)
    return s
}

// Спан после уборки (шаг 5), где остались объекты: свободные слоты ищутся
// снова с начала (freeindex — адрес первого слота), а быстрый путь закрыт
// (S_FAST = 0) — освобождённые слоты надо обнулять при выделении (NEEDZERO).
// Биты START и PTRB освобождённых слотов уборка уже сняла.
fn __span_rewind(s: int) {
    store64(s + S_FREE, load64(s + S_BASE))
    store64(s + S_FAST, 0)
    store64(s + S_INFO, load64(s + S_INFO) | (F_NEEDZERO << 48))
}

// Спан, где не осталось объектов, — страницы кучке (шаг 5): биты START, MARK и
// PTRB его памяти снимаются (у свободной памяти они нули), записи карты
// страниц — нули, запись спана — не INUSE; страницы — свободны и грязны (их
// следующий спан обнулит). Байты объектов из __heap_live вычитает вызывающий.
fn __span_free(s: int) {
    let base = load64(s + S_BASE)
    let np = load64(s + S_INFO) & 0xFFFFFFFF
    let pg = (base - STORE_REGION) >> GC_PAGE_SHIFT
    let g = (base - STORE_REGION) >> 4
    __bits_put(GC_START, g, g + (np << 9), false)
    __bits_put(GC_MARK, g, g + (np << 9), false)
    __bits_put(GC_PTRB, g << 1, (g << 1) + (np << 10), false)
    __gc_pagemap_set(pg, np, 0)
    store64(s + S_INFO, 0)
    store64(s + S_FREE, 0)
    store64(s + S_FAST, 0)
    __ph_free(__gc_ph, pg, np)
}

// Объект больше GC_SMALL_MAX — свой спан из целых страниц.
fn __salloc_large(n: int, kind: int, mask: int) -> int {
    let np = (n + GC_PAGE - 1) >> GC_PAGE_SHIFT
    let pg = __gc_pages(np)
    let base = STORE_REGION + (pg << GC_PAGE_SHIFT)
    let bytes = np << GC_PAGE_SHIFT
    var fl = F_INUSE | F_LARGE
    if kind == K_NOSCAN {
        fl = fl | F_NOSCAN
    }
    let s = GC_SPANS + (pg << 6)
    store64(s + S_BASE, base)
    store64(s + S_INFO, np | (fl << 48))
    store64(s + S_SIZE, bytes)
    store64(s + S_FREE, base + bytes)
    store64(s + S_SWEEPGEN, __gc_sweepgen)
    store64(s + S_MAGIC, 1 << 32)
    store64(s + S_NEXT, 0)
    store64(s + S_FAST, 0)
    __gc_pagemap_set(pg, np, pg + 1)
    __gc_bit_set(GC_START, base)
    if __gc_marking != 0 {
        __gc_bit_set(GC_MARK, base)
    }
    if __gc_took_dirty {
        __memset(base, 0, bytes)
    } else if __gc_verify {
        __gc_check_zero(base, bytes)
    }
    if kind != K_NOSCAN {
        __gc_ptrbits(base, n, kind, mask)
    }
    __heap_live += bytes
    return base
}

// Биты PTRB объекта p из n байт: у K_PTRS — единицы на каждое слово, у K_MASK —
// маска. Остальные биты слота — уже нули (у свободной памяти они нули).
fn __gc_ptrbits(p: int, n: int, kind: int, mask: int) {
    let b = (p - STORE_REGION) >> 3
    var m = mask
    if kind == K_PTRS {
        let k = (n + 7) >> 3
        if k >= 64 {
            __bits_put(GC_PTRB, b, b + k, true)
            return
        }
        m = (1 << k) - 1
    }
    let sh = b & 63
    let a = GC_PTRB + ((b >> 6) << 3)
    store64(a, load64(a) | (m << sh))
    if sh != 0 {
        let hi = (m >> (64 - sh)) & ((1 << sh) - 1)
        if hi != 0 {
            store64(a + 8, load64(a + 8) | hi)
        }
    }
}

// np страниц для спана: первые подходящие по адресу из кучки, память к ним
// подключена. __gc_took_dirty — на них уже были объекты (их надо обнулять).
fn __gc_pages(np: int) -> int {
    let ph = __gc_ph
    let pg = __ph_find(ph, np)
    if pg < 0 {
        __panic(PANIC_MEMORY, "region")
    }
    let end = (pg + np) << GC_PAGE_SHIFT
    if end > __gc_committed {
        __gc_commit_to(end)
    }
    __gc_took_dirty = __ph_take(ph, pg, np)
    return pg
}

fn __gc_pagemap_set(pg: int, np: int, v: int) {
    var i = 0
    while i < np {
        store32(GC_PAGEMAP + ((pg + i) << 2), v)
        i += 1
    }
}

// Подключить память STORE до end байт (кратно COMMIT) и метаданные к ней:
// START, MARK, PTRB, PAGEMAP и SPANS — по паре в таблице: смещение от GCMETA
// в гигабайтах и сдвиг (байт метаданных — байт STORE >> сдвиг).
fn __gc_commit_to(end: int) {
    let old = __gc_committed
    let nw = (end + COMMIT - 1) & ~(COMMIT - 1)
    if nw > STORE_SIZE {
        __panic(PANIC_MEMORY, "region")
    }
    __gc_mprotect(STORE_REGION, old, nw)
    let t = __data_hex("00 07 02 07 04 06 08 0B 09 07")
    for i in 0..5 {
        let sh = load8(t + i * 2 + 1)
        __gc_mprotect(GCMETA + (load8(t + i * 2) << 30), old >> sh, nw >> sh)
    }
    __gc_committed = nw
}

// Память [base + from, base + to) — на чтение и запись (по целым страницам ОС).
fn __gc_mprotect(base: int, from: int, to: int) {
    let a = from & ~4095
    let b = (to + 4095) & ~4095
    if b > a && syscall(10, base + a, b - a, 3) < 0 {
        __panic(PANIC_MEMORY, "mprotect")
    }
}

// Вид памяти, где лежит p (массив списка в store): K_NOSCAN — спан без
// ссылок, иначе K_PTRS. Рост списка наследует вид старого массива (§4.4).
fn __gc_kind_of(p: int) -> int {
    let off = p - STORE_REGION
    if off < 0 || off >= __gc_committed {
        return K_PTRS
    }
    let e = load32(GC_PAGEMAP + ((off >> GC_PAGE_SHIFT) << 2))
    if e == 0 {
        return K_PTRS
    }
    if ((load64(GC_SPANS + ((e - 1) << 6) + S_INFO) >> 48) & F_NOSCAN) != 0 {
        return K_NOSCAN
    }
    return K_PTRS
}

// Начало выделенного объекта, внутри которого лежит p, или 0: p вне занятых
// страниц STORE, в хвосте спана или в свободном слоте.
fn __gc_obj_of(p: int) -> int {
    let off = p - STORE_REGION
    if off < 0 || off >= (load64(__gc_ph + PH_HW) << GC_PAGE_SHIFT) {
        return 0
    }
    let e = load32(GC_PAGEMAP + ((off >> GC_PAGE_SHIFT) << 2))
    if e == 0 {
        return 0
    }
    let s = GC_SPANS + ((e - 1) << 6)
    let fl = load64(s + S_INFO) >> 48
    if (fl & F_INUSE) == 0 {
        return 0
    }
    let base = load64(s + S_BASE)
    var slot = base
    if (fl & F_LARGE) == 0 {
        let mg = load64(s + S_MAGIC)
        let i = ((p - base) * (mg & 0xFFFFFFFF)) >> 32
        if i >= mg >> 32 {
            return 0
        }
        slot = base + i * load64(s + S_SIZE)
    }
    if !__gc_bit(GC_START, slot) {
        return 0
    }
    return slot
}

// Размер слота объекта o (начало выделенного объекта).
fn __gc_obj_size(o: int) -> int {
    return load64(__gc_span_of(o) + S_SIZE)
}

// Спан, в котором лежит p (p в занятой странице STORE).
fn __gc_span_of(p: int) -> int {
    let e = load32(GC_PAGEMAP + (((p - STORE_REGION) >> GC_PAGE_SHIFT) << 2))
    return GC_SPANS + ((e - 1) << 6)
}

// ---- Битовые карты ----

// Бит адреса p в карте START или MARK.
fn __gc_bit(bm: int, p: int) -> bool {
    let g = (p - STORE_REGION) >> 4
    return ((load64(bm + ((g >> 6) << 3)) >> (g & 63)) & 1) != 0
}

fn __gc_bit_set(bm: int, p: int) {
    let g = (p - STORE_REGION) >> 4
    let a = bm + ((g >> 6) << 3)
    store64(a, load64(a) | (1 << (g & 63)))
}

// Биты [lo, hi) одного слова (0 ≤ lo < hi ≤ 64).
fn __bits_mask(lo: int, hi: int) -> int {
    if hi - lo == 64 {
        return -1
    }
    return ((1 << (hi - lo)) - 1) << lo
}

// Биты [from, to) карты bm — единицы (one) или нули.
fn __bits_put(bm: int, from: int, to: int, one: bool) {
    var i = from
    while i < to {
        let wi = i >> 6
        var hi = to - (wi << 6)
        if hi > 64 {
            hi = 64
        }
        let m = __bits_mask(i & 63, hi)
        let a = bm + (wi << 3)
        if one {
            store64(a, load64(a) | m)
        } else {
            store64(a, load64(a) & ~m)
        }
        i = (wi << 6) + hi
    }
}

// Есть ли единица (one) или ноль (!one) среди битов [from, to) карты bm.
fn __bits_any(bm: int, from: int, to: int, one: bool) -> bool {
    var i = from
    while i < to {
        let wi = i >> 6
        var hi = to - (wi << 6)
        if hi > 64 {
            hi = 64
        }
        let m = __bits_mask(i & 63, hi)
        var w = load64(bm + (wi << 3))
        if !one {
            w = ~w
        }
        if (w & m) != 0 {
            return true
        }
        i = (wi << 6) + hi
    }
    return false
}

// Самая длинная серия единиц в слове.
fn __run_max(w: int) -> int {
    var x = w
    var k = 0
    while x != 0 {
        x = x & ((x >> 1) & 0x7FFFFFFFFFFFFFFF)
        k += 1
    }
    return k
}

// ---- Кучка страниц (§3.2) ----
// Состояние ph (16 слов):
const PH_CAP = 0
// одна за самой верхней занятой страницей
const PH_HW = 8
// карты: бит на страницу; free — свободна, dirty — на ней были объекты с тех
// пор, как её память вернули системе, released — память возвращена (шаг 5)
const PH_FREE = 16
const PH_DIRTY = 24
const PH_REL = 32
// дерево: узел i — 16 байт, [0] pre | suf << 32, [8] best (страниц)
const PH_TREE = 40
// наибольшая ёмкость (страниц)
const PH_MAX = 48
// операций с последней проверки дерева (KHRIP_GC_VERIFY)
const PH_OPS = 56
// 1 — кучка STORE: память карт и дерева подключается при росте ёмкости
const PH_COMMIT = 64
//
// Ёмкость cap — степень двойки, не меньше 64 страниц; страницы до cap, кроме
// занятых, свободны (и за ph_hw — все). Листья дерева — слова карты free (по
// 64 страницы), их L = cap / 64; узлы 1..2L−1 в порядке кучи, лист j — узел
// L + j. У узла: pre — свободных страниц подряд от его начала, suf — до его
// конца, best — самая длинная серия свободных внутри. Узлы обновляются сразу
// при каждом взятии и возврате, за O(np / 64 + log L); когда ёмкости не
// хватает, она удваивается и дерево строится заново, за O(L).

fn __ph_init(ph: int, fr: int, dt: int, rl: int, tr: int, cap: int, max: int, commit: bool) {
    store64(ph + PH_CAP, cap)
    store64(ph + PH_HW, 0)
    store64(ph + PH_FREE, fr)
    store64(ph + PH_DIRTY, dt)
    store64(ph + PH_REL, rl)
    store64(ph + PH_TREE, tr)
    store64(ph + PH_MAX, max)
    store64(ph + PH_OPS, 0)
    var cm = 0
    if commit {
        cm = 1
        __ph_commit(ph, cap)
    }
    store64(ph + PH_COMMIT, cm)
    __bits_put(fr, 0, cap, true)
    __ph_rebuild(ph)
}

// Память карт и дерева кучки STORE для ёмкости cap.
fn __ph_commit(ph: int, cap: int) {
    __gc_mprotect(load64(ph + PH_FREE), 0, cap >> 3)
    __gc_mprotect(load64(ph + PH_DIRTY), 0, cap >> 3)
    __gc_mprotect(load64(ph + PH_REL), 0, cap >> 3)
    __gc_mprotect(load64(ph + PH_TREE), 0, (cap >> 1) + 16)
}

// Удвоить ёмкость. → false, если она уже наибольшая.
fn __ph_grow(ph: int) -> bool {
    let cap = load64(ph + PH_CAP)
    if cap >= load64(ph + PH_MAX) {
        return false
    }
    if load64(ph + PH_COMMIT) != 0 {
        __ph_commit(ph, cap * 2)
    }
    __bits_put(load64(ph + PH_FREE), cap, cap * 2, true)
    store64(ph + PH_CAP, cap * 2)
    __ph_rebuild(ph)
    return true
}

// Лист i дерева t по слову карты free.
fn __ph_leaf(t: int, i: int, w: int) {
    var pre = 64
    var suf = 64
    var best = 64
    if w != -1 {
        pre = __ctz(~w)
        suf = __clz(~w)
        best = __run_max(w)
    }
    store64(t + (i << 4), pre | (suf << 32))
    store64(t + (i << 4) + 8, best)
}

// Узел i по детям, у которых по cs страниц.
fn __ph_node(t: int, i: int, cs: int) {
    let l = t + (i << 5)
    let lw = load64(l)
    let rw = load64(l + 16)
    let lpre = lw & 0xFFFFFFFF
    let lsuf = lw >> 32
    let rpre = rw & 0xFFFFFFFF
    let rsuf = rw >> 32
    var pre = lpre
    if lpre == cs {
        pre = cs + rpre
    }
    var suf = rsuf
    if rsuf == cs {
        suf = cs + lsuf
    }
    var best = load64(l + 8)
    let rb = load64(l + 24)
    if rb > best {
        best = rb
    }
    if lsuf + rpre > best {
        best = lsuf + rpre
    }
    store64(t + (i << 4), pre | (suf << 32))
    store64(t + (i << 4) + 8, best)
}

// Дерево целиком по карте free.
fn __ph_rebuild(ph: int) {
    let t = load64(ph + PH_TREE)
    let fr = load64(ph + PH_FREE)
    let nl = load64(ph + PH_CAP) >> 6
    for j in 0..nl {
        __ph_leaf(t, nl + j, load64(fr + (j << 3)))
    }
    var lo = nl >> 1
    var cs = 64
    while lo >= 1 {
        for i in lo..lo * 2 {
            __ph_node(t, i, cs)
        }
        lo = lo >> 1
        cs = cs * 2
    }
}

// Узлы над страницами [from, to) после изменения карты free.
fn __ph_update(ph: int, from: int, to: int) {
    let t = load64(ph + PH_TREE)
    let fr = load64(ph + PH_FREE)
    let nl = load64(ph + PH_CAP) >> 6
    var a = from >> 6
    var b = (to - 1) >> 6
    var i = a
    while i <= b {
        __ph_leaf(t, nl + i, load64(fr + (i << 3)))
        i += 1
    }
    a = (nl + a) >> 1
    b = (nl + b) >> 1
    var cs = 64
    while a >= 1 {
        i = a
        while i <= b {
            __ph_node(t, i, cs)
            i += 1
        }
        a = a >> 1
        b = b >> 1
        cs = cs * 2
    }
}

// Первая по адресу серия из np свободных страниц в пределах ёмкости или −1.
// В узле: влево, если там есть серия; иначе серия на стыке (её начало — самое
// левое из возможных); иначе вправо. В листе — перебор битов слова.
fn __ph_first_fit(ph: int, np: int) -> int {
    let t = load64(ph + PH_TREE)
    let nl = load64(ph + PH_CAP) >> 6
    if load64(t + 24) < np {
        return -1
    }
    var i = 1
    var lo = 0
    var size = load64(ph + PH_CAP)
    while i < nl {
        let cs = size >> 1
        let l = t + (i << 5)
        if load64(l + 8) >= np {
            i = i * 2
            size = cs
            continue
        }
        let lsuf = load64(l) >> 32
        if lsuf + (load64(l + 16) & 0xFFFFFFFF) >= np {
            return lo + cs - lsuf
        }
        i = i * 2 + 1
        lo += cs
        size = cs
    }
    let w = load64(load64(ph + PH_FREE) + ((i - nl) << 3))
    var run = 0
    for j in 0..64 {
        if ((w >> j) & 1) != 0 {
            run += 1
            if run >= np {
                return lo + j + 1 - np
            }
        } else {
            run = 0
        }
    }
    __gc_fatal("page heap: the tree promises a run the leaf does not have")
    return -1
}

// Первая по адресу серия из np свободных страниц, с ростом ёмкости; −1 — нет
// места и при наибольшей ёмкости.
fn __ph_find(ph: int, np: int) -> int {
    while true {
        let pg = __ph_first_fit(ph, np)
        if pg >= 0 {
            return pg
        }
        if !__ph_grow(ph) {
            return -1
        }
    }
    return -1
}

// Занять страницы [pg, pg + np) (они свободны). → true, если на какой-то из
// них уже были объекты.
fn __ph_take(ph: int, pg: int, np: int) -> bool {
    let fr = load64(ph + PH_FREE)
    if __gc_verify && __bits_any(fr, pg, pg + np, false) {
        __gc_fatal("page heap: a taken page is not free")
    }
    let dirty = __bits_any(load64(ph + PH_DIRTY), pg, pg + np, true)
    __bits_put(fr, pg, pg + np, false)
    __ph_update(ph, pg, pg + np)
    if pg + np > load64(ph + PH_HW) {
        store64(ph + PH_HW, pg + np)
    }
    __ph_tick(ph)
    return dirty
}

// Вернуть страницы [pg, pg + np) (они заняты): свободны и грязны; граница
// занятых опускается за свободные страницы под ней.
fn __ph_free(ph: int, pg: int, np: int) {
    let fr = load64(ph + PH_FREE)
    if __gc_verify && __bits_any(fr, pg, pg + np, true) {
        __gc_fatal("page heap: a freed page is already free")
    }
    __bits_put(fr, pg, pg + np, true)
    __bits_put(load64(ph + PH_DIRTY), pg, pg + np, true)
    __ph_update(ph, pg, pg + np)
    var hw = load64(ph + PH_HW)
    if pg + np == hw {
        hw = pg
        while hw > 0 {
            let top = (hw - 1) & 63
            let w = load64(fr + (((hw - 1) >> 6) << 3))
            if top == 63 && w == -1 {
                hw -= 64
            } else if ((w >> top) & 1) != 0 {
                hw -= 1
            } else {
                break
            }
        }
        store64(ph + PH_HW, hw)
    }
    __ph_tick(ph)
}

// ---- Загрузка ----

// Начало программы со store (__serve, __run_timers — с load, __tests_init —
// без): постоянная память, начальные значения глобальных пользователя
// (__init_stores) и, если load, восстановление из KHRIP_DATA. Всё временное —
// значения инициализаторов до копии, текст файла, разобранное значение —
// выделяется в арене загрузки BOOT_ARENA (64 ГБ адресов, MAP_NORESERVE), а в
// store значения копирует __persist (store_write в __init_stores и в
// __store_restore). После загрузки граф store — только STORE и DATA (I1), и
// арена целиком возвращается системе: из пика памяти (файл, разобранное
// значение, временное декодера, store) остаётся только store.
fn __store_boot(load: bool) {
    __store_init()
    __store_rw_init()
    __store_lock()
    let c = __ctx()
    let pa = load64(c + CTX_ARENA)
    let pe = load64(c + CTX_ARENA_END)
    __arena_attach(c, BOOT_ARENA)
    __arena_begin()
    __init_stores()
    if __gc_verify {
        __gc_verify_graph("boot")
    }
    var restored = false
    if load {
        restored = __load_store()
    }
    // Арена больше не нужна: снова обычная память потока, а арена — системе
    // целиком (__arena_end обнулил бы до 32 МБ её страниц ради следующего
    // запроса, а у арены загрузки его не будет). В неё не указывает никто:
    // store — копия, а JSON-null восстановления и кэш строк арены (её первые
    // STRC_SIZE байт) уходят вместе с ней.
    store64(c + CTX_PTR, load64(c + CTX_SAVE_PTR))
    store64(c + CTX_END, load64(c + CTX_SAVE_END))
    syscall(SYS_MUNMAP, BOOT_ARENA, BOOT_ARENA_SIZE)
    store64(c + CTX_ARENA, pa)
    store64(c + CTX_ARENA_END, pe)
    store64(c + CTX_JNULLS, 0)
    if restored && __gc_verify {
        __gc_verify_graph("restore")
    }
    __store_unlock()
    __store_saved = __store_touches
}

// ---- Проверки (KHRIP_GC_VERIFY=1) ----

// Ошибка проверки — конец программы: граф или куча store уже неверны, и
// продолжать значит портить данные дальше. Выделение из store выключается
// раньше, чем строится сообщение.
fn __gc_fatal(what: str) {
    if load64(__ctx() + CTX_PSAVE_PTR) != 0 {
        __pmode_off()
    }
    eprint("khrip: gc verify: " + what)
    exit(101)
}
