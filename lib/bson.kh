// BSON 1.1 (https://bsonspec.org/spec.html). Документ хранит порядок полей и
// точные типы BSON, без JSON посередине. Построители не превращают переданные
// значения в синтаксис запроса. Длины из чужих байтов сверяются с границами
// до чтения по ним.
//
// Документ проверяется один раз — на границе доверия: bson_parse, bson_finish,
// to_bson и ответ сервера (lib/mongo.kh). Результат помечен checked: его не
// проверяют снова, когда вкладывают в другой документ или отправляют.
// Аксессоры, обходы и from_bson не проверяют документ заранее и не строят
// списков полей: каждый шаг сверяет длину значения с границами документа,
// поэтому они безопасны и на непроверенных байтах (испорченная часть просто не
// находится). UTF-8 строки проверяется там, где значение становится str
// (from_bson, bson_get_str, имена полей map), — с путём поля в ошибке: одна
// испорченная строка не мешает читать остальной ответ.

const BSON_MAX_BYTES = 16777216
const BSON_MAX_DEPTH = 64

type Bson {
    data: str
    error: str = ""
    // байты проверены (ставит библиотека): вложение и отправка их не перепроверяют
    checked: bool = false
}
type BsonBuilder {
    buffer: Buf, error: str = "", keys: map[str, bool] = {}
}
type BsonObjectId {
    hex: str
}
type BsonDate {
    milliseconds: int
}
type BsonBinary {
    data: str, subtype: int = 0
}
// Точные байты IEEE decimal128 (little endian). Арифметики decimal нет.
type BsonDecimal128 {
    bytes: str
}
type BsonTimestamp {
    increment: int, seconds: int
}
type BsonField {
    name: str, kind: int, data: str
}
// Чтение from_bson: текст ошибки и путь поля (каждый уровень дописывает своё
// имя спереди, только при ошибке).
type __BsonRead {
    error: str = ""
    path: str = ""
}
// Запись to_bson: один буфер на весь документ, вложенные документы — на месте.
type __BsonOut {
    b: Buf
    error: str = ""
    path: str = ""
}

fn __bson_u32(b: Buf, n: int) {
    buf_reserve(b, 4)
    store32(b.data + b.len, n)
    b.len += 4
}

fn __bson_u64(b: Buf, n: int) {
    buf_reserve(b, 8)
    store64(b.data + b.len, n)
    b.len += 8
}

// Знаковое int32 по адресу p.
fn __bson_i32(p: int) -> int {
    let v = load32(p)
    if v > 2147483647 {
        return v - 4294967296
    }
    return v
}

// Первый нулевой байт в [p, end) или -1.
fn __bson_zero(p: int, end: int) -> int {
    let i = __find_byte(p, end - p, 0)
    if i >= end - p {
        return -1
    }
    return p + i
}

// Конец полей документа [p, p + n) — адрес завершающего нуля — или 0, если
// длина в заголовке или завершающий ноль не сходятся с n.
fn __bson_body(p: int, n: int) -> int {
    if n < 5 || load32(p) != n || load8(p + n - 1) != 0 {
        return 0
    }
    return p + n - 1
}

// Конец значения вида kind, которое начинается в p, или -1, если оно выходит за
// end. Только границы: вложенные документы и UTF-8 здесь не проверяются, поэтому
// обход документа читает каждое значение один раз.
fn __bson_skip(kind: int, p: int, end: int) -> int {
    var n = 0
    if kind == 1 || kind == 9 || kind == 17 || kind == 18 {
        n = 8
    } else if kind == 16 {
        n = 4
    } else if kind == 7 {
        n = 12
    } else if kind == 19 {
        n = 16
    } else if kind == 8 {
        n = 1
    } else if kind == 6 || kind == 10 || kind == 127 || kind == 255 {
        return p
    } else if kind == 2 || kind == 13 || kind == 14 {
        if end - p < 5 {
            return -1
        }
        n = load32(p)
        if n < 1 || n > end - p - 4 || load8(p + 3 + n) != 0 {
            return -1
        }
        return p + 4 + n
    } else if kind == 3 || kind == 4 {
        if end - p < 5 {
            return -1
        }
        n = load32(p)
        if n < 5 || n > end - p || load8(p + n - 1) != 0 {
            return -1
        }
        return p + n
    } else if kind == 5 {
        if end - p < 5 {
            return -1
        }
        n = load32(p)
        if n > end - p - 5 {
            return -1
        }
        return p + 5 + n
    } else if kind == 11 {
        let z = __bson_zero(p, end)
        if z < 0 {
            return -1
        }
        let z2 = __bson_zero(z + 1, end)
        if z2 < 0 {
            return -1
        }
        return z2 + 1
    } else if kind == 12 {
        let z = __bson_skip(2, p, end)
        if z < 0 || end - z < 12 {
            return -1
        }
        return z + 12
    } else if kind == 15 {
        if end - p < 4 {
            return -1
        }
        n = load32(p)
        if n < 14 || n > end - p {
            return -1
        }
        return p + n
    } else {
        return -1
    }
    if n > end - p {
        return -1
    }
    return p + n
}

// Ключ [p, p + n) — десятичная запись index без ведущих нулей (ключ элемента
// массива). Сравнение цифр на месте, без строк.
fn __bson_index_key(p: int, n: int, index: int) -> bool {
    var digits = 1
    var v = index
    while v >= 10 {
        v = v / 10
        digits += 1
    }
    if n != digits {
        return false
    }
    v = index
    var i = n - 1
    while i >= 0 {
        if load8(p + i) != '0' + v % 10 {
            return false
        }
        v = v / 10
        i -= 1
    }
    return true
}

// Ключ элемента массива index — прямо в буфер.
fn __bson_put_index(b: Buf, index: int) {
    var digits = 1
    var v = index
    while v >= 10 {
        v = v / 10
        digits += 1
    }
    buf_reserve(b, digits + 1)
    v = index
    var i = digits - 1
    while i >= 0 {
        store8(b.data + b.len + i, '0' + v % 10)
        v = v / 10
        i -= 1
    }
    store8(b.data + b.len + digits, 0)
    b.len += digits + 1
}

// Проверка документа [p, p + n): длины, завершающие нули, виды значений,
// булевы 0/1, ключи массивов "0", "1", ..., глубина; с utf8 — ещё строки и имена
// полей. Каждый байт читается один раз: рекурсия — только во вложенные
// документы. Ответы сервера проверяются без utf8 (там UTF-8 проверяет чтение).
fn __bson_check(p: int, n: int, depth: int, array: bool, utf8: bool) -> bool {
    if depth > BSON_MAX_DEPTH {
        return false
    }
    let end = __bson_body(p, n)
    if end == 0 {
        return false
    }
    var at = p + 4
    var index = 0
    while at < end {
        let kind = load8(at)
        let z = __bson_zero(at + 1, end)
        if z < 0 {
            return false
        }
        if array {
            if !__bson_index_key(at + 1, z - at - 1, index) {
                return false
            }
        } else if utf8 && __utf8_scan(at + 1, z - at - 1) < 0 {
            return false
        }
        let v = z + 1
        let next = __bson_skip(kind, v, end)
        if next < 0 {
            return false
        }
        if kind == 3 || kind == 4 {
            if !__bson_check(v, next - v, depth + 1, kind == 4, utf8) {
                return false
            }
        } else if kind == 8 {
            if load8(v) > 1 {
                return false
            }
        } else if kind == 5 {
            // старый подтип 2: внутри ещё одна длина
            let m = load32(v)
            if load8(v + 4) == 2 && (m < 4 || load32(v + 5) != m - 4) {
                return false
            }
        } else if kind == 2 || kind == 13 || kind == 14 {
            if utf8 && __utf8_scan(v + 4, next - v - 5) < 0 {
                return false
            }
        } else if kind == 11 {
            let z2 = __bson_zero(v, end)
            if utf8 && (__utf8_scan(v, z2 - v) < 0 || __utf8_scan(z2 + 1, next - z2 - 2) < 0) {
                return false
            }
        } else if kind == 12 {
            if utf8 && __utf8_scan(v + 4, next - v - 17) < 0 {
                return false
            }
        } else if kind == 15 {
            // код с областью: общая длина, строка кода, документ области
            let code_end = __bson_skip(2, v + 4, next)
            if code_end < 0 || __bson_skip(3, code_end, next) != next {
                return false
            }
            if utf8 && __utf8_scan(v + 8, code_end - v - 9) < 0 {
                return false
            }
            if !__bson_check(code_end, next - code_end, depth + 1, false, utf8) {
                return false
            }
        }
        at = next
        index += 1
    }
    return true
}

// Поле key документа [p, p + n): адрес его байта вида или 0 — поля нет или
// документ испорчен раньше него. Ключ сравнивается на месте; значение
// найденного поля целиком внутри документа. Значение — по адресу at + 2 + длина
// ключа.
fn __bson_find(p: int, n: int, key: str) -> int {
    let end = __bson_body(p, n)
    if end == 0 {
        return 0
    }
    let kp = __str_ptr(key)
    let kn = key.byte_len()
    var at = p + 4
    while at < end {
        let z = __bson_zero(at + 1, end)
        if z < 0 {
            return 0
        }
        let next = __bson_skip(load8(at), z + 1, end)
        if next < 0 {
            return 0
        }
        if z - at - 1 == kn && __memeq(at + 1, kp, kn) {
            return at
        }
        at = next
    }
    return 0
}

// Ключ [kp, kp + kn) равен строке name.
fn __bson_key_is(kp: int, kn: int, name: str) -> bool {
    return name.byte_len() == kn && __memeq(kp, __str_ptr(name), kn)
}

fn __bson_kind_name(kind: int) -> str {
    if kind == 1 {
        return "double"
    }
    if kind == 2 {
        return "string"
    }
    if kind == 3 {
        return "document"
    }
    if kind == 4 {
        return "array"
    }
    if kind == 5 {
        return "binary"
    }
    if kind == 7 {
        return "objectId"
    }
    if kind == 8 {
        return "bool"
    }
    if kind == 9 {
        return "date"
    }
    if kind == 10 {
        return "null"
    }
    if kind == 16 {
        return "int32"
    }
    if kind == 17 {
        return "timestamp"
    }
    if kind == 18 {
        return "int64"
    }
    if kind == 19 {
        return "decimal128"
    }
    return "type {kind}"
}

// Тип Khrip по описанию — для текста ошибки.
fn __bson_type_name(d: int) -> str {
    let k = load64(d)
    if k == D_INT {
        return "int"
    }
    if k == D_FLOAT {
        return "float"
    }
    if k == D_BOOL {
        return "bool"
    }
    if k == D_STR {
        return "str"
    }
    if k == D_OPT {
        return __bson_type_name(load64(d + 8)) + "?"
    }
    if k == D_LIST {
        return "[" + __bson_type_name(load64(d + 8)) + "]"
    }
    if k == D_MAP {
        return "map"
    }
    let name: str = __cast(load64(d + 16))
    return name
}

// Путь name.path (path пуст — только name).
fn __bson_join(name: str, path: str) -> str {
    if path == "" {
        return name
    }
    return name + "." + path
}

// Ошибка документа, вложенного по пути prefix: "BSON field 'x' ..." становится
// "BSON field 'prefix.x' ...", другой текст — "BSON field 'prefix' is invalid: текст".
fn __bson_nest_error(prefix: str, error: str) -> str {
    let head = "BSON field '"
    if error.starts_with(head) {
        return head + prefix + "." + error.byte_slice(head.byte_len(), error.byte_len())
    }
    return head + prefix + "' is invalid: " + error
}

// Текст ошибки — в слот json_error() запроса (или программы вне запроса):
// bson_error() — причина последнего неудачного from_bson или bson_get_*.
fn __bson_report(message: str) {
    if load64(__ctx() + CTX_WORKER) != 0 {
        let worker = __w()
        worker.json_err = message
    } else {
        __json_last_err = message
    }
}

// ---- Числа: расширение без потерь (как Go-драйвер) ----

// double — целое из диапазона int64 (NaN не проходит сравнений). Граница 2^63 —
// точное число double; x.to_int() паникует на -2^63, поэтому оно отдельно.
fn __bson_whole(f: float) -> bool {
    let two63 = 9223372036854775808.0
    if !(f >= -two63 && f < two63) {
        return false
    }
    if f == -two63 {
        return true
    }
    return f.to_int().to_float() == f
}

// Целое значение double, для которого __bson_whole.
fn __bson_to_int(f: float) -> int {
    if f == -9223372036854775808.0 {
        return -9223372036854775807 - 1
    }
    return f.to_int()
}

// float хранит int64 v точно.
fn __bson_exact_float(v: int) -> bool {
    if v == -9223372036854775807 - 1 {
        return true
    }
    let f = v.to_float()
    return f < 9223372036854775808.0 && f.to_int() == v
}

// ---- Разбор и проверка ----

fn bson_valid(doc: Bson) -> bool {
    let n = doc.data.byte_len()
    return doc.error == "" && n <= BSON_MAX_BYTES && __bson_check(__str_ptr(doc.data), n, 0, false, true)
}

fn bson_parse(data: str) -> Bson {
    let doc = Bson {
        data, checked: true
    }
    if !bson_valid(doc) {
        return Bson {
            data: "", error: "invalid BSON document"
        }
    }
    return doc
}

// ---- Построитель ----

fn bson_new() -> BsonBuilder {
    let b = BsonBuilder {
        buffer: buf_new(128)
    }
    __bson_u32(b.buffer, 0)
    return b
}

fn __bson_key(b: BsonBuilder, key: str, kind: int, size: int) -> bool {
    if b.error != "" {
        return false
    }
    if key.contains("\0") {
        b.error = "BSON field name contains NUL"
        return false
    }
    if __utf8_scan(__str_ptr(key), key.byte_len()) < 0 {
        b.error = "BSON field name is not UTF-8"
        return false
    }
    if b.keys.has(key) {
        b.error = "BSON field '" + key + "' is duplicated"
        return false
    }
    if size < 0 || size > BSON_MAX_BYTES || key.byte_len() > BSON_MAX_BYTES - size - 2 || b.buffer.len > BSON_MAX_BYTES - size - key.byte_len() - 3 {
        b.error = "BSON document exceeds 16 MiB"
        return false
    }
    b.keys[key] = true
    buf_byte(b.buffer, kind)
    buf_add(b.buffer, key)
    buf_byte(b.buffer, 0)
    return true
}

fn __bson_fail(b: BsonBuilder, key: str, message: str) {
    if b.error != "" {
        return
    }
    if __utf8_scan(__str_ptr(key), key.byte_len()) < 0 {
        b.error = "BSON field name is not UTF-8"
        return
    }
    b.error = "BSON field '" + key + "' " + message
}

fn bson_int(b: BsonBuilder, key: str, value: int) {
    if __bson_key(b, key, 18, 8) {
        __bson_u64(b.buffer, value)
    }
}

fn bson_int32(b: BsonBuilder, key: str, value: int) {
    if value < -2147483648 || value > 2147483647 {
        __bson_fail(b, key, "does not fit int32")
        return
    }
    if __bson_key(b, key, 16, 4) {
        __bson_u32(b.buffer, value)
    }
}

fn bson_float(b: BsonBuilder, key: str, value: float) {
    if __bson_key(b, key, 1, 8) {
        __bson_u64(b.buffer, __cast(value))
    }
}

fn bson_str(b: BsonBuilder, key: str, value: str) {
    if __utf8_scan(__str_ptr(value), value.byte_len()) < 0 {
        __bson_fail(b, key, "is not UTF-8; use BsonBinary for bytes")
        return
    }
    if __bson_key(b, key, 2, value.byte_len() + 5) {
        __bson_u32(b.buffer, value.byte_len() + 1)
        buf_add(b.buffer, value)
        buf_byte(b.buffer, 0)
    }
}

fn bson_bool(b: BsonBuilder, key: str, value: bool) {
    if __bson_key(b, key, 8, 1) {
        if value {
            buf_byte(b.buffer, 1)
        } else {
            buf_byte(b.buffer, 0)
        }
    }
}

fn bson_null(b: BsonBuilder, key: str) {
    __bson_key(b, key, 10, 0)
}

// Вложенный документ годится: без ошибки и проверен (непроверенный проверяется
// сейчас, один раз). → "" или текст ошибки с путём key.
fn __bson_nested(key: str, value: Bson) -> str {
    if value.error != "" {
        return __bson_nest_error(key, value.error)
    }
    if !value.checked && !bson_valid(value) {
        return "BSON field '" + key + "' holds an invalid BSON document"
    }
    return ""
}

fn __bson_doc(b: BsonBuilder, key: str, value: Bson, kind: int) {
    if b.error != "" {
        return
    }
    let bad = __bson_nested(key, value)
    if bad != "" {
        b.error = bad
        return
    }
    if __bson_key(b, key, kind, value.data.byte_len()) {
        buf_add(b.buffer, value.data)
    }
}

fn bson_doc(b: BsonBuilder, key: str, value: Bson) {
    __bson_doc(b, key, value, 3)
}

// Массив документов пишется сразу в буфер построителя: без промежуточного
// документа, словаря ключей и строк индексов.
fn bson_array(b: BsonBuilder, key: str, values: [Bson]) {
    if b.error != "" {
        return
    }
    var size = 5
    for i in 0..values.len() {
        let value = values[i]
        if value.error != "" || (!value.checked && !bson_valid(value)) {
            b.error = __bson_nested(key + "." + i.to_str(), value)
            return
        }
        size += value.data.byte_len() + 12
    }
    if !__bson_key(b, key, 4, size) {
        return
    }
    buf_reserve(b.buffer, size)
    let start = b.buffer.len
    __bson_u32(b.buffer, 0)
    for i in 0..values.len() {
        buf_byte(b.buffer, 3)
        __bson_put_index(b.buffer, i)
        buf_add(b.buffer, values[i].data)
    }
    buf_byte(b.buffer, 0)
    store32(b.buffer.data + start, b.buffer.len - start)
}

fn bson_int_array(b: BsonBuilder, key: str, values: [int]) {
    if !__bson_key(b, key, 4, 5 + values.len() * 21) {
        return
    }
    let start = b.buffer.len
    __bson_u32(b.buffer, 0)
    for i in 0..values.len() {
        buf_byte(b.buffer, 18)
        __bson_put_index(b.buffer, i)
        __bson_u64(b.buffer, values[i])
    }
    buf_byte(b.buffer, 0)
    store32(b.buffer.data + start, b.buffer.len - start)
}

fn bson_binary(b: BsonBuilder, key: str, value: str, subtype: int = 0) {
    if subtype < 0 || subtype > 255 || subtype == 2 {
        __bson_fail(b, key, "has an invalid or legacy binary subtype")
        return
    }
    if __bson_key(b, key, 5, value.byte_len() + 5) {
        __bson_u32(b.buffer, value.byte_len())
        buf_byte(b.buffer, subtype)
        buf_add(b.buffer, value)
    }
}

// 12 байт ObjectId из 24 шестнадцатеричных цифр в raw; false — не цифры.
fn __bson_oid_raw(hex: str, raw: int) -> bool {
    if hex.byte_len() != 24 {
        return false
    }
    for i in 0..24 {
        if __hex_val(hex.byte(i)) < 0 {
            return false
        }
    }
    __unhex(hex, raw)
    return true
}

fn bson_object_id(b: BsonBuilder, key: str, hex: str) {
    let raw = __alloc(12)
    if !__bson_oid_raw(hex, raw) {
        __bson_fail(b, key, "needs 24 hexadecimal digits for an ObjectId")
        return
    }
    if __bson_key(b, key, 7, 12) {
        buf_add_raw(b.buffer, raw, 12)
    }
}

fn bson_date(b: BsonBuilder, key: str, milliseconds: int) {
    if __bson_key(b, key, 9, 8) {
        __bson_u64(b.buffer, milliseconds)
    }
}

fn bson_decimal128(b: BsonBuilder, key: str, bytes: str) {
    if bytes.byte_len() != 16 {
        __bson_fail(b, key, "needs exactly 16 bytes for decimal128")
        return
    }
    if __bson_key(b, key, 19, 16) {
        buf_add(b.buffer, bytes)
    }
}

fn bson_timestamp(b: BsonBuilder, key: str, increment: int, seconds: int) {
    if increment < 0 || increment > 4294967295 || seconds < 0 || seconds > 4294967295 {
        __bson_fail(b, key, "has timestamp parts that do not fit uint32")
        return
    }
    if __bson_key(b, key, 17, 8) {
        __bson_u32(b.buffer, increment)
        __bson_u32(b.buffer, seconds)
    }
}

// Документ из построителя. Каждая часть проверена, когда её добавляли, поэтому
// результат помечен проверенным без нового прохода. Снимок: повторный
// bson_finish или новые поля после него документ не меняют.
fn bson_finish(b: BsonBuilder) -> Bson {
    if b.error != "" {
        return Bson {
            data: "", error: b.error
        }
    }
    let n = b.buffer.len + 1
    if n > BSON_MAX_BYTES {
        return Bson {
            data: "", error: "BSON document exceeds 16 MiB"
        }
    }
    let data = __alloc(n)
    __memcpy(data, b.buffer.data, b.buffer.len)
    store32(data, n)
    store8(data + n - 1, 0)
    return Bson {
        data: __str_new(data, n), checked: true
    }
}

// ---- Чтение полей ----

fn bson_fields(doc: Bson) -> [BsonField] {
    var fields: [BsonField] = []
    let p = __str_ptr(doc.data)
    let end = __bson_body(p, doc.data.byte_len())
    if end == 0 {
        return fields
    }
    var at = p + 4
    while at < end {
        let z = __bson_zero(at + 1, end)
        if z < 0 {
            return []
        }
        let next = __bson_skip(load8(at), z + 1, end)
        if next < 0 {
            return []
        }
        fields.push(BsonField {
            name: __str_new(at + 1, z - at - 1), kind: load8(at), data: __str_new(z + 1, next - z - 1)
        })
        at = next
    }
    return fields
}

fn bson_get(doc: Bson, key: str) -> BsonField? {
    let p = __str_ptr(doc.data)
    let n = doc.data.byte_len()
    let at = __bson_find(p, n, key)
    if at == 0 {
        return none
    }
    let v = at + 2 + key.byte_len()
    let next = __bson_skip(load8(at), v, p + n - 1)
    return BsonField {
        name: key, kind: load8(at), data: __str_new(v, next - v)
    }
}

fn bson_has(doc: Bson, key: str) -> bool {
    return __bson_find(__str_ptr(doc.data), doc.data.byte_len(), key) != 0
}

fn bson_is_null(doc: Bson, key: str) -> bool {
    let at = __bson_find(__str_ptr(doc.data), doc.data.byte_len(), key)
    return at != 0 && load8(at) == 10
}

// Поле для bson_get_*: адрес байта вида или 0. С report причина неудачи
// bson_get_* — в bson_error(); драйвер читает ответы без report, чтобы не
// затирать ошибку пользователя.
fn __bson_lookup(doc: Bson, key: str, report: bool) -> int {
    let at = __bson_find(__str_ptr(doc.data), doc.data.byte_len(), key)
    if at == 0 && report {
        __bson_report("BSON field '" + key + "' is missing")
    }
    return at
}

fn __bson_get_fail(report: bool, key: str, message: str) {
    if report {
        __bson_report("BSON field '" + key + "' " + message)
    }
}

fn __bson_wrong(kind: int, expected: str) -> str {
    return "has an incompatible type: BSON " + __bson_kind_name(kind) + ", expected " + expected
}

// int: Int64, Int32 и целый double из диапазона int64.
fn __bson_get_int(doc: Bson, key: str, report: bool) -> int? {
    let at = __bson_lookup(doc, key, report)
    if at == 0 {
        return none
    }
    let kind = load8(at)
    let v = at + 2 + key.byte_len()
    if kind == 18 {
        return load64(v)
    }
    if kind == 16 {
        return __bson_i32(v)
    }
    if kind == 1 {
        let f: float = __cast(load64(v))
        if __bson_whole(f) {
            return __bson_to_int(f)
        }
        __bson_get_fail(report, key, "holds a double that is not a whole int64")
        return none
    }
    __bson_get_fail(report, key, __bson_wrong(kind, "int"))
    return none
}

fn bson_get_int(doc: Bson, key: str) -> int? {
    return __bson_get_int(doc, key, true)
}

// float: double, Int32 и Int64, которое float хранит точно.
fn bson_get_float(doc: Bson, key: str) -> float? {
    let at = __bson_lookup(doc, key, true)
    if at == 0 {
        return none
    }
    let kind = load8(at)
    let v = at + 2 + key.byte_len()
    if kind == 1 {
        let f: float = __cast(load64(v))
        return f
    }
    if kind == 16 {
        return __bson_i32(v).to_float()
    }
    if kind == 18 {
        let n = load64(v)
        if __bson_exact_float(n) {
            return n.to_float()
        }
        __bson_get_fail(true, key, "holds an int64 that float cannot represent exactly")
        return none
    }
    __bson_get_fail(true, key, __bson_wrong(kind, "float"))
    return none
}

fn __bson_get_str(doc: Bson, key: str, report: bool) -> str? {
    let at = __bson_lookup(doc, key, report)
    if at == 0 {
        return none
    }
    let kind = load8(at)
    if kind != 2 {
        __bson_get_fail(report, key, __bson_wrong(kind, "str"))
        return none
    }
    let v = at + 2 + key.byte_len()
    let n = load32(v) - 1
    if __utf8_scan(v + 4, n) < 0 {
        __bson_get_fail(report, key, "is not valid UTF-8")
        return none
    }
    return __str_new(v + 4, n)
}

fn bson_get_str(doc: Bson, key: str) -> str? {
    return __bson_get_str(doc, key, true)
}

fn __bson_get_bool(doc: Bson, key: str, report: bool) -> bool? {
    let at = __bson_lookup(doc, key, report)
    if at == 0 {
        return none
    }
    let kind = load8(at)
    if kind != 8 || load8(at + 2 + key.byte_len()) > 1 {
        __bson_get_fail(report, key, __bson_wrong(kind, "bool"))
        return none
    }
    return load8(at + 2 + key.byte_len()) == 1
}

fn bson_get_bool(doc: Bson, key: str) -> bool? {
    return __bson_get_bool(doc, key, true)
}

fn __bson_get_doc(doc: Bson, key: str, report: bool) -> Bson? {
    let at = __bson_lookup(doc, key, report)
    if at == 0 {
        return none
    }
    let kind = load8(at)
    if kind != 3 {
        __bson_get_fail(report, key, __bson_wrong(kind, "document"))
        return none
    }
    let v = at + 2 + key.byte_len()
    return Bson {
        data: __str_new(v, load32(v)), checked: doc.checked
    }
}

fn bson_get_doc(doc: Bson, key: str) -> Bson? {
    return __bson_get_doc(doc, key, true)
}

// Массив документов. none — нет поля, не массив или элемент не документ
// (причина — в bson_error()).
fn bson_get_array(doc: Bson, key: str) -> [Bson]? {
    let at = __bson_lookup(doc, key, true)
    if at == 0 {
        return none
    }
    let kind = load8(at)
    if kind != 4 {
        __bson_get_fail(true, key, __bson_wrong(kind, "array"))
        return none
    }
    let p = at + 2 + key.byte_len()
    let end = p + load32(p) - 1
    var out: [Bson] = []
    var e = p + 4
    var i = 0
    while e < end {
        let z = __bson_zero(e + 1, end)
        var next = -1
        if z >= 0 {
            next = __bson_skip(load8(e), z + 1, end)
        }
        if next < 0 {
            __bson_get_fail(true, key, "holds an invalid array")
            return none
        }
        if load8(e) != 3 {
            __bson_get_fail(true, key + "." + i.to_str(), "is a BSON " + __bson_kind_name(load8(e)) + ", not a document")
            return none
        }
        out.push(Bson {
            data: __str_new(z + 1, next - z - 1), checked: doc.checked
        })
        e = next
        i += 1
    }
    return out
}

fn __bson_get_binary(doc: Bson, key: str, report: bool) -> BsonBinary? {
    let at = __bson_lookup(doc, key, report)
    if at == 0 {
        return none
    }
    let kind = load8(at)
    if kind != 5 {
        __bson_get_fail(report, key, __bson_wrong(kind, "binary"))
        return none
    }
    let v = at + 2 + key.byte_len()
    let n = load32(v)
    let subtype = load8(v + 4)
    if subtype == 2 {
        if n < 4 || load32(v + 5) != n - 4 {
            __bson_get_fail(report, key, "holds an invalid binary value")
            return none
        }
        return BsonBinary {
            data: __str_new(v + 9, n - 4), subtype
        }
    }
    return BsonBinary {
        data: __str_new(v + 5, n), subtype
    }
}

fn bson_get_binary(doc: Bson, key: str) -> BsonBinary? {
    return __bson_get_binary(doc, key, true)
}

// ---- ObjectId ----

// Блок генератора ObjectId (общий для потоков): [0, 5) — случайное значение
// процесса, [8] — счётчик.
var __objectid_block: int

// Новый ObjectId — 24 шестнадцатеричные цифры: секунды Unix (4 байта, старшим
// вперёд), случайное значение процесса (5 байт) и счётчик (3 байта) со
// случайного начала, как требует спецификация BSON. Счётчик увеличивается
// атомарно. Гонка первого вызова безвредна: поток, чей блок не остался в
// __objectid_block, выдал свои id со своим случайным значением.
fn object_id() -> str {
    var block = __objectid_block
    if block == 0 {
        block = __mmap(4096)
        __random_bytes(block, 8)
        store64(block + 8, load64(block) >> 40)
        __objectid_block = block
    }
    let count = __xadd(block + 8, 1)
    let t = now()
    let raw = __alloc(16)
    store8(raw, (t >> 24) & 255)
    store8(raw + 1, (t >> 16) & 255)
    store8(raw + 2, (t >> 8) & 255)
    store8(raw + 3, t & 255)
    __memcpy(raw + 4, block, 5)
    store8(raw + 9, (count >> 16) & 255)
    store8(raw + 10, (count >> 8) & 255)
    store8(raw + 11, count & 255)
    return __hex_bytes(raw, 12)
}

// ---- to_bson ----

fn __bson_struct_name(d: int) -> str {
    if load64(d) != D_STRUCT {
        return ""
    }
    return __cast(load64(d + 16))
}

// Ошибка значения поля, ключ которого начинается в o.b по смещению key: путь —
// пока только это имя, вызывающие допишут свои спереди.
fn __bson_out_fail(o: __BsonOut, key: int, message: str) {
    if o.error != "" {
        return
    }
    o.error = message
    let kp = o.b.data + key
    o.path = __str_copy(kp, __bson_zero(kp, o.b.data + o.b.len) - kp)
}

// Документ вложен в поле с ключом по смещению key: при ошибке внутри — имя этого
// поля спереди пути.
fn __bson_out_up(o: __BsonOut, key: int) {
    if o.error != "" {
        let kp = o.b.data + key
        o.path = __bson_join(__str_copy(kp, __bson_zero(kp, o.b.data + o.b.len) - kp), o.path)
    }
}

// Поле: байт вида, ключ [kp, kp + kn), значение v по описанию d. none у поля
// структуры и у записи map пропускается (как spread и PATCH в Khrip и omitempty
// в Go): явный null — только bson_null или $unset. В массиве none — null, чтобы
// не сдвинуть индексы (это делает ветка D_LIST).
fn __bson_out_field(o: __BsonOut, kp: int, kn: int, v: int, d: int, depth: int) {
    var dd = d
    var vv = v
    if load64(dd) == D_OPT {
        if vv == 0 {
            return
        }
        dd = load64(d + 8)
        if __is_scalar(dd) {
            vv = load64(v)
        }
    }
    let at = o.b.len
    buf_reserve(o.b, kn + 2)
    buf_byte(o.b, 0)
    buf_add_raw(o.b, kp, kn)
    buf_byte(o.b, 0)
    let kind = __bson_out_value(o, at + 1, vv, dd, depth)
    store8(o.b.data + at, kind)
}

// Значение по описанию d; ключ поля — в o.b по смещению key. → вид BSON.
fn __bson_out_value(o: __BsonOut, key: int, v: int, d: int, depth: int) -> int {
    let b = o.b
    let kind = load64(d)
    if kind == D_INT {
        __bson_u64(b, v)
        return 18
    }
    if kind == D_BOOL {
        if v != 0 {
            buf_byte(b, 1)
        } else {
            buf_byte(b, 0)
        }
        return 8
    }
    if kind == D_FLOAT {
        __bson_u64(b, v)
        return 1
    }
    if kind == D_STR {
        let s: str = __cast(v)
        let n = s.byte_len()
        if n >= BSON_MAX_BYTES {
            __bson_out_fail(o, key, "exceeds 16 MiB")
            return 2
        }
        if __utf8_scan(__str_ptr(s), n) < 0 {
            __bson_out_fail(o, key, "is not UTF-8; use BsonBinary for bytes")
            return 2
        }
        __bson_u32(b, n + 1)
        buf_add(b, s)
        buf_byte(b, 0)
        return 2
    }
    if kind == D_STRUCT {
        let name = __bson_struct_name(d)
        if name.byte_len() >= 4 && name.byte(0) == 'B' && name.byte(1) == 's' {
            let special = __bson_out_special(o, key, name, v)
            if special != 0 {
                return special
            }
        }
    }
    if depth >= BSON_MAX_DEPTH {
        __bson_out_fail(o, key, "is nested deeper than 64 levels")
        return 3
    }
    if kind == D_STRUCT || kind == D_MAP {
        __bson_out_doc(o, v, d, depth + 1)
        __bson_out_up(o, key)
        return 3
    }
    if kind == D_LIST {
        let start = b.len
        __bson_u32(b, 0)
        let ed = load64(d + 8)
        let bools = load64(ed) == D_BOOL
        let n = load64(v + 8)
        let data = load64(v)
        for i in 0..n {
            if o.error != "" {
                break
            }
            var value = 0
            if bools {
                value = load8(data + i)
            } else {
                value = load64(data + i * 8)
            }
            // ключ — цифры индекса: прямо в буфер, затем значение
            let at = b.len
            buf_byte(b, 0)
            __bson_put_index(b, i)
            if load64(ed) == D_OPT && value == 0 {
                store8(b.data + at, 10)
                continue
            }
            var ev = value
            var edd = ed
            if load64(ed) == D_OPT {
                edd = load64(ed + 8)
                if __is_scalar(edd) {
                    ev = load64(value)
                }
            }
            // вид — после значения: оно может перенести буфер
            let ek = __bson_out_value(o, at + 1, ev, edd, depth + 1)
            store8(b.data + at, ek)
        }
        buf_byte(b, 0)
        store32(b.data + start, b.len - start)
        __bson_out_up(o, key)
        return 4
    }
    if kind == D_SUM {
        let e = __variant_entry(d, v)
        if e == 0 {
            __bson_out_fail(o, key, "holds an invalid variant")
            return 10
        }
        let name: str = __cast(load64(e))
        if load64(d + 24) != 0 {
            __bson_u32(b, name.byte_len() + 1)
            buf_add(b, name)
            buf_byte(b, 0)
            return 2
        }
        // вариант с полями — документ {"type": имя, поля...}
        let start = b.len
        __bson_u32(b, 0)
        buf_byte(b, 2)
        buf_add(b, "type")
        buf_byte(b, 0)
        __bson_u32(b, name.byte_len() + 1)
        buf_add(b, name)
        buf_byte(b, 0)
        __bson_out_fields(o, v, load64(e + 8), depth + 1)
        buf_byte(b, 0)
        store32(b.data + start, b.len - start)
        __bson_out_up(o, key)
        return 3
    }
    __bson_out_fail(o, key, "has a type that BSON cannot hold")
    return 10
}

// Обёртки точных типов BSON и вложенный Bson. → вид или 0 (обычная структура).
fn __bson_out_special(o: __BsonOut, key: int, name: str, v: int) -> int {
    let b = o.b
    if name == "Bson" {
        // готовый документ вкладывается как есть, как в bson_doc
        let doc: Bson = __cast(v)
        if doc.error != "" {
            // исходная ошибка документа — с путём: "BSON field 'путь' сказуемое"
            __bson_out_fail(o, key, "is invalid: " + doc.error)
            let head = "BSON field '"
            if doc.error.starts_with(head) {
                let rest = doc.error.byte_slice(head.byte_len(), doc.error.byte_len())
                if let q = rest.byte_find("' ") {
                    o.path = o.path + "." + rest.byte_slice(0, q)
                    o.error = rest.byte_slice(q + 2, rest.byte_len())
                }
            }
            return 3
        }
        if !doc.checked && !bson_valid(doc) {
            __bson_out_fail(o, key, "holds an invalid BSON document")
            return 3
        }
        buf_add(b, doc.data)
        return 3
    }
    if name == "BsonObjectId" {
        let hex: str = __cast(load64(v))
        buf_reserve(b, 12)
        if !__bson_oid_raw(hex, b.data + b.len) {
            __bson_out_fail(o, key, "needs 24 hexadecimal digits for an ObjectId")
            return 7
        }
        b.len += 12
        return 7
    }
    if name == "BsonDate" {
        __bson_u64(b, load64(v))
        return 9
    }
    if name == "BsonBinary" {
        let data: str = __cast(load64(v))
        let subtype = load64(v + 8)
        if subtype < 0 || subtype > 255 || subtype == 2 {
            __bson_out_fail(o, key, "has an invalid or legacy binary subtype")
            return 5
        }
        if data.byte_len() >= BSON_MAX_BYTES {
            __bson_out_fail(o, key, "exceeds 16 MiB")
            return 5
        }
        __bson_u32(b, data.byte_len())
        buf_byte(b, subtype)
        buf_add(b, data)
        return 5
    }
    if name == "BsonDecimal128" {
        let bytes: str = __cast(load64(v))
        if bytes.byte_len() != 16 {
            __bson_out_fail(o, key, "needs exactly 16 bytes for decimal128")
            return 19
        }
        buf_add(b, bytes)
        return 19
    }
    if name == "BsonTimestamp" {
        let increment = load64(v)
        let seconds = load64(v + 8)
        if increment < 0 || increment > 4294967295 || seconds < 0 || seconds > 4294967295 {
            __bson_out_fail(o, key, "has timestamp parts that do not fit uint32")
            return 17
        }
        __bson_u32(b, increment)
        __bson_u32(b, seconds)
        return 17
    }
    return 0
}

fn __bson_out_fields(o: __BsonOut, v: int, d: int, depth: int) {
    for i in 0..load64(d + 8) {
        if o.error != "" {
            return
        }
        let f = __field(d, i)
        let key: str = __cast(load64(f))
        __bson_out_field(o, __str_ptr(key), key.byte_len(), load64(v + i * 8), load64(f + 16), depth)
    }
}

// Документ из структуры или map[str, T] — на месте, в o.b.
fn __bson_out_doc(o: __BsonOut, v: int, d: int, depth: int) {
    let b = o.b
    let start = b.len
    __bson_u32(b, 0)
    if load64(d) == D_STRUCT {
        __bson_out_fields(o, v, d, depth)
    } else if load64(load64(d + 8)) == D_STR {
        let vd = load64(d + 16)
        let m: map[str, int] = __cast(v)
        for key, value in m {
            if o.error != "" {
                break
            }
            let kp = __str_ptr(key)
            let kn = key.byte_len()
            if __find_byte(kp, kn, 0) < kn {
                o.error = "has a field name with NUL"
                return
            }
            if __utf8_scan(kp, kn) < 0 {
                o.error = "has a field name that is not UTF-8"
                return
            }
            __bson_out_field(o, kp, kn, value, vd, depth)
        }
    } else {
        o.error = "needs a struct or map[str, T] for a BSON document"
        return
    }
    buf_byte(b, 0)
    store32(b.data + start, b.len - start)
}

fn __bson_encode(v: int, d: int) -> Bson {
    let k = load64(d)
    if k != D_STRUCT && !(k == D_MAP && load64(load64(d + 8)) == D_STR) {
        return Bson {
            data: "", error: "BSON root must be a struct or map[str, T]"
        }
    }
    let o = __BsonOut {
        b: buf_new(128)
    }
    __bson_out_doc(o, v, d, 0)
    if o.error == "" && o.b.len > BSON_MAX_BYTES {
        o.error = "exceeds 16 MiB"
    }
    if o.error != "" {
        var message = "BSON document " + o.error
        if o.path != "" {
            message = "BSON field '" + o.path + "' " + o.error
        }
        return Bson {
            data: "", error: message
        }
    }
    // буфер — последний выделенный блок: его хвост возвращается выделителю
    __alloc_trim(o.b.data, o.b.cap, o.b.len)
    return Bson {
        data: __str_new(o.b.data, o.b.len), checked: true
    }
}

// ---- from_bson ----

// Значение вида kind в [p, end) как тип d. При ошибке — 0 и r.error; путь
// дописывают вызывающие (имена полей, индексы массивов).
fn __bson_read(r: __BsonRead, kind: int, p: int, end: int, d: int, depth: int) -> int {
    let dk = load64(d)
    if dk == D_OPT {
        if kind == 10 {
            return 0
        }
        let inner = load64(d + 8)
        let value = __bson_read(r, kind, p, end, inner, depth)
        if r.error != "" {
            return 0
        }
        if __is_scalar(inner) {
            let cell = __alloc(8)
            store64(cell, value)
            return cell
        }
        return value
    }
    if dk == D_INT {
        if kind == 18 {
            return load64(p)
        }
        if kind == 16 {
            return __bson_i32(p)
        }
        if kind == 1 {
            let f: float = __cast(load64(p))
            if __bson_whole(f) {
                return __bson_to_int(f)
            }
            r.error = "holds a double that is not a whole int64"
            return 0
        }
    } else if dk == D_FLOAT {
        if kind == 1 {
            return load64(p)
        }
        if kind == 16 {
            let f = __bson_i32(p).to_float()
            return __cast(f)
        }
        if kind == 18 {
            let n = load64(p)
            if __bson_exact_float(n) {
                let f = n.to_float()
                return __cast(f)
            }
            r.error = "holds an int64 that float cannot represent exactly"
            return 0
        }
    } else if dk == D_BOOL {
        if kind == 8 {
            if load8(p) <= 1 {
                return load8(p)
            }
            r.error = "holds an invalid boolean"
            return 0
        }
    } else if dk == D_STR {
        if kind == 2 {
            let n = load32(p) - 1
            if __utf8_scan(p + 4, n) < 0 {
                r.error = "is not valid UTF-8"
                return 0
            }
            return __cast(__str_new(p + 4, n))
        }
    } else if dk == D_STRUCT {
        let name = __bson_struct_name(d)
        if name.byte_len() >= 4 && name.byte(0) == 'B' && name.byte(1) == 's' {
            let special = __bson_read_special(r, kind, p, end, name)
            if special != 0 || r.error != "" {
                return special
            }
        }
        if kind == 3 {
            return __bson_read_struct(r, p, end, d, depth + 1)
        }
    } else if dk == D_LIST {
        if kind == 4 {
            return __bson_read_list(r, p, end, d, depth + 1)
        }
    } else if dk == D_MAP {
        if kind == 3 && load64(load64(d + 8)) == D_STR {
            return __bson_read_map(r, p, end, d, depth + 1)
        }
    } else if dk == D_SUM {
        return __bson_read_sum(r, kind, p, end, d, depth + 1)
    }
    r.error = __bson_wrong(kind, __bson_type_name(d))
    return 0
}

// Обёртки точных типов BSON и вложенный Bson. → значение или 0 (не подходит).
fn __bson_read_special(r: __BsonRead, kind: int, p: int, end: int, name: str) -> int {
    if name == "Bson" && kind == 3 {
        // вложенный документ как есть: проверяется его структура
        if !__bson_check(p, end - p, 0, false, false) {
            r.error = "holds an invalid BSON document"
            return 0
        }
        return __cast(Bson {
            data: __str_new(p, end - p), checked: true
        })
    }
    if name == "BsonObjectId" && kind == 7 {
        return __cast(BsonObjectId {
            hex: __hex_bytes(p, 12)
        })
    }
    if name == "BsonDate" && kind == 9 {
        return __cast(BsonDate {
            milliseconds: load64(p)
        })
    }
    if name == "BsonBinary" && kind == 5 {
        let n = load32(p)
        let subtype = load8(p + 4)
        if subtype == 2 {
            if n < 4 || load32(p + 5) != n - 4 {
                r.error = "holds an invalid binary value"
                return 0
            }
            return __cast(BsonBinary {
                data: __str_new(p + 9, n - 4), subtype
            })
        }
        return __cast(BsonBinary {
            data: __str_new(p + 5, n), subtype
        })
    }
    if name == "BsonDecimal128" && kind == 19 {
        return __cast(BsonDecimal128 {
            bytes: __str_new(p, 16)
        })
    }
    if name == "BsonTimestamp" && kind == 17 {
        return __cast(BsonTimestamp {
            increment: load32(p), seconds: load32(p + 4)
        })
    }
    return 0
}

fn __bson_read_list(r: __BsonRead, p: int, end: int, d: int, depth: int) -> int {
    if depth > BSON_MAX_DEPTH {
        r.error = "is nested deeper than 64 levels"
        return 0
    }
    let ed = load64(d + 8)
    var size = 8
    if load64(ed) == D_BOOL {
        size = 1
    }
    let xs: [int] = __cast(__list_new(4, size))
    let body = end - 1
    var at = p + 4
    var i = 0
    while at < body {
        let kind = load8(at)
        let z = __bson_zero(at + 1, body)
        var next = -1
        if z >= 0 {
            next = __bson_skip(kind, z + 1, body)
        }
        if next < 0 {
            r.error = "holds an invalid array"
            return 0
        }
        let value = __bson_read(r, kind, z + 1, next, ed, depth)
        if r.error != "" {
            r.path = __bson_join(i.to_str(), r.path)
            return 0
        }
        xs.push(value)
        at = next
        i += 1
    }
    return __cast(xs)
}

// Индекс поля структуры d (n полей) с именем [kp, kp + kn) или -1. Сначала —
// поле hint: обычно поля документа идут в порядке структуры.
fn __bson_field_index(d: int, n: int, kp: int, kn: int, hint: int) -> int {
    if hint < n {
        let name: str = __cast(load64(__field(d, hint)))
        if __bson_key_is(kp, kn, name) {
            return hint
        }
    }
    for i in 0..n {
        let name: str = __cast(load64(__field(d, i)))
        if __bson_key_is(kp, kn, name) {
            return i
        }
    }
    return -1
}

fn __bson_read_struct(r: __BsonRead, p: int, end: int, d: int, depth: int) -> int {
    if depth > BSON_MAX_DEPTH {
        r.error = "is nested deeper than 64 levels"
        return 0
    }
    let n = load64(d + 8)
    let out = __struct_alloc(d)
    let seen = __alloc(n + 1)
    let body = end - 1
    var at = p + 4
    var hint = 0
    while at < body {
        let kind = load8(at)
        let z = __bson_zero(at + 1, body)
        var next = -1
        if z >= 0 {
            next = __bson_skip(kind, z + 1, body)
        }
        if next < 0 {
            r.error = "holds an invalid BSON document"
            return 0
        }
        let i = __bson_field_index(d, n, at + 1, z - at - 1, hint)
        if i >= 0 {
            let f = __field(d, i)
            let name: str = __cast(load64(f))
            if load8(seen + i) != 0 {
                r.error = "is duplicated"
                r.path = name
                return 0
            }
            let fd = load64(f + 16)
            store64(out + i * 8, __bson_read(r, kind, z + 1, next, fd, depth))
            if r.error != "" {
                r.path = __bson_join(name, r.path)
                return 0
            }
            store8(seen + i, 1)
            if kind == 10 && load64(fd) == D_OPT && i < 62 {
                __json_null_mark(out, i)
            }
            hint = i + 1
        }
        at = next
    }
    for i in 0..n {
        if load8(seen + i) != 0 {
            continue
        }
        let f = __field(d, i)
        let dk = load64(f + 24)
        if dk == 1 {
            store64(out + i * 8, load64(f + 32))
        } else if dk == 2 {
            store64(out + i * 8, __list_new(4, load64(f + 32)))
        } else if dk == 3 {
            store64(out + i * 8, __map_new(load64(f + 32)))
        } else if load64(load64(f + 16)) != D_OPT {
            r.error = "is missing"
            r.path = __cast(load64(f))
            return 0
        }
    }
    return out
}

fn __bson_read_map(r: __BsonRead, p: int, end: int, d: int, depth: int) -> int {
    if depth > BSON_MAX_DEPTH {
        r.error = "is nested deeper than 64 levels"
        return 0
    }
    let vd = load64(d + 16)
    let m = __map_new(1)
    let body = end - 1
    var at = p + 4
    while at < body {
        let kind = load8(at)
        let z = __bson_zero(at + 1, body)
        var next = -1
        if z >= 0 {
            next = __bson_skip(kind, z + 1, body)
        }
        if next < 0 {
            r.error = "holds an invalid BSON document"
            return 0
        }
        if __utf8_scan(at + 1, z - at - 1) < 0 {
            r.error = "has a field name that is not valid UTF-8"
            return 0
        }
        let key = __str_new(at + 1, z - at - 1)
        if __map_has(m, __cast(key)) {
            r.error = "is duplicated"
            r.path = key
            return 0
        }
        let value = __bson_read(r, kind, z + 1, next, vd, depth)
        if r.error != "" {
            r.path = __bson_join(key, r.path)
            return 0
        }
        __map_set(m, __cast(key), value)
        at = next
    }
    return m
}

// Вариант: перечисление — строка с именем, вариант с полями — документ с полем
// "type".
fn __bson_read_sum(r: __BsonRead, kind: int, p: int, end: int, d: int, depth: int) -> int {
    var tp = 0
    var tn = -1
    if load64(d + 24) != 0 && kind == 2 {
        tp = p + 4
        tn = load32(p) - 1
    } else if kind == 3 {
        let at = __bson_find(p, end - p, "type")
        if at != 0 && load8(at) == 2 {
            tp = at + 10
            tn = load32(at + 6) - 1
        }
    }
    if tn < 0 {
        r.error = __bson_wrong(kind, __bson_type_name(d))
        return 0
    }
    for i in 0..load64(d + 8) {
        let e = d + 32 + i * 24
        let ename: str = __cast(load64(e))
        if __bson_key_is(tp, tn, ename) {
            if load64(e + 16) != 0 {
                return load64(e + 16)
            }
            if kind != 3 {
                break
            }
            return __bson_read_struct(r, p, end, load64(e + 8), depth)
        }
    }
    r.error = "holds an unknown variant of " + __bson_type_name(d)
    return 0
}

// Ошибка — в слоте json_error() запроса (или программы вне запроса), а не в
// общем состоянии потоков: bson_error() и json_error() описывают последнее
// чтение.
fn __bson_decode(doc: Bson, d: int) -> int {
    let r = __BsonRead {}
    var result = 0
    let p = __str_ptr(doc.data)
    let n = doc.data.byte_len()
    if doc.error != "" {
        r.error = doc.error
    } else if __bson_body(p, n) == 0 {
        r.error = "is invalid"
    } else {
        result = __bson_read(r, 3, p, p + n, d, 0)
    }
    var message = r.error
    if doc.error == "" && r.error != "" {
        message = "BSON document " + r.error
        if r.path != "" {
            message = "BSON field '" + r.path + "' " + r.error
        }
    }
    __bson_report(message)
    if r.error != "" {
        return 0
    }
    return result
}

fn bson_error() -> str {
    return json_error()
}
