// Строки как текст UTF-8: длина, индекс, срезы, поиск, регистр и пробелы в
// символах — то, что видит пользовательский код. Символ — по правилу Go
// (lib/core.kh, «UTF-8 без SIMD»): правильная последовательность — один символ,
// любой другой байт — отдельный символ U+FFFD. Порядок, равенство, contains,
// split и replace с непустым образцом остаются байтовыми: на правильном тексте
// это то же самое.
//
// Обёртки над примитивами SIMD (src/simd.kh): функции с __simd_* не встраиваются
// (src/decl.kh, can_inline), поэтому код примитива — один на программу и только
// в программах, которые до него доходят.

// Кэш строк: 0 — обычный, STRC_OFF — выключен, STRC_STRESS — проверочный
// (KHRIP_STRCACHE=off|stress; читает __simd_init в lib/rt.kh).
var __strc_mode: int
// Таблица символов U+0000–U+07FF (__chars) или 0.
var __chars_tab: int

const STRC_OFF = 1
const STRC_STRESS = 2
// Строки не длиннее STRC_MIN байт не кэшируются: пересчёт стоит ≤ 30 нс.
const STRC_MIN = 256
// Строка короче STRC_BIG байт получает сначала лёгкое место (STRC_LIGHT_N мест,
// ниже), длинная — сразу запись: без неё каждое обращение стоит O(n).
const STRC_BIG = 4096
const STRC_N = 8
// Слова блока кэша; поле записи e — по адресу блок + поле + 8·e.
const STRC_CLOCK = 8
const STRC_LAST = 16
const STRC_HI = 24
const STRC_MRU = 32
const STRC_MEMO = 40
const STRC_LNEXT = 48
const STRC_LLAST = 56
const STRC_LMRU = 64
const STRC_MIDFULL = 72
// факты последней средней строки, у которой нет места: kp, kn, факты
const STRC_FKP = 80
const STRC_FKN = 88
const STRC_FF = 96
// лёгкие места: по STRC_LW байт с STRC_LIGHT
const STRC_LIGHT = 128
const STRC_LIGHT_N = 4
const STRC_LW = 48
const STRC_KP = 320
const STRC_KN = 384
const STRC_CNT = 448
const STRC_VUP = 512
const STRC_IX = 576
const STRC_FAR = 640
const STRC_USE = 704
// курсор c записи: CK + STRC_CUR·c, CB + STRC_CUR·c (c = 0, 1)
const STRC_CK = 768
const STRC_CB = 832
const STRC_CUR = 128
// Факты лёгкого места: число символов + 1 и бит «вся строка правильная».
const STRC_VALID = 0x4000000000000000
// Дальний переход в лёгком месте — больше STRC_LFAR символов; на втором место
// становится записью.
const STRC_LFAR = 64
// Память фактов (STRC_MEMO): STRC_MEMO_N мест по 6 слов — kp, kn, cnt, vup, ix,
// far; у ключа — набор из STRC_MEMO_W мест подряд, номер набора — по хешу (p, n).
const STRC_MEMO_N = 64
const STRC_MEMO_W = 4
// Открытый конец среза: s[a..] передаёт его вместо b.
const TEXT_END = 0x7FFFFFFFFFFFFFFF

// Число символов, если [p, p + n) — правильный UTF-8, иначе -1.
fn __utf8_scan(p: int, n: int) -> int {
    __strc_add(n)
    return __simd_utf8_scan(p, n)
}

// Смещение начала символа k (k >= 0) или n, если символов не больше k. Символ
// начинается в байте 0 и в каждом байте, кроме 10xxxxxx: на правильном UTF-8 это
// точно, на неправильном — нет (там — __utf8_go_skip).
fn __utf8_skip(p: int, n: int, k: int) -> int {
    let r = __simd_utf8_skip(p, n, k)
    __strc_add(r)
    return r
}

// Обходы по правилу Go (lib/core.kh) — со счётом байтов для __strc_scanned.
fn __tx_go_skip(p: int, n: int, k: int) -> int {
    let r = __utf8_go_skip(p, n, k)
    __strc_add(r)
    return r
}

fn __tx_go_count(p: int, n: int) -> int {
    __strc_add(n)
    return __utf8_go_count(p, n)
}

// Сколько байтов этот поток пропустил через проверку, пропуск и обходы: тесты
// проверяют по нему, что работа со строкой не квадратична. Счёт — в контексте
// потока, а не в глобальной переменной: запись в общую строку кэша процессора
// из всех потоков замедлила бы их.
fn __strc_scanned() -> int {
    return load64(__ctx() + CTX_SCANNED)
}

fn __strc_add(n: int) {
    let a = __ctx() + CTX_SCANNED
    store64(a, load64(a) + n)
}

// ---- Кэш строк ----
// Блок STRC_SIZE байт: у запроса — в начале его арены (lib/core.kh,
// __arena_begin), у кода вне арены — в контексте потока (CTX_STRC). Восемь
// записей, ключ записи — адрес и длина байтов строки. Байты под ключом не
// меняются (правило I1 у CTX_PTR), поэтому всё, что узнали о ключе, верно для
// любой строки с тем же ключом: поля, параметры, результаты trim. Записи хранят
// только числа относительно ptr и адрес индекса; по ключу ничего не читают, а
// каждое смещение из записи проверяется перед чтением (__strc_ok).
//
// Раскладка — по массиву на поле, у записи e — слово 8·e в каждом:
//   [0] номер сборки store, [8] часы LRU, [16] 8·e + STRC_CUR·c + 1 — курсор
//       c записи e, который передвинул последний поиск (0 — никакой), [24]
//       сколько записей с начала могут быть заняты (новая запись берёт первое
//       свободное место, поэтому обходить нужно только их), [32] запись + 1,
//       которую последней нашёл __strc_key, [40] память фактов или 0 (ниже),
//       [48] следующее лёгкое место, [56] адрес лёгкого места − блок + 1, курсор
//       которого передвинул последний поиск, [64] адрес − блок лёгкого места,
//       которое последним нашёл __strc_key (0 — никакого), [72] 1 — у строки
//       короче STRC_BIG байт может быть запись (иначе такую ищут только в лёгких
//       местах), [80] [88] [96] — ключ и факты последней средней строки без
//       лёгкого места (её длину узнали, а места она ещё не заняла), [128]
//       лёгкие места (ниже);
//   kp, kn — ключ (kp = 0 — запись свободна);
//   cnt    — число символов + 1 (0 — неизвестно);
//   vup    — [0, vup) — правильный UTF-8, vup — граница символа;
//   ix     — индекс: смещения символов 0, 64, 128, ... (по 8 байт) или 0;
//   use    — отметка LRU; far — сколько было дальних переходов;
//   ck, cb — два курсора: символ ck начинается в байте cb; у второго ck = -1,
//            пока он не нужен. Два курсора — для двух указателей (палиндром).
//
// Лёгкие места: строка короче STRC_BIG байт записи сразу не получает — её ключ
// ложится в лёгкое место: их STRC_LIGHT_N, по два на бит хеша ключа, в паре —
// по очереди (новый ключ вытесняет не тот, что положили последним): [0] kp, [8] kn, [16]
// факты (число символов + 1 | STRC_VALID, если правильна вся строка; 0 —
// неизвестно), [24] ck, [32] cb — один курсор, [40] far. Обращение через лёгкое
// место — без записи: от курсора, если он не дальше цели, иначе от начала;
// правильная строка — пропуском, остальные — проверкой с пропуском
// (__utf8_seek) или обходом по правилу Go. Строке, которую трогают несколько
// раз (длина, символ, срез многих разных полей), этого хватает, и запись — поиск
// места, вытеснение, второй курсор — ей не нужна. Второй дальний переход
// (больше STRC_LFAR символов от опоры: два указателя, вразнобой) делает место
// записью (__strc_promote) с его фактами и курсором. Длине курсор не нужен:
// len() места не занимает, а факты кладёт в слова [80]–[96] блока, откуда их
// возьмёт место, если строку потом спросят о символе.
//
// Память фактов: дальние переходы (far) и индекс (ix) длинной строки
// переживают вытеснение её записи. Без неё строка, которую вытесняют между
// обращениями (девять строк и больше по кругу, длинная строка между восемью
// другими), каждый раз начинала бы с нуля: пересчёт O(n), новый индекс в
// памяти запроса — снова и снова — и проход по порядку O(n²). Память — таблица
// STRC_MEMO_N мест в памяти запроса (арена) или потока; выделяется при первом
// дальнем переходе, пишется при дальнем переходе и при постройке индекса,
// читается, когда у ключа появляется новая запись (__strc_init). Как и записи,
// хранит только числа и адрес индекса, всё проверяется перед чтением; уходит
// вместе с блоком (обнуление блока стирает её адрес). Ключ из памяти фактов
// получает запись сразу, минуя лёгкие места.
//
// KHRIP_STRCACHE=stress: кэшируется всё, кроме пустых строк, сразу, запись
// одна, индекс строится на первом переходе любой длины, а испорченная запись —
// паника, а не тихий сброс.

// Блок кэша или 0: кэш выключен, идёт запись в store или выделитель подменён
// (x509.kh, db.kh). Блок с другим номером сборки store очищается.
fn __strc() -> int {
    if __strc_mode == STRC_OFF {
        return 0
    }
    let c = __ctx()
    var b = load64(c + CTX_ARENA)
    if b != 0 {
        let d = load64(c + CTX_PTR) - b
        if d < STRC_SIZE || d >= ARENA_SIZE {
            return 0
        }
    } else {
        if load64(c + CTX_PSAVE_PTR) != 0 {
            return 0
        }
        b = c + CTX_STRC
    }
    if load64(b) != __store_epoch {
        __memset(b, 0, STRC_SIZE)
        store64(b, __store_epoch)
    }
    return b
}

// Блок кэша для строки из n байт или 0: короткую строку дешевле пересчитать.
fn __strc_for(n: int) -> int {
    if n <= STRC_MIN && (__strc_mode != STRC_STRESS || n == 0) {
        return 0
    }
    return __strc()
}

fn __strc_slots() -> int {
    if __strc_mode == STRC_STRESS {
        return 1
    }
    return STRC_N
}

fn __strc_touch(b: int, e: int) {
    let t = load64(b + STRC_CLOCK) + 1
    store64(b + STRC_CLOCK, t)
    store64(b + STRC_USE + 8 * e, t)
}

// Запись e — для ключа (p, n): факты — из памяти фактов, иначе из лёгкого места
// z (если z не 0; оттуда же первый курсор, а место освобождается), иначе нули;
// первый курсор — на начало, второй не нужен. Сначала ключ обнуляется, последним
// пишется: паника посередине не оставит полузаписи, похожей на настоящую.
fn __strc_init(b: int, e: int, p: int, n: int, z: int) {
    let x = b + 8 * e
    store64(x + STRC_KP, 0)
    var cnt1 = 0
    var vup = 0
    var ix = 0
    var far = 0
    var ck = 0
    var cb = 0
    let y = __strc_memo_find(b, p, n)
    if y != 0 {
        cnt1 = load64(y + 16)
        vup = load64(y + 24)
        ix = load64(y + 32)
        far = load64(y + 40)
    } else if z != 0 {
        let f = load64(z + 16)
        cnt1 = f & (STRC_VALID - 1)
        if f >= STRC_VALID {
            vup = n
        }
    }
    if z != 0 {
        ck = load64(z + 24)
        cb = load64(z + 32)
        store64(z, 0)
    }
    store64(x + STRC_CNT, cnt1)
    store64(x + STRC_VUP, vup)
    store64(x + STRC_IX, ix)
    store64(x + STRC_FAR, far)
    store64(x + STRC_CK, ck)
    store64(x + STRC_CB, cb)
    store64(x + STRC_CK + STRC_CUR, -1)
    store64(x + STRC_CB + STRC_CUR, 0)
    store64(x + STRC_KN, n)
    store64(x + STRC_KP, p)
}

// Набор из STRC_MEMO_W мест ключа (p, n) в памяти фактов (адрес первого) или
// 0, если памяти нет. Хеш — умножением (в библиотеке оно по модулю 2^64),
// старшие биты.
fn __strc_memo_set(b: int, p: int, n: int) -> int {
    let m = load64(b + STRC_MEMO)
    if m == 0 {
        return 0
    }
    let h = (((p ^ (n << 24)) * 0x7F4A7C159E3779B1) >> 40) & (STRC_MEMO_N / STRC_MEMO_W - 1)
    return m + 48 * STRC_MEMO_W * h
}

// Факты ключа (p, n) из памяти: адрес места или 0.
fn __strc_memo_find(b: int, p: int, n: int) -> int {
    var z = __strc_memo_set(b, p, n)
    if z == 0 {
        return 0
    }
    let end = z + 48 * STRC_MEMO_W
    while z < end {
        if load64(z) == p && load64(z + 8) == n {
            return z
        }
        z += 48
    }
    return 0
}

// Запомнить факты записи e ключа (p, n): в место ключа, иначе в первое место
// набора, а прежние места сдвигаются на одно (последнее уходит): набор — по
// давности, и ключи, которые идут по кругу, не выталкивают друг друга, пока их
// в наборе не больше STRC_MEMO_W. Ключ места обнуляется первым и пишется
// последним, как в __strc_init.
fn __strc_remember(b: int, e: int, p: int, n: int) {
    if load64(b + STRC_MEMO) == 0 {
        store64(b + STRC_MEMO, __alloc(48 * STRC_MEMO_N))
    }
    var z = __strc_memo_find(b, p, n)
    if z == 0 {
        z = __strc_memo_set(b, p, n)
        var q = z + 48 * (STRC_MEMO_W - 1)
        while q > z {
            store64(q, 0)
            store64(q + 8, load64(q - 40))
            store64(q + 16, load64(q - 32))
            store64(q + 24, load64(q - 24))
            store64(q + 32, load64(q - 16))
            store64(q + 40, load64(q - 8))
            store64(q, load64(q - 48))
            q -= 48
        }
    }
    let x = b + 8 * e
    store64(z, 0)
    store64(z + 16, load64(x + STRC_CNT))
    store64(z + 24, load64(x + STRC_VUP))
    store64(z + 32, load64(x + STRC_IX))
    store64(z + 40, load64(x + STRC_FAR))
    store64(z + 8, n)
    store64(z, p)
}

// Пара лёгких мест ключа (p, n): номер первого (0 или 2) — по старшему биту хеша.
fn __strc_light_pair(p: int, n: int) -> int {
    return 2 * (((p ^ (n << 24)) * 0x7F4A7C159E3779B1) >> 63 & 1)
}

// Лёгкое место ключа (p, n) (адрес) или 0.
fn __strc_light_find(b: int, p: int, n: int) -> int {
    let z = b + STRC_LIGHT + STRC_LW * __strc_light_pair(p, n)
    if load64(z) == p && load64(z + 8) == n {
        return z
    }
    if load64(z + STRC_LW) == p && load64(z + STRC_LW + 8) == n {
        return z + STRC_LW
    }
    return 0
}

// Ключ (p, n) — в лёгкое место своей пары, которое занимали раньше другого:
// факты неизвестны, курсор — на начале. → адрес места.
fn __strc_light_new(b: int, p: int, n: int) -> int {
    let h = __strc_light_pair(p, n)
    // бит h слова STRC_LNEXT — какое место пары следующее
    let bits = load64(b + STRC_LNEXT)
    let i = h + ((bits >> h) & 1)
    store64(b + STRC_LNEXT, bits ^ (1 << h))
    let z = b + STRC_LIGHT + STRC_LW * i
    store64(z, 0)
    var f = 0
    if load64(b + STRC_FKP) == p && load64(b + STRC_FKN) == n {
        f = load64(b + STRC_FF)
    }
    store64(z + 16, f)
    store64(z + 24, 0)
    store64(z + 32, 0)
    store64(z + 40, 0)
    store64(z + 8, n)
    store64(z, p)
    return z
}

// Число символов + 1 из фактов f лёгкого места или 0 (неизвестно или испорчено).
fn __strc_light_cnt(f: int, n: int) -> int {
    let c1 = f & (STRC_VALID - 1)
    if c1 > n + 1 {
        return 0
    }
    return c1
}

// Смещение символа k (k >= 0) строки (p, n) через лёгкое место z или n, если
// символов не больше k. Опора — курсор места, если он не дальше k, иначе начало;
// курсор — на (k, off), если off < n. Второй дальний переход делает место
// записью.
fn __strc_light_off(b: int, z: int, p: int, n: int, k: int) -> int {
    store64(b + STRC_LLAST, 0)
    let f = load64(z + 16)
    let valid = f >= STRC_VALID
    let c1 = __strc_light_cnt(f, n)
    if c1 != 0 {
        if k >= c1 - 1 {
            return n
        }
        if valid && c1 == n + 1 {
            // ASCII
            return k
        }
    }
    var ak = 0
    var ab = 0
    let ck = load64(z + 24)
    if ck > 0 && ck <= k {
        let cb = load64(z + 32)
        // курсор проверяется: внутри строки, а в правильной — не внутри символа
        if cb > 0 && cb < n && (!valid || (load8(p + cb) & 0xC0) != 0x80) {
            ak = ck
            ab = cb
        }
    }
    var off = 0
    if valid {
        off = ab + __utf8_skip(p + ab, n - ab, k - ak)
    } else {
        let r = __utf8_seek(p + ab, n - ab, k - ak)
        if r >= 0 {
            off = ab + r
        } else {
            off = ab + __tx_go_skip(p + ab, n - ab, k - ak)
        }
    }
    if off < n {
        store64(z + 24, k)
        store64(z + 32, off)
        store64(b + STRC_LLAST, z - b + 1)
    }
    if k - ak > STRC_LFAR {
        let far = load64(z + 40) + 1
        store64(z + 40, far)
        if far >= 2 {
            __strc_promote(b, z, p, n)
        }
    }
    return off
}

// Курсор лёгкого места, который передвинул последний поиск, — дальше на (k, off).
fn __strc_light_move(b: int, p: int, n: int, k: int, off: int) {
    let t = load64(b + STRC_LLAST) - 1
    let z = b + t
    if t >= 0 && load64(z) == p && load64(z + 8) == n {
        store64(z + 24, k)
        store64(z + 32, off)
    }
}

// Лёгкое место z ключа (p, n) — в запись (свободную, следующую или вместо самой
// старой) с его фактами и курсором.
fn __strc_promote(b: int, z: int, p: int, n: int) {
    let m = load64(b + STRC_HI)
    var e = -1
    var old = -1
    var ouse = 0
    var i = 0
    var x = b
    while i < m {
        let kp = load64(x + STRC_KP)
        if kp == 0 {
            if e < 0 {
                e = i
            }
        } else if old < 0 || load64(x + STRC_USE) < ouse {
            old = i
            ouse = load64(x + STRC_USE)
        }
        i += 1
        x += 8
    }
    if e < 0 && m < __strc_slots() {
        e = m
        store64(b + STRC_HI, m + 1)
    }
    if e < 0 {
        e = old
    }
    store64(b + STRC_MIDFULL, 1)
    __strc_init(b, e, p, n, z)
    store64(b + STRC_LLAST, 0)
    store64(b + STRC_MRU, e + 1)
    __strc_touch(b, e)
}

// Смещение off из записи годится строке (p, n): оно внутри строки, а в
// известной правильной части — не внутри символа.
fn __strc_ok(p: int, n: int, vup: int, off: int) -> bool {
    return off == n || (off >= 0 && off < n && (off >= vup || (load8(p + off) & 0xC0) != 0x80))
}

// Испорченная запись (её не очистили вовремя) забывается; в проверочном режиме
// это паника.
fn __strc_drop(b: int, e: int) {
    if __strc_mode == STRC_STRESS {
        __panic_msg("internal: string cache")
    }
    // и в памяти фактов: иначе новая запись ключа взяла бы их снова
    let x = b + 8 * e
    let z = __strc_memo_find(b, load64(x + STRC_KP), load64(x + STRC_KN))
    if z != 0 {
        store64(z, 0)
    }
    store64(x + STRC_KP, 0)
}

// Для длины: как __strc_key, но средней строке без лёгкого места его не
// заводит — ответ -1 (факты — в словах [80]–[96]).
fn __strc_key_len(b: int, p: int, n: int) -> int {
    if n < STRC_BIG && load64(b + STRC_MIDFULL) == 0 && __strc_mode != STRC_STRESS {
        let z0 = b + STRC_LIGHT + STRC_LW * __strc_light_pair(p, n)
        if load64(z0) == p && load64(z0 + 8) == n {
            return -z0
        }
        let z1 = z0 + STRC_LW
        if load64(z1) == p && load64(z1 + 8) == n {
            return -z1
        }
        return -1
    }
    return __strc_key(b, p, n)
}

// Запись ключа (p, n) с проверенными фактами: та, что нашлась в прошлый раз,
// иначе __strc_find. Отрицательный ответ -z — у ключа лёгкое место z.
fn __strc_key(b: int, p: int, n: int) -> int {
    var e = load64(b + STRC_MRU) - 1
    var x = b + 8 * e
    if e < 0 || load64(x + STRC_KP) != p || load64(x + STRC_KN) != n {
        if n < STRC_BIG && load64(b + STRC_MIDFULL) == 0 && __strc_mode != STRC_STRESS {
            // у средних строк записей нет: только лёгкие места (как
            // __strc_light_find и __strc_light_new, без вызовов)
            let h = __strc_light_pair(p, n)
            let z0 = b + STRC_LIGHT + STRC_LW * h
            if load64(z0) == p && load64(z0 + 8) == n {
                return -z0
            }
            let z1 = z0 + STRC_LW
            if load64(z1) == p && load64(z1 + 8) == n {
                return -z1
            }
            return -__strc_light_new(b, p, n)
        }
        // лёгкое место, которое нашлось в прошлый раз
        let lz = load64(b + STRC_LMRU)
        let z = b + lz
        if lz >= STRC_LIGHT && lz < STRC_KP && load64(z) == p && load64(z + 8) == n {
            return -z
        }
        e = __strc_find(b, p, n)
        if e < 0 {
            store64(b + STRC_LMRU, -e - b)
            return e
        }
        x = b + 8 * e
    }
    let v = load64(x + STRC_VUP)
    let c = load64(x + STRC_CNT)
    if v < 0 || v > n || c < 0 || c > n + 1 {
        __strc_drop(b, e)
        return __strc_key(b, p, n)
    }
    __strc_touch(b, e)
    return e
}

// Запись ключа (p, n) среди занятых, иначе его лёгкое место (ответ — минус
// адрес). Новый ключ строки короче STRC_BIG байт получает лёгкое место, а
// длинной и известной памяти фактов — запись: свободную, следующую или вместо
// самой старой.
fn __strc_find(b: int, p: int, n: int) -> int {
    let m = load64(b + STRC_HI)
    var free = -1
    var old = -1
    var ouse = 0
    var e = 0
    var x = b
    while e < m {
        let kp = load64(x + STRC_KP)
        if kp == p && load64(x + STRC_KN) == n {
            store64(b + STRC_MRU, e + 1)
            return e
        }
        if kp == 0 {
            if free < 0 {
                free = e
            }
        } else if old < 0 || load64(x + STRC_USE) < ouse {
            old = e
            ouse = load64(x + STRC_USE)
        }
        e += 1
        x += 8
    }
    let z = __strc_light_find(b, p, n)
    if z != 0 {
        return -z
    }
    if n < STRC_BIG && __strc_mode != STRC_STRESS && __strc_memo_find(b, p, n) == 0 {
        return -__strc_light_new(b, p, n)
    }
    e = free
    if e < 0 && m < __strc_slots() {
        e = m
        store64(b + STRC_HI, m + 1)
    }
    if e < 0 {
        e = old
    }
    if n < STRC_BIG {
        store64(b + STRC_MIDFULL, 1)
    }
    __strc_init(b, e, p, n, 0)
    store64(b + STRC_MRU, e + 1)
    return e
}

// Число символов строки (p, n) с записью e: из записи или одним проходом.
fn __strc_count(b: int, e: int, p: int, n: int) -> int {
    let x = b + 8 * e
    let c1 = load64(x + STRC_CNT)
    if c1 != 0 {
        return c1 - 1
    }
    var c = __utf8_scan(p, n)
    if c >= 0 {
        store64(x + STRC_VUP, n)
    } else {
        c = __tx_go_count(p, n)
    }
    store64(x + STRC_CNT, c + 1)
    return c
}

// Индекс ключа: смещения символов 0, 64, 128, ... — в памяти запроса (арена)
// или потока. 1 МБ кириллицы — около 76 КБ, один раз.
fn __strc_index(b: int, e: int, p: int, n: int) {
    let c = __strc_count(b, e, p, n)
    let x = b + 8 * e
    let valid = load64(x + STRC_VUP) == n
    let m = c / 64 + 1
    let t = __alloc(8 * m)
    var off = 0
    var j = 1
    while j < m {
        if valid {
            off += __utf8_skip(p + off, n - off, 64)
        } else {
            off += __tx_go_skip(p + off, n - off, 64)
        }
        store64(t + 8 * j, off)
        j += 1
    }
    store64(x + STRC_IX, t)
    __strc_remember(b, e, p, n)
}

// Вперёд от границы ab (символ ak) до символа k. Пропуск считает символы по
// первым байтам — это точно на правильном UTF-8 (P3), поэтому часть за vup
// сначала проверяется: правильная, если примыкает к [0, vup), продлевает её,
// а на неправильной идёт обход по правилу Go. От самой vup и дальше проверка и
// пропуск — один проход (__utf8_seek).
fn __strc_fwd(b: int, e: int, p: int, n: int, ak: int, ab: int, k: int) -> int {
    if k == ak {
        return ab
    }
    let x = b + 8 * e
    let vup = load64(x + STRC_VUP)
    if ab >= vup {
        let r = __utf8_seek(p + ab, n - ab, k - ak)
        if r >= 0 {
            if ab == vup {
                store64(x + STRC_VUP, ab + r)
            }
            return ab + r
        }
        return ab + __tx_go_skip(p + ab, n - ab, k - ak)
    }
    let off = ab + __utf8_skip(p + ab, n - ab, k - ak)
    if off <= vup {
        return off
    }
    if __utf8_scan(p + vup, off - vup) >= 0 {
        store64(x + STRC_VUP, off)
        return off
    }
    return ab + __tx_go_skip(p + ab, n - ab, k - ak)
}

// Курсор c записи e — на (k, off) (off < n); он — последний передвинутый.
fn __strc_put(b: int, e: int, c: int, k: int, off: int) {
    let t = 8 * e + STRC_CUR * c
    store64(b + t + STRC_CK, k)
    store64(b + t + STRC_CB, off)
    store64(b + STRC_LAST, t + 1)
}

// Курсор для (k, off), когда шли не от курсора записи e: второй, если он ещё не
// нужен, иначе тот, что ближе к k: дальний ведёт другой указатель (два указателя
// навстречу), и его терять нельзя.
fn __strc_place(b: int, e: int, k: int, off: int) {
    let x = b + 8 * e
    let k1 = load64(x + STRC_CK + STRC_CUR)
    var c = 0
    if k1 < 0 || (k1 - k).abs() < (load64(x + STRC_CK) - k).abs() {
        c = 1
    }
    __strc_put(b, e, c, k, off)
}

// Курсор, который передвинул последний поиск, — дальше на (k, off).
fn __strc_move(b: int, p: int, n: int, k: int, off: int) {
    let t = load64(b + STRC_LAST) - 1
    let x = b + (t & (STRC_CUR - 1))
    if t >= 0 && load64(x + STRC_KP) == p && load64(x + STRC_KN) == n {
        store64(b + t + STRC_CK, k)
        store64(b + t + STRC_CB, off)
    }
}

// Смещение символа k (k >= 0) строки (p, n) с записью e или n, если символов не
// больше k. Опоры: точка индекса, если он есть (не дальше 63 символов), иначе
// начало или конец (если строка правильная и число символов известно); курсоры
// записи — если с них ближе. Путь вперёд стоит k − ak, назад — 8·(ak − k) и
// только в известной правильной части. Дальний переход (путь больше 256
// символов в строке от STRC_BIG байт) отмечается; на втором строится индекс.
// Счёт переходов и индекс помнит память фактов, поэтому записи, которые
// вытесняют, не платят O(n) снова и снова и не строят индекс заново. Курсор — на
// (k, off), если off < n: пропуск не отличает «k = числу символов» от «k больше».
fn __strc_off(b: int, e: int, p: int, n: int, k: int) -> int {
    let x = b + 8 * e
    let vup = load64(x + STRC_VUP)
    let cnt1 = load64(x + STRC_CNT)
    store64(b + STRC_LAST, 0)
    if cnt1 != 0 {
        if k >= cnt1 - 1 {
            return n
        }
        if vup == n && cnt1 == n + 1 {
            // ASCII
            return k
        }
    }
    var ak = 0
    var ab = 0
    var cost = k
    var from = -1
    let ix = load64(x + STRC_IX)
    if ix != 0 {
        ab = load64(ix + 8 * (k >> 6))
        if !__strc_ok(p, n, vup, ab) {
            __strc_drop(b, e)
            return __tx_seek(p, n, k)
        }
        ak = k & ~63
        cost = k - ak
    } else if cnt1 != 0 && vup == n && 8 * (cnt1 - 1 - k) < cost {
        ak = cnt1 - 1
        ab = n
        cost = 8 * (ak - k)
    }
    var c = 0
    var y = x
    while c < 2 && cost > 0 {
        let ck = load64(y + STRC_CK)
        if ck >= 0 {
            let cb = load64(y + STRC_CB)
            if !__strc_ok(p, n, vup, cb) {
                __strc_drop(b, e)
                return __tx_seek(p, n, k)
            }
            var d = -1
            if k >= ck {
                d = k - ck
            } else if cb <= vup {
                d = 8 * (ck - k)
            }
            if d >= 0 && d < cost {
                ak = ck
                ab = cb
                cost = d
                from = c
            }
        }
        c += 1
        y += STRC_CUR
    }
    let stress = __strc_mode == STRC_STRESS
    if ix == 0 && ((stress && cost > 0) || (cost > 256 && n >= STRC_BIG)) {
        let far = load64(x + STRC_FAR) + 1
        store64(x + STRC_FAR, far)
        if far >= 2 || stress {
            __strc_index(b, e, p, n)
            return __strc_off(b, e, p, n, k)
        }
        __strc_remember(b, e, p, n)
    }
    var off = ab
    if k >= ak {
        off = __strc_fwd(b, e, p, n, ak, ab, k)
    } else {
        off = __utf8_back(p, ab, ak - k)
    }
    if off < n {
        if from >= 0 {
            __strc_put(b, e, from, k, off)
        } else {
            __strc_place(b, e, k, off)
        }
    }
    return off
}

// Начало символа на j символов раньше символа в байте o строки p (в правильной
// части): символ начинается с байта не 10xxxxxx. Отдельно — чтобы цикл не
// забирал регистры у вызывающих.
fn __utf8_back(p: int, o0: int, j0: int) -> int {
    var o = o0
    var j = j0
    while j > 0 && o > 0 {
        o -= 1
        while o > 0 && (load8(p + o) & 0xC0) == 0x80 {
            o -= 1
        }
        j -= 1
    }
    __strc_add(o0 - o)
    return o
}

// s[i] вразнобой по правильной строке (p, n) с индексом (запись x — её адрес
// b + 8·e): опора — точка индекса (не дальше 63 символов) или курсор записи,
// если с него ближе (вперёд — i − ck, назад — 8·(ck − i)); строка правильная, и
// пропуск точен. Курсор — сразу на следующий символ: тот, с которого шли, иначе
// второй, если он не нужен, иначе ближний. → смещение символа i или -1, если
// опора испорчена (тогда — общий путь, он её сбросит).
fn __strc_at_ix(b: int, x: int, p: int, n: int, i: int) -> int {
    var ak = i & ~63
    var ab = load64(load64(x + STRC_IX) + 8 * (i >> 6))
    var cost = i - ak
    var from = -1
    let k0 = load64(x + STRC_CK)
    let k1 = load64(x + (STRC_CK + STRC_CUR))
    if cost > 0 && k0 >= 0 {
        var d = 8 * (k0 - i)
        if k0 <= i {
            d = i - k0
        }
        if d < cost {
            ak = k0
            ab = load64(x + STRC_CB)
            cost = d
            from = 0
        }
    }
    if cost > 0 && k1 >= 0 {
        var d = 8 * (k1 - i)
        if k1 <= i {
            d = i - k1
        }
        if d < cost {
            ak = k1
            ab = load64(x + (STRC_CB + STRC_CUR))
            from = 1
        }
    }
    if ab < 0 || ab >= n || (load8(p + ab) & 0xC0) == 0x80 {
        return -1
    }
    var o = ab
    if i >= ak {
        // пропуск — прямо здесь, без обёртки __utf8_skip (это самый частый путь
        // s[i] вразнобой)
        let r = __simd_utf8_skip(p + ab, n - ab, i - ak)
        __strc_add(r)
        o = ab + r
    } else {
        o = __utf8_back(p, ab, ak - i)
    }
    if o >= n {
        return -1
    }
    let w = __tx_lead_width(load8(p + o))
    if w == 0 || o + w > n {
        return -1
    }
    if o + w < n {
        if from < 0 {
            from = 0
            if k1 < 0 || (k1 - i).abs() < (k0 - i).abs() {
                from = 1
            }
        }
        let y = x + STRC_CUR * from
        store64(y + STRC_CK, i + 1)
        store64(y + STRC_CB, o + w)
        store64(b + STRC_LAST, y - b + 1)
    }
    return o
}

// Смещение символа k строки (p, n) без кэша: проверка начала строки и пропуск —
// одним проходом, на неправильном начале — обход по правилу Go.
fn __tx_seek(p: int, n: int, k: int) -> int {
    let off = __utf8_seek(p, n, k)
    if off >= 0 {
        return off
    }
    return __tx_go_skip(p, n, k)
}

// Смещение символа k (k >= 0) по первым байтам, если [0, смещение) — правильный
// UTF-8 (а если символов не больше k — вся строка), иначе -1. С AVX2 — одним
// проходом (проверка идёт только до найденного символа), без него — пропуском и
// проверкой.
fn __utf8_seek(p: int, n: int, k: int) -> int {
    if __simd_level < 2 {
        let off = __utf8_skip(p, n, k)
        if __utf8_scan(p, off) >= 0 {
            return off
        }
        return -1
    }
    let r = __simd_utf8_seek(p, n, k)
    if r >= 0 {
        __strc_add(r)
        return r
    }
    __strc_add(-1 - r)
    return -1
}

// ---- Символы ----

// Таблица символов U+0000–U+07FF: 2048 заголовков по 16 байт, за ними байты
// символов, по 2 на код. Циклы по латинице, греческому, кириллице, ивриту и
// арабскому берут символы отсюда, ничего не выделяя. Строится один раз на
// процесс в постоянной памяти; у глобальных переменных нет адреса для __cas,
// поэтому таблицу публикуют под замком постоянной памяти (__store_rw + 48):
// остаётся первая, построенная одновременно с ней (36 КБ) пропадает.
fn __chars() -> int {
    let t0 = __chars_tab
    if t0 != 0 {
        return t0
    }
    let t = __perm_alloc(36864)
    var cp = 0
    while cp < 2048 {
        let q = t + 32768 + 2 * cp
        if cp < 0x80 {
            store8(q, cp)
            store64(t + 16 * cp + 8, 1)
        } else {
            store8(q, 0xC0 | (cp >> 6))
            store8(q + 1, 0x80 | (cp & 63))
            store64(t + 16 * cp + 8, 2)
        }
        store64(t + 16 * cp, q)
        cp += 1
    }
    __store_rw_init()
    let lock = __store_rw + 48
    __mutex_lock(lock)
    if __chars_tab == 0 {
        __chars_tab = t
    }
    __mutex_unlock(lock)
    return __chars_tab
}

// Символ в байтах [off, off + w) строки с началом p: U+0000–U+07FF — из таблицы,
// остальные (и неправильный байт) — заголовок на байты строки.
fn __tx_char(p: int, off: int, w: int) -> str {
    let c = load8(p + off)
    if c < 0x80 || w == 2 {
        var t = __chars_tab
        if t == 0 {
            t = __chars()
        }
        if c < 0x80 {
            return __cast(t + 16 * c)
        }
        return __cast(t + 16 * (((c & 0x1F) << 6) | (load8(p + off + 1) & 0x3F)))
    }
    return __str_new(p + off, w)
}

// Символ, который начинается в байте off (граница символа, off < длины).
fn __text_char_at(self: str, off: int) -> str {
    let p = __str_ptr(self)
    return __tx_char(p, off, __utf8_width(p, __str_len(self), off))
}

// UTF-8 символа cp — в q → число байтов.
fn __utf8_put(q: int, cp: int) -> int {
    if cp < 0x80 {
        store8(q, cp)
        return 1
    }
    if cp < 0x800 {
        store8(q, 0xC0 | (cp >> 6))
        store8(q + 1, 0x80 | (cp & 63))
        return 2
    }
    if cp < 0x10000 {
        store8(q, 0xE0 | (cp >> 12))
        store8(q + 1, 0x80 | ((cp >> 6) & 63))
        store8(q + 2, 0x80 | (cp & 63))
        return 3
    }
    store8(q, 0xF0 | (cp >> 18))
    store8(q + 1, 0x80 | ((cp >> 12) & 63))
    store8(q + 2, 0x80 | ((cp >> 6) & 63))
    store8(q + 3, 0x80 | (cp & 63))
    return 4
}

// ---- Операции пользовательского кода ----
// Короткие строки (и все, когда кэш выключен) — без кэша: длина — одной
// проверкой со счётом, символ и срез — проверкой начала строки вместе с
// пропуском (__utf8_seek), на неправильном начале — обходом по правилу Go.
// Средние — через лёгкое место, длинные — через запись.

// Ширина символа по первому байту c в правильном UTF-8; 0 — c не первый байт.
fn __tx_lead_width(c: int) -> int {
    if c < 0x80 {
        return 1
    }
    if c < 0xC2 {
        return 0
    }
    if c < 0xE0 {
        return 2
    }
    if c < 0xF0 {
        return 3
    }
    if c < 0xF5 {
        return 4
    }
    return 0
}

// s.len(): число символов. Короткая строка — одной проверкой со счётом; длинная —
// в __text_len_c (отдельно, чтобы короткой не сохранять регистры длинной).
fn __text_len(self: str) -> int {
    let p = __str_ptr(self)
    let n = __str_len(self)
    if n > STRC_MIN || (__strc_mode == STRC_STRESS && n != 0) {
        return __text_len_c(p, n)
    }
    let c = __utf8_scan(p, n)
    if c >= 0 {
        return c
    }
    return __tx_go_count(p, n)
}

// Длина строки (p, n), которую кэш может хранить.
fn __text_len_c(p: int, n: int) -> int {
    let b = __strc()
    if b != 0 {
        let e = __strc_key_len(b, p, n)
        if e >= 0 {
            return __strc_count(b, e, p, n)
        }
        // факты — из лёгкого места или из слов [80]–[96], иначе одним проходом —
        // туда же
        var fa = b + STRC_FF
        if e != -1 {
            fa = 16 - e
        } else if load64(b + STRC_FKP) != p || load64(b + STRC_FKN) != n {
            store64(b + STRC_FKP, 0)
            store64(b + STRC_FF, 0)
            store64(b + STRC_FKN, n)
            store64(b + STRC_FKP, p)
        }
        let c1 = __strc_light_cnt(load64(fa), n)
        if c1 != 0 {
            return c1 - 1
        }
        let c = __utf8_scan(p, n)
        if c >= 0 {
            store64(fa, (c + 1) | STRC_VALID)
            return c
        }
        let g = __tx_go_count(p, n)
        store64(fa, g + 1)
        return g
    }
    let c = __utf8_scan(p, n)
    if c >= 0 {
        return c
    }
    return __tx_go_count(p, n)
}

// s[i]: символ i (строка из одного символа); вне [0, len) — паника.
fn __text_at(self: str, i: int) -> str {
    let p = __str_ptr(self)
    let n = __str_len(self)
    if i < 0 {
        __panic(PANIC_INDEX, "str")
    }
    let b = __strc_for(n)
    var e = -1
    var off = 0
    if b != 0 {
        // запись прошлого поиска. Проход по порядку: её курсор — ровно на i, в
        // известной правильной части. Там граница символа — байт не 10xxxxxx, а
        // ширина — по первому байту; курсор сразу — на следующий символ (как
        // дальше делают __strc_off и __strc_move, только без них). Другой
        // символ правильной строки с индексом — сразу через индекс, без
        // __strc_key
        let t = load64(b + STRC_LAST) - 1
        // y — курсор t (его поля — по адресам y + STRC_CK, y + STRC_CB), x — его
        // запись: её поле f — по адресу x + f
        let y = b + t
        let x = b + (t & (STRC_CUR - 1))
        if t >= 0 && load64(x + STRC_KP) == p && load64(x + STRC_KN) == n {
            var co = -1
            var cw = 0
            if load64(y + STRC_CK) == i {
                co = load64(y + STRC_CB)
                let vup = load64(x + STRC_VUP)
                if co >= 0 && co < vup && vup <= n {
                    cw = __tx_lead_width(load8(p + co))
                    if cw > 0 && co + cw <= vup {
                        if co + cw < n {
                            store64(y + STRC_CK, i + 1)
                            store64(y + STRC_CB, co + cw)
                        }
                    } else {
                        co = -1
                    }
                } else {
                    co = -1
                }
            } else if load64(x + STRC_IX) != 0 && load64(x + STRC_VUP) == n && i < load64(x + STRC_CNT) - 1 {
                co = __strc_at_ix(b, x, p, n, i)
                if co >= 0 {
                    cw = __tx_lead_width(load8(p + co))
                }
            }
            if co >= 0 {
                let clock = load64(b + STRC_CLOCK) + 1
                store64(b + STRC_CLOCK, clock)
                store64(x + STRC_USE, clock)
                return __tx_char(p, co, cw)
            }
        }
        // то же у лёгкого места, если строка правильная целиком
        let lt = load64(b + STRC_LLAST) - 1
        let z = b + lt
        if lt >= 0 && load64(z + 24) == i && load64(z) == p && load64(z + 8) == n && load64(z + 16) >= STRC_VALID {
            let o = load64(z + 32)
            if o >= 0 && o < n {
                let w = __tx_lead_width(load8(p + o))
                if w > 0 && o + w <= n {
                    if o + w < n {
                        store64(z + 24, i + 1)
                        store64(z + 32, o + w)
                    }
                    return __tx_char(p, o, w)
                }
            }
        }
        e = __strc_key(b, p, n)
        if e >= 0 {
            let x0 = b + 8 * e
            if load64(x0 + STRC_IX) != 0 && load64(x0 + STRC_VUP) == n && i < load64(x0 + STRC_CNT) - 1 {
                let o = __strc_at_ix(b, x0, p, n, i)
                if o >= 0 {
                    return __tx_char(p, o, __tx_lead_width(load8(p + o)))
                }
            }
            off = __strc_off(b, e, p, n, i)
        } else {
            off = __strc_light_off(b, -e, p, n, i)
        }
    } else {
        off = __tx_seek(p, n, i)
    }
    if off >= n {
        __panic(PANIC_INDEX, "str")
    }
    let w = __utf8_width(p, n, off)
    if e >= 0 {
        // курсор — на следующий символ; правильный символ сразу за vup
        // продлевает правильную часть
        let xe = b + 8 * e
        if load64(xe + STRC_VUP) == off && (w > 1 || load8(p + off) < 0x80) {
            store64(xe + STRC_VUP, off + w)
        }
        if off + w < n {
            __strc_move(b, p, n, i + 1, off + w)
        }
    } else if b != 0 && off + w < n {
        // курсор лёгкого места — на следующий символ (если место не стало записью)
        let zl = -e
        if load64(zl) == p && load64(zl + 8) == n {
            store64(zl + 24, i + 1)
            store64(zl + 32, off + w)
        }
    }
    return __tx_char(p, off, w)
}

// s[a..b]: символы [a, b), границы прижаты к [0, len]; b = TEXT_END — до конца.
// Весь диапазон — сама строка, пустой — "".
fn __text_slice(self: str, a0: int, b0: int) -> str {
    let p = __str_ptr(self)
    let n = __str_len(self)
    var a = a0
    if a < 0 {
        a = 0
    }
    if b0 <= a {
        return ""
    }
    var oa = 0
    var ob = n
    let b = __strc_for(n)
    var e = -1
    if b != 0 {
        e = __strc_key(b, p, n)
    }
    if e >= 0 {
        oa = __strc_off(b, e, p, n, a)
        if oa >= n {
            return ""
        }
        let x = b + 8 * e
        let c1 = load64(x + STRC_CNT)
        if b0 != TEXT_END && (c1 == 0 || b0 < c1 - 1) {
            if c1 == n + 1 && load64(x + STRC_VUP) == n {
                ob = b0
            } else {
                ob = __strc_fwd(b, e, p, n, a, oa, b0)
                if ob < n {
                    __strc_move(b, p, n, b0, ob)
                }
            }
        }
    } else if b != 0 {
        // лёгкое место: начало — через него, конец — вперёд от начала
        let z = -e
        oa = __strc_light_off(b, z, p, n, a)
        if oa >= n {
            return ""
        }
        let f = load64(z + 16)
        let c1 = __strc_light_cnt(f, n)
        if b0 != TEXT_END && (c1 == 0 || b0 < c1 - 1) {
            if f >= STRC_VALID && c1 == n + 1 {
                ob = b0
            } else {
                if f >= STRC_VALID {
                    ob = oa + __utf8_skip(p + oa, n - oa, b0 - a)
                } else {
                    ob = oa + __tx_seek(p + oa, n - oa, b0 - a)
                }
                if ob < n {
                    __strc_light_move(b, p, n, b0, ob)
                }
            }
        }
    } else if b0 != TEXT_END {
        // конец первым: проверка [0, ob) вместе с пропуском — один проход, а
        // начало — пропуск в уже проверенной части
        let r = __utf8_seek(p, n, b0)
        if r >= 0 {
            ob = r
            oa = __utf8_skip(p, r, a)
        } else {
            oa = __tx_go_skip(p, n, a)
            if oa < n {
                ob = oa + __tx_go_skip(p + oa, n - oa, b0 - a)
            }
        }
        if oa >= n {
            return ""
        }
    } else {
        oa = __tx_seek(p, n, a)
        if oa >= n {
            return ""
        }
    }
    if oa == 0 && ob == n {
        return self
    }
    if ob <= oa {
        return ""
    }
    return __str_new(p + oa, ob - oa)
}

// s.find(sub): индекс символа, с которого начинается первое вхождение, или none.
// Ищутся байты; правильный непустой образец совпадает только на границах
// символов (P4), и от ближайшего курсора остаётся досчитать символы.
fn __text_find(self: str, sub: str) -> int? {
    let bi = __str_byte_find_from(self, sub, 0)
    if bi < 0 {
        return none
    }
    let p = __str_ptr(self)
    let n = __str_len(self)
    let b = __strc_for(n)
    var e = -1
    if b != 0 {
        e = __strc_key(b, p, n)
    }
    if e < 0 {
        // без кэша или через лёгкое место: от его курсора, если он не дальше bi
        var ck = 0
        var cb = 0
        var z = 0
        if b != 0 {
            z = -e
            let f = load64(z + 16)
            if f >= STRC_VALID && __strc_light_cnt(f, n) == n + 1 {
                return bi
            }
            let k1 = load64(z + 24)
            let b1 = load64(z + 32)
            if k1 > 0 && b1 > 0 && b1 <= bi && b1 < n && (f < STRC_VALID || (load8(p + b1) & 0xC0) != 0x80) {
                ck = k1
                cb = b1
            }
        }
        var c = __utf8_scan(p + cb, bi - cb)
        if c < 0 {
            c = __tx_go_count(p + cb, bi - cb)
        }
        let k = ck + c
        // курсор — только на границу символа: неправильный образец ("\x80")
        // может совпасть внутри символа
        let sn = __str_len(sub)
        if z != 0 && bi < n && sn > 0 && __utf8_scan(__str_ptr(sub), sn) >= 0 {
            store64(z + 24, k)
            store64(z + 32, bi)
            store64(b + STRC_LLAST, z - b + 1)
        }
        return k
    }
    let x = b + 8 * e
    let vup = load64(x + STRC_VUP)
    if vup == n && load64(x + STRC_CNT) == n + 1 {
        return bi
    }
    // курсор записи с наибольшим cb <= bi
    var ck = 0
    var cb = 0
    var from = -1
    var c = 0
    var y = x
    while c < 2 {
        let k1 = load64(y + STRC_CK)
        if k1 >= 0 {
            let b1 = load64(y + STRC_CB)
            if !__strc_ok(p, n, vup, b1) {
                __strc_drop(b, e)
                return __text_find(self, sub)
            }
            if b1 <= bi && b1 >= cb {
                ck = k1
                cb = b1
                from = c
            }
        }
        c += 1
        y += STRC_CUR
    }
    var cnt = __utf8_scan(p + cb, bi - cb)
    if cnt >= 0 {
        if cb <= vup && bi > vup {
            store64(x + STRC_VUP, bi)
        }
    } else {
        cnt = __tx_go_count(p + cb, bi - cb)
    }
    let k = ck + cnt
    // курсор — только на границу символа: неправильный образец ("\x80")
    // может совпасть внутри символа
    let sp = __str_ptr(sub)
    let sn = __str_len(sub)
    if bi < n && sn > 0 && __utf8_scan(sp, sn) >= 0 {
        if from >= 0 {
            __strc_put(b, e, from, k, bi)
        } else {
            __strc_place(b, e, k, bi)
        }
    }
    return k
}

// s.split(sep): с пустым sep — список символов (как в Go и JS), иначе по байтам.
fn __text_split(self: str, sep: str) -> [str] {
    if __str_len(sep) != 0 {
        return __str_split(self, sep)
    }
    var parts: [str] = []
    let p = __str_ptr(self)
    let n = __str_len(self)
    var off = 0
    while off < n {
        let w = __utf8_width(p, n, off)
        parts.push(__tx_char(p, off, w))
        off += w
    }
    return parts
}

// s.replace(old, new): с пустым old — new между символами и по краям (как в
// Python и Go: "".replace("", "-") — "-"), иначе по байтам.
fn __text_replace(self: str, old: str, new: str) -> str {
    if __str_len(old) != 0 {
        return __str_replace(self, old, new)
    }
    let p = __str_ptr(self)
    let n = __str_len(self)
    let b = buf_new(n + 2 * __str_len(new) + 16)
    buf_add(b, new)
    var off = 0
    while off < n {
        let w = __utf8_width(p, n, off)
        buf_add_raw(b, p + off, w)
        buf_add(b, new)
        off += w
    }
    return buf_str(b)
}

// White_Space (PropList.txt): \t \n \v \f \r, пробел, U+0085, U+00A0, U+1680,
// U+2000–200A, U+2028, U+2029, U+202F, U+205F, U+3000 — 25 кодов;
// tools/unicode_tables.kh сверяет список с UCD. ZWSP и BOM — не пробелы (как в
// Go и C#).
fn __cp_is_space(cp: int) -> bool {
    if cp < 0x80 {
        return cp == ' ' || (cp >= 9 && cp <= 13)
    }
    if cp < 0x2000 {
        return cp == 0x85 || cp == 0xA0 || cp == 0x1680
    }
    return cp <= 0x200A || cp == 0x2028 || cp == 0x2029 || cp == 0x202F || cp == 0x205F || cp == 0x3000
}

// Ширина пробельного символа в байте i или 0. Первые байты пробелов вне ASCII —
// только C2, E1, E2 и E3.
fn __tx_space_at(p: int, n: int, i: int) -> int {
    let c = load8(p + i)
    if c < 0x80 {
        if c == ' ' || (c >= 9 && c <= 13) {
            return 1
        }
        return 0
    }
    if c != 0xC2 && (c < 0xE1 || c > 0xE3) {
        return 0
    }
    let w = __utf8_width(p, n, i)
    if w > 1 && __cp_is_space(__utf8_decode(p, n, i)) {
        return w
    }
    return 0
}

// s.trim(): без White_Space по краям; если обрезать нечего — сама строка.
fn __text_trim(self: str) -> str {
    let p = __str_ptr(self)
    let n = __str_len(self)
    var a = 0
    while a < n {
        let w = __tx_space_at(p, n, a)
        if w == 0 {
            break
        }
        a += w
    }
    var b = n
    while b > a {
        // начало последнего символа: назад через байты 10xxxxxx, не дальше 3
        var q = b - 1
        while q > a && q > b - 4 && (load8(p + q) & 0xC0) == 0x80 {
            q -= 1
        }
        let w = __tx_space_at(p, b, q)
        if w == 0 || q + w != b {
            break
        }
        b = q
    }
    if a == 0 && b == n {
        return self
    }
    return __str_new(p + a, b - a)
}

fn __text_lower(self: str) -> str {
    return __tx_case(self, false)
}

fn __text_upper(self: str) -> str {
    return __tx_case(self, true)
}

// Простое отображение регистра (UnicodeData.txt, поля 12 и 13; как в Go и C#):
// ß остаётся, "İ".lower() — "i", без правила конечной сигмы. Сначала ищется
// первый символ, который меняется: с AVX2 — блоками по 32 байта, пока в них
// только ASCII и кириллица U+0400–045F (__tx_case_run), а блок, который не
// прошёл, и строки короче 32 байт — по символам: слова по 8 байт ASCII — одной
// проверкой на слово (SWAR на 64 битах: в библиотеке сложение по модулю 2^64, а
// в байтах < 0x80 переносов между байтами нет), кириллица (D0 xx, D1 80–9F) —
// арифметикой на байтах, остальные символы — через __case_map. Если такого нет —
// сама строка, без выделения. Иначе копия — так же, блоками и по символам:
// отображения растут не больше чем в 1,5 раза (22 из 2 байт в 3, это проверяет
// tools/unicode_tables.kh), поэтому 1,5·n + 4 байт хватает; лишний хвост
// возвращается __alloc_trim. Неправильные байты копируются как есть.
fn __tx_case(self: str, up: bool) -> str {
    let p = __str_ptr(self)
    let n = __str_len(self)
    // буквы lo..lo+25; в каждом байте below = 0x80 − lo, past = 0x80 − lo − 26:
    // старший бит байта в (x + below) & ~(x + past) — буква
    var lo = 'A'
    var below = 0x3F3F3F3F3F3F3F3F
    var past = 0x2525252525252525
    if up {
        lo = 'a'
        below = 0x1F1F1F1F1F1F1F1F
        past = 0x0505050505050505
    }
    let high = ~0x7F7F7F7F7F7F7F7F
    var i = 0
    // блок, на котором остановились блоки, и всё до by_char — по символам
    var by_char = 0
    while i < n {
        if i >= by_char && n - i >= 32 {
            i += __tx_case_run(0, p + i, n - i, up)
            if i >= n {
                break
            }
            by_char = i + 32
        }
        let c = load8(p + i)
        if c < 0x80 {
            if i + 8 <= n {
                let x = load64(p + i)
                if (x & high) == 0 {
                    if ((x + below) & ~(x + past) & high) != 0 {
                        break
                    }
                    i += 8
                    continue
                }
            }
            if c >= lo && c < lo + 26 {
                break
            }
            i += 1
            continue
        }
        if c >= 0xC2 && c <= 0xDF && i + 1 < n && (load8(p + i + 1) & 0xC0) == 0x80 {
            let cp = ((c & 0x1F) << 6) | (load8(p + i + 1) & 0x3F)
            if cp >= 0x400 && cp < 0x460 {
                // как в __case_map: строчные — U+0430–045F
                if (cp >= 0x430) == up {
                    break
                }
            } else if __case_map(cp, up) != cp {
                break
            }
            i += 2
            continue
        }
        let w = __utf8_width(p, n, i)
        if w > 1 {
            let cp = __utf8_decode(p, n, i)
            if __case_map(cp, up) != cp {
                break
            }
        }
        i += w
    }
    if i >= n {
        return self
    }
    let cap = n + n / 2 + 4
    let q = __alloc(cap)
    __memcpy(q, p, i)
    var j = i
    by_char = 0
    while i < n {
        if i >= by_char && n - i >= 32 {
            let m = __tx_case_run(q + j, p + i, n - i, up)
            i += m
            j += m
            if i >= n {
                break
            }
            by_char = i + 32
        }
        var c = load8(p + i)
        if c < 0x80 {
            if i + 8 <= n {
                let x = load64(p + i)
                if (x & high) == 0 {
                    // сдвиг знаковый: 0x20 — маской после него
                    store64(q + j, x ^ ((((x + below) & ~(x + past) & high) >> 2) & 0x2020202020202020))
                    i += 8
                    j += 8
                    continue
                }
            }
            if c >= lo && c < lo + 26 {
                c = c ^ 32
            }
            store8(q + j, c)
            i += 1
            j += 1
            continue
        }
        if c >= 0xC2 && c <= 0xDF && i + 1 < n && (load8(p + i + 1) & 0xC0) == 0x80 {
            // два байта — в два байта, без вызовов разбора
            var m = ((c & 0x1F) << 6) | (load8(p + i + 1) & 0x3F)
            if m >= 0x400 && m < 0x460 {
                // кириллица — арифметикой, как в __case_map
                if up {
                    if m >= 0x450 {
                        m -= 0x50
                    } else if m >= 0x430 {
                        m -= 0x20
                    }
                } else if m < 0x410 {
                    m += 0x50
                } else if m < 0x430 {
                    m += 0x20
                }
            } else {
                m = __case_map(m, up)
            }
            if m >= 0x80 && m < 0x800 {
                store8(q + j, 0xC0 | (m >> 6))
                store8(q + j + 1, 0x80 | (m & 63))
                j += 2
            } else {
                j += __utf8_put(q + j, m)
            }
            i += 2
            continue
        }
        let w = __utf8_width(p, n, i)
        if w == 1 {
            store8(q + j, c)
            j += 1
        } else {
            j += __utf8_put(q + j, __case_map(__utf8_decode(p, n, i), up))
        }
        i += w
    }
    __alloc_trim(q, cap, j + 1)
    return __str_new(q, j)
}

// Регистр ASCII и кириллицы U+0400–045F блоками по 32 байта (src/simd.kh,
// __simd_case): сколько байтов с начала [p, p + n) обработано (в q — их
// отображение); q = 0 — только проверка: обработанное не меняется. Без AVX2 и
// при n < 32 — 0. Если ответ стоит на первом байте пары, этот байт в q уже
// записан — его перепишет посимвольный проход.
fn __tx_case_run(q: int, p: int, n: int, up: bool) -> int {
    if __simd_level < 2 {
        return 0
    }
    var u = 0
    if up {
        u = 1
    }
    return __simd_case(q, p, n, u)
}

// Простое отображение регистра кода cp: в верхний (up) или нижний. ASCII и
// кириллица U+0400–045F — арифметикой, остальное — двухуровневой таблицей
// lib/text_tables.kh: номер пары разностей pi = s2[s1[cp >> 6]·64 + (cp & 63)],
// pi = 0 — без отображения, иначе cp + разность пары (i32: нижний, верхний).
fn __case_map(cp: int, up: bool) -> int {
    if cp < 0x80 {
        if up {
            if cp >= 'a' && cp <= 'z' {
                return cp - 32
            }
        } else if cp >= 'A' && cp <= 'Z' {
            return cp + 32
        }
        return cp
    }
    if cp >= 0x400 && cp < 0x460 {
        if up {
            if cp >= 0x450 {
                return cp - 0x50
            }
            if cp >= 0x430 {
                return cp - 0x20
            }
        } else {
            if cp < 0x410 {
                return cp + 0x50
            }
            if cp < 0x430 {
                return cp + 0x20
            }
        }
        return cp
    }
    if cp >= CASE_END {
        return cp
    }
    let t = __case_tab()
    let pi = load8(t + CASE_S2 + load8(t + (cp >> 6)) * 64 + (cp & 63))
    if pi == 0 {
        return cp
    }
    var a = t + CASE_PAL + 8 * pi
    if up {
        a += 4
    }
    return cp + ((load32(a) << 32) >> 32)
}

// \w в регулярных выражениях: буквы (L), знаки (M), десятичные цифры (Nd) и
// соединители (Pc) — как \w у C# и [\p{L}\p{M}\p{Nd}\p{Pc}] у Go и RE2. Выше
// WORD_END таких кодов нет, кроме селекторов вариантов U+E0100–E01EF; ниже —
// бит (cp & 127) в 16-байтовом блоке s2[s1[cp >> 7]] таблицы lib/text_tables.kh.
fn __cp_is_word(cp: int) -> bool {
    if cp < 0x80 {
        return (cp >= 'a' && cp <= 'z') || (cp >= 'A' && cp <= 'Z') || (cp >= '0' && cp <= '9') || cp == '_'
    }
    if cp >= WORD_END {
        return cp >= 0xE0100 && cp <= 0xE01EF
    }
    let t = __word_tab()
    let blk = load8(t + (cp >> 7))
    return ((load8(t + WORD_S2 + 16 * blk + ((cp & 127) >> 3)) >> (cp & 7)) & 1) != 0
}

// Строка, в которой каждый неправильный байт (правило Go) заменён на U+FFFD
// (EF BF BD); правильная — сама.
fn __utf8_sanitize(self: str) -> str {
    let p = __str_ptr(self)
    let n = __str_len(self)
    if __utf8_scan(p, n) >= 0 {
        return self
    }
    let b = buf_new(n + 16)
    var off = 0
    while off < n {
        let bad = off + __utf8_bad_at(p + off, n - off)
        buf_add_raw(b, p + off, bad - off)
        if bad < n {
            buf_utf8(b, 0xFFFD)
        }
        off = bad + 1
    }
    return buf_str(b)
}

// Порядок s и однобайтового литерала ASCII c (s < 'a' и т. п.): <0, 0 или >0,
// как __str_cmp — по байтам.
fn __text_cmp1(self: str, c: int) -> int {
    let n = __str_len(self)
    if n == 0 {
        return -1
    }
    let d = load8(__str_ptr(self)) - c
    if d != 0 {
        return d
    }
    return n - 1
}
