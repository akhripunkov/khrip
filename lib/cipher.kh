// Шифрование с проверкой целостности (AEAD) для TLS 1.3: AES-128-GCM,
// AES-256-GCM и ChaCha20-Poly1305. AES и GHASH — инструкции процессора
// (AES-NI, PCLMULQDQ; машинный код в src/simd.kh), ChaCha20 — SSE2, Poly1305 —
// обычный код на 26-битных частях числа (без переполнений int).

// Таблица замены AES (S-box): нужна только для развёртки ключа.
var __aes_sbox: int

fn __aes_sbox_table() -> int {
    if __aes_sbox != 0 {
        return __aes_sbox
    }
    let hex = ""
    let t = __mmap(4096)
    for i in 0..256 {
        store8(t + i, __hex_val(hex.byte(2 * i)) * 16 + __hex_val(hex.byte(2 * i + 1)))
    }
    __aes_sbox = t
    return t
}

// Ключи раундов AES (FIPS 197, 5.2) подряд байтами; klen — 16 или 32.
fn __aes_expand(key: int, klen: int) -> int {
    let sb = __aes_sbox_table()
    let nk = klen / 4
    let rounds = nk + 6
    let total = 4 * (rounds + 1)
    let ks = __alloc(total * 4)
    __memcpy(ks, key, klen)
    var rcon = 1
    for i in nk..total {
        let p = ks + (i - 1) * 4
        var t0 = load8(p)
        var t1 = load8(p + 1)
        var t2 = load8(p + 2)
        var t3 = load8(p + 3)
        if i % nk == 0 {
            let x = t0
            t0 = load8(sb + t1) ^ rcon
            t1 = load8(sb + t2)
            t2 = load8(sb + t3)
            t3 = load8(sb + x)
            rcon = rcon << 1
            if rcon >= 256 {
                rcon = rcon ^ 0x11b
            }
        } else if nk == 8 && i % 8 == 4 {
            t0 = load8(sb + t0)
            t1 = load8(sb + t1)
            t2 = load8(sb + t2)
            t3 = load8(sb + t3)
        }
        let q = ks + (i - nk) * 4
        let o = ks + i * 4
        store8(o, load8(q) ^ t0)
        store8(o + 1, load8(q + 1) ^ t1)
        store8(o + 2, load8(q + 2) ^ t2)
        store8(o + 3, load8(q + 3) ^ t3)
    }
    return ks
}

// ---- AEAD ----

const AEAD_AES128 = 1
const AEAD_AES256 = 2
const AEAD_CHACHA = 3

// Ключ AEAD: шифр, ключи раундов AES или ключ ChaCha20, ключ GHASH.
type __Aead {
    kind: int
    ks: int
    rounds: int
    // для GCM: H с переставленными байтами и маска pshufb (32 байта)
    gh: int
}

fn __aead_new(kind: int, key: int) -> __Aead {
    if kind == AEAD_CHACHA {
        let k = __alloc(32)
        __memcpy(k, key, 32)
        return __Aead { kind, ks: k, rounds: 0, gh: 0 }
    }
    var klen = 16
    if kind == AEAD_AES256 {
        klen = 32
    }
    let ks = __aes_expand(key, klen)
    let rounds = klen / 4 + 6
    // H = AES(0); для PCLMULQDQ — байты в обратном порядке, за ними маска
    let zero = __alloc(16)
    let ctr = __alloc(16)
    let h = __alloc(16)
    __aes_ctr(ks, rounds * 16, ctr, zero, h, 1)
    let gh = __alloc(32)
    for i in 0..16 {
        store8(gh + i, load8(h + 15 - i))
        store8(gh + 16 + i, 15 - i)
    }
    return __Aead { kind, ks, rounds, gh }
}

// Длина ключа шифра в байтах.
fn __aead_key_len(kind: int) -> int {
    if kind == AEAD_AES128 {
        return 16
    }
    return 32
}

// GHASH данных [p, p + n) в x: неполный последний блок дополняется нулями.
fn __ghash_bytes(gh: int, x: int, p: int, n: int) {
    let full = n / 16
    __ghash(gh, x, p, full)
    let rest = n - full * 16
    if rest > 0 {
        let b = __alloc(16)
        __memcpy(b, p + full * 16, rest)
        __ghash(gh, x, b, 1)
    }
}

// AES-CTR от счётчика ctr (меняется на месте) для n байт.
fn __aes_ctr_bytes(a: __Aead, ctr: int, src: int, dst: int, n: int) {
    let full = n / 16
    __aes_ctr(a.ks, a.rounds * 16, ctr, src, dst, full)
    let rest = n - full * 16
    if rest > 0 {
        let b = __alloc(16)
        __memcpy(b, src + full * 16, rest)
        __aes_ctr(a.ks, a.rounds * 16, ctr, b, b, 1)
        __memcpy(dst + full * 16, b, rest)
    }
}

// Тег GCM: GHASH(aad, шифротекст, длины) ^ AES(J0).
fn __gcm_tag(a: __Aead, nonce: int, aad: int, alen: int, ct: int, clen: int, tag: int) {
    let x = __alloc(16)
    __ghash_bytes(a.gh, x, aad, alen)
    __ghash_bytes(a.gh, x, ct, clen)
    let lens = __alloc(16)
    let ab = alen * 8
    let cb = clen * 8
    for i in 0..8 {
        store8(lens + 7 - i, (ab >> (i * 8)) & 255)
        store8(lens + 15 - i, (cb >> (i * 8)) & 255)
    }
    __ghash(a.gh, x, lens, 1)
    let j0 = __alloc(16)
    __memcpy(j0, nonce, 12)
    store8(j0 + 15, 1)
    __aes_ctr(a.ks, a.rounds * 16, j0, x, tag, 1)
}

// 16 байт: число в младшем порядке байтов.
fn __le_store(p: int, v: int, n: int) {
    for i in 0..n {
        store8(p + i, (v >> (i * 8)) & 255)
    }
}

// Блок ChaCha20 по ключу, счётчику и nonce (RFC 8439, 2.3).
fn __chacha(key: int, counter: int, nonce: int, out: int) {
    let st = __alloc(64)
    store32(st, 0x61707865)
    store32(st + 4, 0x3320646e)
    store32(st + 8, 0x79622d32)
    store32(st + 12, 0x6b206574)
    __memcpy(st + 16, key, 32)
    store32(st + 48, counter)
    __memcpy(st + 52, nonce, 12)
    __chacha_block(st, out)
}

// ChaCha20 для n байт, счётчик блоков начинается с counter.
fn __chacha_xor(key: int, counter: int, nonce: int, src: int, dst: int, n: int) {
    let st = __alloc(64)
    store32(st, 0x61707865)
    store32(st + 4, 0x3320646e)
    store32(st + 8, 0x79622d32)
    store32(st + 12, 0x6b206574)
    __memcpy(st + 16, key, 32)
    __memcpy(st + 52, nonce, 12)
    let ks = __alloc(64)
    var off = 0
    var c = counter
    while off < n {
        store32(st + 48, c)
        __chacha_block(st, ks)
        c += 1
        let take = (n - off).min(64)
        if take == 64 {
            for j in 0..8 {
                store64(dst + off + j * 8, load64(src + off + j * 8) ^ load64(ks + j * 8))
            }
        } else {
            for j in 0..take {
                store8(dst + off + j, load8(src + off + j) ^ load8(ks + j))
            }
        }
        off += take
    }
}

// Poly1305 (RFC 8439, 2.5): 26-битные части, произведения не больше 2^58.
type __Poly {
    r: [int]
    h: [int]
    pad: int
}

fn __poly_new(key: int) -> __Poly {
    let r0 = load32(key) & 0x3ffffff
    let r1 = (load32(key + 3) >> 2) & 0x3ffff03
    let r2 = (load32(key + 6) >> 4) & 0x3ffc0ff
    let r3 = (load32(key + 9) >> 6) & 0x3f03fff
    let r4 = (load32(key + 12) >> 8) & 0x00fffff
    return __Poly { r: [r0, r1, r2, r3, r4], h: [0, 0, 0, 0, 0], pad: key + 16 }
}

// Блоки по 16 байт; последний неполный дополняется байтом 1 и нулями.
fn __poly_update(pl: __Poly, p: int, n: int) {
    let r0 = pl.r[0]
    let r1 = pl.r[1]
    let r2 = pl.r[2]
    let r3 = pl.r[3]
    let r4 = pl.r[4]
    let s1 = r1 * 5
    let s2 = r2 * 5
    let s3 = r3 * 5
    let s4 = r4 * 5
    var h0 = pl.h[0]
    var h1 = pl.h[1]
    var h2 = pl.h[2]
    var h3 = pl.h[3]
    var h4 = pl.h[4]
    let m = 0x3ffffff
    let last = __alloc(16)
    var off = 0
    while off < n {
        var q = p + off
        var hibit = 1 << 24
        if n - off < 16 {
            __memset(last, 0, 16)
            __memcpy(last, q, n - off)
            store8(last + n - off, 1)
            q = last
            hibit = 0
        }
        h0 += load32(q) & m
        h1 += (load32(q + 3) >> 2) & m
        h2 += (load32(q + 6) >> 4) & m
        h3 += (load32(q + 9) >> 6) & m
        h4 += (load32(q + 12) >> 8) | hibit
        let d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1
        var d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2
        var d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3
        var d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4
        var d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0
        h0 = d0 & m
        d1 += d0 >> 26
        h1 = d1 & m
        d2 += d1 >> 26
        h2 = d2 & m
        d3 += d2 >> 26
        h3 = d3 & m
        d4 += d3 >> 26
        h4 = d4 & m
        h0 += (d4 >> 26) * 5
        h1 += h0 >> 26
        h0 = h0 & m
        off += 16
    }
    pl.h[0] = h0
    pl.h[1] = h1
    pl.h[2] = h2
    pl.h[3] = h3
    pl.h[4] = h4
}

fn __poly_final(pl: __Poly, out: int) {
    let m = 0x3ffffff
    var h0 = pl.h[0]
    var h1 = pl.h[1]
    var h2 = pl.h[2]
    var h3 = pl.h[3]
    var h4 = pl.h[4]
    h2 += h1 >> 26
    h1 = h1 & m
    h3 += h2 >> 26
    h2 = h2 & m
    h4 += h3 >> 26
    h3 = h3 & m
    h0 += (h4 >> 26) * 5
    h4 = h4 & m
    h1 += h0 >> 26
    h0 = h0 & m
    // h - p: если не отрицательно, берётся оно
    var g0 = h0 + 5
    var g1 = h1 + (g0 >> 26)
    g0 = g0 & m
    var g2 = h2 + (g1 >> 26)
    g1 = g1 & m
    var g3 = h3 + (g2 >> 26)
    g2 = g2 & m
    let g4 = h4 + (g3 >> 26) - (1 << 26)
    g3 = g3 & m
    if g4 >= 0 {
        h0 = g0
        h1 = g1
        h2 = g2
        h3 = g3
        h4 = g4
    }
    let w0 = (h0 | (h1 << 26)) & 0xffffffff
    let w1 = ((h1 >> 6) | (h2 << 20)) & 0xffffffff
    let w2 = ((h2 >> 12) | (h3 << 14)) & 0xffffffff
    let w3 = ((h3 >> 18) | (h4 << 8)) & 0xffffffff
    var f = w0 + load32(pl.pad)
    store32(out, f & 0xffffffff)
    f = w1 + load32(pl.pad + 4) + (f >> 32)
    store32(out + 4, f & 0xffffffff)
    f = w2 + load32(pl.pad + 8) + (f >> 32)
    store32(out + 8, f & 0xffffffff)
    f = w3 + load32(pl.pad + 12) + (f >> 32)
    store32(out + 12, f & 0xffffffff)
}

// Данные, дополненные нулями до целого числа блоков по 16 байт.
fn __poly_padded(pl: __Poly, p: int, n: int) {
    let full = n / 16 * 16
    __poly_update(pl, p, full)
    if n > full {
        let b = __alloc(16)
        __memcpy(b, p + full, n - full)
        __poly_update(pl, b, 16)
    }
}

// Тег ChaCha20-Poly1305: aad, шифротекст (оба дополнены до 16) и длины.
fn __chachapoly_tag(a: __Aead, nonce: int, aad: int, alen: int, ct: int, clen: int, tag: int) {
    let pk = __alloc(64)
    __chacha(a.ks, 0, nonce, pk)
    let pl = __poly_new(pk)
    __poly_padded(pl, aad, alen)
    __poly_padded(pl, ct, clen)
    let lens = __alloc(16)
    __le_store(lens, alen, 8)
    __le_store(lens + 8, clen, 8)
    __poly_update(pl, lens, 16)
    __poly_final(pl, tag)
}

// Зашифровать n байт src в dst и дописать 16 байт тега (dst — n + 16 байт).
fn __aead_seal(a: __Aead, nonce: int, aad: int, alen: int, src: int, n: int, dst: int) {
    if a.kind == AEAD_CHACHA {
        __chacha_xor(a.ks, 1, nonce, src, dst, n)
        __chachapoly_tag(a, nonce, aad, alen, dst, n, dst + n)
        return
    }
    let ctr = __alloc(16)
    __memcpy(ctr, nonce, 12)
    store8(ctr + 15, 2)
    __aes_ctr_bytes(a, ctr, src, dst, n)
    __gcm_tag(a, nonce, aad, alen, dst, n, dst + n)
}

// Проверить тег и расшифровать: src — n байт шифротекста и 16 байт тега.
// → false, если тег не совпал (dst тогда не трогается).
fn __aead_open(a: __Aead, nonce: int, aad: int, alen: int, src: int, n: int, dst: int) -> bool {
    let tag = __alloc(16)
    if a.kind == AEAD_CHACHA {
        __chachapoly_tag(a, nonce, aad, alen, src, n, tag)
    } else {
        __gcm_tag(a, nonce, aad, alen, src, n, tag)
    }
    // сравнение без раннего выхода
    let diff = (load64(tag) ^ load64(src + n)) | (load64(tag + 8) ^ load64(src + n + 8))
    if diff != 0 {
        return false
    }
    if a.kind == AEAD_CHACHA {
        __chacha_xor(a.ks, 1, nonce, src, dst, n)
        return true
    }
    let ctr = __alloc(16)
    __memcpy(ctr, nonce, 12)
    store8(ctr + 15, 2)
    __aes_ctr_bytes(a, ctr, src, dst, n)
    return true
}
