// HTTP/1.1-сервер на epoll: неблокирующие сокеты, keep-alive, конвейерные
// запросы, тело по Content-Length. Каждый рабочий поток — свой epoll, свой
// слушающий сокет (SO_REUSEPORT), свои соединения и своя арена запроса.
// Маршрутизатор __dispatch генерирует компилятор из объявлений route.

const SYS_RT_SIGACTION = 13
const SYS_SOCKET = 41
const SYS_ACCEPT4 = 288
const SYS_BIND = 49
const SYS_LISTEN = 50
const SYS_SETSOCKOPT = 54
const SYS_TIME = 201
const SYS_EPOLL_WAIT = 232
const SYS_EPOLL_CTL = 233
const SYS_EPOLL_CREATE1 = 291

const AF_INET = 2
const SOCK_STREAM = 1
const SOCK_NONBLOCK = 0x800
const SOL_SOCKET = 1
const SO_REUSEADDR = 2
const SO_REUSEPORT = 15
const IPPROTO_TCP = 6
const TCP_NODELAY = 1
const SIGPIPE = 13
const EAGAIN = 11

const EPOLL_CTL_ADD = 1
const EPOLL_CTL_MOD = 3
const EPOLLIN = 1
const EPOLLOUT = 4
const EPOLLERR = 8
const EPOLLHUP = 16
const EPOLL_EVENT_SIZE = 12

const HTTP_IN_SIZE = 65536
const HTTP_OUT_SIZE = 65536
const HTTP_MAX_FD = 65536
const HTTP_MAX_EVENTS = 512
const HTTP_DATE_LEN = 29

type __Conn {
    inp: int
    in_len: int
    out: int
    out_len: int
    out_cap: int
    sent: int
    close: bool
    wait_out: bool
}

// Состояние сервера в потоке.
type __Server {
    ep: int
    lfd: int
    conns: int
    events: int
    date: int
    date_sec: int
    tmp: int
    w: __Worker
}

var __http_port: int

fn __srv() -> __Server {
    return __cast(load64(__ctx() + CTX_SERVER))
}

// ---- Сокеты ----

fn __setsockopt(tmp: int, fd: int, level: int, opt: int, value: int) {
    store64(tmp, value)
    syscall(SYS_SETSOCKOPT, fd, level, opt, tmp, 4)
}

fn __ignore_sigpipe() {
    let act = __alloc(32)
    store64(act, 1)
    syscall(SYS_RT_SIGACTION, SIGPIPE, act, 0, 8)
}

// Неблокирующий слушающий сокет на 0.0.0.0:port → дескриптор или код ошибки.
fn __tcp_listen(tmp: int, port: int) -> int {
    let fd = syscall(SYS_SOCKET, AF_INET, SOCK_STREAM | SOCK_NONBLOCK, 0)
    if fd < 0 {
        return fd
    }
    __setsockopt(tmp, fd, SOL_SOCKET, SO_REUSEADDR, 1)
    __setsockopt(tmp, fd, SOL_SOCKET, SO_REUSEPORT, 1)
    let addr = tmp + 16
    store64(addr, 0)
    store64(addr + 8, 0)
    store8(addr, AF_INET)
    store8(addr + 2, (port >> 8) & 255)
    store8(addr + 3, port & 255)
    let r = syscall(SYS_BIND, fd, addr, 16)
    if r < 0 {
        return r
    }
    let l = syscall(SYS_LISTEN, fd, 4096)
    if l < 0 {
        return l
    }
    return fd
}

// struct epoll_event на x86-64 упакована: u32 events, затем u64 data (здесь — fd).
fn __epoll_ctl(s: __Server, op: int, fd: int, events: int) {
    store64(s.tmp, events)
    store64(s.tmp + 4, fd)
    syscall(SYS_EPOLL_CTL, s.ep, op, fd, s.tmp)
}

// ---- Дата для заголовка Date: «Sun, 06 Nov 1994 08:49:37 GMT» ----

fn __put2(p: int, v: int) {
    store8(p, '0' + v / 10)
    store8(p + 1, '0' + v % 10)
}

// Unix-время → дата по RFC 7231 (civil_from_days Говарда Хиннанта).
fn __format_date(out: int, t: int) {
    let days = t / 86400
    let secs = t % 86400
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    var month = mp + 3
    if mp >= 10 {
        month = mp - 9
    }
    var year = yoe + era * 400
    if month <= 2 {
        year += 1
    }
    let wd = "SunMonTueWedThuFriSat"
    __memcpy(out, __str_ptr(wd) + (days + 4) % 7 * 3, 3)
    store8(out + 3, ',')
    store8(out + 4, ' ')
    __put2(out + 5, day)
    store8(out + 7, ' ')
    let mn = "JanFebMarAprMayJunJulAugSepOctNovDec"
    __memcpy(out + 8, __str_ptr(mn) + (month - 1) * 3, 3)
    store8(out + 11, ' ')
    __put2(out + 12, year / 100)
    __put2(out + 14, year % 100)
    store8(out + 16, ' ')
    __put2(out + 17, secs / 3600)
    store8(out + 19, ':')
    __put2(out + 20, secs / 60 % 60)
    store8(out + 22, ':')
    __put2(out + 23, secs % 60)
    __memcpy(out + 25, __str_ptr(" GMT"), 4)
}

fn __update_date(s: __Server) {
    let t = syscall(SYS_TIME, 0)
    if t != s.date_sec {
        s.date_sec = t
        __format_date(s.date, t)
    }
}

// ---- Выходной буфер соединения ----

fn __out_reserve(c: __Conn, n: int) {
    if c.out_len + n <= c.out_cap {
        return
    }
    var cap = c.out_cap * 2
    while cap < c.out_len + n {
        cap *= 2
    }
    let p = __mmap(cap)
    __memcpy(p, c.out, c.out_len)
    syscall(SYS_MUNMAP, c.out, c.out_cap)
    c.out = p
    c.out_cap = cap
}

fn __out_raw(c: __Conn, p: int, n: int) {
    __memcpy(c.out + c.out_len, p, n)
    c.out_len += n
}

fn __out_str(c: __Conn, s: str) {
    __out_raw(c, __str_ptr(s), s.len())
}

fn __out_int(c: __Conn, x: int) {
    if x == 0 {
        store8(c.out + c.out_len, '0')
        c.out_len += 1
        return
    }
    var n = 0
    var v = x
    while v > 0 {
        n += 1
        v = v / 10
    }
    v = x
    var i = n - 1
    while i >= 0 {
        store8(c.out + c.out_len + i, '0' + v % 10)
        v = v / 10
        i -= 1
    }
    c.out_len += n
}

// Заголовки и тело ответа из состояния потока.
fn __write_response(s: __Server, c: __Conn) {
    let w = s.w
    let n = w.body.len
    __out_reserve(c, n + 256)
    __out_str(c, "HTTP/1.1 ")
    __out_int(c, w.status)
    store8(c.out + c.out_len, ' ')
    c.out_len += 1
    __out_str(c, __reason(w.status))
    __out_str(c, "\r\nServer: Khrip\r\nDate: ")
    __out_raw(c, s.date, HTTP_DATE_LEN)
    if w.ctype == CT_JSON {
        __out_str(c, "\r\nContent-Type: application/json")
    } else if n > 0 {
        __out_str(c, "\r\nContent-Type: text/plain")
    }
    __out_str(c, "\r\nContent-Length: ")
    __out_int(c, n)
    if c.close {
        __out_str(c, "\r\nConnection: close")
    }
    __out_str(c, "\r\n\r\n")
    __out_raw(c, w.body.data, n)
}

// Ошибка протокола; соединение закроется после отправки.
fn __http_error(s: __Server, c: __Conn, status: int) {
    c.close = true
    __reply_status(status)
    __write_response(s, c)
}

// ---- Разбор запросов ----

// Позиция сразу за «\r\n\r\n» или 0. Байт не \r и не \n не может входить
// в конец заголовков, поэтому можно перескочить сразу на 4 байта.
fn __header_end(p: int, n: int) -> int {
    var i = 3
    while i < n {
        let c = load8(p + i)
        if c == '\n' {
            if load8(p + i - 1) == '\r' && load8(p + i - 2) == '\n' && load8(p + i - 3) == '\r' {
                return i + 1
            }
            i += 1
        } else if c == '\r' {
            i += 1
        } else {
            i += 4
        }
    }
    return 0
}

fn __lower(c: int) -> int {
    if c >= 'A' && c <= 'Z' {
        return c + 32
    }
    return c
}

// Сравнение без учёта регистра с образцом в нижнем регистре.
fn __ieq(p: int, n: int, s: str) -> bool {
    if n != s.len() {
        return false
    }
    let q = __str_ptr(s)
    for i in 0..n {
        if __lower(load8(p + i)) != load8(q + i) {
            return false
        }
    }
    return true
}

fn __parse_len(p: int, n: int) -> int {
    if n == 0 || n > 15 {
        return -1
    }
    var v = 0
    for i in 0..n {
        let c = load8(p + i)
        if c < '0' || c > '9' {
            return -1
        }
        v = v * 10 + (c - '0')
    }
    return v
}

// Разбирает один запрос с начала p, вызывает маршрутизатор и дописывает ответ.
// → сколько байтов занял запрос, или 0, если он ещё не пришёл целиком.
fn __http_request(s: __Server, c: __Conn, p: int, n: int) -> int {
    let hend = __header_end(p, n)
    if hend == 0 {
        return 0
    }
    // строка запроса: МЕТОД ПУТЬ ВЕРСИЯ
    var i = 0
    while i < hend && load8(p + i) != ' ' {
        i += 1
    }
    let method_len = i
    i += 1
    let target = p + i
    while i < hend && load8(p + i) != ' ' && load8(p + i) != '\r' {
        i += 1
    }
    let target_len = p + i - target
    if method_len == 0 || target_len == 0 || load8(p + i) != ' ' || load8(target) != '/' || i + 9 > hend {
        __http_error(s, c, 400)
        return n
    }
    i += 1
    var keep_alive = true
    if __memeq(p + i, __str_ptr("HTTP/1.0"), 8) {
        keep_alive = false
    } else if !__memeq(p + i, __str_ptr("HTTP/1.1"), 8) {
        __http_error(s, c, 400)
        return n
    }
    while load8(p + i) != '\n' {
        i += 1
    }
    i += 1
    // заголовки: нужны Content-Length, Connection и Transfer-Encoding
    var body_len = 0
    while i < hend - 2 {
        let line = p + i
        var j = i
        while load8(p + j) != '\r' {
            j += 1
        }
        let line_len = p + j - line
        var k = 0
        while k < line_len && load8(line + k) != ':' {
            k += 1
        }
        if k == line_len {
            __http_error(s, c, 400)
            return n
        }
        var v = k + 1
        while v < line_len && (load8(line + v) == ' ' || load8(line + v) == '\t') {
            v += 1
        }
        let value = line + v
        let value_len = line_len - v
        let first = __lower(load8(line))
        if first == 'c' && __ieq(line, k, "content-length") {
            body_len = __parse_len(value, value_len)
            if body_len < 0 {
                __http_error(s, c, 400)
                return n
            }
        } else if first == 'c' && __ieq(line, k, "connection") {
            if __ieq(value, value_len, "close") {
                keep_alive = false
            } else if __ieq(value, value_len, "keep-alive") {
                keep_alive = true
            }
        } else if first == 't' && __ieq(line, k, "transfer-encoding") {
            __http_error(s, c, 501)
            return n
        }
        i = j + 2
    }
    if body_len > HTTP_IN_SIZE - hend {
        __http_error(s, c, 413)
        return n
    }
    if hend + body_len > n {
        return 0
    }
    // путь и строка запроса после «?»
    var path_len = 0
    while path_len < target_len && load8(target + path_len) != '?' {
        path_len += 1
    }
    var query_len = target_len - path_len - 1
    if query_len < 0 {
        query_len = 0
    }
    if !keep_alive {
        c.close = true
    }
    __arena_begin()
    let req = __Req {
        method: __str_new(p, method_len),
        path: __str_new(target, path_len),
        query: __str_new(target + path_len + 1, query_len),
        body: __str_new(p + hend, body_len)
    }
    __serve_one(s.w, req)
    __write_response(s, c)
    __arena_end()
    return hend + body_len
}

// ---- Соединения ----

fn __conn(s: __Server, fd: int) -> __Conn {
    return __cast(load64(s.conns + fd * 8))
}

// Отправляет накопленные ответы. → true, если всё отправлено и соединение живо.
fn __flush(s: __Server, fd: int, c: __Conn) -> bool {
    while c.sent < c.out_len {
        let w = syscall(SYS_WRITE, fd, c.out + c.sent, c.out_len - c.sent)
        if w == -EAGAIN {
            if !c.wait_out {
                c.wait_out = true
                __epoll_ctl(s, EPOLL_CTL_MOD, fd, EPOLLOUT)
            }
            return false
        }
        if w <= 0 {
            syscall(SYS_CLOSE, fd)
            return false
        }
        c.sent += w
    }
    c.out_len = 0
    c.sent = 0
    if c.close {
        syscall(SYS_CLOSE, fd)
        return false
    }
    if c.wait_out {
        c.wait_out = false
        __epoll_ctl(s, EPOLL_CTL_MOD, fd, EPOLLIN)
    }
    return true
}

// Все полные запросы из входного буфера, затем отправка ответов.
fn __process(s: __Server, fd: int, c: __Conn) {
    while true {
        var off = 0
        var more = false
        while off < c.in_len && !c.close {
            if c.out_len >= HTTP_OUT_SIZE {
                more = true
                break
            }
            let used = __http_request(s, c, c.inp + off, c.in_len - off)
            if used == 0 {
                break
            }
            off += used
        }
        if off > 0 {
            __memcpy(c.inp, c.inp + off, c.in_len - off)
            c.in_len -= off
        }
        if !c.close && c.in_len == HTTP_IN_SIZE {
            __http_error(s, c, 431)
        }
        if !__flush(s, fd, c) || !more {
            return
        }
    }
}

fn __read(s: __Server, fd: int, c: __Conn) {
    let n = syscall(SYS_READ, fd, c.inp + c.in_len, HTTP_IN_SIZE - c.in_len)
    if n == -EAGAIN {
        return
    }
    if n <= 0 {
        syscall(SYS_CLOSE, fd)
        return
    }
    c.in_len += n
    __process(s, fd, c)
}

fn __accept(s: __Server) {
    while true {
        let fd = syscall(SYS_ACCEPT4, s.lfd, 0, 0, SOCK_NONBLOCK)
        if fd < 0 {
            return
        }
        if fd >= HTTP_MAX_FD {
            syscall(SYS_CLOSE, fd)
            continue
        }
        __setsockopt(s.tmp, fd, IPPROTO_TCP, TCP_NODELAY, 1)
        var a = load64(s.conns + fd * 8)
        if a == 0 {
            let c = __Conn { inp: __mmap(HTTP_IN_SIZE), in_len: 0, out: __mmap(HTTP_OUT_SIZE * 2), out_len: 0, out_cap: HTTP_OUT_SIZE * 2, sent: 0, close: false, wait_out: false }
            a = __cast(c)
            store64(s.conns + fd * 8, a)
        }
        let c = __conn(s, fd)
        c.in_len = 0
        c.out_len = 0
        c.sent = 0
        c.close = false
        c.wait_out = false
        __epoll_ctl(s, EPOLL_CTL_ADD, fd, EPOLLIN)
    }
}

fn __event(s: __Server, fd: int, flags: int) {
    let c = __conn(s, fd)
    if (flags & (EPOLLERR | EPOLLHUP)) != 0 {
        syscall(SYS_CLOSE, fd)
        return
    }
    if c.wait_out {
        if (flags & EPOLLOUT) != 0 && __flush(s, fd, c) {
            __process(s, fd, c)
        }
        return
    }
    __read(s, fd, c)
}

// Рабочий цикл потока id.
fn __http_worker(id: int) {
    let w = __worker_init()
    __arena_init(id)
    let tmp = __alloc(64)
    let lfd = __tcp_listen(tmp, __http_port)
    if lfd < 0 {
        eprint("khrip: cannot listen on port {__http_port}")
        exit(1)
    }
    let s = __Server {
        ep: syscall(SYS_EPOLL_CREATE1, 0),
        lfd: lfd,
        conns: __mmap(HTTP_MAX_FD * 8),
        events: __alloc(HTTP_MAX_EVENTS * EPOLL_EVENT_SIZE),
        date: __alloc(32),
        date_sec: 0,
        tmp: tmp,
        w: w
    }
    store64(__ctx() + CTX_SERVER, __cast(s))
    __update_date(s)
    __epoll_ctl(s, EPOLL_CTL_ADD, lfd, EPOLLIN)
    while true {
        let n = syscall(SYS_EPOLL_WAIT, s.ep, s.events, HTTP_MAX_EVENTS, -1)
        __update_date(s)
        var i = 0
        while i < n {
            let e = s.events + i * EPOLL_EVENT_SIZE
            let fd = load64(e + 4) & 0xFFFFFFFF
            if fd == lfd {
                __accept(s)
            } else {
                __event(s, fd, load64(e) & 0xFFFFFFFF)
            }
            i += 1
        }
    }
}

fn __env_int(name: str, default: int) -> int {
    let v = env(name) else {
        return default
    }
    return v.to_int() ?? default
}

// Точка входа сервера: программа с route.
fn __serve() {
    __http_port = __env_int("PORT", 8080)
    __ignore_sigpipe()
    __store_init()
    eprint("khrip: listening on http://0.0.0.0:{__http_port}")
    __http_worker(0)
}
