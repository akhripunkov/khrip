// HTTP/1.1-сервер на epoll: неблокирующие сокеты, keep-alive, конвейерные
// запросы, тело по Content-Length. Каждый рабочий поток — свой epoll, свой
// слушающий сокет (SO_REUSEPORT) и свои соединения. Каждый запрос выполняется
// в сопрограмме (lib/rt.kh) со своей ареной: если он ждёт (fetch, sleep), поток
// выполняет другие. Маршрутизатор __dispatch генерирует компилятор из
// объявлений route.

const SYS_RT_SIGACTION = 13
const SYS_SOCKET = 41
const SYS_ACCEPT4 = 288
const SYS_BIND = 49
const SYS_LISTEN = 50
const SYS_SETSOCKOPT = 54
const SYS_SHUTDOWN = 48
const SHUT_WR = 1
const SYS_TIME = 201
const SYS_EPOLL_WAIT = 232
const SYS_EPOLL_CREATE1 = 291
const SYS_MPROTECT = 10
const SYS_MADVISE = 28

const AF_INET = 2
const SOCK_STREAM = 1
const SOCK_NONBLOCK = 0x800
const SOCK_CLOEXEC = 0x80000
const SOL_SOCKET = 1
const SO_REUSEADDR = 2
const SO_REUSEPORT = 15
const IPPROTO_TCP = 6
const TCP_NODELAY = 1
const SIGPIPE = 13
const EAGAIN = 11

const EPOLL_EVENT_SIZE = 12

const HTTP_IN_SIZE = 65536
const HTTP_OUT_SIZE = 65536
const HTTP_MAX_FD = 65536
const HTTP_MAX_EVENTS = 512
const HTTP_DATE_LEN = 29

// Сопрограммы потока: не больше CO_MAX или KHRIP_COROUTINES (дальше запросы
// ждут в очереди), из свободных CO_KEEP держат память арены; стек запросов —
// CO_STACK байт.
const CO_MAX = 4096
const CO_KEEP = 64
const CO_STACK = 8388608

type __Conn {
    inp: int
    in_len: int
    out: int
    out_len: int
    out_cap: int
    sent: int
    close: bool
    wait_out: bool
    // ответ с закрытием отправлен: ждём, пока клиент закроет соединение, и
    // выбрасываем его данные — иначе close() с непрочитанным вводом шлёт RST,
    // и клиент может не успеть прочитать ответ (431, 400)
    linger: bool
    // сколько байтов входа уже разобрано; размер запроса, который выполняется
    off: int
    pend: int
    // запрос соединения выполняется (ждёт) или ждёт свободную сопрограмму:
    // вход не читается и не сдвигается — строки запроса указывают в него
    busy: bool
    // клиент ушёл, пока запрос выполнялся: закрыть, когда запрос закончится
    dead: bool
    open: bool
    // события, на которые соединение подписано в epoll
    armed: int
}

// Состояние сервера в потоке.
type __Server {
    ep: int
    lfd: int
    conns: int
    events: int
    date: int
    date_sec: int
    tmp: int
    // ответы на ошибки протокола (400, 413, 431, 501)
    w: __Worker
    sch: __Sched
    // свободные сопрограммы; сколько создано и сколько можно
    free: [int]
    co_count: int
    co_max: int
    // соединения, чьим запросам не хватило сопрограммы, по очереди
    starved: [int]
    starved_head: int
    // сопрограммы, чей срок вышел
    due: [int]
}

// Задание сопрограммы: запрос в буфере соединения conn (адреса и длины).
type __Job {
    conn: int = 0
    fd: int = 0
    p: int = 0
    mlen: int = 0
    target: int = 0
    plen: int = 0
    qlen: int = 0
    lend: int = 0
    hend: int = 0
    blen: int = 0
}

var __http_port: int
// рабочих потоков сервера (для запаса соединений с базой)
var __threads: int

fn __srv() -> __Server {
    return __cast(load64(__ctx() + CTX_SERVER))
}

// ---- Сокеты ----

fn __setsockopt(tmp: int, fd: int, level: int, opt: int, value: int) {
    store64(tmp, value)
    syscall(SYS_SETSOCKOPT, fd, level, opt, tmp, 4)
}

fn __ignore_sigpipe() {
    let act = __alloc(32)
    store64(act, 1)
    syscall(SYS_RT_SIGACTION, SIGPIPE, act, 0, 8)
}

// Неблокирующий слушающий сокет на 0.0.0.0:port → дескриптор или код ошибки.
fn __tcp_listen(tmp: int, port: int) -> int {
    let fd = syscall(SYS_SOCKET, AF_INET, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0)
    if fd < 0 {
        return fd
    }
    __setsockopt(tmp, fd, SOL_SOCKET, SO_REUSEADDR, 1)
    __setsockopt(tmp, fd, SOL_SOCKET, SO_REUSEPORT, 1)
    let addr = tmp + 16
    store64(addr, 0)
    store64(addr + 8, 0)
    store8(addr, AF_INET)
    store8(addr + 2, (port >> 8) & 255)
    store8(addr + 3, port & 255)
    let r = syscall(SYS_BIND, fd, addr, 16)
    if r < 0 {
        return r
    }
    let l = syscall(SYS_LISTEN, fd, 4096)
    if l < 0 {
        return l
    }
    return fd
}

// struct epoll_event на x86-64 упакована: u32 events, затем u64 data (здесь — fd).
fn __epoll_ctl(s: __Server, op: int, fd: int, events: int) {
    store64(s.tmp, events)
    store64(s.tmp + 4, fd)
    syscall(SYS_EPOLL_CTL, s.ep, op, fd, s.tmp)
}

// ---- Дата для заголовка Date: «Sun, 06 Nov 1994 08:49:37 GMT» ----

fn __put2(p: int, v: int) {
    store8(p, '0' + v / 10)
    store8(p + 1, '0' + v % 10)
}

// Unix-время → дата по RFC 7231 (civil_from_days Говарда Хиннанта).
fn __format_date(out: int, t: int) {
    let days = t / 86400
    let secs = t % 86400
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    var month = mp + 3
    if mp >= 10 {
        month = mp - 9
    }
    var year = yoe + era * 400
    if month <= 2 {
        year += 1
    }
    let wd = "SunMonTueWedThuFriSat"
    __memcpy(out, __str_ptr(wd) + (days + 4) % 7 * 3, 3)
    store8(out + 3, ',')
    store8(out + 4, ' ')
    __put2(out + 5, day)
    store8(out + 7, ' ')
    let mn = "JanFebMarAprMayJunJulAugSepOctNovDec"
    __memcpy(out + 8, __str_ptr(mn) + (month - 1) * 3, 3)
    store8(out + 11, ' ')
    __put2(out + 12, year / 100)
    __put2(out + 14, year % 100)
    store8(out + 16, ' ')
    __put2(out + 17, secs / 3600)
    store8(out + 19, ':')
    __put2(out + 20, secs / 60 % 60)
    store8(out + 22, ':')
    __put2(out + 23, secs % 60)
    __memcpy(out + 25, __str_ptr(" GMT"), 4)
}

fn __update_date(s: __Server) {
    let t = syscall(SYS_TIME, 0)
    if t != s.date_sec {
        s.date_sec = t
        __format_date(s.date, t)
    }
}

// ---- Выходной буфер соединения ----

fn __out_reserve(c: __Conn, n: int) {
    if c.out_len + n <= c.out_cap {
        return
    }
    var cap = c.out_cap * 2
    while cap < c.out_len + n {
        cap *= 2
    }
    let p = __mmap(cap)
    __memcpy(p, c.out, c.out_len)
    syscall(SYS_MUNMAP, c.out, c.out_cap)
    c.out = p
    c.out_cap = cap
}

fn __out_raw(c: __Conn, p: int, n: int) {
    __memcpy(c.out + c.out_len, p, n)
    c.out_len += n
}

fn __out_str(c: __Conn, s: str) {
    __out_raw(c, __str_ptr(s), s.len())
}

fn __out_int(c: __Conn, x: int) {
    if x == 0 {
        store8(c.out + c.out_len, '0')
        c.out_len += 1
        return
    }
    var n = 0
    var v = x
    while v > 0 {
        n += 1
        v = v / 10
    }
    v = x
    var i = n - 1
    while i >= 0 {
        store8(c.out + c.out_len + i, '0' + v % 10)
        v = v / 10
        i -= 1
    }
    c.out_len += n
}

// Заголовки и тело ответа из состояния запроса w.
fn __write_response(s: __Server, c: __Conn, w: __Worker) {
    let n = w.body.len
    __out_reserve(c, n + 256)
    __out_str(c, "HTTP/1.1 ")
    __out_int(c, w.status)
    store8(c.out + c.out_len, ' ')
    c.out_len += 1
    __out_str(c, __reason(w.status))
    __out_str(c, "\r\nServer: Khrip\r\nDate: ")
    __out_raw(c, s.date, HTTP_DATE_LEN)
    if w.ctype == CT_JSON {
        __out_str(c, "\r\nContent-Type: application/json")
    } else if n > 0 {
        __out_str(c, "\r\nContent-Type: text/plain")
    }
    __out_str(c, "\r\nContent-Length: ")
    __out_int(c, n)
    if w.extra.len > 0 {
        __out_reserve(c, w.extra.len + 8)
        __out_str(c, "\r\n")
        __out_raw(c, w.extra.data, w.extra.len - 2)
    }
    if c.close {
        __out_str(c, "\r\nConnection: close")
    }
    __out_str(c, "\r\n\r\n")
    __out_raw(c, w.body.data, n)
}

// Ошибка протокола; соединение закроется после отправки.
fn __http_error(s: __Server, c: __Conn, status: int) {
    c.close = true
    __reply_status(status)
    __write_response(s, c, s.w)
}

// ---- Разбор запросов ----

// Позиция сразу за «\r\n\r\n» или 0, если заголовки ещё не пришли целиком.
fn __header_end(p: int, n: int) -> int {
    let i = __find_crlf2(p, n)
    if i >= n {
        return 0
    }
    return i + 4
}

fn __lower(c: int) -> int {
    if c >= 'A' && c <= 'Z' {
        return c + 32
    }
    return c
}

// Сравнение без учёта регистра с образцом в нижнем регистре.
fn __ieq(p: int, n: int, s: str) -> bool {
    if n != s.len() {
        return false
    }
    let q = __str_ptr(s)
    for i in 0..n {
        if __lower(load8(p + i)) != load8(q + i) {
            return false
        }
    }
    return true
}

fn __parse_len(p: int, n: int) -> int {
    if n == 0 || n > 15 {
        return -1
    }
    var v = 0
    for i in 0..n {
        let c = load8(p + i)
        if c < '0' || c > '9' {
            return -1
        }
        v = v * 10 + (c - '0')
    }
    return v
}

// Разбирает один запрос с начала p и выполняет его в сопрограмме: она вызывает
// маршрутизатор и дописывает ответ. → сколько байтов занял запрос; 0 — он ещё
// не пришёл целиком; -1 — он ждёт (fetch, sleep), его размер — в c.pend; -2 —
// свободной сопрограммы нет.
fn __http_request(s: __Server, c: __Conn, fd: int, p: int, n: int) -> int {
    let hend = __header_end(p, n)
    if hend == 0 {
        return 0
    }
    // строка запроса: МЕТОД ПУТЬ ВЕРСИЯ
    let line_end = __find_byte(p, hend, '\r')
    let method_len = __find_byte(p, line_end, ' ')
    var i = method_len + 1
    let target = p + i
    var target_len = 0
    if i < line_end {
        target_len = __find_byte(target, line_end - i, ' ')
    }
    i += target_len
    if method_len == 0 || target_len == 0 || i >= line_end || load8(target) != '/' || i + 9 > hend {
        __http_error(s, c, 400)
        return n
    }
    i += 1
    var keep_alive = true
    if __memeq(p + i, __str_ptr("HTTP/1.0"), 8) {
        keep_alive = false
    } else if !__memeq(p + i, __str_ptr("HTTP/1.1"), 8) {
        __http_error(s, c, 400)
        return n
    }
    i = line_end + 2
    // заголовки: нужны Content-Length, Connection и Transfer-Encoding
    var body_len = 0
    while i < hend - 2 {
        let line = p + i
        let line_len = __find_byte(line, hend - i, '\r')
        let j = i + line_len
        let k = __find_byte(line, line_len, ':')
        if k == line_len {
            __http_error(s, c, 400)
            return n
        }
        var v = k + 1
        while v < line_len && (load8(line + v) == ' ' || load8(line + v) == '\t') {
            v += 1
        }
        let value = line + v
        let value_len = line_len - v
        let first = __lower(load8(line))
        if first == 'c' && __ieq(line, k, "content-length") {
            body_len = __parse_len(value, value_len)
            if body_len < 0 {
                __http_error(s, c, 400)
                return n
            }
        } else if first == 'c' && __ieq(line, k, "connection") {
            if __ieq(value, value_len, "close") {
                keep_alive = false
            } else if __ieq(value, value_len, "keep-alive") {
                keep_alive = true
            }
        } else if first == 't' && __ieq(line, k, "transfer-encoding") {
            __http_error(s, c, 501)
            return n
        }
        i = j + 2
    }
    if body_len > HTTP_IN_SIZE - hend {
        __http_error(s, c, 413)
        return n
    }
    if hend + body_len > n {
        return 0
    }
    // путь и строка запроса после «?»
    let path_len = __find_byte(target, target_len, '?')
    var query_len = target_len - path_len - 1
    if query_len < 0 {
        query_len = 0
    }
    let co = __co_get(s) else {
        return -2
    }
    if !keep_alive {
        c.close = true
    }
    let j: __Job = __cast(co.job)
    j.conn = __cast(c)
    j.fd = fd
    j.p = p
    j.mlen = method_len
    j.target = target
    j.plen = path_len
    j.qlen = query_len
    j.lend = line_end
    j.hend = hend
    j.blen = body_len
    __co_enter(s.sch, co)
    if co.done {
        __co_put(s, co)
        return hend + body_len
    }
    c.pend = hend + body_len
    return -1
}

// ---- Сопрограммы запросов ----

fn __co_new(s: __Server) -> __Co? {
    let base = __arena_take()
    if base == 0 {
        return none
    }
    let w = __worker_new()
    let job = __Job {}
    let co = __Co { sch: s.sch, jb: __alloc(64), ctx: __alloc(CTX_CO_END), stk: 0, stk_len: 0, stk_cap: 0, started: false, parked: false, done: false, deadline: 0, hidx: -1, revents: 0, w: __cast(w), job: __cast(job) }
    let x = co.ctx
    store64(x + CTX_WORKER, co.w)
    store64(x + CTX_SERVER, __cast(s))
    store64(x + CTX_CORO, __cast(co))
    __arena_attach(x, base)
    return co
}

fn __co_get(s: __Server) -> __Co? {
    if s.free.len() > 0 {
        let co: __Co = __cast(s.free.pop())
        return co
    }
    if s.co_count >= s.co_max {
        return none
    }
    let co = __co_new(s) else {
        // адреса арен кончились: больше сопрограмм не будет
        s.co_max = s.co_count
        return none
    }
    s.co_count += 1
    return co
}

fn __co_put(s: __Server, co: __Co) {
    co.started = false
    co.parked = false
    co.done = false
    let w: __Worker = __cast(co.w)
    buf_shrink(w.body, 1048576)
    buf_shrink(w.extra, 65536)
    if s.free.len() >= CO_KEEP {
        // лишняя свободная сопрограмма: страницы арены — системе
        let base = load64(co.ctx + CTX_ARENA)
        syscall(SYS_MADVISE, base, load64(co.ctx + CTX_ARENA_END) - base, 4)
    }
    s.free.push(__cast(co))
}

// Кадры сопрограммы, которая ждёт, — со стека запросов в кучу.
fn __co_evict(sch: __Sched, occ: int) {
    sch.on_stack = 0
    let o: __Co = __cast(occ)
    if !o.parked {
        return
    }
    let sp = load64(o.jb + 8)
    let n = sch.top - sp
    if n > o.stk_cap {
        var cap = 4096
        while cap < n {
            cap *= 2
        }
        o.stk = __alloc(cap)
        o.stk_cap = cap
    }
    __memcpy(o.stk, sp, n)
    o.stk_len = n
}

// Выполнять сопрограмму co, пока она не остановится или не закончит задание.
fn __co_enter(sch: __Sched, co: __Co) {
    let c = __ctx()
    let cv: int = __cast(co)
    let occ = sch.on_stack
    if occ != 0 && occ != cv {
        __co_evict(sch, occ)
    }
    __memcpy(sch.ctx + 8, c + 8, CTX_CO_END - 8)
    __memcpy(c + 8, co.ctx + 8, CTX_CO_END - 8)
    if __setjmp(sch.jb) == 0 {
        sch.on_stack = cv
        if co.started {
            if occ != cv {
                __memcpy(sch.top - co.stk_len, co.stk, co.stk_len)
            }
            co.parked = false
            __longjmp(co.jb)
        }
        co.started = true
        __co_call(sch.top, cv)
    }
    __memcpy(co.ctx + 8, c + 8, CTX_CO_END - 8)
    __memcpy(c + 8, sch.ctx + 8, CTX_CO_END - 8)
}

// Начало сопрограммы на стеке запросов (встроенная __co_call). Из функции нет
// возврата: планировщик продолжает с __setjmp в __co_enter.
fn __co_main(co: __Co) {
    __co_job(co)
    co.done = true
    __longjmp(co.sch.jb)
}

fn __co_job(co: __Co) {
    let j: __Job = __cast(co.job)
    let w: __Worker = __cast(co.w)
    let c: __Conn = __cast(j.conn)
    let p = j.p
    __arena_begin()
    let req = __Req {
        method: __str_new(p, j.mlen),
        path: __str_new(j.target, j.plen),
        query: __str_new(j.target + j.plen + 1, j.qlen),
        body: __str_new(p + j.hend, j.blen),
        headers: __str_new(p + j.lend + 2, j.hend - j.lend - 4)
    }
    __serve_one(w, req)
    __write_response(__srv(), c, w)
    __arena_end()
}

fn __co_run(s: __Server, co: __Co) {
    __co_enter(s.sch, co)
    if co.done {
        let j: __Job = __cast(co.job)
        let c: __Conn = __cast(j.conn)
        let fd = j.fd
        __co_put(s, co)
        __conn_resume(s, fd, c, c.pend)
        __feed_starved(s)
    }
}

// Событие для сопрограммы, которая ждёт fd.
fn __co_wake(s: __Server, cv: int, flags: int) {
    let co: __Co = __cast(cv)
    if !co.parked {
        return
    }
    if co.hidx >= 0 {
        __heap_remove(s.sch, co)
    }
    co.revents = flags
    __co_run(s, co)
}

// Разбудить сопрограммы, чей срок вышел.
fn __co_expire(s: __Server) {
    let sch = s.sch
    if sch.heap_len == 0 {
        return
    }
    let now = now_ms()
    while sch.heap_len > 0 {
        let co = __heap_at(sch, 0)
        if co.deadline > now {
            break
        }
        __heap_remove(sch, co)
        s.due.push(__cast(co))
    }
    for cv in s.due {
        let co: __Co = __cast(cv)
        if co.parked {
            co.revents = 0
            __co_run(s, co)
        }
    }
    s.due.clear()
}

// Сколько мс epoll может ждать: до ближайшего срока или без предела (-1).
fn __co_timeout(sch: __Sched) -> int {
    if sch.heap_len == 0 {
        return -1
    }
    let d = __heap_at(sch, 0).deadline - now_ms()
    if d < 0 {
        return 0
    }
    return d
}

// Запросы, которым не хватило сопрограммы, — по мере того как они освобождаются.
fn __feed_starved(s: __Server) {
    while s.starved_head < s.starved.len() && (s.free.len() > 0 || s.co_count < s.co_max) {
        let fd = s.starved[s.starved_head]
        s.starved_head += 1
        __conn_resume(s, fd, __conn(s, fd), 0)
    }
    if s.starved_head == s.starved.len() {
        s.starved.clear()
        s.starved_head = 0
    }
}

// ---- Соединения ----

fn __conn(s: __Server, fd: int) -> __Conn {
    return __cast(load64(s.conns + fd * 8))
}

// Подписать соединение на события ev, если оно подписано на другие.
fn __conn_arm(s: __Server, fd: int, c: __Conn, ev: int) {
    if c.armed != ev {
        __epoll_ctl(s, EPOLL_CTL_MOD, fd, ev)
        c.armed = ev
    }
}

// Закрыть соединение; если его запрос ещё выполняется — когда закончится.
fn __conn_drop(s: __Server, fd: int, c: __Conn) {
    if c.busy {
        if !c.dead {
            c.dead = true
            __epoll_ctl(s, EPOLL_CTL_DEL, fd, 0)
            c.armed = 0
        }
        return
    }
    if c.open {
        c.open = false
        syscall(SYS_CLOSE, fd)
    }
}

// Запрос соединения закончился (used — его размер) или получил сопрограмму
// (used = 0): разобрать остальной вход и снова ждать ввода.
fn __conn_resume(s: __Server, fd: int, c: __Conn, used: int) {
    c.busy = false
    c.off += used
    c.pend = 0
    if c.dead {
        c.dead = false
        __conn_drop(s, fd, c)
        return
    }
    __process(s, fd, c)
    if c.open && !c.busy && !c.dead {
        if c.wait_out {
            __conn_arm(s, fd, c, EPOLLOUT)
        } else {
            __conn_arm(s, fd, c, EPOLLIN)
        }
    }
}

// Отправляет накопленные ответы. → true, если всё отправлено, соединение живо
// и можно разбирать следующие запросы.
fn __flush(s: __Server, fd: int, c: __Conn) -> bool {
    while c.sent < c.out_len {
        let w = syscall(SYS_WRITE, fd, c.out + c.sent, c.out_len - c.sent)
        if w == -EAGAIN {
            c.wait_out = true
            __conn_arm(s, fd, c, EPOLLOUT)
            return false
        }
        if w <= 0 {
            __conn_drop(s, fd, c)
            return false
        }
        c.sent += w
    }
    c.out_len = 0
    c.sent = 0
    c.wait_out = false
    if c.close && !c.busy {
        syscall(SYS_SHUTDOWN, fd, SHUT_WR)
        c.linger = true
        __conn_arm(s, fd, c, EPOLLIN)
        return false
    }
    __conn_arm(s, fd, c, EPOLLIN)
    return !c.busy
}

// Все полные запросы из входного буфера, затем отправка ответов.
fn __process(s: __Server, fd: int, c: __Conn) {
    while true {
        var more = false
        while c.off < c.in_len && !c.close {
            if c.out_len >= HTTP_OUT_SIZE {
                more = true
                break
            }
            let used = __http_request(s, c, fd, c.inp + c.off, c.in_len - c.off)
            if used == 0 {
                break
            }
            if used < 0 {
                // запрос ждёт: следующие — когда он закончится (ответы по порядку)
                c.busy = true
                if used == -2 {
                    s.starved.push(fd)
                }
                __flush(s, fd, c)
                return
            }
            c.off += used
        }
        if c.off > 0 {
            __memcpy(c.inp, c.inp + c.off, c.in_len - c.off)
            c.in_len -= c.off
            c.off = 0
        }
        if !c.close && c.in_len == HTTP_IN_SIZE {
            __http_error(s, c, 431)
        }
        if !__flush(s, fd, c) || !more {
            return
        }
    }
}

fn __read(s: __Server, fd: int, c: __Conn) {
    if c.linger {
        // выбросить ввод; закрыть, когда клиент закроет своё направление
        while true {
            let d = syscall(SYS_READ, fd, c.inp, HTTP_IN_SIZE)
            if d == -EAGAIN {
                return
            }
            if d <= 0 {
                __conn_drop(s, fd, c)
                return
            }
        }
    }
    let n = syscall(SYS_READ, fd, c.inp + c.in_len, HTTP_IN_SIZE - c.in_len)
    if n == -EAGAIN {
        return
    }
    if n <= 0 {
        __conn_drop(s, fd, c)
        return
    }
    c.in_len += n
    __process(s, fd, c)
}

fn __accept(s: __Server) {
    while true {
        let fd = syscall(SYS_ACCEPT4, s.lfd, 0, 0, SOCK_NONBLOCK | SOCK_CLOEXEC)
        if fd < 0 {
            return
        }
        if fd >= HTTP_MAX_FD {
            syscall(SYS_CLOSE, fd)
            continue
        }
        __setsockopt(s.tmp, fd, IPPROTO_TCP, TCP_NODELAY, 1)
        var a = load64(s.conns + fd * 8)
        if a == 0 {
            let c = __Conn { inp: __mmap(HTTP_IN_SIZE), in_len: 0, out: __mmap(HTTP_OUT_SIZE * 2), out_len: 0, out_cap: HTTP_OUT_SIZE * 2, sent: 0, close: false, wait_out: false, linger: false, off: 0, pend: 0, busy: false, dead: false, open: true, armed: 0 }
            a = __cast(c)
            store64(s.conns + fd * 8, a)
        }
        let c = __conn(s, fd)
        c.in_len = 0
        c.out_len = 0
        c.sent = 0
        c.close = false
        c.wait_out = false
        c.linger = false
        c.off = 0
        c.pend = 0
        c.busy = false
        c.dead = false
        c.open = true
        c.armed = EPOLLIN
        __epoll_ctl(s, EPOLL_CTL_ADD, fd, EPOLLIN)
    }
}

fn __event(s: __Server, fd: int, flags: int) {
    let c = __conn(s, fd)
    if !c.open {
        return
    }
    if (flags & (EPOLLERR | EPOLLHUP)) != 0 {
        __conn_drop(s, fd, c)
        return
    }
    if c.wait_out {
        if (flags & EPOLLOUT) != 0 && __flush(s, fd, c) {
            __process(s, fd, c)
        }
        return
    }
    if c.busy {
        // новый ввод подождёт, пока выполняется запрос
        __conn_arm(s, fd, c, 0)
        return
    }
    __read(s, fd, c)
}

// Рабочий цикл потока id.
fn __http_worker(id: int) {
    let w = __worker_init()
    let tmp = __alloc(64)
    let lfd = __tcp_listen(tmp, __http_port)
    if lfd < 0 {
        eprint("khrip: cannot listen on port {__http_port}")
        exit(1)
    }
    let ep = syscall(SYS_EPOLL_CREATE1, SOCK_CLOEXEC)
    // стек запросов и страница-охранник под ним
    let stack = __mmap(CO_STACK + 4096)
    syscall(SYS_MPROTECT, stack, 4096, 0)
    let co_max = __env_int("KHRIP_COROUTINES", CO_MAX).max(1)
    let sch = __Sched { ep, jb: __alloc(64), ctx: __alloc(CTX_CO_END), top: stack + 4096 + CO_STACK, on_stack: 0, heap: __mmap(co_max * 8), heap_len: 0, ev: __alloc(16) }
    let s = __Server {
        ep: ep,
        lfd: lfd,
        conns: __mmap(HTTP_MAX_FD * 8),
        events: __alloc(HTTP_MAX_EVENTS * EPOLL_EVENT_SIZE),
        date: __alloc(32),
        date_sec: 0,
        tmp: tmp,
        w: w,
        sch: sch,
        free: [],
        co_count: 0,
        co_max: co_max,
        starved: [],
        starved_head: 0,
        due: []
    }
    store64(__ctx() + CTX_SERVER, __cast(s))
    __update_date(s)
    __epoll_ctl(s, EPOLL_CTL_ADD, lfd, EPOLLIN)
    while true {
        let n = syscall(SYS_EPOLL_WAIT, s.ep, s.events, HTTP_MAX_EVENTS, __co_timeout(sch))
        __update_date(s)
        var i = 0
        while i < n {
            let e = s.events + i * EPOLL_EVENT_SIZE
            // данные события: дескриптор соединения или сопрограмма, которая ждёт
            let d = load64(e + 4)
            let flags = load64(e) & 0xFFFFFFFF
            if d == lfd {
                __accept(s)
            } else if d < HTTP_MAX_FD {
                __event(s, d, flags)
            } else {
                __co_wake(s, d, flags)
            }
            i += 1
        }
        __co_expire(s)
    }
}

fn __env_int(name: str, default: int) -> int {
    let v = env(name) else {
        return default
    }
    return v.to_int() ?? default
}

const SYS_SCHED_SETAFFINITY = 203
const SYS_SCHED_GETAFFINITY = 204
const THREAD_STACK = 8388608

// Ядра, на которых разрешено работать процессу (учитывает taskset).
var __cpus: [int]

fn __read_cpus() {
    let mask = __alloc(128)
    let n = syscall(SYS_SCHED_GETAFFINITY, 0, 128, mask)
    if n <= 0 {
        __cpus.push(-1)
        return
    }
    for i in 0..n * 8 {
        if (load8(mask + i / 8) >> (i % 8)) & 1 != 0 {
            __cpus.push(i)
        }
    }
}

// Привязать текущий поток к одному ядру.
fn __pin(cpu: int) {
    if cpu < 0 {
        return
    }
    let mask = __alloc(128)
    store8(mask + cpu / 8, 1 << (cpu % 8))
    syscall(SYS_SCHED_SETAFFINITY, 0, 128, mask)
}

// Начало рабочего потока (__spawn); id < 0 — поток фоновых задач.
fn __thread_main(id: int) {
    __thread_init()
    if id < 0 {
        __timer_loop()
        return
    }
    __pin(__cpus[id % __cpus.len()])
    __http_worker(id)
}

// ---- Фоновые задачи (every) и сохранение store (KHRIP_DATA) ----

const SYS_RT_SIGPROCMASK = 14
const SYS_RT_SIGTIMEDWAIT = 128
const SYS_RENAME_STORE = 82
const SIGINT = 2
const SIGTERM = 15

var __store_saved: int

fn __data_path() -> str {
    return env("KHRIP_DATA") ?? ""
}

fn __timers_wanted() -> bool {
    return __every_count() > 0 || __data_path().len() > 0
}

fn __signal_set() -> int {
    let set = __alloc(8)
    store64(set, (1 << (SIGINT - 1)) | (1 << (SIGTERM - 1)))
    return set
}

// SIGINT и SIGTERM блокируются во всех потоках: их принимает поток задач,
// сохраняет store и завершает программу.
fn __block_signals() {
    syscall(SYS_RT_SIGPROCMASK, 0, __signal_set(), 0, 8)
}

fn __load_store() {
    let path = __data_path()
    if path.len() == 0 {
        return
    }
    let text = read_file(path) else {
        return
    }
    if !__store_restore(text) {
        eprint("khrip: cannot read store from {path}: {json_error()}")
        exit(1)
    }
}

// Снимок store под блокировкой, запись — в файл рядом и переименование.
fn __save_store() {
    let path = __data_path()
    __arena_begin()
    __store_lock()
    let text = __store_snapshot()
    __store_saved = __store_touches
    __store_unlock()
    let tmp = path + ".tmp"
    if write_file(tmp, text, false) {
        syscall(SYS_RENAME_STORE, __cstr(tmp), __cstr(path))
    } else {
        eprint("khrip: cannot write store to {path}")
    }
    __arena_end()
}

fn __run_task(w: __Worker, i: int) {
    let c = __ctx()
    __arena_begin()
    store64(c + CTX_JNULLS, 0)
    if __setjmp(w.jb) == 0 {
        store64(c + CTX_CATCH, w.jb)
        __every_run(i)
    } else {
        __pmode_reset()
        let msg: str = __cast(load64(c + CTX_PANIC))
        eprint(msg)
    }
    store64(c + CTX_CATCH, 0)
    __db_end()
    __store_unlock()
    __arena_end()
}

fn __timer_loop() {
    let w = __worker_init()
    __arena_init()
    let n = __every_count()
    var t = now_ms()
    var next: [int] = []
    for i in 0..n {
        next.push(t + __every_ms(i))
    }
    let set = __signal_set()
    let ts = __alloc(16)
    let saving = __data_path().len() > 0
    while true {
        var wait = 3600000
        if saving {
            wait = 1000
        }
        for x in next {
            if x - t < wait {
                wait = x - t
            }
        }
        if wait < 0 {
            wait = 0
        }
        store64(ts, wait / 1000)
        store64(ts + 8, (wait % 1000) * 1000000)
        let sig = syscall(SYS_RT_SIGTIMEDWAIT, set, 0, ts, 8)
        if sig == SIGINT || sig == SIGTERM {
            if saving {
                __save_store()
            }
            exit(0)
        }
        t = now_ms()
        for i in 0..n {
            if t >= next[i] {
                __run_task(w, i)
                t = now_ms()
                next[i] = t + __every_ms(i)
            }
        }
        if saving && __store_touches != __store_saved {
            __save_store()
        }
    }
}

// Программа без route, но с every: только фоновые задачи.
fn __run_timers() {
    __ignore_sigpipe()
    __store_init()
    __store_rw_init()
    __store_lock()
    __store_unlock()
    __load_store()
    __store_saved = __store_touches
    __db_init()
    __block_signals()
    eprint("khrip: running {__every_count()} background task(s)")
    __timer_loop()
}

// Точка входа сервера: программа с route. Рабочих потоков — по числу
// доступных ядер (или THREADS); каждый со своим epoll и сокетом SO_REUSEPORT.
fn __serve() {
    __http_port = __env_int("PORT", 8080)
    __ignore_sigpipe()
    __store_init()
    __store_rw_init()
    __store_lock()
    __store_unlock()
    __load_store()
    __store_saved = __store_touches
    __db_init()
    __read_cpus()
    var n = __env_int("THREADS", __cpus.len())
    if n < 1 {
        n = 1
    }
    __threads = n
    let timers = __timers_wanted()
    if timers {
        __block_signals()
    }
    eprint("khrip: listening on http://0.0.0.0:{__http_port} ({n} threads)")
    for id in 1..n {
        let stack = syscall(SYS_MMAP, 0, THREAD_STACK, 3, 0x22 | 0x4000, -1, 0)
        __spawn(stack + THREAD_STACK, id)
    }
    if timers {
        let stack = syscall(SYS_MMAP, 0, THREAD_STACK, 3, 0x22 | 0x4000, -1, 0)
        __spawn(stack + THREAD_STACK, -1)
    }
    if n > 1 {
        __pin(__cpus[0])
    }
    __http_worker(0)
}
