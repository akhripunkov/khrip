// HTTP/1.1-сервер на epoll: один поток, неблокирующие сокеты, keep-alive,
// конвейерные запросы. Нужны lib/std.kh и lib/net.kh.
//
// Приложение определяет обработчик
//
//     fn handle(req: i64) { ... }
//
// и отвечает из него через respond / respond_text. Если обработчик не ответил,
// клиент получает 404. Запускается сервер вызовом http_serve(port).
//
// Это временный интерфейс шага v0.2: позже его заменят объявления route.

const HTTP_IN_SIZE = 16384
const HTTP_OUT_SIZE = 65536
const HTTP_SCRATCH_SIZE = 65536
const HTTP_MAX_FD = 65536
const HTTP_MAX_EVENTS = 512
const HTTP_DATE_LEN = 29

// Соединение
const CONN_IN = 0
const CONN_IN_LEN = 8
const CONN_OUT = 16
const CONN_SENT = 24
const CONN_CLOSE = 32
const CONN_WAIT_OUT = 40
const CONN_SIZE = 48

// Запрос, который получает обработчик
const REQ_METHOD = 0
const REQ_METHOD_LEN = 8
const REQ_PATH = 16
const REQ_PATH_LEN = 24
const REQ_QUERY = 32
const REQ_QUERY_LEN = 40
const REQ_BODY = 48
const REQ_BODY_LEN = 56
const REQ_SCRATCH = 64
const REQ_OUT = 72
const REQ_DONE = 80
const REQ_CLOSE = 88
const REQ_SIZE = 96

var http_ep: i64
var http_conns: i64
var http_events: i64
var http_req: i64
var http_date: i64
var http_date_sec: i64

// ---- Интерфейс для обработчиков ----

fn req_method_is(req: i64, method: i64) -> i64 {
    return mem_eq(load64(req + REQ_METHOD), load64(req + REQ_METHOD_LEN), method, strlen(method))
}

fn req_path_is(req: i64, path: i64) -> i64 {
    return mem_eq(load64(req + REQ_PATH), load64(req + REQ_PATH_LEN), path, strlen(path))
}

fn req_is(req: i64, method: i64, path: i64) -> i64 {
    return req_path_is(req, path) && req_method_is(req, method)
}

fn req_body(req: i64) -> i64 {
    return load64(req + REQ_BODY)
}

fn req_body_len(req: i64) -> i64 {
    return load64(req + REQ_BODY_LEN)
}

// Буфер для сборки тела ответа; очищается перед каждым запросом.
fn req_scratch(req: i64) -> i64 {
    return load64(req + REQ_SCRATCH)
}

fn http_reason(status: i64) -> i64 {
    if status == 200 {
        return "OK"
    }
    if status == 201 {
        return "Created"
    }
    if status == 204 {
        return "No Content"
    }
    if status == 400 {
        return "Bad Request"
    }
    if status == 404 {
        return "Not Found"
    }
    if status == 405 {
        return "Method Not Allowed"
    }
    if status == 413 {
        return "Payload Too Large"
    }
    if status == 431 {
        return "Request Header Fields Too Large"
    }
    if status == 500 {
        return "Internal Server Error"
    }
    if status == 501 {
        return "Not Implemented"
    }
    return "Unknown"
}

fn respond(req: i64, status: i64, content_type: i64, body: i64, body_len: i64) {
    if load64(req + REQ_DONE) {
        return
    }
    store64(req + REQ_DONE, 1)
    if body_len > HTTP_OUT_SIZE / 2 - 512 {
        store64(req + REQ_CLOSE, 1)
        status = 500
        content_type = "text/plain"
        body = "response too large"
        body_len = 18
    }
    let out = load64(req + REQ_OUT)
    buf_add(out, "HTTP/1.1 ", 9)
    buf_int(out, status)
    buf_byte(out, ' ')
    buf_str(out, http_reason(status))
    buf_add(out, "\r\nServer: Khrip\r\nDate: ", 23)
    buf_add(out, http_date, HTTP_DATE_LEN)
    buf_add(out, "\r\nContent-Type: ", 16)
    buf_str(out, content_type)
    buf_add(out, "\r\nContent-Length: ", 18)
    buf_int(out, body_len)
    if load64(req + REQ_CLOSE) {
        buf_add(out, "\r\nConnection: close", 19)
    }
    buf_add(out, "\r\n\r\n", 4)
    buf_add(out, body, body_len)
}

fn respond_text(req: i64, status: i64, text: i64) {
    respond(req, status, "text/plain", text, strlen(text))
}

// ---- Дата для заголовка Date: «Sun, 06 Nov 1994 08:49:37 GMT» ----

fn put_2digits(p: i64, v: i64) {
    store8(p, '0' + v / 10)
    store8(p + 1, '0' + v % 10)
}

// Unix-время → дата по RFC 7231. Перевод дней в дату — алгоритм civil_from_days
// Говарда Хиннанта.
fn format_http_date(out: i64, t: i64) {
    let days = t / 86400
    let secs = t % 86400
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    var month = mp + 3
    if mp >= 10 {
        month = mp - 9
    }
    var year = yoe + era * 400
    if month <= 2 {
        year = year + 1
    }
    memcpy(out, "SunMonTueWedThuFriSat" + (days + 4) % 7 * 3, 3)
    store8(out + 3, ',')
    store8(out + 4, ' ')
    put_2digits(out + 5, day)
    store8(out + 7, ' ')
    memcpy(out + 8, "JanFebMarAprMayJunJulAugSepOctNovDec" + (month - 1) * 3, 3)
    store8(out + 11, ' ')
    put_2digits(out + 12, year / 100)
    put_2digits(out + 14, year % 100)
    store8(out + 16, ' ')
    put_2digits(out + 17, secs / 3600)
    store8(out + 19, ':')
    put_2digits(out + 20, secs / 60 % 60)
    store8(out + 22, ':')
    put_2digits(out + 23, secs % 60)
    memcpy(out + 25, " GMT", 4)
}

// Дата пересчитывается не чаще раза в секунду.
fn http_update_date() {
    let t = syscall(SYS_TIME, 0)
    if t != http_date_sec {
        http_date_sec = t
        format_http_date(http_date, t)
    }
}

// ---- Разбор запросов ----

// Позиция сразу за «\r\n\r\n» или 0, если заголовки ещё не пришли целиком.
// Если байт — не \r и не \n, конец заголовков не может его включать,
// поэтому можно сразу перескочить на 4 байта.
fn http_header_end(p: i64, n: i64) -> i64 {
    var i = 3
    while i < n {
        let c = load8(p + i)
        if c == '\n' {
            if load8(p + i - 1) == '\r' && load8(p + i - 2) == '\n' && load8(p + i - 3) == '\r' {
                return i + 1
            }
            i = i + 1
        } else if c == '\r' {
            i = i + 1
        } else {
            i = i + 4
        }
    }
    return 0
}

// Ответ об ошибке протокола; соединение закроется после отправки.
fn http_error(c: i64, status: i64) {
    store64(c + CONN_CLOSE, 1)
    let r = http_req
    store64(r + REQ_OUT, load64(c + CONN_OUT))
    store64(r + REQ_DONE, 0)
    store64(r + REQ_CLOSE, 1)
    respond_text(r, status, http_reason(status))
}

// Разбирает один запрос с начала p и вызывает обработчик.
// → сколько байтов занял запрос, или 0, если он ещё не пришёл целиком.
fn http_request(c: i64, p: i64, n: i64) -> i64 {
    let hend = http_header_end(p, n)
    if hend == 0 {
        return 0
    }

    // Строка запроса: МЕТОД ПУТЬ ВЕРСИЯ
    var i = 0
    while i < hend && load8(p + i) != ' ' {
        i = i + 1
    }
    let method_len = i
    i = i + 1
    let path = p + i
    while i < hend && load8(p + i) != ' ' && load8(p + i) != '\r' {
        i = i + 1
    }
    let target_len = p + i - path
    if method_len == 0 || target_len == 0 || load8(p + i) != ' ' || load8(path) != '/' {
        http_error(c, 400)
        return n
    }
    i = i + 1
    if i + 8 > hend {
        http_error(c, 400)
        return n
    }
    var keep_alive = 1
    if mem_eq(p + i, 8, "HTTP/1.0", 8) {
        keep_alive = 0
    } else if !mem_eq(p + i, 8, "HTTP/1.1", 8) {
        http_error(c, 400)
        return n
    }
    while load8(p + i) != '\n' {
        i = i + 1
    }
    i = i + 1

    // Заголовки: нужны только Content-Length, Connection и Transfer-Encoding.
    var body_len = 0
    while i < hend - 2 {
        let line = p + i
        var j = i
        while load8(p + j) != '\r' {
            j = j + 1
        }
        let line_len = p + j - line
        var k = 0
        while k < line_len && load8(line + k) != ':' {
            k = k + 1
        }
        var v = k + 1
        while v < line_len && (load8(line + v) == ' ' || load8(line + v) == '\t') {
            v = v + 1
        }
        let value = line + v
        let value_len = line_len - v
        if k == line_len {
            http_error(c, 400)
            return n
        }
        if mem_ieq(line, k, "content-length", 14) {
            body_len = parse_uint(value, value_len)
            if body_len < 0 {
                http_error(c, 400)
                return n
            }
        } else if mem_ieq(line, k, "connection", 10) {
            if mem_ieq(value, value_len, "close", 5) {
                keep_alive = 0
            } else if mem_ieq(value, value_len, "keep-alive", 10) {
                keep_alive = 1
            }
        } else if mem_ieq(line, k, "transfer-encoding", 17) {
            http_error(c, 501)
            return n
        }
        i = j + 2
    }

    // Тело
    if body_len > HTTP_IN_SIZE - hend {
        http_error(c, 413)
        return n
    }
    if hend + body_len > n {
        return 0
    }

    // Путь и строка запроса после «?»
    var path_len = 0
    while path_len < target_len && load8(path + path_len) != '?' {
        path_len = path_len + 1
    }
    var query_len = target_len - path_len - 1
    if query_len < 0 {
        query_len = 0
    }

    if !keep_alive {
        store64(c + CONN_CLOSE, 1)
    }
    let r = http_req
    store64(r + REQ_METHOD, p)
    store64(r + REQ_METHOD_LEN, method_len)
    store64(r + REQ_PATH, path)
    store64(r + REQ_PATH_LEN, path_len)
    store64(r + REQ_QUERY, path + path_len + 1)
    store64(r + REQ_QUERY_LEN, query_len)
    store64(r + REQ_BODY, p + hend)
    store64(r + REQ_BODY_LEN, body_len)
    store64(r + REQ_OUT, load64(c + CONN_OUT))
    store64(r + REQ_DONE, 0)
    store64(r + REQ_CLOSE, !keep_alive)
    buf_reset(load64(r + REQ_SCRATCH))
    handle(r)
    if !load64(r + REQ_DONE) {
        respond_text(r, 404, "Not Found")
    }
    return hend + body_len
}

// ---- Соединения ----

fn http_conn(fd: i64) -> i64 {
    return load64(http_conns + fd * 8)
}

fn http_close(fd: i64) {
    syscall(SYS_CLOSE, fd)
}

// Отправляет накопленные ответы. → 1, если всё отправлено и соединение живо;
// 0, если ждём готовности сокета к записи или соединение закрыто.
fn http_flush(fd: i64, c: i64) -> i64 {
    let out = load64(c + CONN_OUT)
    var sent = load64(c + CONN_SENT)
    let total = buf_len(out)
    while sent < total {
        let w = syscall(SYS_WRITE, fd, buf_ptr(out) + sent, total - sent)
        if w == -EAGAIN {
            store64(c + CONN_SENT, sent)
            if !load64(c + CONN_WAIT_OUT) {
                store64(c + CONN_WAIT_OUT, 1)
                epoll_ctl(http_ep, EPOLL_CTL_MOD, fd, EPOLLOUT)
            }
            return 0
        }
        if w <= 0 {
            http_close(fd)
            return 0
        }
        sent = sent + w
    }
    buf_reset(out)
    store64(c + CONN_SENT, 0)
    if load64(c + CONN_CLOSE) {
        http_close(fd)
        return 0
    }
    if load64(c + CONN_WAIT_OUT) {
        store64(c + CONN_WAIT_OUT, 0)
        epoll_ctl(http_ep, EPOLL_CTL_MOD, fd, EPOLLIN)
    }
    return 1
}

// Обрабатывает все полные запросы из входного буфера и отправляет ответы.
fn http_process(fd: i64, c: i64) {
    while 1 {
        let inp = load64(c + CONN_IN)
        let len = load64(c + CONN_IN_LEN)
        let out = load64(c + CONN_OUT)
        var off = 0
        var more = 0
        while off < len && !load64(c + CONN_CLOSE) {
            if buf_len(out) >= HTTP_OUT_SIZE / 2 {
                more = 1
                break
            }
            let used = http_request(c, inp + off, len - off)
            if used == 0 {
                break
            }
            off = off + used
        }
        if off > 0 {
            memcpy(inp, inp + off, len - off)
            store64(c + CONN_IN_LEN, len - off)
        }
        if !load64(c + CONN_CLOSE) && load64(c + CONN_IN_LEN) == HTTP_IN_SIZE {
            http_error(c, 431)
        }
        if !http_flush(fd, c) || !more {
            return
        }
    }
}

fn http_read(fd: i64, c: i64) {
    let inp = load64(c + CONN_IN)
    let len = load64(c + CONN_IN_LEN)
    let n = syscall(SYS_READ, fd, inp + len, HTTP_IN_SIZE - len)
    if n == -EAGAIN {
        return
    }
    if n <= 0 {
        http_close(fd)
        return
    }
    store64(c + CONN_IN_LEN, len + n)
    http_process(fd, c)
}

fn http_accept(lfd: i64) {
    while 1 {
        let fd = tcp_accept(lfd)
        if fd < 0 {
            return
        }
        if fd >= HTTP_MAX_FD {
            http_close(fd)
            continue
        }
        tcp_nodelay(fd)
        var c = http_conn(fd)
        if c == 0 {
            c = alloc(CONN_SIZE)
            store64(c + CONN_IN, alloc(HTTP_IN_SIZE))
            store64(c + CONN_OUT, buf_new(HTTP_OUT_SIZE))
            store64(http_conns + fd * 8, c)
        }
        store64(c + CONN_IN_LEN, 0)
        buf_reset(load64(c + CONN_OUT))
        store64(c + CONN_SENT, 0)
        store64(c + CONN_CLOSE, 0)
        store64(c + CONN_WAIT_OUT, 0)
        epoll_ctl(http_ep, EPOLL_CTL_ADD, fd, EPOLLIN)
    }
}

fn http_event(fd: i64, flags: i64) {
    let c = http_conn(fd)
    if flags & (EPOLLERR | EPOLLHUP) {
        http_close(fd)
        return
    }
    if load64(c + CONN_WAIT_OUT) {
        if flags & EPOLLOUT && http_flush(fd, c) {
            http_process(fd, c)
        }
        return
    }
    http_read(fd, c)
}

fn http_serve(port: i64) {
    ignore_sigpipe()
    let lfd = tcp_listen(port)
    if lfd < 0 {
        eprint("http: cannot listen on the port\n")
        exit(1)
    }
    http_ep = epoll_new()
    http_conns = alloc(HTTP_MAX_FD * 8)
    http_events = alloc(HTTP_MAX_EVENTS * EPOLL_EVENT_SIZE)
    http_req = alloc(REQ_SIZE)
    store64(http_req + REQ_SCRATCH, buf_new(HTTP_SCRATCH_SIZE))
    http_date = alloc(32)
    http_update_date()
    epoll_ctl(http_ep, EPOLL_CTL_ADD, lfd, EPOLLIN)
    while 1 {
        let n = epoll_wait(http_ep, http_events, HTTP_MAX_EVENTS, -1)
        http_update_date()
        var i = 0
        while i < n {
            let e = http_events + i * EPOLL_EVENT_SIZE
            let fd = epoll_event_fd(e)
            if fd == lfd {
                http_accept(lfd)
            } else {
                http_event(fd, epoll_event_flags(e))
            }
            i = i + 1
        }
    }
}
