// float: печать, разбор, методы. Арифметику и сравнения компилятор делает сам
// (SSE2); x.to_int() и n.to_float() — тоже. Точный перевод между десятичной
// записью и двоичной — на длинных целых (__dec_to_f64 в lib/core.kh).

const F64_ABS = 0x7FFFFFFFFFFFFFFF

fn __float_abs(self: float) -> float {
    if self < 0 {
        return -self
    }
    return self
}

fn __float_floor(self: float) -> int {
    let t = self.to_int()
    if t.to_float() > self {
        return t - 1
    }
    return t
}

fn __float_ceil(self: float) -> int {
    let t = self.to_int()
    if t.to_float() < self {
        return t + 1
    }
    return t
}

// Округление к ближайшему целому, половина — от нуля (2.5 → 3, -2.5 → -3).
fn __float_round(self: float) -> int {
    if self < 0 {
        return 0 - (0.5 - self).floor()
    }
    return (self + 0.5).floor()
}

fn __pow10f(e: int) -> float {
    var r = 1.0
    for i in 0..e {
        r = r * 10.0
    }
    return r
}

// Округление до digits знаков после точки: 12.345.round_to(1) == 12.3.
fn __float_round_to(self: float, digits: int) -> float {
    let k = __pow10f(digits)
    return (self * k).round().to_float() / k
}

fn __float_sqrt(self: float) -> float {
    return __fsqrt(self)
}

fn __float_min(self: float, other: float) -> float {
    if other < self {
        return other
    }
    return self
}

fn __float_max(self: float, other: float) -> float {
    if other > self {
        return other
    }
    return self
}

fn __list_sum_float(self: [float]) -> float {
    var s = 0.0
    for x in self {
        s += x
    }
    return s
}

// ---- Разбор ----

// Число в [p, p + n): [-+]цифры[.цифры][e[-+]цифры] — целиком, иначе none.
fn __float_parse(p: int, n: int) -> float? {
    var i = 0
    var neg = false
    if i < n && (load8(p) == '-' || load8(p) == '+') {
        neg = load8(p) == '-'
        i += 1
    }
    let start = i
    var digits = 0
    var sig = 0
    var mant = 0
    var e10 = 0
    var frac = false
    while i < n {
        let c = load8(p + i)
        if c >= '0' && c <= '9' {
            digits += 1
            if sig > 0 || c != '0' {
                sig += 1
            }
            if sig <= 18 {
                mant = mant * 10 + (c - '0')
                if frac {
                    e10 -= 1
                }
            } else if !frac {
                e10 += 1
            }
        } else if c == '.' && !frac {
            frac = true
        } else {
            break
        }
        i += 1
    }
    if digits == 0 {
        return none
    }
    let span = i - start
    var ex = 0
    if i < n && (load8(p + i) == 'e' || load8(p + i) == 'E') {
        i += 1
        var eneg = false
        if i < n && (load8(p + i) == '-' || load8(p + i) == '+') {
            eneg = load8(p + i) == '-'
            i += 1
        }
        let es = i
        while i < n && load8(p + i) >= '0' && load8(p + i) <= '9' {
            if ex < 100000 {
                ex = ex * 10 + (load8(p + i) - '0')
            }
            i += 1
        }
        if i == es {
            return none
        }
        if eneg {
            ex = 0 - ex
        }
    }
    if i != n {
        return none
    }
    var r = 0.0
    let e = e10 + ex
    if sig <= 15 && e >= -22 && e <= 22 {
        // быстрый путь: целая мантисса и степень десяти точны в double, одно округление
        r = mant.to_float()
        if e >= 0 {
            r = r * __pow10f(e)
        } else {
            r = r / __pow10f(0 - e)
        }
    } else {
        r = __cast(__dec_to_f64(p + start, span, ex))
    }
    if neg {
        return -r
    }
    return r
}

fn __str_to_float(self: str) -> float? {
    return __float_parse(__str_ptr(self), self.len())
}

// ---- Печать: самая короткая запись, которая читается обратно в то же число ----

fn __big_from(v: int) -> [int] {
    var a: [int] = []
    a.push(v & 0xFFFFFFFF)
    a.push((v >> 32) & 0xFFFFFFFF)
    __big_trim(a)
    return a
}

fn __big_times10(a: [int], n: int) {
    var i = 0
    while i < n {
        __big_mul_add(a, 10, 0)
        i += 1
    }
}

// Сравнение mant × 2^e2 с 10^k.
fn __f64_cmp_pow10(mant: int, e2: int, k: int) -> int {
    var a = __big_from(mant)
    var b: [int] = []
    b.push(1)
    if e2 > 0 {
        a = __big_shl(a, e2)
    } else if e2 < 0 {
        b = __big_shl(b, 0 - e2)
    }
    if k > 0 {
        __big_times10(b, k)
    } else if k < 0 {
        __big_times10(a, 0 - k)
    }
    return __big_cmp(a, b)
}

// round(mant × 2^e2 × 10^(p − 1 − k)) — p значащих цифр, к ближайшему (к чётному).
fn __f64_digits(mant: int, e2: int, k: int, p: int) -> int {
    let s = p - 1 - k
    var num = __big_from(mant)
    var den: [int] = []
    den.push(1)
    if e2 > 0 {
        num = __big_shl(num, e2)
    } else if e2 < 0 {
        den = __big_shl(den, 0 - e2)
    }
    if s > 0 {
        __big_times10(num, s)
    } else if s < 0 {
        __big_times10(den, 0 - s)
    }
    let q = __big_divmod(num, den)
    var v = __big_word(q, 0) | (__big_word(q, 1) << 32)
    __big_mul_add(num, 2, 0)
    let c = __big_cmp(num, den)
    if c > 0 || (c == 0 && (v & 1) == 1) {
        v += 1
    }
    return v
}

// Цифры ds (первая — при 10^k) → текст, как в JavaScript.
fn __format_dec(digits: str, k: int) -> str {
    var n = digits.len()
    while n > 1 && digits[n - 1] == '0' {
        n -= 1
    }
    let ds = digits[0..n]
    if k >= 21 || k < -6 {
        var r = ds[0..1]
        if n > 1 {
            r = r + "." + ds[1..n]
        }
        if k >= 0 {
            return r + "e+" + k.to_str()
        }
        return r + "e-" + (0 - k).to_str()
    }
    if k < 0 {
        return "0." + "0".repeat(0 - k - 1) + ds
    }
    if n <= k + 1 {
        return ds + "0".repeat(k + 1 - n)
    }
    return ds[0..k + 1] + "." + ds[k + 1..n]
}

fn __float_to_str(self: float) -> str {
    let bits: int = __cast(self)
    let ab = bits & F64_ABS
    var sign = ""
    if bits < 0 {
        sign = "-"
    }
    let e = ab >> 52
    let f = ab & 0xFFFFFFFFFFFFF
    if e == 0x7FF {
        if f != 0 {
            return "NaN"
        }
        return sign + "Infinity"
    }
    if ab == 0 {
        return "0"
    }
    var mant = f
    var e2 = -1074
    if e > 0 {
        mant = f | (1 << 52)
        e2 = e - 1075
    }
    // целое значение — без дробной части
    if e2 >= 0 && e2 <= 10 {
        return sign + (mant << e2).to_str()
    }
    if e2 < 0 && e2 > -53 && (mant & ((1 << (0 - e2)) - 1)) == 0 {
        return sign + (mant >> (0 - e2)).to_str()
    }
    // Быстрый путь для обычных дробей (цены, проценты): наименьшее число знаков
    // после точки d, при котором округлённое v·10^d, делённое на 10^d, даёт ровно
    // v. Оба числа точные, деление округляется верно — значит, такая запись
    // разбирается обратно в то же число и короче не бывает.
    let av: float = __cast(ab)
    if av >= 0.000001 && av < 1000000000000000.0 {
        var p10 = 1.0
        for d in 1..16 {
            p10 = p10 * 10.0
            let x = av * p10
            if x >= 9007199254740992.0 {
                break
            }
            let m = x.round()
            var hit = -1
            if m.to_float() / p10 == av {
                hit = m
            } else if (m - 1).to_float() / p10 == av {
                hit = m - 1
            } else if (m + 1).to_float() / p10 == av {
                hit = m + 1
            }
            if hit >= 0 && hit >= 1000000000000000 {
                // 16–17 значащих цифр: подойти могут две записи, нужна ближайшая —
                // это решает точный путь
                break
            }
            if hit >= 0 {
                var ds = hit.to_str()
                while ds.len() <= d {
                    ds = "0" + ds
                }
                return sign + ds[..ds.len() - d] + "." + ds[ds.len() - d..]
            }
        }
    }
    // k = порядок первой значащей цифры
    var bl = 0
    var t = mant
    while t > 0 {
        bl += 1
        t = t >> 1
    }
    var k = ((bl + e2 - 1) * 78913) >> 18
    if __f64_cmp_pow10(mant, e2, k) < 0 {
        k -= 1
    } else if __f64_cmp_pow10(mant, e2, k + 1) >= 0 {
        k += 1
    }
    var best = ""
    var best_k = k
    var p = 1
    while p <= 17 {
        var q = __f64_digits(mant, e2, k, p)
        var kk = k
        let top = __pow10i(p)
        if q >= top {
            q = q / 10
            kk += 1
        }
        let ds = q.to_str()
        best = ds
        best_k = kk
        if __dec_to_f64(__str_ptr(ds), ds.len(), kk - (p - 1)) == ab {
            return sign + __format_dec(ds, kk)
        }
        p += 1
    }
    return sign + __format_dec(best, best_k)
}

fn __pow10i(p: int) -> int {
    var r = 1
    for i in 0..p {
        r *= 10
    }
    return r
}
