// Язык и база: места запросов sql "...", которые собрал компилятор (src/sql.kh).
//
// При запуске (__db_start): подключение, миграции, затем каждое место
// проверяется самим PostgreSQL (Parse + Describe): типы параметров, столбцы
// и их типы против ожидаемого типа Khrip, NOT NULL — по каталогу. Ошибка —
// выход с кодом 1 и местом в исходнике: запрос с опечаткой не доживает до
// первого запроса клиента. Проверка строит план раскладки строк для каждого
// места; рабочие потоки только читают его.
//
// Запрос (__db_run): соединение из запаса потока (или соединение транзакции),
// параметры по виду Khrip и типу столбца, результат — по форме места.
// Ошибка базы завершает запрос статусом: дубликат 409, нет ссылки 404, плохое
// значение 400, база недоступна 503, остальное 500.

// Слова места запроса (их пишет компилятор, src/sql.kh)
const SITE_SQL = 0
const SITE_NVALS = 8
const SITE_NPARAMS = 16
const SITE_PARAMS = 24
const SITE_SHAPE = 32
const SITE_DESC = 40
const SITE_LOC = 48
const SITE_TARGET = 56
const SITE_INDEX = 64
// заполняет рантайм при запуске
const SITE_OIDS = 72
const SITE_PLAN = 80
const SITE_SCALAR = 88
const SITE_COUNT = 96
const SITE_FALLBACK = 104
// таблица вариантов ORDER BY {o}: номер значения, число, пары (строка, место)
const SITE_VARIANTS = 112
// ключи строк для очереди повторов tx: число, пары («таблица.столбец», параметр)
const SITE_KEYS = 120

const SH_COUNT = 0
const SH_ONE = 1
const SH_OPT = 2
const SH_LIST = 3

const PK_VAL = 1
const PK_ISNULL = 2
const PK_LIKE = 3
const PK_TEXT = 4
const PK_FIELD = 5
const PK_COLUMN = 6
const PK_GIVEN = 7

// Типы PostgreSQL (pg_type.oid)
const OID_BOOL = 16
const OID_BYTEA = 17
const OID_CHAR = 18
const OID_NAME = 19
const OID_INT8 = 20
const OID_INT2 = 21
const OID_INT4 = 23
const OID_TEXT = 25
const OID_OID = 26
const OID_JSON = 114
const OID_FLOAT4 = 700
const OID_FLOAT8 = 701
const OID_UNKNOWN = 705
const OID_BPCHAR = 1042
const OID_VARCHAR = 1043
const OID_DATE = 1082
const OID_TIME = 1083
const OID_TIMESTAMP = 1114
const OID_TIMESTAMPTZ = 1184
const OID_INTERVAL = 1186
const OID_NUMERIC = 1700
const OID_UUID = 2950
const OID_JSONB = 3802

// Как значение столбца становится значением Khrip
const CV_INT = 1
const CV_FLOAT = 2
const CV_BOOL = 3
const CV_STR = 4
const CV_TIME_INT = 5
const CV_TIME_STR = 6
const CV_BYTES = 7
const CV_JSON = 8
const CV_ARRAY = 9
const CV_ENUM = 10

// Время на запрос к базе (мс): ожидание соединения, сам запрос и повторы.
fn __db_timeout() -> int {
    return __env_int("DATABASE_TIMEOUT", 10000)
}

// ---- Типы PostgreSQL ----

fn __oid_int(o: int) -> bool {
    return o == OID_INT2 || o == OID_INT4 || o == OID_INT8 || o == OID_OID
}

fn __oid_float(o: int) -> bool {
    return o == OID_FLOAT4 || o == OID_FLOAT8 || o == OID_NUMERIC
}

fn __oid_time(o: int) -> bool {
    return o == OID_TIMESTAMPTZ || o == OID_TIMESTAMP || o == OID_DATE
}

fn __oid_json(o: int) -> bool {
    return o == OID_JSON || o == OID_JSONB
}

// Тип, который PostgreSQL читает из текста: строка Khrip подходит к нему.
fn __oid_texty(o: int) -> bool {
    return o == OID_TEXT || o == OID_VARCHAR || o == OID_BPCHAR || o == OID_NAME || o == OID_CHAR || o == OID_UUID || o == OID_DATE || o == OID_TIME || o == OID_TIMESTAMP || o == OID_TIMESTAMPTZ || o == OID_INTERVAL || o == OID_JSON || o == OID_JSONB || o == OID_BYTEA || o == OID_NUMERIC || o == OID_UNKNOWN || o == 869 || o == 650 || o == 829 || o == 142 || o >= 16384
}

// Элемент массива: OID массива → OID элемента (0 — не массив).
fn __oid_elem(o: int) -> int {
    if o == 1000 {
        return OID_BOOL
    }
    if o == 1005 {
        return OID_INT2
    }
    if o == 1007 {
        return OID_INT4
    }
    if o == 1016 {
        return OID_INT8
    }
    if o == 1009 {
        return OID_TEXT
    }
    if o == 1015 {
        return OID_VARCHAR
    }
    if o == 1014 {
        return OID_BPCHAR
    }
    if o == 1021 {
        return OID_FLOAT4
    }
    if o == 1022 {
        return OID_FLOAT8
    }
    if o == 1231 {
        return OID_NUMERIC
    }
    if o == 2951 {
        return OID_UUID
    }
    if o == 1115 {
        return OID_TIMESTAMP
    }
    if o == 1185 {
        return OID_TIMESTAMPTZ
    }
    if o == 1182 {
        return OID_DATE
    }
    if o == 199 {
        return OID_JSON
    }
    if o == 3807 {
        return OID_JSONB
    }
    if o == 1001 {
        return OID_BYTEA
    }
    // массивы типов программы (перечисления, домены, citext): из pg_type при запуске
    return __db_user_elem[o] ?? 0
}

// Типы базы с OID от 16384: элемент массива и имя (читаются один раз при запуске).
var __db_user_elem: map[int, int] = {}
var __db_user_name: map[int, str] = {}

fn __db_load_types(c: int, deadline: int) {
    let r = __pg_exec(c, "select oid::bigint, typelem::bigint, format_type(oid, null), typcategory::text from pg_type where oid >= 16384", [], deadline)
    for i in 0..r.rows {
        let o = __pg_int(r, 4 * i)
        __db_user_name[o] = __pg_str(r, 4 * i + 2)
        if __pg_str(r, 4 * i + 3) == "A" {
            __db_user_elem[o] = __pg_int(r, 4 * i + 1)
        }
    }
}

// Значение варианта перечисления по метке или -1.
fn __db_enum_value(d: int, label: str) -> int {
    let n = load64(d + 8)
    for j in 0..n {
        let e = d + 32 + j * 24
        let vn: str = __cast(load64(e))
        if vn == label {
            return load64(e + 16)
        }
    }
    return -1
}

fn __oid_name(o: int) -> str {
    if o == OID_BOOL {
        return "boolean"
    }
    if o == OID_INT2 {
        return "smallint"
    }
    if o == OID_INT4 {
        return "integer"
    }
    if o == OID_INT8 {
        return "bigint"
    }
    if o == OID_TEXT {
        return "text"
    }
    if o == OID_VARCHAR {
        return "varchar"
    }
    if o == OID_FLOAT4 {
        return "real"
    }
    if o == OID_FLOAT8 {
        return "double precision"
    }
    if o == OID_NUMERIC {
        return "numeric"
    }
    if o == OID_TIMESTAMPTZ {
        return "timestamptz"
    }
    if o == OID_TIMESTAMP {
        return "timestamp"
    }
    if o == OID_DATE {
        return "date"
    }
    if o == OID_UUID {
        return "uuid"
    }
    if o == OID_JSON {
        return "json"
    }
    if o == OID_JSONB {
        return "jsonb"
    }
    if o == OID_BYTEA {
        return "bytea"
    }
    if o == OID_INTERVAL {
        return "interval"
    }
    let e = __oid_elem(o)
    if e != 0 {
        return __oid_name(e) + "[]"
    }
    return __db_user_name[o] ?? "type {o}"
}

// Название типа Khrip по описанию (для сообщений).
fn __desc_name(d: int) -> str {
    let k = load64(d)
    if k == D_INT {
        return "int"
    }
    if k == D_FLOAT {
        return "float"
    }
    if k == D_BOOL {
        return "bool"
    }
    if k == D_STR {
        return "str"
    }
    if k == D_OPT {
        return __desc_name(load64(d + 8)) + "?"
    }
    if k == D_LIST {
        return "[" + __desc_name(load64(d + 8)) + "]"
    }
    if k == D_MAP {
        return "map"
    }
    let name: str = __cast(load64(d + 16))
    return name
}

// Перечисление: вариант без полей у каждого значения.
fn __desc_enum(d: int) -> bool {
    if load64(d) != D_SUM {
        return false
    }
    let n = load64(d + 8)
    for i in 0..n {
        if load64(d + 32 + i * 24 + 16) == 0 {
            return false
        }
    }
    return true
}

// Тип параметра, если сервер не вывел его сам.
fn __desc_oid(d: int) -> int {
    let k = load64(d)
    if k == D_OPT {
        return __desc_oid(load64(d + 8))
    }
    if k == D_INT {
        return OID_INT8
    }
    if k == D_FLOAT {
        return OID_FLOAT8
    }
    if k == D_BOOL {
        return OID_BOOL
    }
    if k == D_STR || __desc_enum(d) {
        return OID_TEXT
    }
    if k == D_LIST {
        let e = load64(load64(d + 8))
        if e == D_INT {
            return 1016
        }
        if e == D_FLOAT {
            return 1022
        }
        if e == D_BOOL {
            return 1000
        }
        if e == D_STR {
            return 1009
        }
    }
    return OID_JSONB
}

// Подходит ли значение Khrip (описание d) к параметру типа o → "" или почему нет.
fn __param_fits(d: int, o: int) -> str {
    var k = load64(d)
    var dd = d
    if k == D_OPT {
        dd = load64(d + 8)
        k = load64(dd)
    }
    if o == 0 || o == OID_UNKNOWN {
        return ""
    }
    if k == D_INT {
        if __oid_int(o) || __oid_float(o) || __oid_time(o) {
            return ""
        }
        return "it is int"
    }
    if k == D_FLOAT {
        if o == OID_FLOAT4 || o == OID_FLOAT8 || o == OID_NUMERIC {
            return ""
        }
        if __oid_int(o) {
            return "it is float and PostgreSQL would round it silently: use .round() or a numeric column"
        }
        return "it is float"
    }
    if k == D_BOOL {
        if o == OID_BOOL {
            return ""
        }
        return "it is bool"
    }
    if k == D_STR || __desc_enum(dd) {
        // строку разбирает сервер: годится любой тип, кроме чисел, bool и
        // массивов (tsrange, timetz, tsvector, money, inet, домены...)
        if __oid_texty(o) || (o != OID_BOOL && !__oid_int(o) && !__oid_float(o) && __oid_elem(o) == 0) {
            return ""
        }
        if __oid_int(o) || __oid_float(o) {
            return "it is str: parse it first, e.g. let n = s.to_int() else \{ return 400 }"
        }
        return "it is str"
    }
    if k == D_LIST {
        if __oid_elem(o) != 0 || __oid_json(o) {
            return ""
        }
        return "it is a list: compare with = ANY(\{list}) or store it in an array or jsonb column"
    }
    if __oid_json(o) {
        return ""
    }
    return "it is " + __desc_name(dd) + ": store it in a jsonb column or pass its fields"
}

// ---- Параметры ----

fn __db_scalar_text(d: int, v: int, o: int) -> str {
    let k = load64(d)
    if k == D_INT {
        if o == OID_TIMESTAMPTZ || o == OID_TIMESTAMP {
            return time_iso(v)
        }
        if o == OID_DATE {
            return time_iso(v).byte_slice(0, 10)
        }
        return v.to_str()
    }
    if k == D_FLOAT {
        let f: float = __cast(v)
        return f.to_str()
    }
    if k == D_BOOL {
        if v != 0 {
            return "t"
        }
        return "f"
    }
    if k == D_STR {
        let s: str = __cast(v)
        if o == OID_BYTEA {
            return __pg_bytes_param(s)
        }
        return s
    }
    let j = __json_encode(v, d)
    if __desc_enum(d) && !__oid_json(o) && j.byte_len() >= 2 {
        return j.byte_slice(1, j.byte_len() - 1)
    }
    return j
}

// Значение параметра: текст для Bind или none (NULL).
fn __db_encode(d: int, v: int, o: int) -> str? {
    let k = load64(d)
    if k == D_OPT {
        if v == 0 {
            return none
        }
        let inner = load64(d + 8)
        if __is_scalar(inner) {
            return __db_encode(inner, load64(v), o)
        }
        return __db_encode(inner, v, o)
    }
    if k == D_LIST && !__oid_json(o) {
        let ed = load64(d + 8)
        var items: [str?] = []
        let eo = __oid_elem(o)
        if load64(ed) == D_BOOL {
            let xs: [bool] = __cast(v)
            for x in xs {
                if x {
                    items.push("t")
                } else {
                    items.push("f")
                }
            }
        } else {
            let xs: [int] = __cast(v)
            for x in xs {
                items.push(__db_encode(ed, x, eo))
            }
        }
        return __pg_arr_param(items)
    }
    return __db_scalar_text(d, v, o)
}

fn __like_escape(s: str) -> str {
    return s.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
}

// Параметры места из значений на стеке (значение i — по адресу vals + (n-1-i)*8).
fn __db_params(site: int, vals: int) -> [str?] {
    let nv = load64(site + SITE_NVALS)
    let np = load64(site + SITE_NPARAMS)
    let pt = load64(site + SITE_PARAMS)
    let oids: [int] = __cast(load64(site + SITE_OIDS))
    var out: [str?] = []
    for i in 0..np {
        let kind = load64(pt + i * 32)
        let d = load64(pt + i * 32 + 8)
        let v = load64(vals + (nv - 1 - load64(pt + i * 32 + 16)) * 8)
        let f = load64(pt + i * 32 + 24)
        var o = 0
        if oids.len() > i {
            o = oids[i]
        }
        if kind == PK_ISNULL {
            if v == 0 {
                out.push("t")
            } else {
                out.push("f")
            }
        } else if kind == PK_LIKE {
            if let s = __db_encode(d, v, OID_TEXT) {
                out.push(__like_escape(s))
            } else {
                out.push(none)
            }
        } else if kind == PK_TEXT {
            out.push(__db_encode(d, v, OID_TEXT))
        } else if kind == PK_FIELD {
            out.push(__db_encode(d, load64(v + f * 8), o))
        } else if kind == PK_GIVEN {
            if load64(v + f * 8) != 0 || __json_null_sent(v, f) {
                out.push("t")
            } else {
                out.push("f")
            }
        } else if kind == PK_COLUMN {
            // список структур: значения поля f всех элементов — массивом
            let xs: [int] = __cast(v)
            if load64(load64(d + 8)) == D_BOOL {
                // [bool] в памяти — по байту на элемент
                var bs: [bool] = []
                for x in xs {
                    bs.push(load64(x + f * 8) != 0)
                }
                out.push(__db_encode(d, __cast(bs), o))
            } else {
                var col: [int] = []
                for x in xs {
                    col.push(load64(x + f * 8))
                }
                out.push(__db_encode(d, __cast(col), o))
            }
        } else {
            out.push(__db_encode(d, v, o))
        }
    }
    return out
}

// ---- Строки результата ----

// Где значение: место запроса и поле (fi < 0 — единственный столбец). Строится
// только для сообщения об ошибке.
fn __db_at(site: int, fi: int) -> str {
    let loc: str = __cast(load64(site + SITE_LOC))
    if fi < 0 {
        return loc + ": the column"
    }
    let d = load64(site + SITE_DESC)
    let fname: str = __cast(load64(__field(d, fi)))
    return loc + ": " + __desc_name(d) + "." + fname
}

fn __db_decode(r: __PgRes, i: int, d: int, cv: int, site: int, fi: int) -> int {
    let k = load64(d)
    if k == D_OPT {
        if __pg_null(r, i) {
            return 0
        }
        let inner = load64(d + 8)
        let v = __db_decode(r, i, inner, cv, site, fi)
        if __is_scalar(inner) {
            let b = __alloc(8)
            store64(b, v)
            return b
        }
        return v
    }
    if __pg_null(r, i) {
        __panic_msg("{__db_at(site, fi)} is NULL, but its type {__desc_name(d)} has no none: make it {__desc_name(d)}? or use coalesce(...) in the query")
    }
    if cv == CV_INT {
        return __pg_int(r, i)
    }
    if cv == CV_FLOAT {
        let f = __pg_float(r, i)
        return __cast(f)
    }
    if cv == CV_BOOL {
        if __pg_bool(r, i) {
            return 1
        }
        return 0
    }
    if cv == CV_TIME_INT {
        return __pg_time(r, i)
    }
    if cv == CV_TIME_STR {
        let s = __pg_str(r, i)
        if s.byte_len() == 10 {
            return __cast(s)
        }
        return __cast(time_iso(__pg_time(r, i)))
    }
    if cv == CV_BYTES {
        return __cast(__pg_bytes(r, i))
    }
    if cv == CV_JSON {
        let v = __json_decode(__pg_str(r, i), d)
        if v == 0 {
            __panic_msg("{__db_at(site, fi)}: the JSON from the database does not fit {__desc_name(d)}: {json_error()}")
        }
        if __is_scalar(d) {
            return load64(v)
        }
        return v
    }
    if cv == CV_ENUM {
        let label = __pg_str(r, i)
        let ev = __db_enum_value(d, label)
        if ev >= 0 {
            return ev
        }
        __panic_msg("{__db_at(site, fi)} is '{label}', which is not a value of {__desc_name(d)}")
    }
    if cv == CV_ARRAY {
        let items = __pg_arr(r, i)
        let ed = load64(d + 8)
        let ek = load64(ed)
        if ek == D_BOOL {
            var xs: [bool] = []
            for x in items {
                let s = x else {
                    __panic_msg("{__db_at(site, fi)} has a NULL element, but its type {__desc_name(d)} has no none")
                    return 0
                }
                xs.push(s == "t")
            }
            return __cast(xs)
        }
        var xs: [int] = []
        for x in items {
            let s = x else {
                __panic_msg("{__db_at(site, fi)} has a NULL element, but its type {__desc_name(d)} has no none")
                return 0
            }
            if ek == D_INT {
                let v = s.to_int() else {
                    __panic_msg("{__db_at(site, fi)} has the element {s}, which is not an int")
                    return 0
                }
                xs.push(v)
            } else if ek == D_FLOAT {
                var f = 0.0
                if s == "NaN" {
                    f = __cast(0x7FF8000000000000)
                } else if s == "Infinity" {
                    f = __cast(0x7FF0000000000000)
                } else if s == "-Infinity" {
                    f = __cast(-4503599627370496)
                } else {
                    let parsed = s.to_float() else {
                        __panic_msg("{__db_at(site, fi)} has the element {s}, which is not a float")
                        return 0
                    }
                    f = parsed
                }
                xs.push(__cast(f))
            } else if __desc_enum(ed) {
                let ev = __db_enum_value(ed, s)
                if ev < 0 {
                    __panic_msg("{__db_at(site, fi)} has '{s}', which is not a value of {__desc_name(ed)}")
                }
                xs.push(ev)
            } else {
                xs.push(__cast(s))
            }
        }
        return __cast(xs)
    }
    return __cast(__pg_str(r, i))
}

// Строка row → значение по плану места (структура или одно значение).
fn __db_row(site: int, r: __PgRes, row: int) -> int {
    let d = load64(site + SITE_DESC)
    let plan: [int] = __cast(load64(site + SITE_PLAN))
    let base = row * r.cols
    if load64(site + SITE_SCALAR) != 0 {
        return __db_decode(r, base, d, plan[1], site, -1)
    }
    let s = __struct_alloc(d)
    let n = load64(d + 8)
    for fi in 0..n {
        let col = plan[2 * fi]
        let fd = __field_desc(d, fi)
        let f = __field(d, fi)
        if col < 0 {
            // столбца нет: значение по умолчанию поля
            let dk = load64(f + 24)
            if dk == 1 {
                store64(s + fi * 8, load64(f + 32))
            } else if dk == 2 {
                store64(s + fi * 8, __list_new(4, load64(f + 32)))
            } else if dk == 3 {
                store64(s + fi * 8, __map_new(load64(f + 32)))
            } else {
                store64(s + fi * 8, 0)
            }
            continue
        }
        store64(s + fi * 8, __db_decode(r, base + col, fd, plan[2 * fi + 1], site, fi))
    }
    return s
}

// ---- Проверка места при запуске ----

// Как столбец типа o становится значением с описанием d (0 — никак).
fn __db_conv(d: int, o: int) -> int {
    var k = load64(d)
    var dd = d
    if k == D_OPT {
        dd = load64(d + 8)
        k = load64(dd)
    }
    if k == D_INT {
        if __oid_int(o) || o == OID_NUMERIC {
            return CV_INT
        }
        if __oid_time(o) {
            return CV_TIME_INT
        }
        return 0
    }
    if k == D_FLOAT {
        if __oid_float(o) || __oid_int(o) {
            return CV_FLOAT
        }
        return 0
    }
    if k == D_BOOL {
        if o == OID_BOOL {
            return CV_BOOL
        }
        return 0
    }
    if k == D_STR {
        if o == OID_TIMESTAMPTZ || o == OID_TIMESTAMP || o == OID_DATE {
            return CV_TIME_STR
        }
        if o == OID_BYTEA {
            return CV_BYTES
        }
        if o == OID_BOOL || __oid_int(o) || o == OID_FLOAT4 || o == OID_FLOAT8 || __oid_elem(o) != 0 {
            return 0
        }
        return CV_STR
    }
    if __oid_json(o) {
        return CV_JSON
    }
    if __desc_enum(dd) && (o == OID_TEXT || o == OID_VARCHAR || o >= 16384) {
        return CV_ENUM
    }
    if k == D_LIST {
        let eo = __oid_elem(o)
        if eo == 0 {
            return 0
        }
        let ek = load64(load64(dd + 8))
        let texty = eo != OID_BOOL && !__oid_int(eo) && !__oid_float(eo) && !__oid_time(eo)
        if (ek == D_INT && __oid_int(eo)) || (ek == D_FLOAT && (__oid_float(eo) || __oid_int(eo))) || (ek == D_BOOL && eo == OID_BOOL) || (ek == D_STR && texty) || (__desc_enum(load64(dd + 8)) && texty) {
            return CV_ARRAY
        }
    }
    return 0
}

fn __db_conv_hint(d: int, o: int) -> str {
    var dd = d
    if load64(d) == D_OPT {
        dd = load64(d + 8)
    }
    let k = load64(dd)
    if k == D_INT && o == OID_NUMERIC {
        return ""
    }
    if k == D_INT && (o == OID_FLOAT8 || o == OID_FLOAT4) {
        return "make it float, or cast in SQL: round(x)::bigint"
    }
    if k == D_STR && (__oid_int(o) || __oid_float(o) || o == OID_BOOL) {
        return "make it " + __kh_for_oid(o) + ", or cast in SQL: x::text"
    }
    if (k == D_INT || k == D_FLOAT || k == D_BOOL) && __oid_texty(o) {
        return "make it str, or cast in SQL: x::bigint"
    }
    return "make it " + __kh_for_oid(o)
}

// Тип Khrip для столбца типа o (для подсказок).
fn __kh_for_oid(o: int) -> str {
    if __oid_int(o) {
        return "int"
    }
    if __oid_float(o) {
        return "float"
    }
    if o == OID_BOOL {
        return "bool"
    }
    if __oid_json(o) {
        return "a type that matches the JSON"
    }
    let e = __oid_elem(o)
    if e != 0 {
        return "[" + __kh_for_oid(e) + "]"
    }
    return "str"
}

// Метки компилятора в тексте запроса: %%T:таблица.столбец%% — тип столбца,
// %%D:таблица.столбец%% — его DEFAULT, для identity — nextval, иначе NULL.
// → готовый текст или "" (тогда в __db_mark_err — почему).
var __db_mark_err: str = ""

fn __db_markers(c: int, sql: str, deadline: int) -> str {
    if !sql.contains("%%") {
        return sql
    }
    let b = buf_new(sql.byte_len() + 64)
    var i = 0
    let n = sql.byte_len()
    while i < n {
        if i + 3 < n && sql.byte(i) == '%' && sql.byte(i + 1) == '%' && (sql.byte(i + 2) == 'T' || sql.byte(i + 2) == 'D' || sql.byte(i + 2) == 'A') && sql.byte(i + 3) == ':' {
            var j = i + 4
            while j + 1 < n && !(sql.byte(j) == '%' && sql.byte(j + 1) == '%') {
                j += 1
            }
            var refend = j
            var val = ""
            if sql.byte(i + 2) == 'A' {
                // %%A:таблица.столбец:значение%%
                while refend > i + 4 && sql.byte(refend - 1) != ':' {
                    refend -= 1
                }
                val = sql.byte_slice(refend, j)
                refend -= 1
            }
            // имя таблицы может быть со схемой: столбец — после последней точки
            var dot = refend - 1
            while dot > i + 4 && sql.byte(dot) != '.' {
                dot -= 1
            }
            let table = sql.byte_slice(i + 4, dot)
            let col = sql.byte_slice(dot + 1, refend)
            // тип — без модификатора: приведение к varchar(5) молча обрезало бы
            // строку, а присваивание столбцу даёт ошибку 22001 (400)
            let r = __pg_exec(c, "select format_type(a.atttypid, null), case when a.attidentity <> '' then 'nextval(' || quote_literal(pg_get_serial_sequence($1, a.attname)) || ')' else '(' || pg_get_expr(d.adbin, d.adrelid) || ')' end, t.typcategory::text from pg_attribute a join pg_type t on t.oid = a.atttypid left join pg_attrdef d on d.adrelid = a.attrelid and d.adnum = a.attnum where a.attrelid = to_regclass($1) and a.attname::text in ($2::text, lower($2::text)) and a.attnum > 0 and not a.attisdropped order by a.attname::text = $2::text desc limit 1", [table, col], deadline)
            if r.err.code.byte_len() > 0 || r.rows == 0 {
                __db_mark_err = "table {table} has no column {col}"
                return ""
            }
            let ty = __pg_str(r, 0)
            if sql.byte(i + 2) == 'T' {
                buf_add(b, ty)
            } else if sql.byte(i + 2) == 'D' {
                buf_add(b, __pg_text(r, 1) ?? "NULL")
            } else if __pg_str(r, 2) == "A" {
                // список из jsonb — в массив столбца, по порядку
                buf_add(b, "ARRAY(SELECT e FROM jsonb_array_elements_text({val}) WITH ORDINALITY AS x(e, o) ORDER BY o)::{ty}")
            } else {
                buf_add(b, "{val}::{ty}")
            }
            i = j + 2
            continue
        }
        buf_byte(b, sql.byte(i))
        i += 1
    }
    return buf_str(b)
}

// Подготовка места: Parse + Describe, типы параметров (с повтором, если сервер
// не вывел тип), план раскладки строк. → описание ошибки или "".
fn __db_check(c: int, site: int, notnull: map[str, bool], deadline: int) -> str {
    let marked: str = __cast(load64(site + SITE_SQL))
    let sql = __db_markers(c, marked, deadline)
    if sql.byte_len() == 0 {
        return __db_mark_err + "\n    in: " + marked
    }
    store64(site + SITE_SQL, __cast(sql))
    let np = load64(site + SITE_NPARAMS)
    let pt = load64(site + SITE_PARAMS)
    var types: [int] = []
    var fallback: [int] = []
    for i in 0..np {
        let kind = load64(pt + i * 32)
        let d = load64(pt + i * 32 + 8)
        if kind == PK_ISNULL || kind == PK_GIVEN {
            types.push(OID_BOOL)

        } else if kind == PK_LIKE || kind == PK_TEXT {
            types.push(OID_TEXT)
        } else {
            types.push(0)
        }
        fallback.push(__desc_oid(d))
    }
    var desc = __pg_describe_typed(c, sql, types, deadline)
    var tries = 0
    while desc.err.code.byte_len() > 0 && tries <= np {
        tries += 1
        var changed = false
        if (desc.err.code == "42P18" || desc.err.code == "42P08") && __pg_param_no(desc.err.message) != none {
            let k = __pg_param_no(desc.err.message) ?? -1
            if k >= 0 && k < np && types[k] == 0 {
                types[k] = fallback[k]
                changed = true
            }
        } else if desc.err.code == "42P18" || desc.err.code == "42P08" || desc.err.code == "42725" {
            // номер не прочитать (сообщение на другом языке) или оператор
            // неоднозначен: тип из fallback — всем, у кого его нет
            for j in 0..np {
                if types[j] == 0 {
                    types[j] = fallback[j]
                    changed = true
                }
            }
        }
        if !changed {
            break
        }
        desc = __pg_describe_typed(c, sql, types, deadline)
    }
    if desc.err.code.byte_len() > 0 {
        return __db_sql_error(sql, desc.err)
    }
    // типы параметров, которые вывел сервер
    var oids: [int] = []
    for i in 0..np {
        var o = types[i]
        if i < desc.params.len() {
            o = desc.params[i]
        }
        oids.push(o)
        let kind = load64(pt + i * 32)
        let d = load64(pt + i * 32 + 8)
        if kind == PK_VAL || kind == PK_FIELD || kind == PK_COLUMN {
            var why = ""
            if kind == PK_COLUMN {
                // массовая вставка: элемент списка — против элемента массива
                why = __param_fits(load64(d + 8), __oid_elem(o))
            } else {
                why = __param_fits(d, o)
            }
            if why.byte_len() > 0 {
                return "parameter ${i + 1} is sent to a {__oid_name(o)} place, but {why}\n    in: {sql}"
            }
        }
    }
    let persist_oids: [int] = oids
    store64(site + SITE_OIDS, __cast(persist_oids))
    store64(site + SITE_FALLBACK, __cast(types))
    let shape = load64(site + SITE_SHAPE)
    let d = load64(site + SITE_DESC)
    var names: [str] = []
    for col in desc.cols {
        names.push(col.name)
    }
    if shape == SH_COUNT {
        if desc.cols.len() > 0 {
            return "sql needs to know the result type: the query returns {names.join(", ")}\n    fix: let row: Row = sql ... (one row), Row? (maybe none) or [Row] (all rows), with type Row \{ {__db_suggest(desc)} }"
        }
        return ""
    }
    if desc.cols.len() == 0 {
        // let n: int = sql "UPDATE ..." — число строк
        if load64(d) == D_INT && shape == SH_ONE {
            store64(site + SITE_COUNT, 1)
            return ""
        }
        return "the query returns no rows, but a {__desc_name(d)} is expected: add RETURNING ..., or drop the type to get the number of changed rows"
    }
    var dd = d
    if load64(d) == D_OPT {
        dd = load64(d + 8)
    }
    // один столбец json, чьё имя — не поле структуры: это вся строка в JSON
    var whole_json = false
    if load64(dd) == D_STRUCT && desc.cols.len() == 1 && __oid_json(desc.cols[0].ty) {
        whole_json = true
        let cname = desc.cols[0].name.ascii_lower()
        for fi in 0..load64(dd + 8) {
            let fname: str = __cast(load64(__field(dd, fi)))
            if fname.ascii_lower() == cname {
                whole_json = false
            }
        }
    }
    let is_struct = load64(dd) == D_STRUCT && !whole_json
    var plan: [int] = []
    if !is_struct {
        if desc.cols.len() != 1 {
            return "{__desc_name(d)} takes one column, but the query returns {desc.cols.len()}: {names.join(", ")}"
        }
        let col = desc.cols[0]
        let cv = __db_conv(d, col.ty)
        if cv == 0 {
            return "column {col.name} is {__oid_name(col.ty)}, but {__desc_name(d)} is expected; {__db_conv_hint(d, col.ty)}"
        }
        if col.table != 0 && load64(d) != D_OPT && shape != SH_OPT {
            if !(notnull["{col.table}:{col.attnum}"] ?? true) {
                return "column {col.name} can be NULL, but {__desc_name(d)} has no none\n    fix: {__desc_name(d)}? (or [{__desc_name(d)}?]), add NOT NULL to the column, or select coalesce({col.name}, ...)"
            }
        }
        plan.push(0)
        plan.push(cv)
        store64(site + SITE_SCALAR, 1)
    } else {
        let n = load64(dd + 8)
        let tname: str = __cast(load64(dd + 16))
        for fi in 0..n {
            let f = __field(dd, fi)
            let fname: str = __cast(load64(f))
            let fd = __field_desc(dd, fi)
            var ci = -1
            for j, col in desc.cols {
                if ci < 0 && col.name == fname {
                    ci = j
                }
            }
            if ci < 0 {
                for j, col in desc.cols {
                    if ci < 0 && col.name.ascii_lower() == fname.ascii_lower() {
                        ci = j
                    }
                }
            }
            if ci < 0 {
                if load64(f + 24) == 0 && load64(fd) != D_OPT {
                    return "{tname}.{fname} has no column: the query returns {names.join(", ")}\n    fix: select it (or rename a column with AS {fname}), or give the field a default"
                }
                plan.push(-1)
                plan.push(0)
                continue
            }
            let col = desc.cols[ci]
            let cv = __db_conv(fd, col.ty)
            if cv == 0 {
                return "{tname}.{fname} is {__desc_name(fd)}, but column {col.name} is {__oid_name(col.ty)}; {__db_conv_hint(fd, col.ty)}"
            }
            if col.table != 0 && load64(fd) != D_OPT {
                if !(notnull["{col.table}:{col.attnum}"] ?? true) {
                    return "{tname}.{fname} is {__desc_name(fd)}, but column {col.name} can be NULL\n    fix: make the field {__desc_name(fd)}?, add NOT NULL to the column, or select coalesce({col.name}, ...) AS {fname}"
                }
            }
            plan.push(ci)
            plan.push(cv)
        }
    }
    store64(site + SITE_PLAN, __cast(plan))
    return ""
}

// Поля типа для подсказки: «id: int, owner: str».
fn __db_suggest(desc: __PgDesc) -> str {
    var parts: [str] = []
    for col in desc.cols {
        parts.push(col.name + ": " + __kh_for_oid(col.ty))
    }
    return parts.join(", ")
}

// Ошибка PostgreSQL с подсказкой и местом в тексте запроса.
fn __db_sql_error(sql: str, e: __PgErr) -> str {
    var msg = "{e.message} [{e.code}]"
    if e.hint.byte_len() > 0 {
        msg = msg + "\n    hint: " + e.hint
    }
    msg = msg + "\n    in: " + sql.replace("\n", " ")
    if e.position > 0 && e.position <= sql.byte_len() {
        let pad = buf_new(e.position + 8)
        for i in 0..e.position + 7 {
            buf_byte(pad, ' ')
        }
        msg = msg + "\n" + buf_str(pad) + "^"
    }
    return msg
}

// NOT NULL столбцов, которые возвращают запросы: «таблица:номер» → attnotnull.
// NOT NULL столбцов таблиц (у представлений и выражений его не знают — их не
// проверяем, чтобы не отказывать правильным запросам).
fn __db_notnull(c: int, deadline: int) -> map[str, bool] {
    var m: map[str, bool] = {}
    let r = __pg_exec(c, "select attrelid::bigint, attnum::bigint, attnotnull from pg_attribute where attnum > 0 and attrelid in (select oid from pg_class where relkind in ('r', 'p') and relnamespace not in (select oid from pg_namespace where nspname in ('pg_catalog', 'information_schema')))", [], deadline)
    for i in 0..r.rows {
        m["{__pg_int(r, 3 * i)}:{__pg_int(r, 3 * i + 1)}"] = __pg_bool(r, 3 * i + 2)
    }
    return m
}

// ---- Запуск ----

fn __db_start() {
    // всё, что строит запуск (планы мест, типы параметров), живёт до конца
    // процесса: выделять из свежего куска mmap, а не из арены запроса
    let cx = __ctx()
    let sp = load64(cx + CTX_PTR)
    let se = load64(cx + CTX_END)
    store64(cx + CTX_PTR, 0)
    store64(cx + CTX_END, 0)
    __db_start_here()
    store64(cx + CTX_PTR, sp)
    store64(cx + CTX_END, se)
}

// khc test: своя пустая схема на запуск, удаляется в конце (__db_test_done).
fn __db_testing() -> bool {
    return load64(__ctx() + CTX_WORKER) != 0 && __w().testing
}

fn __db_start_here() {
    var c = __pg_startup(__db_testing())
    if __db_testing() {
        let name = "khrip_test_{syscall(39)}_{random_str(6).ascii_lower()}"
        let e = __pg_simple(c, "create schema {name}", now_ms() + 10000)
        if e.code.byte_len() > 0 {
            eprint("khrip: cannot create the test schema: {e.message}")
            exit(1)
        }
        __pg_free(c)
        __pg_url.schema = name
        let pc = __pg_connect(__pg_url, now_ms() + 10000)
        if pc.c == 0 {
            eprint("khrip: cannot connect to the database: {pc.err}")
            exit(1)
        }
        c = pc.c
    }
    let deadline = now_ms() + 600000
    let root = __db_root()
    let mt = load64(root + 8)
    var names: [str] = []
    var sqls: [str] = []
    if mt != 0 {
        for i in 0..load64(mt) {
            let nm: str = __cast(load64(mt + 8 + 16 * i))
            let sq: str = __cast(load64(mt + 16 + 16 * i))
            names.push(nm)
            sqls.push(sq)
        }
    }
    // DATABASE_MIGRATE: apply (по умолчанию) — применить при старте; check — схему
    // меняет отдельный шаг ./app migrate, сервер только проверяет
    let mode = env("DATABASE_MIGRATE") ?? "apply"
    if mode != "apply" && mode != "check" && mode != "1" && mode != "0" {
        eprint("khrip: DATABASE_MIGRATE must be apply or check, not {mode}")
        exit(1)
    }
    let migrate = mode == "apply" || mode == "1" || (args().len() > 1 && args()[1] == "migrate")
    if names.len() > 0 && migrate {
        let log = buf_new(64)
        let err = __pg_migrate(c, names, sqls, log)
        for line in buf_str(log).split("\n") {
            if line.byte_len() > 0 {
                eprint("khrip: " + line.replace("applied ", "applied migration "))
            }
        }
        if err.byte_len() > 0 {
            eprint("khrip: migration failed: " + err)
            exit(1)
        }
    } else if names.len() > 0 {
        // DATABASE_MIGRATE=check: схему меняет отдельный шаг (./app migrate)
        let done = __pg_exec(c, "select name from khrip_migrations", [], deadline)
        var applied: [str] = []
        for i in 0..done.rows {
            applied.push(__pg_str(done, i))
        }
        for nm in names {
            if !applied.contains(nm) {
                eprint("khrip: migration {nm} is not applied (DATABASE_MIGRATE={mode}): run ./app migrate")
                exit(1)
            }
        }
    }
    // каждое место sql — против настоящей базы
    let st = load64(root)
    var bad = 0
    if st != 0 {
        let notnull = __db_notnull(c, deadline)
        __db_load_types(c, deadline)
        for i in 0..load64(st) {
            let site = load64(st + 8 + 8 * i)
            let err = __db_check(c, site, notnull, deadline)
            if err.byte_len() > 0 {
                let loc: str = __cast(load64(site + SITE_LOC))
                eprint("{loc}: error: {err}")
                bad += 1
            }
        }
    }
    if bad > 0 {
        eprint("khrip: {bad} sql statement(s) do not match the database")
        exit(1)
    }
    __pg_free(c)
    // ./app migrate — шаг выкладки: миграции и проверка запросов, без сервера
    let a = args()
    if a.len() > 1 && a[1] == "migrate" {
        eprint("khrip: the database is up to date")
        exit(0)
    }
}

// Конец khc test: удалить временную схему.
fn __db_test_done() {
    if __pg_url.schema.byte_len() == 0 {
        return
    }
    let schema = __pg_url.schema
    __pg_url.schema = ""
    let pc = __pg_connect(__pg_url, now_ms() + 10000)
    if pc.c != 0 {
        __pg_simple(pc.c, "drop schema {schema} cascade", now_ms() + 30000)
        __pg_free(pc.c)
    }
}

// ---- Выполнение ----

// Ошибка базы → статус и тело ответа. target — таблицы, в которые пишет оператор
// (для 23503: «нет строки, на которую ссылаемся» — 404, «на строку ещё
// ссылаются» — 409); пусто — неизвестно (COMMIT с отложенными ограничениями).
type __DbFail {
    status: int
    msg: str
}

fn __db_classify(e: __PgErr, target: str) -> __DbFail {
    let code = e.code
    // тело ответа — без значений из DETAIL (они только в журнале)
    var name = e.constraint
    if name.byte_len() == 0 {
        name = e.table
    }
    if code == "23505" || code == "23P01" {
        return __DbFail { status: 409, msg: "already exists: " + name }
    }
    if code == "23514" {
        // CHECK — инвариант состояния (баланс, остаток): ввод проверяется в коде
        return __DbFail { status: 409, msg: "conflict: " + name }
    }
    if code == "23503" {
        // направление — по тексту PostgreSQL, если он английский; иначе — по
        // таблицам, в которые пишет оператор
        if e.detail.contains("is still referenced") {
            return __DbFail { status: 409, msg: "still referenced: " + name }
        }
        if e.detail.contains("is not present") {
            return __DbFail { status: 404, msg: "not found: " + name }
        }
        if target.byte_len() > 0 && target.contains(" " + e.table + " ") {
            return __DbFail { status: 404, msg: "not found: " + name }
        }
        return __DbFail { status: 409, msg: "still referenced: " + name }
    }
    if code == "23502" {
        return __DbFail { status: 400, msg: "missing value: " + e.table + "." + e.column }
    }
    // неверное значение от клиента — 400; ошибка вычисления в запросе (деление
    // на ноль, регулярное выражение, индекс массива) — ошибка программы, 500
    if code == "22P02" || code == "22001" || code == "22003" || code == "22007" || code == "22008" || code == "22009" || code == "22023" || code == "22004" || code == "22021" || code == "22P05" || code == "P0001" {
        return __DbFail { status: 400, msg: e.message }
    }
    if code == "08007" {
        // связь пропала во время COMMIT: повторять небезопасно
        return __DbFail { status: 500, msg: "transaction outcome unknown" }
    }
    if code == "57014" || code == "55P03" || code.starts_with("08") || code.starts_with("53") || code.starts_with("57P") || code.starts_with("40") {
        return __DbFail { status: 503, msg: "database unavailable, try again" }
    }
    return __DbFail { status: 500, msg: "internal error" }
}

// Ошибка базы → завершить запрос статусом (или паника вне запроса).
fn __db_fail(site: int, e: __PgErr) {
    let loc: str = __cast(load64(site + SITE_LOC))
    let target: str = __cast(load64(site + SITE_TARGET))
    let f = __db_classify(e, target)
    if f.status >= 500 {
        var extra = ""
        if e.detail.byte_len() > 0 {
            extra = " (" + e.detail + ")"
        }
        if f.status == 500 {
            let sql: str = __cast(load64(site + SITE_SQL))
            extra = extra + "\n    in: " + sql
        }
        eprint("{loc}: sql failed [{e.code}] {e.message}{extra}")
    }
    __db_answer(f, "{loc}: sql failed [{e.code}] {e.message}")
}

// Ответ статусом в запросе; вне запроса — паника с текстом why.
fn __db_answer(f: __DbFail, why: str) {
    if load64(__ctx() + CTX_WORKER) != 0 {
        let w = __w()
        if w.cur != 0 {
            if f.status == 503 {
                set_header("Retry-After", "1")
            }
            fail(f.status, f.msg)
        }
    }
    __panic_msg(why)
}

fn __db_unavailable(site: int, why: str) {
    let e = __PgErr { code: "08006", message: why }
    __db_fail(site, e)
}

// ORDER BY {o}: место, текст которого собран с этой строкой o.
fn __db_variant(site: int, vt: int, vals: int) -> int {
    let nv = load64(site + SITE_NVALS)
    let o: str = __cast(load64(vals + (nv - 1 - load64(vt)) * 8))
    let k = load64(vt + 8)
    for j in 0..k {
        let s: str = __cast(load64(vt + 16 + j * 16))
        if s == o {
            return load64(vt + 24 + j * 16)
        }
    }
    let loc: str = __cast(load64(site + SITE_LOC))
    __panic_msg("{loc}: ORDER BY got \"{o}\", which is none of the strings the compiler saw")
    return site
}

// Выполнить место sql: значения параметров на стеке, результат — слово Khrip.
fn __db_run(site0: int, vals: int) -> int {
    var site = site0
    let vt = load64(site0 + SITE_VARIANTS)
    if vt != 0 {
        site = __db_variant(site0, vt, vals)
    }
    let cx = __ctx()
    let deadline = now_ms() + __db_timeout()
    let params = __db_params(site, vals)
    let sql: str = __cast(load64(site + SITE_SQL))
    let types: [int] = __cast(load64(site + SITE_FALLBACK))
    let tc = load64(cx + CTX_PGHELD)
    if tc != 0 && load64(site + SITE_KEYS) != 0 {
        __db_note_keys(tc, site, params)
    }
    var attempt = 0
    var res = __PgRes { cols: 0, rows: 0, data: buf_new(16), at: [], affected: 0, err: __PgErr {} }
    while true {
        attempt += 1
        let held = load64(cx + CTX_PGHELD)
        var c = held
        var dl = deadline
        if c == 0 {
            let pc = __pg_acquire(__pg_url, deadline)
            if pc.c == 0 {
                __db_unavailable(site, pc.err)
            }
            c = pc.c
            // на время запроса соединение — у запроса: паника посреди ответа
            // закроет его (__pg_request_end), а не потеряет
            store64(cx + CTX_PGHELD, c)
        } else {
            // в tx — не дольше бюджета блока
            dl = dl.min(load64(c + PB_TXDL))
        }
        store64(c + PB_INFLIGHT, 1)
        // в транзакции — свой подготовленный оператор места (см. PG_SITES)
        var idx = load64(site + SITE_INDEX)
        if held != 0 && idx >= 0 && idx < PG_SITES {
            idx += PG_SITES
        }
        res = __pg_query_at(c, idx, sql, params, types, [], dl)
        store64(c + PB_INFLIGHT, 0)
        if held == 0 {
            store64(cx + CTX_PGHELD, 0)
            __pg_release(c)
        }
        if res.err.code.byte_len() == 0 {
            break
        }
        // 55P03 — повтор, только если это наш короткий lock_timeout первой
        // попытки; NOWAIT и свой lock_timeout программы — обычная ошибка (503)
        if __pg_retryable(res.err) || (held != 0 && res.err.code == "55P03" && load64(held + PB_TXTRY) == 0) {
            if held != 0 {
                // конфликт в транзакции: она повторяется целиком
                __db_tx_retry(res.err)
            } else if now_ms() < deadline {
                // одиночный запрос (взаимоблокировка) — повторить его
                __pg_backoff(attempt)
                continue
            }
        }
        __db_fail(site, res.err)
    }
    let shape = load64(site + SITE_SHAPE)
    if shape == SH_COUNT || load64(site + SITE_COUNT) != 0 {
        return res.affected
    }
    if shape == SH_LIST {
        let d = load64(site + SITE_DESC)
        if load64(d) == D_BOOL {
            var bs: [bool] = []
            for i in 0..res.rows {
                bs.push(__db_row(site, res, i) != 0)
            }
            return __cast(bs)
        }
        var xs: [int] = []
        for i in 0..res.rows {
            xs.push(__db_row(site, res, i))
        }
        return __cast(xs)
    }
    if res.rows > 1 {
        // T и T? — одна строка: несколько — ошибка программы, а не «первая попавшаяся»
        let loc: str = __cast(load64(site + SITE_LOC))
        __panic_msg("{loc}: the query returned {res.rows} rows, but one is expected: filter by a unique key, add LIMIT 1 with ORDER BY, or use a list [T]")
    }
    if res.rows == 0 {
        if shape == SH_OPT {
            return 0
        }
        // T без строки: 404, как fail(404)
        if load64(cx + CTX_WORKER) != 0 && __w().cur != 0 {
            fail(404, "not found")
        }
        let loc: str = __cast(load64(site + SITE_LOC))
        __panic_msg("{loc}: the query returned no row")
    }
    if shape == SH_OPT && load64(site + SITE_SCALAR) != 0 && __pg_null(res, 0) {
        // T? из одного столбца: и «нет строки», и NULL — none
        return 0
    }
    let v = __db_row(site, res, 0)
    if shape == SH_OPT {
        let d = load64(site + SITE_DESC)
        if __is_scalar(d) {
            let b = __alloc(8)
            store64(b, v)
            return b
        }
    }
    return v
}

// ---- tx { } ----
// Блок держит одно соединение (CTX_PGHELD) от начала до конца. BEGIN уходит с
// первым запросом. Конфликт (40001, 40P01) в любом запросе или в COMMIT:
// откат, случайная пауза, и блок выполняется снова с начала (longjmp в точку,
// которую запомнил компилятор), пока не выйдет DATABASE_TIMEOUT — тогда 503.

// Начало блока id → буфер повтора (0 — блок вложен и присоединяется к внешнему).
fn __db_tx_begin(id: int) -> int {
    let cx = __ctx()
    if load64(cx + CTX_PGHELD) != 0 {
        return 0
    }
    let deadline = now_ms() + __db_timeout()
    let pc = __pg_acquire(__pg_url, deadline)
    if pc.c == 0 {
        __db_tx_unavailable(pc.err)
    }
    let c = pc.c
    store64(cx + CTX_PGHELD, c)
    __pg_tx_begin(c, PG_SERIALIZABLE | PG_SHORT_LOCKS)
    let jb = __alloc(64)
    store64(c + PB_TXJB, jb)
    store64(c + PB_TXTRY, 0)
    store64(c + PB_TXDL, deadline)
    var hl = 0
    if load64(cx + CTX_WORKER) != 0 && __w().cur != 0 {
        hl = __w().extra.len
    }
    store64(c + PB_TXHDR, hl)
    store64(c + PB_TXID, id)
    store64(c + PB_KEYS, 0)
    return jb
}

// Запрос в транзакции: ключи его строк — в набор попытки (по ним повтор встанет
// в очередь). Строка горячая — её ждёт или держит повтор в этом процессе: первый
// запрос попытки сначала встаёт в ту же очередь (BEGIN ещё не ушёл, снимок
// возьмётся после ожидания), а запрос посреди попытки уступает — откат и
// повтор в очереди, а не верный конфликт с тем, кто ждёт дольше.
fn __db_note_keys(c: int, site: int, params: [str?]) {
    let kt = load64(site + SITE_KEYS)
    let held = c + PB_HELD
    var hot = false
    let mine = __alloc(8 + PG_KEYS * 8)
    store64(mine, 0)
    for i in 0..load64(kt) {
        let no = load64(kt + 16 + 16 * i)
        if no < params.len() {
            if let v = params[no] {
                let k = __pg_row_key(__cast(load64(kt + 8 + 16 * i)), v)
                __pg_key_add(c + PB_KEYS, k)
                __pg_key_add(mine, k)
                // строка, которую повтор не возьмёт (набор полон), — не повод
                // уступать: иначе попытка уступала бы без конца
                if __pg_key_has(c + PB_KEYS, k) && !__pg_key_has(held, k) && __pg_key_hot(c, k) {
                    hot = true
                }
            }
        }
    }
    if !hot {
        return
    }
    if load64(c + PB_BEGIN) != 0 && load64(held) == 0 {
        __pg_hold(c, mine)
        store64(c + PB_GATE, 1)
    } else if load64(c + PB_TXJB) != 0 {
        __db_tx_retry(__PgErr { code: "40001", message: "row is queued for a retry" })
    }
}

fn __db_tx_unavailable(why: str) {
    // подробности (адрес, пользователь, ошибка TLS) — только в журнал
    eprint("tx failed: database unavailable: " + why)
    if load64(__ctx() + CTX_WORKER) != 0 && __w().cur != 0 {
        set_header("Retry-After", "1")
        fail(503, "database unavailable, try again")
    }
    __panic_msg("database unavailable: " + why)
}

// Освободить соединение блока (и очередь повторов, если блок в ней стоял).
fn __db_tx_release(c: int) {
    store64(__ctx() + CTX_PGHELD, 0)
    store64(c + PB_TXJB, 0)
    if load64(c + PB_BROKEN) == 0 {
        __pg_unlock_tx(c)
    }
    __pg_release(c)
}

// Конец блока: COMMIT (jb == 0 — блок вложен, фиксирует внешний).
fn __db_tx_commit(jb: int) {
    if jb == 0 {
        return
    }
    let c = load64(__ctx() + CTX_PGHELD)
    if c == 0 {
        return
    }
    let e = __pg_tx_end(c, true, load64(c + PB_TXDL))
    if e.code.byte_len() > 0 {
        if __pg_retryable(e) || (e.code == "55P03" && load64(c + PB_TXTRY) == 0) {
            __db_tx_retry(e)
        }
        __db_tx_release(c)
        __db_tx_error(e)
    }
    __db_tx_release(c)
}

// Ответ из блока: статус меньше 400 — COMMIT, иначе ROLLBACK.
fn __db_tx_status(status: int) {
    let c = load64(__ctx() + CTX_PGHELD)
    if c == 0 {
        return
    }
    if status < 400 {
        __db_tx_commit(load64(c + PB_TXJB))
        return
    }
    __pg_tx_end(c, false, load64(c + PB_TXDL))
    __db_tx_release(c)
}

fn __db_tx_error(e: __PgErr) {
    let f = __db_classify(e, "")
    if f.status >= 500 {
        var extra = ""
        if e.detail.byte_len() > 0 {
            extra = " (" + e.detail + ")"
        }
        eprint("tx failed [{e.code}] {e.message}{extra}")
    }
    __db_answer(f, "tx failed [{e.code}] {e.message}")
}

// Конфликт внутри блока: откатить и выполнить блок снова.
fn __db_tx_retry(e: __PgErr) {
    let cx = __ctx()
    let c = load64(cx + CTX_PGHELD)
    let jb = load64(c + PB_TXJB)
    let n = load64(c + PB_TXTRY) + 1
    store64(c + PB_TXTRY, n)
    if load64(c + PB_TX) != 'I' && load64(c + PB_BROKEN) == 0 {
        __pg_simple(c, "rollback", load64(c + PB_TXDL).max(now_ms() + 5000))
    }
    // заголовки неудачной попытки не уходят в ответ (ни в повтор, ни в 503)
    if load64(cx + CTX_WORKER) != 0 && __w().cur != 0 {
        let w = __w()
        w.extra.len = load64(c + PB_TXHDR)
    }
    if jb == 0 || now_ms() >= load64(c + PB_TXDL) || load64(c + PB_BROKEN) != 0 {
        __db_tx_release(c)
        __db_tx_error(e)
    }
    // Очередь повторов: проигравший конфликт блок ждёт на сессионных
    // advisory-блокировках строк, которых касалась попытка (во всех копиях
    // сервера), а не бьётся снова вслепую. BEGIN — после блокировок: снимок уже
    // свежий. Паузы нет: повторы за одну строку и так идут друг за другом.
    // Строк не видно (нет WHERE col = {x}) — ключ всего блока tx.
    let ka = c + PB_KEYS
    let hk = c + PB_HELD
    for i in 0..load64(hk) {
        __pg_key_add(ka, load64(hk + 8 + i * 8))
    }
    if load64(ka) == 0 {
        __pg_key_add(ka, 0x4B48520000000000 + load64(c + PB_TXID))
    }
    var fresh = false
    for i in 0..load64(ka) {
        fresh = fresh || !__pg_key_has(hk, load64(ka + 8 + i * 8))
    }
    if fresh {
        // новые строки: снять прежние и взять все разом по порядку — так
        // ожидающие не держат одно и не ждут другое по кругу
        if load64(hk) > 0 {
            let ue = __pg_simple(c, "select pg_advisory_unlock_all()", load64(c + PB_TXDL))
            if ue.code.byte_len() > 0 {
                __db_tx_release(c)
                __db_tx_error(ue)
            }
        }
        __pg_hot_leave(c)
        __pg_hold(c, ka)
        let le = __pg_simple(c, __pg_lock_sql(c), load64(c + PB_TXDL))
        if le.code.byte_len() > 0 {
            __db_tx_release(c)
            __db_tx_error(le)
        }
    }
    store64(ka, 0)
    __pg_tx_begin(c, PG_SERIALIZABLE)
    __longjmp(jb)
}
