// Таблицы Unicode для lib/text.kh: простое отображение регистра (__case_map)
// и \w регулярных выражений (__cp_is_word). Файл создан tools/unicode_tables.kh —
// не правьте его руками, запустите генератор.
//
// Unicode 17.0.0, файлы UCD:
//   UnicodeData.txt  sha256 2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c
//   PropList.txt     sha256 130dcddcaadaf071008bdfce1e7743e04fdfbc910886f017d9f9ac931d8c64dd
//
// Регистр: отображений в нижний — 1488, в верхний — 1505; в UTF-8 растут 22
// (не больше чем в 1,5 раза), уменьшаются 38. s1 — u8 × 1958 (cp >> 6 < CASE_END),
// s2 — блоки по 64 u8 (номер пары), их 70; пары — 185 × {i32 к нижнему,
// i32 к верхнему}. Всего байт: 7918.
// \w — категории L, M, Nd и Pc: кодов 148995, диапазонов 796. s1 — u8 × 1641
// (cp >> 7 < WORD_END), s2 — блоки по 16 байт (бит на код), их 202. Всего байт:
// 4873. Выше WORD_END — только U+E0100–E01EF.
// White_Space из PropList.txt (кодов: 25) совпадает с __cp_is_space.

const CASE_END = 0x1E980
const CASE_S2 = 1958
const CASE_PAL = 6438
const WORD_END = 0x33480
const WORD_S2 = 1641

fn __case_tab() -> int {
    return __data_hex("")
}

fn __word_tab() -> int {
    return __data_hex("")
}
