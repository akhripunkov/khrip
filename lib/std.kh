// Минимальная стандартная библиотека Khrip-0.
// Подключается как ещё один входной файл: khc -o prog lib/std.kh prog.kh

const SYS_READ = 0
const SYS_WRITE = 1
const SYS_OPEN = 2
const SYS_CLOSE = 3
const SYS_MMAP = 9
const SYS_EXIT = 60

const STDOUT = 1
const STDERR = 2

fn exit(status: i64) {
    syscall(SYS_EXIT, status)
}

// ---- Память ----

const HEAP_CHUNK = 1048576
const HEAP_BIG = 65536

var heap_p: i64
var heap_end: i64

fn mmap(size: i64) -> i64 {
    let p = syscall(SYS_MMAP, 0, size, 3, 0x22, -1, 0)
    if p < 0 {
        eprint("out of memory\n")
        exit(1)
    }
    return p
}

// Выделяет обнулённую память, выровненную на 16 байт. Мелкие блоки нарезаются
// из кусков по 1 МБ, крупные берутся у ядра напрямую. Освобождения нет:
// память живёт до конца процесса.
fn alloc(size: i64) -> i64 {
    size = (size + 15) & ~15
    if size >= HEAP_BIG {
        return mmap(size)
    }
    if heap_p + size > heap_end {
        heap_p = mmap(HEAP_CHUNK)
        heap_end = heap_p + HEAP_CHUNK
    }
    let p = heap_p
    heap_p = heap_p + size
    return p
}

// Копирует n байт по 8 за раз. Области могут перекрываться, если dst < src.
fn memcpy(dst: i64, src: i64, n: i64) {
    var i = 0
    while i + 8 <= n {
        store64(dst + i, load64(src + i))
        i = i + 8
    }
    while i < n {
        store8(dst + i, load8(src + i))
        i = i + 1
    }
}

// ---- Строки ----

fn strlen(s: i64) -> i64 {
    var n = 0
    while load8(s + n) != 0 {
        n = n + 1
    }
    return n
}

fn mem_eq(a: i64, an: i64, b: i64, bn: i64) -> i64 {
    if an != bn {
        return 0
    }
    var i = 0
    while i < an {
        if load8(a + i) != load8(b + i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

fn lower(c: i64) -> i64 {
    if c >= 'A' && c <= 'Z' {
        return c + 32
    }
    return c
}

// Сравнение без учёта регистра; образец b — в нижнем регистре.
fn mem_ieq(a: i64, an: i64, b: i64, bn: i64) -> i64 {
    if an != bn {
        return 0
    }
    var i = 0
    while i < an {
        if lower(load8(a + i)) != load8(b + i) {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Десятичное число без знака → значение или -1, если это не число.
fn parse_uint(p: i64, n: i64) -> i64 {
    if n <= 0 || n > 18 {
        return -1
    }
    var v = 0
    var i = 0
    while i < n {
        let c = load8(p + i)
        if c < '0' || c > '9' {
            return -1
        }
        v = v * 10 + c - '0'
        i = i + 1
    }
    return v
}

// ---- Окружение процесса ----

// Значение переменной окружения или 0. Окружение лежит в стеке сразу за argv.
fn getenv(argc: i64, argv: i64, name: i64) -> i64 {
    let n = strlen(name)
    var env = argv + (argc + 1) * 8
    while load64(env) != 0 {
        let s = load64(env)
        if mem_eq(s, n, name, n) && load8(s + n) == '=' {
            return s + n + 1
        }
        env = env + 8
    }
    return 0
}

fn env_int(argc: i64, argv: i64, name: i64, fallback: i64) -> i64 {
    let s = getenv(argc, argv, name)
    if s == 0 {
        return fallback
    }
    let v = parse_uint(s, strlen(s))
    if v < 0 {
        return fallback
    }
    return v
}

// ---- Буфер для сборки байтов ----
// Если данные не помещаются, буфер помечается ошибкой и дальше не растёт.

const BUF_PTR = 0
const BUF_LEN = 8
const BUF_CAP = 16
const BUF_ERR = 24
const BUF_SIZE = 32

fn buf_new(cap: i64) -> i64 {
    let b = alloc(BUF_SIZE)
    store64(b + BUF_PTR, alloc(cap))
    store64(b + BUF_CAP, cap)
    return b
}

fn buf_ptr(b: i64) -> i64 {
    return load64(b + BUF_PTR)
}

fn buf_len(b: i64) -> i64 {
    return load64(b + BUF_LEN)
}

fn buf_reset(b: i64) {
    store64(b + BUF_LEN, 0)
    store64(b + BUF_ERR, 0)
}

fn buf_add(b: i64, p: i64, n: i64) {
    let len = load64(b + BUF_LEN)
    if len + n > load64(b + BUF_CAP) {
        store64(b + BUF_ERR, 1)
        return
    }
    memcpy(load64(b + BUF_PTR) + len, p, n)
    store64(b + BUF_LEN, len + n)
}

fn buf_str(b: i64, s: i64) {
    buf_add(b, s, strlen(s))
}

fn buf_byte(b: i64, c: i64) {
    let len = load64(b + BUF_LEN)
    if len >= load64(b + BUF_CAP) {
        store64(b + BUF_ERR, 1)
        return
    }
    store8(load64(b + BUF_PTR) + len, c)
    store64(b + BUF_LEN, len + 1)
}

fn buf_int(b: i64, x: i64) {
    let tmp = "................................"
    if x == 0 {
        buf_byte(b, '0')
        return
    }
    if x < 0 {
        buf_byte(b, '-')
    }
    var i = 32
    while x != 0 {
        var d = x % 10
        if d < 0 {
            d = -d
        }
        i = i - 1
        store8(tmp + i, '0' + d)
        x = x / 10
    }
    buf_add(b, tmp + i, 32 - i)
}

// ---- Вывод ----

fn write_n(fd: i64, p: i64, n: i64) {
    syscall(SYS_WRITE, fd, p, n)
}

fn print(s: i64) {
    write_n(STDOUT, s, strlen(s))
}

fn println(s: i64) {
    print(s)
    print("\n")
}

fn eprint(s: i64) {
    write_n(STDERR, s, strlen(s))
}

var print_buf: i64

fn print_int(x: i64) {
    if print_buf == 0 {
        print_buf = buf_new(32)
    }
    buf_reset(print_buf)
    buf_int(print_buf, x)
    write_n(STDOUT, buf_ptr(print_buf), buf_len(print_buf))
}

fn println_int(x: i64) {
    print_int(x)
    print("\n")
}
