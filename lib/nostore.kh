// Заглушки кучи store для программ без store (src/main.kh выбирает между
// этим файлом и lib/gc.kh). Ядро и рантайм ссылаются на кучу store, но без
// store выделение из неё не включается (__gc_ready остаётся false), поэтому
// здесь — простые версии с тем же смыслом, и код кучи в программу не попадает.

// Недостижимо: без кучи store выделение из неё не включается (__pmode_on), а
// объектов store, которые могли бы расти, нет.
fn __salloc(n: int, kind: int, mask: int) -> int {
    syscall(SYS_EXIT_GROUP, 101)
    return 0
}

fn __salloc_for(h: int, n: int, kind: int, mask: int) -> int {
    return __salloc(n, kind, mask)
}

fn __struct_salloc(d: int, n: int, tag: int) -> int {
    return __salloc(n, 0, 0)
}

// Словарей в store нет: роста по частям тоже.
fn __gc_lazy_alloc(n: int, h: int) -> int {
    return __salloc(n, 0, 0)
}

fn __gc_ptrb_on(p: int, n: int) {
}

fn __gc_grow_hold(n: int, g: int) {
}

fn __gc_grow_done(n: int, at: int) {
}

// Выделения из store нет, объектов в store тоже.
fn __store_on() -> bool {
    return false
}

fn __store_for(h: int) -> bool {
    return false
}

// Контейнеров store нет: проверять нечего.
fn __store_mut(h: int) {
}

// Выделения из store нет: выходить из него при панике не нужно.
fn __store_panic() {
}

fn __store_init() {
    __panic_msg("internal: store in a program without store")
}

// Начало сервера или фоновых задач без store: глобальных пользователя у
// такой программы нет (src/api.kh, check_api), восстанавливать нечего.
fn __store_boot(load: bool) {
    __store_rw_init()
}

// Записей контекстов (lib/gc.kh) без store нет: указателей в store никто не
// держит, публиковать и отзывать нечего.
fn __pin_new(top: int) -> int {
    return 0
}

fn __pin_acquired(c: int) {
}

fn __pin_publish(r: int) {
}

fn __pin_unfinished(c: int) -> bool {
    return false
}

fn __pin_final(c: int) {
}

fn __pin_check_idle(r: int) {
}

// Сборщика без store нет: собирать нечего, потока сборщика нет.
fn __gc_hard_check() {
}

fn __gc_test_point(end: bool) {
}

fn __gc_window_point() {
}

fn __gc_spawn() {
}

fn __gc_thread_main() {
}

// Барьера SATB без store нет: разметки не бывает. Хуки контейнеров
// (lib/core.kh) и барьеров (lib/api.kh) пустые — встраиваются в ничто.
fn __gc_field(obj: int, off: int) {
}

fn __gc_elem(xs: int, i: int) {
}

fn __gc_root(slot: int) {
}

fn __gc_shade(w: int) {
}

fn __gc_old_array(h: int) {
}

fn __gc_old_slots(m: int) {
}

fn __gc_old_at(m: int, a: int) {
}

fn __gc_vacate(h: int, from: int) {
}

fn __gc_remove_at(h: int, v: int, i: int, n: int) {
}

fn __gc_permute(h: int) {
}

fn __gc_map_removed(m: int, idx: int, v: int) {
