// Ответ к заданию урока 1.
fn fizzbuzz(n: int) -> str {
    if n % 15 == 0 {
        return "FizzBuzz"
    }
    if n % 3 == 0 {
        return "Fizz"
    }
    if n % 5 == 0 {
        return "Buzz"
    }
    return n.to_str()
}

fn main() {
    var parts: [str] = []
    for i in 1..=15 {
        parts.push(fizzbuzz(i))
    }
    print(parts.join(" "))
}
